<!--
  The language server, registered only where the platform has an LSP API - see plugin.xml. An IDE
  without one loads everything else and the editor still colours Yana; what it loses is the half of
  the plugin that needs a compiler.
-->
<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <platform.lsp.serverSupportProvider
            implementation="se.rimmer.yana.lsp.YanaLspServerSupportProvider"/>

        <!--
          The compiler is the reference resolver. The flat PSI file intentionally has no native
          declaration tree, so Ctrl+B needs this small adapter to the LSP definition response,
          including definitions in lib/ outside the project root.
        -->
        <gotoDeclarationHandler order="first" implementation="se.rimmer.yana.lsp.YanaGotoDeclarationHandler"/>
    </extensions>
</idea-plugin>
