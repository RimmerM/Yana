<idea-plugin>
    <!--
      CLion's Build button - see YanaBuildConfigurationProvider. An optional dependency rather than a
      required one, so the plugin still loads in a JetBrains IDE that is not CLion; there it keeps
      Run, and loses only the button this adds.
    -->
    <extensions defaultExtensionNs="cidr">
        <buildConfigurationProvider implementation="se.rimmer.yana.clion.YanaBuildConfigurationProvider"/>
    </extensions>
</idea-plugin>
