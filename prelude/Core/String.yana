import Native

{-
   The string - `lib/Native/Text.native.yana`'s two words, as a declaration on `Array`'s terms.

   `String` claims `@builtin(string)` and is an ordinary record whose one field is the array of
   this target's code units - so growing, reserving and releasing are the array's and not a second
   implementation of each. What the compiler knows about it is that a literal is one, built through
   `stringLiteral` below, and that its **shared** occurrence is `StringView`: a shared `String` in a
   binding position is the view, because a string has no bracket spelling to ask for one with, and
   only `&s: String`, an owned one, and the subject of `Viewed.view` are the owner. That is the view
   table's `spelled` column, and the whole of the difference between this pair and the array's.
-}
@builtin(string)
pub data String {units: Array(CodeUnit)}

@local @builtin(stringView)
data StringView {units: %CodeUnit, length: Size}

{-
   A string from bytes that already exist - what `"abc"` is.

   The bytes are a constant the compiler places and this is the value that describes them: a run
   that owns nothing, so releasing the string hands nothing back and growing it copies once - which
   is copy-on-write, falling out of `Run`'s three answers rather than needing a fourth.
-}
@builtin(stringLiteral) @inline(always)
pub fn stringLiteral(bytes: %CodeUnit, length: Size) -> String =
    String {units: Array {
        run: Run {items: bytes, capacity: truncate(length) :: Count, ownsHeap: runBorrowed},
        length: truncate(length) :: Count
    }}

{-
   The derivation - a shared `String` out of the owner, which is the one body whose subject is the
   owner rather than the view. The compiler reads `Viewed`'s role to give `self` that form, and
   everything else here is ordinary: two field reads, a record, and a result position that is the
   view.
-}
instance Viewed(String):
    @inline(always) fn view(self: source'String) -> source'String =
        StringView {units: self.units.run.items, length: truncate(self.units.length) :: Size}

-- The code unit address a string view is defined by - `values` for a string, and for the same
-- reason: the result is what roots an element borrow in the string.
@inline(always)
pub fn units(self: source'String) -> %source'CodeUnit = self.units

-- The two operations every string has, over the view's own fields - `lib/Core/String.yana`'s
-- native `Length(String)` and `String.unit`, the second as the `Index` instance the language
-- reaches for `s[i]`.
instance Length(String):
    @inline(always) fn length(self: String) -> Size = self.length

instance Index(String, Size, CodeUnit):
    @inline(always) fn get(self: source'String, index: Size) -> source'CodeUnit:
        if (bitcast(index) :: USize) >= (bitcast(self.length) :: USize) then checkFailed()
        return borrow(advance(units(self), index))

    -- Through the owner, because a unique `String` is one: there is no unique view of a string,
    -- so the element is the array's to hand out and the check is the array's instance's.
    @inline(always) fn getMut(&self: source'String, index: Size) -> &source'CodeUnit = getMut(self.units, index)

{-
   Comparing two strings - `lib/Core/String.yana`'s native `Eq(String)`.

   A unit at a time rather than `compareMemory`, which is what `lib` calls: that function is a
   vectorized scan and is not in this library, and a comparison that has to be written twice at two
   speeds is one this stage does not need yet. The length test first is not an optimization but the
   only reason the loop is bounded by one of them.

   `!=` is left to the class default - `!(lhs == rhs)` - because there is nothing faster to say
   here, and a second body would be a second place the comparison is written.
-}
instance Eq(String):
    fn ==(lhs: String, rhs: String) -> Bool:
        let count = length(lhs)
        if count != length(rhs) then return False

        let &i = 0 :: Size
        while i < count:
            if lhs[i] != rhs[i] then return False
            i += 1

        return True

{-
   Growing a string - `lib/Core/String.yana`'s native half, each one line over the owner's array.
   `&self: String` is the owner, since a string has no unique view, and what these reach through
   `self.units` is the growable array whose `push` and `reserve` do the work.
-}
pub fn emptyString() -> String = String {units: emptyArray()}

-- Room for `capacity` units and none of them written yet - `lib/Core/String.yana`'s native
-- `String.ofCapacity`, over this library's own `Array.ofCapacity` rather than over `newRun`.
pub fn String.ofCapacity(capacity: Size) -> String = String {units: ofCapacity(capacity)}

pub fn String.pushUnit(&self: String, unit: CodeUnit): push(self.units, unit)

pub fn String.reserve(&self: String, wanted: Size): reserve(self.units, wanted)

pub fn String.push(&self: String, other: String):
    let count = length(other)
    let &i = 0 :: Size
    while i < count:
        push(self.units, *advance(units(other), i))
        i = i + 1

{-
   `lhs ++ rhs` - `lib/Core/String.yana`'s native `Append(String)`.

   The left side's storage is taken over rather than copied, which is the whole reason the class
   member is written `->`: `out` is `lhs` moved into a mutable binding, and what the append costs is
   the right side's units. A chain of them is therefore linear in the total length rather than
   quadratic in the number of joins.
-}
instance Append(String):
    fn ++(->lhs: String, ->rhs: String) -> String:
        let &->out = lhs
        String.push(out, rhs)
        return out

instance Reclaim(String):
    fn reclaim(->value: String): releaseRun(value.units.run)
