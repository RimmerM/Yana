/*
 * The operations a machine has and the IR does not - the content of a `Node::Native`.
 *
 * `YANA_MIR_NATIVE( enumerator, name )`. The name is what the IR prints; there is nothing else on a
 * row, because these have no shared structure to describe. That is the whole reason they are one
 * node with a column rather than a node each: what they have in common is being a *fixed operation
 * over a flat argument list whose meaning belongs to the backend*, and that is a shape, not a
 * family.
 *
 * **No arity column**, deliberately. A system call has seven of them - `op.def` writes `syscall0`
 * through `syscall6` because a call's argument count decides which registers the kernel reads - and
 * one row per arity here would be six rows that lower identically. The arity is the operand list's,
 * which is where every reader looks anyway.
 *
 * What is *not* here is the rest of the shipping stage's `NativeOp`: the host operations, which
 * belong to a target this stage does not compile for. A row with no producer is a description
 * checked against nothing.
 */

// The two block operations the lower IR already has, reached by name rather than derived from an
// aggregate assignment. `CopyMemory` is `blockCopy(to, from, count)` and `SetMemory` is
// `setMemory(to, value, count)`.
YANA_MIR_NATIVE( CopyMemory, "copy.memory"_v )
YANA_MIR_NATIVE( SetMemory,  "set.memory"_v  )

/*
 * `syscall(number, args...)`.
 *
 * The number is **operand zero** rather than a column, which is the lower IR's own shape: it models
 * a system call as a call with its own convention, so what would be a field here is an argument
 * there and carrying it twice is two things to keep in step.
 */
YANA_MIR_NATIVE( Syscall,    "syscall"_v     )

/*
 * `cloneThread(flags, stackTop, entry, argument, threadId)` - a thread, started.
 *
 * The one row here that does **not** map to a lower-IR instruction of its own shape: it becomes
 * `LowerIntrinsic::CloneThread`, a backend pseudo whose encoder is the `clone` system call plus the
 * child's entry sequence. It is a `Native` row all the same, because what it is at this tier is the
 * thing every row here is - a fixed operation over a flat argument list whose meaning belongs to the
 * backend.
 *
 * **The entry stays one operand.** The declaration takes an ordinary function of the language, so
 * what arrives is a `Fun` value - the `{code, env}` pair - and the child needs both words. Splitting
 * it here would need a node for reading a word of a function value, which nothing else in this stage
 * wants and which `resolve_ssa/lower/inst.cpp` already does by hand for a call through a value:
 * `wordAt` at `funCodeOffset` and `funEnvOffset`. So the split is at the lowering, one place, beside
 * the other reader of the same pair, and MIR carries the entry as what the author wrote.
 */
YANA_MIR_NATIVE( CloneThread, "clone.thread"_v )

/*
 * The two halves of a stack context - `stackInit(stackTop, argument, entry)` and
 * `stackSwitch(target, save, transfer)`, Analysis-External-Iterators.md §4.1.
 *
 * `StackInit` is `CloneThread`'s shape twice over: it becomes `LowerIntrinsic::StackInit`, a backend
 * pseudo whose encoder writes four words and an entry stub, and the entry stays **one operand**
 * here for the reason the thread's does - what the author wrote is a function of the language, and
 * the one place that knows a function value is two words at two offsets is the lowering.
 *
 * `StackSwitch` is the row that is *not* an intrinsic below here. It becomes a **call** - a
 * `LowerInstCall` under `LowerCallType::StackSwitch` - because what it has to say about registers is
 * a convention's rather than a form's: the other context runs at that point, so nothing the
 * allocator handed out survives, and a form's clobbers land in front of its operands where a call's
 * land behind them. See the convention's own note in `compiler/lower/convention.h`.
 *
 * A `Native` row all the same, and the same shape as every other one here: a fixed operation over a
 * flat argument list whose meaning belongs to the backend.
 */
YANA_MIR_NATIVE( StackInit,   "stack.init"_v   )
YANA_MIR_NATIVE( StackSwitch, "stack.switch"_v )

/*
 * The x86 instructions a program reaches by name - `lib/Native/Intrinsic/X86.yana`, and the one
 * group here that is a *target's* rather than a machine's in general.
 *
 * Rows here rather than nodes of their own, on this file's own terms: each is a fixed operation
 * over a flat argument list whose meaning belongs to the backend. What made that worth stating
 * again is that they are `@platform`-gated - a build below the level that has one never resolves
 * the declaration, so a row nothing claims is a row nothing can reach.
 *
 * **`sha1rnds4`'s round group is a row rather than an operand**, which is where this departs from
 * `Syscall`'s number. The group is the instruction's trailing byte, so a computed one is not an
 * instruction at all; the lower IR already says so by having four enumerators for it
 * (`LowerSha::Sha1Rounds0` through `3`), and four rows here make the seam a mapping instead of a
 * constant read back out of an operand at the tier that can no longer report about it. The
 * resolver is what holds the argument to being a literal, at the call, which is the only place
 * that can name it.
 *
 * `sha256rnds2`'s third operand is `xmm0` on the machine. That is a register-allocation constraint
 * the x64 form carries and nothing above the backend has to know, so here it is an ordinary third
 * argument - which is the same division `LowerInstSha256Rounds` states from its side.
 */
YANA_MIR_NATIVE( Crc32,          "crc32"_v       )
YANA_MIR_NATIVE( VZeroUpper,     "vzeroupper"_v  )
YANA_MIR_NATIVE( Sha1Message1,   "sha1msg1"_v    )
YANA_MIR_NATIVE( Sha1Message2,   "sha1msg2"_v    )
YANA_MIR_NATIVE( Sha1NextE,      "sha1nexte"_v   )
YANA_MIR_NATIVE( Sha1Rounds0,    "sha1rnds4_0"_v )
YANA_MIR_NATIVE( Sha1Rounds1,    "sha1rnds4_1"_v )
YANA_MIR_NATIVE( Sha1Rounds2,    "sha1rnds4_2"_v )
YANA_MIR_NATIVE( Sha1Rounds3,    "sha1rnds4_3"_v )
YANA_MIR_NATIVE( Sha256Message1, "sha256msg1"_v  )
YANA_MIR_NATIVE( Sha256Message2, "sha256msg2"_v  )
YANA_MIR_NATIVE( Sha256Rounds,   "sha256rnds2"_v )

/*
 * AES-NI and PCLMULQDQ - Analysis-Avx512.md §4.1-4.2. The four AES rounds and the carryless
 * multiply take two operands of one type, sixteen bytes or thirty-two (VAES, VPCLMULQDQ); the two
 * key-schedule instructions take one, of sixteen.
 *
 * **`aeskeygenassist` and `pclmulqdq` carry `NodeNative::immediate`**, which is where this departs
 * from `sha1rnds4`: the round constant is any of 256 bytes, which is not a row count, and the
 * selector travels the same way for symmetry with it. `nativeHasImmediate` names the two.
 */
YANA_MIR_NATIVE( AesEncrypt,        "aesenc"_v          )
YANA_MIR_NATIVE( AesEncryptLast,    "aesenclast"_v      )
YANA_MIR_NATIVE( AesDecrypt,        "aesdec"_v          )
YANA_MIR_NATIVE( AesDecryptLast,    "aesdeclast"_v      )
YANA_MIR_NATIVE( AesInverseMix,     "aesimc"_v          )
YANA_MIR_NATIVE( AesKeygenAssist,   "aeskeygenassist"_v )
YANA_MIR_NATIVE( CarrylessMultiply, "pclmulqdq"_v       )
