/*
 * The roster of SSA instructions - one row per `ssa::Inst::Kind`, and the only place a kind is
 * written down. The enum, the concrete-type cast in `visitInst`, the mnemonic and the traits are
 * generated from it.
 *
 * SSA is the optimizer's IR, so what a row has to decide is different from MIR's. There are no use
 * modes here: an operand carries a `UseKind`, and the invariant is the linear one - an `Owned` value
 * is consumed exactly once on every reachable path, a `Guaranteed` value may not outlive its loan,
 * and a `Trivial` value is unrestricted (§7.1). That is a small enough surface for every pass to
 * preserve mechanically, and `verifyBody` checks it after each of them.
 *
 * ## The columns
 *
 *  - `kind` is the `ssa::Inst::Kind` enumerator, and the order of these rows is the order of the enum.
 *  - `Struct` is the concrete type an `Inst` of that kind may be cast to.
 *  - `mnemonic` is what a dump prints.
 *  - `flags`:
 *      - `kSsaTerminator` - ends its block, and is the only kind that may name successors.
 *      - `kSsaPure` - may be recomputed or not computed at all. Deliberately off for anything that
 *        reads storage another instruction may write, and for every call.
 *      - `kSsaConsumes` - has at least one operand that may be a consuming use. The verifier reads it
 *        to decide whether an `Owned` operand is legal at all, so a kind that transfers ownership
 *        and forgets it is caught rather than silently leaking.
 *
 * ## The mnemonic is a base name
 *
 * `binary` and `unary` print the operation instead - `add`, `neg` - and print.cpp is where that
 * happens, on the same terms as MIR's roster. The operation itself is `mir::BinaryOp`, shared
 * between the tiers: what the conversion decides is ownership, and arithmetic is not that.
 */

//            kind           struct              mnemonic           flags
YANA_SSA_INST( Const,         InstConst,          "const"_v,         kSsaPure )
YANA_SSA_INST( GlobalAddress, InstGlobalAddress,  "global.addr"_v,   kSsaPure )
YANA_SSA_INST( GenValue,      InstGenValue,       "gen.value"_v,     kSsaPure )
/*
 * One measurement of one type - the MIR `metric` carried down.
 *
 * A row of its own and not a constant, for the reason the MIR row gives: at a *type parameter* the
 * answer is a read of the descriptor the caller supplied, and folding it here would be this tier
 * deciding a layout in a body that has no layout to decide. It is the one instruction whose whole
 * content is a type and a question about it.
 *
 * `kSsaPure`: it reads nothing and depends on no state. Both shapes it lowers to - an immediate, and
 * a load of a table cell written once when the image is assembled - are that.
 */
YANA_SSA_INST( Metric,        InstMetric,         "metric"_v,        kSsaPure )
/*
 * An operation the machine has and this IR does not - the MIR `native` carried down.
 *
 * **Not `kSsaPure`.** A system call is the definition of an effect, and the two block operations
 * write storage nothing else in the IR named - what makes them safe is the argument they were given,
 * not anything this tier can see. So they are ordered against every other effect exactly as a call
 * is, and no pass may drop, duplicate or hoist one.
 */
YANA_SSA_INST( Native,        InstNative,         "native"_v,        0 )

/*
 * An operation the **host** has and this IR does not - the MIR `host` carried down, Analysis-IR-JS.md
 * §3.10 and `resolve_mir/host.def` for the rows.
 *
 * **Not `kSsaPure`, and that is the kind's answer rather than the row's.** The flags column is per
 * kind, and what a host operation does is per row: a property read reads, a method call may do
 * anything, and `hostFixedCapacity` answers a question about a type and does nothing at all. So the
 * flag here is the conservative one and `isPure(const Inst&)` is what refines it - the one place in
 * this tier where a kind-level effect question has an instruction-level answer, and the reason that
 * overload exists at all.
 *
 * **`kSsaConsumes`**, which is where it departs from `Native` in the other direction: a native
 * operation's operands are addresses and counts and every one of them is `Inspect`, and a host
 * operation's are the *declaration's* - `host.array` holds the elements of `[1, 2, 3]` afterwards,
 * so they arrive as moves. The flag is what says an owned operand is legal here at all; which
 * positions actually consume is the signature's answer and was settled before the node was built.
 *
 * Nothing lowers one. JSIR is the first tier that knows what a host operation means, so
 * `resolve_ssa/lower` treats one as an internal error - a native build contains no declaration that
 * could reach it, `@platform` selection having deleted them all.
 */
YANA_SSA_INST( Host,          InstHost,           "host"_v,          kSsaConsumes )

/*
 * One atomic operation, and whether its compare-exchange stored - the MIR pair carried down.
 *
 * **Not `kSsaPure`, not even the load.** Purity here means "may be computed again, or not computed
 * at all", and an atomic load may be neither: computing it again is a second read that may see a
 * different value, and not computing it is a synchronization edge removed. That is the same answer
 * the lower IR gives by leaving all six off `isRepeatable`.
 *
 * `AtomicOk` *is* pure, and the two answers are not in tension. What it names is the second result
 * of an instruction that has already run, so reading it again reads the same word - which is exactly
 * what purity is, and is why it is a projection rather than a second access.
 *
 * `kSsaConsumes` for one row of eleven, and that is what the flag is for: `intoValue` takes the
 * atomic over, so an `Owned` operand is legal here - and a kind that transferred ownership without
 * saying so is exactly what the verifier reads this to catch.
 */
YANA_SSA_INST( Atomic,        InstAtomic,         "atomic"_v,        kSsaConsumes )
YANA_SSA_INST( AtomicOk,      InstAtomicOk,       "atomic.ok"_v,     kSsaPure )
// `a * b + c` at most once rounded - the MIR `fma` carried down, and pure for the reason every other
// arithmetic row is.
YANA_SSA_INST( Fma,           InstFma,            "fma"_v,           kSsaPure )

/*
 * A branch-free choice - the MIR `select` carried down, and `kSsaPure` for the reason every other
 * arithmetic row is: it reads three values and nothing else.
 */
YANA_SSA_INST( Select,        InstSelect,         "select"_v,        kSsaPure )

/*
 * A `match` over constants - the MIR `map` carried down, and inventory D3.
 *
 * `kSsaPure`: it reads one value, reads no storage, and answering it twice answers the same thing.
 *
 * **Not `kSsaConsumes`**, which is the one flag worth arguing. Every entry is a constant, and a
 * constant installed is an owned occurrence produced *fresh* rather than transferred - §5.8, and the
 * same statement `InstConst` makes by carrying neither flag. What the result owes is decided by its
 * own convention, exactly as a `const` of a record is.
 */
YANA_SSA_INST( Map,           InstMap,            "map"_v,           kSsaPure )

/*
 * The four vector operations - the MIR nodes carried down, and Design-Vector §3.2 for why there are
 * four of them rather than a family.
 *
 * `kSsaPure` for all of them: each reads its operands and nothing else, and a second copy is the
 * same answer computed twice. That is what a vector *is* at this tier - a value in a register, with
 * everything about where it came from settled above.
 */
YANA_SSA_INST( VecSplat,      InstVecSplat,       "vec.splat"_v,     kSsaPure )
YANA_SSA_INST( VecLane,       InstVecLane,        "vec.lane"_v,      kSsaPure )
YANA_SSA_INST( VecWithLane,   InstVecLane,        "vec.withlane"_v,  kSsaPure )
YANA_SSA_INST( VecShuffle,    InstVecShuffle,     "vec.shuffle"_v,   kSsaPure )
YANA_SSA_INST( VecReduce,     InstVecReduce,      "vec.reduce"_v,    kSsaPure )
YANA_SSA_INST( Alloc,         InstAlloc,          "alloc"_v,         0 )

/*
 * Slots for a run - `mir::NodeRunSlots` carried down, and the request `resolve_ssa/opt/place.cpp`
 * answers.
 *
 * **Not an `Alloc`**, and the difference is the lifetime. `Alloc` is a *slot of this frame*, heap-
 * placed or not, and `Conversion::releaseSlots` hands a heap one back at every exit; a run's slots
 * outlive the frame whenever the container does, and what hands them back is the container's own
 * `Reclaim` through `freeHeap`. So the two are different questions about storage, and a row that
 * shared them would have had a lifetime field that means one thing on half its instances.
 *
 * `placed` is the pass's answer and starts clear, which is the arm that allocates: a request nothing
 * proved to be frame-keepable is the allocator's, and that is the direction a missing decision has
 * to fail in. When it is set, `lower/inst.cpp` emits a frame slot of `[a *capacity]` and the
 * descriptor beside it has already been rebuilt to say `runBorrowed` - the two edits are one
 * rewrite, in `place.cpp`, because a placement whose flag was not turned off is a frame address
 * handed to `freeHeap`.
 *
 * Neither pure nor consuming: it answers fresh storage, so two of them are not one instruction and
 * it may not be duplicated or sunk across the stores that fill it, and it takes no operand that
 * could own anything.
 */
YANA_SSA_INST( RunSlots,      InstRunSlots,       "run.slots"_v,     0 )

/*
 * The other end of one `Alloc` that was not the frame's - §10.4's placement, released.
 *
 * A row of its own rather than a bit on `Drop`, and the two answer different questions about
 * different things: a drop runs what a *value* owes when it dies, and this hands back the *storage*
 * it was sitting in. A heap-placed local whose value left by a `->` argument still owes this one and
 * owes no drop at all, which is exactly the pair `test/resolve/DropFlagHeap.yana` measures - so a
 * shared instruction would have had a flag that is set without the rest of it meaning anything.
 *
 * **Not `kSsaPure`**, and not `kSsaConsumes` either: the operand is an address and an address is
 * never an owner (see `InstAlloc`). What it is is an effect ordered against every other one, because
 * a read of the storage after it is a read of memory the allocator has taken back.
 */
YANA_SSA_INST( Free,          InstFree,           "free"_v,          0 )
YANA_SSA_INST( FieldAddress,  InstFieldAddress,   "field.addr"_v,    kSsaPure )
/*
 * The address of one element - `xs[i]`, and `mir::Place::Index` carried down.
 *
 * A row of its own rather than a `FieldAddress` with a computed index, because the two differ in the
 * thing an instruction table exists to state: a field's position is a constant the manifestation
 * decides, and an element's is a *value* multiplied by a stride. So this one has a second operand
 * and `FieldAddress` has none, and a shared row would have had a `Use` that is set on half its
 * instances.
 *
 * `kSsaPure`: computing an address reads nothing and writes nothing. What is done through it is the
 * load or the store that follows, exactly as for a field.
 */
YANA_SSA_INST( ElementAddress, InstElementAddress, "element.addr"_v,  kSsaPure )
YANA_SSA_INST( Load,          InstLoad,           "load"_v,          0 )
YANA_SSA_INST( Copy,          InstCopy,           "copy"_v,          0 )
YANA_SSA_INST( Store,         InstStore,          "store"_v,         kSsaConsumes )
YANA_SSA_INST( Binary,        InstBinary,         "binary"_v,        kSsaPure )
YANA_SSA_INST( Unary,         InstUnary,          "unary"_v,         kSsaPure )
YANA_SSA_INST( Aggregate,     InstAggregate,      "aggregate"_v,     kSsaConsumes )
YANA_SSA_INST( Drop,          InstDrop,           "drop"_v,          0 )
/*
 * A named function as a value - the MIR `fun.value` carried down, and Analysis-IR.md's G7.
 *
 * `kSsaConsumes` and **not** `kSsaPure`, which changed with D17: a value whose environment is
 * heap-placed takes that environment rather than borrowing it, so the operand's lineage ends here
 * exactly as an aggregate's components do. It was pure while every environment was a borrow, and the
 * flags are per kind - a form that consumes on some values and not others has to state the one that
 * admits both, for the same reason `InstCall` does.
 */
YANA_SSA_INST( FunValue,      InstFunValue,       "fun.value"_v,     kSsaConsumes )
YANA_SSA_INST( Call,          InstCall,           "call"_v,          kSsaConsumes )
YANA_SSA_INST( Return,        InstReturn,         "return"_v,        kSsaTerminator | kSsaConsumes )
YANA_SSA_INST( Jump,          InstJump,           "jump"_v,          kSsaTerminator | kSsaConsumes )
YANA_SSA_INST( Branch,        InstBranch,         "branch"_v,        kSsaTerminator | kSsaConsumes )

/*
 * A multi-way branch - the MIR `switch` carried down, and inventory D3.
 *
 * `kSsaConsumes` for the same reason `Branch` carries it: edge arguments may move owned values, and
 * a terminator that transferred ownership without saying so is what the flag exists to catch.
 */
YANA_SSA_INST( Switch,        InstSwitch,         "switch"_v,        kSsaTerminator | kSsaConsumes )
YANA_SSA_INST( Unreachable,   InstUnreachable,    "unreachable"_v,   kSsaTerminator )
