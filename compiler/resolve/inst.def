/*
 * The roster of resolve-IR instructions - one row per `Value::Kind`, and the only place a kind is
 * written down.
 *
 * `Value::Kind` itself is generated from this file, which is what makes the rows and the enumerators
 * one list rather than two that agree: a kind cannot be added without a row, and a row cannot be
 * added without the four things below being decided for it. Everything that used to be a switch over
 * every opcode to say one thing about each - the mnemonic, whether it ends a block, whether it may be
 * recomputed - is a column here instead.
 *
 * What is *not* here is anything an instruction says with its own fields. The places it names, the
 * operands it reads, the ownership it hands over and the blocks it jumps to are declared beside those
 * fields, as the trait members `Value` gives defaults for (see inst.h) - because a column listing
 * field names would be a second spelling of the struct, and the one thing worth guaranteeing is that
 * an instruction's answer lives next to what it is an answer about.
 *
 * ## The columns
 *
 *  - `kind` is the `Value::Kind` enumerator, and the order of these rows is the order of that enum.
 *  - `Struct` is the concrete type a `Value` of that kind may be cast to. Several kinds share one -
 *    `Init` and `Assign` are one instruction with two meanings, and the twelve arithmetic kinds are
 *    one `InstBinary` - which is why the column exists at all: `visitInstruction` is what turns a
 *    kind into that type, and it is generated from here.
 *  - `mnemonic` is what the IR dump prints. Five kinds refine it from their own fields (a mutable
 *    borrow, a derived drop, the metric, the native operation, the comparison); the refinement is in
 *    print.cpp, and what is here is the base name.
 *  - `flags` is the four-bit answer to the questions a pass asks about a kind rather than about an
 *    instruction:
 *      - `kInstResult` - defines a value another instruction may name. Its absence is checkable, and
 *        `verifyFunction` checks it: nothing may read a store, a drop or a terminator.
 *      - `kInstConstant` - a value that belongs to no block, materialized per function on demand.
 *      - `kInstPure` - may be computed again, or not computed at all. Left off everything whose
 *        absence is a decision an earlier pass took, everything that reads storage someone else may
 *        be writing, and every call.
 *      - `kInstTerminator` - ends its block. The edges it makes are declared as successor slots.
 */

//        kind          struct           mnemonic         flags
YANA_INST(Arg,          Arg,             "arg"_v,         kInstResult)
YANA_INST(ConstInt,     ConstInt,        "int"_v,         kInstResult | kInstConstant | kInstPure)
YANA_INST(ConstFloat,   ConstFloat,      "float"_v,       kInstResult | kInstConstant | kInstPure)
YANA_INST(ConstDouble,  ConstDouble,     "double"_v,      kInstResult | kInstConstant | kInstPure)
YANA_INST(ConstString,  ConstString,     "string"_v,      kInstResult | kInstConstant | kInstPure)
YANA_INST(Alloc,        InstAlloc,       "alloc"_v,       kInstResult)
YANA_INST(LoadPlace,    InstLoadPlace,   "load"_v,        kInstResult)
YANA_INST(Init,         InstInit,        "init"_v,        0)
YANA_INST(Assign,       InstInit,        "assign"_v,      0)
YANA_INST(Aggregate,    InstAggregate,   "aggregate"_v,   0)
YANA_INST(Borrow,       InstBorrow,      "borrow"_v,      kInstResult)
YANA_INST(Move,         InstMove,        "move"_v,        kInstResult)
YANA_INST(Swap,         InstSwap,        "swap"_v,        0)
YANA_INST(Exchange,     InstExchange,    "exchange"_v,    kInstResult)
YANA_INST(Copy,         InstCopy,        "copy"_v,        kInstResult)
YANA_INST(Drop,         InstDrop,        "drop"_v,        0)
YANA_INST(Address,      InstAddress,     "addressof"_v,   kInstResult)
YANA_INST(TypeMetric,   InstTypeMetric,  "sizeof"_v,      kInstResult | kInstPure)
YANA_INST(TableSlot,    InstTableSlot,   "tableslot"_v,   kInstResult | kInstPure)
YANA_INST(Native,       InstNative,      "native"_v,      kInstResult)
YANA_INST(Cast,         InstUnary,       "cast"_v,        kInstResult | kInstPure)
// The same bits read as another type, which `Cast` cannot say for every pair it relates: a `Cast`
// from `Float` to `I32` is a numeric conversion and this is the reinterpretation, and nothing but
// the kind distinguishes them. The lower IR has drawn the same distinction all along.
YANA_INST(Bitcast,      InstUnary,       "bitcast"_v,     kInstResult | kInstPure)
YANA_INST(Neg,          InstUnary,       "neg"_v,         kInstResult | kInstPure)
YANA_INST(Not,          InstUnary,       "not"_v,         kInstResult | kInstPure)
/*
 * The bytes of an integer in the opposite order - `bswap`, `movbe`, `llvm.bswap`, `rev`.
 *
 * A kind on `Sqrt`'s grounds rather than `Abs`'s: the expansion exists, is exactly equivalent, and
 * is simply not what any target does. `swapEndian` was eight source instances of shifts and masks
 * until this row existed - four instructions at 32 bits and eleven at 64, where every machine this
 * compiles for reverses a register in one - and a peephole that had to find that tree again would
 * be looking for a shape the optimizer is free to rearrange first.
 *
 * **An integer, at 16, 32 or 64 bits.** Not a vector: reversing the bytes of a lane is `pshufb`
 * against a pattern rather than this instruction widened, and nothing asks for one. Not a `@bits`
 * refinement either - `WideInt` is 53 bits in a 64-bit register, and which eight bytes a 53-bit
 * value's are is not a question this operation has an answer to. `verifyFunction` says both.
 *
 * The 16-bit case is the one that does not survive the seam. The lower IR's narrowest scalar is
 * `Int32` (see lowerType), so a 16-bit swap cannot be *written* below here at all, and `lowerCalc`
 * expands it into the shift pair beside the narrowing every other 16-bit operation already gets -
 * which is why the width lives in this instruction's type rather than in a field. Below the seam a
 * `Bswap` is always its register's full width, and `movbe` therefore never reaches a 16-bit load.
 */
YANA_INST(ByteSwap,     InstUnary,       "byteswap"_v,    kInstResult | kInstPure)
/*
 * The two floating-point operations no arrangement of the arithmetic above expresses.
 *
 * `Sqrt` is here because nothing in this compiler had a square root at any width, which is what made
 * Implementation-Vector.md §9.4 call it "not a vector-shaped piece of work": what a vector needs is
 * the same instruction the scalar wanted all along.
 *
 * `Fma` is `a * b + c` with **at most one rounding**, which is why it cannot be the multiply and the
 * add: those round twice and are a different function of the same three inputs. Design-Vector §3.3
 * makes that observable and rules on it - the language says `fma` *may* fuse, so a target with a
 * fused instruction gives one rounding and a target without gives two, and a program that must not
 * fuse writes `a * b + c` rather than calling this.
 *
 * Both take a float or a vector of floats, and neither is anything else: `Sqrt` of an integer is a
 * question about rounding that no machine instruction answers.
 */
YANA_INST(Sqrt,         InstUnary,       "sqrt"_v,        kInstResult | kInstPure)
YANA_INST(Fma,          InstFma,         "fma"_v,         kInstResult | kInstPure)
/*
 * The magnitude, which is a kind rather than the three instructions it can be built from.
 *
 * `select(v .<= 0, 0 - v, v)` computes it, and that is what the library emitted until this row
 * existed - the comparison non-strict and the negation a subtraction *from zero*, so that `-0.0`
 * answers `+0.0` where `-v` would have answered `-0.0`. What that shape also does, without meaning
 * to, is promise that the **sign of a NaN survives**, since a NaN compares false and leaves through
 * the untouched arm.
 *
 * That promise is the reason this is a kind. Every target computes a magnitude in one instruction -
 * `andps` against `0x7fffffff`, `pabsd`, `llvm.fabs`, `Math.abs` - and every one of them **clears**
 * the sign of a NaN. So a backend that used its own instruction quietly disagreed with one that
 * expanded the shape, and the disagreement was invisible: three backends, two answers, and nothing
 * in the language saying which was right.
 *
 * **So the ruling is here: `abs` answers the magnitude, and the sign of a NaN is unspecified.** That
 * is weaker than the expansion and is what every target can implement directly, which is the whole
 * of what a kind buys over a shape a peephole has to find again.
 *
 * A vector of floats or of *signed* integers. An unsigned lane is its own magnitude, so `emitAbs`
 * answers the operand and no instruction is built; a scalar is not produced by anything today, and
 * `verifyFunction` says so rather than leaving a case every backend would have to carry untested.
 */
YANA_INST(Abs,          InstUnary,       "abs"_v,         kInstResult | kInstPure)
/*
 * The four roundings to an integral value, which are `Sqrt`'s case again at a different operation.
 *
 * All four were shapes in the library until these rows existed. `trunc` was
 * `widen(truncate(x) :: Long)` under a magnitude guard natively and an add-and-subtract of 2^52 on
 * JS; `floor` and `ceil` were `trunc` and a correcting compare-and-select; `round` was
 * `trunc(x + copysign(0.5, x))`. Every target has all four directly - `roundsd`/`roundpd` with an
 * immediate selecting the mode, `llvm.trunc`/`llvm.floor`/`llvm.ceil`/`llvm.round`, and
 * `Math.trunc`/`Math.floor`/`Math.ceil`/`Math.round` - so they are here for the reason `Sqrt` is:
 * the expansion is not what the target does, and a backend using its own instruction would have
 * disagreed with one that expanded the shape.
 *
 * **The tie rule is the ruling, and only `Round` has one to make.** `Trunc` is toward zero, `Floor`
 * toward negative infinity and `Ceil` toward positive infinity; those three are exactly what IEEE
 * 754 names and what every target spells in one instruction. `Round` is to nearest with ties
 * **away from zero** - C's `round`, and what lib/Math.yana already documents `Real.round` as - and
 * that is deliberately *not* the even-tie rule an FPU's default mode uses, so `round(2.5)` is 3 and
 * not 2. SSE4.1 has no ties-away encoding (`roundsd` imm 0 is ties-to-even), so the x64 backend
 * expands that one alone; the rule lives here so the expansion is a target's problem rather than a
 * difference between targets.
 *
 * Fixing the old `round` shape is part of what the rows buy. `trunc(x + copysign(0.5, x))` answers
 * 1 for 0.49999999999999994, because adding a half to the largest double below a half rounds up to
 * exactly 1 before the truncation ever runs. Every target's own rounding answers 0.
 *
 * All four take a float or a vector of floats, on `Sqrt`'s grounds: rounding an integer to an
 * integer is the identity, and no machine instruction is asked for it.
 */
YANA_INST(Trunc,        InstUnary,       "trunc"_v,       kInstResult | kInstPure)
YANA_INST(Floor,        InstUnary,       "floor"_v,       kInstResult | kInstPure)
YANA_INST(Ceil,         InstUnary,       "ceil"_v,        kInstResult | kInstPure)
YANA_INST(Round,        InstUnary,       "round"_v,       kInstResult | kInstPure)
YANA_INST(Add,          InstBinary,      "add"_v,         kInstResult | kInstPure)
YANA_INST(Sub,          InstBinary,      "sub"_v,         kInstResult | kInstPure)
YANA_INST(Mul,          InstBinary,      "mul"_v,         kInstResult | kInstPure)
/*
 * The top half of a product twice as wide as its operands - Implementation-Map.md §3.1's one new
 * primitive, and the only thing the multiply-fold that hashes a key needs that the language could
 * not already say.
 *
 * One instruction on every 64-bit machine this targets - `mul`/`mulx` on x86-64, `umulh` beside
 * `mul` on AArch64 - and there is deliberately no expansion out of 32-bit pieces: a backend that
 * cannot do it in one is a backend `Native.mulHigh` is not declared on, which is what
 * `@platform(native)` on that declaration says. The lower IR has had `MulHi`/`IMulHi` since the
 * reciprocal in lower_strength.cpp needed them; this is the same pair reachable from source.
 *
 * Signedness is the operand type's, exactly as `Mul`'s choice between `IMul` and `Mul` is.
 */
YANA_INST(MulHi,        InstBinary,      "mulhi"_v,       kInstResult | kInstPure)
/*
 * Division and remainder, and the two divisors the language answers for rather than the machine.
 *
 * **`x / 0` is 0, and `x % 0` is `x`.** Integers only - a float divided by zero is IEEE 754's
 * infinity and always was. The remainder follows from the quotient rather than being a second
 * ruling: `x == (x / b) * b + (x % b)` is the relation lower_strength.cpp computes a remainder *by*,
 * so a rule that broke it at zero would make the strength-reduced form and the direct form disagree
 * about the same expression. It is also what an ARM backend produces for nothing, `rem` being
 * `sdiv` and `msub` there: `x - 0 * 0` is `x`.
 *
 * **`INT_MIN / -1` is `INT_MIN`, and `INT_MIN % -1` is 0.** Not a separate decision either. The true
 * quotient 2^63 is not representable, so this is signed overflow, and doc/spec/types.md already says
 * overflow wraps. Stating it is what lets lower_strength.cpp rewrite `x / -1` as `neg x`, which it
 * previously declined precisely because the question was open.
 *
 * ## Why the language answers at all
 *
 * Because otherwise four targets answer differently and none of them is written down. x86 raises #DE
 * on both divisors; AArch64 defines both and traps on neither; JS gives 0 for a 32-bit lane through
 * the `|0` coercion, NaN in the 33-to-53-bit band through wide.cpp's `wrap`, and *throws* a
 * RangeError for a `bigint`. That is the same shape as the float-to-integer conversion, which was
 * settled the same way and for the same reason - see `saturationRange` in resolve/type.h, whose
 * ruling this one is modelled on down to the cost: a compare and a select.
 *
 * The alternative was to abort, and it was declined on one ground: this makes division *total*, and
 * a total division is ordinary pure arithmetic. `mayFault` in lower_licm.cpp is empty because of it,
 * so a loop-invariant division hoists; lower_fold.cpp folds the two pairs it used to decline; and a
 * 32-bit integer lane may be divided through the packed float divider, which faults on nothing and
 * is the only reason vector division can beat scalar code at all. An aborting division buys none of
 * those, and costs the same compare.
 *
 * ## What is still checked
 *
 * A zero divisor is a mistake even where it has an answer, so `emitDivision` in resolve/intrinsic.cpp
 * emits `checkCondition(b == 0)` in front of an integer division exactly as a subscript emits its
 * bounds test - same flag, same function, same `-no-checks` to remove it. The defined result is what
 * an unchecked build produces and what the checked build's abort *replaces*; it is not a fallback
 * nobody sees. Only `b == 0` is checked: the overflowing pair is defined arithmetic rather than a
 * mistake, and wraps silently as every other overflow does.
 *
 * `makeDivisionTotal` in lower/lower_divide.cpp is what makes the native machines agree with all of
 * this, and it is a correctness pass rather than an optimization - it runs in every build.
 */
YANA_INST(Div,          InstBinary,      "div"_v,         kInstResult | kInstPure)
YANA_INST(Rem,          InstBinary,      "rem"_v,         kInstResult | kInstPure)
YANA_INST(Shl,          InstBinary,      "shl"_v,         kInstResult | kInstPure)
YANA_INST(Shr,          InstBinary,      "shr"_v,         kInstResult | kInstPure)
YANA_INST(Sar,          InstBinary,      "sar"_v,         kInstResult | kInstPure)
YANA_INST(And,          InstBinary,      "and"_v,         kInstResult | kInstPure)
YANA_INST(Or,           InstBinary,      "or"_v,          kInstResult | kInstPure)
YANA_INST(Xor,          InstBinary,      "xor"_v,         kInstResult | kInstPure)
YANA_INST(Cmp,          InstCmp,         "cmp"_v,         kInstResult | kInstPure)
// Pure because both of its arms are: a select is only ever built out of values that may be computed
// unconditionally, so there is nothing in one that recomputing could repeat and nothing that not
// computing it could skip. See convertSelects, which is where that holds.
YANA_INST(Select,       InstSelect,      "select"_v,      kInstResult | kInstPure)
/*
 * Vectors - Implementation-Vector.md §3.2, and five kinds rather than the dozen a portable vector
 * set names.
 *
 * Most of the operation set is not here, and that is the point of the section: `Add` through `Xor`,
 * `Neg`, `Not`, `Cmp` and `Select` all take vector operands with no new kind, so `opt_fold`, CSE, the
 * forwarding passes and the verifier keep working on them unchanged - an `InstBinary` over a vector
 * is an `InstBinary`. `Cmp` over one answers a `Mask` instead of a `Bool`, which is a typing rule
 * rather than an instruction, and `Select` over a mask is the lane-wise select, which is the same
 * instruction with a wider condition.
 *
 * Nor are the conversions here. A lane-count-preserving one is `Widen`, `Narrow` or `Bitcast` over
 * vector types and lowers to the `Cast` and `Bitcast` above; one that changes the lane count is a
 * `VecShuffle` and a `Cast`. Both are instances in stage 9 rather than kinds here.
 *
 * All five are pure: none reads storage and none has an effect, so each may be recomputed, hoisted
 * or dropped. The lane index and the shuffle pattern are *fields* rather than operands, because the
 * resolver has already rejected a runtime one (Design-Vector §3.3) - so nothing downstream handles a
 * dynamic case and nothing has to prove an index constant.
 */
YANA_INST(VecSplat,     InstVecSplat,    "vsplat"_v,      kInstResult | kInstPure)
YANA_INST(VecLane,      InstVecLane,     "vlane"_v,       kInstResult | kInstPure)
YANA_INST(VecWithLane,  InstVecLane,     "vwithlane"_v,   kInstResult | kInstPure)
YANA_INST(VecShuffle,   InstVecShuffle,  "vshuffle"_v,    kInstResult | kInstPure)
YANA_INST(VecReduce,    InstVecReduce,   "vreduce"_v,     kInstResult | kInstPure)
YANA_INST(Symbol,       InstSymbol,      "symbol"_v,      kInstResult | kInstPure)
YANA_INST(Call,         InstCall,        "call"_v,        kInstResult)
YANA_INST(CallDyn,      InstCallDyn,     "calldyn"_v,     kInstResult)
YANA_INST(GenCall,      InstGenCall,     "gencall"_v,     kInstResult)
YANA_INST(Je,           InstJe,          "je"_v,          kInstTerminator)
YANA_INST(Jmp,          InstJmp,         "jmp"_v,         kInstTerminator)
YANA_INST(Ret,          InstRet,         "ret"_v,         kInstTerminator)
// Ends a block without leaving it and without answering anything - see InstUnreachable, and §10 item
// 2 of test/bench/findings.md for the check arm that is the only thing which produces one.
YANA_INST(Unreachable,  InstUnreachable, "unreachable"_v, kInstTerminator)
YANA_INST(Phi,          InstPhi,         "phi"_v,         kInstResult)
