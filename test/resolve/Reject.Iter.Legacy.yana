-- The rules of `Reject.Iter.yana` the default stage does not refuse yet: a `for` over a call one
-- argument short, and over an iterator that hands over nothing. It says "no rule finds one from
-- the type of a value" for the first and accepts the second. Move each back when it does.

iter fn upTo(limit: Int) -> Int:
    let &i = 0 :: Int

    while i < limit:
        yield i
        i = i + 1

iter fn ticks(n: Int):
    yield {}

-- One argument short of what the iterator declared, which is not the lens call site's "the block is
-- the missing argument": a loop always supplies the body.
fn wrongArity(n: Int) -> Int:
    for x in upTo():
        return x

    return 0

-- An iterator that hands over nothing gives the loop's pattern nothing to bind.
fn nothingHanded(n: Int) -> Int:
    for x in ticks(n):
        return 1

    return 0

fn main() -> Int = 0
