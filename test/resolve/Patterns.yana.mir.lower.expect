mut @trace = [0, 0, 0, 0]

Guard.drop<complex>(%v_0: I32) {
  b_1 {
    %v_2 = loads @trace, 4: I32
    %v_3 = add %v_2, %v_0: I32
    store @trace, %v_3, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 12, 4: Ptr
    %v_2 = add %v_1, 4: Ptr
    store %v_2, 1, 4
    store %v_1, 0, 1
    call_complex teardown(Box), %v_1
    %v_3 = imm 2: I32
    %v_4 = loads @trace, 4: I32
    call_complex Guard.drop, 4
    %v_5 = imul %v_4, 100: I32
    %v_6 = loads @trace, 4: I32
    %v_7 = add %v_5, %v_6: I32
    %v_8 = add %v_7, 0: I32
    %v_9 = alloca 12, 4: Ptr
    %v_10 = add %v_9, 4: Ptr
    store %v_10, 8, 4
    %v_11 = add %v_9, 8: Ptr
    store %v_11, 16, 4
    store %v_9, 1, 1
    %v_12 = imm 8: I32
    call_complex Guard.drop, %v_12
    %v_13 = loads %v_11, 4: I32
    %v_14 = load %v_11, 4: I32
    call_complex Guard.drop, %v_14
    %v_15 = add %v_12, %v_13: I32
    %v_16 = imm 32: I32
    call_complex Guard.drop, %v_16
    jmp b_17
  }

  b_18 {
    %v_19 = add 141, 1: I32
    call_complex Guard.drop, %v_3
    %v_20 = add %v_19, %v_3: I32
    %v_21 = add %v_20, %v_8: I32
    %v_22 = add %v_21, %v_15: I32
    %v_23 = add %v_22, %v_16: I32
    %v_24 = add %v_23, 17: I32
    %v_25 = add %v_24, %v_26: I32
    %v_27 = loads @trace, 4: I32
    %v_28 = add %v_25, %v_27: I32
    ret %v_28
  }

  b_17 {
    %v_29 = phi [b_30, %v_26], [b_0, 0]: I32
    %v_31 = phi [b_30, %v_32], [b_0, 4]: I32
    %v_26 = add %v_29, %v_31: I32
    %v_33 = cmp_igt %v_31, 1: I32
    je %v_33, b_34, b_35
  }

  b_35 {
    jmp b_30
  }

  b_34 {
    %v_36 = sub %v_31, 1: I32
    jmp b_30
  }

  b_30 {
    %v_37 = phi [b_35, 1], [b_34, 0]: I32
    %v_32 = phi [b_35, 0], [b_34, %v_36]: I32
    je %v_37, b_18, b_17
  }
}

teardown(Box)<complex>(%v_0: Ptr) {
  b_1 {
    %v_2 = load %v_0, 1: I32
    %v_3 = cmp_eq %v_2, 0: I32
    je %v_3, b_4, b_5
  }

  b_6 {
    ret 
  }

  b_4 {
    %v_7 = add %v_0, 4: Ptr
    %v_8 = load %v_7, 4: I32
    call_complex Guard.drop, %v_8
    jmp b_6
  }

  b_5 {
    %v_9 = cmp_eq %v_2, 1: I32
    je %v_9, b_10, b_11
  }

  b_10 {
    %v_12 = add %v_0, 4: Ptr
    %v_13 = load %v_12, 4: I32
    call_complex Guard.drop, %v_13
    %v_14 = add %v_0, 8: Ptr
    %v_15 = load %v_14, 4: I32
    call_complex Guard.drop, %v_15
    jmp b_6
  }

  b_11 {
    jmp b_6
  }
}

