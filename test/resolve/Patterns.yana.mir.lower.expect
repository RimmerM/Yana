mut @trace = [0, 0, 0, 0]

Guard.drop<complex>(%v_0: I32) {
  b_1 {
    %v_2 = loads @trace, 4: I32
    %v_3 = add %v_2, %v_0: I32
    store @trace, %v_3, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 12, 4: Ptr
    %v_2 = add %v_1, 4: Ptr
    store %v_2, 1, 4
    store %v_1, 0, 1
    call_complex teardown(Box), %v_1
    %v_3 = loads @trace, 4: I32
    call_complex Guard.drop, 4
    %v_4 = imul %v_3, 100: I32
    %v_5 = loads @trace, 4: I32
    %v_6 = add %v_4, %v_5: I32
    call_complex Guard.drop, 8
    call_complex Guard.drop, 16
    %v_7 = imm 32: I32
    call_complex Guard.drop, %v_7
    jmp b_8
  }

  b_9 {
    call_complex Guard.drop, 2
    %v_10 = add 144, %v_6: I32
    %v_11 = add %v_10, 24: I32
    %v_12 = add %v_11, %v_7: I32
    %v_13 = add %v_12, 17: I32
    %v_14 = add %v_13, %v_15: I32
    %v_16 = loads @trace, 4: I32
    %v_17 = add %v_14, %v_16: I32
    ret %v_17
  }

  b_8 {
    %v_18 = phi [b_19, %v_15], [b_0, 0]: I32
    %v_20 = phi [b_19, %v_21], [b_0, 4]: I32
    %v_15 = add %v_18, %v_20: I32
    %v_22 = cmp_igt %v_20, 1: I32
    je %v_22, b_23, b_24
  }

  b_24 {
    jmp b_19
  }

  b_23 {
    %v_25 = sub %v_20, 1: I32
    jmp b_19
  }

  b_19 {
    %v_26 = phi [b_24, 1], [b_23, 0]: I32
    %v_21 = phi [b_24, 0], [b_23, %v_25]: I32
    je %v_26, b_9, b_8
  }
}

teardown(Box)<complex>(%v_0: Ptr) {
  b_1 {
    %v_2 = load %v_0, 1: I32
    %v_3 = cmp_eq %v_2, 0: I32
    je %v_3, b_4, b_5
  }

  b_6 {
    ret 
  }

  b_4 {
    %v_7 = add %v_0, 4: Ptr
    %v_8 = load %v_7, 4: I32
    call_complex Guard.drop, %v_8
    jmp b_6
  }

  b_5 {
    %v_9 = cmp_eq %v_2, 1: I32
    je %v_9, b_10, b_11
  }

  b_10 {
    %v_12 = add %v_0, 4: Ptr
    %v_13 = load %v_12, 4: I32
    call_complex Guard.drop, %v_13
    %v_14 = add %v_0, 8: Ptr
    %v_15 = load %v_14, 4: I32
    call_complex Guard.drop, %v_15
    jmp b_6
  }

  b_11 {
    jmp b_6
  }
}

