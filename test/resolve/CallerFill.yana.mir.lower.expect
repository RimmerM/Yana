  b_76 {
    %v_77 = add %left, %v_74: Ptr
    %v_78 = load %v_77, 1: I32
    %v_79 = add %right, %v_74: Ptr
    %v_80 = load %v_79, 1: I32
    %v_81 = cmp_lt %v_78, %v_80: I32
    je %v_81, b_82, b_83
  }

  b_84 {
    %v_85 = phi [b_63, %v_86], [b_62, 0]: I32
    ret %v_85
  }

  b_63 {
    %v_87 = cmp_eq %v_58, %v_60: I32
    %v_86 = select %v_87, 1, 2: I32
    jmp b_84
  }

  b_62 {
    jmp b_84
  }

  b_88 {
    %v_89 = phi [b_83, %v_90], [b_82, 0]: I32
    ret %v_89
  }

  b_83 {
    %v_91 = cmp_eq %v_78, %v_80: I32
    %v_90 = select %v_91, 1, 2: I32
    jmp b_88
  }

  b_82 {
    jmp b_88
  }
}

