import Native

-- A sum type whose tag is bits above its payload rather than a word in front of it - the case niche
-- folding cannot reach, because a payload that fills its own storage has no impossible pattern to
-- fold into. `data Sum = A(U8) | B(U8)` holds one byte and one bit and used to cost eight bytes; here
-- it is two. See scalarizeSum.
--
-- Asserted behaviourally rather than only in the layout dump, because every interesting failure is
-- invisible in the size. A tag written with a plain store instead of a read-modify-write erases the
-- payload it shares a word with; a payload placed above the tag instead of below it erases the tag;
-- and a niche taken over storage nobody zeroed decodes a `Just` as a `Nothing`. All three produce a
-- record of exactly the right number of bytes.

-- One byte of payload, one bit of tag, two bytes in total.
data Sum = A(U8) | B(U8)

-- Three bytes of payload under a one-bit tag: four bytes, where a tag word made it eight. The
-- multi-field constructor is what catches a payload whose fields were placed relative to the tag
-- rather than relative to the record.
data Colour = R {r: U8, g: U8, b: U8} | Gray(U8)

-- Five constructors, so three bits of tag above the same byte of payload. A tag mask that was
-- computed from the constructor count rather than from the field's width reads C4 as C0.
data Five = C0(U8) | C1(U8) | C2(U8) | C3(U8) | C4(U8)

-- A payload that is itself a co-packed scalar record, which puts a read-modify-write on both sides of
-- one word: the two flag bits are the payload's and the ninth bit is the tag's, and neither write may
-- touch the other's bits.
data Flags {a: Bool, b: Bool}

data Tagged = Set(Flags) | Unset(Flags)

-- Declines, and the layout dump is where that is asserted: a four-byte payload under a one-bit tag
-- needs eight bytes, which is exactly what the tag word form already cost. A bit tag is a shift and a
-- mask where a tag word is a load, so where the two are the same size the word is the better answer.
data Wide = W1(U32) | W2(U32)

fn payloadOf(s: Sum) -> Int = match s:
    A(x) -> (x :: Int)
    B(x) -> (x :: Int) + 1000

fn colourOf(c: Colour) -> Int = match c:
    R {r: red, g: green, b: blue} -> (red :: Int) + (green :: Int) * 10 + (blue :: Int) * 100
    Gray(level) -> (level :: Int) * 1000

fn fiveOf(f: Five) -> Int = match f:
    C0(x) -> (x :: Int)
    C1(x) -> (x :: Int) * 10
    C2(x) -> (x :: Int) * 100
    C3(x) -> (x :: Int) * 1000
    C4(x) -> (x :: Int) * 10000

fn flagsValue(f: Flags) -> Int = (if f.a then 1 else 0) + (if f.b then 2 else 0)

fn taggedOf(t: Tagged) -> Int = match t:
    Set(f) -> flagsValue(f)
    Unset(f) -> flagsValue(f) + 100

fn widthOf(w: Wide) -> Int = match w:
    W1(x) -> (x :: Int)
    W2(x) -> (x :: Int) * 10

fn bump(&x: U8): x = x + 1

-- Both constructors, round-tripped through storage. A tag stored over the payload gives A(0) here,
-- and a payload stored over the tag decodes the second one as the first.
fn roundTrip() -> Int = payloadOf(A(7)) + payloadOf(B(9))

-- The tag of the widest payload, which is where the tag sits above three bytes rather than one.
fn coloured() -> Int = colourOf(R {r: 1, g: 2, b: 3}) + colourOf(Gray(4))

-- A three-bit tag, at both ends of its range. C4 is the constructor a one-bit mask loses.
fn counted() -> Int = fiveOf(C0(1)) + fiveOf(C4(1))

-- A payload that is bits of the same word as the tag. Each of the three writes here is a
-- read-modify-write of one byte, and any of them dropping its merge takes the other two with it.
fn packedPayload() -> Int = taggedOf(Set(Flags {a: True, b: True})) + taggedOf(Unset(Flags {a: False, b: True}))

-- Writing a payload field in place, then reading the tag back. This is the assertion that a payload
-- store stays below the tag: `bump` is handed the address of a byte inside the tagged word, so a
-- payload that had been placed above the tag would hand out an address that overlaps it.
fn mutated() -> Int:
    let &s = A(41)

    match s:
        A(x) -> bump(x)
        B(x) -> bump(x)

    return payloadOf(s)

-- A whole payload assigned as one value rather than field by field, which is a copy of the payload's
-- own size. The tag has to be past those bytes - it is placed above the payload's whole storage,
-- padding included, for exactly this reason - or the copy erases it.
fn copied() -> Int:
    let f = Flags {a: True, b: False}
    let t = Unset(f)

    return taggedOf(t)

-- `Maybe` over a bit-tagged sum, which folds into the patterns above the tag: nine bits are reachable
-- in a two-byte word, so `Nothing` is pattern 512 and the whole `Maybe` is still two bytes.
--
-- This is what makes the zeroing at the allocation load-bearing rather than tidy. The bits the niche
-- is made of are the ones above the tag, and nothing writes them: a tag write is a read-modify-write
-- that preserves everything it does not own. So a `Just` built over storage that happened to hold a
-- high bit decodes as some other constructor - see ReprTable::hasPaddedWord.
fn maybeOf(m: Maybe(Sum)) -> Int = match m:
    Nothing -> 500
    Just(s) -> payloadOf(s)

fn folded() -> Int = maybeOf(Nothing) + maybeOf(Just(A(2))) + maybeOf(Just(B(3)))

-- The declined shape, run as well as measured, so that the fallback keeps working while the new form
-- exists beside it.
fn wide() -> Int = widthOf(W1(5)) + widthOf(W2(6))

-- roundTrip:     7 + (9 + 1000)                                = 1016
-- coloured:      (1 + 20 + 300) + 4000                         = 4321
-- counted:       1 + 10000                                     = 10001
-- packedPayload: 3 + (2 + 100)                                 = 105
-- mutated:       42                                            = 42
-- copied:        1 + 100                                       = 101
-- folded:        500 + 2 + (3 + 1000)                          = 1505
-- wide:          5 + 60                                        = 65
fn main() -> Int =
    roundTrip() + coloured() + counted() + packedPayload() + mutated() + copied() + folded() + wide()
