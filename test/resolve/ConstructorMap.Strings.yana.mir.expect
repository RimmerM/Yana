fn twice(c: Colour [shared call]) -> I32 {
  local first: String
  local second: String

bb0:
  %0: Colour = read copy.trivial (c)
  %1: String = call nameOf borrow.shared %0
  write.init borrow.unique (first) take %1
  %3: Colour = read copy.trivial (c)
  %4: String = call nameOf borrow.shared %3
  write.init borrow.unique (second) take %4
  %6: String [shared call] = read borrow.shared (first) loan0
  %7: String [shared slot 0 view] = call.derivation view(String) borrow.shared %6 roots{0}
  %8: String [shared call] = read borrow.shared (second) loan1
  %9: String [shared slot 0 view] = call.derivation view(String) borrow.shared %8 roots{1}
  %10: Bool = call ==(String) borrow.shared %7 borrow.shared %9
  %11: I32 = const 1
  %12: I32 = call check borrow.shared %10 borrow.shared %11
  %13: String [shared call] = read borrow.shared (first) loan2
  %14: String [shared slot 0 view] = call.derivation view(String) borrow.shared %13 roots{2}
  %15: Size = call length(String) borrow.shared %14
  drop (first)
  %16: String [shared call] = read borrow.shared (second) loan3
  %17: String [shared slot 0 view] = call.derivation view(String) borrow.shared %16 roots{3}
  %18: Size = call length(String) borrow.shared %17
  drop (second)
  %19: Bool = eq inspect %15 inspect %18
  %20: I32 = const 2
  %21: I32 = call check borrow.shared %19 borrow.shared %20
  %22: I32 = add inspect %12 inspect %21
  return take %22
}

