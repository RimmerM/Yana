let image$base: () = <none>

let &counter: I32 = 0

fn bump(%step: I32) -> () {
  b0:
    %v1 = load counter : I32
    %v2 = add %v1, %step : I32
    assign counter, %v2
    ret
}

fn area(%w: I32, %h: I32) -> I32 {
  b0:
    %v2 = mul %w, %h : I32
    ret %v2
}

fn twice(%n: I32) -> I32 {
  b0:
    %v1 = add %n, %n : I32
    ret %v1
}

fn fib(%n: I32) -> I32 {
  b0:
    %v3 = cmp_lt %n, 2 : Bool
    je %v3, b1, b2

  b1:
    jmp b3

  b2:
    %v7 = sub %n, 1 : I32
    %v8 = call fib, %v7 : I32
    %v11 = sub %n, 2 : I32
    %v12 = call fib, %v11 : I32
    %v13 = add %v8, %v12 : I32
    jmp b3

  b3:
    %v16 = phi [b1, %n], [b2, %v13] : I32
    ret %v16
}

fn unreached() -> I32 {
  b0:
    ret 99
}

fn main() -> I32 {
  b0:
    call bump, 4
    call bump, 6
    %v6 = call area, 3, 5 : I32
    %v8 = call twice, 11 : I32
    %v9 = add %v6, %v8 : I32
    %v11 = call fib, 10 : I32
    %v12 = add %v9, %v11 : I32
    %v13 = load counter : I32
    %v14 = add %v12, %v13 : I32
    ret %v14
}
