
oneMetre<complex>(%v_0: Ptr) {
  b_1 {
    %v_2 = alloca 4, 4: Ptr
    call_complex FromInt(Metres).fromInt, %v_2, 1
    copy %v_0, %v_2, 4
    ret 
  }
}

isFive<complex>(%distance$value: Int): Int {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    call_complex FromInt(Metres).fromInt, %v_1, 5
    %rhs$value = loads %v_1, 4: Int
    %v_2 = call_complex Eq(Metres).==, %distance$value, %rhs$value: Int
    ret %v_2
  }
}

inc(Long)<complex>(%x: Long): Long {
  b_0 {
    %v_1 = add %x, 1: Long
    ret %v_1
  }
}

incLong<complex>(): Long {
  b_0 {
    %v_1 = call_complex inc(Long), 40: Long
    ret %v_1
  }
}

Eq(Metres).!=<complex>(%lhs$value: Int, %rhs$value: Int): Int {
  b_0 {
    %v_1 = cmp_neq %lhs$value, %rhs$value: Int
    ret %v_1
  }
}

FromInt(Metres).fromInt<complex>(%v_0: Ptr, %value: Long) {
  b_1 {
    %v_2 = cast %value: Int
    store %v_0, %v_2, 4
    ret 
  }
}

Eq(Metres).==<complex>(%lhs$value: Int, %rhs$value: Int): Int {
  b_0 {
    %v_1 = cmp_eq %lhs$value, %rhs$value: Int
    ret %v_1
  }
}

defaulted<complex>(): Int {
  b_0 {
    %v_1 = ftoi 2.5: Int
    %v_2 = add 7, %v_1: Int
    ret %v_2
  }
}

inc(Int)<complex>(%x: Int): Int {
  b_0 {
    %v_1 = add %x, 1: Int
    ret %v_1
  }
}

measure<complex>(%distance$value: Int): Int {
  b_0 {
    ret %distance$value
  }
}

two(Int)<complex>(): Int {
  b_0 {
    ret 2
  }
}

main<complex>(): Int {
  b_0 {
    %v_1 = call_complex inc(Int), 10: Int
    %v_2 = call_complex inc(Float), 1.5: Float
    %v_3 = ftoi %v_2: Int
    %v_4 = add %v_1, %v_3: Int
    %v_5 = call_complex two(Int): Int
    %v_6 = add %v_4, %v_5: Int
    %v_7 = call_complex defaulted: Int
    %v_8 = add %v_6, %v_7: Int
    %v_9 = call_complex mixedLiterals: Float
    %v_10 = ftoi %v_9: Int
    %v_11 = add %v_8, %v_10: Int
    %v_12 = alloca 4, 4: Ptr
    call_complex oneMetre, %v_12
    %distance$value = loads %v_12, 4: Int
    %v_13 = call_complex measure, %distance$value: Int
    %v_14 = add %v_11, %v_13: Int
    %v_15 = alloca 4, 4: Ptr
    call_complex FromInt(Metres).fromInt, %v_15, 4
    %distance$value = loads %v_15, 4: Int
    %v_16 = call_complex measure, %distance$value: Int
    %v_17 = add %v_14, %v_16: Int
    %v_18 = call_complex isFive, 5: Int
    je %v_18, b_19, b_20
  }

  b_19 {
    jmp b_21
  }

  b_20 {
    jmp b_21
  }

  b_21 {
    %v_22 = phi [b_19, 1], [b_20, 0]: Int
    %v_23 = add %v_17, %v_22: Int
    %v_24 = call_complex incLong: Long
    %v_25 = cast %v_24: Int
    %v_26 = add %v_23, %v_25: Int
    ret %v_26
  }
}

inc(Float)<complex>(%x: Float): Float {
  b_0 {
    %v_1 = add %x, 1: Float
    ret %v_1
  }
}

mixedLiterals<complex>(): Float {
  b_0 {
    %v_1 = add 1, 2.5: Float
    ret %v_1
  }
}

