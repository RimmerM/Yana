
oneMetre<complex>(%v_0: Ptr) {
  b_1 {
    %v_2 = alloca 4, 4: Ptr
    call_complex FromInt(Metres).fromInt, %v_2, 1
    copy %v_0, %v_2, 4
    ret 
  }
}

isFive<complex>(%distance: Ptr): Int {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    call_complex FromInt(Metres).fromInt, %v_1, 5
    %v_2 = call_complex Eq(Metres).==, %distance, %v_1: Int
    ret %v_2
  }
}

inc(Long)<complex>(%x: Long): Long {
  b_0 {
    %v_1 = add %x, 1: Long
    ret %v_1
  }
}

incLong<complex>(): Long {
  b_0 {
    %v_1 = call_complex inc(Long), 40: Long
    ret %v_1
  }
}

Eq(Metres).!=<complex>(%lhs: Ptr, %rhs: Ptr): Int {
  b_0 {
    %v_1 = loads %lhs, 4: Int
    %v_2 = loads %rhs, 4: Int
    %v_3 = cmp_neq %v_1, %v_2: Int
    ret %v_3
  }
}

FromInt(Metres).fromInt<complex>(%v_0: Ptr, %value: Long) {
  b_1 {
    %v_2 = cast %value: Int
    store %v_0, %v_2, 4
    ret 
  }
}

Eq(Metres).==<complex>(%lhs: Ptr, %rhs: Ptr): Int {
  b_0 {
    %v_1 = loads %lhs, 4: Int
    %v_2 = loads %rhs, 4: Int
    %v_3 = cmp_eq %v_1, %v_2: Int
    ret %v_3
  }
}

defaulted<complex>(): Int {
  b_0 {
    %v_1 = ftoi 2.5: Int
    %v_2 = add 7, %v_1: Int
    ret %v_2
  }
}

inc(Int)<complex>(%x: Int): Int {
  b_0 {
    %v_1 = add %x, 1: Int
    ret %v_1
  }
}

measure<complex>(%distance: Ptr): Int {
  b_0 {
    %v_1 = loads %distance, 4: Int
    ret %v_1
  }
}

two(Int)<complex>(): Int {
  b_0 {
    ret 2
  }
}

main<complex>(): Int {
  b_0 {
    %v_1 = call_complex inc(Int), 10: Int
    %v_2 = call_complex inc(Float), 1.5: Float
    %v_3 = ftoi %v_2: Int
    %v_4 = add %v_1, %v_3: Int
    %v_5 = call_complex two(Int): Int
    %v_6 = add %v_4, %v_5: Int
    %v_7 = call_complex defaulted: Int
    %v_8 = add %v_6, %v_7: Int
    %v_9 = call_complex mixedLiterals: Float
    %v_10 = ftoi %v_9: Int
    %v_11 = add %v_8, %v_10: Int
    %v_12 = alloca 4, 4: Ptr
    call_complex oneMetre, %v_12
    %v_13 = call_complex measure, %v_12: Int
    %v_14 = add %v_11, %v_13: Int
    %v_15 = alloca 4, 4: Ptr
    call_complex FromInt(Metres).fromInt, %v_15, 4
    %v_16 = call_complex measure, %v_15: Int
    %v_17 = add %v_14, %v_16: Int
    %v_18 = alloca 4, 4: Ptr
    store %v_18, 5, 4
    %v_19 = call_complex isFive, %v_18: Int
    je %v_19, b_20, b_21
  }

  b_20 {
    jmp b_22
  }

  b_21 {
    jmp b_22
  }

  b_22 {
    %v_23 = phi [b_20, 1], [b_21, 0]: Int
    %v_24 = add %v_17, %v_23: Int
    %v_25 = call_complex incLong: Long
    %v_26 = cast %v_25: Int
    %v_27 = add %v_24, %v_26: Int
    ret %v_27
  }
}

inc(Float)<complex>(%x: Float): Float {
  b_0 {
    %v_1 = add %x, 1: Float
    ret %v_1
  }
}

mixedLiterals<complex>(): Float {
  b_0 {
    %v_1 = add 1, 2.5: Float
    ret %v_1
  }
}

