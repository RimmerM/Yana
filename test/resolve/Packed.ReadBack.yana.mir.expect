module ResolveTest

data Header {version: @bits(4) U32, flags: @bits(3) U32, length: @bits(13) U32}

fn opaque(n: I32 [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (n)
  %1: I32 = const 1
  %2: I32 = add inspect %0 inspect %1
  return take %2
}

fn bumpRead(x: U32 [unique call]) -> U32 {
bb0:
  %0: U32 = read copy.trivial (x)
  %1: U32 = const 20
  %2: U32 = add inspect %0 inspect %1
  write.assign borrow.unique (x) take %2
  %4: U32 = read copy.trivial (x)
  return take %4
}

fn bumpInline(x: U32 [unique call]) -> U32 {
bb0:
  %0: U32 = read copy.trivial (x)
  %1: U32 = const 20
  %2: U32 = add inspect %0 inspect %1
  write.assign borrow.unique (x) take %2
  %4: U32 = read copy.trivial (x)
  return take %4
}

fn twiceWrite(x: U32 [unique call]) -> U32 {
  local seen: U32

bb0:
  %0: U32 = const 100
  write.assign borrow.unique (x) take %0
  %2: U32 = read copy.trivial (x)
  write.init borrow.unique (seen) take %2
  %4: U32 = read copy.trivial (seen)
  %5: U32 = const 1
  %6: U32 = add inspect %4 inspect %5
  write.assign borrow.unique (x) take %6
  %8: U32 = read copy.trivial (seen)
  return take %8
}

fn bumpLoop(x: U32 [unique call], n: I32 [shared call]) -> U32 {
  local & local2: I32
  local i: I32

bb0:
  %0: I32 = read copy.trivial (n)
  %1: I32 = const 0
  %2: I32 = const 1
  write.init borrow.unique (local2) take %1
  jump -> bb1(take %0, take %2)

bb1(%3: I32, %4: I32):
  %11: I32 = read copy.trivial (local2)
  %12: Bool = lt inspect %11 inspect %3
  branch inspect %12 -> bb4(take %3, take %4) -> bb3(take %3, take %4)

bb2(%5: I32, %6: I32):
  %40: I32 = read copy.trivial (local2)
  %41: I32 = add inspect %40 inspect %6
  write.assign borrow.unique (local2) take %41
  jump -> bb1(take %5, take %6)

bb3(%7: I32, %8: I32):
  %44: U32 = read copy.trivial (x)
  return take %44

bb4(%13: I32, %14: I32):
  %16: I32 = read copy.trivial (local2)
  write.init borrow.unique (i) take %16
  %18: U32 = read copy.trivial (x)
  %19: U32 = const 10
  %20: U32 = add inspect %18 inspect %19
  write.assign borrow.unique (x) take %20
  %22: I32 = read copy.trivial (i)
  %23: I32 = call opaque borrow.shared %22
  %24: I32 = const 100
  %25: Bool = gt inspect %23 inspect %24
  branch inspect %25 -> bb7(take %13, take %14) -> bb5(take %13, take %14)

bb5(%26: I32, %27: I32):
  jump -> bb6(take %26, take %27)

bb6(%35: I32, %36: I32):
  jump -> bb2(take %35, take %36)

bb7(%28: I32, %29: I32):
  %31: U32 = read copy.trivial (x)
  %32: U32 = const 1
  %33: U32 = add inspect %31 inspect %32
  write.assign borrow.unique (x) take %33
  jump -> bb6(take %28, take %29)
}

fn main() -> I32 {
  local & h: Header
  local r1: U32
  local r2: U32
  local r3: U32
  local r4: U32
  local r5: U32
  local results: U32
  local fields: U32

bb0:
  %0: U32 = const 3
  %1: @bits(4) U32 = convert inspect %0
  %2: U32 = const 5
  %3: @bits(3) U32 = convert inspect %2
  %4: U32 = const 1000
  %5: @bits(13) U32 = convert inspect %4
  %6: Header = aggregate.Header take %1 take %3 take %5
  write.init borrow.unique (h) take %6
  %8: @bits(4) U32 [unique call] = read borrow.unique (h.version) loan0
  %9: U32 = call bumpRead borrow.unique %8
  write.init borrow.unique (r1) take %9
  %11: @bits(4) U32 [unique call] = read borrow.unique (h.version) loan1
  %12: U32 = call bumpInline borrow.unique %11
  write.init borrow.unique (r2) take %12
  %14: @bits(3) U32 [unique call] = read borrow.unique (h.flags) loan2
  %15: U32 = call twiceWrite borrow.unique %14
  write.init borrow.unique (r3) take %15
  %17: @bits(13) U32 [unique call] = read borrow.unique (h.length) loan3
  %18: I32 = const 3
  %19: U32 = call bumpLoop borrow.unique %17 borrow.shared %18
  write.init borrow.unique (r4) take %19
  %21: @bits(4) U32 [unique call] = read borrow.unique (h.version) loan4
  %22: I32 = const 2
  %23: U32 = call bumpLoop borrow.unique %21 borrow.shared %22
  write.init borrow.unique (r5) take %23
  %25: U32 = read copy.trivial (r1)
  %26: U32 = read copy.trivial (r2)
  %27: U32 = add inspect %25 inspect %26
  %28: U32 = read copy.trivial (r3)
  %29: U32 = add inspect %27 inspect %28
  %30: U32 = read copy.trivial (r4)
  %31: U32 = add inspect %29 inspect %30
  %32: U32 = read copy.trivial (r5)
  %33: U32 = add inspect %31 inspect %32
  write.init borrow.unique (results) take %33
  %35: @bits(4) U32 = read copy.trivial (h.version)
  %36: U32 = convert inspect %35
  %37: @bits(3) U32 = read copy.trivial (h.flags)
  %38: U32 = convert inspect %37
  %39: U32 = add inspect %36 inspect %38
  %40: @bits(13) U32 = read copy.trivial (h.length)
  %41: U32 = convert inspect %40
  %42: U32 = add inspect %39 inspect %41
  write.init borrow.unique (fields) take %42
  %44: U32 = read copy.trivial (results)
  %45: U32 = const 10000
  %46: U32 = mul inspect %44 inspect %45
  %47: U32 = read copy.trivial (fields)
  %48: U32 = add inspect %46 inspect %47
  %49: I32 = bitcast inspect %48
  return take %49
}

entry main
