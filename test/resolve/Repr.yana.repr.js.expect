Bool: size 1, align 1, stride 1, tag word at 0, payload at 0, scalar of 1 bits, niche at 0 width 1, valid 0..1, free 0 below / 254 above

Ordering: size 1, align 1, stride 1, tag word at 0, payload at 0, scalar of 2 bits, niche at 0 width 1, valid 0..2, free 0 below / 253 above

Flags: size 1, align 1, stride 1, scalar of 2 bits, niche at 0 width 1, valid 0..3, free 0 below / 252 above
  .0 at 0 bits 0..0 of 1 bytes: Bool
  .1 at 0 bits 1..1 of 1 bytes: Bool

Held: size 8, align 8, stride 8, niche absent
  .0 at 0: &Int

Raw: size 8, align 8, stride 8, niche absent
  .0 at 0: %U8

Wrapped: size 8, align 8, stride 8, niche absent
  .0 at 0: @bits(53) U64
