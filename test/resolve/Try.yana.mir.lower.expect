Token.drop<complex>(%v_0: I32) {
  b_1 {
    %v_2 = loads @dropped, 4: I32
    %v_3 = add %v_2, 1: I32
    store @dropped, %v_3, 4
    ret 
  }
}

looped<complex>(%n: I32): I32, I32 {
  b_0 {
    jmp b_1
