mut @log = [0, 0, 0, 0]
mut @dropped = [0, 0, 0, 0]

Token.drop<complex>() {
  b_0 {
    %v_1 = loads @dropped, 4: I32
    %v_2 = add %v_1, 1: I32
    store @dropped, %v_2, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    store @log, 1, 4
    store @log, 2, 4
    store @log, 3, 4
    store @log, 4, 4
    store @log, 5, 4
    store @log, 6, 4
    store @log, 7, 4
    store @log, 8, 4
    store @log, 9, 4
    store @log, 10, 4
    store @log, 11, 4
    store @log, 12, 4
    store @log, 22, 4
    store @log, 32, 4
    store @log, 42, 4
    store @log, 43, 4
    jmp b_1
  }

  b_2 {
    %v_3 = cmp_ilt %v_4, 3: I32
    je %v_3, b_1, b_5
  }

  b_5 {
    jmp b_6
  }

  b_1 {
    %v_7 = phi [b_2, %v_8], [b_0, 0]: I32
    %v_9 = phi [b_2, %v_4], [b_0, 0]: I32
    %v_10 = sub 4, %v_9: I32
    %v_11 = loads @log, 4: I32
    %v_12 = add %v_11, 1: I32
    store @log, %v_12, 4
    %v_13 = shl %v_10, 1: I32
    %v_8 = add %v_7, %v_13: I32
    %v_4 = add %v_9, 1: I32
    jmp b_2
  }

  b_14 {
    %v_15 = phi [b_16, 1], [b_17, 0]: I32
    %v_18 = loads @log, 4: I32
    %v_19 = add %v_18, 1001: I32
    store @log, %v_19, 4
    %v_20 = add %v_18, 11001: I32
    store @log, %v_20, 4
    %v_21 = add %v_18, 11002: I32
    store @log, %v_21, 4
    %v_22 = add %v_18, 11003: I32
    store @log, %v_22, 4
    store @dropped, 0, 4
    call_complex Token.drop
    call_complex Token.drop
    %v_23 = loads @dropped, 4: I32
    store @dropped, 0, 4
    %v_24 = alloca 8, 4: Ptr
    %v_25 = alloca 8, 4: Ptr
    store %v_25, 0, 1
    call_complex teardown(Maybe(Token)), %v_25
    store %v_24, 1, 1
    call_complex teardown(Outcome(Token, {})), %v_24
    call_complex Token.drop
    %v_26 = loads @dropped, 4: I32
    store @dropped, 0, 4
    %v_27 = alloca 8, 4: Ptr
    %v_28 = alloca 8, 4: Ptr
    store %v_28, 0, 1
    call_complex teardown(Maybe(Token)), %v_28
    store %v_27, 1, 1
    call_complex teardown(Outcome(Token, {})), %v_27
    %v_29 = loads @dropped, 4: I32
    %v_30 = add 174, %v_8: I32
    %v_31 = add %v_30, 20: I32
    %v_32 = add %v_31, 11: I32
    %v_33 = add %v_32, 7: I32
    %v_34 = neg %v_15: I32
    %v_35 = add %v_34, 1: I32
    %v_36 = add 3, %v_35: I32
    %v_37 = add %v_36, 1: I32
    %v_38 = add %v_37, 1: I32
    %v_39 = add %v_38, 1: I32
    %v_40 = add %v_39, 1: I32
    %v_41 = imul %v_40, 1000: I32
    %v_42 = add %v_33, %v_41: I32
    %v_43 = imul %v_23, 100000: I32
    %v_44 = add %v_42, %v_43: I32
    %v_45 = imul %v_26, 10000000: I32
    %v_46 = add %v_44, %v_45: I32
    %v_47 = imul %v_29, 1000000000: I32
    %v_48 = add %v_46, %v_47: I32
    %v_49 = loads @log, 4: I32
    %v_50 = add %v_48, %v_49: I32
    ret %v_50
  }

  b_16 {
    jmp b_14
  }

  b_6 {
    %v_51 = phi [b_52, %v_53], [b_5, 0]: I32
    %v_54 = phi [b_52, %v_55], [b_5, 0]: I32
    %v_56 = sub 1, %v_54: I32
    %v_57 = loads @log, 4: I32
    %v_58 = add %v_57, 1: I32
    store @log, %v_58, 4
    %v_59 = cmp_igt %v_56, 0: I32
    je %v_59, b_52, b_17
  }

  b_17 {
    jmp b_14
  }

  b_52 {
    %v_60 = shl %v_56, 1: I32
    %v_53 = add %v_51, %v_60: I32
    %v_55 = add %v_54, 1: I32
    %v_61 = cmp_ilt %v_55, 3: I32
    je %v_61, b_6, b_16
  }
}

teardown(Maybe(Token))<complex>(%v_0: Ptr) {
  b_1 {
    %v_2 = load %v_0, 1: I32
    %v_3 = cmp_eq %v_2, 1: I32
    je %v_3, b_4, b_5
  }

  b_6 {
    ret 
  }

  b_4 {
    call_complex Token.drop
    jmp b_6
  }

  b_5 {
    jmp b_6
  }
}

teardown(Outcome(Token, {}))<complex>(%v_0: Ptr) {
  b_1 {
    %v_2 = load %v_0, 1: I32
    %v_3 = cmp_eq %v_2, 0: I32
    je %v_3, b_4, b_5
  }

  b_6 {
    ret 
  }

  b_4 {
    call_complex Token.drop
    jmp b_6
  }

  b_5 {
    jmp b_6
