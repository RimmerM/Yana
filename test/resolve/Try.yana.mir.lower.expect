    %v_8 = sub %n, %v_6: I32
    %v_9 = loads @log, 4: I32
    %v_10 = add %v_9, 1: I32
    store @log, %v_10, 4
    %v_11 = cmp_igt %v_8, 0: I32
    je %v_11, b_5, b_12
  }

  b_12 {
    ret 0, 0
  }

  b_5 {
    %v_13 = shl %v_8, 1: I32
    %v_3 = add %v_4, %v_13: I32
    %v_7 = add %v_6, 1: I32
    %v_14 = cmp_ilt %v_7, 3: I32
    je %v_14, b_1, b_2
  }
}

