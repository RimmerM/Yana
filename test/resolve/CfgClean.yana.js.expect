"use strict";
var live = 0;
var trace = 0;

// ResolveTest
function take(h) {
  Drop_Held_drop(h);
  return h;
}

function nested(n) {
  var sum = 0;
  live = live + 1 | 0;
  var i = 0;
  L0: for (;;) {
    B1: {
      if (i < n) {
        if (i > 2) {
          var v48 = take(n);
          var v90 = 0;
          if (v48 > 4) {
            v90 = 1;
          } else {
            sum = Math.imul(sum, 10) + v48 | 0;
            v90 = 0;
          }
          if (v90 === 1) {
            break L0;
          }
        } else {
          var v69 = 0;
          if (i > 4) {
            v69 = 1;
          } else {
            sum = Math.imul(sum, 10) + i | 0;
            v69 = 0;
          }
          if (v69 === 1) {
            Drop_Held_drop(n);
            break L0;
          } else {
            i = i + 1 | 0;
            continue L0;
          }
        }
      } else {
        Drop_Held_drop(n);
      }
    }
    break L0;
  }
  return sum;
}

function main() {
  return (Math.imul((((Math.imul(nested(0), 3) + 35 | 0) + Math.imul(nested(3), 5) | 0) + Math.imul(nested(6), 7) | 0) + 769 | 0, 1000) + Math.imul(trace, 10) | 0) + live | 0;
}

function Drop_Held_drop(self) {
  live = live - 1 | 0;
  trace = Math.imul(trace, 10) + self | 0;
}
main();
