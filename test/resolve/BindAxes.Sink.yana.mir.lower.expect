    %v_1 = load %value, 8: Ptr
    %v_2 = add %value, 8: Ptr
    %v_3 = load %v_2, 4: I64
    %v_4 = add %value, 12: Ptr
    %v_5 = load %v_4, 4: I32
    %v_6 = shr %v_3, 30: I64
    %v_7 = cast %v_6: I32
    %v_8 = load @runFromHeap, 4: I32
    %v_9 = cmp_eq %v_7, %v_8: I32
    je %v_9, b_10, b_11
  }

  b_10 {
    call_complex freeHeap, %v_1
    jmp b_11
  }

  b_11 {
    ret 
  }
}

