"use strict";
// ResolveTest
function invariant(count) {
  var total = 0;
  var i = 0;
  L0: for (;;) {
    if (i < count) {
      total = total + 12 | 0;
      i = i + 1 | 0;
      continue L0;
    }
    break L0;
  }
  return total;
}

function carried(count) {
  var i = 0;
  var v27 = 0;
  L0: for (;;) {
    if (i < count) {
      var v16 = v27 + 5 | 0;
      i = i + 1 | 0;
      v27 = v16;
      continue L0;
    }
    break L0;
  }
  return v27;
}

function main() {
  return ((invariant(3) + 53 | 0) + carried(4) | 0) + 17 | 0;
}
main();
