}

function nested(a) {
  var v5 = a + 1 | 0;
  if (a > 0) {
    return (a + v5 | 0) + 5 | 0;
  } else {
    return 5;
  }
}

function escaped(a) {
  return (a > 0 ? a + 1 | 0 : a) + 1 | 0;
}

function main() {
  return ((invariant(3) + 53 | 0) + carried(4) | 0) + 17 | 0;
}
