"use strict";
// ResolveTest
function widen(p) {
  p.x = p.x + 1 | 0;
  return;
}

function branched(a) {
  var v4 = a + 1 | 0;
  if (a > 0) {
    return a + v4 | 0;
  } else {
    return v4;
  }
}

function partial(a) {
  return (a > 0 ? 30 : 2) + 1 | 0;
}

function merged(a) {
  return (a > 5 ? 20 : a > 0 ? 10 : 0) + 7 | 0;
}

function invariant(count) {
  var total = 0;
  var i = 0;
  L0: for (;;) {
    if (i < count) {
      total = total + 12 | 0;
      i = i + 1 | 0;
      continue L0;
    }
    break L0;
  }
  return total;
}

function carried(count) {
  var i = 0;
  var v28 = 0;
  L0: for (;;) {
    if (i < count) {
      var v17 = v28 + 5 | 0;
      i = i + 1 | 0;
      v28 = v17;
      continue L0;
    }
    break L0;
  }
