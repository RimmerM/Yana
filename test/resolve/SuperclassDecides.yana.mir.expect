module ResolveTest

class Lane(v -> m): cmp, pick

class (Lane(a, m)) Rated(a -> m): rating

instance Lane(I32, Bool): I32.cmp, I32.pick

instance Rated(I32, Bool): I32.rating

fn cmp(lhs: v [shared call], rhs: v [shared call]) -> m = <no body>

fn pick(mask: m [shared call], ifTrue: v [shared call], ifFalse: v [shared call]) -> v = <no body>

fn rating(x: a [shared call]) -> a = <no body>

fn I32.cmp(lhs: I32 [shared call], rhs: I32 [shared call]) -> Bool {
bb0:
  %0: I32 = read copy.trivial (lhs)
  %1: I32 = read copy.trivial (rhs)
  %2: Bool = lt inspect %0 inspect %1
  return take %2
}

fn I32.pick(mask: Bool [shared call], ifTrue: I32 [shared call], ifFalse: I32 [shared call]) -> I32 {
bb0:
  %0: Bool = read copy.trivial (mask)
  branch inspect %0 -> bb3 -> bb1

bb1:
  %3: I32 = read copy.trivial (ifFalse)
  jump -> bb2(take %3)

bb2(%4: I32):
  return take %4

bb3:
  %2: I32 = read copy.trivial (ifTrue)
  jump -> bb2(take %2)
}

fn I32.rating(x: I32 [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (x)
  %1: I32 = const 2
  %2: I32 = mul inspect %0 inspect %1
  return take %2
}

fn smaller(x: a [shared call], y: a [shared call]) -> a {
  form specialized
  slot #0 type a
  slot #1 type m
  slot #2 class Rated(a, m)
  local local2: m

bb0:
  %0: a [shared call] = read borrow.shared (x) loan0
  %1: a [shared call] = read borrow.shared (y) loan1
  %2: m = call cmp(a, m) borrow.shared %0 borrow.shared %1
  write.init borrow.unique (local2) take %2
  %4: m [shared call] = read borrow.shared (local2) loan2
  %5: a [shared call] = read borrow.shared (x) loan3
  %6: a [shared call] = read borrow.shared (y) loan4
  %7: a = call pick(a, m) borrow.shared %4 borrow.shared %5 borrow.shared %6
  drop (local2)
  return take %7
}

fn larger(x: a [shared call], y: a [shared call]) -> a {
  form specialized
  slot #0 type a
  slot #1 type m
  slot #2 class Rated(a, m)
  local local2: m

bb0:
  %0: a [shared call] = read borrow.shared (x) loan0
  %1: a [shared call] = read borrow.shared (y) loan1
  %2: m = call cmp(a, m) borrow.shared %0 borrow.shared %1
  write.init borrow.unique (local2) take %2
  %4: m [shared call] = read borrow.shared (local2) loan2
  %5: a [shared call] = read borrow.shared (y) loan3
  %6: a [shared call] = read borrow.shared (x) loan4
  %7: a = call pick(a, m) borrow.shared %4 borrow.shared %5 borrow.shared %6
  drop (local2)
  return take %7
}

fn ratedSmaller(x: a [shared call], y: a [shared call]) -> a {
  form specialized
  slot #0 type a
  slot #1 type m
  slot #2 class Rated(a, m)
  local local2: a

bb0:
  %0: a [shared call] = read borrow.shared (x) loan0
  %1: a [shared call] = read borrow.shared (y) loan1
  %2: a = call smaller(a, m) borrow.shared %0 borrow.shared %1
  write.init borrow.unique (local2) take %2
  %4: a [shared call] = read borrow.shared (local2) loan2
  %5: a = call rating(a, m) borrow.shared %4
  drop (local2)
  return take %5
}

fn main() -> I32 {
bb0:
  %0: I32 = const 9
  %1: I32 = const 4
  %2: I32 = call smaller(I32, Bool) borrow.shared %0 borrow.shared %1
  %3: I32 = const 4
  %4: Bool = ne inspect %2 inspect %3
  branch inspect %4 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %9: I32 = const 9
  %10: I32 = const 4
  %11: I32 = call larger(I32, Bool) borrow.shared %9 borrow.shared %10
  %12: I32 = const 9
  %13: Bool = ne inspect %11 inspect %12
  branch inspect %13 -> bb6 -> bb4

bb3:
  %6: I32 = const 1
  return take %6

bb4:
  jump -> bb5

bb5:
  %18: I32 = const 9
  %19: I32 = const 4
  %20: I32 = call ratedSmaller(I32, Bool) borrow.shared %18 borrow.shared %19
  %21: I32 = const 8
  %22: Bool = ne inspect %20 inspect %21
  branch inspect %22 -> bb9 -> bb7

bb6:
  %15: I32 = const 2
  return take %15

bb7:
  jump -> bb8

bb8:
  %27: I32 = const 88
  return take %27

bb9:
  %24: I32 = const 3
  return take %24
}

fn smaller(I32, Bool)(x: I32 [shared call], y: I32 [shared call]) -> I32 = <smaller at I32, Bool>

fn larger(I32, Bool)(x: I32 [shared call], y: I32 [shared call]) -> I32 = <larger at I32, Bool>

fn ratedSmaller(I32, Bool)(x: I32 [shared call], y: I32 [shared call]) -> I32 = <ratedSmaller at I32, Bool>

entry main
