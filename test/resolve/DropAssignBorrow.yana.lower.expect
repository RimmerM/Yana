initHeap<complex>() {
  b_0 {
    %region = call_complex mapMemory, 4194304: Ptr
    %v_1 = bitcast %region: Long
    %v_2 = cmp_eq %v_1, 0: Int
    je %v_2, b_3, b_4
  }

  b_3 {
    ret 
  }

  b_4 {
    jmp b_5
  }

  b_5 {
    %table = imul 32, 8: Long
    setpattern %region, %table, 0
    %v_6 = bitcast %region: Ptr
    store @heapFree, %v_6, 8
    %v_7 = add %region, %table: Ptr
    store @heapNext, %v_7, 8
    %v_8 = add %region, 4194304: Ptr
    store @heapLimit, %v_8, 8
    ret 
  }
}

heapBlockSize<complex>(%sizeClass: Long): Long {
  b_0 {
    %v_1 = shl 16, %sizeClass: Long
    ret %v_1
  }
}

