makeBuffer<complex>(%v_0: Ptr, %size: Long) {
  b_1 {
    %v_2 = loads @liveBuffers, 8: Long
    call_complex +=(I64), @liveBuffers, 1
    %buffer = alloca 8, 8: Ptr
    %v_3 = call_complex allocateHeap, %size: Ptr
    store %buffer, %v_3, 8
    %v_4 = load %buffer, 8: Ptr
    setpattern %v_4, %size, 0
    copy %v_0, %buffer, 8
    ret 
  }
}

main<complex>(): Long {
  b_0 {
    %result = alloca 8, 8: Ptr
    store %result, 0, 8
    %v_1 = loads %result, 8: Long
    %v_2 = call_complex whole: Long
    call_complex +=(I64), %result, %v_2
    %v_3 = loads @liveBuffers, 8: Long
    %v_4 = cmp_neq %v_3, 0: Int
    je %v_4, b_5, b_6
  }

  b_5 {
    %v_7 = neg 1: Long
    ret %v_7
  }

  b_6 {
    jmp b_8
