allocateHeap<complex>(%size: Long): Ptr {
  b_0 {
    %v_1 = load @heapFree, 8: Ptr
    %v_2 = bitcast %v_1: Long
    %v_3 = cmp_eq %v_2, 0: Int
    je %v_3, b_4, b_5
  }

  b_4 {
    call_complex initHeap
    %v_6 = load @heapFree, 8: Ptr
    %v_7 = bitcast %v_6: Long
    %v_8 = cmp_eq %v_7, 0: Int
    je %v_8, b_9, b_10
  }

  b_5 {
    jmp b_11
  }

  b_9 {
    %v_12 = bitcast 0: Ptr
    ret %v_12
  }

  b_10 {
    jmp b_13
  }

  b_13 {
    jmp b_11
  }

  b_11 {
    %v_14 = add %size, 8: Long
    %sizeClass = call_complex heapClassOf, %v_14: Long
    %v_15 = cmp_ige %sizeClass, 32: Int
    je %v_15, b_16, b_17
  }

  b_16 {
    %v_18 = bitcast 0: Ptr
    ret %v_18
  }

  b_17 {
    jmp b_19
  }

  b_19 {
    %reused = call_complex freeListHead, %sizeClass: Ptr
    %v_20 = bitcast %reused: Long
    %v_21 = cmp_eq %v_20, 0: Int
    %v_22 = xor %v_21, 1: Int
    je %v_22, b_23, b_24
  }

  b_23 {
    %v_25 = bitcast %reused: Ptr
    %v_26 = load %v_25, 8: Ptr
    call_complex setFreeListHead, %sizeClass, %v_26
    ret %reused
  }

  b_24 {
    jmp b_27
  }

  b_27 {
    %block = load @heapNext, 8: Ptr
    %blockSize = call_complex heapBlockSize, %sizeClass: Long
    %v_28 = add %block, %blockSize: Ptr
    %v_29 = load @heapLimit, 8: Ptr
    %v_30 = cmp_gt %v_28, %v_29: Int
    je %v_30, b_31, b_32
  }

  b_31 {
    %v_33 = bitcast 0: Ptr
    ret %v_33
  }

  b_32 {
    jmp b_34
  }

  b_34 {
    %v_35 = add %block, %blockSize: Ptr
    store @heapNext, %v_35, 8
    %v_36 = bitcast %block: Ptr
    store %v_36, %sizeClass, 8
    %v_37 = add %block, 8: Ptr
    ret %v_37
  }
}

field<complex>(): Long {
  b_0 {
    %v_1 = alloca 16, 8: Ptr
    %v_2 = alloca 8, 8: Ptr
    call_complex makeBuffer, %v_2, 16
    copy %v_1, %v_2, 8
    %v_3 = add %v_1, 8: Ptr
    store %v_3, 3, 8
    %owner = alloca 16, 8: Ptr
    copy %owner, %v_1, 16
    %v_4 = call_complex holderOf, %owner: Ptr
    %v_5 = alloca 8, 8: Ptr
    call_complex makeBuffer, %v_5, 32
    call_complex Drop(Buffer).drop, %v_4
    copy %v_4, %v_5, 8
    %counted = loads @liveBuffers, 8: Long
    %v_6 = call_complex firstByte, %owner: Long
    %v_7 = add %counted, %v_6: Long
    %v_8 = add %owner, 8: Ptr
    %v_9 = loads %v_8, 8: Long
    call_complex drop$Holder, %owner
    %v_10 = add %v_7, %v_9: Long
    ret %v_10
