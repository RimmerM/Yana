whole<complex>(): Long {
  b_0 {
    %v_1 = alloca 8, 8: Ptr
    call_complex makeBuffer, %v_1, 16
    %x = alloca 8, 8: Ptr
    copy %x, %v_1, 8
    %v_2 = alloca 8, 8: Ptr
    call_complex makeBuffer, %v_2, 16
    %y = alloca 8, 8: Ptr
    copy %y, %v_2, 8
    %v_3 = call_complex pick, %x, %y, 1: Ptr
    %v_4 = alloca 8, 8: Ptr
    call_complex makeBuffer, %v_4, 32
    call_complex Drop(Buffer).drop, %v_3
    copy %v_3, %v_4, 8
    %counted = loads @liveBuffers, 8: Long
    %v_5 = call_complex firstByte, %x: Long
    call_complex Drop(Buffer).drop, %x
    %v_6 = add %counted, %v_5: Long
    %v_7 = call_complex firstByte, %y: Long
    call_complex Drop(Buffer).drop, %y
    %v_8 = add %v_6, %v_7: Long
    ret %v_8
  }
}

heapClassOf<complex>(%total: Long): Long {
  b_0 {
    %size = alloca 8, 8: Ptr
    store %size, 16, 8
    %sizeClass = alloca 8, 8: Ptr
    store %sizeClass, 0, 8
    jmp b_1
  }

  b_1 {
    %v_2 = loads %size, 8: Long
    %v_3 = cmp_ilt %v_2, %total: Int
    je %v_3, b_4, b_5
  }

  b_5 {
    %v_6 = loads %sizeClass, 8: Long
    ret %v_6
  }

  b_4 {
    %v_7 = loads %size, 8: Long
    %v_8 = loads %size, 8: Long
    %v_9 = add %v_7, %v_8: Long
    store %size, %v_9, 8
    %v_10 = loads %sizeClass, 8: Long
    %v_11 = add %v_10, 1: Long
    store %sizeClass, %v_11, 8
    jmp b_1
  }
}

mapMemory<complex>(%size: Long): Ptr {
  b_0 {
    %v_1 = neg 1: Long
    %result = syscall 9, 0, %size, 3, 34, %v_1, 0: Long
    %v_2 = cmp_ilt %result, 0: Int
    je %v_2, b_3, b_4
  }

  b_3 {
    %v_5 = bitcast 0: Ptr
    ret %v_5
  }

  b_4 {
    jmp b_6
  }

  b_6 {
    %v_7 = bitcast %result: Ptr
    ret %v_7
  }
}

setFreeListHead<complex>(%sizeClass: Long, %block: Ptr) {
  b_0 {
    %v_1 = load @heapFree, 8: Ptr
    %v_2 = imul %sizeClass, 8: Long
    %v_3 = add %v_1, %v_2: Ptr
    store %v_3, %block, 8
    ret 
  }
}

freeHeap<complex>(%allocation: Ptr) {
  b_0 {
    %v_1 = bitcast %allocation: Long
    %v_2 = cmp_eq %v_1, 0: Int
    je %v_2, b_3, b_4
  }

  b_3 {
    ret 
  }

  b_4 {
    jmp b_5
  }

  b_5 {
    %v_6 = sub %allocation, 8: Ptr
    %v_7 = bitcast %v_6: Ptr
    %sizeClass = loads %v_7, 8: Long
    %v_8 = bitcast %allocation: Ptr
    %v_9 = call_complex freeListHead, %sizeClass: Ptr
    store %v_8, %v_9, 8
    call_complex setFreeListHead, %sizeClass, %allocation
    ret 
  }
}

