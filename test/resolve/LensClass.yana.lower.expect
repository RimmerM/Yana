    %v_34 = phi [b_18, %v_23], [b_0, 0]: I32
    %v_35 = phi [b_18, %v_20], [b_0, 0]: I32
    %v_23 = add %v_34, %v_35: I32
    %v_20 = add %v_35, 1: I32
