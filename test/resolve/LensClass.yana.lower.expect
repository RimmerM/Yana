@image$base = []

main<complex>(): I32 {
  b_0 {
    %v_1 = call_complex ResolveTest.continuation$23, 3: I32
    %v_2 = call_complex ResolveTest.continuation$24, 5: I32
    %v_3 = add %v_1, %v_2: I32
    %v_4 = add %v_3, 7: I32
    %v_5 = imm 2: I32
    %v_6 = call_complex ResolveTest.continuation$26(Gate), %v_5: I32
    %v_7 = add %v_4, %v_6: I32
    %v_8 = call_complex ResolveTest.continuation$27(Gate), %v_5: I32
