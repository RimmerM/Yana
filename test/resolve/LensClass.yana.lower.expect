  b_24 {
    %v_31 = phi [b_25, %v_30], [b_21, 0]: I32
    %v_32 = phi [b_25, %v_27], [b_21, 0]: I32
    %v_33 = add %v_31, %v_32: I32
    %v_30 = add %v_33, 1: I32
    %v_27 = add %v_32, 1: I32
