@image$base = []
mut @heading = [1]
mut @ready = [0]
mut @limit = [12, 0, 0, 0, 0, 0, 0, 0]
mut @ratio = [0, 0, 0, 63]
mut @offset = [255, 255, 255, 255, 255, 255, 255, 255]
mut @state = [1]
mut @fell = [0, 0, 128, 191]
mut @minimum = [0, 0, 0, 0, 0, 0, 0, 128]
mut @mask = [255, 255, 255, 255, 255, 255, 255, 255]

main<complex>(): Int {
  b_0 {
    %v_1 = load @heading, 1: Int
    %v_2 = cmp_eq %v_1, 0: Int
    %v_3 = cmp_eq %v_1, 1: Int
    %v_4 = cmp_eq %v_1, 2: Int
    %v_5 = select %v_4, 4, 8: Int
    %v_6 = select %v_3, 2, %v_5: Int
    %v_7 = select %v_2, 1, %v_6: Int
    %v_8 = add %v_7, 64: Int
    %v_9 = load @ready, 1: Int
    je %v_9, b_10, b_11
  }

  b_10 {
    %v_12 = add %v_8, 1024: Int
    jmp b_11
  }

  b_11 {
    %v_13 = phi [b_0, %v_8], [b_10, %v_12]: Int
    %v_14 = add %v_13, 2048: Int
    %v_15 = loads @limit, 8: Long
    %v_16 = cmp_eq 12, %v_15: Int
    je %v_16, b_17, b_18
  }

  b_17 {
    %v_19 = add %v_14, 4096: Int
    jmp b_18
  }

  b_18 {
    %v_20 = phi [b_11, %v_14], [b_17, %v_19]: Int
    %v_21 = load @ratio, 4: Float
    %v_22 = cmp_eq 0.5, %v_21: Int
    je %v_22, b_23, b_24
  }

  b_23 {
    %v_25 = add %v_20, 8192: Int
    jmp b_24
  }

  b_24 {
    %v_26 = phi [b_18, %v_20], [b_23, %v_25]: Int
    %v_27 = add %v_26, 16384: Int
    %v_28 = loads @offset, 8: Long
    %v_29 = cmp_eq %v_28, 18446744073709551615: Int
    je %v_29, b_30, b_31
  }

  b_30 {
    %v_32 = add %v_27, 32768: Int
    jmp b_31
  }

  b_31 {
    %v_33 = phi [b_24, %v_27], [b_30, %v_32]: Int
    %v_34 = load @fell, 4: Float
    %v_35 = cmp_eq %v_34, -1: Int
    je %v_35, b_36, b_37
  }

  b_36 {
    %v_38 = add %v_33, 65536: Int
    jmp b_37
  }

  b_37 {
    %v_39 = phi [b_31, %v_33], [b_36, %v_38]: Int
    %v_40 = cmp_eq -1, %v_34: Int
    je %v_40, b_41, b_42
  }

  b_41 {
    %v_43 = add %v_39, 1048576: Int
    jmp b_42
  }

  b_42 {
    %v_44 = phi [b_37, %v_39], [b_41, %v_43]: Int
    %v_45 = load @state, 1: Int
    %v_46 = cmp_eq %v_45, 0: Int
    %v_47 = select %v_46, 0, 1: Int
    je %v_47, b_48, b_49
  }

  b_48 {
    %v_50 = add %v_44, 131072: Int
    jmp b_49
  }

  b_49 {
    %v_51 = phi [b_42, %v_44], [b_48, %v_50]: Int
    %v_52 = loads @minimum, 8: Long
    %v_53 = cmp_ilt %v_52, 0: Int
    je %v_53, b_54, b_55
  }

  b_54 {
    %v_56 = add %v_51, 262144: Int
    jmp b_55
  }

  b_55 {
    %v_57 = phi [b_49, %v_51], [b_54, %v_56]: Int
    %v_58 = load @mask, 8: Long
    %v_59 = cmp_neq %v_58, 0: Int
    je %v_59, b_60, b_61
  }

  b_60 {
    %v_62 = add %v_57, 524288: Int
    jmp b_61
  }

  b_61 {
    %v_63 = phi [b_55, %v_57], [b_60, %v_62]: Int
    ret %v_63
  }
}

