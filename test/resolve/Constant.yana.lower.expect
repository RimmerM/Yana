@image$base = []
mut @heading = [1]
mut @ready = [0]
mut @limit = [12, 0, 0, 0, 0, 0, 0, 0]
mut @ratio = [0, 0, 0, 63]
mut @offset = [255, 255, 255, 255, 255, 255, 255, 255]
mut @state = [1]
mut @fell = [0, 0, 128, 191]
mut @minimum = [0, 0, 0, 0, 0, 0, 0, 128]
mut @mask = [255, 255, 255, 255, 255, 255, 255, 255]

main<complex>(): Int {
  b_0 {
    %v_1 = load @heading, 1: Int
    %v_2 = cast %v_1: Int
    %v_3 = cmp_eq %v_2, 0: Int
    %v_4 = cmp_eq %v_2, 1: Int
    %v_5 = cmp_eq %v_2, 2: Int
    %v_6 = select 4, 8, %v_5: Int
    %v_7 = select 2, %v_6, %v_4: Int
    %v_8 = select 1, %v_7, %v_3: Int
    %v_9 = add %v_8, 64: Int
    %v_10 = load @ready, 1: Int
    je %v_10, b_11, b_12
  }

  b_11 {
    %v_13 = add %v_9, 1024: Int
    jmp b_12
  }

  b_12 {
    %v_14 = phi [b_0, %v_9], [b_11, %v_13]: Int
    %v_15 = add %v_14, 2048: Int
    %v_16 = loads @limit, 8: Long
    %v_17 = cmp_eq 12, %v_16: Int
    je %v_17, b_18, b_19
  }

  b_18 {
    %v_20 = add %v_15, 4096: Int
    jmp b_19
  }

  b_19 {
    %v_21 = phi [b_12, %v_15], [b_18, %v_20]: Int
    %v_22 = load @ratio, 4: Float
    %v_23 = cmp_eq 0.5, %v_22: Int
    je %v_23, b_24, b_25
  }

  b_24 {
    %v_26 = add %v_21, 8192: Int
    jmp b_25
  }

  b_25 {
    %v_27 = phi [b_19, %v_21], [b_24, %v_26]: Int
    %v_28 = add %v_27, 16384: Int
    %v_29 = loads @offset, 8: Long
    %v_30 = cmp_eq %v_29, 18446744073709551615: Int
    je %v_30, b_31, b_32
  }

  b_31 {
    %v_33 = add %v_28, 32768: Int
    jmp b_32
  }

  b_32 {
    %v_34 = phi [b_25, %v_28], [b_31, %v_33]: Int
    %v_35 = load @fell, 4: Float
    %v_36 = cmp_eq %v_35, -1: Int
    je %v_36, b_37, b_38
  }

  b_37 {
    %v_39 = add %v_34, 65536: Int
    jmp b_38
  }

  b_38 {
    %v_40 = phi [b_32, %v_34], [b_37, %v_39]: Int
    %v_41 = cmp_eq -1, %v_35: Int
    je %v_41, b_42, b_43
  }

  b_42 {
    %v_44 = add %v_40, 1048576: Int
    jmp b_43
  }

  b_43 {
    %v_45 = phi [b_38, %v_40], [b_42, %v_44]: Int
    %v_46 = load @state, 1: Int
    %v_47 = cast %v_46: Int
    %v_48 = cmp_eq %v_47, 0: Int
    %v_49 = select 0, 1, %v_48: Int
    %v_50 = cmp_eq %v_49, 1: Int
    je %v_50, b_51, b_52
  }

  b_51 {
    %v_53 = add %v_45, 131072: Int
    jmp b_52
  }

  b_52 {
    %v_54 = phi [b_43, %v_45], [b_51, %v_53]: Int
    %v_55 = loads @minimum, 8: Long
    %v_56 = cmp_ilt %v_55, 0: Int
    je %v_56, b_57, b_58
  }

  b_57 {
    %v_59 = add %v_54, 262144: Int
    jmp b_58
  }

  b_58 {
    %v_60 = phi [b_52, %v_54], [b_57, %v_59]: Int
    %v_61 = load @mask, 8: Long
    %v_62 = cmp_neq %v_61, 0: Int
    je %v_62, b_63, b_64
  }

  b_63 {
    %v_65 = add %v_60, 524288: Int
    jmp b_64
  }

  b_64 {
    %v_66 = phi [b_58, %v_60], [b_63, %v_65]: Int
    ret %v_66
  }
}

