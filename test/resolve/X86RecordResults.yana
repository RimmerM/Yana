{-
   CPUID remains a source record because it returns four independent information registers. The
   timestamp and machine-state reads return one U64 assembled from their fixed edx:eax results.
   This fixture does not run the privileged operations; its goldens assert their representation.
-}

import Native

fn cpuidEax(leaf: U32, subleaf: U32) -> U32:
    let result = X86.cpuid(leaf, subleaf)
    return result.eax

fn rdtscpValue() -> U64:
    return X86.rdtscp()

fn rdmsrValue(msr: U32) -> U64:
    return X86.rdmsr(msr)

fn xgetbvValue(index: U32) -> U64:
    return X86.xgetbv(index)
