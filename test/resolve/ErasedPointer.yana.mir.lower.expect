
main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    store %v_1, 7, 4
    %v_2 = bitcast %v_1: I64
    %v_3 = cmp_eq %v_2, 0: I32
    je %v_3, b_4, b_5
  }

  b_5 {
    jmp b_6
  }

  b_4 {
    ret 1
  }

  b_6 {
    jmp b_7
  }

  b_7 {
    %v_8 = cmp_eq %v_2, 0: I32
    %v_9 = select %v_8, 4, 0: I32
    ret %v_9
  }
}

