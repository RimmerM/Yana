
main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    %v_2 = alloca 8, 8: Ptr
    %v_3 = alloca 4, 4: Ptr
    store %v_3, 7, 4
    copy %v_1, %v_3, 4
    %v_4 = bitcast %v_1: Ptr
    store %v_2, %v_4, 8
    %v_5 = load %v_2, 8: Ptr
    %v_6 = call_complex absent(Cell), %v_5: I32
    je %v_6, b_7, b_8
  }

  b_8 {
    jmp b_9
  }

  b_9 {
    %v_10 = call_complex nowhere(Cell): Ptr
    %v_11 = call_complex absent(Cell), %v_10: I32
    %v_12 = xor %v_11, 1: I32
    je %v_12, b_13, b_14
  }

  b_7 {
    ret 1
  }

  b_14 {
    jmp b_15
  }

  b_15 {
    %v_16 = call_complex borrowedAddress(Cell), %v_1: I64
    %v_17 = cmp_eq %v_16, 0: I32
    je %v_17, b_18, b_19
  }

  b_13 {
    ret 2
  }

  b_19 {
    jmp b_20
  }

  b_20 {
    %v_21 = load %v_2, 8: Ptr
    %v_22 = call_complex addressValue(Cell), %v_21: I64
    %v_23 = cmp_eq %v_22, 0: I32
    je %v_23, b_24, b_25
  }

  b_18 {
    ret 3
  }

  b_25 {
    jmp b_26
  }

  b_26 {
    ret 0
  }

  b_24 {
    ret 4
  }
}

absent(Cell)<complex>(%it: Ptr): I32 {
  b_0 {
    %v_1 = alloca 8, 8: Ptr
    store %v_1, %it, 8
    %v_2 = load %v_1, 8: Ptr
    %v_3 = call_complex addressValue(Cell), %v_2: I64
    %v_4 = cmp_eq %v_3, 0: I32
    ret %v_4
  }
}

nowhere(Cell)<complex>(): Ptr {
  b_0 {
    %v_1 = call_complex Size.%a.bitcast(Cell), 0: Ptr
    ret %v_1
  }
}

borrowedAddress(Cell)<complex>(%x: Ptr): I64 {
  b_0 {
    %v_1 = bitcast %x: Ptr
    %v_2 = call_complex addressValue(Cell), %v_1: I64
    ret %v_2
  }
}

addressValue(Cell)<complex>(%p: Ptr): I64 {
  b_0 {
    %v_1 = alloca 8, 8: Ptr
    store %v_1, %p, 8
    %v_2 = load %v_1, 8: Ptr
    %v_3 = call_complex %a.Size.bitcast(Cell), %v_2: I64
    ret %v_3
  }
}

Size.%a.bitcast(Cell)<complex>(%from: I64): Ptr {
  b_0 {
    %v_1 = alloca 8, 8: Ptr
    store %v_1, %from, 8
    %v_2 = loads %v_1, 8: I64
    %v_3 = bitcast %v_2: Ptr
    ret %v_3
  }
}

%a.Size.bitcast(Cell)<complex>(%from: Ptr): I64 {
  b_0 {
    %v_1 = alloca 8, 8: Ptr
    store %v_1, %from, 8
    %v_2 = load %v_1, 8: Ptr
    %v_3 = bitcast %v_2: I64
