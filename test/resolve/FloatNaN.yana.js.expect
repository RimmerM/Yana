"use strict";
var zero = 0;
var one = 1;

// ResolveTest
function nan() {
  return Math.fround(zero / zero);
}

function main() {
  var v126 = Math.fround(zero / zero);
  var score = 0;
  if (v126 < one) {
    score = score + 1 | 0;
  }
  if (v126 <= one) {
    score = score + 2 | 0;
  }
  if (v126 > one) {
    score = score + 4 | 0;
  }
  if (v126 >= one) {
    score = score + 8 | 0;
  }
  if (v126 === one) {
    score = score + 16 | 0;
  }
  if (v126 !== one) {
    score = score + 32 | 0;
  }
  if (v126 === v126) {
    score = score + 64 | 0;
  }
  if (v126 !== v126) {
    score = score + 128 | 0;
  }
  if (one > zero) {
    score = score + 256 | 0;
  }
  if (zero < one) {
    score = score + 512 | 0;
  }
  if (one === one) {
    score = score + 1024 | 0;
  }
  if (one !== zero) {
    score = score + 2048 | 0;
  }
  return score;
}
