module ResolveTest

let & seed: I32 = 3

fn main() -> I32 {
  local base: Vec(I32)
  local high: Vec(I32)
  local low: Vec(I32)

bb0:
  %0: I32 = read copy.trivial (global seed)
  %1: Vec(I32) = vec.splat inspect %0
  write.init borrow.unique (base) take %1
  %3: Vec(I32) = read copy.trivial (base)
  %4: I32 = const 5
  %5: I32 = const 40
  %6: Vec(I32) = vec.withlane #5 inspect %3 inspect %5
  write.init borrow.unique (high) take %6
  %8: Vec(I32) = read copy.trivial (high)
  %9: I32 = const 5
  %10: I32 = vec.lane #5 inspect %8
  %11: I32 = const 40
  %12: Bool = ne inspect %10 inspect %11
  branch inspect %12 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %17: Vec(I32) = read copy.trivial (high)
  %18: I32 = const 4
  %19: I32 = vec.lane #4 inspect %17
  %20: I32 = const 3
  %21: Bool = ne inspect %19 inspect %20
  branch inspect %21 -> bb6 -> bb4

bb3:
  %14: I32 = const -1
  return take %14

bb4:
  jump -> bb5

bb5:
  %26: Vec(I32) = read copy.trivial (high)
  %27: I32 = const 7
  %28: I32 = vec.lane #7 inspect %26
  %29: I32 = const 3
  %30: Bool = ne inspect %28 inspect %29
  branch inspect %30 -> bb9 -> bb7

bb6:
  %23: I32 = const -2
