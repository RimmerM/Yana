bb8:
  %35: Vec(I32) = read copy.trivial (high)
  %36: I32 = const 0
  %37: I32 = vec.lane #0 inspect %35
  %38: I32 = const 3
  %39: Bool = ne inspect %37 inspect %38
  branch inspect %39 -> bb12 -> bb10

bb9:
  %32: I32 = const -3
  return take %32

bb10:
  jump -> bb11

bb11:
  %44: Vec(I32) = read copy.trivial (high)
  %45: I32 = const 1
  %46: I32 = const 20
  %47: Vec(I32) = vec.withlane #1 inspect %44 inspect %46
  write.init borrow.unique (low) take %47
  %49: Vec(I32) = read copy.trivial (low)
  %50: I32 = const 1
  %51: I32 = vec.lane #1 inspect %49
  %52: I32 = const 20
  %53: Bool = ne inspect %51 inspect %52
  branch inspect %53 -> bb15 -> bb13

bb12:
  %41: I32 = const -4
  return take %41

bb13:
  jump -> bb14

bb14:
  %58: Vec(I32) = read copy.trivial (low)
  %59: I32 = const 5
  %60: I32 = vec.lane #5 inspect %58
  %61: I32 = const 40
  %62: Bool = ne inspect %60 inspect %61
  branch inspect %62 -> bb18 -> bb16

bb15:
  %55: I32 = const -5
  return take %55

bb16:
  jump -> bb17

bb17:
  %67: Vec(I32) = read copy.trivial (low)
  %68: I32 = const 6
  %69: I32 = vec.lane #6 inspect %67
  %70: I32 = const 3
  %71: Bool = ne inspect %69 inspect %70
  branch inspect %71 -> bb21 -> bb19

bb18:
  %64: I32 = const -6
  return take %64

bb19:
  jump -> bb20

bb20:
  %76: Vec(I32) = read copy.trivial (low)
  %77: I32 = vec.reduce max inspect %76
  %78: I32 = const 40
  %79: Bool = ne inspect %77 inspect %78
  branch inspect %79 -> bb24 -> bb22

bb21:
  %73: I32 = const -7
  return take %73

bb22:
  jump -> bb23

bb23:
  %84: Vec(I32) = read copy.trivial (low)
  %85: I32 = vec.reduce min inspect %84
  %86: I32 = const 3
  %87: Bool = ne inspect %85 inspect %86
  branch inspect %87 -> bb27 -> bb25

bb24:
  %81: I32 = const -8
  return take %81

bb25:
  jump -> bb26

bb26:
  %92: Vec(I32) = read copy.trivial (low)
  %93: I32 = vec.reduce add inspect %92
  %94: I32 = const 3
  %95: Vec(I32) = read copy.trivial (low)
  %96: I32 = const 16
  %97: I32 = const 2
  %98: I32 = sub inspect %96 inspect %97
  %99: I32 = mul inspect %94 inspect %98
  %100: I32 = const 60
  %101: I32 = add inspect %99 inspect %100
  %102: Bool = ne inspect %93 inspect %101
  branch inspect %102 -> bb30 -> bb28

bb27:
  %89: I32 = const -9
  return take %89

bb28:
  jump -> bb29

bb29:
  %107: Vec(I32) = read copy.trivial (low)
  %108: I32 = const 5
  %109: I32 = vec.lane #5 inspect %107
  %110: I32 = const 10
  %111: I32 = mul inspect %109 inspect %110
  %112: Vec(I32) = read copy.trivial (low)
  %113: I32 = const 1
  %114: I32 = vec.lane #1 inspect %112
  %115: I32 = add inspect %111 inspect %114
  return take %115

bb30:
  %104: I32 = const -10
