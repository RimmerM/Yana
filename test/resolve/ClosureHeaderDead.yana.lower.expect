@image$base = []
mut @dropCalls = [0, 0, 0, 0]

teardown$none<complex>(%value: Ptr) {
  b_0 {
    ret 
  }
}

consume<complex>(%f: Ptr): Int {
  b_0 {
    %v_1 = add %f, 8: Ptr
    %v_2 = load %f, 8: Ptr
    %v_3 = load %v_1, 8: Ptr
    %v_4 = call_complex %v_2, %v_3, 1: Int
    call_complex drop$(Int) -> Int, %f
    call_complex reclaim$(Int) -> Int, %f
    ret %v_4
  }
}

main<complex>(): Int {
  b_0 {
    %v_1 = loads @dropCalls, 4: Int
    %v_2 = add %v_1, 1: Int
    store @dropCalls, %v_2, 4
    %v_3 = alloca 4, 4: Ptr
    store %v_3, 5, 4
    %v_4 = alloca 16, 8: Ptr
    store %v_4, ResolveTest.lambda$16, 8
    %v_5 = add %v_4, 8: Ptr
    store %v_5, %v_3, 8
    %v_6 = call_complex consume, %v_4: Int
    %v_7 = add 13, %v_6: Int
    %v_8 = loads @dropCalls, 4: Int
    %v_9 = add %v_7, %v_8: Int
    ret %v_9
  }
}

@closure$ResolveTest.lambda$16 = [0, 0, 0, 0, 0, 0, 0, 0]
ResolveTest.lambda$16<complex>(%env: Ptr, %x: Int): Int {
  b_0 {
    %v_1 = loads %env, 4: Int
    %v_2 = add %x, %v_1: Int
    ret %v_2
  }
}

drop${g: Guard}<complex>(%value: Ptr) {
  b_0 {
    %v_1 = loads @dropCalls, 4: Int
    %v_2 = add %v_1, 1: Int
    store @dropCalls, %v_2, 4
    ret 
  }
}

drop$(Int) -> Int<complex>(%value: Ptr) {
  b_0 {
    %v_1 = add %value, 8: Ptr
    %v_2 = load %v_1, 8: Ptr
    %v_3 = bitcast 0: Ptr
    %v_4 = cmp_neq %v_2, %v_3: Int
    je %v_4, b_5, b_6
  }

  b_5 {
    %v_7 = load %value, 8: Ptr
    %v_8 = bitcast %v_7: Long
    %v_9 = sub %v_8, 8: Long
    %v_10 = bitcast %v_9: Ptr
    %v_11 = loads %v_10, 4: Int
    %v_12 = sext %v_11: Long
    %v_13 = add %v_12, @image$base: Ptr
    call_complex %v_13, %v_2
    jmp b_6
  }

  b_6 {
    ret 
  }
}

reclaim$(Int) -> Int<complex>(%value: Ptr) {
  b_0 {
    %v_1 = add %value, 8: Ptr
    %v_2 = load %v_1, 8: Ptr
    %v_3 = bitcast 0: Ptr
    %v_4 = cmp_neq %v_2, %v_3: Int
    je %v_4, b_5, b_6
  }

  b_5 {
    %v_7 = load %value, 8: Ptr
    %v_8 = bitcast %v_7: Long
    %v_9 = sub %v_8, 8: Long
    %v_10 = bitcast %v_9: Ptr
    %v_11 = add %v_10, 4: Ptr
    %v_12 = loads %v_11, 4: Int
    %v_13 = sext %v_12: Long
    %v_14 = add %v_13, @image$base: Ptr
    call_complex %v_14, %v_2
    jmp b_6
  }

  b_6 {
    ret 
  }
}

