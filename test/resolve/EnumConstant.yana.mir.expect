module ResolveTest

data Flag = Off | On

data Level = Low = 10 | Mid = 20 | High = 40

data Config {flag: Flag = On, level: Level = High, enabled: Bool = True, quiet: Bool = False}

fn flagValue(f: Flag [shared call]) -> I32 {
bb0:
  %0: U8 = read copy.trivial (f.#)
  %1: U8 = const 1
  %2: Bool = eq inspect %0 inspect %1
  branch inspect %2 -> bb3 -> bb1

bb1:
  %5: I32 = const 0
  jump -> bb2(take %5)

bb2(%6: I32):
  return take %6

bb3:
  %4: I32 = const 1
  jump -> bb2(take %4)
}

fn levelValue(l: Level [shared call]) -> I32 {
bb0:
  %0: U8 = read copy.trivial (l.#)
  %1: U8 = const 10
  %2: Bool = eq inspect %0 inspect %1
  branch inspect %2 -> bb4 -> bb1

bb1:
  %5: U8 = read copy.trivial (l.#)
  %6: U8 = const 20
  %7: Bool = eq inspect %5 inspect %6
  branch inspect %7 -> bb5 -> bb2

bb2:
  %10: I32 = const 40
  jump -> bb3(take %10)

bb3(%11: I32):
  return take %11

bb4:
  %4: I32 = const 10
  jump -> bb3(take %4)

bb5:
  %9: I32 = const 20
  jump -> bb3(take %9)
}

fn truthValue(b: Bool [shared call]) -> I32 {
bb0:
  %0: U8 = read copy.trivial (b.#)
  %1: U8 = const 1
  %2: Bool = eq inspect %0 inspect %1
  branch inspect %2 -> bb3 -> bb1

bb1:
  %5: I32 = const 0
  jump -> bb2(take %5)

bb2(%6: I32):
  return take %6

bb3:
  %4: I32 = const 1
  jump -> bb2(take %4)
}

fn negate(b: Bool [shared call]) -> Bool {
bb0:
  %0: Bool = read copy.trivial (b)
  %1: Bool = not inspect %0
  return take %1
}

fn both(a: Bool [shared call], b: Bool [shared call]) -> Bool {
bb0:
  %0: Bool = read copy.trivial (a)
  branch inspect %0 -> bb3 -> bb1

bb1:
  %3: Bool = const False
  jump -> bb2(take %3)

bb2(%4: Bool):
  return take %4

bb3:
  %2: Bool = read copy.trivial (b)
  jump -> bb2(take %2)
}

fn defaults() -> I32 {
  local taken: Config
  local written: Config

bb0:
  %0: Flag = const On
  %1: Level = const High
  %2: Bool = const True
  %3: Bool = const False
  %4: Config = aggregate.Config take %0 take %1 take %2 take %3
  write.init borrow.unique (taken) take %4
  %6: Flag = const Off
  %7: Level = const Low
  %8: Bool = const False
  %9: Bool = const True
  %10: Config = aggregate.Config take %6 take %7 take %8 take %9
  write.init borrow.unique (written) take %10
  %12: Flag = read copy.trivial (taken.flag)
  %13: I32 = call flagValue borrow.shared %12
  %14: I32 = const 1000
  %15: I32 = mul inspect %13 inspect %14
  %16: Level = read copy.trivial (taken.level)
  %17: I32 = call levelValue borrow.shared %16
  %18: I32 = const 10
  %19: I32 = mul inspect %17 inspect %18
  %20: I32 = add inspect %15 inspect %19
  %21: Bool = read copy.trivial (taken.enabled)
  %22: I32 = call truthValue borrow.shared %21
  %23: I32 = const 2
  %24: I32 = mul inspect %22 inspect %23
  %25: I32 = add inspect %20 inspect %24
  %26: Bool = read copy.trivial (taken.quiet)
  %27: I32 = call truthValue borrow.shared %26
  %28: I32 = add inspect %25 inspect %27
  %29: Flag = read copy.trivial (written.flag)
  %30: I32 = call flagValue borrow.shared %29
  %31: I32 = const 1000
  %32: I32 = mul inspect %30 inspect %31
  %33: I32 = sub inspect %28 inspect %32
  %34: Level = read copy.trivial (written.level)
  %35: I32 = call levelValue borrow.shared %34
  %36: I32 = const 10
  %37: I32 = mul inspect %35 inspect %36
  %38: I32 = sub inspect %33 inspect %37
  %39: Bool = read copy.trivial (written.enabled)
  %40: I32 = call truthValue borrow.shared %39
  %41: I32 = const 2
  %42: I32 = mul inspect %40 inspect %41
  %43: I32 = sub inspect %38 inspect %42
  %44: Bool = read copy.trivial (written.quiet)
  %45: I32 = call truthValue borrow.shared %44
  %46: I32 = sub inspect %43 inspect %45
  return take %46
}

fn takesFloat(v: F32 [shared call]) -> I32 {
bb0:
  %0: I32 = const 7
  return take %0
}

fn takesDouble(v: F64 [shared call]) -> I32 {
bb0:
  %0: I32 = const 9
  return take %0
}

fn literals() -> I32 {
  local counted: I32
  local scaled: F32
  local wide: F64

bb0:
  %0: I32 = const 4
  write.init borrow.unique (counted) take %0
  %2: F32 = const 1.5
  write.init borrow.unique (scaled) take %2
  %4: F64 = const 1.5
  write.init borrow.unique (wide) take %4
  %6: I32 = read copy.trivial (counted)
  %7: F32 = read copy.trivial (scaled)
  %8: I32 = call takesFloat borrow.shared %7
  %9: I32 = add inspect %6 inspect %8
  %10: F64 = read copy.trivial (wide)
  %11: I32 = call takesDouble borrow.shared %10
  %12: I32 = add inspect %9 inspect %11
  return take %12
}

fn main() -> I32 {
  local flags: I32

bb0:
  %0: Bool = const False
  %1: Bool = call negate borrow.shared %0
  %2: I32 = call truthValue borrow.shared %1
  %3: Bool = const True
  %4: Bool = const False
  %5: Bool = call negate borrow.shared %4
  %6: Bool = call both borrow.shared %3 borrow.shared %5
  %7: I32 = call truthValue borrow.shared %6
  %8: I32 = add inspect %2 inspect %7
  write.init borrow.unique (flags) take %8
  %10: I32 = call defaults
  %11: I32 = call literals
  %12: I32 = add inspect %10 inspect %11
  %13: I32 = read copy.trivial (flags)
  %14: I32 = add inspect %12 inspect %13
  return take %14
}

entry main
