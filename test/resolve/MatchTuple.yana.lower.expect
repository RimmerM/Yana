@image$base = []
mut @drops = [0, 0, 0, 0]

main<complex>(): Int {
  b_0 {
    %a = alloca 8, 4: Ptr
    store %a, 1, 4
    %v_1 = add %a, 4: Ptr
    store %v_1, 3, 4
    %b = alloca 8, 4: Ptr
    store %b, 1, 4
    %v_2 = add %b, 4: Ptr
    store %v_2, 4, 4
    call_complex drop$Maybe(Held), %a
    call_complex drop$Maybe(Held), %b
    %v_3 = loads @drops, 4: Int
    %v_4 = imul %v_3, 10: Int
    %v_5 = add %v_4, 14: Int
    ret %v_5
  }
}

drop$Maybe(Held)<complex>(%value: Ptr) {
  b_0 {
    %v_1 = loads %value, 4: Int
    %v_2 = cmp_eq %v_1, 1: Int
    je %v_2, b_3, b_4
  }

  b_5 {
    ret 
  }

  b_3 {
    %v_6 = loads @drops, 4: Int
    %v_7 = add %v_6, 1: Int
    store @drops, %v_7, 4
    jmp b_5
  }

  b_4 {
    jmp b_5
  }
}

