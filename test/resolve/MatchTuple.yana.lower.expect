@drops = [0, 0, 0, 0]

ordered<complex>(%a: Ptr, %b: Ptr, %c: Int): Int {
  b_0 {
    %v_1 = loads %a, 4: Int
    %v_2 = cmp_eq %v_1, 1: Int
    je %v_2, b_3, b_4
  }

  b_4 {
    %v_5 = loads %a, 4: Int
    %v_6 = cmp_eq %v_5, 1: Int
    je %v_6, b_7, b_8
  }

  b_3 {
    %v_9 = loads %b, 4: Int
    %v_10 = cmp_eq %v_9, 1: Int
    je %v_10, b_11, b_4
  }

  b_11 {
    %v_12 = cmp_eq %c, 0: Int
    je %v_12, b_13, b_4
  }

  b_13 {
    %v_14 = add %a, 4: Ptr
    %v_15 = loads %v_14, 4: Int
    %v_16 = add %b, 4: Ptr
    %v_17 = loads %v_16, 4: Int
    %v_18 = add %v_15, %v_17: Int
    jmp b_19
  }

  b_8 {
    jmp b_19
  }

  b_7 {
    %v_20 = loads %b, 4: Int
    %v_21 = cmp_eq %v_20, 0: Int
    je %v_21, b_22, b_8
  }

  b_22 {
    %v_23 = add %a, 4: Ptr
    %v_24 = loads %v_23, 4: Int
    %v_25 = add %v_24, %c: Int
    jmp b_19
  }

  b_19 {
    %v_26 = phi [b_13, %v_18], [b_22, %v_25], [b_8, 0]: Int
    ret %v_26
  }
}

main<complex>(): Int {
  b_0 {
    %a = alloca 8, 4: Ptr
    store %a, 1, 4
    %v_1 = add %a, 4: Ptr
    store %v_1, 3, 4
    %b = alloca 8, 4: Ptr
    store %b, 1, 4
    %v_2 = add %b, 4: Ptr
    store %v_2, 4, 4
    %v_3 = call_complex ordered, %a, %b, 0: Int
    %v_4 = loads @drops, 4: Int
    %v_5 = add %v_4, 2: Int
    store @drops, %v_5, 4
    %v_6 = imul %v_5, 10: Int
    %v_7 = add %v_3, %v_6: Int
    %v_8 = add %v_7, 7: Int
    ret %v_8
  }
}

