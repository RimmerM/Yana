let image$base: () = <none>

let &seed: Int = 3

fn comparisons(%a: Vec(Int), %b: Vec(Int)) -> Int {
  b0:
    %v2 = cmp_lt %a, %b : Mask(Int)
    %v3 = vreduce_and %v2 : Bool
    %v5 = xor %v3, True : Bool
    je %v5, b1, b2

  b1:
    %v9 = neg 1 : Int
    ret %v9

  b2:
    jmp b3

  b3:
    %v12 = cmp_le %a, %b : Mask(Int)
    %v13 = vreduce_and %v12 : Bool
    %v15 = xor %v13, True : Bool
    je %v15, b4, b5

  b4:
    %v19 = neg 2 : Int
    ret %v19

  b5:
    jmp b6

  b6:
    %v22 = cmp_gt %b, %a : Mask(Int)
    %v23 = vreduce_and %v22 : Bool
    %v25 = xor %v23, True : Bool
    je %v25, b7, b8

  b7:
    %v29 = neg 3 : Int
    ret %v29

  b8:
    jmp b9

  b9:
    %v32 = cmp_ge %b, %a : Mask(Int)
    %v33 = vreduce_and %v32 : Bool
    %v35 = xor %v33, True : Bool
    je %v35, b10, b11

  b10:
    %v39 = neg 4 : Int
    ret %v39

  b11:
    jmp b12

  b12:
    %v42 = cmp_ne %a, %b : Mask(Int)
    %v43 = vreduce_and %v42 : Bool
    %v45 = xor %v43, True : Bool
    je %v45, b13, b14

  b13:
    %v49 = neg 5 : Int
    ret %v49

  b14:
    jmp b15

  b15:
    %v52 = cmp_eq %a, %b : Mask(Int)
    %v53 = vreduce_or %v52 : Bool
    je %v53, b16, b17

  b16:
    %v57 = neg 6 : Int
    ret %v57

  b17:
    jmp b18

  b18:
    %v60 = cmp_gt %a, %b : Mask(Int)
    %v61 = vreduce_or %v60 : Bool
    %v63 = xor %v61, True : Bool
    %v65 = xor %v63, True : Bool
    je %v65, b19, b20

  b19:
    %v69 = neg 7 : Int
    ret %v69

  b20:
    jmp b21

  b21:
    ret 0
}

fn selection(%a: Vec(Int), %b: Vec(Int)) -> Int {
  b0:
    %v2 = cmp_lt %a, %b : Mask(Int)
    %smaller = select %v2 ? %a : %b : Vec(Int)
    %v4 = cmp_lt %a, %b : Mask(Int)
    %larger = select %v4 ? %b : %a : Vec(Int)
    %v8 = vlane %smaller, 0 : Int
    %v11 = cmp_ne %v8, 3 : Bool
    je %v11, b1, b2

  b1:
    %v15 = neg 1 : Int
    ret %v15

  b2:
    jmp b3

  b3:
    %v20 = vlane %larger, 1 : Int
    %v23 = cmp_ne %v20, 4 : Bool
    je %v23, b4, b5

  b4:
    %v27 = neg 2 : Int
    ret %v27

  b5:
    jmp b6

  b6:
    ret 0
}

fn combining(%a: Vec(Int), %b: Vec(Int)) -> Int {
  b0:
    %below = cmp_lt %a, %b : Mask(Int)
    %equal = cmp_eq %a, %b : Mask(Int)
    %v4 = or %below, %equal : Mask(Int)
    %v5 = vreduce_and %v4 : Bool
    %v7 = xor %v5, True : Bool
    je %v7, b1, b2

  b1:
    %v11 = neg 1 : Int
    ret %v11

  b2:
    jmp b3

  b3:
    %v14 = and %below, %equal : Mask(Int)
    %v15 = vreduce_or %v14 : Bool
    je %v15, b4, b5

  b4:
    %v19 = neg 2 : Int
    ret %v19

  b5:
    jmp b6

  b6:
    %v22 = xor %below, %equal : Mask(Int)
    %v23 = vreduce_and %v22 : Bool
    %v25 = xor %v23, True : Bool
    je %v25, b7, b8

  b7:
    %v29 = neg 3 : Int
    ret %v29

  b8:
    jmp b9

  b9:
    %v32 = not %equal : Mask(Int)
    %v33 = vreduce_and %v32 : Bool
    %v35 = xor %v33, True : Bool
    je %v35, b10, b11

  b10:
    %v39 = neg 4 : Int
    ret %v39

  b11:
    jmp b12

  b12:
    ret 0
}

fn counting() -> Int {
  b0:
    %v1 = vsplat 0 : Vec(Int)
    %v3 = vwithlane %v1, 1, 1 : Vec(Int)
    %v5 = vwithlane %v3, 2, 2 : Vec(Int)
    %indices = vwithlane %v5, 3, 3 : Vec(Int)
    %v10 = vsplat 1 : Vec(Int)
    %past = cmp_ge %indices, %v10 : Mask(Int)
    %v12 = vreduce_add %past : Int
    %v16 = sub 4, 1 : Int
    %v17 = cmp_ne %v12, %v16 : Bool
    je %v17, b1, b2

  b1:
    %v21 = neg 1 : Int
    ret %v21

  b2:
    jmp b3

  b3:
    %v24 = vreduce_first %past : Int
    %v27 = cmp_ne %v24, 1 : Bool
    je %v27, b4, b5

  b4:
    %v31 = neg 2 : Int
    ret %v31

  b5:
    jmp b6

  b6:
    %empty = vsplat 0 : Vec(Int)
    %never = cmp_lt %indices, %empty : Mask(Int)
    %v37 = vreduce_first %never : Int
    %v39 = cmp_ne %v37, 4 : Bool
    je %v39, b7, b8

  b7:
    %v43 = neg 3 : Int
    ret %v43

  b8:
    jmp b9

  b9:
    %v46 = vreduce_add %never : Int
    %v49 = cmp_ne %v46, 0 : Bool
    je %v49, b10, b11

  b10:
    %v53 = neg 4 : Int
    ret %v53

  b11:
    jmp b12

  b12:
    %always = cmp_ge %indices, %empty : Mask(Int)
    %v57 = vreduce_first %always : Int
    %v60 = cmp_ne %v57, 0 : Bool
    je %v60, b13, b14

  b13:
    %v64 = neg 5 : Int
    ret %v64

  b14:
    jmp b15

  b15:
    %v67 = vreduce_add %always : Int
    %v69 = cmp_ne %v67, 4 : Bool
    je %v69, b16, b17

  b16:
    %v73 = neg 6 : Int
    ret %v73

  b17:
    jmp b18

  b18:
    ret 0
}

fn floats() -> Int {
  b0:
    %a = vsplat 1.5 : Vec(Float)
    %b = vsplat 2.5 : Vec(Float)
    %v6 = cmp_lt %a, %b : Mask(Float)
    %v7 = vreduce_and %v6 : Bool
    %v9 = xor %v7, True : Bool
    je %v9, b1, b2

  b1:
    %v13 = neg 1 : Int
    ret %v13

  b2:
    jmp b3

  b3:
    %v16 = cmp_lt %a, %b : Mask(Float)
    %v17 = select %v16 ? %a : %b : Vec(Float)
    %v20 = vlane %v17, 0 : Float
    %v23 = cmp_ne %v20, 1.5 : Bool
    je %v23, b4, b5

  b4:
    %v27 = neg 2 : Int
    ret %v27

  b5:
    jmp b6

  b6:
    ret 0
}

fn main() -> Int {
  b0:
    %v0 = load seed : Int
    %a = vsplat %v0 : Vec(Int)
    %v2 = load seed : Int
    %v5 = add %v2, 1 : Int
    %b = vsplat %v5 : Vec(Int)
    %v7 = call comparisons, %a, %b : Int
    %v10 = cmp_ne %v7, 0 : Bool
    je %v10, b1, b2

  b1:
    %v12 = call comparisons, %a, %b : Int
    ret %v12

  b2:
    jmp b3

  b3:
    %v15 = call selection, %a, %b : Int
    %v18 = cmp_ne %v15, 0 : Bool
    je %v18, b4, b5

  b4:
    %v20 = call selection, %a, %b : Int
    %v23 = mul %v20, 10 : Int
    ret %v23

  b5:
    jmp b6

  b6:
    %v26 = call combining, %a, %b : Int
    %v29 = cmp_ne %v26, 0 : Bool
    je %v29, b7, b8

  b7:
    %v31 = call combining, %a, %b : Int
    %v34 = mul %v31, 100 : Int
    ret %v34

  b8:
    jmp b9

  b9:
    %v37 = call counting : Int
    %v40 = cmp_ne %v37, 0 : Bool
    je %v40, b10, b11

  b10:
    %v42 = call counting : Int
    %v45 = mul %v42, 1000 : Int
    ret %v45

  b11:
    jmp b12

  b12:
    %v48 = call floats : Int
    %v51 = cmp_ne %v48, 0 : Bool
    je %v51, b13, b14

  b13:
    %v53 = call floats : Int
    %v56 = mul %v53, 10000 : Int
    ret %v56

  b14:
    jmp b15

  b15:
    ret 4839
}
