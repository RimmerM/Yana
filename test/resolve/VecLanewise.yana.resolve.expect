let image$base: () = <none>

let &seed: Int = 3

fn comparisons(%a: Vec(Int), %b: Vec(Int)) -> Int {
  b0:
    %v2 = cmp_lt %a, %b : Mask(Int)
    %v3 = vreduce_and %v2 : Bool
    %v5 = xor %v3, True : Bool
    je %v5, b1, b2

  b1:
    ret -1

  b2:
    jmp b3

  b3:
    %v10 = cmp_le %a, %b : Mask(Int)
    %v11 = vreduce_and %v10 : Bool
    %v13 = xor %v11, True : Bool
    je %v13, b4, b5

  b4:
    ret -2

  b5:
    jmp b6

  b6:
    %v18 = cmp_gt %b, %a : Mask(Int)
    %v19 = vreduce_and %v18 : Bool
    %v21 = xor %v19, True : Bool
    je %v21, b7, b8

  b7:
    ret -3

  b8:
    jmp b9

  b9:
    %v26 = cmp_ge %b, %a : Mask(Int)
    %v27 = vreduce_and %v26 : Bool
    %v29 = xor %v27, True : Bool
    je %v29, b10, b11

  b10:
    ret -4

  b11:
    jmp b12

  b12:
    %v34 = cmp_ne %a, %b : Mask(Int)
    %v35 = vreduce_and %v34 : Bool
    %v37 = xor %v35, True : Bool
    je %v37, b13, b14

  b13:
    ret -5

  b14:
    jmp b15

  b15:
    %v42 = cmp_eq %a, %b : Mask(Int)
    %v43 = vreduce_or %v42 : Bool
    je %v43, b16, b17

  b16:
    ret -6

  b17:
    jmp b18

  b18:
    %v48 = cmp_gt %a, %b : Mask(Int)
    %v49 = vreduce_or %v48 : Bool
    %v51 = xor %v49, True : Bool
    %v53 = xor %v51, True : Bool
    je %v53, b19, b20

  b19:
    ret -7

  b20:
    jmp b21

  b21:
    ret 0
}

fn selection(%a: Vec(Int), %b: Vec(Int)) -> Int {
  b0:
    %v2 = cmp_lt %a, %b : Mask(Int)
    %smaller = select %v2 ? %a : %b : Vec(Int)
    %v4 = cmp_lt %a, %b : Mask(Int)
    %larger = select %v4 ? %b : %a : Vec(Int)
    %v8 = vlane %smaller, 0 : Int
    %v11 = cmp_ne %v8, 3 : Bool
    je %v11, b1, b2

  b1:
    ret -1

  b2:
    jmp b3

  b3:
    %v18 = vlane %larger, 1 : Int
    %v21 = cmp_ne %v18, 4 : Bool
    je %v21, b4, b5

  b4:
    ret -2

  b5:
    jmp b6

  b6:
    ret 0
}

fn combining(%a: Vec(Int), %b: Vec(Int)) -> Int {
  b0:
    %below = cmp_lt %a, %b : Mask(Int)
    %equal = cmp_eq %a, %b : Mask(Int)
    %v4 = or %below, %equal : Mask(Int)
    %v5 = vreduce_and %v4 : Bool
    %v7 = xor %v5, True : Bool
    je %v7, b1, b2

  b1:
    ret -1

  b2:
    jmp b3

  b3:
    %v12 = and %below, %equal : Mask(Int)
    %v13 = vreduce_or %v12 : Bool
    je %v13, b4, b5

  b4:
    ret -2

  b5:
    jmp b6

  b6:
    %v18 = xor %below, %equal : Mask(Int)
    %v19 = vreduce_and %v18 : Bool
    %v21 = xor %v19, True : Bool
    je %v21, b7, b8

  b7:
    ret -3

  b8:
    jmp b9

  b9:
    %v26 = not %equal : Mask(Int)
    %v27 = vreduce_and %v26 : Bool
    %v29 = xor %v27, True : Bool
    je %v29, b10, b11

  b10:
    ret -4

  b11:
    jmp b12

  b12:
    ret 0
}

fn counting() -> Int {
  b0:
    %v1 = vsplat 0 : Vec(Int)
    %v3 = vwithlane %v1, 1, 1 : Vec(Int)
    %v5 = vwithlane %v3, 2, 2 : Vec(Int)
    %indices = vwithlane %v5, 3, 3 : Vec(Int)
    %v10 = vsplat 1 : Vec(Int)
    %past = cmp_ge %indices, %v10 : Mask(Int)
    %v12 = vreduce_add %past : Int
    %v16 = sub 4, 1 : Int
    %v17 = cmp_ne %v12, %v16 : Bool
    je %v17, b1, b2

  b1:
    ret -1

  b2:
    jmp b3

  b3:
    %v22 = vreduce_first %past : Int
    %v25 = cmp_ne %v22, 1 : Bool
    je %v25, b4, b5

  b4:
    ret -2

  b5:
    jmp b6

  b6:
    %empty = vsplat 0 : Vec(Int)
    %never = cmp_lt %indices, %empty : Mask(Int)
    %v33 = vreduce_first %never : Int
    %v35 = cmp_ne %v33, 4 : Bool
    je %v35, b7, b8

  b7:
    ret -3

  b8:
    jmp b9

  b9:
    %v40 = vreduce_add %never : Int
    %v43 = cmp_ne %v40, 0 : Bool
    je %v43, b10, b11

  b10:
    ret -4

  b11:
    jmp b12

  b12:
    %always = cmp_ge %indices, %empty : Mask(Int)
    %v49 = vreduce_first %always : Int
    %v52 = cmp_ne %v49, 0 : Bool
    je %v52, b13, b14

  b13:
    ret -5

  b14:
    jmp b15

  b15:
    %v57 = vreduce_add %always : Int
    %v59 = cmp_ne %v57, 4 : Bool
    je %v59, b16, b17

  b16:
    ret -6

  b17:
    jmp b18

  b18:
    ret 0
}

fn floats() -> Int {
  b0:
    %a = vsplat 1.5 : Vec(Float)
    %b = vsplat 2.5 : Vec(Float)
    %v6 = cmp_lt %a, %b : Mask(Float)
    %v7 = vreduce_and %v6 : Bool
    %v9 = xor %v7, True : Bool
    je %v9, b1, b2

  b1:
    ret -1

  b2:
    jmp b3

  b3:
    %v14 = cmp_lt %a, %b : Mask(Float)
    %v15 = select %v14 ? %a : %b : Vec(Float)
    %v18 = vlane %v15, 0 : Float
    %v21 = cmp_ne %v18, 1.5 : Bool
    je %v21, b4, b5

  b4:
    ret -2

  b5:
    jmp b6

  b6:
    ret 0
}

fn main() -> Int {
  b0:
    %v0 = load seed : Int
    %a = vsplat %v0 : Vec(Int)
    %v2 = load seed : Int
    %v5 = add %v2, 1 : Int
    %b = vsplat %v5 : Vec(Int)
    %v7 = call comparisons, %a, %b : Int
    %v10 = cmp_ne %v7, 0 : Bool
    je %v10, b1, b2

  b1:
    %v12 = call comparisons, %a, %b : Int
    ret %v12

  b2:
    jmp b3

  b3:
    %v15 = call selection, %a, %b : Int
    %v18 = cmp_ne %v15, 0 : Bool
    je %v18, b4, b5

  b4:
    %v20 = call selection, %a, %b : Int
    %v23 = mul %v20, 10 : Int
    ret %v23

  b5:
    jmp b6

  b6:
    %v26 = call combining, %a, %b : Int
    %v29 = cmp_ne %v26, 0 : Bool
    je %v29, b7, b8

  b7:
    %v31 = call combining, %a, %b : Int
    %v34 = mul %v31, 100 : Int
    ret %v34

  b8:
    jmp b9

  b9:
    %v37 = call counting : Int
    %v40 = cmp_ne %v37, 0 : Bool
    je %v40, b10, b11

  b10:
    %v42 = call counting : Int
    %v45 = mul %v42, 1000 : Int
    ret %v45

  b11:
    jmp b12

  b12:
    %v48 = call floats : Int
    %v51 = cmp_ne %v48, 0 : Bool
    je %v51, b13, b14

  b13:
    %v53 = call floats : Int
    %v56 = mul %v53, 10000 : Int
    ret %v56

  b14:
    jmp b15

  b15:
    ret 4839
}
