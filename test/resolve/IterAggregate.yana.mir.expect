  %14: %Point [owned here shape6 .*=shared slot 0] = call valuesMut(Point) borrow.unique %13 roots.0{0}
  %15: Size = const 0
  write.init borrow.unique ([%%14][0]) take %2
  %17: Size = const 1
  write.init borrow.unique ([%%14][1]) take %5
  %19: Size = const 2
