module ResolveTest

data Point {x: I32, y: I32}

lens fn each(xs: Array(a) [shared call view], $body: (a) -> I32 [shared call]) -> I32 {
  form specialized
  slot #0 type a
  slot #1 class TrivialCopy(a)
  local & $yielded: I32
  local & i: I32
  local n: I32
  local local5: a [shared slot 0]

bb0:
  %0: I32 = const 0
  write.init borrow.unique ($yielded) take %0
  %2: I32 = const 0
  write.init borrow.unique (i) take %2
  %4: Array(a) [shared call view] = read borrow.shared (xs) loan0
  %5: Size = call length(Array(a)) borrow.shared %4
  %6: I32 = convert inspect %5
  write.init borrow.unique (n) take %6
  jump -> bb1

bb1:
  %9: I32 = read copy.trivial (i)
  %10: I32 = read copy.trivial (n)
  %11: Bool = lt inspect %9 inspect %10
  branch inspect %11 -> bb3 -> bb2

bb2:
  %31: I32 = read copy.trivial ($yielded)
  return take %31

bb3:
  %13: I32 = read copy.trivial (i)
  %14: Array(a) [shared call view] = read borrow.shared (xs) loan1
  %15: Size = convert inspect %13
  %16: a [shared slot 0] = call.subscript get(Array(a), Size, a) borrow.shared %14 borrow.shared %15 roots{1}
  write.init borrow.unique (local5) borrow.shared %16
  %18: a = read copy.trivial (local5)
  %19: (a) -> I32 [shared call] = read borrow.shared ($body) loan2
  %20: I32 = call inspect %19 borrow.shared %18
  %21: I32 = const 0
  %22: Bool = eq inspect %20 inspect %21
  write.assign borrow.unique ($yielded) take %20
  branch inspect %22 -> bb4 -> bb5

bb4:
  %26: I32 = read copy.trivial (i)
  %27: I32 = const 1
  %28: I32 = add inspect %26 inspect %27
  write.assign borrow.unique (i) take %28
  jump -> bb1

bb5:
  jump -> bb2
}

lens fn filtered(xs: Array(a) [shared call view], keep: (a) -> Bool [shared call], $body: (a) -> I32 [shared call]) -> I32 {
  form specialized
  slot #0 type a
  slot #1 class TrivialCopy(a)
  local & $yielded: I32
  local x: a [shared call]

bb0:
  %0: I32 = const 0
  write.init borrow.unique ($yielded) take %0
  %2: Array(a) [shared call view] = read borrow.shared (xs) loan0
  lens.call each(a) borrow.shared %2 -> bb2

bb1:
  %21: I32 = read copy.trivial ($yielded)
  return take %21

bb2(%3: a [shared call]) handover(a [shared call]) many -> bb1:
  write.init borrow.unique (x) borrow.shared %3
  %6: (a) -> Bool [shared call] = read borrow.shared (keep) loan1
  %7: a = read copy.trivial (x)
  %8: Bool = call inspect %6 borrow.shared %7
  branch inspect %8 -> bb5 -> bb3

bb3 handover(a [shared call]) many:
  jump -> bb4

bb4 handover(a [shared call]) many:
  jump -> bb1

bb5 handover(a [shared call]) many:
  %10: a = read copy.trivial (x)
  %11: (a) -> I32 [shared call] = read borrow.shared ($body) loan2
  %12: I32 = call inspect %11 borrow.shared %10
  %13: I32 = const 0
  %14: Bool = eq inspect %12 inspect %13
  write.assign borrow.unique ($yielded) take %12
  branch inspect %14 -> bb6 -> bb7

bb6 handover(a [shared call]) many:
  jump -> bb4

bb7 handover(a [shared call]) many:
  break -> bb1
}

lens fn mapFiltered(xs: Array(a) [shared call view], keep: (a) -> Bool [shared call], f: (a) -> b [shared call], $body: (b) -> I32 [shared call]) -> I32 {
  form specialized
  slot #0 type a
  slot #1 type b
  slot #2 class TrivialCopy(a)
  local & $yielded: I32
  local x: a [shared call]
  local local6: b

bb0:
  %0: I32 = const 0
  write.init borrow.unique ($yielded) take %0
  %2: Array(a) [shared call view] = read borrow.shared (xs) loan0
  %3: (a) -> Bool [shared call] = read borrow.shared (keep) loan1
  lens.call filtered(a) borrow.shared %2 borrow.shared %3 -> bb2

bb1:
  %20: I32 = read copy.trivial ($yielded)
  return take %20

bb2(%4: a [shared call]) handover(a [shared call]) many -> bb1:
  write.init borrow.unique (x) borrow.shared %4
  %7: (a) -> b [shared call] = read borrow.shared (f) loan2
  %8: a = read copy.trivial (x)
  %9: b = call inspect %7 borrow.shared %8
  write.init borrow.unique (local6) take %9
  %11: b [shared call] = read borrow.shared (local6) loan3
  %12: (b) -> I32 [shared call] = read borrow.shared ($body) loan4
  %13: I32 = call inspect %12 borrow.shared %11
  drop (local6)
  %14: I32 = const 0
  %15: Bool = eq inspect %13 inspect %14
  write.assign borrow.unique ($yielded) take %13
  branch inspect %15 -> bb3 -> bb4

bb3 handover(a [shared call]) many:
  jump -> bb1

bb4 handover(a [shared call]) many:
  break -> bb1
}

