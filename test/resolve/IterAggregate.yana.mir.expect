fn main() -> I32 {
  local & local0: Array(Point) object0
  local & ps: Array(Point) object0
  local & local2: Array(I32) object3
  local & ns: Array(I32) object3

bb0:
  %0: I32 = const 0
  %1: I32 = const 0
  %2: Point = aggregate.Point take %0 take %1
  %3: I32 = const 1
  %4: I32 = const 2
