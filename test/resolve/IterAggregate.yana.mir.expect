  %21: Array(Point) = read take (local0)
  write.init borrow.unique (ps) take %21
  %23: I32 = const 1
  %24: I32 = const 2
  %25: I32 = const 3
  %26: I32 = const 4
  %27: Size = const 4
  %28: Array(I32) = call literalArray(I32) borrow.shared %27
  write.init borrow.unique (local2) take %28
  %30: Array(I32) [unique slot 0] = read borrow.unique (local2) loan1
  %31: Array(I32) [unique slot 0 view] = call.derivation elementsMut(Array(I32), I32) borrow.unique %30 roots{1}
  %32: %I32 [owned here shape6 .*=shared slot 0] = call valuesMut(I32) borrow.unique %31 roots.0{1}
  %33: Size = const 0
  write.init borrow.unique ([%%32][0]) take %23
  %35: Size = const 1
  write.init borrow.unique ([%%32][1]) take %24
  %37: Size = const 2
  write.init borrow.unique ([%%32][2]) take %25
  %39: Size = const 3
  write.init borrow.unique ([%%32][3]) take %26
  %41: Array(I32) = read take (local2)
  write.init borrow.unique (ns) take %41
  %43: Array(Point) [shared call] = read borrow.shared (ps) loan2
  %44: Array(Point) [shared slot 0 view] = call.derivation elements(Array(Point), Point) borrow.shared %43 roots{2}
  %45: I32 = call direct borrow.shared %44
  %46: Array(Point) [shared call] = read borrow.shared (ps) loan3
  %47: Array(Point) [shared slot 0 view] = call.derivation elements(Array(Point), Point) borrow.shared %46 roots{3}
  %48: I32 = call oneLift borrow.shared %47
  %49: I32 = add inspect %45 inspect %48
  %50: Array(Point) [shared call] = read borrow.shared (ps) loan4
  %51: Array(Point) [shared slot 0 view] = call.derivation elements(Array(Point), Point) borrow.shared %50 roots{4}
  %52: I32 = call twoLifts borrow.shared %51
  drop (ps)
  %53: I32 = add inspect %49 inspect %52
  %54: Array(I32) [shared call] = read borrow.shared (ns) loan5
  %55: Array(I32) [shared slot 0 view] = call.derivation elements(Array(I32), I32) borrow.shared %54 roots{5}
  %56: I32 = call scalar borrow.shared %55
  drop (ns)
  %57: I32 = add inspect %53 inspect %56
