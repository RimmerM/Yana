}

lens fn each(Point)(xs: Array(Point) [shared call view], $body: (Point) -> I32 [shared call]) -> I32 = <each at Point>

lens fn filtered(Point)(xs: Array(Point) [shared call view], keep: (Point) -> Bool [shared call], $body: (Point) -> I32 [shared call]) -> I32 = <filtered at Point>

lens fn mapFiltered(Point, I32)(xs: Array(Point) [shared call view], keep: (Point) -> Bool [shared call], f: (Point) -> I32 [shared call], $body: (I32) -> I32 [shared call]) -> I32 = <mapFiltered at Point, I32>

lens fn each(I32)(xs: Array(I32) [shared call view], $body: (I32) -> I32 [shared call]) -> I32 = <each at I32>

