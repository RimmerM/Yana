mut @trace = [0, 0, 0, 0]

Guard.drop<complex>(%value: Ptr) {
  b_0 {
    %v_1 = load %value, 4: I32
    %v_2 = loads @trace, 4: I32
    %v_3 = add %v_2, %v_1: I32
    store @trace, %v_3, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 8, 4: Ptr
    %v_2 = alloca 8, 4: Ptr
    %v_3 = add %v_1, 4: Ptr
    store %v_3, 4, 4
    store %v_1, 0, 1
    call_complex teardown(Held), %v_1
    store %v_2, 1, 1
    call_complex teardown(Held), %v_2
    %v_4 = loads @trace, 4: I32
    %v_5 = add 23417, %v_4: I32
    ret %v_5
  }
}

teardown(Held)<complex>(%v_0: Ptr) {
  b_1 {
    %v_2 = load %v_0, 1: I32
    %v_3 = cmp_eq %v_2, 0: I32
    je %v_3, b_4, b_5
  }

  b_6 {
    ret 
  }

  b_4 {
    %v_7 = add %v_0, 4: Ptr
    call_complex Guard.drop, %v_7
    jmp b_6
  }

  b_5 {
    jmp b_6
  }
}

