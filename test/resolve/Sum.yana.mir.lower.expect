mut @trace = [0, 0, 0, 0]

Guard.drop<complex>(%value: Ptr) {
  b_0 {
    %v_1 = load %value, 4: I32
    %v_2 = loads @trace, 4: I32
    %v_3 = add %v_2, %v_1: I32
    store @trace, %v_3, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    jmp b_1
  }

  b_1 {
    jmp b_2
  }

  b_2 {
    jmp b_3
  }

  b_3 {
    jmp b_4
  }

  b_4 {
    jmp b_5
  }

  b_5 {
    jmp b_6
  }

  b_6 {
    jmp b_7
  }

  b_7 {
    jmp b_8
  }

  b_8 {
    jmp b_9
  }

  b_10 {
    jmp b_11
  }

  b_9 {
    jmp b_10
  }

  b_12 {
    %v_13 = alloca 8, 4: Ptr
    store %v_13, 1, 1
    %v_14 = add %v_13, 4: Ptr
    store %v_14, 1, 1
    %v_15 = load %v_13, 1: I32
    %v_16 = cmp_eq %v_15, 0: I32
    je %v_16, b_17, b_18
  }

  b_11 {
    jmp b_12
  }

  b_18 {
    %v_19 = load %v_14, 1: I32
    %v_20 = select %v_19, 1, 2: I32
    jmp b_21
  }

  b_17 {
    %v_22 = loads %v_14, 4: I32
    %v_23 = sub 0, %v_22: I32
    jmp b_21
  }

  b_21 {
    %v_24 = phi [b_18, %v_20], [b_17, %v_23]: I32
    %v_25 = add 16, %v_24: I32
    %v_26 = add 23400, %v_25: I32
    %v_27 = alloca 8, 4: Ptr
    %v_28 = alloca 8, 4: Ptr
    %v_29 = add %v_27, 4: Ptr
    store %v_29, 4, 4
    store %v_27, 0, 1
    call_complex teardown(Held), %v_27
    store %v_28, 1, 1
    call_complex teardown(Held), %v_28
    %v_30 = loads @trace, 4: I32
    %v_31 = add %v_26, %v_30: I32
    ret %v_31
  }
}

teardown(Held)<complex>(%v_0: Ptr) {
  b_1 {
    %v_2 = load %v_0, 1: I32
    %v_3 = cmp_eq %v_2, 0: I32
    je %v_3, b_4, b_5
  }

  b_6 {
    ret 
  }

  b_4 {
    %v_7 = add %v_0, 4: Ptr
    call_complex Guard.drop, %v_7
    jmp b_6
  }

  b_5 {
    jmp b_6
  }
}

