mut @trace = [0, 0, 0, 0]

area<complex>(%s: Ptr): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    %v_2 = alloca 4, 4: Ptr
    %v_3 = alloca 4, 4: Ptr
    %v_4 = load %s, 1: I32
    %v_5 = cmp_eq %v_4, 0: I32
    je %v_5, b_6, b_7
  }

  b_7 {
    %v_8 = load %s, 1: I32
    %v_9 = cmp_eq %v_8, 1: I32
    je %v_9, b_10, b_11
  }

  b_11 {
    %v_12 = add %s, 4: Ptr
    %v_13 = loads %v_12, 4: I32
    store %v_2, %v_13, 4
    %v_14 = add %s, 8: Ptr
    %v_15 = loads %v_14, 4: I32
    store %v_3, %v_15, 4
    %v_16 = loads %v_2, 4: I32
    %v_17 = loads %v_3, 4: I32
    %v_18 = imul %v_16, %v_17: I32
    jmp b_19
  }

  b_19 {
    %v_20 = phi [b_11, %v_18], [b_6, 0], [b_10, %v_21]: I32
    ret %v_20
  }

  b_6 {
    jmp b_19
  }

  b_10 {
    %v_22 = add %s, 4: Ptr
    %v_23 = loads %v_22, 4: I32
    store %v_1, %v_23, 4
    %v_21 = loads %v_1, 4: I32
    jmp b_19
  }
}

rank<complex>(%c: I32): I32 {
  b_0 {
    %v_1 = alloca 1, 1: Ptr
    store %v_1, %c, 1
    %v_2 = load %v_1, 1: I32
    %v_3 = cmp_eq %v_2, 0: I32
    je %v_3, b_4, b_5
  }

  b_5 {
    %v_6 = load %v_1, 1: I32
    %v_7 = cmp_eq %v_6, 1: I32
    je %v_7, b_8, b_9
  }

  b_9 {
    jmp b_10
  }

  b_10 {
    %v_11 = phi [b_9, 300], [b_4, 100], [b_8, 200]: I32
    ret %v_11
  }

  b_4 {
    jmp b_10
  }

  b_8 {
    jmp b_10
  }
}

unwrapOr<complex>(%o: Ptr, %fallback: I32): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    %v_2 = alloca 4, 4: Ptr
    store %v_1, %fallback, 4
    %v_3 = load %o, 1: I32
    %v_4 = cmp_eq %v_3, 0: I32
    je %v_4, b_5, b_6
  }

  b_6 {
    jmp b_7
  }

  b_7 {
    %v_8 = loads %v_1, 4: I32
    ret %v_8
  }

  b_5 {
    %v_9 = add %o, 4: Ptr
    %v_10 = loads %v_9, 4: I32
    store %v_2, %v_10, 4
    %v_11 = loads %v_2, 4: I32
    ret %v_11
  }
}

negated<complex>(%o: Ptr): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    %v_2 = alloca 1, 1: Ptr
    %v_3 = load %o, 1: I32
    %v_4 = cmp_eq %v_3, 0: I32
    je %v_4, b_5, b_6
  }

  b_6 {
    %v_7 = add %o, 4: Ptr
    %v_8 = load %v_7, 1: I32
    store %v_2, %v_8, 1
    %v_9 = load %v_2, 1: I32
    je %v_9, b_10, b_11
  }

  b_12 {
    %v_13 = phi [b_5, %v_14], [b_15, %v_16]: I32
    ret %v_13
  }

  b_5 {
    %v_17 = add %o, 4: Ptr
    %v_18 = loads %v_17, 4: I32
    store %v_1, %v_18, 4
    %v_19 = loads %v_1, 4: I32
    %v_14 = sub 0, %v_19: I32
    jmp b_12
  }

  b_11 {
    jmp b_15
  }

  b_15 {
    %v_16 = phi [b_11, 2], [b_10, 1]: I32
    jmp b_12
  }

  b_10 {
    jmp b_15
  }
}

Guard.drop<complex>(%value: Ptr) {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    copy %v_1, %value, 4
    %v_2 = loads @trace, 4: I32
    %v_3 = loads %v_1, 4: I32
    %v_4 = add %v_2, %v_3: I32
    store @trace, %v_4, 4
    ret 
  }
}

guard<complex>(%v_0: Ptr, %id: I32) {
  b_1 {
    %v_2 = alloca 4, 4: Ptr
    store %v_2, %id, 4
    %v_3 = loads %v_2, 4: I32
    %v_4 = alloca 4, 4: Ptr
    store %v_4, %v_3, 4
    copy %v_0, %v_4, 4
    ret 
  }
}

releases<complex>(): I32 {
  b_0 {
    %v_1 = alloca 8, 4: Ptr
    %v_2 = alloca 8, 4: Ptr
    %v_3 = alloca 4, 4: Ptr
    call_complex guard, %v_3, 4
    %v_4 = alloca 8, 4: Ptr
    store %v_4, 0, 1
    %v_5 = add %v_4, 4: Ptr
    copy %v_5, %v_3, 4
    copy %v_1, %v_4, 8
    call_complex teardown(Held), %v_1
    %v_6 = alloca 8, 4: Ptr
    store %v_6, 1, 1
    copy %v_2, %v_6, 8
    call_complex teardown(Held), %v_2
    %v_7 = loads @trace, 4: I32
    ret %v_7
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    %v_2 = alloca 4, 4: Ptr
    %v_3 = alloca 4, 4: Ptr
    %v_4 = alloca 12, 4: Ptr
    store %v_4, 0, 1
    %v_5 = call_complex area, %v_4: I32
    %v_6 = alloca 12, 4: Ptr
    store %v_6, 1, 1
    %v_7 = add %v_6, 4: Ptr
    store %v_7, 3, 4
    %v_8 = call_complex area, %v_6: I32
    %v_9 = add %v_5, %v_8: I32
    %v_10 = alloca 12, 4: Ptr
    store %v_10, 2, 1
    %v_11 = add %v_10, 4: Ptr
    store %v_11, 4, 4
    %v_12 = add %v_10, 8: Ptr
    store %v_12, 5, 4
    %v_13 = call_complex area, %v_10: I32
    %v_14 = add %v_9, %v_13: I32
    store %v_1, %v_14, 4
    %v_15 = call_complex rank, 0: I32
    %v_16 = call_complex rank, 2: I32
    %v_17 = add %v_15, %v_16: I32
    store %v_2, %v_17, 4
    %v_18 = alloca 8, 4: Ptr
    store %v_18, 0, 1
    %v_19 = add %v_18, 4: Ptr
    store %v_19, 7, 4
    %v_20 = call_complex unwrapOr, %v_18, 9: I32
    %v_21 = alloca 8, 4: Ptr
    store %v_21, 1, 1
    %v_22 = add %v_21, 4: Ptr
    store %v_22, 1, 4
    %v_23 = call_complex unwrapOr, %v_21, 9: I32
    %v_24 = add %v_20, %v_23: I32
    %v_25 = alloca 8, 4: Ptr
    store %v_25, 1, 1
    %v_26 = add %v_25, 4: Ptr
    store %v_26, 1, 1
    %v_27 = call_complex negated, %v_25: I32
    %v_28 = add %v_24, %v_27: I32
    store %v_3, %v_28, 4
    %v_29 = loads %v_1, 4: I32
    %v_30 = imul %v_29, 1000: I32
    %v_31 = loads %v_2, 4: I32
    %v_32 = add %v_30, %v_31: I32
    %v_33 = loads %v_3, 4: I32
    %v_34 = add %v_32, %v_33: I32
    %v_35 = call_complex releases: I32
    %v_36 = add %v_34, %v_35: I32
    ret %v_36
  }
}

teardown(Held)<complex>(%v_0: Ptr) {
  b_1 {
    %v_2 = load %v_0, 1: I32
    %v_3 = cmp_eq %v_2, 0: I32
    je %v_3, b_4, b_5
  }

  b_6 {
    ret 
  }

  b_4 {
    %v_7 = add %v_0, 4: Ptr
    call_complex Guard.drop, %v_7
    jmp b_6
  }

  b_5 {
    jmp b_6
  }
}

