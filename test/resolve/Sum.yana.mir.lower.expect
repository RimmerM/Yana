mut @trace = [0, 0, 0, 0]

Guard.drop<complex>(%value: Ptr) {
  b_0 {
    %v_1 = load %value, 4: I32
    %v_2 = loads @trace, 4: I32
    %v_3 = add %v_2, %v_1: I32
    store @trace, %v_3, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    jmp b_1
  }

  b_1 {
    jmp b_2
  }

  b_2 {
    jmp b_3
  }

  b_3 {
    jmp b_4
  }

  b_4 {
    jmp b_5
  }

  b_5 {
    jmp b_6
  }

  b_6 {
    jmp b_7
  }

  b_7 {
    jmp b_8
  }

  b_8 {
    jmp b_9
  }

  b_9 {
    jmp b_10
  }

  b_10 {
    jmp b_11
  }

  b_11 {
    jmp b_12
  }

  b_12 {
    jmp b_13
  }

  b_14 {
    jmp b_15
  }

  b_13 {
    jmp b_14
  }

  b_16 {
    %v_17 = alloca 8, 4: Ptr
    store %v_17, 1, 1
    %v_18 = add %v_17, 4: Ptr
    store %v_18, 1, 1
    %v_19 = load %v_17, 1: I32
    %v_20 = cmp_eq %v_19, 0: I32
    je %v_20, b_21, b_22
  }

  b_15 {
    jmp b_16
  }

  b_22 {
    %v_23 = load %v_18, 1: I32
    %v_24 = select %v_23, 1, 2: I32
    jmp b_25
  }

  b_21 {
    %v_26 = loads %v_18, 4: I32
    %v_27 = sub 0, %v_26: I32
    jmp b_25
  }

  b_25 {
    %v_28 = phi [b_22, %v_24], [b_21, %v_27]: I32
    %v_29 = add 16, %v_28: I32
    %v_30 = add 23400, %v_29: I32
    %v_31 = alloca 8, 4: Ptr
    %v_32 = alloca 8, 4: Ptr
    store %v_31, 0, 1
    %v_33 = add %v_31, 4: Ptr
    store %v_33, 4, 4
    call_complex teardown(Held), %v_31
    store %v_32, 1, 1
    call_complex teardown(Held), %v_32
    %v_34 = loads @trace, 4: I32
    %v_35 = add %v_30, %v_34: I32
    ret %v_35
  }
}

teardown(Held)<complex>(%v_0: Ptr) {
  b_1 {
    %v_2 = load %v_0, 1: I32
    %v_3 = cmp_eq %v_2, 0: I32
    je %v_3, b_4, b_5
  }

  b_6 {
    ret 
  }

  b_4 {
    %v_7 = add %v_0, 4: Ptr
    call_complex Guard.drop, %v_7
    jmp b_6
  }

  b_5 {
    jmp b_6
  }
}

