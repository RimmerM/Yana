data Shape = Circle {Circle: I32} | Square {width: I32, height: I32}

fn orZero(m: Maybe(I32) [shared call]) -> I32 {
  local v: I32

bb0:
  %0: U8 = read copy.trivial (m.#)
  %1: U8 = const 1
  %2: Bool = eq inspect %0 inspect %1
  branch inspect %2 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %11: I32 = const 0
  return take %11

bb3:
  %4: I32 = read copy.trivial (m.Just)
  write.init borrow.unique (v) take %4
  %6: I32 = read copy.trivial (v)
  %7: I32 = const 1
  %8: I32 = add inspect %6 inspect %7
  return take %8
}

