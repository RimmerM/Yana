module ResolveTest

data Person {name: I32, age: I32}

data Item {name: I32, cost: I32}

data Left {name: I32, tag: I32}

data Right {tag: I32, name: I32}

fn nameOf'2(p: a [shared call]) -> I32 {
  form specialized
  slot #0 type a
  slot #1 property a.name
bb0:
  %0: I32 = read copy.trivial (p.name)
  return take %0
}

fn rename(p: a [unique call], to: I32 [shared call]) -> {} {
  form specialized
  slot #0 type a
  slot #1 property a.name
bb0:
  %0: I32 = read copy.trivial (to)
  write.assign borrow.unique (p.name) take %0
  return
}

fn labelled(p: a [shared call]) -> I32 {
  form specialized
  slot #0 type a
  slot #1 property a.name
  slot #2 property a.tag
bb0:
  %0: a [shared call] = read borrow.shared (p) loan0
  %1: I32 = call nameOf'2(a) borrow.shared %0
  %2: I32 = const 100
  %3: I32 = mul inspect %1 inspect %2
  %4: I32 = read copy.trivial (p.tag)
  %5: I32 = add inspect %3 inspect %4
  return take %5
}

fn main() -> I32 {
  local people: I32
  local items: I32
  local & subject: Person
  local left: I32
  local right: I32

bb0:
  %0: I32 = const 5
  %1: I32 = const 90
  %2: Person = aggregate.Person take %0 take %1
  %3: I32 = call nameOf'2(Person) borrow.shared %2
  write.init borrow.unique (people) take %3
  %5: I32 = const 2
  %6: I32 = const 7
  %7: Item = aggregate.Item take %5 take %6
  %8: I32 = call nameOf'2(Item) borrow.shared %7
  write.init borrow.unique (items) take %8
  %10: I32 = const 1
  %11: I32 = const 2
  %12: Person = aggregate.Person take %10 take %11
  write.init borrow.unique (subject) take %12
  %14: Person [unique call] = read borrow.unique (subject) loan0
  %15: I32 = const 8
  %16: {} = call rename(Person) borrow.unique %14 borrow.shared %15
  %17: I32 = const 1
  %18: I32 = const 3
  %19: Left = aggregate.Left take %17 take %18
  %20: I32 = call labelled(Left) borrow.shared %19
  write.init borrow.unique (left) take %20
  %22: I32 = const 4
  %23: I32 = const 6
  %24: Right = aggregate.Right take %22 take %23
  %25: I32 = call labelled(Right) borrow.shared %24
  write.init borrow.unique (right) take %25
  %27: I32 = read copy.trivial (people)
  %28: I32 = const 1000
  %29: I32 = mul inspect %27 inspect %28
  %30: I32 = read copy.trivial (items)
  %31: I32 = const 100
  %32: I32 = mul inspect %30 inspect %31
  %33: I32 = add inspect %29 inspect %32
  %34: Person = read copy.trivial (subject)
  %35: I32 = call nameOf'2(Person) borrow.shared %34
  %36: I32 = const 10
  %37: I32 = mul inspect %35 inspect %36
  %38: I32 = add inspect %33 inspect %37
  %39: I32 = read copy.trivial (left)
  %40: I32 = add inspect %38 inspect %39
  %41: I32 = read copy.trivial (right)
  %42: I32 = add inspect %40 inspect %41
  return take %42
}

fn nameOf'2(Person)(p: Person [shared call]) -> I32 = <nameOf at Person>

fn nameOf'2(Item)(p: Item [shared call]) -> I32 = <nameOf at Item>

fn rename(Person)(p: Person [unique call], to: I32 [shared call]) -> {} = <rename at Person>

fn labelled(Left)(p: Left [shared call]) -> I32 = <labelled at Left>

fn labelled(Right)(p: Right [shared call]) -> I32 = <labelled at Right>

fn nameOf'2(Left)(p: Left [shared call]) -> I32 = <nameOf at Left>

fn nameOf'2(Right)(p: Right [shared call]) -> I32 = <nameOf at Right>

entry main
