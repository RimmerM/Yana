  %11: Atomic(I32) [shared call] = read borrow.shared (c) loan2
  %12: I32 = const 9
  %13: UpdateOrder = const UpdateAcquireRelease
  %14: I32 = atomic.xchg acqrel inspect %11 inspect %12
  write.init borrow.unique (previous) take %14
  %16: I32 = read copy.trivial (seen)
  %17: I32 = read copy.trivial (previous)
  %18: I32 = add inspect %16 inspect %17
  %19: Atomic(I32) = read take (c)
  %20: I32 = atomic.into relaxed take %19
  %21: I32 = add inspect %18 inspect %20
  return take %21
}

