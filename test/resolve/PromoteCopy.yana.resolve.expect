let image$base: () = <none>

fn classify(%n: I32) -> Code {
  b0:
    %v3 = cmp_eq %n, 1 : Bool
    je %v3, b1, b2

  b1:
    jmp b7

  b2:
    %v8 = cmp_eq %n, 2 : Bool
    je %v8, b3, b4

  b3:
    jmp b7

  b4:
    %v13 = cmp_eq %n, 3 : Bool
    je %v13, b5, b6

  b5:
    jmp b7

  b6:
    jmp b7

  b7:
    %v21 = phi [b1, Missing], [b3, Denied], [b5, Busy], [b6, Full] : Code
    ret %v21
}

fn weight(%c: Code) -> I32 {
  b0:
    %v1 = cast %c : I32
    %v3 = add %v1, 1 : I32
    ret %v3
}

fn attempt(%n: I32) -> Outcome {
  b0:
    %v3 = cmp_lt %n, 0 : Bool
    je %v3, b1, b2

  b1:
    %v5 = alloc : Outcome
    %v9 = sub 0, %n : I32
    %v10 = call classify, %v9 : Code
    aggregate %local0.discriminant = 0, %local0@Failed = %v10
    ret %v5

  b2:
    jmp b3

  b3:
    %v14 = alloc : Outcome
    init %local1.discriminant, 1
    ret %v14
}

fn score(%n: I32) -> I32 {
  b0:
    %v1 = call attempt, %n : Outcome
    %v2 = load %local0.discriminant : I32
    %v4 = cmp_eq %v2, 1 : Bool
    je %v4, b2, b1

  b1:
    %c = load %local0@Failed : Code
    jmp b3

  b2:
    jmp b3

  b3:
    %v11 = phi [b2, 0], [b1, 1] : I32
    ret %v11
}

fn triage(%n: I32) -> Outcome {
  b0:
    %v3 = cmp_gt %n, 10 : Bool
    je %v3, b1, b2

  b1:
    %v5 = alloc : Outcome
    init %local0.discriminant, 1
    ret %v5

  b2:
    jmp b3

  b3:
    %v12 = cmp_gt %n, 0 : Bool
    je %v12, b4, b5

  b4:
    %v14 = alloc : Outcome
    %v16 = call classify, %n : Code
    aggregate %local1.discriminant = 0, %local1@Failed = %v16
    ret %v14

  b5:
    jmp b6

  b6:
    %v20 = alloc : Outcome
    %v24 = sub 0, %n : I32
    %v25 = call classify, %v24 : Code
    aggregate %local2.discriminant = 0, %local2@Failed = %v25
    ret %v20
}

fn ranked(%n: I32) -> I32 {
  b0:
    %v1 = call triage, %n : Outcome
    %v2 = load %local0.discriminant : I32
    %v4 = cmp_eq %v2, 1 : Bool
    je %v4, b2, b1

  b1:
    %c = load %local0@Failed : Code
    jmp b3

  b2:
    jmp b3

  b3:
    %v11 = phi [b2, 0], [b1, 1] : I32
    ret %v11
}

fn removeIt(%n: I32) -> Result(Code, ()) {
  b0:
    %v3 = cmp_lt %n, 0 : Bool
    je %v3, b1, b2

  b1:
    %v5 = alloc : Result(Code, ())
    %v9 = sub 0, %n : I32
    %v10 = call classify, %v9 : Code
    aggregate %local0.discriminant = 0, %local0@Err = %v10
    ret %v5

  b2:
    jmp b3

  b3:
    %v14 = alloc : Result(Code, ())
    init %local1.discriminant, 1
    ret %v14
}

fn removed(%n: I32) -> I32 {
  b0:
    %v1 = call removeIt, %n : Result(Code, ())
    %v2 = load %local0.discriminant : I32
    %v4 = cmp_eq %v2, 1 : Bool
    je %v4, b2, b1

  b1:
    %e = load %local0@Err : Code
    jmp b3

  b2:
    jmp b3

  b3:
    %v11 = phi [b2, 0], [b1, 1] : I32
    ret %v11
}

fn scored(%n: I32) -> I32 {
  b0:
    %v1 = call attempt, %n : Outcome
    %v2 = load %local0.discriminant : I32
    %v4 = cmp_eq %v2, 1 : Bool
    je %v4, b2, b1

  b1:
    %c = load %local0@Failed : Code
    %v8 = call weight, %c : I32
    jmp b3

  b2:
    jmp b3

  b3:
    %v11 = phi [b2, 0], [b1, %v8] : I32
    ret %v11
}

fn main() -> I32 {
  b0:
    %v1 = call score, 1 : I32
    %v6 = sub 0, 1 : I32
    %v7 = call score, %v6 : I32
    %v8 = add %v1, %v7 : I32
    %v13 = sub 0, 2 : I32
    %v14 = call score, %v13 : I32
    %v15 = add %v8, %v14 : I32
    %v20 = sub 0, 3 : I32
    %v21 = call score, %v20 : I32
    %v22 = add %v15, %v21 : I32
    %v27 = sub 0, 4 : I32
    %v28 = call score, %v27 : I32
    %v29 = add %v22, %v28 : I32
    %v31 = call ranked, 50 : I32
    %v32 = add %v29, %v31 : I32
    %v34 = call ranked, 2 : I32
    %v35 = add %v32, %v34 : I32
    %v40 = sub 0, 3 : I32
    %v41 = call ranked, %v40 : I32
    %v42 = add %v35, %v41 : I32
    %v44 = call removed, 4 : I32
    %v45 = add %v42, %v44 : I32
    %v50 = sub 0, 1 : I32
    %v51 = call removed, %v50 : I32
    %v52 = add %v45, %v51 : I32
    %v57 = sub 0, 3 : I32
    %v58 = call scored, %v57 : I32
    %v61 = mul %v58, 10 : I32
    %v62 = add %v52, %v61 : I32
    %v64 = call scored, 9 : I32
    %v67 = mul %v64, 100 : I32
    %v68 = add %v62, %v67 : I32
    ret %v68
