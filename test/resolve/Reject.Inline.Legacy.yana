-- The rule of `Reject.Inline.yana` the default stage does not refuse yet: plain `@inline` beside
-- `@noinline`. It accepts it: the default stage checks only `@inline(always)` against `@noinline`.
-- The recursive `@inline(always)` this file also held is `Reject.Inline.Recursive.yana`.

-- The two together are a contradiction rather than a precedence question, so neither applies and
-- the function is left to the ordinary heuristics.
@inline
@noinline
fn undecided(x: Int) -> Int = x + 4

fn main() -> Int = undecided(4)
