fn total(xs: Array(a) [shared call view]) -> a {
  form specialized
  slot #0 type a
  slot #1 class Num(a)
  local & acc: a
  local v: a [shared call]

bb0:
  %0: I64 = const 0
  %1: a = call fromInt(a) borrow.shared %0
  write.init borrow.unique (acc) take %1
  %3: Array(a) [shared call view] = read borrow.shared (xs) loan0
  lens.call items(Array(a), a) borrow.shared %3 -> bb2

bb1:
  %12: a = read take (acc)
  return take %12

bb2(%4: a [shared call]) handover(a [shared call]) many -> bb1:
  write.init borrow.unique (v) borrow.shared %4
  %7: a [shared call] = read borrow.shared (acc) loan1
  %8: a [shared call] = read borrow.shared (v) loan2 roots{0}
  %9: a = call +(a) borrow.shared %7 borrow.shared %8
  drop (acc)
  write.reinit borrow.unique (acc) take %9
  jump -> bb1
}

