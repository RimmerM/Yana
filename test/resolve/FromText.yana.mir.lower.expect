    %v_50 = add %from, %v_49: Ptr
    %v_51 = load %v_50, 8: I64
    store %to, %v_48, 8
    %v_52 = add %to, %v_49: Ptr
    store %v_52, %v_51, 8
    jmp b_30
  }

  b_46 {
    %v_53 = load %from, 16: i8x16
    %v_54 = sub %count, 16: I64
    %v_55 = add %from, %v_54: Ptr
    %v_56 = load %v_55, 16: i8x16
    store %to, %v_53, 16
    %v_57 = add %to, %v_54: Ptr
    store %v_57, %v_56, 16
    jmp b_30
  }

  b_30 {
    ret 
  }
}

