@image$base = []

main<complex>(): Int {
  b_0 {
    %v_1 = alloca 8, 4: Ptr
    store %v_1, 1, 4
    %v_2 = add %v_1, 4: Ptr
    store %v_2, 1, 4
    %v_3 = alloca 8, 4: Ptr
    store %v_3, 1, 4
    %v_4 = add %v_3, 4: Ptr
    store %v_4, 1, 4
    %v_5 = call_complex Eq(Maybe(a)).==(Int), %v_1, %v_3: Int
    je %v_5, b_6, b_7
  }

  b_6 {
    jmp b_7
  }

  b_7 {
    %v_8 = phi [b_0, 0], [b_6, 1]: Long
    %v_9 = alloca 8, 4: Ptr
    store %v_9, 1, 4
    %v_10 = add %v_9, 4: Ptr
    store %v_10, 1, 4
    %v_11 = alloca 8, 4: Ptr
    store %v_11, 1, 4
    %v_12 = add %v_11, 4: Ptr
    store %v_12, 2, 4
    %v_13 = call_complex Eq(Maybe(a)).==(Int), %v_9, %v_11: Int
    %v_14 = xor %v_13, 1: Int
    je %v_14, b_15, b_16
  }

  b_15 {
    %v_17 = add %v_8, 2: Long
    jmp b_16
  }

  b_16 {
    %v_18 = phi [b_7, %v_8], [b_15, %v_17]: Long
    %v_19 = alloca 8, 4: Ptr
    store %v_19, 0, 4
    %v_20 = alloca 8, 4: Ptr
    store %v_20, 0, 4
    %v_21 = call_complex Eq(Maybe(a)).==(Int), %v_19, %v_20: Int
    je %v_21, b_22, b_23
  }

  b_22 {
    %v_24 = add %v_18, 4: Long
    jmp b_23
  }

  b_23 {
    %v_25 = phi [b_16, %v_18], [b_22, %v_24]: Long
    %v_26 = add %v_25, 8: Long
    %v_27 = alloca 8, 8: Ptr
    store %v_27, 0, 8
    %v_28 = alloca 8, 8: Ptr
    store %v_28, 0, 8
    %v_29 = cmp_lt %v_27, %v_28: Int
    %v_30 = select %v_29, %v_27, %v_28: Ptr
    %v_31 = cmp_lt %v_28, %v_27: Int
    %v_32 = select %v_31, %v_28, %v_27: Ptr
    %v_33 = cmp_le %v_30, %v_32: Int
    je %v_33, b_34, b_35
  }

  b_34 {
    jmp b_35
  }

  b_35 {
    %v_36 = phi [b_23, 0], [b_34, 1]: Long
    %v_37 = cmp_eq %v_30, %v_30: Int
    je %v_37, b_38, b_39
  }

  b_38 {
    %v_40 = add %v_36, 2: Long
    jmp b_39
  }

  b_39 {
    %v_41 = phi [b_35, %v_36], [b_38, %v_40]: Long
    %v_42 = add %v_41, 4: Long
    %v_43 = add %v_26, %v_42: Long
    %v_44 = add %v_43, 16: Long
    %v_45 = cast %v_44: Int
    ret %v_45
  }
}

Eq(Maybe(a)).==(Int)<complex>(%lhs: Ptr, %rhs: Ptr): Int {
  b_0 {
    %v_1 = loads %lhs, 4: Int
    %v_2 = cmp_eq %v_1, 1: Int
    je %v_2, b_3, b_4
  }

  b_4 {
    %v_5 = cmp_eq %v_1, 0: Int
    je %v_5, b_6, b_7
  }

  b_3 {
    %v_8 = add %lhs, 4: Ptr
    %x = loads %v_8, 4: Int
    %v_9 = loads %rhs, 4: Int
    %v_10 = cmp_eq %v_9, 1: Int
    je %v_10, b_11, b_4
  }

  b_11 {
    %v_12 = add %rhs, 4: Ptr
    %y = loads %v_12, 4: Int
    %v_13 = cmp_eq %x, %y: Int
    jmp b_14
  }

  b_7 {
    jmp b_14
  }

  b_6 {
    %v_15 = loads %rhs, 4: Int
    %v_16 = cmp_eq %v_15, 0: Int
    je %v_16, b_17, b_7
  }

  b_17 {
    jmp b_14
  }

  b_14 {
    %v_18 = phi [b_11, %v_13], [b_17, 1], [b_7, 0]: Int
    ret %v_18
  }
}

