@image$base = []

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 8, 4: Ptr
    store %v_1, 1, 4
    %v_2 = add %v_1, 4: Ptr
    store %v_2, 1, 4
    %v_3 = alloca 8, 4: Ptr
    store %v_3, 1, 4
    %v_4 = add %v_3, 4: Ptr
    store %v_4, 1, 4
    %v_5 = call_complex Eq(Opt(a)).==(I32), %v_1, %v_3: I32
    je %v_5, b_6, b_7
  }

  b_6 {
    jmp b_7
  }

  b_7 {
    %v_8 = phi [b_0, 0], [b_6, 1]: I64
    %v_9 = alloca 8, 4: Ptr
    store %v_9, 1, 4
    %v_10 = add %v_9, 4: Ptr
    store %v_10, 1, 4
    %v_11 = alloca 8, 4: Ptr
    store %v_11, 1, 4
    %v_12 = add %v_11, 4: Ptr
    store %v_12, 2, 4
    %v_13 = call_complex Eq(Opt(a)).==(I32), %v_9, %v_11: I32
    je %v_13, b_14, b_15
  }

  b_15 {
    %v_16 = add %v_8, 2: I64
    jmp b_14
  }

  b_14 {
    %v_17 = phi [b_7, %v_8], [b_15, %v_16]: I64
    %v_18 = alloca 8, 4: Ptr
    store %v_18, 0, 4
    %v_19 = alloca 8, 4: Ptr
    store %v_19, 0, 4
    %v_20 = call_complex Eq(Opt(a)).==(I32), %v_18, %v_19: I32
    je %v_20, b_21, b_22
  }

  b_21 {
    %v_23 = add %v_17, 4: I64
    jmp b_22
  }

  b_22 {
    %v_24 = phi [b_14, %v_17], [b_21, %v_23]: I64
    %v_25 = add %v_24, 8: I64
    %v_26 = alloca 8, 8: Ptr
    store %v_26, 0, 8
    %v_27 = alloca 8, 8: Ptr
    store %v_27, 0, 8
    %v_28 = cmp_lt %v_26, %v_27: I32
    %v_29 = select %v_28, %v_26, %v_27: Ptr
    %v_30 = cmp_lt %v_27, %v_26: I32
    %v_31 = select %v_30, %v_27, %v_26: Ptr
    %v_32 = cmp_le %v_29, %v_31: I32
    je %v_32, b_33, b_34
  }

  b_33 {
    jmp b_34
  }

  b_34 {
    %v_35 = phi [b_22, 0], [b_33, 1]: I64
    %v_36 = cmp_eq %v_29, %v_29: I32
    je %v_36, b_37, b_38
  }

  b_37 {
    %v_39 = add %v_35, 2: I64
    jmp b_38
  }

  b_38 {
    %v_40 = phi [b_34, %v_35], [b_37, %v_39]: I64
    %v_41 = add %v_40, 4: I64
    %v_42 = add %v_25, %v_41: I64
    %v_43 = add %v_42, 16: I64
    %v_44 = cast %v_43: I32
    ret %v_44
  }
}

Eq(Opt(a)).==(I32)<complex>(%lhs: Ptr, %rhs: Ptr): I32 {
  b_0 {
    %v_1 = loads %lhs, 4: I32
    %v_2 = cmp_eq %v_1, 1: I32
    je %v_2, b_3, b_4
  }

  b_4 {
    %v_5 = cmp_eq %v_1, 0: I32
    je %v_5, b_6, b_7
  }

  b_3 {
    %v_8 = add %lhs, 4: Ptr
    %x = loads %v_8, 4: I32
    %v_9 = loads %rhs, 4: I32
    %v_10 = cmp_eq %v_9, 1: I32
    je %v_10, b_11, b_4
  }

  b_11 {
    %v_12 = add %rhs, 4: Ptr
    %y = loads %v_12, 4: I32
    %v_13 = cmp_eq %x, %y: I32
    jmp b_14
  }

  b_7 {
    jmp b_14
  }

  b_6 {
    %v_15 = loads %rhs, 4: I32
    %v_16 = cmp_eq %v_15, 0: I32
    je %v_16, b_17, b_7
  }

  b_17 {
    jmp b_14
  }

  b_14 {
    %v_18 = phi [b_11, %v_13], [b_17, 1], [b_7, 0]: I32
    ret %v_18
  }
}

