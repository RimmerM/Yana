@image$base = []

maybes<complex>(): Long {
  b_0 {
    %v_1 = alloca 8, 4: Ptr
    store %v_1, 1, 4
    %v_2 = add %v_1, 4: Ptr
    store %v_2, 1, 4
    %v_3 = alloca 8, 4: Ptr
    store %v_3, 1, 4
    %v_4 = add %v_3, 4: Ptr
    store %v_4, 1, 4
    %v_5 = call_complex Eq(Maybe(a)).==(Int), %v_1, %v_3: Int
    je %v_5, b_6, b_7
  }

  b_6 {
    jmp b_7
  }

  b_7 {
    %v_8 = phi [b_0, 0], [b_6, 1]: Long
    %v_9 = alloca 8, 4: Ptr
    store %v_9, 1, 4
    %v_10 = add %v_9, 4: Ptr
    store %v_10, 1, 4
    %v_11 = alloca 8, 4: Ptr
    store %v_11, 1, 4
    %v_12 = add %v_11, 4: Ptr
    store %v_12, 2, 4
    %v_13 = call_complex Eq(Maybe(a)).==(Int), %v_9, %v_11: Int
    %v_14 = xor %v_13, 1: Int
    je %v_14, b_15, b_16
  }

  b_15 {
    %v_17 = add %v_8, 2: Long
    jmp b_16
  }

  b_16 {
    %v_18 = phi [b_7, %v_8], [b_15, %v_17]: Long
    %v_19 = alloca 8, 4: Ptr
    store %v_19, 0, 4
    %v_20 = alloca 8, 4: Ptr
    store %v_20, 0, 4
    %v_21 = call_complex Eq(Maybe(a)).==(Int), %v_19, %v_20: Int
    je %v_21, b_22, b_23
  }

  b_22 {
    %v_24 = add %v_18, 4: Long
    jmp b_23
  }

  b_23 {
    %v_25 = phi [b_16, %v_18], [b_22, %v_24]: Long
    %v_26 = add %v_25, 8: Long
    ret %v_26
  }
}

pointers<complex>(): Long {
  b_0 {
    %v_1 = alloca 8, 8: Ptr
    store %v_1, 0, 8
    %v_2 = alloca 8, 8: Ptr
    store %v_2, 0, 8
    %v_3 = cmp_lt %v_1, %v_2: Int
    %v_4 = select %v_1, %v_2, %v_3: Ptr
    %v_5 = cmp_lt %v_2, %v_1: Int
    %v_6 = select %v_2, %v_1, %v_5: Ptr
    %v_7 = cmp_le %v_4, %v_6: Int
    je %v_7, b_8, b_9
  }

  b_8 {
    jmp b_9
  }

  b_9 {
    %v_10 = phi [b_0, 0], [b_8, 1]: Long
    %v_11 = cmp_eq %v_4, %v_4: Int
    je %v_11, b_12, b_13
  }

  b_12 {
    %v_14 = add %v_10, 2: Long
    jmp b_13
  }

  b_13 {
    %v_15 = phi [b_9, %v_10], [b_12, %v_14]: Long
    %v_16 = add %v_15, 4: Long
    ret %v_16
  }
}

main<complex>(): Int {
  b_0 {
    %v_1 = call_complex maybes: Long
    %v_2 = call_complex pointers: Long
    %v_3 = add %v_1, %v_2: Long
    %v_4 = add %v_3, 16: Long
    %v_5 = cast %v_4: Int
    ret %v_5
  }
}

Eq(Maybe(a)).==(Int)<complex>(%lhs: Ptr, %rhs: Ptr): Int {
  b_0 {
    %v_1 = loads %lhs, 4: Int
    %v_2 = cmp_eq %v_1, 1: Int
    je %v_2, b_3, b_4
  }

  b_4 {
    %v_5 = cmp_eq %v_1, 0: Int
    je %v_5, b_6, b_7
  }

  b_3 {
    %v_8 = add %lhs, 4: Ptr
    %x = loads %v_8, 4: Int
    %v_9 = loads %rhs, 4: Int
    %v_10 = cmp_eq %v_9, 1: Int
    je %v_10, b_11, b_4
  }

  b_11 {
    %v_12 = add %rhs, 4: Ptr
    %y = loads %v_12, 4: Int
    %v_13 = cmp_eq %x, %y: Int
    jmp b_14
  }

  b_7 {
    jmp b_14
  }

  b_6 {
    %v_15 = loads %rhs, 4: Int
    %v_16 = cmp_eq %v_15, 0: Int
    je %v_16, b_17, b_7
  }

  b_17 {
    jmp b_14
  }

  b_14 {
    %v_18 = phi [b_11, %v_13], [b_17, 1], [b_7, 0]: Int
    ret %v_18
  }
}

