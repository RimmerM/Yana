"use strict";
// ResolveTest
function widen(value) {
  return BigInt.asIntN(64, BigInt(value));
}

function longLiteral() {
  return 9n;
}

function floatLiteral() {
  return 1.5;
}

function doubleLiteral() {
  return 1.5;
}

function floatProduct(a, b) {
  return Math.fround(a * b);
}

function doubleSum(a, b) {
  return a + b;
}

function both(a, b) {
  return a ? b : a;
}

function main() {
  return 7;
}
