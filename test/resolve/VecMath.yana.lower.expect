@image$base = []

scalars<complex>(): I32 {
  b_0 {
    %v_1 = sqrt 16: F64
    %v_2 = cmp_neq %v_1, 4: I32
    je %v_2, b_3, b_4
  }

  b_3 {
    ret 18446744073709551615
  }

  b_4 {
    %v_5 = sqrt 2.25: F64
    %v_6 = cmp_neq %v_5, 1.5: I32
    je %v_6, b_7, b_8
  }

  b_7 {
    ret 18446744073709551614
  }

  b_8 {
    %v_9 = fma 2, 3, 4: F64
    %v_10 = cmp_neq %v_9, 10: I32
    je %v_10, b_11, b_12
  }

  b_11 {
    ret 18446744073709551613
  }

  b_12 {
    %v_13 = sqrt 6.25: F32
    %v_14 = cmp_neq %v_13, 2.5: I32
    je %v_14, b_15, b_16
  }

  b_15 {
    ret 18446744073709551612
  }

  b_16 {
    %v_17 = sqrt 0: F32
    %v_18 = div 1, %v_17: F32
    %v_19 = div 1, 0: F32
    %v_20 = cmp_neq %v_18, %v_19: I32
    je %v_20, b_21, b_22
  }

  b_21 {
    ret 18446744073709551611
  }

  b_22 {
