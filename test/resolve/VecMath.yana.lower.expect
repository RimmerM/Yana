}

lanes<complex>(): I32 {
  b_0 {
    %squares = vsplat 6.25: f32x4
    %roots = sqrt %squares: f32x4
    %v_1 = vlane %roots, 0: F32
    %v_2 = cmp_neq %v_1, 2.5: I32
    je %v_2, b_3, b_4
  }

  b_3 {
    ret 18446744073709551615
  }

  b_4 {
    %v_5 = vreduce_min %roots: F32
    %v_6 = cmp_neq %v_5, 2.5: I32
    je %v_6, b_7, b_8
  }

  b_7 {
    ret 18446744073709551614
  }

  b_8 {
    %v_9 = vsplat 0: f32x4
    %v_10 = vwithlane %v_9, 1, 1: f32x4
    %v_11 = vwithlane %v_10, 2, 2: f32x4
    %counted = vwithlane %v_11, 3, 3: f32x4
    %v_12 = vsplat 3: f32x4
    %v_13 = vsplat 1: f32x4
    %scaled = fma %counted, %v_12, %v_13: f32x4
    %v_14 = vlane %scaled, 0: F32
    %v_15 = cmp_neq %v_14, 1: I32
    je %v_15, b_16, b_17
  }

  b_16 {
    ret 18446744073709551613
  }

  b_17 {
    %v_18 = vlane %scaled, 1: F32
    %v_19 = cmp_neq %v_18, 4: I32
    je %v_19, b_20, b_21
  }

  b_20 {
    ret 18446744073709551612
  }

  b_21 {
    %v_22 = vlane %scaled, 2: F32
    %v_23 = cmp_neq %v_22, 7: I32
    je %v_23, b_24, b_25
  }

  b_24 {
    ret 18446744073709551611
  }

  b_25 {
    %v_26 = vreduce_add %scaled: F32
    %v_27 = cmp_neq %v_26, 22: I32
    je %v_27, b_28, b_29
  }

  b_28 {
    ret 18446744073709551610
  }

  b_29 {
    ret 0
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = call_complex scalars: I32
    %v_2 = cmp_neq %v_1, 0: I32
    je %v_2, b_3, b_4
  }

  b_3 {
    %v_5 = call_complex scalars: I32
    ret %v_5
  }

  b_4 {
    %v_6 = call_complex lanes: I32
    %v_7 = cmp_neq %v_6, 0: I32
    je %v_7, b_8, b_9
  }

  b_8 {
    %v_10 = call_complex lanes: I32
    %v_11 = imul %v_10, 10: I32
    ret %v_11
  }

  b_9 {
    ret 7
  }
}

