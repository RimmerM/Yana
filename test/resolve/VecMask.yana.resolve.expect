let image$base: () = <none>

fn pickByFloat(%a: Vec(F32), %b: Vec(F32), %x: Vec(I32), %y: Vec(I32)) -> Vec(I32) {
  b0:
    %v4 = cmp_lt %a, %b : Mask(F32)
    %v5 = bitcast %v4 : Mask(I32)
    %v6 = select %v5 ? %x : %y : Vec(I32)
    ret %v6
}

fn pickByInt(%a: Vec(I32), %b: Vec(I32), %x: Vec(F32), %y: Vec(F32)) -> Vec(F32) {
  b0:
    %v4 = cmp_lt %a, %b : Mask(I32)
    %v5 = bitcast %v4 : Mask(F32)
    %v6 = select %v5 ? %x : %y : Vec(F32)
    ret %v6
}

fn maskedTotal(%v: Vec(I32), %limit: I32) -> I32 {
  b0:
    %v2 = vsplat %limit : Vec(I32)
    %v3 = cmp_lt %v, %v2 : Mask(I32)
    %live = alloc : Mask(I32)
    init %live, %v3
    %v6 = load %live : Mask(I32)
    %v9 = vsplat 0 : Vec(I32)
    %kept = select %v6 ? %v : %v9 : Vec(I32)
    %v11 = load %live : Mask(I32)
    %v12 = vreduce_or %v11 : Bool
    %v14 = xor %v12, True : Bool
    je %v14, b1, b2

  b1:
    ret -1

  b2:
    jmp b3

  b3:
    %v19 = vreduce_add %kept : I32
    %v22 = mul %v19, 10 : I32
    %v23 = load %live : Mask(I32)
    %v24 = vreduce_add %v23 : I32
    %v25 = add %v22, %v24 : I32
    ret %v25
}

fn main() -> I32 {
  b0:
    %a = vsplat 1 : Vec(F32)
    %b = vsplat 2 : Vec(F32)
    %ints = vsplat 7 : Vec(I32)
    %others = vsplat 3 : Vec(I32)
    %picked = call pickByFloat, %a, %b, %ints, %others : Vec(I32)
    %floats = call pickByInt, %others, %ints, %a, %b : Vec(F32)
    %v15 = vsplat 0 : Vec(I32)
    %v17 = vwithlane %v15, 1, 1 : Vec(I32)
    %v19 = vwithlane %v17, 2, 2 : Vec(I32)
    %v21 = vwithlane %v19, 3, 3 : Vec(I32)
    %counted = call maskedTotal, %v21, 3 : I32
    %v26 = vlane %picked, 0 : I32
    %v29 = mul %v26, 100000 : I32
    %v32 = vlane %floats, 0 : F32
    %v35 = cmp_eq %v32, 1 : Bool
    je %v35, b1, b2

  b1:
    jmp b3

  b2:
    jmp b3

  b3:
    %v43 = phi [b1, 1], [b2, 0] : I32
    %v46 = mul %v43, 10000 : I32
    %v47 = add %v29, %v46 : I32
    %v48 = add %v47, %counted : I32
    ret %v48
}
