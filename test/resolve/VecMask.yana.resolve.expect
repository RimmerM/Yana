fn maskedTotal(%v: Vec(Int), %limit: Int) -> Int {
  b0:
    %v2 = vsplat %limit : Vec(Int)
    %v3 = cmp_lt %v, %v2 : Mask(Int)
    %live = alloc : Mask(Int)
