let image$base: () = <none>

fn pickByFloat(%a: Vec(Float), %b: Vec(Float), %x: Vec(Int), %y: Vec(Int)) -> Vec(Int) {
  b0:
    %v4 = cmp_lt %a, %b : Mask(Float)
    %v5 = bitcast %v4 : Mask(Int)
