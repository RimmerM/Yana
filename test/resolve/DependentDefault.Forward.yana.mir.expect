module ResolveTest

data Node(a, b) {value: a, link: b} drop derived reclaim derived

data Link(x, y) {head: x, weight: y} drop derived reclaim derived

data Chain(a, b) {start: a, rest: b} drop derived reclaim derived

data Link(I32, I32) {head: I32, weight: I32} of Link

data Node(I32, Link(I32, I32)) {value: I32, link: Link(I32, I32)} of Node

data Chain(I32, Node(I32, Link(I32, I32))) {start: I32, rest: Node(I32, Link(I32, I32))} of Chain

fn weigh(n: Node(I32, Link(I32, I32)) [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (n.value)
  %1: I32 = read copy.trivial (n.link.head)
  %2: I32 = read copy.trivial (n.link.weight)
  %3: I32 = mul inspect %1 inspect %2
  %4: I32 = add inspect %0 inspect %3
  return take %4
}

fn follow(c: Chain(I32, Node(I32, Link(I32, I32))) [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (c.start)
  %1: I32 = const 100
  %2: I32 = mul inspect %0 inspect %1
  %3: Node(I32, Link(I32, I32)) = read copy.trivial (c.rest)
  %4: I32 = call weigh borrow.shared %3
  %5: I32 = add inspect %2 inspect %4
  return take %5
}

fn main() -> I32 {
  local n: Node(I32, Link(I32, I32))
  local c: Chain(I32, Node(I32, Link(I32, I32)))

bb0:
  %0: I32 = const 1
  %1: I32 = const 2
  %2: I32 = const 3
  %3: Link(I32, I32) = aggregate.Link take %1 take %2
  %4: Node(I32, Link(I32, I32)) = aggregate.Node take %0 take %3
  write.init borrow.unique (n) take %4
  %6: I32 = const 4
  %7: I32 = const 5
  %8: I32 = const 6
  %9: I32 = const 7
  %10: Link(I32, I32) = aggregate.Link take %8 take %9
  %11: Node(I32, Link(I32, I32)) = aggregate.Node take %7 take %10
  %12: Chain(I32, Node(I32, Link(I32, I32))) = aggregate.Chain take %6 take %11
  write.init borrow.unique (c) take %12
  %14: Node(I32, Link(I32, I32)) = read copy.trivial (n)
  %15: I32 = call weigh borrow.shared %14
  %16: I32 = const 1000
  %17: I32 = mul inspect %15 inspect %16
  %18: Chain(I32, Node(I32, Link(I32, I32))) = read copy.trivial (c)
  %19: I32 = call follow borrow.shared %18
  %20: I32 = add inspect %17 inspect %19
  return take %20
}

entry main
