
main<complex>(): I32 {
  b_0 {
    jmp b_1
  }

  b_2 {
    %v_3 = cmp_ilt %v_4, 3: I32
    je %v_3, b_1, b_5
  }

  b_5 {
    %v_6 = alloca 16, 4: Ptr
    store %v_6, 1, 4
    %v_7 = add %v_6, 4: Ptr
    store %v_7, 2, 4
    %v_8 = add %v_6, 8: Ptr
    store %v_8, 3, 4
    %v_9 = add %v_6, 12: Ptr
    store %v_9, 4, 4
    %v_10 = add %v_11, 11: I32
    ret %v_10
  }

  b_1 {
    %v_12 = phi [b_2, %v_4], [b_0, 0]: I32
    %v_13 = phi [b_2, %v_11], [b_0, 0]: I32
    %v_14 = add %v_13, 5: I32
    %v_11 = add %v_14, %v_12: I32
    %v_4 = add %v_12, 1: I32
    jmp b_2
  }
}

