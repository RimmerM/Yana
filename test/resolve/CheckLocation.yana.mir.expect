fn reachable(xs: Array(I32) [shared call view], at: Size [shared call]) -> I32 {
  local local2: I32 [shared slot 0]

bb0:
  %0: Size = read copy.trivial (at)
  %1: Array(I32) [shared call view] = read borrow.shared (xs) loan0
  %2: I32 [shared slot 0] = call.subscript get(Array(I32), Size, I32) borrow.shared %1 borrow.shared %0 roots{0}
  write.init borrow.unique (local2) borrow.shared %2
  %4: I32 = read copy.trivial (local2)
  return take %4
}

fn firstAtLeast(xs: Array(I32) [shared call view], bound: I32 [shared call]) -> Size {
  local & at: Size
