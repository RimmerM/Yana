  write.init borrow.unique (local3) borrow.shared %5
  %7: I32 = read copy.trivial (local3)
  %8: I32 = read copy.trivial (bound)
  %9: Bool = lt inspect %7 inspect %8
  branch inspect %9 -> bb3 -> bb2

bb2:
  %15: Size = read copy.trivial (at)
  return take %15

bb3:
  %11: Size [unique call] = read borrow.unique (at) loan1
  %12: Size = const 1
  %13: {} = call +=(Size) borrow.unique %11 borrow.shared %12
  jump -> bb1
}

