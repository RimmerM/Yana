fn widen(p: Point [unique call]) -> {} {
bb0:
  %0: I32 = read copy.trivial (p.x)
  %1: I32 = const 1
  %2: I32 = add inspect %0 inspect %1
  write.assign borrow.unique (p.x) take %2
