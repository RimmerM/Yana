"use strict";
// ResolveTest
function add(a, b) {
  return a + b | 0;
}

function noop() {
  return;
}

function local(value) {
  return Math.imul(value + 1 | 0, 2) | 0;
}

function choose(a, b) {
  return a > b ? a + 1 | 0 : b;
}

function classify(value) {
  return value < 0 ? -1 : value === 0 ? 0 : 1;
}

function main() {
  return 7;
}
