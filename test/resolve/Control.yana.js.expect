"use strict";
// ResolveTest
function add(a, b) {
  return a + b | 0;
}

function noop() {
  return;
}

function local(value) {
  return Math.imul(value + 1 | 0, 2) | 0;
}

function choose(a, b) {
  var v8;
  if (a > b) {
    v8 = a + 1 | 0;
  } else {
    v8 = b;
  }
  return v8;
}

function classify(value) {
  var v17;
  if (value < 0) {
    v17 = -1;
  } else {
    if (value === 0) {
      v17 = 0;
    } else {
      v17 = 1;
    }
  }
  return v17;
}

function main() {
  return (((Math.imul(choose(2, 1), 2) | 0) + classify(5) | 0) + 2 | 0) - 2 | 0;
}
