mut @released = [0, 0, 0, 0]

Counter.drop<complex>(%value: Ptr) {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    copy %v_1, %value, 4
    %released = global @released: Ptr
    %v_2 = loads %released, 4: I32
    %v_3 = add %v_2, 1: I32
    store %released, %v_3, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    jmp b_1
  }

  b_1 {
    jmp b_2
  }

  b_2 {
    jmp b_3
  }

  b_3 {
    jmp b_4
  }

  b_4 {
    %v_5 = alloca 8, 4: Ptr
    %v_6 = add %v_5, 4: Ptr
    store %v_6, 36, 4
    store %v_5, 1, 4
    call_complex Counter.drop, %v_6
    jmp b_7
  }

  b_7 {
    jmp b_8
  }

  b_8 {
    jmp b_9
  }

  b_9 {
    jmp b_10
  }

  b_10 {
    %v_11 = loads @released, 4: I32
    %v_12 = add 142, %v_11: I32
    ret %v_12
  }
}

