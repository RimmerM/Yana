mut @released = [0, 0, 0, 0]

Counter.drop<complex>(%value: Ptr) {
  b_0 {
    %released = global @released: Ptr
    %v_1 = loads %released, 4: I32
    %v_2 = add %v_1, 1: I32
    store %released, %v_2, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 8, 4: Ptr
    %v_2 = add %v_1, 4: Ptr
    store %v_2, 36, 4
    store %v_1, 1, 4
    call_complex Counter.drop, %v_2
    %v_3 = loads @released, 4: I32
    %v_4 = add 142, %v_3: I32
    ret %v_4
  }
}

