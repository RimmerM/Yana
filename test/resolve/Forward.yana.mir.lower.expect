
main<complex>(): I32 {
  b_0 {
    jmp b_1
  }

  b_2 {
    %v_3 = cmp_ilt %v_4, 3: I32
    je %v_3, b_1, b_5
  }

  b_5 {
    %v_6 = add 53, %v_7: I32
    jmp b_8
  }

  b_1 {
    %v_9 = phi [b_2, %v_7], [b_0, 0]: I32
    %v_10 = phi [b_2, %v_4], [b_0, 0]: I32
    %v_7 = add %v_9, 12: I32
    %v_4 = add %v_10, 1: I32
    jmp b_2
  }

  b_11 {
    %v_12 = cmp_ilt %v_13, 4: I32
    je %v_12, b_8, b_14
  }

  b_14 {
    %v_15 = add %v_6, %v_16: I32
    %v_17 = add %v_15, 10: I32
    %v_18 = add %v_17, 7: I32
    ret %v_18
  }

  b_8 {
    %v_19 = phi [b_11, %v_13], [b_5, 0]: I32
    %v_20 = phi [b_11, %v_16], [b_5, 0]: I32
    %v_16 = add %v_20, 5: I32
    %v_13 = add %v_19, 1: I32
    jmp b_11
