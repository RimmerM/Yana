
main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    %v_2 = alloca 8, 8: Ptr
    %v_3 = alloca 8, 8: Ptr
    %v_4 = alloca 8, 8: Ptr
    store %v_1, 0, 4
    store %v_2, %v_1, 8
    call_complex main.lambda, %v_2
    store %v_3, %v_1, 8
    call_complex main.lambda'2, %v_3
    %v_5 = loads %v_1, 4: I32
    store %v_4, %v_1, 8
    call_complex main.lambda'3, %v_4
    %v_6 = loads %v_1, 4: I32
    %v_7 = add %v_6, %v_5: I32
    ret %v_7
  }
}

main.lambda<complex>(%main.lambda.env: Ptr) {
  b_0 {
    %v_1 = load %main.lambda.env, 8: Ptr
    %v_2 = loads %v_1, 4: I32
    %v_3 = add %v_2, 1: I32
    store %v_1, %v_3, 4
    ret 
  }
}

main.lambda'2<complex>(%main.lambda'2.env: Ptr) {
  b_0 {
    %v_1 = load %main.lambda'2.env, 8: Ptr
    %v_2 = loads %v_1, 4: I32
    %v_3 = imul %v_2, 10: I32
    store %v_1, %v_3, 4
