mut @live = [0, 0, 0, 0]
mut @heapNext = [0, 0, 0, 0, 0, 0, 0, 0]

Guard.drop<complex>(%self: Ptr) {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    copy %v_1, %self, 4
    %v_2 = loads @live, 4: I32
    %v_3 = sub %v_2, 1: I32
    store @live, %v_3, 4
    ret 
  }
}

heaped<complex>(%c: I32, %d: I32): I32 {
