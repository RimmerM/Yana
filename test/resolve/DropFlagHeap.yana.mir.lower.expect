    %v_2 = loads @live, 4: I32
    %v_3 = add %v_2, 1: I32
    store @live, %v_3, 4
    store %v_1, 1, 4
    je %c, b_4, b_5
  }

  b_5 {
    call_complex Guard.drop, %v_1
    jmp b_6
  }

  b_6 {
    je %d, b_7, b_8
