    %v_13 = add %v_12, 1: I32
    store @live, %v_13, 4
    store %v_1, 2, 4
    call_complex Guard.drop, %v_1
    jmp b_8
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = call_complex heaped, 1, 0: I32
    %v_2 = loads @live, 4: I32
    %v_3 = cmp_neq %v_2, 0: I32
    je %v_3, b_4, b_5
