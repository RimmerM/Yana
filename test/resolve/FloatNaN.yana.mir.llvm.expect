target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

@zero = global [4 x i8] zeroinitializer, align 8
@one = global [4 x i8] c"\00\00\80?", align 8

define fastcc i32 @main() #0 {
  br label %1

1:                                                ; preds = %0
  %2 = load float, ptr @zero, align 1
  %3 = fdiv float %2, %2
  %4 = load float, ptr @one, align 1
  %5 = fcmp olt float %3, %4
  %6 = zext i1 %5 to i32
  %7 = fcmp ole float %3, %4
  %8 = zext i1 %7 to i32
  %9 = add i32 %6, 2
  %10 = select i1 %7, i32 %9, i32 %6
  %11 = fcmp ogt float %3, %4
  %12 = zext i1 %11 to i32
  %13 = add i32 %10, 4
  %14 = select i1 %11, i32 %13, i32 %10
  %15 = fcmp oge float %3, %4
  %16 = zext i1 %15 to i32
  %17 = add i32 %14, 8
  %18 = select i1 %15, i32 %17, i32 %14
  %19 = fcmp oeq float %3, %4
  %20 = zext i1 %19 to i32
  %21 = add i32 %18, 16
  %22 = select i1 %19, i32 %21, i32 %18
  %23 = fcmp une float %3, %4
  %24 = zext i1 %23 to i32
  %25 = add i32 %22, 32
  %26 = select i1 %23, i32 %25, i32 %22
  %27 = fcmp oeq float %3, %3
  %28 = zext i1 %27 to i32
  %29 = add i32 %26, 64
  %30 = select i1 %27, i32 %29, i32 %26
  %31 = fcmp une float %3, %3
  %32 = zext i1 %31 to i32
  %33 = add i32 %30, 128
  %34 = select i1 %31, i32 %33, i32 %30
  %35 = fcmp ogt float %4, %2
  %36 = zext i1 %35 to i32
  %37 = add i32 %34, 256
  %38 = select i1 %35, i32 %37, i32 %34
  %39 = fcmp olt float %2, %4
  %40 = zext i1 %39 to i32
  %41 = add i32 %38, 512
  %42 = select i1 %39, i32 %41, i32 %38
  %43 = fcmp oeq float %4, %4
  %44 = zext i1 %43 to i32
  %45 = add i32 %42, 1024
  %46 = select i1 %43, i32 %45, i32 %42
  %47 = fcmp une float %4, %2
  %48 = zext i1 %47 to i32
  %49 = add i32 %46, 2048
  %50 = select i1 %47, i32 %49, i32 %46
  ret i32 %50
}

attributes #0 = { "probe-stack"="inline-asm" }
