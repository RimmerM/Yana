"use strict";
var live = 0;

// ResolveTest
function main() {
  var sum = 0;
  var v9 = 1;
  while (v9 < 4) {
    var i = v9;
    var v37 = live + 1 | 0;
    var v50 = (i + Math.imul(i, 2) | 0) + Math.imul(i, 3) | 0;
    live = v37 - 1 | 0;
    sum = sum + v50 | 0;
    v9 = v9 + 1 | 0;
  }
  return Math.imul(sum, 1000) + live | 0;
}
main();
