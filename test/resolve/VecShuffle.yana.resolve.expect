let image$base: () = <none>

let &seed: I32 = 2

fn oneSource() -> I32 {
  b0:
    %v1 = vsplat 0 : Vec(U32)
    %v3 = vwithlane %v1, 1, 1 : Vec(U32)
    %v5 = vwithlane %v3, 2, 2 : Vec(U32)
    %v = vwithlane %v5, 3, 3 : Vec(U32)
    %backwards = vshuffle %v, %v, 3, 2, 1, 0 : Vec(U32)
    %derived = vshuffle %v, %v, 3, 2, 1, 0 : Vec(U32)
    %v22 = vlane %backwards, 0 : U32
    %v25 = vlane %derived, 0 : U32
    %v26 = cmp_ne %v22, %v25 : Bool
    je %v26, b1, b2

  b1:
    ret -1

  b2:
    jmp b3

  b3:
    %v33 = vlane %backwards, 3 : U32
    %v36 = vlane %derived, 3 : U32
    %v37 = cmp_ne %v33, %v36 : Bool
    je %v37, b4, b5

  b4:
    ret -2

  b5:
    jmp b6

  b6:
    %v44 = vlane %backwards, 0 : U32
    %v47 = cmp_ne %v44, 3 : Bool
    je %v47, b7, b8

  b7:
    ret -3

  b8:
    jmp b9

  b9:
    %broadcast = vshuffle %v, %v, 2, 2, 2, 2 : Vec(U32)
    %v65 = vlane %broadcast, 0 : U32
    %v68 = cmp_ne %v65, 2 : Bool
    je %v68, b10, b11

  b10:
    ret -4

  b11:
    jmp b12

  b12:
    %v75 = vlane %broadcast, 3 : U32
    %v78 = cmp_ne %v75, 2 : Bool
    je %v78, b13, b14

  b13:
    ret -5

  b14:
    jmp b15

  b15:
    %doubled = vshuffle %v, %v, 2, 3, 2, 3 : Vec(U32)
    %v96 = vlane %doubled, 0 : U32
    %v99 = cmp_ne %v96, 2 : Bool
    je %v99, b16, b17

  b16:
    ret -6

  b17:
    jmp b18

  b18:
    %v106 = vlane %doubled, 2 : U32
    %v109 = cmp_ne %v106, 2 : Bool
    je %v109, b19, b20

  b19:
    ret -7

  b20:
    jmp b21

  b21:
    %v116 = vlane %doubled, 3 : U32
    %v119 = cmp_ne %v116, 3 : Bool
    je %v119, b22, b23

  b22:
    ret -8

  b23:
    jmp b24

  b24:
    ret 0
}

fn twoSources() -> I32 {
  b0:
    %v1 = vsplat 0 : Vec(U32)
    %v3 = vwithlane %v1, 1, 1 : Vec(U32)
    %v5 = vwithlane %v3, 2, 2 : Vec(U32)
    %low = vwithlane %v5, 3, 3 : Vec(U32)
    %v9 = vsplat 10 : Vec(U32)
    %high = add %v9, %low : Vec(U32)
    %mixed = vshuffle %low, %high, 1, 0, 7, 6 : Vec(U32)
    %v24 = vlane %mixed, 0 : U32
    %v27 = cmp_ne %v24, 1 : Bool
    je %v27, b1, b2

  b1:
    ret -1

  b2:
    jmp b3

  b3:
    %v34 = vlane %mixed, 1 : U32
    %v37 = cmp_ne %v34, 0 : Bool
