}

fn runtime(%v: Vec(U32)) -> I32 {
  b0:
    %backwards = vshuffle %v, %v, 3, 2, 1, 0 : Vec(U32)
    %mixed = vshuffle %v, %backwards, 0, 1, 6, 7 : Vec(U32)
    %v25 = vlane %backwards, 0 : U32
    %v28 = vlane %v, 3 : U32
    %v29 = cmp_ne %v25, %v28 : Bool
    je %v29, b1, b2

  b1:
    ret -1

  b2:
    jmp b3

  b3:
    %v36 = vlane %mixed, 0 : U32
    %v39 = vlane %v, 0 : U32
    %v40 = cmp_ne %v36, %v39 : Bool
    je %v40, b4, b5

  b4:
    ret -2

  b5:
    jmp b6

  b6:
    %v47 = vlane %mixed, 2 : U32
    %v50 = vlane %v, 1 : U32
    %v51 = cmp_ne %v47, %v50 : Bool
    je %v51, b7, b8

  b7:
    ret -3

  b8:
    jmp b9

  b9:
    %v58 = vlane %mixed, 3 : U32
    %v61 = vlane %v, 0 : U32
    %v62 = cmp_ne %v58, %v61 : Bool
    je %v62, b10, b11

  b10:
    ret -4

  b11:
    jmp b12

  b12:
    ret 0
}

fn main() -> I32 {
  b0:
    %v1 = vsplat 0 : Vec(U32)
    %v3 = vwithlane %v1, 1, 1 : Vec(U32)
    %v5 = vwithlane %v3, 2, 2 : Vec(U32)
    %v7 = vwithlane %v5, 3, 3 : Vec(U32)
    %v8 = load seed : I32
    %v9 = cast %v8 : U32
    %v10 = vsplat %v9 : Vec(U32)
    %v = add %v7, %v10 : Vec(U32)
    %v12 = call oneSource : I32
    %v15 = cmp_ne %v12, 0 : Bool
    je %v15, b1, b2

  b1:
    %v17 = call oneSource : I32
    ret %v17

  b2:
    jmp b3

  b3:
    %v20 = call twoSources : I32
    %v23 = cmp_ne %v20, 0 : Bool
    je %v23, b4, b5

  b4:
    %v25 = call twoSources : I32
    %v28 = mul %v25, 10 : I32
    ret %v28

  b5:
    jmp b6

  b6:
    %v31 = call byteLane : I32
    %v34 = cmp_ne %v31, 0 : Bool
    je %v34, b7, b8

  b7:
    %v36 = call byteLane : I32
    %v39 = mul %v36, 100 : I32
    ret %v39

  b8:
    jmp b9

  b9:
    %v42 = call floatLane : I32
    %v45 = cmp_ne %v42, 0 : Bool
    je %v45, b10, b11

  b10:
    %v47 = call floatLane : I32
    %v50 = mul %v47, 1000 : I32
    ret %v50

  b11:
    jmp b12

  b12:
    %v53 = call runtime, %v : I32
    %v56 = cmp_ne %v53, 0 : Bool
    je %v56, b13, b14

  b13:
    %v58 = call runtime, %v : I32
    %v61 = mul %v58, 10000 : I32
    ret %v61

  b14:
    jmp b15

  b15:
    ret 314
}
