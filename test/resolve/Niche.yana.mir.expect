module ResolveTest

data Rank = Less | Same | More

data Pair {first: Maybe(Rank), second: Maybe(Rank)}

fn tagOf(m: Maybe(Rank) [shared call]) -> I32 {
bb0:
  %0: U8 = read copy.trivial (m.#)
  %1: U8 = const 0
  %2: Bool = eq inspect %0 inspect %1
  branch inspect %2 -> bb5 -> bb1

bb1:
  %5: U8 = read copy.trivial (m.#)
  %6: U8 = const 1
  %7: Bool = eq inspect %5 inspect %6
  branch inspect %7 -> bb6 -> bb2

bb2:
  %14: U8 = read copy.trivial (m.#)
  %15: U8 = const 1
  %16: Bool = eq inspect %14 inspect %15
  branch inspect %16 -> bb8 -> bb3

bb3:
  %23: I32 = const 3
  jump -> bb4(take %23)

bb4(%24: I32):
  return take %24

bb5:
  %4: I32 = const 0
  jump -> bb4(take %4)

bb6:
  %9: U8 = read copy.trivial (m.Just.#)
  %10: U8 = const 0
  %11: Bool = eq inspect %9 inspect %10
  branch inspect %11 -> bb7 -> bb2

bb7:
  %13: I32 = const 1
  jump -> bb4(take %13)

bb8:
  %18: U8 = read copy.trivial (m.Just.#)
  %19: U8 = const 1
  %20: Bool = eq inspect %18 inspect %19
  branch inspect %20 -> bb9 -> bb3

bb9:
  %22: I32 = const 2
  jump -> bb4(take %22)
}

fn depthOf(m: Maybe(Maybe(Rank)) [shared call]) -> I32 {
  local o: Rank

bb0:
  %0: U8 = read copy.trivial (m.#)
  %1: U8 = const 0
  %2: Bool = eq inspect %0 inspect %1
  branch inspect %2 -> bb4 -> bb1

bb1:
  %5: U8 = read copy.trivial (m.#)
  %6: U8 = const 1
  %7: Bool = eq inspect %5 inspect %6
  branch inspect %7 -> bb5 -> bb2

bb2:
  %14: Rank = read copy.trivial (m.Just.Just)
  write.init borrow.unique (o) take %14
  %16: I32 = const 300
  %17: Rank = read copy.trivial (o)
  %18: Maybe(Rank) = aggregate.Just take %17
  %19: I32 = call tagOf borrow.shared %18
  %20: I32 = add inspect %16 inspect %19
  jump -> bb3(take %20)

bb3(%21: I32):
  return take %21

bb4:
  %4: I32 = const 100
  jump -> bb3(take %4)

bb5:
  %9: U8 = read copy.trivial (m.Just.#)
  %10: U8 = const 0
  %11: Bool = eq inspect %9 inspect %10
  branch inspect %11 -> bb6 -> bb2

bb6:
  %13: I32 = const 200
  jump -> bb3(take %13)
}

fn heldOr(m: Maybe(I32) [shared call shape2 .0=unique call], fallback: I32 [shared call]) -> I32 {
  local at: I32

bb0:
  %0: U8 = read copy.trivial (m.#)
  %1: U8 = const 0
  %2: Bool = eq inspect %0 inspect %1
  branch inspect %2 -> bb3 -> bb1

bb1:
  %5: I32 = read copy.trivial (m.Just)
  write.init borrow.unique (at) take %5
  %7: I32 = read copy.trivial (at)
  jump -> bb2(take %7)

bb2(%8: I32):
  return take %8

bb3:
  %4: I32 = read copy.trivial (fallback)
  jump -> bb2(take %4)
}

fn pairValue(p: Pair [shared call]) -> I32 {
bb0:
  %0: Maybe(Rank) = read copy.trivial (p.first)
  %1: I32 = call tagOf borrow.shared %0
  %2: I32 = const 10
  %3: I32 = mul inspect %1 inspect %2
  %4: Maybe(Rank) = read copy.trivial (p.second)
  %5: I32 = call tagOf borrow.shared %4
  %6: I32 = add inspect %3 inspect %5
  return take %6
}

fn roundTrip() -> I32 {
  local a: I32
  local b: I32
  local c: I32

bb0:
  %0: Maybe(Rank) = aggregate.Nothing
  %1: I32 = call tagOf borrow.shared %0
  write.init borrow.unique (a) take %1
  %3: Rank = const Less
  %4: Maybe(Rank) = aggregate.Just take %3
  %5: I32 = call tagOf borrow.shared %4
  write.init borrow.unique (b) take %5
  %7: Rank = const More
  %8: Maybe(Rank) = aggregate.Just take %7
  %9: I32 = call tagOf borrow.shared %8
  write.init borrow.unique (c) take %9
  %11: I32 = read copy.trivial (a)
  %12: I32 = read copy.trivial (b)
  %13: I32 = const 10
  %14: I32 = mul inspect %12 inspect %13
  %15: I32 = add inspect %11 inspect %14
  %16: I32 = read copy.trivial (c)
  %17: I32 = const 100
  %18: I32 = mul inspect %16 inspect %17
  %19: I32 = add inspect %15 inspect %18
  return take %19
}

fn nested() -> I32 {
  local outer: I32
  local middle: I32
  local inner: I32

bb0:
  %0: Maybe(Maybe(Rank)) = aggregate.Nothing
  %1: I32 = call depthOf borrow.shared %0
  write.init borrow.unique (outer) take %1
  %3: Maybe(Rank) = aggregate.Nothing
  %4: Maybe(Maybe(Rank)) = aggregate.Just take %3
  %5: I32 = call depthOf borrow.shared %4
  write.init borrow.unique (middle) take %5
  %7: Rank = const Same
  %8: Maybe(Rank) = aggregate.Just take %7
  %9: Maybe(Maybe(Rank)) = aggregate.Just take %8
  %10: I32 = call depthOf borrow.shared %9
  write.init borrow.unique (inner) take %10
  %12: I32 = read copy.trivial (outer)
  %13: I32 = read copy.trivial (middle)
  %14: I32 = add inspect %12 inspect %13
  %15: I32 = read copy.trivial (inner)
  %16: I32 = add inspect %14 inspect %15
  return take %16
}

fn paired() -> I32 {
bb0:
  %0: Rank = const More
  %1: Maybe(Rank) = aggregate.Just take %0
  %2: Maybe(Rank) = aggregate.Nothing
  %3: Pair = aggregate.Pair take %1 take %2
  %4: I32 = call pairValue borrow.shared %3
  return take %4
}

fn nibbleOr(m: Maybe(@bits(4) U32) [shared call], fallback: I32 [shared call]) -> I32 {
  local value: @bits(4) U32

bb0:
  %0: U8 = read copy.trivial (m.#)
  %1: U8 = const 0
  %2: Bool = eq inspect %0 inspect %1
  branch inspect %2 -> bb3 -> bb1

bb1:
  %5: @bits(4) U32 = read copy.trivial (m.Just)
  write.init borrow.unique (value) take %5
  %7: @bits(4) U32 = read copy.trivial (value)
  %8: I32 = convert inspect %7
  jump -> bb2(take %8)

bb2(%9: I32):
  return take %9

bb3:
  %4: I32 = read copy.trivial (fallback)
  jump -> bb2(take %4)
}

fn nibbles() -> I32 {
  local empty: I32
  local zero: I32
  local low: I32
  local high: I32

bb0:
  %0: Maybe(@bits(4) U32) = aggregate.Nothing
  %1: I32 = const 1000
  %2: I32 = call nibbleOr borrow.shared %0 borrow.shared %1
  write.init borrow.unique (empty) take %2
  %4: I32 = const 0
  %5: U32 = convert inspect %4
  %6: @bits(4) U32 = convert inspect %5
  %7: Maybe(@bits(4) U32) = aggregate.Just take %6
  %8: I32 = const 1000
  %9: I32 = call nibbleOr borrow.shared %7 borrow.shared %8
  write.init borrow.unique (zero) take %9
  %11: I32 = const 3
  %12: U32 = convert inspect %11
  %13: @bits(4) U32 = convert inspect %12
  %14: Maybe(@bits(4) U32) = aggregate.Just take %13
  %15: I32 = const 1000
  %16: I32 = call nibbleOr borrow.shared %14 borrow.shared %15
  write.init borrow.unique (low) take %16
  %18: I32 = const 15
  %19: U32 = convert inspect %18
  %20: @bits(4) U32 = convert inspect %19
  %21: Maybe(@bits(4) U32) = aggregate.Just take %20
  %22: I32 = const 1000
  %23: I32 = call nibbleOr borrow.shared %21 borrow.shared %22
  write.init borrow.unique (high) take %23
  %25: I32 = read copy.trivial (empty)
  %26: I32 = read copy.trivial (zero)
  %27: I32 = add inspect %25 inspect %26
  %28: I32 = read copy.trivial (low)
  %29: I32 = const 100
  %30: I32 = mul inspect %28 inspect %29
  %31: I32 = add inspect %27 inspect %30
  %32: I32 = read copy.trivial (high)
  %33: I32 = add inspect %31 inspect %32
  return take %33
}

fn main() -> I32 {
bb0:
  %0: I32 = call roundTrip
  %1: I32 = call nested
  %2: I32 = add inspect %0 inspect %1
  %3: I32 = call paired
  %4: I32 = add inspect %2 inspect %3
  %5: I32 = call nibbles
  %6: I32 = add inspect %4 inspect %5
  return take %6
}

entry main
