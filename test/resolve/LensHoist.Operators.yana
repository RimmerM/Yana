-- A lens call written as an *operand* - `hoistableLensCall`'s Infix and Prefix cases.
--
-- `LensHoist.yana` is the construct; this is the half of it that operators reach. An operand is an
-- ordinary position - evaluated exactly once, unconditionally - so the call is lifted into a `let`
-- in front of the statement exactly as an argument's is, and the extent is the rest of the block
-- either way.
--
-- The exception is an operator that leaves an operand *unevaluated*. `&&` and `||` are ordinary
-- named functions whose right operand is `@lazy`, so there is no syntax to recognise them by:
-- `defersArguments` asks `Program::lazyNames`, the same question the call site asks and for the same
-- reason. The parser nests a chain to the right without regard for precedence, so what this walk can
-- read is the written order - and that is enough, because re-association regroups the operands
-- without reordering them. Everything before the first deferring operator is unconditional whatever
-- the grouping turns out to be; `Reject.Lens.yana` holds the operand after one.
--
-- `log` is read outside the block the lens split, so the post-`yield` half is observable at all.

let &log = 0 :: Int

lens fn logged(step: Int) -> Int:
    log = log + step
    yield log
    log = log + 100

lens fn flagged(step: Int) -> Bool:
    log = log + step
    yield log > 0
    log = log + 100

-- The left operand, which is where a chain starts.
fn leftOperand() -> Int:
    log = 0

    let seen = logged(1) + 3
    return seen + log

-- The right one, two levels down: the walk descends the chain in written order, so what it lifts is
-- `logged(1)` and the arithmetic around it stays where it was written.
fn rightOperand() -> Int:
    log = 0

    let seen = 3 + logged(1) * 2
    return seen + log

-- A prefix operator's operand, which is the same position with one operand instead of two.
fn inPrefix() -> Int:
    log = 0

    let seen = !flagged(1)
    let v = if seen: 1 else: 2
    return v + log

-- Before a `&&`. The operand the walk stops at is the one *after* the operator that defers, not the
-- one before it - and `>` binds tighter than `&&`, so re-association leaves this call exactly where
-- the written order already said it was.
fn beforeShortCircuit(b: Bool) -> Int:
    log = 0

    let seen = logged(1) > 0 && b
    let v = if seen: 1 else: 2
    return v + log

fn main() -> Int:
    let a = leftOperand()             -- 5:  yields 1, seen 4, log still 1
    let b = rightOperand()            -- 6:  yields 1, seen 5, log still 1
    let c = inPrefix()                -- 3:  yields True, seen False, v 2, log 1
    let d = beforeShortCircuit(True)  -- 2:  1 > 0 && True, v 1, log 1
    let e = beforeShortCircuit(False) -- 3:  1 > 0 && False, v 2, log 1

    -- 56323.
    return a * 10000 + b * 1000 + c * 100 + d * 10 + e
