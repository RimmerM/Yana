-- The file of `Split` that writes the module's one import. Everything it names out of `Geometry`
-- resolves; `User.yana` beside it names the same things and none of them resolve, which is the whole
-- of Analysis-Modules.md §2.1.2 - an import is written in a file and is in scope for that file.

import Geometry

pub fn here(p: Point) -> Int = p.x + p.y
