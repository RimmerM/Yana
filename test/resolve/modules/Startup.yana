-- A library module that tries to run something at its top level.
--
-- Only the root module has a program point at which top-level code runs, so this is the module that
-- says so from the other side. Its constant `let` is fine and is what a library module's top level
-- has always been able to hold - see Reject.TopLevel.yana, which imports this.

pub let libraryLimit = 8

-- Not a constant, and there is no sequence in this module for it to be initialized by.
pub let &libraryCache = compute()

-- And not a declaration at all.
compute()

pub fn compute() -> Int = libraryLimit * 2
