import Native

{-
   `remove` over an element type that has a teardown.

   Closing the gap is a `moveMemory`, which is Native moving bytes rather than an assignment the
   compiler can see - so nothing about it says the element it writes over is over. `remove` now takes
   that element out into a `->` binding first, and the binding is what owes its release.

   What this file asserts: the element leaves, the survivors keep their order, the length is right,
   and the live count follows each of those - which is the half a golden diff cannot show, since a
   release that never ran and one that ran twice produce the same instructions.

   The second half of the file is `remove` answering with what it took. Discarding that answer is
   what every call in the first half does and is what "remove it" has always compiled to: the `Maybe`
   has no name and no use, so the drop runs at the call. Naming it with `Just(->b)` moves the decision
   to the caller, which is the whole of what lets a container hold a value nobody else may copy.
-}

let &liveBuffers = 0 :: I64

data Buffer {bytes: %U8}

fn makeBuffer(mark: I64) -> Buffer:
    liveBuffers += 1
    let buffer = Buffer {bytes: allocateHeap(16)}
    setMemory(buffer.bytes, 0, 16)

    -- A marker, so that "the right element was removed" is a question this file can ask rather than
    -- only "the right number of them".
    store(bitcast(buffer.bytes) :: %I64, mark)
    return buffer

instance Drop(Buffer):
    fn drop(->value: Buffer) -> {}:
        freeHeap(value.bytes)
        liveBuffers -= 1

fn marker(it: Buffer) -> I64 = *(bitcast(it.bytes) :: %I64)

fn main() -> I64:
    let &xs = emptyArray() :: [Buffer]
    push(xs, makeBuffer(1))
    push(xs, makeBuffer(2))
    push(xs, makeBuffer(3))

    if liveBuffers != 3 then return -1
    if length(xs) != 3 then return -2

    -- The middle one goes, and the two that remain keep their order.
    remove(xs, 1)

    if length(xs) != 2 then return -3
    if marker(xs[0]) != 1 then return -4
    if marker(xs[1]) != 3 then return -5
    if liveBuffers != 2 then return -6

    -- An index outside the array removes nothing.
    remove(xs, 5)
    remove(xs, 0 - 1)
    if length(xs) != 2 then return -7

    -- The last element, where there is no gap to close.
    remove(xs, 1)
    if length(xs) != 1 then return -8
    if marker(xs[0]) != 1 then return -9

    remove(xs, 0)
    if length(xs) != 0 then return -10
    if liveBuffers != 0 then return -11

    {-
       The element handed back rather than released where it lay.

       Every call above discards the answer, which is what "remove it" has always meant and still
       compiles to: the `Maybe` is a value with no name and no use, so its last use is the call and
       the drop runs there. Naming it with `->` is the other half - the caller decides when the
       element's life ends, and that is the whole of what makes a container hold a linear type.
    -}
    push(xs, makeBuffer(7))
    push(xs, makeBuffer(8))
    if liveBuffers != 2 then return -12

    -- `liveBuffers` first and `marker(b)` second, deliberately: the marker read is the arm's last
    -- use of `b`, so reading the count after it would be reading it past the drop. Two alive here -
    -- the one still in the array and the one this arm is holding.
    let kept = match remove(xs, 0):
        Just(->b) -> liveBuffers * 10 + marker(b)
        Nothing -> 0 - 1

    if kept != 27 then return -13

    -- And one alive once the arm has finished, because the arm is where the element's last use was.
    if liveBuffers != 1 then return -14
    if length(xs) != 1 then return -15

    -- An index outside the array answers `Nothing`, and takes nothing.
    if remove(xs, 9) is Just(->_) then return -16
    if liveBuffers != 1 then return -17

    remove(xs, 0)
    if liveBuffers != 0 then return -18

    return 1
