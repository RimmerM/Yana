module ResolveTest

data OutputWindow(unit) {space: &0'Array(unit), used: Size} shape3

data InFail = InBroken

data OutFail = OutFull

data SliceBlocks {bytes: Array(U8), size: Size, failAt: Size} reclaim derived

data NamedBlocks {bytes: Array(U8), size: Size, failAt: Size} reclaim derived

data FixedWindows {storage: Array(U8), used: Size} reclaim derived

data DriveFailure(ie, oe) = InputFailed {InputFailed: ie} | OutputFailed {OutputFailed: oe} drop derived reclaim derived

data Chunks {bytes: Array(U8), at: Size, step: Size, failAt: Size} reclaim derived

data OutputWindow(U8) {space: &0'Array(U8), used: Size} of OutputWindow shape3

data DriveFailure(InFail, OutFail) = InputFailed {InputFailed: InFail} | OutputFailed {OutputFailed: OutFail} of DriveFailure

data DriveFailure(String, OutFail) = InputFailed {InputFailed: String} | OutputFailed {OutputFailed: OutFail} of DriveFailure reclaim derived

class BlockInput(i -> unit, error): blocks

class WindowOutput(o -> unit, error): withWindow

class Source(s -> e): readSome

instance BlockInput(SliceBlocks, U8, InFail): SliceBlocks.blocks

instance BlockInput(NamedBlocks, U8, String): NamedBlocks.blocks

instance WindowOutput(FixedWindows, U8, OutFail): FixedWindows.withWindow

instance Source(Chunks, String): Chunks.readSome

let string'188: [CodeUnit *10] = "broken at "

let string'189: [CodeUnit *15] = "read failed at "

lens fn blocks(input: i [unique slot 0], $body: (Array(unit)) -> I32 [shared call]) -> Outcome(I32, error) = <no body>

lens fn withWindow(output: o [unique call], minimum: Size [shared call], preferred: Size [shared call], $body: (&OutputWindow(unit)) -> I32 [shared call]) -> Outcome(I32, error) = <no body>

fn readSome(self: s [unique call], into: Array(U8) [unique call view]) -> Result(e, Size) = <no body>

fn commit(window: OutputWindow(unit) [unique call], count: Size [shared call]) -> {} {
  form specialized
  slot #0 type unit
bb0:
  %0: Size [unique call] = read borrow.unique (window.used) loan0
  %1: Size = read copy.trivial (count)
  %2: {} = call +=(Size) borrow.unique %0 borrow.shared %1
  return
}

