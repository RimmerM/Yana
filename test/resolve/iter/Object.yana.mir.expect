fn Held.drop(value: Held) -> {} {
bb0:
  %0: I32 = read copy.trivial (global trace)
  %1: I32 = const 10
  %2: I32 = mul inspect %0 inspect %1
  %3: I32 = read copy.trivial (value.id)
  %4: I32 = add inspect %2 inspect %3
  write.assign borrow.unique (global trace) take %4
  return
}

lens fn lent(n: I32 [shared call], $body: (Held) -> I32 [shared call]) -> I32 {
  local & $yielded: I32
  local & i: I32
  local h: Held

bb0:
  %0: I32 = const 0
  write.init borrow.unique ($yielded) take %0
  %2: I32 = const 1
