  %10: Held = aggregate.Held take %9
  write.init borrow.unique (h) take %10
  %12: Held [shared call] = read borrow.shared (h) loan0
  %13: (Held) -> I32 [shared call] = read borrow.shared ($body) loan1
  %14: I32 = call inspect %13 borrow.shared %12
  drop (h)
  %15: I32 = const 0
  %16: Bool = eq inspect %14 inspect %15
  write.assign borrow.unique ($yielded) take %14
  branch inspect %16 -> bb4 -> bb5

bb4:
