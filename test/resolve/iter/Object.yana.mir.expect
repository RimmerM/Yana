module ResolveTest

data Held {id: I32} drop authored

data Cmd = Keep | Skip

data Cursor {at: I32}

data Parser(l) {lexer: l, packed: I32} drop derived reclaim derived

data upTo.Iter {$index: I32, $slot: I32, n: I32, i: I32}

data doubled.Iter {$index: I32, $slot: I32, n: I32, i: I32}

data lent.Iter {$index: I32, $slot: %Held, n: I32, i: I32, h: Held} drop authored

data steps.Iter {$index: I32, $slot: I32, n: I32, $yielded: I32, i: I32}

data advancing.Iter {$index: I32, $slot: I32, cursor: %Cursor, n: I32, k: I32} shape9

data Parser(steps.Iter) {lexer: steps.Iter, packed: I32} of Parser

instance Drop(Held): Held.drop

instance Iterate(upTo.Iter, I32, {}): upTo$next, upTo$resume

instance Iterate(doubled.Iter, I32, {}): doubled$next, doubled$resume

instance Drop(lent.Iter): lent$drop

instance Iterate(lent.Iter, Held, {}): lent$next, lent$resume

instance Iterate(steps.Iter, I32, Cmd): steps$next, steps$resume

instance Iterate(advancing.Iter, I32, {}): advancing$next, advancing$resume

let & trace: I32 = 0

lens fn upTo(n: I32 [shared call], $body: (I32) -> I32 [shared call]) -> I32 {
  local & $yielded: I32
  local & i: I32

bb0:
  %0: I32 = const 0
  write.init borrow.unique ($yielded) take %0
  %2: I32 = const 0
  write.init borrow.unique (i) take %2
  jump -> bb1

bb1:
  %5: I32 = read copy.trivial (i)
  %6: I32 = read copy.trivial (n)
  %7: Bool = lt inspect %5 inspect %6
  branch inspect %7 -> bb3 -> bb2

bb2:
  %22: I32 = read copy.trivial ($yielded)
  return take %22

bb3:
  %9: I32 = read copy.trivial (i)
  %10: (I32) -> I32 [shared call] = read borrow.shared ($body) loan0
  %11: I32 = call inspect %10 borrow.shared %9
  %12: I32 = const 0
  %13: Bool = eq inspect %11 inspect %12
  write.assign borrow.unique ($yielded) take %11
  branch inspect %13 -> bb4 -> bb5

bb4:
  %17: I32 = read copy.trivial (i)
  %18: I32 = const 1
  %19: I32 = add inspect %17 inspect %18
  write.assign borrow.unique (i) take %19
  jump -> bb1

bb5:
  jump -> bb2
}

