{-
   **A resuming producer that owns something** - `doc/inflight/Design-Iterator-Objects.md` §3.3 and
   §2.5 together, and `../../../doc/progress/2026-09-16-J57-object-defects.md` §2.

   # resolver: ownership

   A record owing anything gets a generated `instance Drop`, whose member is the step entered with a
   cancel request. That step is handed **what the continuation answered**, and a producer declaring
   `<- R` takes `Outcome(R, exit)` there rather than the bare signal - so the teardown, which sends a
   row of its own rather than a consumer's value, had to build the wrapper and did not. It sent the
   signal, the call was mistyped, and the *declaration* failed to compile:

       error: internal: call to g$step supplies argument 1 of type I32, and it declares
       Outcome(Cmd, I32)

   Owning anything is what gives a record the teardown at all, so this refused every resuming
   producer with a growable array, a `String` or a record holding either - which is three of the five
   workarounds `test/bench/lexer/findings.md` §5 lists and 288 bytes of that lexer's record.
   `exitRow` in `resolve_ssa/convert.cpp` is the fix, and it is shared with the other two callers
   that send a row: a nested member's "fall out" and the cancellation of a suspended child.

   The **second** defect this file holds is the one the first was hiding. A site record's `Drop` is
   its step and the step releases the members' *storage* as well - so the derived `Reclaim` the
   classification gave it beside the drop freed every array member a second time, once per field,
   including the temporary that is a second copy of one. It corrupted the allocator rather than
   trapping, so what died was the next `@heap` binding in the program. `own.cpp` is where a site
   record now owes no reclaim of its own.

   What each function claims:

   | | |
   | --- | --- |
   | `ran` | a producer owning an array, a `String` and a `Note`, resumed to its end |
   | `abandoned` | the same one dropped **suspended**, with the `Note`'s trace proving the cancel step ran once |
   | `heaped` | the payload under `@heap` - a member in a run of the record's own, released by the same step |
   | `after` | an `@heap` binding *after* the abandonment, which is what the double free used to kill |
-}

let &trace = 0 :: I32

data Note {id: I32}

instance Drop(Note):
    fn drop(->value: Note):
        trace = trace * 10 + value.id

data Cmd = Keep | Pop

-- Three obligations in one record: a growable array, a `String` local and a value with an authored
-- teardown, all live across the hand-over.
iter fn levels(n: I32) -> (I32 <- Cmd):
    let &xs = [] :: [I32]
    let label = "lv"
    let held = Note {id: 1}
    let &i = 0 :: I32

    while i < n:
        push(xs, i)
        let c = yield xs[truncate(length(xs)) - 1] + truncate(length(label))
        if c is Pop then i = i + 2 else i = i + 1

-- The same shape with the payload in a run of the record's own - §6.1's second fix, where the field
-- is a pointer and the teardown frees what it reaches.
iter fn placed(n: I32) -> (I32 <- Cmd):
    let @heap &xs = [] :: [I32]
    let &i = 0 :: I32

    while i < n:
        push(xs, i)
        let c = yield xs[truncate(length(xs)) - 1]
        if c is Pop then i = i + 2 else i = i + 1

fn ran(n: I32) -> I32:
    trace = 0
    let &it = levels(n)
    let &packed = 0 :: I32
    let &going = True

    while going:
        if it.resume(Keep) is Just(v):
            packed = packed * 10 + v + 1
        else:
            going = False

    return packed

-- Dropped while **suspended**: the step is entered with `Exit(kExitLeave)` at the resume index, the
-- producer departs, and the trace says the `Note` was released exactly once.
fn abandoned(n: I32) -> I32:
    trace = 0
    let &it = levels(n)
    let &got = 0 :: I32

    if it.resume(Keep) is Just(v): got = v + 1

    return got

fn heaped(n: I32) -> I32:
    let &it = placed(n)
    let &packed = 0 :: I32
    let &going = True

    while going:
        if it.resume(Pop) is Just(v):
            packed = packed * 10 + v + 1
        else:
            going = False

    return packed

-- An allocation *after* the abandonment, which is the probe the reclaim defect needed: three frees of
-- one run leave the allocator's free list holding a block twice, and the next binding that asks for
-- one gets a pointer into the middle of another.
fn afterwards() -> I32:
    let @heap &xs = [] :: [I32]
    let &k = 0 :: I32

    while k < 40:
        push(xs, k)
        k = k + 1

    return truncate(length(xs))

fn main() -> I32:
    -- 3456: two bytes of `"lv"` on every hand-over, and the index below it.
    if ran(4) != 3456 then return 1

    -- The first hand-over is `0 + 2`, so `got` is 3 - and `trace` is the `Note`, released once by
    -- the cancel step rather than never and rather than twice.
    let got = abandoned(4)
    if got != 3 then return 2
    if trace != 1 then return 3

    -- `Pop` steps two at a time: 0, 2, 4 handed over as 1, 3, 5.
    if heaped(5) != 135 then return 4
    if afterwards() != 40 then return 5

    return 0
