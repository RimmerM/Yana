module ResolveTest

data Holder {cursor: 0'shared.Iter, seen: I32} shape2

data shared.Iter {$index: I32, $slot: I32, source: StringView, n: I32, p: I32} shape9

data counted.Iter {$index: I32, $slot: I32, n: I32, p: I32}

data owning.Iter {$index: I32, $slot: I32, source: String, n: I32, p: I32, : String, : String, : String, note: String} drop authored

instance Iterate(shared.Iter, I32, {}): shared$next, shared$resume

instance Iterate(counted.Iter, I32, {}): counted$next, counted$resume

instance Drop(owning.Iter): owning$drop

instance Iterate(owning.Iter, I32, {}): owning$next, owning$resume

let & after: I32 = 0

let string: [CodeUnit *3] = "at "

let string'2: [CodeUnit *4] = " of "

let string'144: [CodeUnit *3] = "abc"

let string'145: [CodeUnit *5] = "hello"

lens fn counted(n: I32 [shared call], $body: (I32) -> I32 [shared call]) -> I32 {
  local & $yielded: I32
  local & p: I32

bb0:
  %0: I32 = const 0
  write.init borrow.unique ($yielded) take %0
  %2: I32 = const 0
  write.init borrow.unique (p) take %2
  jump -> bb1

bb1:
  %5: I32 = read copy.trivial (p)
  %6: I32 = read copy.trivial (n)
  %7: Bool = lt inspect %5 inspect %6
  branch inspect %7 -> bb3 -> bb2

bb2:
  %25: I32 = read copy.trivial ($yielded)
  return take %25

bb3:
  %9: I32 = read copy.trivial (p)
  %10: (I32) -> I32 [shared call] = read borrow.shared ($body) loan0
  %11: I32 = call inspect %10 borrow.shared %9
  %12: I32 = const 0
  %13: Bool = eq inspect %11 inspect %12
  write.assign borrow.unique ($yielded) take %11
  branch inspect %13 -> bb4 -> bb5

bb4:
  %17: I32 [unique call] = read borrow.unique (global after) loan1
  %18: I32 = const 1
  %19: {} = call +=(I32) borrow.unique %17 borrow.shared %18
  %20: I32 = read copy.trivial (p)
  %21: I32 = const 1
  %22: I32 = add inspect %20 inspect %21
  write.assign borrow.unique (p) take %22
  jump -> bb1

bb5:
  jump -> bb2
}

lens fn owning(source: String, n: I32 [shared call], $body: (I32) -> I32 [shared call]) -> I32 {
  local & $yielded: I32
  local & p: I32
  local & local5: String object2
  local local6: String
  local local7: String
  local note: String object2
  flag (source) = held

bb0:
  %0: I32 = const 0
  write.init borrow.unique ($yielded) take %0
  %2: I32 = const 0
  write.init borrow.unique (p) take %2
  jump -> bb1

bb1:
  %5: I32 = read copy.trivial (p)
  %6: I32 = read copy.trivial (n)
  %7: Bool = lt inspect %5 inspect %6
  branch inspect %7 -> bb3 -> bb2

bb2:
  drop.maybe (source)
  %61: I32 = read copy.trivial ($yielded)
  flag (source) = gone
  return take %61

bb3:
  %9: I32 = read copy.trivial (p)
  %10: (I32) -> I32 [shared call] = read borrow.shared ($body) loan0
  %11: I32 = call inspect %10 borrow.shared %9
  %12: I32 = const 0
  %13: Bool = eq inspect %11 inspect %12
  write.assign borrow.unique ($yielded) take %11
  branch inspect %13 -> bb4 -> bb5

bb4:
  %17: Size = const 7
  %18: I32 = read copy.trivial (p)
  %19: Maybe(Size) = call showBound(I32) borrow.shared %18
  %20: Size = call formatBound borrow.shared %19
  %21: Size = add inspect %17 inspect %20
  %22: String [shared call] = read borrow.shared (source) loan1
  %23: String [shared slot 0 view] = call.derivation view(String) borrow.shared %22 roots{1}
  %24: Maybe(Size) = call showBound(String) borrow.shared %23
  %25: Size = call formatBound borrow.shared %24
  %26: Size = add inspect %21 inspect %25
  %27: String = call String.ofCapacity borrow.shared %26
  write.init borrow.unique (local5) take %27
  %29: String [unique call] = read borrow.unique (local5) loan2
  %30: String = const String {units: Array {run: Run {items: &string, capacity: 3, ownsHeap: 0}, length: 3}}
  write.init borrow.unique (local6) take %30
  %32: String [shared slot 0] = read borrow.shared (local6) loan3
  %33: String [shared slot 0 view] = call.derivation view(String) borrow.shared %32 roots{3}
  %34: {} = call String.push borrow.unique %29 borrow.shared %33
  drop (local6)
  %35: I32 = read copy.trivial (p)
  %36: String [unique call] = read borrow.unique (local5) loan4
  %37: {} = call show(I32) borrow.shared %35 borrow.unique %36
  %38: String [unique call] = read borrow.unique (local5) loan5
  %39: String = const String {units: Array {run: Run {items: &string'2, capacity: 4, ownsHeap: 0}, length: 4}}
  write.init borrow.unique (local7) take %39
  %41: String [shared slot 0] = read borrow.shared (local7) loan6
  %42: String [shared slot 0 view] = call.derivation view(String) borrow.shared %41 roots{6}
  %43: {} = call String.push borrow.unique %38 borrow.shared %42
  drop (local7)
  %44: String [shared call] = read borrow.shared (source) loan7
  %45: String [unique call] = read borrow.unique (local5) loan8
  %46: String [shared slot 0 view] = call.derivation view(String) borrow.shared %44 roots{7}
  %47: {} = call show(String) borrow.shared %46 borrow.unique %45
  %48: String = read take (local5)
  write.init borrow.unique (note) take %48
  %50: I32 [unique call] = read borrow.unique (global after) loan9
  %51: String [shared call] = read borrow.shared (note) loan10
  %52: String [shared slot 0 view] = call.derivation view(String) borrow.shared %51 roots{10}
  %53: Size = call length(String) borrow.shared %52
  drop (note)
  %54: I32 = convert inspect %53
  %55: {} = call +=(I32) borrow.unique %50 borrow.shared %54
  %56: I32 = read copy.trivial (p)
  %57: I32 = const 1
  %58: I32 = add inspect %56 inspect %57
  write.assign borrow.unique (p) take %58
  jump -> bb1

bb5:
  drop (source)
  jump -> bb2
  flag (source) = gone
}

lens fn shared(source: String [shared call view], n: I32 [shared call], $body: (I32) -> I32 [shared call]) -> I32 {
  local & $yielded: I32
  local & p: I32

bb0:
  %0: I32 = const 0
  write.init borrow.unique ($yielded) take %0
  %2: I32 = const 0
  write.init borrow.unique (p) take %2
  jump -> bb1

bb1:
  %5: I32 = read copy.trivial (p)
  %6: I32 = read copy.trivial (n)
  %7: Bool = lt inspect %5 inspect %6
  branch inspect %7 -> bb3 -> bb2

bb2:
  %26: I32 = read copy.trivial ($yielded)
  return take %26

bb3:
  %9: String [shared call view] = read borrow.shared (source) loan0
  %10: Size = call length(String) borrow.shared %9
  %11: I32 = convert inspect %10
  %12: I32 = read copy.trivial (p)
  %13: I32 = add inspect %11 inspect %12
  %14: (I32) -> I32 [shared call] = read borrow.shared ($body) loan1
  %15: I32 = call inspect %14 borrow.shared %13
  %16: I32 = const 0
  %17: Bool = eq inspect %15 inspect %16
  write.assign borrow.unique ($yielded) take %15
  branch inspect %17 -> bb4 -> bb5

bb4:
  %21: I32 = read copy.trivial (p)
  %22: I32 = const 1
  %23: I32 = add inspect %21 inspect %22
  write.assign borrow.unique (p) take %23
  jump -> bb1

bb5:
  jump -> bb2
}

fn main() -> I32 {
  local & jt: counted.Iter
  local y: I32
  local & kt: owning.Iter
  local y: I32
  local text: String
  local & lt: shared.Iter [owned here shape9 .2.0.*=shared slot 0]
  local & h: Holder
  local & cursor: shared.Iter
  local y: I32

bb0:
  %0: I32 = const 0
  write.assign borrow.unique (global after) take %0
  %2: I32 = const 3
  %3: counted.Iter = call counted$new take %2
  write.init borrow.unique (jt) take %3
  jump -> bb1

bb1:
  %6: counted.Iter [unique call] = read borrow.unique (jt) loan0
  %7: I32 = const 0
  %8: Bool = const False
  %9: Bool = call counted$step borrow.unique %6 take %7 take %8
  branch inspect %9 -> bb3 -> bb2

bb2:
  %15: I32 = const 2
  %16: owning.Iter = call scanner borrow.shared %15
  write.init borrow.unique (kt) take %16
  jump -> bb4

bb3:
  %11: I32 = read copy.trivial (jt.$slot)
  write.init borrow.unique (y) take %11
  %13: {} = const {}
  jump -> bb1

bb4:
  %19: owning.Iter [unique call] = read borrow.unique (kt) loan1
  %20: I32 = const 0
  %21: Bool = const False
  %22: Bool = call owning$step borrow.unique %19 take %20 take %21
  branch inspect %22 -> bb6 -> bb5

bb5:
  drop (kt)
  %28: String = const String {units: Array {run: Run {items: &string'145, capacity: 5, ownsHeap: 0}, length: 5}}
  write.init borrow.unique (text) take %28
  %30: String [shared call] = read borrow.shared (text) loan2
  %31: String [shared slot 0 view] = call.derivation view(String) borrow.shared %30 roots{2}
  %32: I32 = const 2
  %33: shared.Iter [owned here shape9 .2.0.*=shared slot 0] = call shared$new borrow.shared %31 take %32 roots.0{2}
  write.init borrow.unique (lt) take %33
  %35: shared.Iter [shared slot 0 shape9 .2.0.*=shared slot 0] = read borrow.shared (lt) loan3 roots.0{2}
  %36: I32 = const 0
  %37: Holder = aggregate.Holder borrow.shared %35 take %36 roots.0{2, 3}
  write.init borrow.unique (h) take %37
  %39: shared.Iter = read copy.trivial (h.cursor) roots{2, 3}
  write.init borrow.unique (cursor) take %39
  jump -> bb7

bb6:
  %24: I32 = read copy.trivial (kt.$slot)
  write.init borrow.unique (y) take %24
  %26: {} = const {}
  jump -> bb4

bb7:
  %42: shared.Iter [unique call] = read borrow.unique (cursor) loan4 roots{2, 3}
  %43: I32 = const 0
  %44: Bool = const False
  %45: Bool = call shared$step borrow.unique %42 take %43 take %44
  branch inspect %45 -> bb9 -> bb8

bb8:
  drop (text)
  %53: I32 = read copy.trivial (global after)
  write.assign borrow.unique (h.seen) take %53
  %55: I32 = read copy.trivial (h.seen)
  return take %55

bb9:
  %47: I32 = read copy.trivial (cursor.$slot)
  write.init borrow.unique (y) take %47
  %49: I32 [unique call] = read borrow.unique (global after) loan5
  %50: I32 = read copy.trivial (y)
  %51: {} = call +=(I32) borrow.unique %49 borrow.shared %50
  jump -> bb7
}

fn shared$new(source: String [shared slot 0 view], n: I32) -> shared.Iter [owned here shape9 .2.0.*=shared slot 0] = <no body>

fn shared$step($self: shared.Iter [unique call], $resume: I32, $cancel: Bool) -> Bool = <no body>

fn shared$next($self: shared.Iter [unique slot 0]) -> Maybe(I32) [owned here shape2 .0=shared slot 0] = <no body>

fn shared$resume($self: shared.Iter [unique slot 0], $v: {}) -> Maybe(I32) [owned here shape2 .0=shared slot 0] = <no body>

fn counted$new(n: I32) -> counted.Iter = <no body>

fn counted$step($self: counted.Iter [unique call], $resume: I32, $cancel: Bool) -> Bool = <no body>

fn counted$next($self: counted.Iter [unique slot 0]) -> Maybe(I32) [owned here shape2 .0=shared slot 0] = <no body>

fn counted$resume($self: counted.Iter [unique slot 0], $v: {}) -> Maybe(I32) [owned here shape2 .0=shared slot 0] = <no body>

fn make(n: I32 [shared call]) -> counted.Iter {
  local it: counted.Iter

bb0:
  %0: I32 = read copy.trivial (n)
  %1: counted.Iter = call counted$new take %0
  write.init borrow.unique (it) take %1
  %3: counted.Iter = read copy.trivial (it)
  return take %3
}

fn owning$new(source: String, n: I32) -> owning.Iter = <no body>

fn owning$step($self: owning.Iter [unique call], $resume: I32, $cancel: Bool) -> Bool = <no body>

fn owning$drop($self: owning.Iter) -> {} = <no body>

fn owning$next($self: owning.Iter [unique slot 0]) -> Maybe(I32) [owned here shape2 .0=shared slot 0] = <no body>

fn owning$resume($self: owning.Iter [unique slot 0], $v: {}) -> Maybe(I32) [owned here shape2 .0=shared slot 0] = <no body>

fn scanner(n: I32 [shared call]) -> owning.Iter {
  local it: owning.Iter

bb0:
  %0: String = const String {units: Array {run: Run {items: &string'144, capacity: 3, ownsHeap: 0}, length: 3}}
  %1: I32 = read copy.trivial (n)
  %2: owning.Iter = call owning$new take %0 take %1
  write.init borrow.unique (it) take %2
  %4: owning.Iter = read take (it)
  return take %4
}

entry main
