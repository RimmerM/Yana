module ResolveTest

data Cmd = Keep | Skip

data steps.Iter {$index: I32, $slot: I32, n: I32, $yielded: I32, i: I32}

data plain.Iter {$index: I32, $slot: I32, n: I32, i: I32}

instance Iterate(steps.Iter, I32, Cmd): steps$next, steps$resume

instance Iterate(plain.Iter, I32, {}): plain$next, plain$resume

lens fn steps(n: I32 [shared call], $body: (I32) -> Outcome(Cmd, I32) [shared call]) -> I32 {
  local & $yielded: I32
  local & i: I32
  local local4: Outcome(Cmd, I32)
  local c: Cmd

bb0:
  %0: I32 = const 0
