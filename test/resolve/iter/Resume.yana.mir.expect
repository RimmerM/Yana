  %2: I32 = const 0
  write.init borrow.unique (i) take %2
  jump -> bb1

bb1:
  %5: I32 = read copy.trivial (i)
  %6: I32 = read copy.trivial (n)
  %7: Bool = lt inspect %5 inspect %6
  branch inspect %7 -> bb3 -> bb2

bb2:
  %40: I32 = read copy.trivial ($yielded)
  return take %40

bb3:
  %9: I32 = read copy.trivial (i)
  %10: (I32) -> Outcome(Cmd, I32) [shared call] = read borrow.shared ($body) loan0
  %11: Outcome(Cmd, I32) = call inspect %10 borrow.shared %9
  write.init borrow.unique (local4) take %11
  %13: U8 = read copy.trivial (local4.#)
  %14: U8 = const 1
  %15: Bool = eq inspect %13 inspect %14
  branch inspect %15 -> bb5 -> bb4

bb4:
  %21: Cmd = read copy.trivial (local4.Proceed)
  jump -> bb7(take %21)

bb5:
  %17: I32 = read copy.trivial (local4.Exit)
  write.assign borrow.unique ($yielded) take %17
  jump -> bb6

bb6:
  jump -> bb2

bb7(%22: Cmd):
  write.init borrow.unique (c) take %22
  %25: U8 = read copy.trivial (c.#)
  %26: U8 = const 1
  %27: Bool = eq inspect %25 inspect %26
  branch inspect %27 -> bb10 -> bb8

bb8:
  %33: I32 = read copy.trivial (i)
  %34: I32 = const 1
  %35: I32 = add inspect %33 inspect %34
  write.assign borrow.unique (i) take %35
  jump -> bb9

bb9:
  jump -> bb1

bb10:
  %29: I32 = read copy.trivial (i)
  %30: I32 = const 2
  %31: I32 = add inspect %29 inspect %30
  write.assign borrow.unique (i) take %31
  jump -> bb9
}

