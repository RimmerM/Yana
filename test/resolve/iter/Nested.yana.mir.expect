data doubled.Iter {$index: I32, $slot: I32, n: I32, $digits: digits.Iter}

data tripled.Iter {$index: I32, $slot: I32, n: I32, $doubled: doubled.Iter}

data notes.Iter {$index: I32, $slot: %Note, n: I32, i: I32, held: Note} drop authored

data sumNotes.Iter {$index: I32, $slot: I32, n: I32, $notes: notes.Iter} drop authored

data stopEarly.Iter {$index: I32, $slot: I32, n: I32, $notes: notes.Iter} drop authored

data keeping.Iter {$index: I32, $slot: I32, n: I32, mark: Note, $digits: digits.Iter} drop authored

data viaHeld.Iter {$index: I32, $slot: I32, n: I32, inner: digits.Iter}

instance Drop(Note): Note.drop

instance Iterate(digits.Iter, I32, {}): digits$next, digits$resume

instance Iterate(nothingBack.Iter, I32, {}): nothingBack$next, nothingBack$resume

instance Iterate(unitNest.Iter, I32, {}): unitNest$next, unitNest$resume

instance Iterate(unitNestWritten.Iter, I32, {}): unitNestWritten$next, unitNestWritten$resume

