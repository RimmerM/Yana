instance Iterate(tripled.Iter, I32, {}): tripled$next, tripled$resume

instance Drop(notes.Iter): notes$drop

instance Iterate(notes.Iter, Note, {}): notes$next, notes$resume

instance Drop(sumNotes.Iter): sumNotes$drop

instance Iterate(sumNotes.Iter, I32, {}): sumNotes$next, sumNotes$resume

instance Drop(stopEarly.Iter): stopEarly$drop

instance Iterate(stopEarly.Iter, I32, {}): stopEarly$next, stopEarly$resume

instance Drop(keeping.Iter): keeping$drop

instance Iterate(keeping.Iter, I32, {}): keeping$next, keeping$resume

instance Iterate(viaHeld.Iter, I32, {}): viaHeld$next, viaHeld$resume

let & trace: I32 = 0

fn Note.drop(value: Note) -> {} {
bb0:
  %0: I32 = read copy.trivial (global trace)
  %1: I32 = const 10
  %2: I32 = mul inspect %0 inspect %1
  %3: I32 = read copy.trivial (value.id)
  %4: I32 = add inspect %2 inspect %3
  write.assign borrow.unique (global trace) take %4
  return
}

