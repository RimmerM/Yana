instance Drop(evens.Iter): evens$drop

instance Iterate(evens.Iter, I32, {}): evens$next, evens$resume

instance Drop(marked.Iter): marked$drop

instance Iterate(marked.Iter, I32, {}): marked$next, marked$resume

