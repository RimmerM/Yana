  %6: I32 = read copy.trivial (n)
  %7: I32 = const 2
  %8: I32 = mul inspect %6 inspect %7
  %9: (I32) -> $r [shared call] = read borrow.shared ($body) loan0
  %10: $r = call inspect %9 borrow.shared %8
  write.init borrow.unique ($yielded) take %10
  %12: I32 = read copy.trivial (global trace)
  %13: I32 = const 10
  %14: I32 = mul inspect %12 inspect %13
  %15: I32 = const 2
  %16: I32 = add inspect %14 inspect %15
  write.assign borrow.unique (global trace) take %16
  %18: $r = read take ($yielded)
  return take %18
}

