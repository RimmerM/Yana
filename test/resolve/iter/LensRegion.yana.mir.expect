module ResolveTest

data Note {id: I32} drop authored

data guard(I32).Lens {$index: I32, $slot: I32, n: I32}

data guarded.Iter {$index: I32, $slot: I32, n: I32, $guard: guard(I32).Lens} drop authored

data keeping.Iter {$index: I32, $slot: I32, n: I32, mark: Note, $guard: guard(I32).Lens} drop authored

data digits.Iter {$index: I32, $slot: I32, n: I32, i: I32}

data inside.Iter {$index: I32, $slot: I32, n: I32, $guard: guard(I32).Lens, $digits: digits.Iter} drop authored

data flat.Iter {$index: I32, $slot: I32, n: I32, $guard: guard(I32).Lens} drop authored

data bare.Iter {$index: I32, $slot: I32, n: I32, $guard: guard(I32).Lens} drop authored

data quiet.Iter {$index: I32, $slot: I32, n: I32, $guard: guard(I32).Lens} drop authored

data inner(I32).Lens {$index: I32, $slot: I32, n: I32}

data twoDeep.Iter {$index: I32, $slot: I32, n: I32, $guard: guard(I32).Lens, $inner: inner(I32).Lens} drop authored

data I32.enter.Lens {$index: I32, $slot: I32, self: I32}

data viaClass.Iter {$index: I32, $slot: I32, n: I32, $enter: I32.enter.Lens} drop authored

data stopping.Iter {$index: I32, $slot: I32, n: I32, $guard: guard(I32).Lens, $digits: digits.Iter} drop authored

class Scoped(a): enter

instance Drop(Note): Note.drop

instance Scoped(I32): I32.enter

instance Drop(guarded.Iter): guarded$drop

instance Iterate(guarded.Iter, I32, {}): guarded$next, guarded$resume

instance Drop(keeping.Iter): keeping$drop

instance Iterate(keeping.Iter, I32, {}): keeping$next, keeping$resume

instance Iterate(digits.Iter, I32, {}): digits$next, digits$resume

instance Drop(inside.Iter): inside$drop

instance Iterate(inside.Iter, I32, {}): inside$next, inside$resume

instance Drop(flat.Iter): flat$drop

instance Iterate(flat.Iter, I32, {}): flat$next, flat$resume

instance Drop(bare.Iter): bare$drop

instance Iterate(bare.Iter, I32, {}): bare$next, bare$resume

instance Drop(quiet.Iter): quiet$drop

instance Iterate(quiet.Iter, I32, {}): quiet$next, quiet$resume

instance Drop(twoDeep.Iter): twoDeep$drop

instance Iterate(twoDeep.Iter, I32, {}): twoDeep$next, twoDeep$resume

instance Drop(viaClass.Iter): viaClass$drop

instance Iterate(viaClass.Iter, I32, {}): viaClass$next, viaClass$resume

instance Drop(stopping.Iter): stopping$drop

instance Iterate(stopping.Iter, I32, {}): stopping$next, stopping$resume

let & trace: I32 = 0

lens fn enter(self: a [shared call], $body: (I32) -> I32 [shared call]) -> I32 = <no body>

fn Note.drop(value: Note) -> {} {
bb0:
  %0: I32 = read copy.trivial (global trace)
  %1: I32 = const 10
  %2: I32 = mul inspect %0 inspect %1
  %3: I32 = read copy.trivial (value.id)
  %4: I32 = add inspect %2 inspect %3
  write.assign borrow.unique (global trace) take %4
  return
}

lens fn guard(n: I32 [shared call], $body: (I32) -> $r [shared call]) -> $r {
  form specialized
  slot #0 type $r
  local $yielded: $r

bb0:
