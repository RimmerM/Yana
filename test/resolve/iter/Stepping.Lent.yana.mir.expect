  %23: U8 = add inspect %21 inspect %22
  %24: Array(U8) [unique slot 0 view] = read borrow.unique (xs) loan2
  %25: U8 [unique slot 0 owner] = call.subscript getMut(Array(U8), Size, U8) borrow.unique %24 borrow.shared %16 roots{2}
  write.init borrow.unique (local6) borrow.unique %25
