  %4: Win [unique call] = read borrow.unique (w) loan0
  %5: (&Win) -> I32 [shared call] = read borrow.shared ($body) loan1
  %6: I32 = call inspect %5 borrow.unique %4
  write.init borrow.unique ($yielded) take %6
  %8: I32 = read copy.trivial (output.total)
  %9: I32 = read copy.trivial (minimum)
  %10: I32 = add inspect %8 inspect %9
  write.assign borrow.unique (output.total) take %10
  %12: I32 = read copy.trivial ($yielded)
  return take %12
}

