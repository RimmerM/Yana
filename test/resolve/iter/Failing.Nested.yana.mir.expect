data forward.Iter {$index: I32, $slot: I32, n: I32, failAt: I32, tag: Tag, $child: child.Iter, $failure: Outcome(I32, Tag)} drop authored

instance Drop(Tag): Tag.drop

instance Drop(child.Iter): child$drop

instance IterateFailing(child.Iter, I32, Tag, {}): child$next, child$resume

instance Drop(recover.Iter): recover$drop

instance Iterate(recover.Iter, I32, {}): recover$next, recover$resume

instance Drop(replace.Iter): replace$drop

instance Iterate(replace.Iter, I32, {}): replace$next, replace$resume

instance Drop(forward.Iter): forward$drop

instance IterateFailing(forward.Iter, I32, Tag, {}): forward$next, forward$resume

