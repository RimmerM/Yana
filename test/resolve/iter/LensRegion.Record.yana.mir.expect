module ResolveTest

data Src {bytes: Array(U8), at: Size} reclaim derived

data Win {space: &0'Array(U8), used: Size} shape3

data window(I32).Lens {$index: I32, $slot: %Win, src: %Src, count: Size, start: Size, w: Win} shape11

data blocks.Iter {$index: I32, $slot: I32, src: %Src, $window: window(I32).Lens} shape13 drop authored

data scratchWindow(I32).Lens {$index: I32, $slot: %Win, buf: ArrayView(U8), count: Size, win: Win} shape16

data encoded.Iter {$index: I32, $slot: I32, input: ArrayView(U8), scratch: ArrayView(U8), at: Size, $scratchWindow: scratchWindow(I32).Lens} shape22 drop authored

instance Drop(blocks.Iter): blocks$drop

instance Iterate(blocks.Iter, I32, {}): blocks$next, blocks$resume

instance Drop(encoded.Iter): encoded$drop

instance Iterate(encoded.Iter, I32, {}): encoded$next, encoded$resume

