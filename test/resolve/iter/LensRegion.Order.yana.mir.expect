lens fn around($body: (->{}) -> $r [shared call]) -> $r {
  form specialized
  slot #0 type $r
  local $yielded: $r

bb0:
  %0: I32 = read copy.trivial (global trace)
  %1: I32 = const 1
  %2: I32 = add inspect %0 inspect %1
  write.assign borrow.unique (global trace) take %2
  %4: {} = const {}
  %5: (->{}) -> $r [shared call] = read borrow.shared ($body) loan0
  %6: $r = call inspect %5 take {}
  write.init borrow.unique ($yielded) take %6
  %8: I32 = read copy.trivial (global trace)
  %9: I32 = const 10
  %10: I32 = add inspect %8 inspect %9
  write.assign borrow.unique (global trace) take %10
  %12: $r = read take ($yielded)
  return take %12
}

lens fn doubled(x: a [shared call], $body: (a) -> $r [shared call]) -> $r {
  form specialized
  slot #0 type a
  slot #1 type $r
  slot #2 class Num(a)
  local $yielded: $r
  local local3: a

bb0:
  %0: a [shared call] = read borrow.shared (x) loan0
  %1: a [shared call] = read borrow.shared (x) loan1
  %2: a = call +(a) borrow.shared %0 borrow.shared %1
  write.init borrow.unique (local3) take %2
  %4: a [shared call] = read borrow.shared (local3) loan2
  %5: (a) -> $r [shared call] = read borrow.shared ($body) loan3
  %6: $r = call inspect %5 borrow.shared %4
  drop (local3)
  write.init borrow.unique ($yielded) take %6
  %8: $r = read take ($yielded)
  return take %8
}

lens fn Tracer.bracket(self: Tracer [shared call], $body: (->{}) -> I32 [shared call]) -> I32 {
  local $yielded: I32

bb0:
  %0: {} = const {}
  %1: (->{}) -> I32 [shared call] = read borrow.shared ($body) loan0
  %2: I32 = call inspect %1 take {}
  write.init borrow.unique ($yielded) take %2
  %4: I32 = read copy.trivial (global trace)
  %5: I32 = read copy.trivial (self.step)
  %6: I32 = const 100
  %7: I32 = mul inspect %5 inspect %6
  %8: I32 = add inspect %4 inspect %7
  write.assign borrow.unique (global trace) take %8
  %10: I32 = read copy.trivial ($yielded)
  return take %10
}

