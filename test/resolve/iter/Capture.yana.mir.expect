module ResolveTest

data Owned {id: I32} drop authored

data Big {a: I32, b: I32, c: I32, d: I32, e: I32, f: I32} drop authored

data Pair(k, v) {key: k, value: v} drop derived reclaim derived

data Pair(I32, I32) {key: I32, value: I32} of Pair

data handing.Iter {$index: I32, $slot: Owned, n: I32, i: I32, $held: Bool} drop authored

data over.Iter {$index: I32, $slot: I32, big: %Big, n: I32, i: I32} shape8

data picking.Iter {$index: I32, $slot: I32, xs: ArrayView(I32), n: I32, i: I32} shape10

data paired.Iter {$index: I32, $slot: %Pair(I32, I32), xs: ArrayView(I32), n: I32, i: I32, entry: Pair(I32, I32)} shape10

instance Drop(Owned): Owned.drop

instance Drop(Big): Big.drop

instance Drop(handing.Iter): handing$drop

instance Iterate(handing.Iter, Owned, {}): handing$next, handing$resume

instance Iterate(over.Iter, I32, {}): over$next, over$resume

instance Iterate(picking.Iter, I32, {}): picking$next, picking$resume

instance Iterate(paired.Iter, Pair(I32, I32), {}): paired$next, paired$resume

let & trace: I32 = 0

fn Owned.drop(value: Owned) -> {} {
bb0:
  %0: I32 = read copy.trivial (global trace)
