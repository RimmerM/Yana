module ResolveTest

data Tree {size: I32}

data Row {width: I32}

data Held(i) {walk: i, packed: I32} drop derived reclaim derived

data Step {size: I32}

data Branch = Leaf | Node {left: @box Branch, right: @box Branch, value: I32} reclaim derived

data Tree.walk.Iter {$index: I32, $slot: I32, self: Tree}

data Row.walk.Iter {$index: I32, $slot: I32, self: Row, : I32, : I32, : I32}

data countUp.Iter {$index: I32, $slot: I32, to: I32, : I32, : I32, : I32}

data countDown.Iter {$index: I32, $slot: I32, from: I32, i: I32}

data Held(iter(I32)) {walk: iter(I32), packed: I32} of Held drop derived reclaim derived

data Held(iter(Array(I32))) {walk: iter(Array(I32)), packed: I32} of Held drop derived reclaim derived

data paces(Step).Iter {$index: I32, $slot: I32, self: Step, n: I32, i: I32}

data Branch.descend.Iter {$index: I32, $slot: I32, self: %Branch, right: %Branch, value: I32, $descend: {$pair: iter(I32), $up: USize}, $descend: {$pair: iter(I32), $up: USize}, $down: USize, $inner: USize} shape8 drop authored

class Walks(s): walk

class Streams(s): steps

class Paces(p): stride, paces

class Walkers(t): descend

instance Walks(Tree): Tree.walk

instance Walks(Row): Row.walk

instance Streams(Tree): Tree.steps

instance Streams(Row): Row.steps

instance Paces(Step): Step.stride, Paces.paces

instance Walkers(Branch): Branch.descend

instance Iterate(Tree.walk.Iter, I32, {}): Tree.walk$next, Tree.walk$resume

instance Iterate(Row.walk.Iter, I32, {}): Row.walk$next, Row.walk$resume

instance Iterate(countUp.Iter, I32, {}): countUp$next, countUp$resume

instance Iterate(countDown.Iter, I32, {}): countDown$next, countDown$resume

instance Iterate(paces(Step).Iter, I32, {}): paces(Step)$next, paces(Step)$resume

instance Drop(Branch.descend.Iter): Branch.descend$drop

instance Iterate(Branch.descend.Iter, I32, {}): Branch.descend$next, Branch.descend$resume

let & trace: I32 = 0

lens fn walk(self: s [shared call], $body: (I32) -> I32 [shared call]) -> I32 = <no body>

fn steps(self: s [shared call]) -> iter(I32) = <no body>

fn stride(self: p [shared call]) -> I32 = <no body>

lens fn paces(self: p [shared call], $body: (I32) -> I32 [shared call]) -> I32 {
  form specialized
  slot #0 type p
  slot #1 class Paces(p)
  local & $yielded: I32
  local n: I32
  local & i: I32

bb0:
  %0: I32 = const 0
  write.init borrow.unique ($yielded) take %0
  %2: p [shared call] = read borrow.shared (self) loan0
  %3: I32 = call stride(p) borrow.shared %2
  write.init borrow.unique (n) take %3
  %5: I32 = const 0
  write.init borrow.unique (i) take %5
  jump -> bb1

bb1:
  %8: I32 = read copy.trivial (i)
  %9: I32 = read copy.trivial (n)
  %10: Bool = lt inspect %8 inspect %9
  branch inspect %10 -> bb3 -> bb2

bb2:
  %27: I32 = read copy.trivial ($yielded)
  return take %27

bb3:
  %12: I32 = read copy.trivial (i)
  %13: I32 = const 2
  %14: I32 = mul inspect %12 inspect %13
  %15: (I32) -> I32 [shared call] = read borrow.shared ($body) loan1
  %16: I32 = call inspect %15 borrow.shared %14
  %17: I32 = const 0
  %18: Bool = eq inspect %16 inspect %17
  write.assign borrow.unique ($yielded) take %16
  branch inspect %18 -> bb4 -> bb5

bb4:
  %22: I32 = read copy.trivial (i)
  %23: I32 = const 1
  %24: I32 = add inspect %22 inspect %23
  write.assign borrow.unique (i) take %24
  jump -> bb1

bb5:
  jump -> bb2
}

lens fn descend(self: t [shared call], $body: (I32) -> I32 [shared call]) -> I32 = <no body>

