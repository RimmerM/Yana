module ResolveTest

data Mark {id: I32} drop authored

data Tree = Leaf | Node {left: @box Tree, right: @box Tree, value: I32} reclaim derived

data Carrier {walk: descend.Iter, packed: I32} drop derived

data Held {walk: markedDescend.Iter, packed: I32} drop derived

data descend.Iter {$index: I32, $slot: I32, n: I32, $descend: {$pair: iter(I32), $up: USize}, $down: USize, $inner: USize} drop authored

data markedDescend.Iter {$index: I32, $slot: I32, n: I32, m: Mark, $markedDescend: {$pair: iter(I32), $up: USize}, $down: USize, $inner: USize} drop authored

data pass.Iter {$index: I32, $slot: I32, t: %Tree, right: %Tree, value: I32, $pass: {$pair: iter(I32), $up: USize}, $pass: {$pair: iter(I32), $up: USize}, $down: USize, $inner: USize} shape8 drop authored

data outer.Iter {$index: I32, $slot: I32, t: %Tree, $pass: pass.Iter} shape10 drop authored

data tallied.Iter {$index: I32, $slot: I32, t: %Tree, right: %Tree, value: I32, $tallied: iter(I32), $tallied: iter(I32)} shape8 drop authored

data odds.Iter {$index: I32, $slot: I32, t: %Tree, right: %Tree, value: I32, $evens: {$pair: iter(I32), $up: USize}, $evens: {$pair: iter(I32), $up: USize}, $down: USize, $inner: USize} shape8 drop authored

data evens.Iter {$index: I32, $slot: I32, t: %Tree, right: %Tree, value: I32, $odds: {$pair: iter(I32), $up: USize}, $odds: {$pair: iter(I32), $up: USize}, $down: USize, $inner: USize} shape8 drop authored

data marked.Iter {$index: I32, $slot: I32, t: %Tree, right: %Tree, value: I32, m: Mark, $marked: {$pair: iter(I32), $up: USize}, $marked: {$pair: iter(I32), $up: USize}, $down: USize, $inner: USize} shape8 drop authored

instance Drop(Mark): Mark.drop

instance Drop(descend.Iter): descend$drop

instance Iterate(descend.Iter, I32, {}): descend$next, descend$resume

instance Drop(markedDescend.Iter): markedDescend$drop

instance Iterate(markedDescend.Iter, I32, {}): markedDescend$next, markedDescend$resume

instance Drop(pass.Iter): pass$drop

instance Iterate(pass.Iter, I32, {}): pass$next, pass$resume

instance Drop(outer.Iter): outer$drop

instance Iterate(outer.Iter, I32, {}): outer$next, outer$resume

instance Drop(tallied.Iter): tallied$drop

instance Iterate(tallied.Iter, I32, {}): tallied$next, tallied$resume

instance Drop(odds.Iter): odds$drop

instance Iterate(odds.Iter, I32, {}): odds$next, odds$resume

instance Drop(evens.Iter): evens$drop

instance Iterate(evens.Iter, I32, {}): evens$next, evens$resume

instance Drop(marked.Iter): marked$drop

instance Iterate(marked.Iter, I32, {}): marked$next, marked$resume

let & trace: I32 = 0

let & made: I32 = 0

let & visits: I32 = 0

fn Mark.drop(value: Mark) -> {} {
bb0:
  %0: I32 = read copy.trivial (global trace)
  %1: I32 = const 10
  %2: I32 = mul inspect %0 inspect %1
  %3: I32 = read copy.trivial (value.id)
  %4: I32 = add inspect %2 inspect %3
  write.assign borrow.unique (global trace) take %4
  return
}

fn mark(id: I32 [shared call]) -> Mark {
bb0:
  %0: I32 = read copy.trivial (global made)
  %1: I32 = const 1
  %2: I32 = add inspect %0 inspect %1
  write.assign borrow.unique (global made) take %2
  %4: I32 = read copy.trivial (id)
  %5: Mark = aggregate.Mark take %4
  return take %5
}

fn build(depth: I32 [shared call], base: I32 [shared call]) -> Tree {
bb0:
  %0: I32 = read copy.trivial (depth)
  %1: I32 = const 0
  %2: Bool = eq inspect %0 inspect %1
  branch inspect %2 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %7: I32 = read copy.trivial (depth)
  %8: I32 = const 1
  %9: I32 = sub inspect %7 inspect %8
  %10: I32 = read copy.trivial (base)
  %11: I32 = const 2
  %12: I32 = mul inspect %10 inspect %11
  %13: Tree = call build borrow.shared %9 borrow.shared %12
  %14: I32 = read copy.trivial (depth)
  %15: I32 = const 1
  %16: I32 = sub inspect %14 inspect %15
  %17: I32 = read copy.trivial (base)
  %18: I32 = const 2
  %19: I32 = mul inspect %17 inspect %18
  %20: I32 = const 1
  %21: I32 = add inspect %19 inspect %20
  %22: Tree = call build borrow.shared %16 borrow.shared %21
  %23: I32 = read copy.trivial (base)
  %24: Tree = aggregate.Node take %13 take %22 take %23
  return take %24

bb3:
  %4: Tree = aggregate.Leaf
  return take %4
}

fn chain(length: I32 [shared call], base: I32 [shared call]) -> Tree {
bb0:
  %0: I32 = read copy.trivial (length)
  %1: I32 = const 0
  %2: Bool = eq inspect %0 inspect %1
  branch inspect %2 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %7: I32 = read copy.trivial (length)
  %8: I32 = const 1
  %9: I32 = sub inspect %7 inspect %8
  %10: I32 = read copy.trivial (base)
  %11: I32 = const 1
  %12: I32 = add inspect %10 inspect %11
  %13: Tree = call chain borrow.shared %9 borrow.shared %12
  %14: Tree = aggregate.Leaf
  %15: I32 = read copy.trivial (base)
  %16: Tree = aggregate.Node take %13 take %14 take %15
  return take %16

bb3:
  %4: Tree = aggregate.Leaf
  return take %4
}

