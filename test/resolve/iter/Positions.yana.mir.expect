module ResolveTest

data Parser(l) {lexer: l, packed: I32} drop derived reclaim derived

data Scan {cursor: upTo.Iter, packed: I32}

data Tag {v: I32}

data upTo.Iter {$index: I32, $slot: I32, n: I32, i: I32}

data Parser(upTo.Iter) {lexer: upTo.Iter, packed: I32} of Parser

class Absorbing(s): absorb

instance Absorbing(Tag): Tag.absorb

instance Iterate(upTo.Iter, I32, {}): upTo$next, upTo$resume

fn absorb(self: s [shared call]) -> I32 = <no body>

lens fn upTo(n: I32 [shared call], $body: (I32) -> I32 [shared call]) -> I32 {
  local & $yielded: I32
