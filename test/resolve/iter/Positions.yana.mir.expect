  %3: upTo.Iter [unique call] = read borrow.unique (held) loan0
  %4: I32 = call peek borrow.unique %3
  write.init borrow.unique (first) take %4
  %6: I32 = read copy.trivial (first)
  %7: I32 = const 10000
  %8: I32 = mul inspect %6 inspect %7
  %9: I32 = read copy.trivial (n)
  %10: upTo.Iter = call upTo$new take %9
  %11: I32 = call drain take %10
  %12: I32 = add inspect %8 inspect %11
  return take %12
}

fn Tag.absorb(self: Tag [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (self.v)
