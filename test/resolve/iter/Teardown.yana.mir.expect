instance Drop(Note): Note.drop

instance Drop(straight.Iter): straight$drop

instance Iterate(straight.Iter, I32, {}): straight$next, straight$resume

instance Drop(looped.Iter): looped$drop

instance Iterate(looped.Iter, I32, {}): looped$next, looped$resume

instance Drop(holding.Iter): holding$drop

instance Iterate(holding.Iter, I32, {}): holding$next, holding$resume

let & trace: I32 = 0

fn Note.drop(value: Note) -> {} {
bb0:
