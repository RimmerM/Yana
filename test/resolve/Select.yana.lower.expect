@image$base = []
mut @calls = [0, 0, 0, 0]

lowered<complex>(): Float {
  b_0 {
    ret -3
  }
}

zero<complex>(): Int {
  b_0 {
    ret 0
  }
}

doubled<complex>(%value: Int): Int {
  b_0 {
    %v_1 = shl %value, 1: Int
    ret %v_1
  }
}

main<complex>(): Int {
  b_0 {
    store @calls, 1, 4
    %v_1 = call_complex lowered: Float
    %v_2 = cmp_gt %v_1, 0: Int
    %v_3 = sub 0, %v_1: Float
    %v_4 = select %v_2, %v_1, %v_3: Float
    %v_5 = cmp_gt %v_4, 2.5: Int
    %v_6 = select %v_5, 5, 0: Int
    %v_7 = shl %v_6, 8: Int
    %v_8 = add %v_7, 1310: Int
    jmp b_9
  }

  b_10 {
    %v_11 = cmp_ilt %v_12, 5: Int
    je %v_11, b_9, b_13
  }

  b_13 {
    %v_14 = shl %v_15, 9: Int
    %v_16 = add %v_8, %v_14: Int
    %v_17 = call_complex zero: Int
    %v_18 = cmp_neq %v_17, 0: Int
    je %v_18, b_19, b_20
  }

  b_20 {
    jmp b_21
  }

  b_19 {
    %v_22 = idiv 10, %v_17: Int
    jmp b_21
  }

  b_21 {
    %v_23 = phi [b_19, %v_22], [b_20, 0]: Int
    %v_24 = shl %v_23, 10: Int
    %v_25 = add %v_16, %v_24: Int
    %v_26 = add %v_25, 10240: Int
    %v_27 = call_complex doubled, 3: Int
    %v_28 = shl %v_27, 12: Int
    %v_29 = add %v_26, %v_28: Int
    ret %v_29
  }

  b_9 {
    %v_30 = phi [b_10, %v_15], [b_0, 100]: Int
    %v_31 = phi [b_10, %v_12], [b_0, 0]: Int
    %v_32 = imul %v_31, 3: Int
    %candidate = sub 40, %v_32: Int
    %v_33 = cmp_ilt %candidate, %v_30: Int
    %v_15 = select %v_33, %candidate, %v_30: Int
    %v_12 = add %v_31, 1: Int
    jmp b_10
  }
}

