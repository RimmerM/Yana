@image$base = []
mut @calls = [0, 0, 0, 0]

lowered<complex>(): Float {
  b_0 {
    ret -3
  }
}

zero<complex>(): Int {
  b_0 {
    ret 0
  }
}

doubled<complex>(%value: Int): Int {
  b_0 {
    %v_1 = shl %value, 1: Int
    ret %v_1
  }
}

main<complex>(): Int {
  b_0 {
    store @calls, 1, 4
    %v_1 = call_complex lowered: Float
    %v_2 = cmp_gt %v_1, 0: Int
    %v_3 = sub 0, %v_1: Float
    %v_4 = select %v_1, %v_3, %v_2: Float
    %v_5 = cmp_gt %v_4, 2.5: Int
    %v_6 = select 5, 0, %v_5: Int
    %v_7 = shl %v_6, 8: Int
    %v_8 = add %v_7, 1310: Int
    jmp b_9
  }

  b_9 {
    %v_10 = phi [b_0, 100], [b_11, %v_12]: Int
    %v_13 = phi [b_0, 0], [b_11, %v_14]: Int
    %v_15 = cmp_ilt %v_13, 5: Int
    je %v_15, b_11, b_16
  }

  b_16 {
    %v_17 = shl %v_10, 9: Int
    %v_18 = add %v_8, %v_17: Int
    %v_19 = call_complex zero: Int
    %v_20 = cmp_neq %v_19, 0: Int
    je %v_20, b_21, b_22
  }

  b_22 {
    jmp b_23
  }

  b_21 {
    %v_24 = idiv 10, %v_19: Int
    jmp b_23
  }

  b_23 {
    %v_25 = phi [b_21, %v_24], [b_22, 0]: Int
    %v_26 = shl %v_25, 10: Int
    %v_27 = add %v_18, %v_26: Int
    %v_28 = add %v_27, 10240: Int
    %v_29 = call_complex doubled, 3: Int
    %v_30 = shl %v_29, 12: Int
    %v_31 = add %v_28, %v_30: Int
    ret %v_31
  }

  b_11 {
    %v_32 = imul %v_13, 3: Int
    %candidate = sub 40, %v_32: Int
    %v_33 = cmp_ilt %candidate, %v_10: Int
    %v_12 = select %candidate, %v_10, %v_33: Int
    %v_14 = add %v_13, 1: Int
    jmp b_9
  }
}

