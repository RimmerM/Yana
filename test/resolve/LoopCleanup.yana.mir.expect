module ResolveTest

data Cell {kind: @bits(4) U32, live: Bool, count: @bits(12) U32, age: @bits(20) U32}

data Item {weight: F64, kind: @bits(4) U32, live: Bool, marked: Bool, level: @bits(8) U32, count: @bits(12) U32}

