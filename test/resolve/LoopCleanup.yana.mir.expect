  %28: I32 = read copy.trivial (j)
  %29: U32 = bitcast inspect %28
  write.init borrow.unique (i) take %29
  %31: Array(Cell) [unique call] = read borrow.unique (xs) loan0
  %32: U32 = read copy.trivial (i)
  %33: U32 = const 16
  %34: U32 = rem inspect %32 inspect %33
  %35: @bits(4) U32 = convert inspect %34
  %36: U32 = read copy.trivial (i)
  %37: U32 = const 3
  %38: U32 = rem inspect %36 inspect %37
  %39: U32 = const 0
  %40: Bool = eq inspect %38 inspect %39
  %41: U32 = read copy.trivial (i)
  %42: U32 = const 4096
  %43: U32 = rem inspect %41 inspect %42
  %44: @bits(12) U32 = convert inspect %43
  %45: U32 = read copy.trivial (i)
  %46: U32 = const 1000000
  %47: U32 = rem inspect %45 inspect %46
  %48: @bits(20) U32 = convert inspect %47
  %49: Cell = aggregate.Cell take %35 take %40 take %44 take %48
  %50: {} = call push(Cell) borrow.unique %31 take %49
  jump -> bb2(take %23, take %24)
}

