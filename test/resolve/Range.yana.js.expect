"use strict";
// ResolveTest
function sum(n) {
  var total = 0;
  var v7 = 0;
  while (v7 < n) {
    var i = v7;
    total = total + i | 0;
    v7 = v7 + 1 | 0;
  }
  return total;
}

function sumInclusive(n) {
  var total = 0;
  var v7 = 0;
  while (v7 <= n) {
    var i = v7;
    total = total + i | 0;
    var v15 = v7;
    if ((n - v15 | 0) < 1) {
      break;
    }
    v7 = v15 + 1 | 0;
  }
  return total;
}

function empty() {
  var total = 7;
  var v8 = 0;
  while (v8 < 0) {
    total = total + 100 | 0;
    v8 = v8 + 1 | 0;
  }
  var v30 = 5;
  while (v30 < 3) {
    total = total + 100 | 0;
    v30 = v30 + 1 | 0;
  }
  var v52 = 5;
  while (v52 <= 3) {
    total = total + 100 | 0;
    var v62 = v52;
    if ((3 - v62 | 0) < 1) {
      break;
    }
    v52 = v62 + 1 | 0;
  }
  return total;
}

function ascending(n) {
  var seen = 0;
  var v7 = 0;
  while (v7 < n) {
    var i = v7;
    seen = Math.imul(seen, 10) + i | 0;
    v7 = v7 + 1 | 0;
  }
  return seen;
}

function descending(n) {
  var seen = 0;
  if (n > 0) {
    if (n >= 1) {
      var v11 = n - 1 | 0;
      while (v11 >= 0) {
        var i = v11;
        seen = Math.imul(seen, 10) + i | 0;
        var v22 = v11;
        if (v22 < 1) {
          break;
        }
        v11 = v22 - 1 | 0;
      }
    }
  }
  return seen;
}

function strideUp(n) {
  var seen = 0;
  var v7 = 0;
  while (v7 < n) {
    var i = v7;
    seen = Math.imul(seen, 10) + i | 0;
    var v18 = v7;
    if ((n - v18 | 0) <= 2) {
      break;
    }
    v7 = v18 + 2 | 0;
  }
  return seen;
}

function strideDown(n) {
  var seen = 0;
  if (n > 0) {
    if (n >= 2) {
      var v11 = n - 2 | 0;
      while (v11 >= 0) {
        var i = v11;
        seen = Math.imul(seen, 10) + i | 0;
        var v22 = v11;
        if (v22 < 2) {
          break;
        }
        v11 = v22 - 2 | 0;
      }
    }
  }
  return seen;
}

function unsignedTop() {
  var count = 0;
  var v7 = 0;
  while (v7 <= 255) {
    count = count + 1 | 0;
    var v17 = v7;
    if ((255 - v17 & 255) < 1) {
      break;
    }
    v7 = v17 + 1 & 255;
  }
  return count;
}

function unsignedHalfOpen() {
  var count = 0;
  var v7 = 0;
  while (v7 < 255) {
    count = count + 1 | 0;
    v7 = v7 + 1 & 255;
  }
  return count;
}

function unsignedEmpty() {
  var count = 0;
  var v5 = 0;
  while (v5 < 0) {
    count = count + 1 | 0;
    v5 = v5 + 1 & 255;
  }
  return count;
}

function broken(n) {
  var total = 0;
  var v7 = 0;
  while (v7 < n) {
    var i = v7;
    if (i > 5) {
      break;
    }
    total = total + i | 0;
    v7 = v7 + 1 | 0;
  }
  return total;
}

function skipped(n) {
  var total = 0;
  var v7 = 0;
  while (v7 < n) {
    var i = v7;
    if ($rem(i, 2) | 0) {
      total = total + i | 0;
    }
    v7 = v7 + 1 | 0;
  }
  return total;
}

function everySkipped(n) {
  var count = 0;
  var v7 = 0;
  while (v7 < n) {
    count = count + 1 | 0;
    v7 = v7 + 1 | 0;
  }
  return count;
}

function firstOver(n, bound) {
  var v5 = 0;
  while (v5 < n) {
    var i = v5;
    if (i > bound) {
      return i;
    } else {
      v5 = v5 + 1 | 0;
    }
  }
  return -1;
}

function grid() {
  var total = 0;
  var v6 = 1;
  while (v6 < 4) {
    var r = v6;
    var v14 = 0;
    var v22 = Math.imul(r, 10);
    while (v14 < r) {
      var c = v14;
      total = (total + v22 | 0) + c | 0;
      v14 = v14 + 1 | 0;
    }
    v6 = v6 + 1 | 0;
  }
  return total;
}

function walked() {
  return (((((sum(5) + sumInclusive(5) | 0) + empty() | 0) + ascending(4) | 0) + descending(4) | 0) + strideUp(9) | 0) + strideDown(10) | 0;
}

function stopped() {
  return ((((((unsignedTop() + unsignedHalfOpen() | 0) + unsignedEmpty() | 0) + broken(20) | 0) + skipped(8) | 0) + everySkipped(6) | 0) + firstOver(10, 6) | 0) + grid() | 0;
}

function main() {
  return walked() + stopped() | 0;
}

// `x / 0` is 0 and `x % 0` is x - see doc/spec/types.md
function $rem(a, b) {
  return b ? a % b : a;
}
main();
