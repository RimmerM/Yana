fn roundTrip() -> I32 {
  local taken: Maybe(Whence)
  local w: Whence
  local back: I32

bb0:
  %0: I32 = const 1
  %1: I32 = call opaque borrow.shared %0
  %2: I64 = convert inspect %1
  %3: Maybe(Whence) = call whenceOf borrow.shared %2
