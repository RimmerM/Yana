module ResolveTest

data Pair {left: I64, right: I64}

fn main() -> I32 {
  local & p: Pair

bb0:
  %0: I64 = const 10
  %1: I64 = const 20
  %2: Pair = aggregate.Pair take %0 take %1
  write.init borrow.unique (p) take %2
  %4: I64 = read copy.trivial (p.left)
  %5: I64 = const 2
  %6: I64 = add inspect %4 inspect %5
  write.assign borrow.unique (p.left) take %6
  %8: I64 = read copy.trivial (p.left)
  %9: I64 = read copy.trivial (p.right)
  %10: I64 = add inspect %8 inspect %9
  %11: I32 = convert inspect %10
  return take %11
}

entry main
