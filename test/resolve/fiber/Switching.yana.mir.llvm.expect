define fastcc void @newFiber(ptr %0, ptr %stack, i64 %stackBytes, ptr %context, ptr %entry) #0 {
  br label %2

2:                                                ; preds = %1
  %3 = getelementptr i8, ptr %stack, i64 %stackBytes
  %4 = ptrtoint ptr %3 to i64
  %5 = and i64 %4, -16
  %6 = inttoptr i64 %5 to ptr
  %7 = load ptr, ptr %entry, align 1
  %8 = getelementptr i8, ptr %entry, i64 8
  %9 = load ptr, ptr %8, align 1
  %10 = getelementptr i8, ptr %6, i64 -8
  store ptr %7, ptr %10, align 8
  %11 = getelementptr i8, ptr %6, i64 -16
  store ptr %context, ptr %11, align 8
  %12 = getelementptr i8, ptr %6, i64 -24
  store ptr %9, ptr %12, align 8
  %13 = getelementptr i8, ptr %6, i64 -32
  store ptr @__yana_stack_entry, ptr %13, align 8
  %14 = getelementptr i8, ptr %6, i64 -40
  store i64 0, ptr %14, align 8
  %15 = getelementptr i8, ptr %6, i64 -40
  %16 = getelementptr i8, ptr %0, i64 8
  call void @llvm.memset.p0.i64(ptr align 1 %16, i8 0, i64 9, i1 false)
  store ptr %15, ptr %0, align 1
  ret void
}

define fastcc void @finishOn(ptr %self, i64 %value) #0 {
  br label %1

1:                                                ; preds = %0
  %2 = getelementptr i8, ptr %self, i64 16
  store i8 2, ptr %2, align 1
  br label %3

3:                                                ; preds = %3, %1
  %4 = getelementptr i8, ptr %self, i64 8
  %5 = load ptr, ptr %4, align 1
  %6 = call preserve_nonecc i64 @__yana_stack_switch(ptr %5, ptr %self, i64 %value)
  br label %3
}

define fastcc void @"funvalue(count'2)"(ptr %0, ptr %1) #0 {
  br label %3

3:                                                ; preds = %2
  call fastcc void @"count'2"(ptr %1)
  ret void
}

define fastcc void @"teardown()"(ptr %0) #0 {
  br label %2

2:                                                ; preds = %1
  ret void
}

declare preserve_nonecc i64 @__yana_stack_switch(ptr, ptr, i64)

declare void @__yana_stack_entry()

; Function Attrs: nocallback nofree nounwind willreturn memory(argmem: write)
declare void @llvm.memset.p0.i64(ptr writeonly captures(none), i8, i64, i1 immarg) #1

; Function Attrs: nocallback nofree nounwind willreturn memory(argmem: readwrite)
declare void @llvm.memcpy.p0.p0.i64(ptr noalias writeonly captures(none), ptr noalias readonly captures(none), i64, i1 immarg) #2

attributes #0 = { "probe-stack"="inline-asm" }
attributes #1 = { nocallback nofree nounwind willreturn memory(argmem: write) }
attributes #2 = { nocallback nofree nounwind willreturn memory(argmem: readwrite) }
