target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

module asm "\09.set \22image$base\22, 0"
module asm "\09.text"
module asm "\09.p2align 4"
module asm "\09.type __yana_stack_switch, @function"
module asm "__yana_stack_switch:"
module asm "\09pushq %rbp"
module asm "\09movq %rsp, (%r13)"
module asm "\09movq %r12, %rsp"
module asm "\09movq %r14, %rax"
module asm "\09popq %rbp"
module asm "\09popq %rcx"
module asm "\09jmpq *%rcx"
module asm "\09.size __yana_stack_switch, . - __yana_stack_switch"
module asm "\09.text"
module asm "\09.p2align 4"
module asm "\09.type __yana_stack_entry, @function"
module asm "__yana_stack_entry:"
module asm "\09popq %rdi"
module asm "\09popq %rsi"
module asm "\09popq %r11"
module asm "\09callq *%r11"
module asm "\09ud2"
module asm "\09.size __yana_stack_entry, . - __yana_stack_entry"

@"environment(newFiber(Counter))" = constant <{ i32 }> <{ i32 sub (i32 ptrtoint (ptr @"descriptor(Counter)" to i32), i32 ptrtoint (ptr @"image$base" to i32)) }>, align 8
@"descriptor(Counter)" = constant <{ [4 x i8], i32 }> <{ [4 x i8] c"(\00\00\1D", i32 sub (i32 ptrtoint (ptr @"teardown()" to i32), i32 ptrtoint (ptr @"image$base" to i32)) }>, align 8
@"image$base" = external constant [0 x i8], align 8

define fastcc void @"count'2"(ptr %self) #0 {
  br label %1

1:                                                ; preds = %0
  %2 = getelementptr i8, ptr %self, i64 24
  %3 = load i64, ptr %2, align 1
  br label %4

4:                                                ; preds = %19, %1
  %5 = phi i64 [ 1, %1 ], [ %20, %19 ]
  %6 = icmp sle i64 %5, %3
  %7 = zext i1 %6 to i32
  br i1 %6, label %9, label %8

8:                                                ; preds = %9, %4
  call fastcc void @finishOn(ptr %self, i64 0)
  unreachable

9:                                                ; preds = %4
  %10 = getelementptr i8, ptr %self, i64 8
  %11 = load ptr, ptr %10, align 1
  %12 = call preserve_nonecc i64 @__yana_stack_switch(ptr %11, ptr %self, i64 %5)
  %13 = getelementptr i8, ptr %self, i64 32
  %14 = load i64, ptr %13, align 1
  %15 = add i64 %14, %12
  store i64 %15, ptr %13, align 1
  %16 = sub i64 %3, %5
  %17 = icmp sge i64 %16, 1
  %18 = zext i1 %17 to i32
  br i1 %17, label %19, label %8

19:                                               ; preds = %9
  %20 = add i64 %5, 1
  br label %4
}

define fastcc i64 @main() #0 {
  %1 = alloca i8, i64 17, align 8
  %2 = alloca i8, i64 16, align 8
  %3 = alloca i8, i64 40, align 8
  br label %4

4:                                                ; preds = %0
  %5 = call i64 asm sideeffect "syscall", "={rax},{rax},{rdi},{rsi},{rdx},{r10},{r8},{r9},~{rcx},~{r11},~{memory},~{dirflag},~{fpsr},~{flags}"(i64 9, i64 0, i64 65536, i64 3, i64 34, i64 -1, i64 0)
  %6 = icmp slt i64 %5, 0
  %7 = zext i1 %6 to i32
  %8 = inttoptr i64 %5 to ptr
  %9 = select i1 %6, ptr null, ptr %8
  call void @llvm.memset.p0.i64(ptr align 1 %3, i8 0, i64 17, i1 false)
  %10 = getelementptr i8, ptr %3, i64 24
  store i64 5, ptr %10, align 1
  %11 = getelementptr i8, ptr %3, i64 32
  store i64 0, ptr %11, align 1
  store ptr @"funvalue(count'2)", ptr %2, align 1
  %12 = getelementptr i8, ptr %2, i64 8
  store i64 0, ptr %12, align 1
  call fastcc void @newFiber(ptr %1, ptr %9, i64 65536, ptr %3, ptr %2)
  call void @llvm.memcpy.p0.p0.i64(ptr align 1 %3, ptr align 1 %1, i64 17, i1 false)
  br label %13

13:                                               ; preds = %37, %4
  %14 = phi i64 [ 0, %4 ], [ %39, %37 ]
  %15 = phi i64 [ 0, %4 ], [ %31, %37 ]
  %16 = getelementptr i8, ptr %3, i64 16
  %17 = load i8, ptr %16, align 1
  %18 = zext i8 %17 to i32
  %19 = icmp eq i32 %18, 2
  %20 = zext i1 %19 to i32
  br i1 %19, label %21, label %30

21:                                               ; preds = %13
  %22 = ptrtoint ptr %9 to i64
  %23 = call i64 asm sideeffect "syscall", "={rax},{rax},{rdi},{rsi},~{rcx},~{r11},~{memory},~{dirflag},~{fpsr},~{flags}"(i64 11, i64 %22, i64 65536)
  %24 = mul i64 %14, 10000
  %25 = mul i64 %15, 100
  %26 = add i64 %24, %25
  %27 = getelementptr i8, ptr %3, i64 32
  %28 = load i64, ptr %27, align 1
  %29 = add i64 %26, %28
  ret i64 %29

30:                                               ; preds = %13
  %31 = add i64 %15, 1
  %32 = getelementptr i8, ptr %3, i64 16
  %33 = load i8, ptr %32, align 1
  %34 = zext i8 %33 to i32
  %35 = icmp eq i32 %34, 2
  %36 = zext i1 %35 to i32
  br i1 %35, label %44, label %40

37:                                               ; preds = %44, %40
  %38 = phi i64 [ %43, %40 ], [ 0, %44 ]
  %39 = add i64 %14, %38
  br label %13

40:                                               ; preds = %30
  store i8 1, ptr %32, align 1
  %41 = load ptr, ptr %3, align 1
  %42 = getelementptr i8, ptr %3, i64 8
  %43 = call preserve_nonecc i64 @__yana_stack_switch(ptr %41, ptr %42, i64 %31)
