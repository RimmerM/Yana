{-
   A materialized iterator - `lib/Fiber`'s `Cursor(a)`, and what
   `doc/inflight/Analysis-External-Iterators.md` §1.2 promises a consumer-driven producer does.

   Three claims, and the third is the one an internal `iter fn` cannot make:

    - a producer's ordinary locals survive a hand-over. `squares` counts in a `for` loop across five
      stack switches;
    - a yielded value may be **owned**. `words` hands over a `String` it built, and the consumer is
      what drops it;
    - **two producers can be stepped alternately.** `evens` and `odds` are both suspended at once and
      the consumer chooses which advances next, which is §1.4's whole distinction: an internal
      traversal can nest but the inner one has to finish before the outer continues.

   Written without `is` in a conjunction so that both resolve stages compile it - see AGENTS.md on
   the one place the rewritten stage is ahead. What is asserted is the one number `main` answers, so
   the two stages are held to the same result.
-}

import Native
import Fiber

fn squares(self: %Cursor(Size)):
    for i in 1..=5:
        Cursor.emit(self, i * i)

    Cursor.finish(self)

fn evens(self: %Cursor(Size)):
    for i in 0..4:
        Cursor.emit(self, i * 2)

    Cursor.finish(self)

fn odds(self: %Cursor(Size)):
    for i in 0..4:
        Cursor.emit(self, i * 2 + 1)

    Cursor.finish(self)

fn words(self: %Cursor(String)):
    for i in 1..=3:
        Cursor.emit(self, "w{i}")

    Cursor.finish(self)

fn main() -> Size:
    let bytes = 65536 :: Size

    -- One producer, run out.
    let &cursor = Cursor.new() :: Cursor(Size)
    cursor.open(bytes, squares)

    let &sum = 0 :: Size
    while cursor.next() is Just(v):
        sum += v

    cursor.close()

    -- Two, alternately.
    let &left = Cursor.new() :: Cursor(Size)
    let &right = Cursor.new() :: Cursor(Size)

    left.open(bytes, evens)
    right.open(bytes, odds)

    let &pairs = 0 :: Size
    while True:
        let a = left.next()
        if a is Nothing then break

        let b = right.next()
        if b is Nothing then break

        if a is Just(x):
            if b is Just(y):
                pairs += x * 10 + y

    left.close()
    right.close()

    -- And an owned hand-over.
    let &text = Cursor.new() :: Cursor(String)
    text.open(bytes, words)

    let &joined = "" :: String
    while text.next() is Just(w):
        joined = joined ++ copy(w) ++ "."

    text.close()

    -- One number for the three claims: the squares, the interleaved pairs, and the length of the
    -- string the owned hand-overs built.
    return sum * 100000 + pairs * 100 + length(joined)
