{-
   `fn f(...) -> iter(T)` - `doc/inflight/Analysis-External-Iterators.md` §2.1's external iterator,
   end to end.

   # resolver: ownership

   Only the rewritten stage implements the result type; the shipping one refuses it by name. Seven
   claims, packed into the one number `main` answers:

    - a `for` over a call runs a producer to its end, with an argument copied into it (`sum`);
    - two handles are stepped **alternately by hand** - §1.4's distinction, and the one thing an
      internal `iter fn` cannot do (`pairs`);
    - leaving a `for` early drops the handle it built, and the drop **cancels** the producer: its
      `Guard` is released on its own stack before the stack is given back (`firstTwo`, `trace`);
    - a handle that never ran still drops the owned argument it captured (`trace`);
    - a handle the author holds survives a `break`, and a second `for` carries on where the first
      stopped (`part`);
    - a lent `String` travels as its view, a lent temporary is kept by the handle, and owned
      values are handed over (`joined`);
    - a lent local is **borrowed by the handle**, exclusively or shared, for as long as the handle
      exists - so a producer may write through `&total`, and a `Guard` it only reads is dropped once,
      by its owner, after the handle is gone (`sum`, `trace`).
-}

import Native
import Fiber

let &trace = 0 :: Size

data Guard {id: Size}

instance Drop(Guard):
    fn drop(->value: Guard):
        trace = trace + value.id

fn squares(n: Size) -> iter(Size):
    for i in 1..=n:
        yield i * i

fn evens() -> iter(Size):
    for i in 0..4:
        yield i * 2

fn odds() -> iter(Size):
    for i in 0..4:
        yield i * 2 + 1

-- Suspended with a `Guard` live, and cancelled there.
fn guarded() -> iter(Size):
    let g = Guard {id: 7}

    for i in 0..10:
        yield i + g.id

-- An owned argument, released by the producer when it runs and by the handle when it never does.
fn holding(->g: Guard) -> iter(Size):
    yield g.id

-- A plain parameter, so the argument arrives as a view - or, for a temporary, as the owned string
-- the handle keeps until the producer is done lending it.
fn words(prefix: String) -> iter(->String):
    for i in 1..=3:
        yield "{prefix}{i}"

-- Lent exclusively: the producer writes through the loan the handle holds.
fn counting(&total: Size) -> iter(Size):
    for i in 1..=3:
        total = total + i
        yield total

-- Lent shared, and neither a view nor a copy: travels by address under the handle's loan.
fn watching(g: Guard) -> iter(Size):
    yield g.id
    yield g.id * 2

fn main() -> Size:
    let &sum = 0 :: Size
    for v in squares(5):
        sum += v

    let &left = evens()
    let &right = odds()
    let &pairs = 0 :: Size

    while True:
        let a = left.next()
        if a is Nothing then break

        let b = right.next()
        if b is Nothing then break

        if a is Just(x):
            if b is Just(y):
                pairs += x * 10 + y

    let &firstTwo = 0 :: Size
    for v in squares(100):
        firstTwo += v
        if v >= 4 then break

    for v in guarded():
        if v >= 7 then break

    let unused = holding(Guard {id: 100})

    for v in holding(Guard {id: 1000}):
        sum += 0

    let &c = squares(4)
    let &part = 0 :: Size

    for v in c:
        part += v
        if v == 4 then break

    for v in c:
        part += v * 10

    let &prefix = "w" :: String
    let &joined = "" :: String

    for w in words(prefix):
        joined = joined ++ w ++ "."

    -- A temporary, which outlives this statement only because the handle holds it.
    let tag = "x" :: String
    let &later = words("v" ++ tag)

    for w in words("z"):
        joined = joined ++ w ++ "."

    for w in later:
        joined = joined ++ w ++ "."

    let &total = 0 :: Size
    let &running = 0 :: Size

    for v in counting(total):
        running += v

    let g = Guard {id: 3}
    for v in watching(g):
        running += v

    sum += running + total

    -- Each claim in its own decimal field, least significant last.
    return ((((trace * 100 + length(joined)) * 1000 + part) * 100 + firstTwo) * 1000 + pairs) * 100 +
           sum
