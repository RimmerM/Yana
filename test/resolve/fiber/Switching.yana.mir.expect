fn fiberOf(self: %Counter [shared call shape6 .*=shared slot 0]) -> %Fiber [owned here shape6 .*=shared slot 0] {
  local & me: Counter [unique slot 0 owner]

bb0:
  %0: %Counter [owned here shape6 .*=shared slot 0] = read copy.trivial (self)
  %1: Counter [unique slot 0 owner] = read borrow.unique ([%%0]) loan0
  write.init borrow.unique (me) borrow.unique %1
  %3: Fiber [shared slot 0 owner] = read borrow.shared (me.fiber) loan1 roots{0}
  %4: %Fiber [owned here shape6 .*=shared slot 0] = address inspect %3 roots.0{0, 1}
  return take %4
}

