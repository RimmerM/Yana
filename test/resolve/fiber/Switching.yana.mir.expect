fn main() -> Size {
  local bytes: Size
  local stack: %U8
  local & state: Counter
  local local3: (%Counter) -> {} [owned here shape8 .0=unique call]
  local & sum: Size
  local & steps: Size

bb0:
  %0: Size = const 65536
  write.init borrow.unique (bytes) take %0
  %2: Size = const 65536
  %3: %U8 = call mapMemory borrow.shared %2
  write.init borrow.unique (stack) take %3
