{-
   What a handle's loans refuse - an external iterator borrows what it was lent for as long as the
   handle exists, the way a closure borrows what it captured.

   # resolver: ownership
-}

import Native
import Fiber

fn counting(&total: Size) -> iter(Size):
    total = total + 1
    yield total

fn reading(text: String) -> iter(Size):
    yield length(text)

-- Written while the handle that borrows it exclusively is still to be stepped.
fn writeWhileLent() -> Size:
    let &total = 0 :: Size
    let &c = counting(total)
    total = 5

    let &sum = 0 :: Size
    for v in c:
        sum += v

    return sum

-- Assigned while a handle that reads it is still live.
fn replaceWhileRead() -> Size:
    let &text = "abc" :: String
    let &c = reading(text)
    text = "d"

    let &sum = 0 :: Size
    for v in c:
        sum += v

    return sum

-- A handle over a local cannot leave the frame that lent it.
fn escapes() -> Iter(Size, {%Size}):
    let &total = 0 :: Size
    return counting(total)

fn apply(f: () -> Size) -> iter(Size):
    yield f()

fn grow(f: () -> {}) -> iter(Size):
    f()
    yield 1

-- An argument that refers to storage of its own: the handle keeps what the closure captured, so
-- writing it while the handle is still to be stepped is refused as writing a lent local is.
fn writeWhileCaptured() -> Size:
    let &x = 5 :: Size
    let &c = apply((): x + 1)
    x = 7

    let &sum = 0 :: Size
    for v in c:
        sum += v

    return sum

-- The same for a closure that writes what it captured, which the handle keeps borrowed exclusively.
-- A `String`, because copying a trivially copyable value out through an exclusive loan is allowed.
fn borrowWhileCapturedMut() -> Size:
    let &text = "ab" :: String
    let &c = grow((): text = "abc")
    let seen = length(text)

    let &sum = 0 :: Size
    for v in c:
        sum += v

    return sum + seen

-- And a handle holding such a closure cannot leave the frame whose local it captured.
fn escapesCaptured() -> Iter(Size, {() -> Size}):
    let &x = 5 :: Size
    return apply((): x + 1)

fn main() -> Size = writeWhileLent() + replaceWhileRead() + writeWhileCaptured() + borrowWhileCapturedMut()
