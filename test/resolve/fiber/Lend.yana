{-
   A producer that **lends** what it yields - `doc/inflight/Analysis-External-Iterators.md` §3.3.

   # resolver: ownership

   `-> iter(T)` at a `T` with a teardown hands the consumer a loan of a value that stays in the
   producer's frame, valid until the producer is resumed. Four claims, packed into the one number
   `main` answers:

    - a lent **temporary** lives in the producer's frame across the switch and is released there
      once the consumer resumes (`words`);
    - a lent **local** is shown twice and released once, by the frame that owns it (`guards`,
      `trace`);
    - a `for` over a held lending handle borrows each value from the handle (`ids`);
    - `next()` steps one by hand, each value dead before the next step (`n`).

   `Reject.Lend.yana` is the other half: what a lent value keeps the consumer from doing.
-}

import Native
import Fiber

let &trace = 0 :: Size

data Guard {id: Size}

instance Drop(Guard):
    fn drop(->value: Guard):
        trace = trace + value.id

fn words(prefix: String) -> iter(String):
    for i in 1..=3:
        yield "{prefix}{i}"

fn guards() -> iter(Guard):
    let g = Guard {id: 5}
    yield g
    yield g

fn main() -> Size:
    let &n = 0 :: Size
    for w in words("ab"):
        n += length(w)

    let &c = guards()
    let &ids = 0 :: Size
    for g in c:
        ids += g.id

    let &h = words("x")
    while True:
        let w = h.next()
        if w is Just(s):
            n += length(s)
        else:
            break

    -- Each claim in its own decimal field, least significant last.
    return (trace * 100 + ids) * 100 + n
