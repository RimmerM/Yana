fn heldOr(%m: Maybe(&Int), %fallback: Int) -> Int {
  b0:
    %v2 = load %m.discriminant : Int
    %v4 = cmp_eq %v2, 0 : Bool
    je %v4, b2, b1

  b1:
    %at = load %m@Just : &Int
    %at = load [%at] : Int
    jmp b3

  b2:
    jmp b3

  b3:
    %v10 = phi [b2, %fallback], [b1, %at] : Int
    ret %v10
}

fn pairValue(%p: Pair) -> Int {
  b0:
    %v1 = load %p@Pair.first : Maybe(Rank)
    %v2 = call tagOf, %v1 : Int
    %v5 = mul %v2, 10 : Int
    %v6 = load %p@Pair.second : Maybe(Rank)
    %v7 = call tagOf, %v6 : Int
    %v8 = add %v5, %v7 : Int
