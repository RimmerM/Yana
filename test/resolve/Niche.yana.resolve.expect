fn tagOf(%m: Maybe(Rank)) -> Int {
  b0:
    %v1 = load %m.discriminant : Int
    %v3 = cmp_eq %v1, 0 : Bool
    je %v3, b2, b1

  b1:
    %v6 = load %m.discriminant : Int
    %v8 = cmp_eq %v6, 1 : Bool
    je %v8, b4, b3

  b2:
    jmp b9

  b3:
    %v16 = load %m.discriminant : Int
    %v18 = cmp_eq %v16, 1 : Bool
    je %v18, b7, b6

  b4:
    %v10 = load %m@Just : Rank
    %v11 = cast %v10 : Int
    %v13 = cmp_eq %v11, 0 : Bool
    je %v13, b5, b3

  b5:
    jmp b9

  b6:
    %v26 = load %m@Just : Rank
    jmp b9

  b7:
    %v20 = load %m@Just : Rank
    %v21 = cast %v20 : Int
    %v23 = cmp_eq %v21, 1 : Bool
    je %v23, b8, b6

  b8:
    jmp b9

  b9:
    %v32 = phi [b2, 0], [b5, 1], [b8, 2], [b6, 3] : Int
    ret %v32
