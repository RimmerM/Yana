    %v10 = alloc : Maybe(Rank)
    init %local2.discriminant, 1
    init %local2@Just, More
    %c = call tagOf, %v10 : Int
    %v18 = mul %b, 10 : Int
    %v19 = add %a, %v18 : Int
    %v22 = mul %c, 100 : Int
    %v23 = add %v19, %v22 : Int
