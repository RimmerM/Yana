  b3:
    %v16 = load %m@Just : Maybe(Rank)
    %o = load %m@Just@Just : Rank
    %v19 = alloc : Maybe(Rank)
    init %local1.discriminant, 1
    init %local1@Just, %o
    %v23 = call tagOf, %v19 : Int
    %v25 = add 300, %v23 : Int
    jmp b6

  b4:
    %v10 = load %m@Just : Maybe(Rank)
    %v11 = load %m@Just.discriminant : Int
    %v13 = cmp_eq %v11, 0 : Bool
    je %v13, b5, b3

  b5:
