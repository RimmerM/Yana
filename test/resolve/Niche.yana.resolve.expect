fn roundTrip() -> Int {
  b0:
    %v0 = alloc : Maybe(Rank)
    init %local0.discriminant, 0
    %a = call tagOf, %v0 : Int
    %v4 = alloc : Maybe(Rank)
    init %local1.discriminant, 1
    init %local1@Just, Less
