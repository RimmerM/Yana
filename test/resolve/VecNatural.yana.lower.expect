@image$base = []

main<complex>(): I32 {
  b_0 {
    %v_1 = vsplat 3: i32x4
    %v_2 = vreduce_add %v_1: I32
    %v_3 = cmp_neq %v_2, 12: I32
    je %v_3, b_4, b_5
  }

  b_5 {
    %v_6 = add %v_1, %v_1: i32x4
    %v_7 = vreduce_add %v_6: I32
    %v_8 = cmp_neq %v_7, 24: I32
    %v_9 = select %v_8, 3, 102: I32
    ret %v_9
  }

  b_4 {
    ret 2
  }
}

