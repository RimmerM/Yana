combined<complex>(%v_0: Ptr) {
  b_1 {
    %v_2 = alloca 8, 8: Ptr
    store %v_2, 64, 8
    %v_3 = alloca 8, 8: Ptr
    store %v_3, 512, 8
    %v_4 = alloca 8, 8: Ptr
    call_complex OpenFlags.or, %v_4, %v_2, %v_3
    copy %v_0, %v_4, 8
