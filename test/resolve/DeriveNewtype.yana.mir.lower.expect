}

anySet<complex>(%flags: Ptr): I32 {
  b_0 {
    %v_1 = alloca 8, 8: Ptr
    copy %v_1, %flags, 8
    %v_2 = call_complex OpenFlags.truthy, %v_1: I32
    je %v_2, b_3, b_4
  }

  b_4 {
    jmp b_5
  }

  b_5 {
    %v_6 = phi [b_4, 0], [b_3, 1]: I32
    ret %v_6
  }

  b_3 {
    jmp b_5
  }
}

