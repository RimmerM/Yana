main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 8, 8: Ptr
    %v_2 = alloca 8, 8: Ptr
    %v_3 = alloca 8, 8: Ptr
    call_complex combined, %v_3
    copy %v_1, %v_3, 8
    %v_4 = alloca 8, 8: Ptr
    copy %v_4, %v_1, 8
    %v_5 = call_complex anySet, %v_4: I32
    %v_6 = xor %v_5, 1: I32
    je %v_6, b_7, b_8
  }

  b_8 {
    jmp b_9
  }

  b_9 {
    %v_10 = alloca 4, 4: Ptr
    store %v_10, 3, 4
    %v_11 = alloca 4, 4: Ptr
    store %v_11, 3, 4
    %v_12 = call_complex sameHandle, %v_10, %v_11: I32
    %v_13 = xor %v_12, 1: I32
    je %v_13, b_14, b_15
  }

  b_7 {
    ret 1
  }

  b_15 {
    jmp b_16
  }

  b_16 {
    %v_17 = alloca 4, 4: Ptr
    store %v_17, 3, 4
    %v_18 = alloca 4, 4: Ptr
    store %v_18, 4, 4
    %v_19 = call_complex differentHandle, %v_17, %v_18: I32
    %v_20 = xor %v_19, 1: I32
    je %v_20, b_21, b_22
  }

  b_14 {
    ret 2
  }

  b_22 {
    jmp b_23
  }

  b_23 {
    %v_24 = alloca 4, 4: Ptr
    store %v_24, 9, 4
    %v_25 = alloca 4, 4: Ptr
    store %v_25, 2, 4
    %v_26 = call_complex higher, %v_24, %v_25: I32
    %v_27 = xor %v_26, 1: I32
    je %v_27, b_28, b_29
  }

  b_21 {
    ret 3
  }

  b_29 {
    jmp b_30
  }

  b_30 {
    %v_31 = loads %v_1, 8: I64
    store %v_2, %v_31, 8
    %v_32 = loads %v_2, 8: I64
    %v_33 = sext %v_32: I32
    jmp b_34
  }

  b_28 {
    ret 4
  }

  b_34 {
    %v_35 = phi [b_30, %v_33]: I32
    ret %v_35
  }
}

I32.compare<complex>(%lhs: I32, %rhs: I32): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    %v_2 = alloca 4, 4: Ptr
    store %v_1, %lhs, 4
    store %v_2, %rhs, 4
    %v_3 = loads %v_1, 4: I32
    %v_4 = loads %v_2, 4: I32
    %v_5 = cmp_ilt %v_3, %v_4: I32
    je %v_5, b_6, b_7
  }

  b_6 {
    ret 0
  }

  b_7 {
    %v_8 = loads %v_1, 4: I32
    %v_9 = loads %v_2, 4: I32
    %v_10 = cmp_eq %v_8, %v_9: I32
    je %v_10, b_11, b_12
  }

  b_11 {
    ret 1
  }

  b_12 {
    ret 2
  }
}

