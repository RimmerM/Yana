
OpenFlags.or<complex>(%v_0: Ptr, %lhs: Ptr, %rhs: Ptr) {
  b_1 {
    %v_2 = loads %lhs, 8: I64
    %v_3 = loads %rhs, 8: I64
    %v_4 = or %v_2, %v_3: I64
    %v_5 = alloca 8, 8: Ptr
    store %v_5, %v_4, 8
    copy %v_0, %v_5, 8
    ret 
  }
}

OpenFlags.truthy<complex>(%value: Ptr): I32 {
  b_0 {
    %v_1 = loads %value, 8: I64
    %v_2 = cmp_neq %v_1, 0: I32
    ret %v_2
  }
}

Handle.==<complex>(%lhs: Ptr, %rhs: Ptr): I32 {
  b_0 {
    %v_1 = loads %lhs, 4: I32
    %v_2 = loads %rhs, 4: I32
    %v_3 = cmp_eq %v_1, %v_2: I32
