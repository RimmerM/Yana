fn capturingBig() -> I32 {
  local base: I32
  local spread: capturingBig.lambda.env
  local got: Big

bb0:
  %0: I32 = const 100
  write.init borrow.unique (base) take %0
  %2: I32 = const 100
  %3: capturingBig.lambda.env = aggregate.capturingBig.lambda.env take %2
