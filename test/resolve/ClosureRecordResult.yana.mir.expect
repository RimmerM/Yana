  %6: I32 = const 3
  %7: Big = call borrow.shared %5 borrow.shared %6
  write.init borrow.unique (got) take %7
  %9: I32 = read copy.trivial (got.a)
  %10: I32 = read copy.trivial (got.e)
  %11: I32 = sub inspect %9 inspect %10
  %12: I32 = read copy.trivial (got.c)
  %13: I32 = add inspect %11 inspect %12
