  %3: I32 = const 3
  %4: Cell = aggregate.Cell take %3
  %5: I32 = const 4
  %6: Cell = aggregate.Cell take %5
  %7: Cell = call borrow.shared %2 borrow.shared %4 borrow.shared %6
  write.init borrow.unique (local1) take %7
  %9: I32 = read copy.trivial (local1.value)
  return take %9
}

fn viaBig() -> I32 {
