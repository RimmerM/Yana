mut @live = [0, 0, 0, 0]
mut @trace = [0, 0, 0, 0]
@string = [97, 98, 99, 100, 101, 102]
@runBorrowed = [0, 0, 0, 0]
@runFromHeap = [1, 0, 0, 0]
mut @heapFree = [0, 0, 0, 0, 0, 0, 0, 0]

Held.drop<complex>(%self: Ptr) {
  b_0 {
    %v_1 = load %self, 4: I32
    %v_2 = loads @live, 4: I32
    %v_3 = sub %v_2, 1: I32
    store @live, %v_3, 4
    %v_4 = loads @trace, 4: I32
    %v_5 = imul %v_4, 10: I32
    %v_6 = add %v_5, %v_1: I32
    store @trace, %v_6, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    %v_2 = loads @live, 4: I32
    %v_3 = add %v_2, 1: I32
    store @live, %v_3, 4
    store %v_1, 4, 4
    call_complex Held.drop, %v_1
    %v_4 = load @runBorrowed, 4: I32
    %v_5 = and %v_4, 3: I32
    %v_6 = alloca 16, 8: Ptr
    store %v_6, @string, 8
    %v_7 = add %v_6, 8: Ptr
    %v_8 = load %v_7, 4: I64
    %v_9 = cast %v_5: I64
    %v_10 = shl %v_9, 30: I64
    %v_11 = or 6, %v_10: I64
    store %v_7, %v_11, 4
    %v_12 = add %v_6, 12: Ptr
    store %v_12, 6, 4
    %v_13 = load %v_6, 8: Ptr
    call_complex String.reclaim, %v_6
    %v_14 = loads @live, 4: I32
    %v_15 = imul %v_14, 1000: I32
    %v_16 = add 271, %v_15: I32
    %v_17 = loads @trace, 4: I32
    %v_18 = add %v_16, %v_17: I32
    ret %v_18
  }
}

String.reclaim<complex>(%value: Ptr) {
  b_0 {
    %v_1 = load %value, 8: Ptr
    %v_2 = add %value, 8: Ptr
    %v_3 = load %v_2, 4: I64
    %v_4 = add %value, 12: Ptr
    %v_5 = load %v_4, 4: I32
    %v_6 = shr %v_3, 30: I64
    %v_7 = cast %v_6: I32
    %v_8 = load @runFromHeap, 4: I32
    %v_9 = cmp_eq %v_7, %v_8: I32
    je %v_9, b_10, b_11
  }

  b_10 {
    call_complex freeHeap, %v_1
    jmp b_11
  }

  b_11 {
    ret 
  }
}

Array(a).reclaim(CodeUnit)<complex>(%value: Ptr) {
  b_0 {
    %v_1 = load %value, 8: Ptr
    %v_2 = add %value, 8: Ptr
    %v_3 = load %v_2, 4: I64
    %v_4 = add %value, 12: Ptr
