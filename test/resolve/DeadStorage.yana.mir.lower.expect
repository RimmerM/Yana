    %v_14 = add %v_8, 12: Ptr
    store %v_14, 6, 4
    %v_15 = load %v_8, 8: Ptr
    call_complex String.reclaim, %v_8
    %v_16 = add 10, %v_5: I32
    %v_17 = add %v_16, 34: I32
    %v_18 = add %v_17, 106: I32
    %v_19 = add %v_18, 6: I32
    %v_20 = add %v_19, 8: I32
