freeHeap<complex>(%allocation: Ptr) {
  b_0 {
    %v_1 = bitcast %allocation: I64
    %v_2 = cmp_eq %v_1, 0: I32
    je %v_2, b_3, b_4
  }

  b_4 {
    %v_5 = sub %allocation, 8: Ptr
    %v_6 = loads %v_5, 8: I64
    %v_7 = load @heapFree, 8: Ptr
    %v_8 = shl %v_6, 3: I64
    %v_9 = add %v_7, %v_8: Ptr
    %v_10 = load %v_9, 8: Ptr
    store %allocation, %v_10, 8
    %v_11 = load @heapFree, 8: Ptr
    %v_12 = add %v_11, %v_8: Ptr
    store %v_12, %allocation, 8
    ret 
  }

  b_3 {
    ret 
  }
}

Run(a).reclaim(CodeUnit)<complex>(%value: Ptr) {
  b_0 {
    %v_1 = load %value, 8: Ptr
    %v_2 = add %value, 8: Ptr
    %v_3 = load %v_2, 4: I64
    %v_4 = shr %v_3, 30: I64
    %v_5 = cast %v_4: I32
    %v_6 = load @runFromHeap, 4: I32
    %v_7 = cmp_eq %v_5, %v_6: I32
    je %v_7, b_8, b_9
  }

  b_8 {
    call_complex freeHeap, %v_1
    jmp b_9
