mut @live = [0, 0, 0, 0]
mut @trace = [0, 0, 0, 0]

bump<complex>(%v: Ptr) {
  b_0 {
    %v_1 = loads %v, 4: I32
    %v_2 = add %v_1, 100: I32
    store %v, %v_2, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = loads @live, 4: I32
    %v_2 = add %v_1, 1: I32
    store @live, %v_2, 4
    %v_3 = sub %v_2, 1: I32
    store @live, %v_3, 4
    %v_4 = loads @trace, 4: I32
    %v_5 = imul %v_4, 10: I32
    %v_6 = add %v_5, 4: I32
    store @trace, %v_6, 4
    %v_7 = alloca 4, 4: Ptr
    store %v_7, 7, 4
    call_complex bump, %v_7
    %v_8 = loads %v_7, 4: I32
    %v_9 = add %v_8, 164: I32
    %v_10 = loads @live, 4: I32
    %v_11 = imul %v_10, 1000: I32
    %v_12 = add %v_9, %v_11: I32
    %v_13 = loads @trace, 4: I32
    %v_14 = add %v_12, %v_13: I32
    ret %v_14
  }
}

