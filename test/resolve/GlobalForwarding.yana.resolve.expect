let image$base: () = <none>

let &counter: I32 = 1

let &pair: Pair = Pair(1, 2)

let &kept: I32 = 0

let &untouched: I32 = 0

let &cell: Cell = <startup>

fn aim(%p: %I32) -> () {
  b0:
    assign cell@Cell.p, %p
    ret
}

fn main() -> I32 {
  b0:
    assign counter, 2
    assign untouched, 3
    %v4 = load counter : I32
    %p = addressof counter : %I32
    assign [%p], 5
    %v9 = load counter : I32
    %v10 = load untouched : I32
    %a = add %v9, %v10 : I32
    assign pair@Pair.right, 20
    %v15 = load pair@Pair.right : I32
    %q = addressof pair@Pair.right : %I32
    assign [%q], 40
    %v21 = load pair@Pair.left : I32
    %v23 = load pair@Pair.right : I32
    %b = add %v21, %v23 : I32
    %v25 = load kept : I32
    %v26 = addressof kept : %I32
    call aim, %v26
    assign kept, 7
    %v30 = load untouched : I32
    %v33 = add %v30, 1 : I32
    assign untouched, %v33
    %v36 = load cell@Cell.p : %I32
    assign [%v36], 70
    %v40 = load kept : I32
    %v41 = load untouched : I32
    %c = add %v40, %v41 : I32
    %v45 = mul %a, 10000 : I32
    %v48 = mul %b, 100 : I32
    %v49 = add %v45, %v48 : I32
    %v50 = add %v49, %c : I32
    ret %v50
}

fn main$() -> I32 {
  b0:
    %v0 = alloc : Cell
    %v1 = load kept : I32
    %v2 = addressof kept : %I32
    aggregate %local0@Cell.p = %v2
    init cell, %v0
    %v5 = call main : I32
    ret %v5
}
