fn unwrap(m: Maybe(I32) [shared call]) -> I32 {
  local v: I32

bb0:
  %0: U8 = read copy.trivial (m.#)
  %1: U8 = const 1
  %2: Bool = eq inspect %0 inspect %1
  branch inspect %2 -> bb3 -> bb1

bb1:
  %7: I32 = const 0
  jump -> bb2(take %7)

bb2(%8: I32):
  return take %8

bb3:
  %4: I32 = read copy.trivial (m.Just)
  write.init borrow.unique (v) take %4
  %6: I32 = read copy.trivial (v)
  jump -> bb2(take %6)
}

fn unwrapOk(r: Result(I32, I32) [shared call]) -> I32 {
