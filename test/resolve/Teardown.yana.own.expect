fn initHeap {
}

fn heapClassOf {
  arg total readonly
  %size: I64 writable live [0, 8) [10, 18)
  %sizeClass: I64 writable live [2, 9) [10, 18)
}

fn heapBlockSize {
  arg sizeClass readonly
}

fn freeListHead {
  arg sizeClass readonly
  result escapes
}

fn setFreeListHead {
  arg sizeClass readonly
  arg block readonly
}

fn allocateHeap {
  arg size readonly
  result escapes
}

fn freeHeap {
  arg allocation readonly
}

fn mapMemory {
  arg size readonly
}

fn makeBuffer {
  arg count readonly
  result escapes
  %local0: Buffer droppable readonly live [4, 8)
}

fn useSession {
  arg s readonly
  %s: Session droppable readonly live [0, 2)
}

fn main {
  %local0: Session droppable readonly live [0, 7)
  %local1: Buffer droppable readonly live [1, 5)
  %local2: Handle droppable readonly live [2, 6)
  %local3: Session droppable readonly live [7, 10)
  %local4: {left: Int, right: Int} readonly live [11, 13)
}

fn Reclaim(Buffer).reclaim {
  arg value readonly
  %value: Buffer borrowed droppable readonly live [0, 4)
}

fn Drop(Handle).drop {
  arg value readonly
  %value: Handle borrowed droppable readonly live [0, 2)
}

fn duplicate(Int) {
  arg x readonly
  %x: Int readonly live [0, 4)
  %x: Int readonly live [2, 6)
  %x: Int readonly live [3, 7)
  %local3: {left: Int, right: Int} readonly live [4, 8)
}

fn drop$Session {
  arg value readonly
}

fn reclaim$Session {
  arg value readonly
