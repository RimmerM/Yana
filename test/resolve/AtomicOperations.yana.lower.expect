@image$base = []

main<complex>(): I32 {
  b_0 {
    %state = alloca 1, 1: Ptr
    store %state, 0, 1
    %v_1, %v_2 = atomic_cas %state, 0, 1, 1, acquire, acquire: I32, I32
    je %v_2, b_3, b_4
  }

  b_4 {
    %v_5 = alloca 1, 1: Ptr
    store %v_5, %v_1, 1
    jmp b_6
  }

  b_3 {
    %v_7 = alloca 1, 1: Ptr
    store %v_7, 3, 1
    jmp b_6
  }

  b_6 {
    %v_8 = phi [b_3, %v_7], [b_4, %v_5]: Ptr
    %v_9 = load %v_8, 1: I64
    %v_10 = cmp_le %v_9, 2: I32
    %v_11 = cmp_eq %v_10, 0: I32
    %actual = load %v_8, 1: I32
    %v_12 = select %v_11, 1, %actual: I32
    %v_13 = shr 2, %v_12: I32
    %locked = and %v_13, 1: I32
    %byte = alloca 1, 1: Ptr
    store %byte, 1, 1
    %half = alloca 2, 2: Ptr
    store %half, 2, 2
    %word = alloca 4, 4: Ptr
    store %word, 3, 4
    %long = alloca 8, 8: Ptr
    store %long, 4, 8
    %flag = alloca 1, 1: Ptr
    store %flag, 1, 1
    atomic_store %byte, 9, 1, release
    atomic_store %half, 9, 2, release
    atomic_store %word, 9, 4, release
    atomic_store %flag, 0, 1, release
    %v_14 = atomic_add %long, 1, 8, relaxed: I64
    %v_15 = cmp_igt %v_14, 0: I32
    %byte = alloca 1, 1: Ptr
    store %byte, 250, 1
    %half = alloca 2, 2: Ptr
    store %half, 1000, 2
    %v_16 = atomic_sub %byte, 10, 1, relaxed: I32
    %a = and %v_16, 255: I32
    %v_17 = atomic_xor %half, 61680, 2, acquire: I32
    %b = and %v_17, 65535: I32
    %v_18 = cast %a: I64
    %v_19 = cast %b: I64
    %v_20 = add %v_18, %v_19: I64
    %v_21 = cmp_igt %v_20, 0: I32
    %c = alloca 4, 4: Ptr
    store %c, 0, 4
    atomic_store %c, 7, 4, release
    %seen = atomic_loads %c, 4, acquire: I32
    %previous = atomic_xchg %c, 9, 4, acq_rel: I32
    %v_22 = add %seen, %previous: I32
    %v_23 = load %c, 4: I32
    %v_24 = add %v_22, %v_23: I32
    %c = alloca 4, 4: Ptr
    store %c, 1, 4
    %a = atomic_add %c, 4, 4, relaxed: I32
    %s = atomic_sub %c, 2, 4, acquire: I32
    %n = atomic_and %c, 255, 4, release: I32
    %o = atomic_or %c, 16, 4, acq_rel: I32
    %x = atomic_xor %c, 1, 4, seq_cst: I32
    %v_25 = add %a, %s: I32
    %v_26 = add %v_25, %n: I32
    %v_27 = add %v_26, %o: I32
    %v_28 = add %v_27, %x: I32
    %v_29 = add %v_24, %v_28: I32
    %c = alloca 4, 4: Ptr
    store %c, 5, 4
    %v_30, %v_31 = atomic_cas %c, 5, 6, 4, acq_rel, acquire: I32, I32
    je %v_31, b_32, b_33
  }

  b_33 {
    %v_34 = alloca 8, 4: Ptr
    store %v_34, 1, 4
    %v_35 = add %v_34, 4: Ptr
    store %v_35, %v_30, 4
    jmp b_36
  }

  b_32 {
    %v_37 = alloca 8, 4: Ptr
    store %v_37, 0, 4
    jmp b_36
  }

  b_36 {
    %v_38 = phi [b_32, %v_37], [b_33, %v_34]: Ptr
    %v_39 = loads %v_38, 4: I32
    %v_40 = cmp_eq %v_39, 0: I32
    %v_41 = add %v_38, 4: Ptr
    %actual = loads %v_41, 4: I32
    %v_42 = select %v_40, 1, %actual: I32
    %v_43 = add %v_29, %v_42: I32
    %c = alloca 4, 4: Ptr
    store %c, 0, 4
    %v_44, %v_45 = atomic_cas_weak %c, 0, 1, 4, release, relaxed: I32, I32
    %v_46, %v_47 = atomic_cas %c, 1, 2, 4, seq_cst, acquire: I32, I32
    je %v_47, b_48, b_49
  }

  b_49 {
    %v_50 = alloca 8, 4: Ptr
    store %v_50, 1, 4
    %v_51 = add %v_50, 4: Ptr
    store %v_51, %v_46, 4
    jmp b_52
  }

  b_48 {
    %v_53 = alloca 8, 4: Ptr
    store %v_53, 0, 4
    jmp b_52
  }

  b_52 {
    %v_54 = phi [b_48, %v_53], [b_49, %v_50]: Ptr
    %v_55 = loads %v_54, 4: I32
    %v_56 = cmp_eq %v_55, 0: I32
    %v_57 = add %v_54, 4: Ptr
    %actual = loads %v_57, 4: I32
    %v_58 = select %v_56, 2, %actual: I32
    %v_59 = add %v_43, %v_58: I32
    %c = alloca 4, 4: Ptr
    store %c, 0, 4
    atomic_store %c, 1, 4, relaxed
    fence release
    spinhint 
    %v_60 = atomic_loads %c, 4, relaxed: I32
    %v_61 = add %v_59, %v_60: I32
    %v_62 = add %v_61, %locked: I32
    %v_63 = add %v_62, %v_15: I32
    %v_64 = add %v_63, %v_21: I32
    ret %v_64
  }
}

