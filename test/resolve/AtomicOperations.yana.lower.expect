@image$base = []

main<complex>(): I32 {
  b_0 {
    %state = alloca 1, 1: Ptr
    store %state, 0, 1
    %v_1, %v_2 = atomic_cas %state, 0, 1, 1, acquire, acquire: I32, I32
    je %v_2, b_3, b_4
  }

  b_4 {
    %v_5 = alloca 1, 1: Ptr
    store %v_5, %v_1, 1
    jmp b_6
  }

  b_3 {
    %v_7 = alloca 1, 1: Ptr
    store %v_7, 3, 1
    jmp b_6
  }

  b_6 {
    %v_8 = phi [b_3, %v_7], [b_4, %v_5]: Ptr
    %v_9 = load %v_8, 1: I64
    %v_10 = cmp_le %v_9, 2: I32
    %v_11 = cmp_eq %v_10, 0: I32
    %actual = load %v_8, 1: I32
    %v_12 = select %v_11, 1, %actual: I32
    %v_13 = shr 2, %v_12: I32
    %locked = and %v_13, 1: I32
    %byte = alloca 1, 1: Ptr
    store %byte, 1, 1
    %half = alloca 2, 2: Ptr
    store %half, 2, 2
    %word = alloca 4, 4: Ptr
    store %word, 3, 4
    %long = alloca 8, 8: Ptr
    store %long, 4, 8
    %flag = alloca 1, 1: Ptr
    store %flag, 1, 1
    atomic_store %byte, 9, 1, release
    atomic_store %half, 9, 2, release
    atomic_store %word, 9, 4, release
    atomic_store %flag, 0, 1, release
    %v_14 = atomic_add %long, 1, 8, relaxed: I64
    %v_15 = cmp_igt %v_14, 0: I32
    %byte = alloca 1, 1: Ptr
    store %byte, 250, 1
    %half = alloca 2, 2: Ptr
    store %half, 1000, 2
    %v_16 = atomic_sub %byte, 10, 1, relaxed: I32
    %a = and %v_16, 255: I32
    %v_17 = atomic_xor %half, 61680, 2, acquire: I32
    %b = and %v_17, 65535: I32
    %v_18 = cast %a: I64
    %v_19 = cast %b: I64
    %v_20 = add %v_18, %v_19: I64
    %v_21 = cmp_igt %v_20, 0: I32
    %c = alloca 4, 4: Ptr
    store %c, 0, 4
    atomic_store %c, 7, 4, release
    %seen = atomic_loads %c, 4, acquire: I32
    %previous = atomic_xchg %c, 9, 4, acq_rel: I32
    %v_22 = add %seen, %previous: I32
    %v_23 = alloca 4, 4: Ptr
    copy %v_23, %c, 4
    %v_24 = loads %v_23, 4: I32
    %v_25 = add %v_22, %v_24: I32
    %c = alloca 4, 4: Ptr
    store %c, 1, 4
    %a = atomic_add %c, 4, 4, relaxed: I32
    %s = atomic_sub %c, 2, 4, acquire: I32
    %n = atomic_and %c, 255, 4, release: I32
    %o = atomic_or %c, 16, 4, acq_rel: I32
    %x = atomic_xor %c, 1, 4, seq_cst: I32
    %v_26 = add %a, %s: I32
    %v_27 = add %v_26, %n: I32
    %v_28 = add %v_27, %o: I32
    %v_29 = add %v_28, %x: I32
    %v_30 = add %v_25, %v_29: I32
    %c = alloca 4, 4: Ptr
    store %c, 5, 4
    %v_31, %v_32 = atomic_cas %c, 5, 6, 4, acq_rel, acquire: I32, I32
    je %v_32, b_33, b_34
  }

  b_34 {
    %v_35 = alloca 8, 4: Ptr
    store %v_35, 1, 4
    %v_36 = add %v_35, 4: Ptr
    store %v_36, %v_31, 4
    jmp b_37
  }

  b_33 {
    %v_38 = alloca 8, 4: Ptr
    store %v_38, 0, 4
    jmp b_37
  }

  b_37 {
    %v_39 = phi [b_33, %v_38], [b_34, %v_35]: Ptr
    %v_40 = loads %v_39, 4: I32
    %v_41 = cmp_eq %v_40, 0: I32
    %v_42 = add %v_39, 4: Ptr
    %actual = loads %v_42, 4: I32
    %v_43 = select %v_41, 1, %actual: I32
    %v_44 = add %v_30, %v_43: I32
    %c = alloca 4, 4: Ptr
    store %c, 0, 4
    %v_45, %v_46 = atomic_cas_weak %c, 0, 1, 4, release, relaxed: I32, I32
    %v_47, %v_48 = atomic_cas %c, 1, 2, 4, seq_cst, acquire: I32, I32
    je %v_48, b_49, b_50
  }

  b_50 {
    %v_51 = alloca 8, 4: Ptr
    store %v_51, 1, 4
    %v_52 = add %v_51, 4: Ptr
    store %v_52, %v_47, 4
    jmp b_53
  }

  b_49 {
    %v_54 = alloca 8, 4: Ptr
    store %v_54, 0, 4
    jmp b_53
  }

  b_53 {
    %v_55 = phi [b_49, %v_54], [b_50, %v_51]: Ptr
    %v_56 = loads %v_55, 4: I32
    %v_57 = cmp_eq %v_56, 0: I32
    %v_58 = add %v_55, 4: Ptr
    %actual = loads %v_58, 4: I32
    %v_59 = select %v_57, 2, %actual: I32
    %v_60 = add %v_44, %v_59: I32
    %c = alloca 4, 4: Ptr
    store %c, 0, 4
    atomic_store %c, 1, 4, relaxed
    fence release
    spinhint 
    %v_61 = atomic_loads %c, 4, relaxed: I32
    %v_62 = add %v_60, %v_61: I32
    %v_63 = add %v_62, %locked: I32
    %v_64 = add %v_63, %v_15: I32
    %v_65 = add %v_64, %v_21: I32
    ret %v_65
  }
}

