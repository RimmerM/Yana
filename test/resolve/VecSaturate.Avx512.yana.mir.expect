fn refClamp(value: I64 [shared call], lo: I64 [shared call], hi: I64 [shared call]) -> I64 {
bb0:
  %0: I64 = read copy.trivial (value)
  %1: I64 = read copy.trivial (lo)
  %2: Bool = lt inspect %0 inspect %1
  branch inspect %2 -> bb3 -> bb1

bb1:
  %5: I64 = read copy.trivial (value)
  %6: I64 = read copy.trivial (hi)
  %7: Bool = gt inspect %5 inspect %6
  branch inspect %7 -> bb6 -> bb4

bb2(%14: I64):
  return take %14

bb3:
  %4: I64 = read copy.trivial (lo)
  jump -> bb2(take %4)

bb4:
  %10: I64 = read copy.trivial (value)
  jump -> bb5(take %10)

bb5(%11: I64):
  jump -> bb2(take %11)

bb6:
  %9: I64 = read copy.trivial (hi)
  jump -> bb5(take %9)
}

fn refAdd(a: I64 [shared call], b: I64 [shared call], lo: I64 [shared call], hi: I64 [shared call]) -> I64 {
bb0:
  %0: I64 = read copy.trivial (a)
  %1: I64 = read copy.trivial (b)
  %2: I64 = add inspect %0 inspect %1
  %3: I64 = read copy.trivial (lo)
  %4: I64 = read copy.trivial (hi)
  %5: I64 = call refClamp borrow.shared %2 borrow.shared %3 borrow.shared %4
  return take %5
}

fn refSub(a: I64 [shared call], b: I64 [shared call], lo: I64 [shared call], hi: I64 [shared call]) -> I64 {
bb0:
  %0: I64 = read copy.trivial (a)
  %1: I64 = read copy.trivial (b)
  %2: I64 = sub inspect %0 inspect %1
  %3: I64 = read copy.trivial (lo)
  %4: I64 = read copy.trivial (hi)
  %5: I64 = call refClamp borrow.shared %2 borrow.shared %3 borrow.shared %4
  return take %5
}

