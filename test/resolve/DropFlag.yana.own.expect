fn +=(I32) {
  arg target writable
  arg amount readonly
  %target: I32 borrowed writable live [0, 3)
  %amount: I32 borrowed readonly live [0, 2)
  %local2: I32 readonly live [1, 3)
}

fn numberOf {
  arg call readonly
}

fn mapMemory {
  arg size readonly
}

fn initHeap {
}

fn growHeap {
  arg needed readonly
  %size: Size writable live [1, 27) [28, 38) [39, 51)
  %region: %U8 writable live [12, 27) [28, 38) [39, 48)
}

fn heapClassOf {
  arg total readonly
  %size: Size writable live [0, 8) [10, 18)
  %sizeClass: Size writable live [2, 9) [10, 18)
}

fn heapBlockSize {
  arg sizeClass readonly
}

fn freeListHead {
  arg sizeClass readonly
  result escapes
}

fn setFreeListHead {
  arg sizeClass readonly
  arg block readonly
}

fn allocateHeap {
  arg size readonly
  result escapes
}

fn freeHeap {
  arg allocation readonly
}

fn guard {
  arg id readonly
  %local0: Guard droppable readonly live [3, 6)
}

fn consume {
  arg g readonly
  %g: Guard droppable readonly live [0, 1)
}

fn replaced {
  arg c readonly
  %local0: Guard droppable readonly live [1, 4)
  %g: Guard droppable writable live [2, 12)
  %local2: Guard droppable readonly live [10, 12)
}

fn maybeReplaced {
  arg c readonly
  arg d readonly
  %local0: Guard droppable readonly live [1, 4)
  %g: Guard droppable writable live [2, 13)
  %local2: Guard droppable readonly live [11, 13)
}

fn nested {
  arg c readonly
  arg d readonly
  %local0: Guard droppable readonly live [1, 4)
  %g: Guard droppable writable live [2, 15)
  %local2: Guard droppable readonly live [13, 15)
}

fn pair {
  arg c readonly
  %local0: Guard droppable readonly live [1, 4)
  %x: Guard droppable writable live [2, 18)
  %local2: Guard droppable readonly live [4, 7)
  %y: Guard droppable writable live [5, 20)
  %local4: Guard droppable readonly live [16, 18)
  %local5: Guard droppable readonly live [18, 20)
}

fn heaped {
  arg c readonly
  arg d readonly
  %local0: Guard droppable readonly live [1, 4)
  %g: Guard droppable writable heap live [2, 13)
  %local2: Guard droppable readonly live [11, 13)
}

fn main {
  %result: I32 writable live [0, 9) [10, 18) [19, 27) [28, 36) [37, 45) [46, 54) [55, 63) [64, 72) [73, 81) [82, 90) [91, 99) [100, 108) [109, 117) [118, 126) [127, 132) [133, 135)
}

fn Drop(Guard).drop {
  arg self readonly
  %self: Guard borrowed droppable readonly live never
}
