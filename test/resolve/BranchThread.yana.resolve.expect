let image$base: () = <none>

fn firstOver(%limit: I32, %count: I32) -> I32 {
  b0:
    %i = alloc : I32
    init %i, 0
    jmp b1

  b1:
    %v6 = load %i : I32
    %v7 = cmp_lt %v6, %count : Bool
    je %v7, b3, b2

  b2:
    ret -1

  b3:
    %v9 = load %i : I32
    %v10 = load %i : I32
    %v11 = mul %v9, %v10 : I32
    %v12 = cmp_gt %v11, %limit : Bool
    je %v12, b4, b5

  b4:
    %v14 = load %i : I32
    ret %v14

  b5:
    jmp b6

  b6:
    %v17 = load %i : I32
    %v20 = add %v17, 1 : I32
    assign %i, %v20
    jmp b1
