fn joined(%flag: Bool, %a: I32, %b: I32) -> I32 {
  b0:
    je %flag, b1, b2

  b1:
    %v4 = alloc : Point
    aggregate %local0@Point.x = %a, %local0@Point.y = 1
    jmp b3

  b2:
    %v7 = alloc : Point
