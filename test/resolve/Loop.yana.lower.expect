@image$base = []

madePoint<complex>(%v_0: Ptr) {
  b_1 {
    store %v_0, 3, 4
    %v_2 = add %v_0, 4: Ptr
    store %v_2, 4, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    jmp b_1
  }

  b_2 {
    %v_3 = cmp_ilt %v_4, 3: I32
    je %v_3, b_1, b_5
  }

