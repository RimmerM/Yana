    %v_62 = phi [b_61, %v_63], [b_7, 0]: I32
    jmp b_64
  }

  b_65 {
    %v_66 = cmp_ilt %v_67, 3: I32
    je %v_66, b_64, b_61
  }

  b_61 {
    %v_63 = add %v_62, 1: I32
    %v_68 = cmp_ilt %v_63, 2: I32
    je %v_68, b_11, b_12
  }

  b_64 {
    %v_69 = phi [b_65, %v_14], [b_11, %v_60]: I32
    %v_70 = phi [b_65, %v_67], [b_11, 0]: I32
    %v_14 = add %v_69, 7: I32
    %v_67 = add %v_70, 1: I32
    jmp b_65
  }

  b_6 {
