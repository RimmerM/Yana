    %v_10 = phi [b_77, %v_71], [b_76, %v_78]: I32
    %v_74 = add %v_73, 1: I32
    %v_79 = cmp_ilt %v_74, 4: I32
    je %v_79, b_6, b_7
  }

  b_1 {
    %v_80 = phi [b_2, %v_9], [b_0, 0]: I32
    %v_81 = phi [b_2, %v_4], [b_0, 0]: I32
    %v_9 = add %v_80, 12: I32
