  }

  b_44 {
    %v_45 = add %v_38, %v_46: I32
    %v_47 = add %v_45, 7: I32
    ret %v_47
  }

  b_40 {
    %v_48 = phi [b_41, %v_49], [b_37, 3]: I32
    %v_50 = phi [b_41, %v_43], [b_37, 0]: I32
    %v_51 = phi [b_41, %v_46], [b_37, 0]: I32
    %v_49 = add %v_48, 1: I32
    %v_52 = shl %v_49, 2: I32
    %v_46 = add %v_51, %v_52: I32
    %v_43 = add %v_50, 1: I32
    jmp b_41
  }

  b_33 {
    %v_53 = phi [b_34, %v_39], [b_26, 0]: I32
    %v_54 = phi [b_34, %v_36], [b_26, 0]: I32
    %v_55 = add %v_53, 1: I32
    %v_39 = add %v_55, %v_32: I32
    %v_36 = add %v_54, 1: I32
    jmp b_34
  }

  b_22 {
    %v_56 = phi [b_23, %v_28], [b_19, 0]: I32
    %v_57 = phi [b_23, %v_25], [b_19, 0]: I32
    %v_28 = add %v_56, 13: I32
    %v_25 = add %v_57, 1: I32
    jmp b_23
  }

  b_15 {
    %v_58 = phi [b_16, %v_21], [b_12, 3]: I32
    %v_59 = phi [b_16, %v_18], [b_12, 0]: I32
    %v_21 = add %v_58, 4: I32
    %v_18 = add %v_59, 1: I32
    jmp b_16
  }

  b_11 {
