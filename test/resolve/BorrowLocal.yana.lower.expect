
accumulate<complex>(%n: Int): Int {
  b_0 {
    %v_1 = imul %n, 2: Int
    ret %v_1
  }
}

addTo<complex>(%target: Ptr, %amount: Int) {
  b_0 {
    %v_1 = loads %target, 4: Int
    %v_2 = add %v_1, %amount: Int
    store %target, %v_2, 4
    ret 
  }
}

shared<complex>(%n: Int): Int {
  b_0 {
    %total = alloca 4, 4: Ptr
    store %total, 0, 4
    call_complex addTo, %total, %n
    %v_1 = loads %total, 4: Int
    %v_2 = add %v_1, 1: Int
    store %total, %v_2, 4
    ret %v_2
  }
}

main<complex>(): Int {
  b_0 {
    %v_1 = call_complex accumulate, 5: Int
    %v_2 = call_complex shared, 5: Int
    %v_3 = add %v_1, %v_2: Int
    ret %v_3
  }
}

