// Generated by the Yana compiler - the ownership pipeline (Analysis-IR-JS.md)
var counter = 0;

// 
function fib(n) {
  var p1;
  if (n < 2) {
    p1 = n;
  } else {
    p1 = fib(n - 1 | 0) + fib(n - 2 | 0) | 0;
  }
  return p1;
}

function main() {
  counter = counter + 4 | 0;
  counter = counter + 6 | 0;
  return (37 + fib(10) | 0) + counter | 0;
}
main();
