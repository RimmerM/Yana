instance Drop(Held): Held.drop

let & live: I32 = 0

let & trace: I32 = 0

let string'142: [CodeUnit *6] = "abcdef"

fn Held.drop(self: Held) -> {} {
bb0:
  %0: I32 = read copy.trivial (global live)
  %1: I32 = const 1
  %2: I32 = sub inspect %0 inspect %1
  write.assign borrow.unique (global live) take %2
  %4: I32 = read copy.trivial (global trace)
  %5: I32 = const 10
  %6: I32 = mul inspect %4 inspect %5
  %7: I32 = read copy.trivial (self.id)
  %8: I32 = add inspect %6 inspect %7
  write.assign borrow.unique (global trace) take %8
  return
}

fn held(id: I32 [shared call]) -> Held {
bb0:
  %0: I32 = read copy.trivial (global live)
  %1: I32 = const 1
  %2: I32 = add inspect %0 inspect %1
  write.assign borrow.unique (global live) take %2
  %4: I32 = read copy.trivial (id)
