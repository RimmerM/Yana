}

fn discarded() -> I32 {
  local unread: Held

bb0:
  %0: I32 = const 4
  %1: Held = call held borrow.shared %0
  write.init borrow.unique (unread) take %1
  drop (unread)
  %3: I32 = const 0
  return take %3
}

