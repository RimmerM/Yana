@image$base = []

main<complex>(): I32 {
  b_0 {
    %c = alloca 4, 4: Ptr
    store %c, 0, 4
    atomic_store %c, 7, 4, release
    %v_1 = atomic_loads %c, 4, acquire: I32
    %v_2 = atomic_xchg %c, 9, 4, acq_rel: I32
    %v_3 = add %v_1, %v_2: I32
    %c = alloca 4, 4: Ptr
    store %c, 0, 4
    atomic_store %c, 1, 4, release
    %v_4 = atomic_loads %c, 4, acquire: I32
    atomic_store %c, 1, 4, release
    %v_5 = atomic_loads %c, 4, acquire: I32
    %v_6 = add %v_4, %v_5: I32
    %v_7 = add %v_3, %v_6: I32
    %c = alloca 4, 4: Ptr
    store %c, 3, 4
    %v_8 = atomic_loads %c, 4, relaxed: I32
    %v_9 = atomic_loads %c, 4, relaxed: I32
    %v_10 = add %v_8, %v_9: I32
    %v_11 = add %v_7, %v_10: I32
    %h = alloca 8, 4: Ptr
    store %h, 4, 4
    %v_12 = add %h, 4: Ptr
    %v_13 = imm 5: I32
    store %v_12, %v_13, 4
    atomic_store %h, 1, 4, release
    %v_14 = atomic_loads %h, 4, acquire: I32
    %v_15 = add %v_14, %v_13: I32
    %v_16 = add %v_11, %v_15: I32
    %v_17 = alloca 8, 4: Ptr
    store %v_17, 1, 4
    %v_18 = add %v_17, 4: Ptr
    store %v_18, 2, 4
    %v_19 = atomic_loads %v_17, 4, relaxed: I32
    %v_20 = atomic_loads %v_18, 4, relaxed: I32
    %v_21 = add %v_19, %v_20: I32
    %v_22 = atomic_loads %v_17, 4, relaxed: I32
    %v_23 = atomic_loads %v_17, 4, relaxed: I32
    %v_24 = add %v_22, %v_23: I32
    jmp b_25
  }

  b_26 {
    %v_27 = cmp_ilt %v_28, 2: I32
    je %v_27, b_25, b_29
  }

  b_29 {
    %v_30 = add %v_21, %v_24: I32
    %v_31 = add %v_16, %v_30: I32
    %h = alloca 8, 4: Ptr
