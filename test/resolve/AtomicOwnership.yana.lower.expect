    %v_32 = add %h, 4: Ptr
    store %v_32, 1, 4
    %v_33 = atomic_loads %h, 4, relaxed: I32
    %v_34 = add %v_33, 1: I32
    %v_35 = add %v_31, %v_34: I32
    %v_36 = add %v_35, 7: I32
    ret %v_36
  }

  b_25 {
    %v_37 = phi [b_26, %v_28], [b_0, 0]: I32
    %v_28 = add %v_37, 1: I32
    jmp b_26
  }
