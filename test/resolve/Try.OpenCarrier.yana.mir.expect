module ResolveTest

data Problem {code: I32}

class Reader(a): readOne

instance Reader(I32): I32.readOne

let string'142: [CodeUnit *2] = [97, 98]

fn readOne(text: String [shared call view]) -> Result(Problem, a) = <no body>

fn I32.readOne(text: String [shared call view]) -> Result(Problem, I32) {
bb0:
  %0: String [shared call view] = read borrow.shared (text) loan0
  %1: Size = call length(String) borrow.shared %0
  %2: Size = const 0
  %3: Bool = eq inspect %1 inspect %2
  branch inspect %3 -> bb3 -> bb1

bb1:
  %8: I32 = const 7
  %9: Result(Problem, I32) = aggregate.Ok take %8
  jump -> bb2(take %9)

bb2(%10: Result(Problem, I32)):
  return take %10

bb3:
  %5: I32 = const 1
  %6: Problem = aggregate.Problem take %5
  %7: Result(Problem, I32) = aggregate.Err take %6
  jump -> bb2(take %7)
}

fn readTwice(text: String [shared call view]) -> Result(Problem, a) {
  form specialized
  slot #0 type a
  slot #1 class Reader(a)
  local outcome: Result(Problem, a)
  local local2: Outcome(a, Problem) object2
  local first: a object2

bb0:
  %0: String [shared call view] = read borrow.shared (text) loan0
  %1: Result(Problem, a) = call readOne(a) borrow.shared %0
  write.init borrow.unique (outcome) take %1
  %3: Result(Problem, a) = read take (outcome)
  %4: Outcome(a, Problem) = call toOutcome(Result(Problem, a), a, Problem) take %3
  write.init borrow.unique (local2) take %4
  %6: U8 = read copy.trivial (local2.#)
  %7: U8 = const 1
  %8: Bool = eq inspect %6 inspect %7
  branch inspect %8 -> bb3 -> bb1

bb1:
  %13: a = read take (local2.Proceed)
  jump -> bb2(take %13)

bb2(%14: a):
  write.init borrow.unique (first) take %14
  %17: a = read take (first)
  %18: Result(Problem, a) = aggregate.Ok take %17
  return take %18

bb3:
  %10: Problem = read copy.trivial (local2.Exit)
  drop (local2)
  %11: Result(Problem, a) = call fromExit(Result(Problem, a), a, Problem) take %10
  return take %11
}

fn main() -> I32 {
  local local0: String
  local outcome: Result(Problem, I32)
  local v: I32
  local p: Problem

bb0:
  %0: [CodeUnit *2] [shared slot 0] = read borrow.shared (global string'142) loan0
  %1: %[CodeUnit *2] [owned here shape6 .*=shared slot 0] = address inspect %0 roots.0{0}
  %2: %CodeUnit [owned here shape6 .*=shared slot 0] = bitcast inspect %1 roots.0{0}
  %3: I32 = const 2
  %4: String = call stringLiteral borrow.shared %2 borrow.shared %3
  write.init borrow.unique (local0) take %4
  %6: String [shared slot 0] = read borrow.shared (local0) loan1
  %7: String [shared slot 0 view] = call.derivation view(String) borrow.shared %6 roots{1}
  %8: Result(Problem, I32) = call readTwice(I32) borrow.shared %7
  drop (local0)
  write.init borrow.unique (outcome) take %8
  %10: U8 = read copy.trivial (outcome.#)
  %11: U8 = const 1
  %12: Bool = eq inspect %10 inspect %11
  branch inspect %12 -> bb3 -> bb1

bb1:
  %17: Problem = read copy.trivial (outcome.Err)
  write.init borrow.unique (p) take %17
  %19: I32 = const 0
  %20: I32 = read copy.trivial (p.code)
  %21: I32 = sub inspect %19 inspect %20
  jump -> bb2(take %21)

bb2(%22: I32):
  return take %22

bb3:
  %14: I32 = read copy.trivial (outcome.Ok)
  write.init borrow.unique (v) take %14
  %16: I32 = read copy.trivial (v)
  jump -> bb2(take %16)
}

fn readTwice(I32)(text: String [shared call view]) -> Result(Problem, I32) = <readTwice at I32>

entry main
