fn branch(flag: Bool [shared call]) -> I64 {
  local held: Buffer
  local counted: I64

bb0:
  %0: Size = const 16
  %1: Buffer = call makeBuffer borrow.shared %0
  write.init borrow.unique (held) take %1
  %3: Bool = read copy.trivial (flag)
  branch inspect %3 -> bb3 -> bb1

bb1:
  drop (held)
