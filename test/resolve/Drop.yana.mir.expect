module ResolveTest

data Buffer {bytes: %U8} drop authored

data Pair {left: Buffer, right: Buffer} drop derived

instance Drop(Buffer): Buffer.drop

let & liveBuffers: I64 = 0

fn makeBuffer(size: Size [shared call]) -> Buffer {
  local buffer: Buffer

bb0:
  %0: I64 [unique call] = read borrow.unique (global liveBuffers) loan0
  %1: I64 = const 1
  %2: {} = call +=(I64) borrow.unique %0 borrow.shared %1
  %3: Size = read copy.trivial (size)
  %4: %U8 = call allocateHeap borrow.shared %3
  %5: Buffer = aggregate.Buffer take %4
  write.init borrow.unique (buffer) take %5
  %7: %U8 = read copy.trivial (buffer.bytes)
  %8: U8 = const 0
  %9: Size = read copy.trivial (size)
  %10: {} = native set.memory inspect %7 inspect %8 inspect %9
  %11: Buffer = read take (buffer)
  return take %11
}

fn Buffer.drop(value: Buffer) -> {} {
bb0:
  %0: %U8 = read copy.trivial (value.bytes)
  %1: {} = call freeHeap borrow.shared %0
  %2: I64 [unique call] = read borrow.unique (global liveBuffers) loan0
  %3: I64 = const 1
  %4: {} = call -=(I64) borrow.unique %2 borrow.shared %3
  return
}

fn firstByte(it: Buffer [shared call]) -> I64 {
bb0:
  %0: %U8 = read copy.trivial (it.bytes)
  %1: U8 = read copy.trivial ([%%0])
  %2: I64 = convert inspect %1
  return take %2
}

fn consume(it: Buffer) -> I64 {
  local counted: I64

bb0:
  %0: I64 = read copy.trivial (global liveBuffers)
  write.init borrow.unique (counted) take %0
  %2: I64 = read copy.trivial (counted)
  %3: Buffer [shared call] = read borrow.shared (it) loan0
  %4: I64 = call firstByte borrow.shared %3
  drop (it)
  %5: I64 = add inspect %2 inspect %4
  return take %5
}

fn straightLine() -> I64 {
  local a: Buffer
