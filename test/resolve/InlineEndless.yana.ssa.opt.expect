module ResolveTest

let & seed: I32 = 3

fn endless(n: I32 [shared call]) -> I32 {
bb0(%0: I32 trivial):
  %9: I32 trivial = const 1
  jump -> bb1(inspect %0)

bb1(%12: I32 trivial):
  %10: I32 trivial = add inspect %12 inspect %9
  jump -> bb1(inspect %10)
