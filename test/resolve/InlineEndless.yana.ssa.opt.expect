fn reaches(n: I32 [shared call]) -> I32 {
bb0(%0: I32 trivial):
  %3: I32 trivial = const 1000000
  %4: Bool trivial = gt inspect %0 inspect %3
  branch inspect %4 -> bb3 -> bb1

bb1:
  %6: I32 trivial = const 3
  %7: I32 trivial = mul inspect %0 inspect %6
  return consume %7

bb3:
  %8: I32 trivial = call spins
