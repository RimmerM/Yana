fn main() -> I32 {
bb0:
  %0: %I32 address = global.addr seed
  %1: I32 trivial = load inspect %0
  %16: I32 trivial = const 1000000
  %17: Bool trivial = gt inspect %1 inspect %16
  branch inspect %17 -> bb5 -> bb4

