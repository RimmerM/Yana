fn main$() -> I32 {
  b0:
    %v2 = neg 21 : I32
    init parenthesized, %v2
    %v8 = mul 7, 3 : I32
    %v9 = neg %v8 : I32
    init overAnExpression, %v9
    %v12 = neg 400 : I32
    init overAName, %v12
    %v17 = div 400, 8 : I32
    %v18 = neg %v17 : I32
    init overAQuotient, %v18
    %v22 = neg 256 : I32
    %v23 = neg %v22 : I32
    init twice, %v23
    %v29 = mul 2, 3 : I32
    %v30 = neg %v29 : I32
    %v31 = cast %v30 : I64
    init ascribed, %v31
    %v33 = call main : I32
