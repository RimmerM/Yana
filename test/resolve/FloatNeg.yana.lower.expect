@image$base = []

opaque<complex>(%x: Double): Double {
  b_0 {
    ret %x
  }
}

opaqueF<complex>(%x: Float): Float {
  b_0 {
    ret %x
  }
}

main<complex>(): Int {
  b_0 {
    %v_1 = call_complex opaque, 2.5: Double
    %v_2 = neg %v_1: Double
    %v_3 = cmp_eq %v_2, -2.5: Int
    je %v_3, b_4, b_5
  }

  b_4 {
    jmp b_5
  }

  b_5 {
    %v_6 = phi [b_0, 0], [b_4, 1]: Int
    %v_7 = call_complex opaqueF, 1.5: Float
    %v_8 = neg %v_7: Float
    %v_9 = cmp_eq %v_8, -1.5: Int
    je %v_9, b_10, b_11
  }

  b_10 {
    %v_12 = add %v_6, 2: Int
    jmp b_11
  }

  b_11 {
    %v_13 = phi [b_5, %v_6], [b_10, %v_12]: Int
    %v_14 = call_complex opaque, 3.25: Double
    %v_15 = neg %v_14: Double
    %v_16 = neg %v_15: Double
    %v_17 = cmp_eq %v_16, 3.25: Int
    je %v_17, b_18, b_19
  }

  b_18 {
    %v_20 = add %v_13, 4: Int
    jmp b_19
  }

  b_19 {
    %v_21 = phi [b_11, %v_13], [b_18, %v_20]: Int
    %v_22 = call_complex opaqueF, 7.5: Float
    %v_23 = neg %v_22: Float
    %v_24 = neg %v_23: Float
    %v_25 = cmp_eq %v_24, 7.5: Int
    je %v_25, b_26, b_27
  }

  b_26 {
    %v_28 = add %v_21, 8: Int
    jmp b_27
  }

  b_27 {
    %v_29 = phi [b_19, %v_21], [b_26, %v_28]: Int
    %v_30 = call_complex opaque, 0: Double
    %v_31 = neg %v_30: Double
    %v_32 = div 1, %v_31: Double
    %v_33 = cmp_lt %v_32, 0: Int
    je %v_33, b_34, b_35
  }

  b_34 {
    %v_36 = add %v_29, 16: Int
    jmp b_35
  }

  b_35 {
    %v_37 = phi [b_27, %v_29], [b_34, %v_36]: Int
    %v_38 = add %v_37, 32: Int
    ret %v_38
  }
}

