  write.init borrow.unique (p) take %2
  %4: I32 = read copy.trivial (p.count)
  %5: I32 = const 1
  %6: I32 = add inspect %4 inspect %5
  write.assign borrow.unique (p.count) take %6
  %8: Rec = read copy.trivial (p)
  return take %8
}

