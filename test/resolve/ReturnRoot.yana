-- Borrows in return position: the `return` marker, and what it buys a caller.

data Point {x: Int, y: Int}

-- A shared accessor. The result is a reference to the caller's storage, so `p` stays borrowed for
-- as long as the result is live.
fn xOf(return p: Point) -> 'Int = p.x

-- An exclusive selector. Both are written now: `'Int` above says shared and `&Int` here says
-- exclusive, where the two used to be one spelling and the group decided which.
fn larger(return &a: Int, return &b: Int) -> &Int = if a > b then a else b

fn main() -> Int:
    let here = Point {x: 10, y: 20}
    let first = xOf(here)

    let &left = 1 :: Int
    let &right = 2 :: Int
    let &chosen = larger(left, right)
    chosen = 40

    return first + chosen
