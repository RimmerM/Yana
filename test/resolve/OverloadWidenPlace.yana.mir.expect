fn widen'2(p: Point [unique call]) -> {} {
bb0:
  %0: I32 = read copy.trivial (p.x)
  %1: I32 = const 2
  %2: I32 = mul inspect %0 inspect %1
  write.assign borrow.unique (p.x) take %2
  return
}

