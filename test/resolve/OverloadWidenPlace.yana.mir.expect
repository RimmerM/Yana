  write.init borrow.unique (m) take %3
  %5: I32 = const 1
  %6: I32 = const 2
  %7: Point = aggregate.Point take %5 take %6
  write.init borrow.unique (p) take %7
  %9: Point [unique call] = read borrow.unique (p) loan0
  %10: {} = call widen'2 borrow.unique %9
  %11: I64 = read copy.trivial (m)
  %12: I32 = convert inspect %11
  %13: I32 = const 10
  %14: I32 = mul inspect %12 inspect %13
  %15: I32 = read copy.trivial (p.x)
  %16: I32 = add inspect %14 inspect %15
