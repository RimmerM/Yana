"use strict";
// ResolveTest
function flags() {
  var score = 0;
  if (Eq_Flags_eq_eq(1, 1)) {
    score = score + 256 | 0;
  }
  if (Eq_Flags_eq_eq(3, 3)) {
    score = score + 512 | 0;
  }
  if (Eq_Flags_eq_eq(2, 2)) {
    score = score + 1024 | 0;
  }
  return score;
}

function main() {
  return flags() + 6399 | 0;
}

function Eq_Flags_eq_eq(lhs, rhs) {
  var v12;
  if ((lhs & 1) === (rhs & 1)) {
    v12 = (lhs >>> 1 & 1) === (rhs >>> 1 & 1) ? 1 : 0;
