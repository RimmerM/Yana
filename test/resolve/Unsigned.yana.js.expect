"use strict";
// ResolveTest
function divide(a, b) {
  return BigInt.asUintN(64, a / b);
}

function remainder(a, b) {
  return BigInt.asUintN(64, a % b);
}

function signedDivide(a, b) {
  return BigInt.asIntN(64, a / b);
}

