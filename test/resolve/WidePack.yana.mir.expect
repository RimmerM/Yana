module ResolveTest

data Pair {a: @bits(20) U32, b: @bits(20) U32}

data Marked {a: @bits(20) U32, m: @bits(20) I32}

data Tagged {v: @bits(40) WideInt, t: @bits(4) U32}

data Boxed {k: U32, a: @bits(20) U32, b: @bits(12) U32}

fn check(actual: U32 [shared call], expected: U32 [shared call], weight: I32 [shared call]) -> I32 {
bb0:
  %0: U32 = read copy.trivial (actual)
  %1: U32 = read copy.trivial (expected)
  %2: Bool = eq inspect %0 inspect %1
  branch inspect %2 -> bb3 -> bb1

bb1:
  %5: I32 = const 0
  jump -> bb2(take %5)

bb2(%6: I32):
  return take %6

bb3:
  %4: I32 = read copy.trivial (weight)
  jump -> bb2(take %4)
}

fn checkI(actual: I32 [shared call], expected: I32 [shared call], weight: I32 [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (actual)
  %1: I32 = read copy.trivial (expected)
  %2: Bool = eq inspect %0 inspect %1
  branch inspect %2 -> bb3 -> bb1

bb1:
  %5: I32 = const 0
  jump -> bb2(take %5)

bb2(%6: I32):
  return take %6

bb3:
  %4: I32 = read copy.trivial (weight)
  jump -> bb2(take %4)
}

fn checkW(actual: WideInt [shared call], expected: WideInt [shared call], weight: I32 [shared call]) -> I32 {
bb0:
  %0: WideInt = read copy.trivial (actual)
  %1: WideInt = read copy.trivial (expected)
  %2: Bool = eq inspect %0 inspect %1
  branch inspect %2 -> bb3 -> bb1

bb1:
  %5: I32 = const 0
  jump -> bb2(take %5)

bb2(%6: I32):
  return take %6

bb3:
  %4: I32 = read copy.trivial (weight)
  jump -> bb2(take %4)
}

fn readB(p: Pair [shared call]) -> @bits(20) U32 {
bb0:
  %0: @bits(20) U32 = read copy.trivial (p.b)
  %1: U32 = convert inspect %0
  %2: @bits(20) U32 = convert inspect %1
  return take %2
}

fn writeHigh() -> Pair {
  local & p: Pair

bb0:
  %0: @bits(20) U32 = const 1000
  %1: @bits(20) U32 = const 1
  %2: Pair = aggregate.Pair take %0 take %1
  write.init borrow.unique (p) take %2
  %4: @bits(20) U32 = const 1048575
  write.assign borrow.unique (p.b) take %4
  %6: Pair = read copy.trivial (p)
  return take %6
}

fn writeLow() -> Pair {
  local & p: Pair

bb0:
  %0: @bits(20) U32 = const 1
  %1: @bits(20) U32 = const 999999
  %2: Pair = aggregate.Pair take %0 take %1
  write.init borrow.unique (p) take %2
  %4: @bits(20) U32 = const 1048575
  write.assign borrow.unique (p.a) take %4
  %6: Pair = read copy.trivial (p)
  return take %6
}

fn nudge(x: @bits(20) U32 [unique call]) -> {} {
bb0:
  %0: @bits(20) U32 = read copy.trivial (x)
  %1: U32 = convert inspect %0
  %2: U32 = const 1
  %3: U32 = add inspect %1 inspect %2
  %4: @bits(20) U32 = convert inspect %3
  write.assign borrow.unique (x) take %4
  return
}

fn bumpedHigh() -> Pair {
  local & p: Pair

bb0:
  %0: @bits(20) U32 = const 1000
  %1: @bits(20) U32 = const 999999
  %2: Pair = aggregate.Pair take %0 take %1
  write.init borrow.unique (p) take %2
  %4: @bits(20) U32 [unique call] = read borrow.unique (p.b) loan0
  %5: {} = call nudge borrow.unique %4
  %6: Pair = read copy.trivial (p)
  return take %6
}

fn marked() -> Marked {
  local & v: Marked

bb0:
  %0: @bits(20) U32 = const 5
  %1: @bits(20) I32 = const 0
  %2: Marked = aggregate.Marked take %0 take %1
  write.init borrow.unique (v) take %2
  %4: I32 = const 0
  %5: I32 = const 3
  %6: I32 = sub inspect %4 inspect %5
  %7: @bits(20) I32 = convert inspect %6
  write.assign borrow.unique (v.m) take %7
  %9: Marked = read copy.trivial (v)
  return take %9
}

fn tagged() -> Tagged {
bb0:
  %0: @bits(40) WideInt = const 549755813887
  %1: @bits(4) U32 = const 9
  %2: Tagged = aggregate.Tagged take %0 take %1
  return take %2
}

fn retagged() -> Tagged {
  local & x: Tagged

bb0:
  %0: @bits(40) WideInt = const 549755813887
  %1: @bits(4) U32 = const 9
  %2: Tagged = aggregate.Tagged take %0 take %1
  write.init borrow.unique (x) take %2
  %4: WideInt = const 0
  %5: WideInt = const 2
  %6: WideInt = sub inspect %4 inspect %5
  %7: @bits(40) WideInt = convert inspect %6
  write.assign borrow.unique (x.v) take %7
  %9: Tagged = read copy.trivial (x)
  return take %9
}

fn stored(x: WideInt [shared call]) -> Tagged {
  local & r: Tagged

bb0:
  %0: @bits(40) WideInt = const 0
  %1: @bits(4) U32 = const 1
  %2: Tagged = aggregate.Tagged take %0 take %1
  write.init borrow.unique (r) take %2
  %4: WideInt = read copy.trivial (x)
  %5: @bits(40) WideInt = convert inspect %4
  write.assign borrow.unique (r.v) take %5
  %7: Tagged = read copy.trivial (r)
  return take %7
}

fn nudge12(x: @bits(12) U32 [unique call]) -> {} {
bb0:
  %0: @bits(12) U32 = read copy.trivial (x)
  %1: U32 = convert inspect %0
  %2: U32 = const 1
  %3: U32 = add inspect %1 inspect %2
  %4: @bits(12) U32 = convert inspect %3
  write.assign borrow.unique (x) take %4
  return
}

fn boxed() -> Boxed {
  local & x: Boxed

bb0:
  %0: U32 = const 7
  %1: @bits(20) U32 = const 1
  %2: @bits(12) U32 = const 4095
  %3: Boxed = aggregate.Boxed take %0 take %1 take %2
  write.init borrow.unique (x) take %3
  %5: @bits(12) U32 [unique call] = read borrow.unique (x.b) loan0
  %6: {} = call nudge12 borrow.unique %5
  %7: Boxed = read copy.trivial (x)
  return take %7
}

