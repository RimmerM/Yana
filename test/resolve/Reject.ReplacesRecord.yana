{-
   A replacement's condition that builds an ill-formed record - Design-Replacements.md §3.3.

   The condition is asked silently, but the record it builds is interned and handed to the next use
   of its type, whose fields are checked only when it is built. So building it is heard: this is a
   mistake in the program rather than a condition that failed, and without that the later
   `Maybe(Laned(Bool))` would compile with nothing reporting it.
-}

data Laned(a) {v: Vec(a)}

fn (Eq(a)) laned(x: a) -> I32 = 1

@replaces
fn (Eq(a), TrivialCopy(Laned(a))) laned(x: a) -> I32 = 2

fn main() -> Int:
    let chosen = laned(True)
    let later = Nothing :: Maybe(Laned(Bool))
    return chosen :: Int
