@image$base = []
mut @calls = [0, 0, 0, 0]

+=(I32)<complex>(%target: Ptr, %amount: I32) {
  b_0 {
    %v_1 = loads %target, 4: I32
    %v_2 = add %v_1, %amount: I32
    store %target, %v_2, 4
    ret 
  }
}

pokeMove<complex>(%h: Ptr) {
  b_0 {
    %v_1 = add %h, 8: Ptr
    %v_2 = loads %v_1, 8: I64
    %v_3 = cmp_ge 1, %v_2: I32
    je %v_3, b_4, b_5
  }

  b_5 {
    %v_6 = load %h, 8: Ptr
    %v_7 = add %v_6, 4: Ptr
    store %v_7, 77, 4
    ret 
  }

  b_4 {
    %v_8 = syscall 60, 134: I64
    unreachable 
  }
}

valuesOf<complex>(%v_0: Ptr, %self: Ptr) {
  b_1 {
    store %v_0, %self, 8
    %v_2 = add %v_0, 8: Ptr
    store %v_2, 4, 8
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    call_complex +=(I32), @calls, 1
    %v_1 = alloca 20, 4: Ptr
    setpattern %v_1, 16, 0
    %v_2 = add %v_1, 16: Ptr
    store %v_2, 1, 4
    %v_3 = add %v_1, 4: Ptr
    store %v_3, 4, 4
    %v_4 = alloca 20, 8: Ptr
    call_complex valuesOf, %v_4, %v_1
    %v_5 = add %v_4, 16: Ptr
    store %v_5, 1, 4
    call_complex pokeMove, %v_4
    %v_6 = add %v_1, 4: Ptr
    %v_7 = loads %v_6, 4: I32
    %v_8 = cmp_neq %v_7, 77: I32
    je %v_8, b_9, b_10
  }

  b_9 {
    jmp b_11
  }

  b_10 {
    jmp b_11
  }

  b_11 {
    %v_12 = phi [b_9, 1], [b_10, 0]: I32
    call_complex +=(I32), @calls, 1
    %v_13 = alloca 12, 4: Ptr
    store %v_13, 5, 4
    %v_14 = add %v_13, 4: Ptr
    store %v_14, 2, 4
    %v_15 = add %v_13, 8: Ptr
    store %v_15, 7, 4
    %v_16 = alloca 20, 8: Ptr
    store %v_16, %v_13, 8
    %v_17 = add %v_16, 8: Ptr
    store %v_17, 3, 8
    %v_18 = add %v_16, 16: Ptr
    store %v_18, 1, 4
    call_complex pokeMove, %v_16
    %v_19 = loads %v_14, 4: I32
    %v_20 = cmp_neq %v_19, 77: I32
    je %v_20, b_21, b_22
  }

  b_21 {
    %v_23 = add %v_12, 2: I32
    jmp b_24
  }

  b_22 {
    jmp b_24
  }

  b_24 {
    %v_25 = phi [b_21, %v_23], [b_22, %v_12]: I32
    %v_26 = loads @calls, 4: I32
    %v_27 = cmp_neq %v_26, 2: I32
    je %v_27, b_28, b_29
  }

  b_28 {
    %v_30 = add %v_25, 4: I32
    jmp b_31
  }

  b_29 {
    jmp b_31
  }

  b_31 {
    %v_32 = phi [b_28, %v_30], [b_29, %v_25]: I32
    ret %v_32
  }
}

