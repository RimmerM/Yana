@image$base = []

main<complex>(): I32 {
  b_0 {
    %v_1 = vsplat 64: i32x4
    %v_2 = vwithlane %v_1, 5, 0: i32x4
    %v_3 = vwithlane %v_2, 100, 1: i32x4
    %a = vwithlane %v_3, 18446744073709551584, 2: i32x4
    %b = vsplat 3: i64x2
    %v_4 = vsplat 3: i32x4
    %left = shl %a, %v_4: i32x4
    %v_5 = vsplat 2: i32x4
    %right = shr %a, %v_5: i32x4
    %v_6 = vsplat 1: i32x4
    %arith = sar %a, %v_6: i32x4
    %v_7 = vsplat 5: i64x2
    %v_8 = shl %b, %v_7: i64x2
    %v_9 = vsplat 4: i64x2
    %wide = shr %v_8, %v_9: i64x2
    %v_10 = vsplat 0: i64x2
    %v_11 = sub %v_10, %b: i64x2
    %v_12 = vsplat 1: i64x2
    %deep = sar %v_11, %v_12: i64x2
    %v_13 = vlane %left, 0: I32
    %v_14 = vlane %right, 1: I32
    %v_15 = add %v_13, %v_14: I32
    %v_16 = vlane %arith, 2: I32
    %v_17 = add %v_15, %v_16: I32
    %v_18 = vlane %wide, 0: I64
    %v_19 = cast %v_18: I32
    %v_20 = add %v_17, %v_19: I32
    %v_21 = vlane %deep, 0: I64
    %v_22 = cast %v_21: I32
    %v_23 = add %v_20, %v_22: I32
    %v_24 = add %v_23, 100: I32
    ret %v_24
  }
}

