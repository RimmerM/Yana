bb2:
  %33: Array(Cell) [shared call] = read borrow.shared (xs) loan1
  %34: Array(Cell) [shared slot 0 view] = call.derivation elements(Array(Cell), Cell) borrow.shared %33 roots{1}
  %35: Size = const 2
