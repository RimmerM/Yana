bb14:
  %72: Array(Cell) [shared call] = read borrow.shared (xs) loan5
  %73: Array(Cell) [shared slot 0 view] = call.derivation elements(Array(Cell), Cell) borrow.shared %72 roots{5}
  %74: Size = const 2
  %75: I32 = call strided borrow.shared %73 borrow.shared %74
  %76: Array(Cell) [shared call] = read borrow.shared (xs) loan6
  %77: Array(Cell) [shared slot 0 view] = call.derivation elements(Array(Cell), Cell) borrow.shared %76 roots{6}
  %78: Size = const 3
  %79: I32 = call strided borrow.shared %77 borrow.shared %78
  drop (xs)
  %80: I32 = add inspect %75 inspect %79
  return take %80

bb15:
  drop (xs)
  %69: I32 = const -4
  return take %69
}

entry main
