  %19: I32 = const 0
  %20: I32 = const 0
  %21: I32 = const 0
  %22: I32 = read copy.trivial (n)
  %23: I32 = const 10
  %24: I32 = mul inspect %22 inspect %23
  %25: I32 = const 0
  %26: Cell = aggregate.Cell take %18 take %19 take %20 take %21 take %24 take %25
  %27: {} = call push(Cell) borrow.unique %17 take %26
  %28: I32 = read copy.trivial (n)
  %29: I32 = const 1
  %30: I32 = add inspect %28 inspect %29
  write.assign borrow.unique (n) take %30
  jump -> bb1

bb4:
  jump -> bb5

bb5:
  %43: Array(Cell) [shared call] = read borrow.shared (xs) loan2
  %44: Array(Cell) [shared slot 0 view] = call.derivation elements(Array(Cell), Cell) borrow.shared %43 roots{2}
  %45: I32 = call everyOther borrow.shared %44
  %46: I32 = const 66
  %47: Bool = ne inspect %45 inspect %46
  branch inspect %47 -> bb9 -> bb7

bb6:
  drop (xs)
  %40: I32 = const -1
  return take %40

bb7:
  jump -> bb8

bb8:
  %52: Array(Cell) [shared call] = read borrow.shared (xs) loan3
  %53: Array(Cell) [shared slot 0 view] = call.derivation elements(Array(Cell), Cell) borrow.shared %52 roots{3}
  %54: Size = const 1
  %55: I32 = call strided borrow.shared %53 borrow.shared %54
  %56: I32 = const 165
  %57: Bool = ne inspect %55 inspect %56
  branch inspect %57 -> bb12 -> bb10

bb9:
  drop (xs)
  %49: I32 = const -2
  return take %49

bb10:
  jump -> bb11

bb11:
  %62: Array(Cell) [shared call] = read borrow.shared (xs) loan4
  %63: Array(Cell) [shared slot 0 view] = call.derivation elements(Array(Cell), Cell) borrow.shared %62 roots{4}
  %64: Size = const 9
  %65: I32 = call strided borrow.shared %63 borrow.shared %64
  %66: I32 = const 0
  %67: Bool = ne inspect %65 inspect %66
  branch inspect %67 -> bb15 -> bb13

bb12:
  drop (xs)
  %59: I32 = const -3
  return take %59

bb13:
