module ResolveTest

data Cell {a: I32, b: I32, c: I32, d: I32, e: I32, f: I32}

fn strided(xs: Array(Cell) [shared call view], by: Size [shared call]) -> I32 {
  local & i: Size
  local & total: I32
  local local4: Cell [shared slot 0]
  local local5: Cell [shared slot 0]

bb0:
  %0: Size = const 0
  write.init borrow.unique (i) take %0
  %2: I32 = const 0
  write.init borrow.unique (total) take %2
  jump -> bb1

bb1:
  %5: Size = read copy.trivial (i)
  %6: Size = const 6
  %7: Bool = lt inspect %5 inspect %6
  branch inspect %7 -> bb3 -> bb2

bb2:
  %28: I32 = read copy.trivial (total)
  return take %28

bb3:
  %9: I32 = read copy.trivial (total)
  %10: Size = read copy.trivial (i)
  %11: Array(Cell) [shared call view] = read borrow.shared (xs) loan0
  %12: Cell [shared slot 0] = call.subscript get(Array(Cell), Size, Cell) borrow.shared %11 borrow.shared %10 roots{0}
  write.init borrow.unique (local4) borrow.shared %12
  %14: I32 = read copy.trivial (local4.a)
  %15: I32 = add inspect %9 inspect %14
  %16: Size = read copy.trivial (i)
  %17: Array(Cell) [shared call view] = read borrow.shared (xs) loan1
  %18: Cell [shared slot 0] = call.subscript get(Array(Cell), Size, Cell) borrow.shared %17 borrow.shared %16 roots{1}
  write.init borrow.unique (local5) borrow.shared %18
  %20: I32 = read copy.trivial (local5.e)
  %21: I32 = add inspect %15 inspect %20
  write.assign borrow.unique (total) take %21
  %23: Size = read copy.trivial (i)
  %24: Size = read copy.trivial (by)
  %25: Size = add inspect %23 inspect %24
  write.assign borrow.unique (i) take %25
  jump -> bb1
}

