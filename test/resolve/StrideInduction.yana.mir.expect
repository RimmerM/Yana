fn main() -> I32 {
  local & local0: Array(Cell) object1
  local & xs: Array(Cell) object1
  local & n: I32

bb0:
  %0: Size = const 0
  %1: %Cell = bitcast inspect %0
  %2: @bits(30) U32 = const 0
  %3: @bits(2) U32 = const 1
  %4: Run(Cell) = aggregate.Run take %1 take %2 take %3
  %5: @bits(30) U32 = const 0
  %6: Array(Cell) = aggregate.Array take %4 take %5
  write.init borrow.unique (local0) take %6
  %8: Array(Cell) = read take (local0)
  write.init borrow.unique (xs) take %8
  %10: I32 = const 0
  write.init borrow.unique (n) take %10
