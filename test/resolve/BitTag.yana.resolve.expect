let image$base: () = <none>

fn pickValue(%p: Pick) -> I32 {
  b0:
    %v1 = load %p.discriminant : I32
    %v3 = cmp_eq %v1, 0 : Bool
    je %v3, b2, b1

  b1:
    %rank = load %p@Right : Rank
    %v13 = cast %rank : I32
    %v15 = add %v13, 3 : I32
    jmp b6

  b2:
    %flag = load %p@Left : Bool
    je %flag, b3, b4

  b3:
    jmp b5

  b4:
    jmp b5

  b5:
    %v11 = phi [b3, 1], [b4, 2] : I32
    jmp b6

  b6:
    %v18 = phi [b5, %v11], [b1, %v15] : I32
    ret %v18
}

fn levelValue(%l: Level) -> I32 {
  b0:
    %v1 = load %l.discriminant : I32
    %v3 = cmp_eq %v1, 0 : Bool
    je %v3, b2, b1

  b1:
    %v6 = load %l.discriminant : I32
    %v8 = cmp_eq %v6, 1 : Bool
    je %v8, b4, b3

  b2:
    jmp b5

  b3:
    %step = load %l@High : @bits(3) U8
    %step = cast %step : I32
    %v19 = add 100, %step : I32
    jmp b5

  b4:
    %step = load %l@Low : @bits(3) U8
    %step = cast %step : I32
    %v14 = add 10, %step : I32
    jmp b5

  b5:
    %v23 = phi [b2, 0], [b4, %v14], [b3, %v19] : I32
    ret %v23
}

fn spanValue(%s: Span) -> I32 {
  b0:
    %v1 = load %s.discriminant : I32
    %v3 = cmp_eq %v1, 0 : Bool
    je %v3, b2, b1

  b1:
    %n = load %s@Large : @bits(12) U16
    %n = cast %n : I32
    %v11 = add 1000, %n : I32
    jmp b3

  b2:
    %n = load %s@Small : @bits(5) U8
    %n = cast %n : I32
    jmp b3

  b3:
    %v14 = phi [b2, %n], [b1, %v11] : I32
    ret %v14
}

fn boardValue(%b: Board) -> I32 {
  b0:
    %v1 = load %b@Board.left : Pick
    %v2 = call pickValue, %v1 : I32
    %v5 = mul %v2, 10 : I32
    %v6 = load %b@Board.right : Pick
    %v7 = call pickValue, %v6 : I32
    %v8 = add %v5, %v7 : I32
    ret %v8
}

fn rightIs(%b: Board) -> I32 {
  b0:
    %v1 = load %b@Board.right : Pick
    %v2 = load %b@Board.right.discriminant : I32
    %v4 = add %v2, 1 : I32
    ret %v4
}

fn maybeValue(%m: Maybe(Level)) -> I32 {
  b0:
    %v1 = load %m.discriminant : I32
    %v3 = cmp_eq %v1, 0 : Bool
    je %v3, b2, b1

  b1:
    %l = load %m@Just : Level
    %v7 = call levelValue, %l : I32
    jmp b3

  b2:
    jmp b3

  b3:
    %v10 = phi [b2, 7], [b1, %v7] : I32
    ret %v10
}

fn written() -> I32 {
  b0:
    %v0 = alloc : Board
    %v1 = alloc : Pick
    aggregate %local1.discriminant = 0, %local1@Left = True
    %v5 = alloc : Pick
    aggregate %local2.discriminant = 1, %local2@Right = Same
    aggregate %b@Board.left = %v1, %b@Board.right = %v5
    %v10 = alloc : Pick
    aggregate %local3.discriminant = 1, %local3@Right = More
    assign %b@Board.left, %v10
    %v15 = alloc : Pick
    aggregate %local4.discriminant = 0, %local4@Left = False
    assign %b@Board.right, %v15
    %v20 = load %b : Board
    %v21 = call boardValue, %v20 : I32
    ret %v21
}

fn main() -> I32 {
  b0:
    %v0 = alloc : Pick
    aggregate %local0.discriminant = 0, %local0@Left = True
    %v4 = call pickValue, %v0 : I32
    %v5 = alloc : Pick
    aggregate %local1.discriminant = 1, %local1@Right = More
    %v9 = call pickValue, %v5 : I32
    %v12 = mul %v9, 10 : I32
    %picks = add %v4, %v12 : I32
    %v14 = alloc : Level
    init %local2.discriminant, 0
    %v17 = call levelValue, %v14 : I32
    %v18 = alloc : Level
    %v22 = cast 5 : U8
    %v24 = and %v22, 7 : U8
    %v25 = cast %v24 : @bits(3) U8
    aggregate %local3.discriminant = 1, %local3@Low = %v25
    %v27 = call levelValue, %v18 : I32
    %v28 = add %v17, %v27 : I32
    %v29 = alloc : Level
    %v33 = cast 7 : U8
    %v35 = and %v33, 7 : U8
    %v36 = cast %v35 : @bits(3) U8
    aggregate %local4.discriminant = 2, %local4@High = %v36
    %v38 = call levelValue, %v29 : I32
    %levels = add %v28, %v38 : I32
    %v40 = alloc : Span
    %v44 = cast 31 : U8
    %v46 = and %v44, 31 : U8
    %v47 = cast %v46 : @bits(5) U8
    aggregate %local5.discriminant = 0, %local5@Small = %v47
    %v49 = call spanValue, %v40 : I32
    %v50 = alloc : Span
    %v54 = cast 4095 : U16
    %v56 = and %v54, 4095 : U16
    %v57 = cast %v56 : @bits(12) U16
    aggregate %local6.discriminant = 1, %local6@Large = %v57
    %v59 = call spanValue, %v50 : I32
    %spans = add %v49, %v59 : I32
    %v61 = alloc : Maybe(Level)
    init %local7.discriminant, 0
    %v64 = call maybeValue, %v61 : I32
    %v65 = alloc : Maybe(Level)
    %v67 = alloc : Level
    %v71 = cast 2 : U8
    %v73 = and %v71, 7 : U8
    %v74 = cast %v73 : @bits(3) U8
    aggregate %local9.discriminant = 1, %local9@Low = %v74
    aggregate %local8.discriminant = 1, %local8@Just = %v67
    %v77 = call maybeValue, %v65 : I32
    %maybes = add %v64, %v77 : I32
    %v79 = alloc : Board
    %v80 = alloc : Pick
    aggregate %local11.discriminant = 0, %local11@Left = False
    %v84 = alloc : Pick
    aggregate %local12.discriminant = 1, %local12@Right = Less
    aggregate %local10@Board.left = %v80, %local10@Board.right = %v84
    %v89 = call rightIs, %v79 : I32
    %v90 = alloc : Board
    %v91 = alloc : Pick
    aggregate %local14.discriminant = 1, %local14@Right = More
    %v95 = alloc : Pick
    aggregate %local15.discriminant = 0, %local15@Left = True
    aggregate %local13@Board.left = %v91, %local13@Board.right = %v95
    %v100 = call rightIs, %v90 : I32
    %v103 = mul %v100, 10 : I32
    %direct = add %v89, %v103 : I32
    %v107 = mul %levels, 10 : I32
    %v108 = add %picks, %v107 : I32
    %v111 = mul %spans, 100 : I32
    %v112 = add %v108, %v111 : I32
    %v115 = mul %maybes, 1000 : I32
    %v116 = add %v112, %v115 : I32
    %v117 = call written : I32
    %v120 = mul %v117, 10000 : I32
    %v121 = add %v116, %v120 : I32
    %v124 = mul %direct, 1000000 : I32
    %v125 = add %v121, %v124 : I32
    ret %v125
}
