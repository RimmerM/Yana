module ResolveTest

data Counter {at: I32}

class Reader(r -> e): next, take

instance Reader(Counter, {}): Counter.next, Counter.take

fn next'3(self: r [unique slot 0]) -> Result(e, I32) = <no body>

fn take(self: r [unique slot 0], count: I32 [shared call]) -> Result(e, I32) = <no body>

fn Counter.next(self: Counter [unique slot 0]) -> Result({}, I32) {
bb0:
  %0: I32 [unique slot 0] = read borrow.unique (self.at) loan0
  %1: I32 = const 1
  %2: {} = call +=(I32) borrow.unique %0 borrow.shared %1
  %3: I32 = read copy.trivial (self.at)
  %4: Result({}, I32) = aggregate.Ok take %3
  return take %4
}

fn Counter.take(self: Counter [unique slot 0], count: I32 [shared call]) -> Result({}, I32) {
bb0:
  %0: I32 [unique slot 0] = read borrow.unique (self.at) loan0
  %1: I32 = read copy.trivial (count)
  %2: {} = call +=(I32) borrow.unique %0 borrow.shared %1
  %3: I32 = read copy.trivial (self.at)
  %4: Result({}, I32) = aggregate.Ok take %3
  return take %4
}

fn sum'2(reader: r [unique call]) -> I32 {
  form specialized
  slot #0 type r
  slot #1 type e
  slot #2 class Reader(r, e)
  local local1: Result(e, I32)
  local a: I32
  local local3: Result(e, I32)
  local b: I32
  local local5: Result(e, I32)
  local c: I32

bb0:
  %0: r [unique slot 0] = read borrow.unique (reader) loan0
  %1: Result(e, I32) = call next'3(r, e) borrow.unique %0
  write.init borrow.unique (local1) take %1
  %3: U8 = read copy.trivial (local1.#)
  %4: U8 = const 1
  %5: Bool = eq inspect %3 inspect %4
  branch inspect %5 -> bb2 -> bb1

bb1:
  drop (local1)
  %7: I32 = const 0
  return take %7

bb2:
  %9: I32 = read copy.trivial (local1.Ok)
  drop (local1)
  write.init borrow.unique (a) take %9
  %11: r [unique slot 0] = read borrow.unique (reader) loan1
  %12: I32 = const 2
  %13: Result(e, I32) = call take(r, e) borrow.unique %11 borrow.shared %12
  write.init borrow.unique (local3) take %13
  %15: U8 = read copy.trivial (local3.#)
  %16: U8 = const 1
  %17: Bool = eq inspect %15 inspect %16
  branch inspect %17 -> bb4 -> bb3

bb3:
  drop (local3)
  %19: I32 = const 0
  return take %19

bb4:
  %21: I32 = read copy.trivial (local3.Ok)
  drop (local3)
  write.init borrow.unique (b) take %21
  %23: r [unique slot 0] = read borrow.unique (reader) loan2
  %24: Result(e, I32) = call next'3(r, e) borrow.unique %23
  write.init borrow.unique (local5) take %24
  %26: U8 = read copy.trivial (local5.#)
  %27: U8 = const 1
  %28: Bool = eq inspect %26 inspect %27
  branch inspect %28 -> bb6 -> bb5

bb5:
  drop (local5)
  %30: I32 = const 0
  return take %30

bb6:
  %32: I32 = read copy.trivial (local5.Ok)
  drop (local5)
  write.init borrow.unique (c) take %32
  %34: I32 = read copy.trivial (a)
  %35: I32 = read copy.trivial (b)
  %36: I32 = add inspect %34 inspect %35
  %37: I32 = read copy.trivial (c)
  %38: I32 = add inspect %36 inspect %37
  return take %38
}

fn main() -> I32 {
  local & counter: Counter

bb0:
  %0: I32 = const 3
  %1: Counter = aggregate.Counter take %0
  write.init borrow.unique (counter) take %1
  %3: Counter [unique call] = read borrow.unique (counter) loan0
  %4: I32 = call sum'2(Counter, {}) borrow.unique %3
  return take %4
}

fn sum'2(Counter, {})(reader: Counter [unique call]) -> I32 = <sum at Counter, {}>

entry main
