@image$base = []
mut @parenthesized = [0, 0, 0, 0]
mut @overAnExpression = [0, 0, 0, 0]
mut @overAName = [0, 0, 0, 0]
mut @overAQuotient = [0, 0, 0, 0]
mut @twice = [0, 0, 0, 0]
mut @ascribed = [0, 0, 0, 0, 0, 0, 0, 0]

main<complex>(): I32 {
  b_0 {
    %v_1 = loads @parenthesized, 4: I32
    %v_2 = cmp_eq %v_1, 18446744073709551595: I32
    je %v_2, b_3, b_4
  }

  b_3 {
    jmp b_5
  }

  b_4 {
    jmp b_5
  }

  b_5 {
    %v_6 = phi [b_3, 1], [b_4, 0]: I32
    %v_7 = loads @overAnExpression, 4: I32
    %v_8 = cmp_eq %v_7, 18446744073709551595: I32
    je %v_8, b_9, b_10
  }

  b_9 {
    %v_11 = add %v_6, 2: I32
    jmp b_12
  }

  b_10 {
    jmp b_12
  }

  b_12 {
    %v_13 = phi [b_9, %v_11], [b_10, %v_6]: I32
    %v_14 = loads @overAName, 4: I32
    %v_15 = cmp_eq %v_14, 18446744073709551216: I32
    je %v_15, b_16, b_17
  }

  b_16 {
    %v_18 = add %v_13, 4: I32
    jmp b_19
  }

  b_17 {
    jmp b_19
  }

  b_19 {
    %v_20 = phi [b_16, %v_18], [b_17, %v_13]: I32
    %v_21 = loads @overAQuotient, 4: I32
    %v_22 = cmp_eq %v_21, 18446744073709551566: I32
    je %v_22, b_23, b_24
  }

  b_23 {
    %v_25 = add %v_20, 8: I32
    jmp b_26
  }

  b_24 {
    jmp b_26
  }

  b_26 {
    %v_27 = phi [b_23, %v_25], [b_24, %v_20]: I32
    %v_28 = loads @twice, 4: I32
    %v_29 = cmp_eq %v_28, 256: I32
    je %v_29, b_30, b_31
  }

  b_30 {
    %v_32 = add %v_27, 16: I32
    jmp b_33
  }

  b_31 {
    jmp b_33
  }

  b_33 {
    %v_34 = phi [b_30, %v_32], [b_31, %v_27]: I32
    %v_35 = loads @ascribed, 8: I64
    %v_36 = cmp_eq %v_35, 18446744073709551610: I32
    je %v_36, b_37, b_38
  }

  b_37 {
    %v_39 = add %v_34, 32: I32
    jmp b_40
  }

  b_38 {
    jmp b_40
  }

  b_40 {
    %v_41 = phi [b_37, %v_39], [b_38, %v_34]: I32
    ret %v_41
  }
}

main$<complex>(): I32 {
  b_0 {
    store @parenthesized, 18446744073709551595, 4
    store @overAnExpression, 18446744073709551595, 4
    store @overAName, 18446744073709551216, 4
    store @overAQuotient, 18446744073709551566, 4
    store @twice, 256, 4
    store @ascribed, 18446744073709551610, 8
    %v_1 = call_complex main: I32
    ret %v_1
  }
}

