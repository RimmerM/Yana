  %13: Cell [shared slot 0] = call.subscript get(Array(Cell), Size, Cell) borrow.shared %12 borrow.shared %11 roots{1}
  write.init borrow.unique (local3) borrow.shared %13
  %15: I64 = read copy.trivial (local3.a)
  %16: I64 = add inspect %10 inspect %15
  %17: Size = read copy.trivial (i)
  %18: Array(Cell) [shared call view] = read borrow.shared (xs) loan2
  %19: Cell [shared slot 0] = call.subscript get(Array(Cell), Size, Cell) borrow.shared %18 borrow.shared %17 roots{2}
  write.init borrow.unique (local4) borrow.shared %19
  %21: I64 = read copy.trivial (local4.c)
  %22: I64 = add inspect %16 inspect %21
  write.assign borrow.unique (acc) take %22
  %24: Size = read copy.trivial (i)
  %25: Size = const 1
  %26: Size = add inspect %24 inspect %25
  write.assign borrow.unique (i) take %26
  jump -> bb1
}

