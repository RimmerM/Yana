"use strict";
// ResolveTest
function addTo(target, amount) {
  target.$v = target.$v + amount | 0;
  return;
}

function accumulate(n) {
  var total = 0;
  total = total + n | 0;
  total = Math.imul(total, 2) | 0;
  return total;
}

function shared(n) {
  var total = { $v: 0 };
  addTo(total, n);
  total.$v = total.$v + 1 | 0;
  return total.$v;
}

function main() {
  return accumulate(5) + shared(5) | 0;
}
