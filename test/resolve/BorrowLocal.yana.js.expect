"use strict";
// ResolveTest
function addTo(target, amount) {
  target.$v = target.$v + amount | 0;
  return;
}

function accumulate(n) {
  return Math.imul(n, 2) | 0;
}

function shared(n) {
  var total = { $v: 0 };
  addTo(total, n);
  var v10 = total.$v + 1 | 0;
  total.$v = v10;
  return v10;
}

function main() {
  return accumulate(5) + shared(5) | 0;
}
