mut @dynamic = [0, 0, 0, 0]
mut @counter = [0, 0, 0, 0]
@origin = [1, 0, 0, 0, 2, 0, 0, 0]
@greeting = [0, 0, 0, 0, 0, 0, 0, 0, 2, 0, 0, 0, 2, 0, 0, 0]
@string = [97, 98]

countdown<complex>(%k: I32): I32 {
  b_0 {
    %v_1 = phi [b_2, %k], [b_3, %v_4]: I32
    %v_5 = cmp_ile %v_1, 0: I32
    je %v_5, b_6, b_3
  }

  b_3 {
    %v_4 = sub %v_1, 1: I32
    jmp b_0
  }

  b_6 {
    %v_7 = loads @dynamic, 4: I32
    ret %v_7
  }
}

main$<complex>(): I32 {
  b_0 {
    store @dynamic, 7, 4
    %v_1 = loads @counter, 4: I32
    %v_2 = add %v_1, 20: I32
    store @counter, %v_2, 4
    %v_3 = call_complex countdown, 3: I32
    %v_4 = cmp_eq %v_3, 7: I32
    %v_5 = loads @counter, 4: I32
    %v_6 = cmp_eq %v_5, 20: I32
    %v_7 = add %v_4, 2: I32
    %v_8 = select %v_6, %v_7, %v_4: I32
    %origin = global @origin: Ptr
    %v_9 = load %origin, 4: I32
    %v_10 = add %origin, 4: Ptr
    %v_11 = load %v_10, 4: I32
    %v_12 = add %v_9, %v_11: I32
    %v_13 = cmp_eq %v_12, 3: I32
    %v_14 = add %v_8, 4: I32
    %v_15 = select %v_13, %v_14, %v_8: I32
    %greeting = global @greeting: Ptr
    %v_16 = load %greeting, 8: Ptr
    %v_17 = add %greeting, 12: Ptr
    %v_18 = load %v_17, 4: I32
    %v_19 = cast %v_18: I64
    %v_20 = sext %v_19: I32
    %v_21 = cmp_eq %v_20, 2: I32
    %v_22 = add %v_15, 8: I32
    %v_23 = select %v_21, %v_22, %v_15: I32
