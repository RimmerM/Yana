mut @dynamic = [0, 0, 0, 0]
mut @counter = [0, 0, 0, 0]

countdown<complex>(%k: I32): I32 {
  b_0 {
    %v_1 = phi [b_2, %k], [b_3, %v_4]: I32
    %v_5 = cmp_ile %v_1, 0: I32
    je %v_5, b_6, b_3
  }

  b_3 {
    %v_4 = sub %v_1, 1: I32
    jmp b_0
  }

  b_6 {
    %v_7 = loads @dynamic, 4: I32
    ret %v_7
  }
}

main$<complex>(): I32 {
  b_0 {
    store @dynamic, 7, 4
    %v_1 = loads @counter, 4: I32
    %v_2 = add %v_1, 20: I32
    store @counter, %v_2, 4
    %v_3 = call_complex countdown, 3: I32
    %v_4 = cmp_eq %v_3, 7: I32
    %v_5 = loads @counter, 4: I32
    %v_6 = cmp_eq %v_5, 20: I32
    %v_7 = add %v_4, 2: I32
    %v_8 = select %v_6, %v_7, %v_4: I32
    %v_9 = add %v_8, 12: I32
    ret %v_9
  }
}

