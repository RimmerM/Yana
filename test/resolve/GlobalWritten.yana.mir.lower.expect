    %v_8 = add %greeting, 8: Ptr
    %v_9 = load %v_3, 4: I64
    store %v_8, %v_9, 4
    %v_10 = add %greeting, 12: Ptr
    store %v_10, 2, 4
    %v_11 = loads @counter, 4: I32
    %v_12 = add %v_11, 20: I32
    store @counter, %v_12, 4
    %v_13 = call_complex countdown, 3: I32
    %v_14 = cmp_eq %v_13, 7: I32
    %v_15 = loads @counter, 4: I32
    %v_16 = cmp_eq %v_15, 20: I32
    %v_17 = add %v_14, 2: I32
    %v_18 = select %v_16, %v_17, %v_14: I32
    %origin = global @origin: Ptr
    %v_19 = load %origin, 4: I32
    %v_20 = add %origin, 4: Ptr
    %v_21 = load %v_20, 4: I32
    %v_22 = add %v_19, %v_21: I32
    %v_23 = cmp_eq %v_22, 3: I32
    %v_24 = add %v_18, 4: I32
    %v_25 = select %v_23, %v_24, %v_18: I32
    %greeting = global @greeting: Ptr
    %v_26 = load %greeting, 8: Ptr
    %v_27 = add %greeting, 12: Ptr
    %v_28 = load %v_27, 4: I32
    %v_29 = cast %v_28: I64
    %v_30 = sext %v_29: I32
    %v_31 = cmp_eq %v_30, 2: I32
    %v_32 = add %v_25, 8: I32
