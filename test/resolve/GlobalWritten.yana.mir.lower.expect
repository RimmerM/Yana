@string = [97, 98]
@runBorrowed = [0, 0, 0, 0]

countdown<complex>(%k: I32): I32 {
  b_0 {
    %v_1 = phi [b_2, %k], [b_3, %v_4]: I32
    %v_5 = cmp_ile %v_1, 0: I32
    je %v_5, b_6, b_3
  }

  b_3 {
    %v_4 = sub %v_1, 1: I32
    jmp b_0
  }

  b_6 {
    %v_7 = loads @dynamic, 4: I32
    ret %v_7
  }
}

main$<complex>(): I32 {
  b_0 {
    store @dynamic, 7, 4
    %v_1 = load @runBorrowed, 4: I32
    %v_2 = and %v_1, 3: I32
    %v_3 = alloca 4, 8: Ptr
    %v_4 = load %v_3, 4: I64
