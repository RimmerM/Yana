fn allocateHeap(%size: I64) -> %U8 {
  b0:
    %v1 = load heapFree : %%U8
    %v2 = cast %v1 : Long
    %v4 = cmp_eq %v2, 0 : Bool
    je %v4, b1, b2

  b1:
    call initHeap
    %v7 = load heapFree : %%U8
    %v8 = cast %v7 : Long
    %v10 = cmp_eq %v8, 0 : Bool
    je %v10, b3, b4

  b2:
    jmp b6

  b3:
    %v13 = cast 0 : %U8
