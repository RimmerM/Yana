@image$base = []
mut @heapFree = [0, 0, 0, 0, 0, 0, 0, 0]

Reclaim(Array(a)).reclaim(I32)<complex>(%value: Ptr) {
  b_0 {
    %v_1 = add %value, 8: Ptr
    %v_2 = load %v_1, 4: I32
    %v_3 = shr %v_2, 30: I32
    %v_4 = cmp_eq %v_3, 1: I32
    je %v_4, b_5, b_6
  }

  b_5 {
    %v_7 = load %value, 8: Ptr
    call_complex freeHeap, %v_7
    jmp b_6
  }

  b_6 {
    ret 
  }
}

freeHeap<complex>(%allocation: Ptr) {
  b_0 {
    %v_1 = bitcast %allocation: I64
    %v_2 = cmp_eq %v_1, 0: I32
    je %v_2, b_3, b_4
  }

  b_3 {
    ret 
  }

  b_4 {
    jmp b_5
  }

  b_5 {
    %v_6 = sub %allocation, 8: Ptr
    %sizeClass = loads %v_6, 8: I64
    %v_7 = load @heapFree, 8: Ptr
    %v_8 = shl %sizeClass, 3: I64
    %v_9 = add %v_7, %v_8: Ptr
    %v_10 = load %v_9, 8: Ptr
    store %allocation, %v_10, 8
    %v_11 = load @heapFree, 8: Ptr
    %v_12 = add %v_11, %v_8: Ptr
    store %v_12, %allocation, 8
    ret 
  }
}

main<complex>(): I64 {
  b_0 {
    %v_1 = alloca 16, 8: Ptr
    %v_2 = alloca 12, 4: Ptr
    store %v_1, %v_2, 8
    %v_3 = add %v_1, 8: Ptr
    %v_4 = load %v_3, 4: I32
    store %v_3, 3, 4
    store %v_2, 100, 4
    %v_5 = add %v_2, 4: Ptr
    store %v_5, 2, 4
    %v_6 = add %v_2, 8: Ptr
    store %v_6, 2, 4
    %v_7 = add %v_1, 12: Ptr
    store %v_7, 3, 4
    call_complex Reclaim(Array(a)).reclaim(I32), %v_1
    ret 4
  }
}

