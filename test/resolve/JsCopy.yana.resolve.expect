let image$base: () = <none>

fn seed() -> I32 {
  b0:
    ret 5
}

fn next(%n: I32) -> I32 {
  b0:
    %v3 = add %n, 1 : I32
    ret %v3
}

fn barrier(%flag: Bool) -> I32 {
  b0:
    %v1 = call seed : I32
    %acc = alloc : I32
    init %acc, %v1
    je %flag, b1, b2

  b1:
    %v5 = load %acc : I32
    %v6 = call next, %v5 : I32
    assign %acc, %v6
    jmp b3

  b2:
    jmp b3

  b3:
    %held = load %acc : I32
    %v11 = load %acc : I32
    %v12 = call next, %v11 : I32
    assign %acc, %v12
    %v16 = mul %held, 100 : I32
    %v17 = load %acc : I32
    %v18 = add %v16, %v17 : I32
    ret %v18
}

fn taken(%flag: Bool) -> I32 {
  b0:
    %v1 = call seed : I32
    %acc = alloc : I32
    init %acc, %v1
    je %flag, b1, b2

  b1:
    %v5 = load %acc : I32
    %v6 = call next, %v5 : I32
    assign %acc, %v6
    jmp b3

  b2:
    jmp b3

  b3:
    %held = load %acc : I32
    %v13 = mul %held, 100 : I32
    %v14 = add %v13, %held : I32
    %v15 = load %acc : I32
    %v16 = add %v14, %v15 : I32
    ret %v16
}

fn main() -> I32 {
  b0:
    %v1 = call barrier, True : I32
    %v3 = call barrier, False : I32
    %v6 = mul %v3, 1000 : I32
    %v7 = add %v1, %v6 : I32
    %v9 = call taken, True : I32
    %v12 = mul %v9, 1000000 : I32
    %v13 = add %v7, %v12 : I32
    ret %v13
}
