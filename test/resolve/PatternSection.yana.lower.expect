@image$base = []

positivePayload<complex>(%m: Ptr): I32 {
  b_0 {
    %v_1 = loads %m, 4: I32
    %v_2 = cmp_eq %v_1, 1: I32
    je %v_2, b_3, b_4
  }

  b_4 {
    %v_5 = cmp_eq %v_1, 1: I32
    %v_6 = select %v_5, 2, 3: I32
    jmp b_7
  }

  b_3 {
    %v_8 = add %m, 4: Ptr
    %v_9 = loads %v_8, 4: I32
    %v_10 = cmp_igt %v_9, 0: I32
    je %v_10, b_11, b_4
  }

  b_11 {
    jmp b_7
  }

  b_7 {
    %v_12 = phi [b_11, 1], [b_4, %v_6]: I32
    ret %v_12
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 8, 4: Ptr
    store %v_1, 1, 4
    %v_2 = add %v_1, 4: Ptr
    store %v_2, 4, 4
    %v_3 = call_complex positivePayload, %v_1: I32
    %v_4 = add %v_3, 18446744073709551520: I32
    %v_5 = alloca 8, 4: Ptr
    store %v_5, 1, 4
    %v_6 = add %v_5, 4: Ptr
    store %v_6, 18446744073709551612, 4
    %v_7 = call_complex positivePayload, %v_5: I32
    %v_8 = imul %v_7, 10: I32
    %v_9 = add %v_4, %v_8: I32
    %v_10 = alloca 8, 4: Ptr
    store %v_10, 0, 4
    %v_11 = call_complex positivePayload, %v_10: I32
    %v_12 = imul %v_11, 100: I32
    %v_13 = add %v_9, %v_12: I32
    ret %v_13
  }
}

