data Inner(e) = Broken {Broken: e} | Short drop derived reclaim derived

data Outer(e) = Wrapped {Wrapped: Inner(e)} | Refused drop derived reclaim derived

data Buffer {bytes: Array(U8), at: Size} reclaim derived

data Inner(String) = Broken {Broken: String} | Short of Inner reclaim derived

data Outer(String) = Wrapped {Wrapped: Inner(String)} | Refused of Outer reclaim derived

data Inner(I32) = Broken {Broken: I32} | Short of Inner

data Outer(I32) = Wrapped {Wrapped: Inner(I32)} | Refused of Outer

instance Widen(Inner(e), Outer(e)): Inner(e).widen

