{-
   The conversions that change a vector's lane count - `unpackLow`, `unpackHigh` and `packLanes` -
   at every integer lane width and both signednesses.

   The x64 backend has no register for the half-width value between the two instructions each of
   these is written as, so `expandLaneCountConversions` rewrites the pair into interleaves, gathers
   and bitcasts. Every lane is checked against the scalar conversion of the lane it came from, so a
   gather reading the wrong byte or an interleave reading the wrong half answers a number other than
   zero, and the number names the pair and the lane. A lane index has to be written down, which is
   why the checks are spelled out one lane at a time.
-}

@noinline fn widenU8(v: Vec(U8)) -> Int:
    let low = unpackLow(v) :: Vec(U16)
    let high = unpackHigh(v) :: Vec(U16)

    if lane(low, 0) != (lane(v, 0) :: U16) then return 1000
    if lane(high, 0) != (lane(v, 8) :: U16) then return 1100
    if lane(low, 1) != (lane(v, 1) :: U16) then return 1001
    if lane(high, 1) != (lane(v, 9) :: U16) then return 1101
    if lane(low, 2) != (lane(v, 2) :: U16) then return 1002
    if lane(high, 2) != (lane(v, 10) :: U16) then return 1102
    if lane(low, 3) != (lane(v, 3) :: U16) then return 1003
    if lane(high, 3) != (lane(v, 11) :: U16) then return 1103
    if lane(low, 4) != (lane(v, 4) :: U16) then return 1004
    if lane(high, 4) != (lane(v, 12) :: U16) then return 1104
    if lane(low, 5) != (lane(v, 5) :: U16) then return 1005
    if lane(high, 5) != (lane(v, 13) :: U16) then return 1105
    if lane(low, 6) != (lane(v, 6) :: U16) then return 1006
    if lane(high, 6) != (lane(v, 14) :: U16) then return 1106
    if lane(low, 7) != (lane(v, 7) :: U16) then return 1007
    if lane(high, 7) != (lane(v, 15) :: U16) then return 1107

    return 0

@noinline fn narrowU8(a: Vec(U16), b: Vec(U16)) -> Int:
    let packed = packLanes(a, b) :: Vec(U8)

    if lane(packed, 0) != (truncate(lane(a, 0)) :: U8) then return 1200
    if lane(packed, 8) != (truncate(lane(b, 0)) :: U8) then return 1300
    if lane(packed, 1) != (truncate(lane(a, 1)) :: U8) then return 1201
    if lane(packed, 9) != (truncate(lane(b, 1)) :: U8) then return 1301
    if lane(packed, 2) != (truncate(lane(a, 2)) :: U8) then return 1202
    if lane(packed, 10) != (truncate(lane(b, 2)) :: U8) then return 1302
    if lane(packed, 3) != (truncate(lane(a, 3)) :: U8) then return 1203
    if lane(packed, 11) != (truncate(lane(b, 3)) :: U8) then return 1303
    if lane(packed, 4) != (truncate(lane(a, 4)) :: U8) then return 1204
    if lane(packed, 12) != (truncate(lane(b, 4)) :: U8) then return 1304
    if lane(packed, 5) != (truncate(lane(a, 5)) :: U8) then return 1205
    if lane(packed, 13) != (truncate(lane(b, 5)) :: U8) then return 1305
    if lane(packed, 6) != (truncate(lane(a, 6)) :: U8) then return 1206
    if lane(packed, 14) != (truncate(lane(b, 6)) :: U8) then return 1306
    if lane(packed, 7) != (truncate(lane(a, 7)) :: U8) then return 1207
    if lane(packed, 15) != (truncate(lane(b, 7)) :: U8) then return 1307

    return 0

@noinline fn widenI8(v: Vec(I8)) -> Int:
    let low = unpackLow(v) :: Vec(I16)
    let high = unpackHigh(v) :: Vec(I16)

    if lane(low, 0) != (lane(v, 0) :: I16) then return 2000
    if lane(high, 0) != (lane(v, 8) :: I16) then return 2100
    if lane(low, 1) != (lane(v, 1) :: I16) then return 2001
    if lane(high, 1) != (lane(v, 9) :: I16) then return 2101
    if lane(low, 2) != (lane(v, 2) :: I16) then return 2002
    if lane(high, 2) != (lane(v, 10) :: I16) then return 2102
    if lane(low, 3) != (lane(v, 3) :: I16) then return 2003
    if lane(high, 3) != (lane(v, 11) :: I16) then return 2103
    if lane(low, 4) != (lane(v, 4) :: I16) then return 2004
    if lane(high, 4) != (lane(v, 12) :: I16) then return 2104
    if lane(low, 5) != (lane(v, 5) :: I16) then return 2005
    if lane(high, 5) != (lane(v, 13) :: I16) then return 2105
    if lane(low, 6) != (lane(v, 6) :: I16) then return 2006
    if lane(high, 6) != (lane(v, 14) :: I16) then return 2106
    if lane(low, 7) != (lane(v, 7) :: I16) then return 2007
    if lane(high, 7) != (lane(v, 15) :: I16) then return 2107

    return 0

@noinline fn narrowI8(a: Vec(I16), b: Vec(I16)) -> Int:
    let packed = packLanes(a, b) :: Vec(I8)

    if lane(packed, 0) != (truncate(lane(a, 0)) :: I8) then return 2200
    if lane(packed, 8) != (truncate(lane(b, 0)) :: I8) then return 2300
    if lane(packed, 1) != (truncate(lane(a, 1)) :: I8) then return 2201
    if lane(packed, 9) != (truncate(lane(b, 1)) :: I8) then return 2301
    if lane(packed, 2) != (truncate(lane(a, 2)) :: I8) then return 2202
    if lane(packed, 10) != (truncate(lane(b, 2)) :: I8) then return 2302
    if lane(packed, 3) != (truncate(lane(a, 3)) :: I8) then return 2203
    if lane(packed, 11) != (truncate(lane(b, 3)) :: I8) then return 2303
    if lane(packed, 4) != (truncate(lane(a, 4)) :: I8) then return 2204
    if lane(packed, 12) != (truncate(lane(b, 4)) :: I8) then return 2304
    if lane(packed, 5) != (truncate(lane(a, 5)) :: I8) then return 2205
    if lane(packed, 13) != (truncate(lane(b, 5)) :: I8) then return 2305
    if lane(packed, 6) != (truncate(lane(a, 6)) :: I8) then return 2206
    if lane(packed, 14) != (truncate(lane(b, 6)) :: I8) then return 2306
    if lane(packed, 7) != (truncate(lane(a, 7)) :: I8) then return 2207
    if lane(packed, 15) != (truncate(lane(b, 7)) :: I8) then return 2307

    return 0

@noinline fn widenU16(v: Vec(U16)) -> Int:
    let low = unpackLow(v) :: Vec(U32)
    let high = unpackHigh(v) :: Vec(U32)

    if lane(low, 0) != (lane(v, 0) :: U32) then return 3000
    if lane(high, 0) != (lane(v, 4) :: U32) then return 3100
    if lane(low, 1) != (lane(v, 1) :: U32) then return 3001
    if lane(high, 1) != (lane(v, 5) :: U32) then return 3101
    if lane(low, 2) != (lane(v, 2) :: U32) then return 3002
    if lane(high, 2) != (lane(v, 6) :: U32) then return 3102
    if lane(low, 3) != (lane(v, 3) :: U32) then return 3003
    if lane(high, 3) != (lane(v, 7) :: U32) then return 3103

    return 0

@noinline fn narrowU16(a: Vec(U32), b: Vec(U32)) -> Int:
    let packed = packLanes(a, b) :: Vec(U16)

    if lane(packed, 0) != (truncate(lane(a, 0)) :: U16) then return 3200
    if lane(packed, 4) != (truncate(lane(b, 0)) :: U16) then return 3300
    if lane(packed, 1) != (truncate(lane(a, 1)) :: U16) then return 3201
    if lane(packed, 5) != (truncate(lane(b, 1)) :: U16) then return 3301
    if lane(packed, 2) != (truncate(lane(a, 2)) :: U16) then return 3202
    if lane(packed, 6) != (truncate(lane(b, 2)) :: U16) then return 3302
    if lane(packed, 3) != (truncate(lane(a, 3)) :: U16) then return 3203
    if lane(packed, 7) != (truncate(lane(b, 3)) :: U16) then return 3303

    return 0

