    if lane(low, 0) != (lane(v, 0) :: I32) then return 4000
    if lane(high, 0) != (lane(v, 4) :: I32) then return 4100
    if lane(low, 1) != (lane(v, 1) :: I32) then return 4001
    if lane(high, 1) != (lane(v, 5) :: I32) then return 4101
    if lane(low, 2) != (lane(v, 2) :: I32) then return 4002
    if lane(high, 2) != (lane(v, 6) :: I32) then return 4102
    if lane(low, 3) != (lane(v, 3) :: I32) then return 4003
    if lane(high, 3) != (lane(v, 7) :: I32) then return 4103

