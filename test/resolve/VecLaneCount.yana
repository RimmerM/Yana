@noinline fn narrowI16(a: Vec(I32), b: Vec(I32)) -> Int:
    let packed = packLanes(a, b) :: Vec(I16)

    if lane(packed, 0) != (truncate(lane(a, 0)) :: I16) then return 4200
    if lane(packed, 4) != (truncate(lane(b, 0)) :: I16) then return 4300
    if lane(packed, 1) != (truncate(lane(a, 1)) :: I16) then return 4201
    if lane(packed, 5) != (truncate(lane(b, 1)) :: I16) then return 4301
    if lane(packed, 2) != (truncate(lane(a, 2)) :: I16) then return 4202
    if lane(packed, 6) != (truncate(lane(b, 2)) :: I16) then return 4302
    if lane(packed, 3) != (truncate(lane(a, 3)) :: I16) then return 4203
    if lane(packed, 7) != (truncate(lane(b, 3)) :: I16) then return 4303

