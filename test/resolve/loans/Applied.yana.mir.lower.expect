mut @trace = [0, 0, 0, 0]

Guard.drop<complex>(%value: Ptr) {
  b_0 {
    %v_1 = load %value, 4: I32
    %v_2 = loads @trace, 4: I32
    %v_3 = add %v_2, %v_1: I32
    store @trace, %v_3, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    store %v_1, 1, 4
    call_complex Guard.drop, %v_1
    %v_2 = alloca 4, 4: Ptr
    store %v_2, 2, 4
    call_complex Guard.drop, %v_2
    %v_3 = alloca 4, 4: Ptr
    %v_4 = alloca 4, 4: Ptr
    store %v_3, 3, 4
    store %v_4, 4, 4
    %v_5 = loads %v_3, 4: I32
    %v_6 = add 40, %v_5: I32
    call_complex Guard.drop, %v_3
    call_complex Guard.drop, %v_4
    %v_7 = add 44, %v_6: I32
    %v_8 = loads @trace, 4: I32
    %v_9 = add %v_7, %v_8: I32
    ret %v_9
  }
}

