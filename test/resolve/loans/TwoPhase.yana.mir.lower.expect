mut @trace = [0, 0, 0, 0]

Guard.drop<complex>(%value: Ptr) {
  b_0 {
    %v_1 = load %value, 4: I32
    %v_2 = loads @trace, 4: I32
    %v_3 = add %v_2, %v_1: I32
    store @trace, %v_3, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    %v_2 = alloca 8, 4: Ptr
    store %v_1, 6, 4
    store %v_2, 5, 4
    %v_3 = imm 1: I32
    %v_4 = add %v_2, 4: Ptr
    store %v_4, %v_3, 4
    %v_5 = loads %v_2, 4: I32
    %v_6 = add %v_5, %v_3: I32
    %v_7 = add %v_5, %v_6: I32
    store %v_2, %v_7, 4
    %v_8 = loads %v_1, 4: I32
    call_complex Guard.drop, %v_1
    %v_9 = loads %v_2, 4: I32
    call_complex Guard.drop, %v_2
    %v_10 = add %v_8, %v_9: I32
    %v_11 = loads @trace, 4: I32
    %v_12 = add %v_10, %v_11: I32
    ret %v_12
  }
}

