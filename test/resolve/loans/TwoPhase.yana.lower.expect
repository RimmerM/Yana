@image$base = []
mut @trace = [0, 0, 0, 0]

bump<complex>(%g: Ptr, %by: I32) {
  b_0 {
    %v_1 = loads %g, 4: I32
    %v_2 = add %v_1, %by: I32
    store %g, %v_2, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = imm 6: I32
    %v_2 = alloca 8, 4: Ptr
    store %v_2, 5, 4
    %v_3 = add %v_2, 4: Ptr
    store %v_3, 1, 4
    call_complex bump, %v_2, 6
    %v_4 = loads @trace, 4: I32
    %v_5 = add %v_4, %v_1: I32
    %v_6 = loads %v_2, 4: I32
    %v_7 = add %v_5, %v_6: I32
    store @trace, %v_7, 4
    %v_8 = add %v_6, %v_1: I32
    %v_9 = add %v_8, %v_7: I32
    ret %v_9
  }
}

