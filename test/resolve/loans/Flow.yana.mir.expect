bb1:
  %8: Guard [shared call] = read borrow.shared (p.left) loan0
  jump -> bb3(borrow.shared %8)

bb2:
  %9: Guard [shared call] = read borrow.shared (p.right) loan1
  jump -> bb3(borrow.shared %9)

bb3(%10: Guard [shared call]):
  %13: I32 = call idOf borrow.shared %10
  drop (p)
  return take %13
}

