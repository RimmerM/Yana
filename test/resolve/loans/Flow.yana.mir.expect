  %13: I32 = read copy.trivial (i)
  %14: {} = call setN borrow.unique %12 borrow.shared %13
  %15: Box [shared call] = read borrow.shared (b) loan1
  write.init borrow.unique (d) borrow.shared %15
  %17: I32 = read copy.trivial (total)
  %18: Box [shared call] = read borrow.shared (d) loan2 roots{1}
  %19: I32 = call peek borrow.shared %18
  %20: I32 = add inspect %17 inspect %19
  write.assign borrow.unique (total) take %20
  %22: I32 = read copy.trivial (i)
  %23: I32 = const 1
  %24: I32 = add inspect %22 inspect %23
  write.assign borrow.unique (i) take %24
  jump -> bb1

bb3:
  drop (b)
  %27: I32 = read copy.trivial (total)
  return take %27
}

