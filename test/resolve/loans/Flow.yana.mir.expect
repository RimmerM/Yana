module ResolveTest

data Guard {id: I32} drop authored

data Pair {left: Guard, right: Guard} drop derived

data Box {inner: Guard, n: I32} drop derived

instance Drop(Guard): Guard.drop

let & trace: I32 = 0

fn Guard.drop(value: Guard) -> {} {
bb0:
  %0: I32 = read copy.trivial (global trace)
  %1: I32 = const 1
  %2: I32 = add inspect %0 inspect %1
  write.assign borrow.unique (global trace) take %2
  return
}

fn guard(id: I32 [shared call]) -> Guard {
bb0:
  %0: I32 = read copy.trivial (id)
  %1: Guard = aggregate take %0
  return take %1
}

fn idOf(g: Guard [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (g.id)
  return take %0
}

fn box(n: I32 [shared call]) -> Box {
bb0:
  %0: I32 = const 1
  %1: Guard = call guard borrow.shared %0
  %2: I32 = read copy.trivial (n)
  %3: Box = aggregate take %1 take %2
  return take %3
}

fn peek(b: Box [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (b.n)
  return take %0
}

fn setN(b: Box [unique call], n: I32 [shared call]) -> {} {
bb0:
  %0: I32 = read copy.trivial (n)
  write.assign borrow.unique (b.n) take %0
  return
}

