    %v_6 = load %v_5, 8: Ptr
    %v_7 = loads %v_6, 4: I32
    %v_8 = imul %v_7, 10000: I32
    %v_9 = add 20000000, %v_8: I32
    %v_10 = alloca 8, 8: Ptr
    %v_11 = alloca 12, 4: Ptr
