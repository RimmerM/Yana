    %v_14 = call_complex id, %v_10: Ptr
    %v_15 = load %v_14, 8: Ptr
    %v_16 = loads %v_15, 4: I32
    %v_17 = imul %v_16, 100: I32
    %v_18 = add %v_9, %v_17: I32
    %v_19 = alloca 8, 8: Ptr
    %v_20 = alloca 8, 8: Ptr
