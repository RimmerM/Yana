
id<complex>(%p: Ptr): Ptr {
  b_0 {
    ret %p
  }
}

pick<complex>(%a: Ptr, %b: Ptr, %k: I32): Ptr {
  b_0 {
    %v_1 = cmp_igt %k, 0: I32
    je %v_1, b_2, b_3
  }

  b_3 {
    jmp b_4
  }

  b_4 {
    %v_5 = phi [b_3, %b], [b_2, %a]: Ptr
    ret %v_5
  }

  b_2 {
    jmp b_4
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 8, 8: Ptr
    %v_2 = alloca 12, 4: Ptr
