
main<complex>(): I32 {
  b_0 {
    jmp b_1
  }

  b_2 {
    %v_3 = cmp_ilt %v_4, 3: I32
    je %v_3, b_1, b_5
  }

  b_5 {
    %v_6 = add 42765, %v_7: I32
    %v_8 = add %v_6, 7000000: I32
    ret %v_8
  }

  b_1 {
    %v_9 = phi [b_2, %v_7], [b_0, 0]: I32
    %v_10 = phi [b_2, %v_4], [b_0, 0]: I32
    %v_4 = add %v_10, 1: I32
    %v_11 = add %v_10, 4: I32
    %v_12 = imul %v_9, 100: I32
    %v_13 = imul %v_4, 10: I32
    %v_14 = add %v_12, %v_13: I32
    %v_7 = add %v_14, %v_11: I32
    jmp b_2
  }
}

