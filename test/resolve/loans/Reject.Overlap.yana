{-
   Loans that overlap, and the four ways the analysis says so.

   The grid `Exclusive.yana` accepts, with the overlaps put back. §6.4 is four rules and this file is
   four messages, because a pass that reported "these borrows conflict" for all of them would pass a
   golden and tell an author nothing: which one is exclusive and which one came second is the whole
   of what they have to change.

   Every function here is refused by `Analysis::checkLoans`, after the body is built and verified.
   The mistakes the *resolver* refuses while building are in `Reject.Exclusive.yana`, and they have
   to be a separate file for the mechanical reason `ownership/Reject.Borrowed.yana` gives: resolution
   stops before the analysis runs, so one file cannot show both.
-}

import Native

let &trace = 0 :: I32

data Guard {id: I32}

instance Drop(Guard):
    fn drop(->value: Guard):
        trace = trace + value.id

fn guard(id: I32) -> Guard = Guard {id: id}

-- Not trivially copyable, because its field is not: a `let` over one is a loan rather than a second
-- value, which is what makes every function below have two names for one object.
data Box {inner: Guard, n: I32}

fn box(n: I32) -> Box = Box {inner: guard(1), n: n}

data Pair {left: Box, right: Box}

fn peek(b: Box) -> I32 = b.n

fn mutate(&b: Box) -> I32:
    b.n = b.n + 1
    return b.n

fn twice(&a: Box, &b: Box) -> I32 = a.n + b.n

fn read(a: Box, b: Box) -> I32 = a.n + b.n

fn mutatePair(&p: Pair) -> I32:
    p.left.n = p.left.n + 1
    return p.left.n

-- A write, over a live exclusive loan.
fn writeOverExclusive() -> I32:
    let &b = box(1)
    let &d = b
    b.n = 2
    return d.n

-- A write, over a live shared one. The same write and a different reason, which is why the two
-- messages differ in one word.
fn writeOverShared() -> I32:
    let &b = box(1)
    let d = b
    b.n = 2
    return d.n

-- A shared borrow, over a live exclusive one. Exclusive means exclusive of readers too.
fn readOverExclusive() -> I32:
    let &b = box(1)
    let &d = b
    let n = peek(b)
    return n + d.n

-- An exclusive borrow, over a live shared one.
fn writeBorrowOverShared() -> I32:
    let &b = box(1)
    let d = b
    let n = mutate(b)
    return n + d.n

-- The same object in both `&` parameters of one call. The two loans are live at once by
-- construction, which is what the aliasing rule is about and what no ordering can fix.
fn aliasedArguments() -> I32:
    let &b = box(1)
    return twice(b, b)

-- A whole record and one of its fields. `placesOverlap` walks up from the field and finds the same
-- root, so these are not the disjoint pair `Exclusive.yana` accepts.
fn wholeOverField() -> I32:
    let &p = Pair {left: box(1), right: box(2)}
    let &d = p.left
    let n = mutatePair(p)
    return n + d.n

-- And the other way round: the field borrowed while the whole record is.
fn fieldOverWhole() -> I32:
    let &p = Pair {left: box(1), right: box(2)}
    let &d = p
    let n = mutate(p.right)
    return n + d.left.n

-- The same body as `Flow.yana`'s `perIteration` with two statements swapped. The borrow is made
-- before the write and read again on the *next* iteration, so it is live at the write across the
-- back edge - which a walk of the instruction list in order cannot see and the backward fixpoint
-- can. Swapping the two statements back is what makes the accepting version accepted.
fn loopCarried() -> I32:
    let &b = box(1)
    let &i = 0 :: I32
    let &total = 0 :: I32
    let d = b

    while i < 3:
        total = total + d.n
        b.n = i
        i = i + 1

    return total

-- Two lenders in one record, with only one of them written, used to be refused here - and that was
-- the approximation rather than the rule. It is `separateLenders` in `Schemas.yana` now: an origin
-- set is per schema slot, so reading one external field says nothing about the other's lender.
--
-- What stays refused is the case below, where the write is to the lender a live field *does* name.

-- A record holding a loan is the loan's extent, so writing to the lender while the reader is live
-- is the same conflict reached through one more step - see `Fields.yana` for the accepting half.
data Cell {v: I32}

data Editor {input: &src'Cell, at: I32}

fn readThrough(e: Editor) -> I32 = e.input.v + e.at

fn writeUnderReader() -> I32:
    let &c = Cell {v: 1}
    let &e = Editor {input: c, at: 0}
    c.v = 2
    return readThrough(e)

-- A whole-local write *through* a `&` binding. `d = box(2)` writes into `b`; it does not re-point
-- `d`, so `d` goes on referring to `b` and the write below meets that loan.
--
-- The strong update in `Analysis::replacedLocal` is about storage this frame *owns*, and this is the
-- half that says so: the condition is ownership and not "a write to a whole local". Read it as a
-- re-pointing and `d`'s loan of `b` disappears here, which is a write under a live exclusive borrow
-- with nothing to report it. `Refill.yana` is the accepting half.
fn writeThroughKeepsLender() -> I32:
    let &b = box(1)
    let &d = b
    d = box(2)
    b.n = 3
    return peek(d)

-- Refilling storage ends the *displaced* lender's loan, and only that one. `r` refers to `h` from
-- the assignment on, so writing `h` is a conflict where writing `g` is not - which is what says the
-- strong update replaced the origin set rather than emptied it. `Refill.yana`'s `refill` is the same
-- body with `g` written instead.
data Reader {held: s'Guard, at: I32}

fn refilledLenderStillLive() -> I32:
    let &g = guard(1)
    let &h = guard(2)
    let &r = Reader {held: g, at: 0}
    r = Reader {held: h, at: 1}
    h.id = 9
    return r.held.id

-- A write through a raw pointer read out of storage, while a unique loan of what it may point at
-- is live. The message names the storage as "what h.at points at" (J128): it used to print the
-- dump's name for the pointer's target, `[%%11]`, which is nowhere in the source.
data PointerHolder {at: %Cell}

lens fn holding(&c: Cell) -> &I32:
    yield c.v

fn throughStoredPointer() -> I32:
    let &c = Cell {v: 1}
    let h = PointerHolder {at: addressOf(c)}
    let r = holding(c) in:
        store(h.at, Cell {v: 5})
        r += 1
    return c.v

fn main() -> I32 = 0
