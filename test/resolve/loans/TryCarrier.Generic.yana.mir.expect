  %17: Result(Ended, U8) = call pair(Bytes, Ended) borrow.unique %16
  write.init borrow.unique (local3) take %17
  %19: U8 = read copy.trivial (local3.#)
  %20: U8 = const 1
  %21: Bool = eq inspect %19 inspect %20
  branch inspect %21 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %31: Input(Bytes) [unique call] = read borrow.unique (input) loan2
  %32: Result(Ended, U8) = call pair(Bytes, Ended) borrow.unique %31
  drop (input)
  write.init borrow.unique (local5) take %32
  %34: U8 = read copy.trivial (local5.#)
  %35: U8 = const 0
  %36: Bool = eq inspect %34 inspect %35
  branch inspect %36 -> bb6 -> bb4

bb3:
  %23: U8 = read copy.trivial (local3.Ok)
  write.init borrow.unique (v) take %23
  %25: I32 [unique call] = read borrow.unique (total) loan1
  %26: U8 = read copy.trivial (v)
  %27: I32 = convert inspect %26
  %28: {} = call +=(I32) borrow.unique %25 borrow.shared %27
  jump -> bb2

bb4:
  jump -> bb5

bb5:
  %43: I32 = const 10
  %44: I32 = const 20
  %45: I32 = const 30
  %46: %I32 = run.slots I32 *3
  %47: Size = bitcast inspect %46
  %48: Size = const 0
  %49: Bool = eq inspect %47 inspect %48
  %50: {} = call checkCondition borrow.shared %49
  %51: @bits(30) U32 = const 3
  %52: @bits(2) U32 = const 1
  %53: Run(I32) = aggregate.Run take %46 take %51 take %52
  %54: @bits(30) U32 = const 3
  %55: Array(I32) = aggregate.Array take %53 take %54
  write.init borrow.unique (local6) take %55
  %57: Size = const 0
  write.init borrow.unique ([%%46][0]) take %43
  %59: Size = const 1
  write.init borrow.unique ([%%46][1]) take %44
  %61: Size = const 2
  write.init borrow.unique ([%%46][2]) take %45
  %63: Array(I32) = read take (local6)
  %64: Size = const 0
  %65: Cells(I32) = aggregate.Cells take %63 take %64
  write.init borrow.unique (cells) take %65
  %67: Cells(I32) [unique call] = read borrow.unique (cells) loan4
  %68: Result(Short, I32) = call sumTwo(I32) borrow.unique %67
  write.init borrow.unique (local8) take %68
  %70: U8 = read copy.trivial (local8.#)
  %71: U8 = const 1
  %72: Bool = eq inspect %70 inspect %71
  branch inspect %72 -> bb9 -> bb7

bb6:
  %38: I32 [unique call] = read borrow.unique (total) loan3
  %39: I32 = const 100
  %40: {} = call +=(I32) borrow.unique %38 borrow.shared %39
  jump -> bb5

bb7:
  jump -> bb8

bb8:
  %83: Cells(I32) [unique call] = read borrow.unique (cells) loan6
  %84: Result(Short, I32) = call sumTwo(I32) borrow.unique %83
  drop (cells)
  write.init borrow.unique (local10) take %84
  %86: U8 = read copy.trivial (local10.#)
  %87: U8 = const 0
