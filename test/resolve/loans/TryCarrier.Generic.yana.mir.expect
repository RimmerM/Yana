  local & total: I32
  local & local1: Array(U8)
  local & input: Input(Bytes)
  local local3: Result(Ended, U8)
  local v: U8
  local local5: Result(Ended, U8)
  local & local6: Array(I32)
  local & cells: Cells(I32)
  local local8: Result(Short, I32)
  local v: I32
  local local10: Result(Short, I32)

bb0:
  %0: I32 = const 0
  write.init borrow.unique (total) take %0
  %2: U8 = const 3
  %3: Bytes = aggregate.Bytes take %2
  %4: Size = const 0
  %5: %U8 = bitcast inspect %4
  %6: @bits(30) U32 = const 0
