}

fn pair(Bytes, Ended)(input: Input(Bytes) [unique call]) -> Result(Ended, U8) = <pair at Bytes, Ended>

fn sumTwo(I32)(cells: Cells(I32) [unique call]) -> Result(Short, I32) = <sumTwo at I32>

fn takeFrom(Bytes, Ended)(self: Input(Bytes) [unique slot 0], count: Size [shared call]) -> Result(Ended, Part) [owned here shape8 .1.0=shared slot 0 view] = <takeFrom at Bytes, Ended>

fn next'3(I32)(self: Cells(I32) [unique slot 0], count: Size [shared call]) -> Result(Short, Array(I32)) [owned here shape9 .1=shared slot 0 view] = <next at I32>

entry main
