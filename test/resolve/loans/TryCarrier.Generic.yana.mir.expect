  %76: I32 [unique call] = read borrow.unique (total) loan5
  %77: I32 = read copy.trivial (v)
  %78: I32 = const 1000
  %79: I32 = mul inspect %77 inspect %78
  %80: {} = call +=(I32) borrow.unique %76 borrow.shared %79
