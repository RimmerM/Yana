module ResolveTest

data Held(a) {value: 0'a, extra: I32} shape2

data L1 {r: 0'I32} shape2

data Box2(t) {v: t} drop derived reclaim derived

data Held(I32) {value: 0'I32, extra: I32} of Held shape2

data Box2(L1) {v: L1} of Box2 shape8

fn keep(x: I32 [shared slot 0]) -> Held(I32) [owned here shape2 .0=shared slot 0] {
bb0:
  %0: I32 [shared slot 0] = read borrow.shared (x) loan0
  %1: I32 = const 0
  %2: Held(I32) [owned here shape2 .0=shared slot 0] = aggregate.Held borrow.shared %0 take %1 roots.0{0}
  return take %2
}

fn clobber(a: I32 [shared call], b: I32 [shared call], c: I32 [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (a)
  %1: I32 = read copy.trivial (b)
  %2: I32 = mul inspect %0 inspect %1
  %3: I32 = read copy.trivial (c)
  %4: I32 = add inspect %2 inspect %3
  return take %4
}

fn laterRead() -> I32 {
  local local0: I32
  local h: Held(I32) [owned here shape2 .0=shared slot 0]
  local local2: I32
  local literal: Held(I32)
  local z: I32

bb0:
  %0: I32 = const 40
  %1: I32 = const 2
  %2: I32 = add inspect %0 inspect %1
  write.init borrow.unique (local0) take %2
  %4: I32 [shared slot 0] = read borrow.shared (local0) loan0
  %5: Held(I32) [owned here shape2 .0=shared slot 0] = call keep borrow.shared %4 roots.0{0}
  write.init borrow.unique (h) take %5
  %7: I32 = const 7
  write.init borrow.unique (local2) take %7
  %9: I32 [shared slot 0] = read borrow.shared (local2) loan1
  %10: I32 = const 1
  %11: Held(I32) = aggregate.Held borrow.shared %9 take %10 roots.0{1}
  write.init borrow.unique (literal) take %11
  %13: I32 = const 7
  %14: I32 = const 8
  %15: I32 = const 9
  %16: I32 = call clobber borrow.shared %13 borrow.shared %14 borrow.shared %15
  write.init borrow.unique (z) take %16
  %18: I32 = read copy.trivial (h.value)
  %19: I32 = const 1000
  %20: I32 = mul inspect %18 inspect %19
  %21: I32 = read copy.trivial (literal.value)
  %22: I32 = const 100
  %23: I32 = mul inspect %21 inspect %22
  %24: I32 = add inspect %20 inspect %23
  %25: I32 = read copy.trivial (z)
  %26: I32 = add inspect %24 inspect %25
  return take %26
}

fn perPass() -> I32 {
  local & sum: I32
  local & local1: I32
  local i: I32
  local local3: I32
  local h: Held(I32)
  local local5: I32
  local k: Held(I32) [owned here shape2 .0=shared slot 0]

bb0:
  %0: I32 = const 0
  write.init borrow.unique (sum) take %0
  %2: I32 = const 0
  %3: I32 = const 3
  %4: I32 = const 1
  write.init borrow.unique (local1) take %2
  jump -> bb1(take %3, take %4)

bb1(%5: I32, %6: I32):
  %13: I32 = read copy.trivial (local1)
  %14: Bool = lt inspect %13 inspect %5
  branch inspect %14 -> bb4(take %5, take %6) -> bb3(take %5, take %6)

bb2(%7: I32, %8: I32):
  %46: I32 = read copy.trivial (local1)
  %47: I32 = add inspect %46 inspect %8
  write.assign borrow.unique (local1) take %47
  jump -> bb1(take %7, take %8)

bb3(%9: I32, %10: I32):
  %50: I32 = read copy.trivial (sum)
  return take %50

bb4(%15: I32, %16: I32):
  %18: I32 = read copy.trivial (local1)
  write.init borrow.unique (i) take %18
  %20: I32 = read copy.trivial (i)
  %21: I32 = const 1
  %22: I32 = add inspect %20 inspect %21
  write.init borrow.unique (local3) take %22
  %24: I32 [shared slot 0] = read borrow.shared (local3) loan0
  %25: I32 = const 0
  %26: Held(I32) = aggregate.Held borrow.shared %24 take %25 roots.0{0}
  write.init borrow.unique (h) take %26
  %28: I32 = read copy.trivial (i)
  %29: I32 = const 4
  %30: I32 = add inspect %28 inspect %29
  write.init borrow.unique (local5) take %30
  %32: I32 [shared slot 0] = read borrow.shared (local5) loan1
  %33: Held(I32) [owned here shape2 .0=shared slot 0] = call keep borrow.shared %32 roots.0{1}
  write.init borrow.unique (k) take %33
  %35: I32 = read copy.trivial (sum)
  %36: I32 = const 100
  %37: I32 = mul inspect %35 inspect %36
  %38: I32 = read copy.trivial (h.value)
  %39: I32 = const 10
  %40: I32 = mul inspect %38 inspect %39
  %41: I32 = add inspect %37 inspect %40
  %42: I32 = read copy.trivial (k.value)
  %43: I32 = add inspect %41 inspect %42
  write.assign borrow.unique (sum) take %43
  jump -> bb2(take %15, take %16)
}

fn wrap1(n: I32 [shared slot 0]) -> L1 [owned here shape2 .0=shared slot 0] {
bb0:
  %0: I32 [shared slot 0] = read borrow.shared (n) loan0
  %1: L1 [owned here shape2 .0=shared slot 0] = aggregate.L1 borrow.shared %0 roots.0{0}
  return take %1
}

fn nestedGeneric() -> I32 {
  local & n: I32
  local b: Box2(L1)

bb0:
  %0: I32 = const 7
  write.init borrow.unique (n) take %0
  %2: I32 [shared slot 0] = read borrow.shared (n) loan0
  %3: L1 [owned here shape2 .0=shared slot 0] = call wrap1 borrow.shared %2 roots.0{0}
  %4: Box2(L1) = aggregate.Box2 take %3 roots.0{0}
  write.init borrow.unique (b) take %4
  %6: I32 = read copy.trivial (b.v.r)
  return take %6
}

fn main() -> I32 {
bb0:
  %0: I32 = call laterRead
  %1: I32 = call perPass
  %2: I32 = add inspect %0 inspect %1
  %3: I32 = call nestedGeneric
  %4: I32 = const 1000000
  %5: I32 = mul inspect %3 inspect %4
  %6: I32 = add inspect %2 inspect %5
  return take %6
}

entry main
