{-
   A raw pointer's subscript, returned under the origin the pointer carries (J147).

   `get(self: source'%a, index)` names the origin of what the pointer points *at*; `p[2]` answers
   `self + 2`, which is not an address in this frame. J147's temporaries (`StoredTemporary.yana`)
   leave a pointer at such a position alone - a temporary there rooted this result in the frame too,
   and `third` was refused as returning one. Native only: `values` is.

   `thirdDirect` subscripts a pointer with no storage of its own. Since J162 the exemption is that
   call's alone (`Reject.StoredTemporary.Pointer.yana` is the position it no longer covers).
-}

fn third(xs: s'[Int]) -> s'Int:
    let p = values(xs)
    return p[2]

fn thirdDirect(xs: s'[Int]) -> s'Int = values(xs)[2]

fn main() -> Int:
    let xs = [10, 20, 30]
    return copy(third(xs)) + copy(thirdDirect(xs))
