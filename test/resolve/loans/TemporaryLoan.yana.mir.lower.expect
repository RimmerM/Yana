
clobber<complex>(%a: I32): I32 {
  b_0 {
    %v_1 = alloca 128, 4: Ptr
    setpattern %v_1, 128, 0
    jmp b_2
  }

  b_3 {
    %v_4 = cmp_ilt %v_5, 32: I32
    je %v_4, b_2, b_6
  }

  b_6 {
    %v_7 = add %v_1, 124: Ptr
    %v_8 = loads %v_7, 4: I32
    ret %v_8
  }

  b_2 {
    %v_9 = phi [b_3, %v_5], [b_0, 0]: I32
    %v_10 = sext %v_9: I64
    %v_11 = add %a, %v_9: I32
    %v_12 = shl %v_10, 2: I64
    %v_13 = add %v_1, %v_12: Ptr
    store %v_13, %v_11, 4
    %v_5 = add %v_9, 1: I32
    jmp b_3
  }
}

held<complex>(%n: I32): I32 {
  b_0 {
    %v_1 = alloca 12, 4: Ptr
    %v_2 = shl %n, 1: I32
    %v_3 = imul %n, 3: I32
    store %v_1, %n, 4
    %v_4 = add %v_1, 4: Ptr
    store %v_4, %v_2, 4
    %v_5 = add %v_1, 8: Ptr
    store %v_5, %v_3, 4
    %v_6 = call_complex clobber, 9000: I32
    %v_7 = add %v_1, 4: Ptr
    %v_8 = loads %v_7, 4: I32
    jmp b_9
  }

  b_10 {
    %v_11 = cmp_ilt %v_12, 3: I32
    je %v_11, b_9, b_13
  }

  b_9 {
    %v_14 = phi [b_10, %v_12], [b_0, 0]: I64
    %v_15 = phi [b_10, %v_16], [b_0, 0]: I32
    %v_17 = shl %v_14, 2: I64
    %v_18 = add %v_1, %v_17: Ptr
    %v_19 = loads %v_18, 4: I32
    %v_16 = add %v_15, %v_19: I32
    %v_12 = add %v_14, 1: I64
    jmp b_10
  }

  b_13 {
    %v_20 = add %v_8, %v_16: I32
    %v_21 = add %v_20, %v_6: I32
    %v_22 = sub %v_21, 9031: I32
    ret %v_22
  }
}

named<complex>(%n: I32): I32 {
  b_0 {
    %v_1 = alloca 8, 4: Ptr
    store %v_1, %n, 4
    %v_2 = add %v_1, 4: Ptr
    store %v_2, %n, 4
    jmp b_3
  }

  b_4 {
    %v_5 = cmp_ilt %v_6, 2: I32
    je %v_5, b_3, b_7
  }

  b_3 {
    %v_8 = phi [b_4, %v_6], [b_0, 0]: I64
    %v_9 = phi [b_4, %v_10], [b_0, 0]: I32
    %v_11 = shl %v_8, 2: I64
    %v_12 = add %v_1, %v_11: Ptr
    %v_13 = loads %v_12, 4: I32
    %v_10 = add %v_9, %v_13: I32
    %v_6 = add %v_8, 1: I64
    jmp b_4
  }

  b_7 {
    ret %v_10
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 12, 4: Ptr
    store %v_1, 1, 4
    %v_2 = add %v_1, 4: Ptr
    store %v_2, 2, 4
    %v_3 = add %v_1, 8: Ptr
    store %v_3, 3, 4
    jmp b_4
  }

  b_5 {
    %v_6 = cmp_ilt %v_7, 3: I32
    je %v_6, b_4, b_8
  }

  b_4 {
    %v_9 = phi [b_5, %v_7], [b_0, 0]: I64
    %v_10 = phi [b_5, %v_11], [b_0, 0]: I32
    %v_12 = shl %v_9, 2: I64
    %v_13 = add %v_1, %v_12: Ptr
    %v_14 = loads %v_13, 4: I32
    %v_11 = add %v_10, %v_14: I32
    %v_7 = add %v_9, 1: I64
    jmp b_5
  }

  b_8 {
    %v_15 = call_complex held, 5: I32
    %v_16 = call_complex named, 7: I32
    %v_17 = imul %v_11, 1000: I32
    %v_18 = imul %v_15, 10: I32
    %v_19 = add %v_17, %v_18: I32
    %v_20 = add %v_19, %v_16: I32
    ret %v_20
  }
}

