  %16: Size = const 1
  write.init borrow.unique ([%%3][1]) take %1
  %18: Size = const 2
  write.init borrow.unique ([%%3][2]) take %2
  %20: Array(U8) = read take (local1)
  %21: I32 = const 0
  %22: Feed = aggregate.Feed take %20 take %21
  write.init borrow.unique (feed) take %22
  %24: Bool = read copy.trivial (fail)
  branch inspect %24 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %53: I32 = read copy.trivial (feed.at)
  drop (feed)
  %54: Result(Fault, I32) = aggregate.Ok take %53
  return take %54

bb3:
  %26: Feed [unique slot 0] = read borrow.unique (feed) loan0
  %27: Result(Fault, Array(U8)) [owned here shape8 .1=shared slot 0 view] = call Feed.next borrow.unique %26 roots.0{0}
  write.init borrow.unique (local3) take %27
  %29: U8 = read copy.trivial (local3.#)
  %30: U8 = const 0
  %31: Bool = eq inspect %29 inspect %30
  branch inspect %31 -> bb6 -> bb4

bb4:
  %45: Array(U8) [shared slot 0 view] = read borrow.shared (local3.Ok) loan1 roots{0}
  jump -> bb5(borrow.shared %45)

bb5(%46: Array(U8) [shared slot 0 view]):
  %48: I32 = const 7
  drop (feed)
  %49: Fault = aggregate.Fault take %48
  %50: Result(Fault, I32) = aggregate.Err take %49
  return take %50

bb6:
  drop (feed)
  %33: Fault = read copy.trivial (local3.Err)
  %34: Result(Fault, Array(U8)) = aggregate.Err take %33
  %35: Outcome(Array(U8), Fault) = call toOutcome(Result(Fault, Array(U8)), Array(U8), Fault) take %34
  write.init borrow.unique (local4) take %35
  %37: U8 = read copy.trivial (local4.#)
  %38: U8 = const 1
  %39: Bool = eq inspect %37 inspect %38
  branch inspect %39 -> bb8 -> bb7

bb7:
  drop (local4)
  unreachable

bb8:
  %41: Fault = read copy.trivial (local4.Exit)
  drop (local4)
  %42: Result(Fault, I32) = call fromExit(Result(Fault, I32), I32, Fault) take %41
  return take %42
}

