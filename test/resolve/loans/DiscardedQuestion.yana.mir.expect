module ResolveTest

data Fault {at: I32}

data Feed {bytes: Array(U8), at: I32} drop authored reclaim derived

instance Drop(Feed): Feed.drop

let & released: I32 = 0

fn Feed.drop(value: Feed) -> {} {
bb0:
  %0: I32 [unique call] = read borrow.unique (global released) loan0
  %1: I32 = const 1
  %2: {} = call +=(I32) borrow.unique %0 borrow.shared %1
  drop (value.bytes)
  return
}

fn Feed.next(self: Feed [unique slot 0]) -> Result(Fault, Array(U8)) [owned here shape8 .1=shared slot 0 view] {
bb0:
  %0: I32 = read copy.trivial (self.at)
  %1: Array(U8) [shared slot 0] = read borrow.shared (self.bytes) loan0
  %2: Array(U8) [shared slot 0 view] = call.derivation elements(Array(U8), U8) borrow.shared %1 roots{0}
  %3: Size = call length(Array(U8)) borrow.shared %2
  %4: Size = convert inspect %0
  %5: Bool = ge inspect %4 inspect %3
  branch inspect %5 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %12: I32 [unique slot 0] = read borrow.unique (self.at) loan1
  %13: I32 = const 1
  %14: {} = call +=(I32) borrow.unique %12 borrow.shared %13
  %15: Array(U8) [shared slot 0] = read borrow.shared (self.bytes) loan2
  %16: I32 = read copy.trivial (self.at)
  %17: I32 = const 1
  %18: I32 = sub inspect %16 inspect %17
  %19: I32 = read copy.trivial (self.at)
  %20: Array(U8) [shared slot 0 view] = call.derivation elements(Array(U8), U8) borrow.shared %15 roots{2}
  %21: Size = convert inspect %18
  %22: Size = convert inspect %19
  %23: Array(U8) [shared slot 0 view] = call slice(U8) borrow.shared %20 borrow.shared %21 borrow.shared %22 roots{2}
  %24: Result(Fault, Array(U8)) [owned here shape8 .1=shared slot 0 view] = aggregate.Ok borrow.shared %23 roots.0{2}
  return take %24

bb3:
  %7: I32 = read copy.trivial (self.at)
  %8: Fault = aggregate.Fault take %7
  %9: Result(Fault, Array(U8)) [owned here shape8 .1=shared slot 0 view] = aggregate.Err take %8
  return take %9
}

fn discarded(fail: Bool [shared call]) -> Result(Fault, I32) {
