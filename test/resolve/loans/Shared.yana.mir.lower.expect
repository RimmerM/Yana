mut @trace = [0, 0, 0, 0]

main<complex>(): I32 {
  b_0 {
    %v_1 = loads @trace, 4: I32
    %v_2 = imul %v_1, 10: I32
    %v_3 = add %v_2, 1: I32
    store @trace, %v_3, 4
    %v_4 = cmp_neq %v_3, 1: I32
    je %v_4, b_5, b_6
  }

  b_6 {
    store @trace, 0, 4
    store @trace, 0, 4
    store @trace, 1, 4
    store @trace, 12, 4
    store @trace, 0, 4
    store @trace, 3, 4
    store @trace, 34, 4
    store @trace, 0, 4
    store @trace, 0, 4
    store @trace, 1, 4
    store @trace, 12, 4
    store @trace, 121, 4
    store @trace, 1212, 4
    store @trace, 0, 4
    %v_7 = imm 6: I32
    jmp b_8
  }

  b_5 {
    ret 18446744073709551615
  }

  b_9 {
    store @trace, 0, 4
    store @trace, 1, 4
    store @trace, 12, 4
    %v_10 = add %v_11, 69: I32
    store @trace, 0, 4
    ret %v_10
  }

  b_12 {
    ret 18446744073709551608
  }

  b_13 {
    %v_14 = cmp_ilt %v_15, 3: I32
    je %v_14, b_8, b_16
  }

  b_16 {
    %v_17 = loads @trace, 4: I32
    %v_18 = imul %v_17, 10: I32
    %v_19 = add %v_18, %v_7: I32
    store @trace, %v_19, 4
    %v_20 = cmp_neq %v_19, 6: I32
    je %v_20, b_12, b_9
  }

  b_8 {
    %v_21 = phi [b_13, %v_15], [b_6, 0]: I32
    %v_22 = phi [b_13, %v_11], [b_6, 0]: I32
    %v_11 = add %v_22, %v_7: I32
    %v_15 = add %v_21, 1: I32
    jmp b_13
  }
}

