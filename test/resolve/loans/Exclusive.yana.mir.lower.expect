mut @trace = [0, 0, 0, 0]
mut @counter = [0, 0, 0, 0]

Held.drop<complex>(%v_0: I32) {
  b_1 {
    %v_2 = loads @trace, 4: I32
    %v_3 = add %v_2, 1: I32
    store @trace, %v_3, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    call_complex Held.drop, 9
    %v_1 = loads @trace, 4: I32
    %v_2 = cmp_neq %v_1, 1: I32
    je %v_2, b_3, b_4
  }

  b_4 {
    call_complex Held.drop, 2
    %v_5 = loads @trace, 4: I32
    %v_6 = cmp_neq %v_5, 2: I32
    je %v_6, b_7, b_8
  }

  b_3 {
    ret 18446744073709551607
  }

  b_8 {
    jmp b_9
  }

  b_7 {
    ret 18446744073709551605
  }

  b_10 {
    %counter = global @counter: Ptr
    %v_11 = loads %counter, 4: I32
    %v_12 = add %v_11, 1: I32
    store %counter, %v_12, 4
    %counter = global @counter: Ptr
    %v_13 = loads %counter, 4: I32
    %v_14 = add %v_13, 10: I32
    store %counter, %v_14, 4
    %v_15 = loads @counter, 4: I32
    %v_16 = cmp_neq %v_15, 11: I32
    %v_17 = select %v_16, 18446744073709551600, 100: I32
    ret %v_17
  }

  b_18 {
    ret 18446744073709551603
  }

  b_19 {
    %v_20 = cmp_ilt %v_21, 4: I32
    je %v_20, b_9, b_22
  }

  b_22 {
    %v_23 = cmp_neq %v_21, 4: I32
    je %v_23, b_18, b_10
  }

  b_9 {
    %v_24 = phi [b_19, %v_21], [b_8, 0]: I32
    %v_21 = add %v_24, 1: I32
    jmp b_19
  }
}

