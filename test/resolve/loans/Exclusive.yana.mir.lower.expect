mut @trace = [0, 0, 0, 0]
mut @counter = [0, 0, 0, 0]

Held.drop<complex>(%value: Ptr) {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    copy %v_1, %value, 4
    %v_2 = loads @trace, 4: I32
    %v_3 = add %v_2, 1: I32
    store @trace, %v_3, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    jmp b_1
  }

  b_1 {
    jmp b_2
  }

  b_2 {
    jmp b_3
  }

  b_3 {
    jmp b_4
  }

  b_4 {
    jmp b_5
  }

  b_5 {
    jmp b_6
  }

  b_6 {
    jmp b_7
  }

  b_7 {
    %v_8 = alloca 4, 4: Ptr
    store %v_8, 9, 4
    call_complex Held.drop, %v_8
    jmp b_9
  }

  b_9 {
    %v_10 = loads @trace, 4: I32
    %v_11 = cmp_neq %v_10, 1: I32
    je %v_11, b_12, b_13
  }

  b_13 {
    %v_14 = alloca 4, 4: Ptr
    store %v_14, 2, 4
    call_complex Held.drop, %v_14
    jmp b_15
  }

  b_12 {
    ret 18446744073709551607
  }

  b_15 {
    %v_16 = loads @trace, 4: I32
    %v_17 = cmp_neq %v_16, 2: I32
    je %v_17, b_18, b_19
  }

  b_19 {
    jmp b_20
  }

  b_18 {
    ret 18446744073709551605
  }

  b_20 {
    jmp b_21
  }

  b_22 {
    jmp b_23
  }

  b_24 {
    ret 18446744073709551603
  }

  b_23 {
    jmp b_25
  }

  b_25 {
    %counter = global @counter: Ptr
    %v_26 = loads %counter, 4: I32
    %v_27 = add %v_26, 1: I32
    store %counter, %v_27, 4
    %counter = global @counter: Ptr
    %v_28 = loads %counter, 4: I32
    %v_29 = add %v_28, 10: I32
    store %counter, %v_29, 4
    %v_30 = loads @counter, 4: I32
    %v_31 = cmp_neq %v_30, 11: I32
    je %v_31, b_32, b_33
  }

  b_33 {
    ret 100
  }

  b_32 {
    ret 18446744073709551600
  }

  b_21 {
    %v_34 = phi [b_20, 0], [b_35, %v_36]: I32
    %v_37 = cmp_ilt %v_34, 4: I32
    je %v_37, b_35, b_38
  }

  b_38 {
    %v_39 = cmp_neq %v_34, 4: I32
    je %v_39, b_24, b_22
  }

  b_35 {
    %v_36 = add %v_34, 1: I32
    jmp b_21
  }
}

