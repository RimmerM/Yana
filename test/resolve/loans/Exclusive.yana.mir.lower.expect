mut @trace = [0, 0, 0, 0]
mut @counter = [0, 0, 0, 0]

Held.drop<complex>(%value: Ptr) {
  b_0 {
    %v_1 = loads @trace, 4: I32
    %v_2 = add %v_1, 1: I32
    store @trace, %v_2, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    jmp b_1
  }

  b_1 {
    jmp b_2
  }

  b_2 {
    jmp b_3
  }

  b_3 {
    %v_4 = alloca 4, 4: Ptr
    store %v_4, 9, 4
    call_complex Held.drop, %v_4
    %v_5 = loads @trace, 4: I32
    %v_6 = cmp_neq %v_5, 1: I32
    je %v_6, b_7, b_8
  }

  b_8 {
    %v_9 = alloca 4, 4: Ptr
    store %v_9, 2, 4
    call_complex Held.drop, %v_9
    %v_10 = loads @trace, 4: I32
    %v_11 = cmp_neq %v_10, 2: I32
    je %v_11, b_12, b_13
  }

  b_7 {
    ret 18446744073709551607
  }

  b_13 {
    jmp b_14
  }

  b_12 {
    ret 18446744073709551605
  }

  b_15 {
    %counter = global @counter: Ptr
    %v_16 = loads %counter, 4: I32
    %v_17 = add %v_16, 1: I32
    store %counter, %v_17, 4
    %counter = global @counter: Ptr
    %v_18 = loads %counter, 4: I32
    %v_19 = add %v_18, 10: I32
    store %counter, %v_19, 4
    %v_20 = loads @counter, 4: I32
    %v_21 = cmp_neq %v_20, 11: I32
    %v_22 = select %v_21, 18446744073709551600, 100: I32
    ret %v_22
  }

  b_23 {
    ret 18446744073709551603
  }

  b_24 {
    %v_25 = cmp_ilt %v_26, 4: I32
    je %v_25, b_14, b_27
  }

  b_27 {
    %v_28 = cmp_neq %v_26, 4: I32
    je %v_28, b_23, b_15
  }

  b_14 {
    %v_29 = phi [b_24, %v_26], [b_13, 0]: I32
    %v_26 = add %v_29, 1: I32
    jmp b_24
  }
}

