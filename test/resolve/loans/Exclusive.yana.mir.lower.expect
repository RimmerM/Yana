mut @trace = [0, 0, 0, 0]
mut @counter = [0, 0, 0, 0]

Held.drop<complex>(%value: Ptr) {
  b_0 {
    %v_1 = loads @trace, 4: I32
    %v_2 = add %v_1, 1: I32
    store @trace, %v_2, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    store %v_1, 9, 4
    call_complex Held.drop, %v_1
    %v_2 = loads @trace, 4: I32
    %v_3 = cmp_neq %v_2, 1: I32
    je %v_3, b_4, b_5
  }

  b_5 {
    %v_6 = alloca 4, 4: Ptr
    store %v_6, 2, 4
    call_complex Held.drop, %v_6
    %v_7 = loads @trace, 4: I32
    %v_8 = cmp_neq %v_7, 2: I32
    je %v_8, b_9, b_10
  }

  b_4 {
    ret 18446744073709551607
  }

  b_10 {
    jmp b_11
  }

  b_9 {
    ret 18446744073709551605
  }

  b_12 {
    %counter = global @counter: Ptr
    %v_13 = loads %counter, 4: I32
    %v_14 = add %v_13, 1: I32
    store %counter, %v_14, 4
    %counter = global @counter: Ptr
    %v_15 = loads %counter, 4: I32
    %v_16 = add %v_15, 10: I32
    store %counter, %v_16, 4
    %v_17 = loads @counter, 4: I32
    %v_18 = cmp_neq %v_17, 11: I32
    %v_19 = select %v_18, 18446744073709551600, 100: I32
    ret %v_19
  }

  b_20 {
    ret 18446744073709551603
  }

  b_21 {
    %v_22 = cmp_ilt %v_23, 4: I32
    je %v_22, b_11, b_24
  }

  b_24 {
    %v_25 = cmp_neq %v_23, 4: I32
    je %v_25, b_20, b_12
  }

  b_11 {
    %v_26 = phi [b_21, %v_23], [b_10, 0]: I32
    %v_23 = add %v_26, 1: I32
    jmp b_21
  }
}

