mut @trace = [0, 0, 0, 0]
mut @counter = [0, 0, 0, 0]

Held.drop<complex>() {
  b_0 {
    %v_1 = loads @trace, 4: I32
    %v_2 = add %v_1, 1: I32
    store @trace, %v_2, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    call_complex Held.drop
    %v_1 = loads @trace, 4: I32
    %v_2 = cmp_neq %v_1, 1: I32
    je %v_2, b_3, b_4
  }

  b_4 {
    store @trace, 2, 4
    jmp b_5
  }

  b_3 {
    ret 18446744073709551607
  }

  b_6 {
    %counter = global @counter: Ptr
    %v_7 = loads %counter, 4: I32
    %v_8 = add %v_7, 1: I32
    store %counter, %v_8, 4
    %v_9 = add %v_7, 11: I32
    store @counter, %v_9, 4
    %v_10 = cmp_neq %v_9, 11: I32
    %v_11 = select %v_10, 18446744073709551600, 100: I32
    ret %v_11
  }

  b_12 {
    ret 18446744073709551603
  }

  b_13 {
    %v_14 = cmp_ilt %v_15, 4: I32
    je %v_14, b_5, b_16
  }

  b_16 {
    %v_17 = cmp_neq %v_15, 4: I32
    je %v_17, b_12, b_6
  }

  b_5 {
    %v_18 = phi [b_13, %v_15], [b_4, 0]: I32
    %v_15 = add %v_18, 1: I32
    jmp b_13
  }
}

