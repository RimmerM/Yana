mut @trace = [0, 0, 0, 0]
mut @counter = [0, 0, 0, 0]

Held.drop<complex>(%value: Ptr) {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    copy %v_1, %value, 4
    %v_2 = loads @trace, 4: I32
    %v_3 = add %v_2, 1: I32
    store @trace, %v_3, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    jmp b_1
  }

  b_1 {
    jmp b_2
  }

  b_2 {
    jmp b_3
  }

  b_3 {
    jmp b_4
  }

  b_4 {
    jmp b_5
  }

  b_5 {
    jmp b_6
  }

  b_6 {
    %v_7 = alloca 4, 4: Ptr
    store %v_7, 9, 4
    call_complex Held.drop, %v_7
    jmp b_8
  }

  b_8 {
    %v_9 = loads @trace, 4: I32
    %v_10 = cmp_neq %v_9, 1: I32
    je %v_10, b_11, b_12
  }

  b_12 {
    %v_13 = alloca 4, 4: Ptr
    store %v_13, 2, 4
    call_complex Held.drop, %v_13
    jmp b_14
  }

  b_11 {
    ret 18446744073709551607
  }

  b_14 {
    %v_15 = loads @trace, 4: I32
    %v_16 = cmp_neq %v_15, 2: I32
    je %v_16, b_17, b_18
  }

  b_18 {
    jmp b_19
  }

  b_17 {
    ret 18446744073709551605
  }

  b_19 {
    jmp b_20
  }

  b_21 {
    jmp b_22
  }

  b_23 {
    ret 18446744073709551603
  }

  b_22 {
    jmp b_24
  }

  b_24 {
    %counter = global @counter: Ptr
    %v_25 = loads %counter, 4: I32
    %v_26 = add %v_25, 1: I32
    store %counter, %v_26, 4
    %counter = global @counter: Ptr
    %v_27 = loads %counter, 4: I32
    %v_28 = add %v_27, 10: I32
    store %counter, %v_28, 4
    %v_29 = loads @counter, 4: I32
    %v_30 = cmp_neq %v_29, 11: I32
    %v_31 = select %v_30, 18446744073709551600, 100: I32
    ret %v_31
  }

  b_32 {
    %v_33 = cmp_ilt %v_34, 4: I32
    je %v_33, b_20, b_35
  }

  b_35 {
    %v_36 = cmp_neq %v_34, 4: I32
    je %v_36, b_23, b_21
  }

  b_20 {
    %v_37 = phi [b_32, %v_34], [b_19, 0]: I32
    %v_34 = add %v_37, 1: I32
    jmp b_32
  }
}

