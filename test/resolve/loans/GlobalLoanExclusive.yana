{-
   A global holding an exclusive loan of another global, used only through its holder.

   # resolver: ownership

   `gTight.held` is `&'Cell` over `gCell` for the whole program, so `gCell` is written through
   `gTight` from any function and is not named again; `Reject.LentExclusive.yana` is the half that
   names it.
-}

data Cell {value: Int}
data Tight {held: &'Cell}

let &gCell = Cell {value: 1}
let &gTight = Tight {held: gCell}

fn bump():
    gTight.held.value += 1

fn main() -> Int:
    bump()
    bump()
    return gTight.held.value * 10 + 4
