{-
   Making an erased iterator runs none of its producer, so a loan of a global may be live where one
   is made - see `computeGlobalEffects` in `compiler/resolve_mir/analyze_loan.cpp`. Native only:
   JSIR does not convert an erased iterator yet.

   # resolver: ownership
-}

let &gArr = [1, 2, 3] :: Array(Int)

fn grow():
    for i in 0..1000:
        push(gArr, i + 100)

-- Its producer runs where it is stepped, and nothing steps it while `w` is live.
iter fn growing(n: Int) -> Int:
    for i in 0..n:
        grow()
        yield i

fn erasedGrowing(n: Int) -> iter(Int) = growing(n)

fn makesErased() -> Int:
    let w = gArr[0..3]
    let &g = erasedGrowing(0)
    let r = w[0] + w[2]
    if g.next() is Just(y):
        return r + y + 10
    return r

fn main() -> Int = makesErased()
