mut @trace = [0, 0, 0, 0]

Guard.drop<complex>(%v_0: I32) {
  b_1 {
    %v_2 = loads @trace, 4: I32
    %v_3 = add %v_2, %v_0: I32
    store @trace, %v_3, 4
    ret 
  }
}

