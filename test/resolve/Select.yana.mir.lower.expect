    %v_3 = loads @calls, 4: I32
    %v_4 = shl %v_3, 2: I32
    %v_5 = add 2, %v_4: I32
    %v_6 = shl %v_5, 6: I32
    %v_7 = add 30, %v_6: I32
    %v_8 = add %v_7, 896: I32
    %v_9 = add %v_8, 1280: I32
