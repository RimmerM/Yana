target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

@"image$base" = constant [0 x i8] zeroinitializer, align 8
@counter = global [4 x i8] zeroinitializer, align 8

define fastcc i32 @main() {
  br label %1

1:                                                ; preds = %0
  %2 = load i32, ptr @counter, align 1
  %3 = add i32 %2, 2
  %4 = icmp sgt i32 %3, 1000
  %5 = zext i1 %4 to i32
  %n = select i1 %4, i32 1, i32 2
  %6 = add i32 %2, 5
  store i32 %6, ptr @counter, align 1
  %7 = icmp sgt i32 %6, 1000
  %8 = zext i1 %7 to i32
  %9 = select i1 %7, i32 1, i32 3
  %m = sext i32 %9 to i64
  %.splatinsert = insertelement <4 x i32> poison, i32 %n, i32 0
  %count = shufflevector <4 x i32> %.splatinsert, <4 x i32> poison, <4 x i32> zeroinitializer
  %left = shl <4 x i32> <i32 5, i32 100, i32 -32, i32 64>, %count
  %right = lshr <4 x i32> <i32 5, i32 100, i32 -32, i32 64>, %count
  %arith = ashr <4 x i32> <i32 5, i32 100, i32 -32, i32 64>, %count
  %10 = extractelement <4 x i32> %left, i32 0
  %11 = extractelement <4 x i32> %right, i32 1
  %12 = add i32 %10, %11
  %13 = extractelement <4 x i32> %arith, i32 2
  %14 = add i32 %12, %13
  %.splatinsert1 = insertelement <2 x i64> poison, i64 %m, i32 0
  %.splat = shufflevector <2 x i64> %.splatinsert1, <2 x i64> poison, <2 x i32> zeroinitializer
  %up = shl <2 x i64> <i64 3, i64 3>, %.splat
  %15 = sub i64 %m, 1
  %.splatinsert2 = insertelement <2 x i64> poison, i64 %15, i32 0
  %.splat3 = shufflevector <2 x i64> %.splatinsert2, <2 x i64> poison, <2 x i32> zeroinitializer
  %down = lshr <2 x i64> %up, %.splat3
  %16 = extractelement <2 x i64> %down, i32 0
  %17 = trunc i64 %16 to i32
  %18 = add i32 %14, %17
  ret i32 %18
}
