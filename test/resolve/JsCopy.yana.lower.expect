
seed<complex>(): Int {
  b_0 {
    ret 5
  }
}

barrier<complex>(%flag: Int): Int {
  b_0 {
    %v_1 = call_complex seed: Int
    je %flag, b_2, b_3
  }

  b_2 {
    %v_4 = call_complex next, %v_1: Int
    jmp b_5
  }

  b_3 {
    jmp b_5
  }

  b_5 {
    %v_6 = phi [b_2, %v_4], [b_3, %v_1]: Int
    %v_7 = call_complex next, %v_6: Int
    %v_8 = imul %v_6, 100: Int
    %v_9 = add %v_8, %v_7: Int
    ret %v_9
  }
}

next<complex>(%n: Int): Int {
  b_0 {
    %v_1 = add %n, 1: Int
    ret %v_1
  }
}

taken<complex>(%flag: Int): Int {
  b_0 {
    %v_1 = call_complex seed: Int
    je %flag, b_2, b_3
  }

  b_2 {
    %v_4 = call_complex next, %v_1: Int
    jmp b_5
  }

  b_3 {
    jmp b_5
  }

  b_5 {
    %v_6 = phi [b_2, %v_4], [b_3, %v_1]: Int
    %v_7 = imul %v_6, 100: Int
    %v_8 = add %v_7, %v_6: Int
    %v_9 = add %v_8, %v_6: Int
    ret %v_9
  }
}

main<complex>(): Int {
  b_0 {
    %v_1 = call_complex barrier, 1: Int
    %v_2 = call_complex barrier, 0: Int
    %v_3 = imul %v_2, 1000: Int
    %v_4 = add %v_1, %v_3: Int
    %v_5 = call_complex taken, 1: Int
    %v_6 = imul %v_5, 1000000: Int
    %v_7 = add %v_4, %v_6: Int
    ret %v_7
  }
}

