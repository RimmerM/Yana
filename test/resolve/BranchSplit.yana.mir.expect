fn reread(box: Box [unique call], into: Array(I32) [unique call view], at: Size [shared call]) -> I32 {
  local first: I32
  local & local4: I32 [unique slot 0 owner]

bb0:
  %0: I32 = read copy.trivial (box.count)
  write.init borrow.unique (first) take %0
  %2: Size = read copy.trivial (at)
  %3: I32 = read copy.trivial (first)
  %4: I32 = const 1
  %5: I32 = add inspect %3 inspect %4
  %6: Array(I32) [unique call view] = read borrow.unique (into) loan0
  %7: I32 [unique slot 0 owner] = call.subscript getMut(Array(I32), Size, I32) borrow.unique %6 borrow.shared %2 roots{0}
  write.init borrow.unique (local4) borrow.unique %7
  write.assign borrow.unique (local4) take %5
  %10: I32 = read copy.trivial (box.count)
  %11: I32 = const 1
  %12: I32 = add inspect %10 inspect %11
  write.assign borrow.unique (box.other) take %12
  %14: I32 = read copy.trivial (first)
  %15: I32 = read copy.trivial (box.count)
  %16: I32 = add inspect %14 inspect %15
  return take %16
}

