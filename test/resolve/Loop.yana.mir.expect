bb1:
  %7: I32 = read copy.trivial (i)
  %8: I32 = read copy.trivial (count)
  %9: Bool = lt inspect %7 inspect %8
  branch inspect %9 -> bb3 -> bb2

bb2:
  %22: I32 = read copy.trivial (total)
  return take %22

bb3:
  %11: I32 = read copy.trivial (total)
  %12: I32 = read copy.trivial (q.x)
  %13: I32 = read copy.trivial (q.y)
  %14: I32 = mul inspect %12 inspect %13
  %15: I32 = add inspect %11 inspect %14
  write.assign borrow.unique (total) take %15
  %17: I32 = read copy.trivial (i)
  %18: I32 = const 1
  %19: I32 = add inspect %17 inspect %18
  write.assign borrow.unique (i) take %19
  jump -> bb1
}

