fn bump(n: I32 [unique call]) -> {} {
bb0:
  %0: I32 = read copy.trivial (n)
  %1: I32 = const 1
  %2: I32 = add inspect %0 inspect %1
  write.assign borrow.unique (n) take %2
  return
}

