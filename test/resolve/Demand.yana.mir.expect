module ResolveTest

data Point {x: I32, y: I32}

fn read(it: Point [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (it.x)
  %1: I32 = read copy.trivial (it.y)
  %2: I32 = add inspect %0 inspect %1
  return take %2
}

fn bump(it: Point [unique call]) -> {} {
bb0:
  %0: I32 = read copy.trivial (it.x)
  %1: I32 = const 1
  %2: I32 = add inspect %0 inspect %1
  write.assign borrow.unique (it.x) take %2
  return
}

fn onlyRead() -> I32 {
  local p: Point

bb0:
  %0: I32 = const 1
  %1: I32 = const 2
  %2: Point = aggregate.Point take %0 take %1
  write.init borrow.unique (p) take %2
  %4: Point = read copy.trivial (p)
  %5: I32 = call read borrow.shared %4
  %6: Point = read copy.trivial (p)
  %7: I32 = call read borrow.shared %6
  %8: I32 = add inspect %5 inspect %7
  return take %8
}

fn mutableOnOneArm(flag: Bool [shared call]) -> I32 {
  local & p: Point

bb0:
  %0: I32 = const 1
  %1: I32 = const 2
  %2: Point = aggregate.Point take %0 take %1
  write.init borrow.unique (p) take %2
  %4: Bool = read copy.trivial (flag)
  branch inspect %4 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %10: Point = read copy.trivial (p)
  %11: I32 = call read borrow.shared %10
  return take %11

bb3:
  %6: Point [unique call] = read borrow.unique (p) loan0
  %7: {} = call bump borrow.unique %6
  jump -> bb2
}

fn copyIsIndependent() -> I32 {
  local source: Point
  local & duplicate: Point

bb0:
  %0: I32 = const 1
  %1: I32 = const 2
  %2: Point = aggregate.Point take %0 take %1
  write.init borrow.unique (source) take %2
  %4: I32 = read copy.trivial (source.x)
  %5: I32 = read copy.trivial (source.y)
  %6: Point = aggregate.Point take %4 take %5
  write.init borrow.unique (duplicate) take %6
  %8: Point [unique call] = read borrow.unique (duplicate) loan0
  %9: {} = call bump borrow.unique %8
  %10: Point = read copy.trivial (source)
  %11: I32 = call read borrow.shared %10
  %12: Point = read copy.trivial (duplicate)
  %13: I32 = call read borrow.shared %12
  %14: I32 = add inspect %11 inspect %13
  return take %14
}

fn addressed() -> I32 {
  local p: Point
  local at: %Point [owned here shape1 .*=shared slot 0]
  local local2: Point
  local local3: Point

bb0:
  %0: I32 = const 1
  %1: I32 = const 2
  %2: Point = aggregate.Point take %0 take %1
  write.init borrow.unique (p) take %2
  %4: Point [shared slot 0] = read borrow.shared (p) loan0
  %5: %Point [owned here shape1 .*=shared slot 0] = address inspect %4 roots.0{0}
  write.init borrow.unique (at) take %5
  %7: %Point [owned here shape1 .*=shared slot 0] = read copy.trivial (at) roots.0{0}
  %8: Point = read copy.trivial ([%%7])
  write.init borrow.unique (local2) take %8
  %10: I32 = read copy.trivial (local2.x)
  %11: %Point [owned here shape1 .*=shared slot 0] = read copy.trivial (at) roots.0{0}
  %12: Point = read copy.trivial ([%%11])
  write.init borrow.unique (local3) take %12
  %14: I32 = read copy.trivial (local3.y)
  %15: I32 = add inspect %10 inspect %14
  return take %15
}

fn main() -> I32 {
bb0:
  %0: I32 = call onlyRead
  %1: Bool = const True
  %2: I32 = call mutableOnOneArm borrow.shared %1
  %3: I32 = add inspect %0 inspect %2
  %4: I32 = call copyIsIndependent
  %5: I32 = add inspect %3 inspect %4
  %6: I32 = call addressed
  %7: I32 = add inspect %5 inspect %6
  return take %7
}

entry main
