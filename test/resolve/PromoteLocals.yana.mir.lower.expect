mut @live = [0, 0, 0, 0]
mut @trace = [0, 0, 0, 0]

bump<complex>(%v: Ptr) {
  b_0 {
    %v_1 = loads %v, 4: I32
    %v_2 = add %v_1, 100: I32
    store %v, %v_2, 4
    ret 
  }
}

Held.drop<complex>(%v_0: I32) {
  b_1 {
    %v_2 = loads @live, 4: I32
    %v_3 = sub %v_2, 1: I32
    store @live, %v_3, 4
    %v_4 = loads @trace, 4: I32
    %v_5 = imul %v_4, 10: I32
    %v_6 = add %v_5, %v_0: I32
    store @trace, %v_6, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    jmp b_1
  }

  b_2 {
    %v_3 = cmp_ilt %v_4, 3: I32
    je %v_3, b_1, b_5
  }

  b_5 {
    %v_6 = cmp_eq %v_7, 12: I32
    %v_8 = select %v_6, 4, 0: I32
    %v_9 = alloca 4, 4: Ptr
    store %v_9, 7, 4
    call_complex bump, %v_9
    %v_10 = loads %v_9, 4: I32
    %v_11 = cmp_eq %v_10, 107: I32
    %v_12 = select %v_11, 8, 0: I32
    %v_13 = loads @live, 4: I32
    %v_14 = add %v_13, 1: I32
    store @live, %v_14, 4
    call_complex Held.drop, 4
    %v_15 = add 3, %v_8: I32
    %v_16 = add %v_15, %v_12: I32
    %v_17 = add %v_16, 1008: I32
    %v_18 = loads @live, 4: I32
    %v_19 = imul %v_18, 10000: I32
    %v_20 = add %v_17, %v_19: I32
    %v_21 = loads @trace, 4: I32
    %v_22 = add %v_20, %v_21: I32
    ret %v_22
  }

  b_1 {
    %v_23 = phi [b_2, %v_7], [b_0, 0]: I32
    %v_24 = phi [b_2, %v_4], [b_0, 0]: I32
    %v_25 = imul %v_23, 10: I32
    %v_7 = add %v_25, %v_24: I32
    %v_4 = add %v_24, 1: I32
    jmp b_2
  }
}

