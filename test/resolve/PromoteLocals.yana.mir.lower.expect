mut @live = [0, 0, 0, 0]
mut @trace = [0, 0, 0, 0]

Held.drop<complex>(%self: Ptr) {
  b_0 {
    %v_1 = load %self, 4: I32
    %v_2 = loads @live, 4: I32
    %v_3 = sub %v_2, 1: I32
    store @live, %v_3, 4
    %v_4 = loads @trace, 4: I32
    %v_5 = imul %v_4, 10: I32
    %v_6 = add %v_5, %v_1: I32
    store @trace, %v_6, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    jmp b_1
  }

  b_2 {
    %v_3 = cmp_ilt %v_4, 3: I32
    je %v_3, b_1, b_5
  }

  b_5 {
    %v_6 = cmp_eq %v_7, 12: I32
    %v_8 = select %v_6, 4, 0: I32
    %v_9 = alloca 4, 4: Ptr
    %v_10 = loads @live, 4: I32
    %v_11 = add %v_10, 1: I32
    store @live, %v_11, 4
    store %v_9, 4, 4
    call_complex Held.drop, %v_9
    %v_12 = add 3, %v_8: I32
    %v_13 = add %v_12, 8: I32
    %v_14 = add %v_13, 16: I32
    %v_15 = add %v_14, 32: I32
    %v_16 = add %v_15, 64: I32
    %v_17 = add %v_16, 128: I32
    %v_18 = add %v_17, 256: I32
    %v_19 = add %v_18, 512: I32
    %v_20 = loads @live, 4: I32
    %v_21 = imul %v_20, 10000: I32
    %v_22 = add %v_19, %v_21: I32
    %v_23 = loads @trace, 4: I32
    %v_24 = add %v_22, %v_23: I32
    ret %v_24
  }

  b_1 {
    %v_25 = phi [b_2, %v_7], [b_0, 0]: I32
    %v_26 = phi [b_2, %v_4], [b_0, 0]: I32
    %v_27 = imul %v_25, 10: I32
    %v_7 = add %v_27, %v_26: I32
    %v_4 = add %v_26, 1: I32
    jmp b_2
  }
}

