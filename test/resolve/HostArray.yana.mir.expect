  %1: I32 = const 1
  %2: {} = call -=(I32) borrow.unique %0 borrow.shared %1
  %3: I32 = read copy.trivial (global closed)
  %4: I32 = read copy.trivial (value.id)
  %5: I32 = add inspect %3 inspect %4
  write.assign borrow.unique (global closed) take %5
  return
}

