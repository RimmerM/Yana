module ResolveTest

data Handle {id: I32} drop authored

instance Drop(Handle): Handle.drop

let & live: I32 = 0

let & closed: I32 = 0

fn openHandle(id: I32 [shared call]) -> Handle {
bb0:
  %0: I32 [unique call] = read borrow.unique (global live) loan0
  %1: I32 = const 1
  %2: {} = call +=(I32) borrow.unique %0 borrow.shared %1
  %3: I32 = read copy.trivial (id)
  %4: Handle = aggregate.Handle take %3
  return take %4
}

fn Handle.drop(value: Handle) -> {} {
bb0:
  %0: I32 [unique call] = read borrow.unique (global live) loan0
  %1: I32 = const 1
  %2: {} = call -=(I32) borrow.unique %0 borrow.shared %1
  %3: I32 = read copy.trivial (global closed)
  %4: I32 = read copy.trivial (value.id)
  %5: I32 = add inspect %3 inspect %4
  write.assign borrow.unique (global closed) take %5
  return
}

fn idsOf(xs: Array(Handle) [shared call view]) -> I32 {
  local & total: I32
  local & i: Size
  local local3: Handle [shared slot 0]

bb0:
  %0: I32 = const 0
  write.init borrow.unique (total) take %0
  %2: Size = const 0
  write.init borrow.unique (i) take %2
  jump -> bb1

bb1:
  %5: Size = read copy.trivial (i)
  %6: Array(Handle) [shared call view] = read borrow.shared (xs) loan0
  %7: Size = call length(Array(Handle)) borrow.shared %6
  %8: Bool = lt inspect %5 inspect %7
  branch inspect %8 -> bb3 -> bb2

bb2:
  %25: I32 = read copy.trivial (total)
  return take %25

bb3:
  %10: I32 = read copy.trivial (total)
  %11: I32 = const 10
  %12: I32 = mul inspect %10 inspect %11
  %13: Size = read copy.trivial (i)
  %14: Array(Handle) [shared call view] = read borrow.shared (xs) loan1
  %15: Handle [shared slot 0] = call.subscript get(Array(Handle), Size, Handle) borrow.shared %14 borrow.shared %13 roots{1}
  write.init borrow.unique (local3) borrow.shared %15
  %17: I32 = read copy.trivial (local3.id)
  %18: I32 = add inspect %12 inspect %17
  write.assign borrow.unique (total) take %18
  %20: Size = read copy.trivial (i)
  %21: Size = const 1
  %22: Size = add inspect %20 inspect %21
  write.assign borrow.unique (i) take %22
  jump -> bb1
}

