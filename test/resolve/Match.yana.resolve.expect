    %v22 = cmp_ge %v20, 11 : Bool
    je %v22, b8, b6

  b8:
    %h = load %s@Square.height : Int
    %v27 = mul %h, 10 : Int
    jmp b9

  b9:
    %v36 = phi [b3, 100], [b5, %r], [b8, %v27], [b6, %v31] : Int
    ret %v36
