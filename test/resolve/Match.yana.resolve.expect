fn colorValue(%c: Color) -> Int {
  b0:
    %v1 = cast %c : Int
    %v3 = cmp_eq %v1, 0 : Bool
    je %v3, b2, b1

  b1:
    %v6 = cast %c : Int
    %v8 = cmp_eq %v6, 1 : Bool
    je %v8, b4, b3

  b2:
    jmp b5

  b3:
    jmp b5

  b4:
    jmp b5

  b5:
    %v15 = phi [b2, 1], [b4, 2], [b3, 3] : Int
    ret %v15
}

fn shapeValue(%s: Shape) -> Int {
  b0:
    %v1 = load %s.discriminant : Int
    %v3 = cmp_eq %v1, 1 : Bool
    je %v3, b2, b1

  b1:
    %r = load %s@Circle : Int
    %v12 = add %r, 1 : Int
    jmp b3

  b2:
    %v5 = load %s@Square : {width: Int, height: Int}
    %width = load %s@Square.width : Int
    %height = load %s@Square.height : Int
    %v8 = mul %width, %height : Int
    jmp b3

  b3:
    %v15 = phi [b2, %v8], [b1, %v12] : Int
    ret %v15
}

fn nested(%m: Maybe(Color)) -> Int {
  b0:
    %v1 = load %m.discriminant : Int
    %v3 = cmp_eq %v1, 1 : Bool
