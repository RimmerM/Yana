  b2:
    %v5 = load %m@Just : Color
    %v6 = cast %v5 : Int
    %v8 = cmp_eq %v6, 0 : Bool
    je %v8, b3, b1

  b3:
    jmp b10

  b4:
    %v21 = load %m.discriminant : Int
    %v23 = cmp_eq %v21, 1 : Bool
    je %v23, b8, b7

  b5:
    %v15 = load %m@Just : Color
