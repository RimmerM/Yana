    %v6 = cast %v5 : Int
    %v8 = cmp_eq %v6, 0 : Bool
    je %v8, b3, b1

  b3:
    jmp b6

  b4:
    jmp b6

  b5:
    %rest = load %m@Just : Color
    %v16 = call colorValue, %rest : Int
    jmp b6

  b6:
    %v21 = phi [b3, 10], [b5, %v16], [b4, 0] : Int
    ret %v21
