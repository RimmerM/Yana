fn classify(%value: Int) -> Int {
  b0:
    %v2 = cmp_eq %value, 0 : Bool
    je %v2, b2, b1

  b1:
    %v7 = cmp_ge %value, 1 : Bool
    %v8 = cmp_le %value, 10 : Bool
    %v9 = and %v7, %v8 : Bool
    je %v9, b4, b3

  b2:
    jmp b5

  b3:
    jmp b5

  b4:
    jmp b5

  b5:
    %v16 = phi [b2, 0], [b4, 1], [b3, 2] : Int
    ret %v16
}

