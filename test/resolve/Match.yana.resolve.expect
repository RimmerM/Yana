fn firstOrRest(%m: Maybe(Color)) -> Int {
  b0:
    %v1 = load %m.discriminant : Int
    %v3 = cmp_eq %v1, 1 : Bool
    je %v3, b2, b1

  b1:
    %v11 = load %m.discriminant : Int
