    %value = loads %v_6, 4: Int
    %v_7 = add %choice, 8: Ptr
    %extra = loads %v_7, 4: Int
    %v_8 = add %value, %extra: Int
    jmp b_9
  }

  b_3 {
    %v_10 = add %choice, 4: Ptr
    %value = loads %v_10, 4: Int
    jmp b_9
  }

  b_9 {
    %v_11 = phi [b_3, %value], [b_4, %v_8]: Int
    ret %v_11
