module ResolveTest

data Point {x: I32, y: I32}

fn bump(counter: I32 [unique call], by: I32 [shared call]) -> {} {
bb0:
  %0: I32 = read copy.trivial (counter)
  %1: I32 = read copy.trivial (by)
  %2: I32 = add inspect %0 inspect %1
  write.assign borrow.unique (counter) take %2
  return
}

fn swap(a: I32 [unique call], b: I32 [unique call]) -> {} {
  local old: I32

bb0:
  %0: I32 = read copy.trivial (a)
  write.init borrow.unique (old) take %0
  %2: I32 = read copy.trivial (b)
  write.assign borrow.unique (a) take %2
  %4: I32 = read copy.trivial (old)
  write.assign borrow.unique (b) take %4
  return
}

fn moveBy(p: Point [unique call], dx: I32 [shared call], dy: I32 [shared call]) -> {} {
bb0:
  %0: I32 [unique call] = read borrow.unique (p.x) loan0
  %1: I32 = read copy.trivial (dx)
  %2: {} = call +=(I32) borrow.unique %0 borrow.shared %1
  %3: I32 [unique call] = read borrow.unique (p.y) loan1
  %4: I32 = read copy.trivial (dy)
  %5: {} = call +=(I32) borrow.unique %3 borrow.shared %4
  return
}

fn copyThroughBorrow(target: I32 [unique call], amount: I32 [shared call]) -> {} {
bb0:
  %0: I32 = read copy.trivial (target)
  %1: I32 = read copy.trivial (amount)
  %2: I32 = add inspect %0 inspect %1
  write.assign borrow.unique (target) take %2
  return
}

fn main() -> I32 {
  local & total: I32
  local & left: I32
  local & right: I32
  local & here: Point

bb0:
  %0: I32 = const 0
  write.init borrow.unique (total) take %0
  %2: I32 [unique call] = read borrow.unique (total) loan0
  %3: I32 = const 5
  %4: {} = call bump borrow.unique %2 borrow.shared %3
  %5: I32 [unique call] = read borrow.unique (total) loan1
  %6: I32 = const 3
  %7: {} = call +=(I32) borrow.unique %5 borrow.shared %6
  %8: I32 [unique call] = read borrow.unique (total) loan2
  %9: I32 = const 2
  %10: {} = call *=(I32) borrow.unique %8 borrow.shared %9
  %11: I32 = const 1
  write.init borrow.unique (left) take %11
  %13: I32 = const 2
  write.init borrow.unique (right) take %13
  %15: I32 [unique call] = read borrow.unique (left) loan3
  %16: I32 [unique call] = read borrow.unique (right) loan4
  %17: {} = call swap borrow.unique %15 borrow.unique %16
  %18: I32 = const 10
  %19: I32 = const 20
  %20: Point = aggregate.Point take %18 take %19
  write.init borrow.unique (here) take %20
  %22: Point [unique call] = read borrow.unique (here) loan5
  %23: I32 = const 1
  %24: I32 = const 2
  %25: {} = call moveBy borrow.unique %22 borrow.shared %23 borrow.shared %24
  %26: I32 [unique call] = read borrow.unique (total) loan6
  %27: I32 = read copy.trivial (total)
  %28: {} = call copyThroughBorrow borrow.unique %26 borrow.shared %27
  %29: I32 = read copy.trivial (total)
  %30: I32 = read copy.trivial (left)
  %31: I32 = read copy.trivial (right)
  %32: I32 = sub inspect %30 inspect %31
  %33: I32 = add inspect %29 inspect %32
  %34: I32 = read copy.trivial (here.x)
  %35: I32 = add inspect %33 inspect %34
  %36: I32 = read copy.trivial (here.y)
  %37: I32 = add inspect %35 inspect %36
  return take %37
}

entry main
