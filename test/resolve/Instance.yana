import Native

-- The type the instance below is placed by. `Eq` is Core's, so writing `instance Eq(Maybe(a))` here
-- would be an orphan - a module implementing someone else's class for someone else's type, which
-- doc/spec/classes.md refuses. Declaring the type is what makes the instance this module's business.
data Opt(a) = None | Some(a)

-- An instance head written over a type variable. `Eq(Opt(a))` is selected by matching rather
-- than by equality, and the `Eq(a)` it declares is what selecting it has to prove for whatever the
-- match bound: `Opt(Int)` has an instance because `Int` does, and an `Opt` of a record that
-- implements nothing has none.
instance (Eq(a)) Eq(Opt(a)):
    fn ==(lhs: Opt(a), rhs: Opt(a)) -> Bool = match {lhs, rhs}:
        {Some(x), Some(y)} -> x == y
        {None, None} -> True
        _ -> False

    fn !=(lhs: Opt(a), rhs: Opt(a)) -> Bool = !(lhs == rhs)

fn none() -> Opt(Int) = None

-- One body, one specialization per element type: the implementations of a parametric instance are
-- generic functions over the head's own variable, and `!=` reaching for `==` is the instance using
-- the class it implements rather than a requirement it has to prove all over again.
fn maybes() -> I64:
    let &score = 0 :: I64

    if Some(1) == Some(1) then score = score + 1
    if Some(1) != Some(2) then score = score + 2
    if none() == none() then score = score + 4
    if Some(True) != Some(False) then score = score + 8

    return score

-- Generic code that constrains a class reaches a parametric instance the same way it reaches any
-- other one: `smaller` never learns that `a` is a pointer.
fn smaller(->x: a, ->y: a) -> a = if x < y then x else y

fn pointers() -> I64:
    let first = 0 :: I64
    let second = 0 :: I64

    let a = addressOf(first)
    let b = addressOf(second)
    let low = smaller(a, b)
    let high = smaller(b, a)

    let &score = 0 :: I64
    if low <= high then score = score + 1
    if smaller(a, b) == low then score = score + 2
    if compare(a, a) is EQ then score = score + 4

    return score

-- A pointer as the element of a generic type, so the requirement is proved through two heads at
-- once: `Eq(Opt(%I64))` needs `Eq(%I64)`, which is the pointer instance.
fn nested() -> I64:
    let value = 0 :: I64
    let p = addressOf(value)

    if Some(p) == Some(p) then return 16
    return 0

fn main() -> Int = truncate((maybes() + pointers() + nested())) :: Int
