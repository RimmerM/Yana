@image$base = []

retarget<complex>(%slot: Ptr) {
  b_0 {
    store %slot, funvalue$triple, 8
    %v_1 = bitcast 0: Ptr
    %v_2 = add %slot, 8: Ptr
    store %v_2, %v_1, 8
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 20, 8: Ptr
    %v_2 = fun funvalue$double: Ptr
    %v_3 = bitcast 0: Ptr
    %v_4 = add %v_1, 16: Ptr
    store %v_4, 1, 4
    store %v_1, %v_2, 8
    %v_5 = add %v_1, 8: Ptr
    store %v_5, %v_3, 8
    %v_6 = call_complex %v_2, %v_3, 10: I32
    call_complex retarget, %v_1
    %v_7 = add %v_1, 8: Ptr
    %v_8 = load %v_1, 8: Ptr
    %v_9 = load %v_7, 8: Ptr
    %v_10 = call_complex %v_8, %v_9, 10: I32
    %v_11 = add %v_1, 16: Ptr
    %v_12 = loads %v_11, 4: I32
    %after = imul %v_10, %v_12: I32
    store %v_11, 4, 4
    %v_13 = fun funvalue$negate: Ptr
    store %v_1, %v_13, 8
    %v_14 = bitcast 0: Ptr
    %v_15 = add %v_1, 8: Ptr
    store %v_15, %v_14, 8
    %v_16 = call_complex %v_13, %v_14, 10: I32
    %last = shl %v_16, 2: I32
    %v_17 = add %v_6, %after: I32
    %v_18 = add %v_17, %last: I32
    ret %v_18
  }
}

funvalue$triple<complex>(%env: Ptr, %x: I32): I32 {
  b_0 {
    %v_1 = imul %x, 3: I32
    ret %v_1
  }
}

funvalue$negate<complex>(%env: Ptr, %x: I32): I32 {
  b_0 {
    %v_1 = sub 0, %x: I32
    ret %v_1
  }
}

funvalue$double<complex>(%env: Ptr, %x: I32): I32 {
  b_0 {
    %v_1 = shl %x, 1: I32
    ret %v_1
  }
}

