let image$base: () = <none>

fn main() -> I32 {
  b0:
    %i = alloc : I32
    init %i, 0
    %sum = alloc : I32
    init %sum, 0
    %done = alloc : Bool
    init %done, False
    jmp b1

  b1:
    %v11 = load %i : I32
    %v12 = cmp_lt %v11, %limit : Bool
    je %v12, b3, b4

  b2:
    %v63 = load %done : Bool
    je %v63, b16, b17

  b3:
    %v14 = load %done : Bool
    %v16 = xor %v14, True : Bool
    jmp b5

  b4:
    jmp b5

  b5:
    %v20 = phi [b3, %v16], [b4, False] : Bool
    je %v20, b6, b2

  b6:
    %v22 = load %i : I32
    %v25 = rem %v22, 3 : I32
    %v28 = cmp_eq %v25, 0 : Bool
    je %v28, b8, b7

  b7:
    %v30 = load %i : I32
    %v33 = rem %v30, 5 : I32
    %v36 = cmp_eq %v33, 0 : Bool
    jmp b9

  b8:
    jmp b9

  b9:
    %v40 = phi [b7, %v36], [b8, True] : Bool
    je %v40, b10, b11

  b10:
    %v42 = load %sum : I32
    %v43 = load %i : I32
    %v44 = add %v42, %v43 : I32
    assign %sum, %v44
    jmp b12

  b11:
    jmp b12

  b12:
    %v48 = load %sum : I32
    %v51 = cmp_gt %v48, 60 : Bool
    je %v51, b13, b14

  b13:
    assign %done, True
    jmp b15

  b14:
    jmp b15

  b15:
    %v57 = load %i : I32
    %v60 = add %v57, 1 : I32
    assign %i, %v60
    jmp b1

  b16:
    %v65 = load %sum : I32
    ret %v65

  b17:
    jmp b18

  b18:
    %v68 = load %sum : I32
    %v71 = add %v68, 1000 : I32
    ret %v71
}
