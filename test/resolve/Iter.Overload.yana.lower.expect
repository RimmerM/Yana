@image$base = []
@heapFree = [0, 0, 0, 0, 0, 0, 0, 0]

freeHeap<complex>(%allocation: Ptr) {
  b_0 {
    %v_1 = bitcast %allocation: Long
    %v_2 = cmp_eq %v_1, 0: Int
    je %v_2, b_3, b_4
  }

  b_3 {
    ret 
  }

  b_4 {
    jmp b_5
  }

  b_5 {
    %v_6 = sub %allocation, 8: Ptr
    %v_7 = bitcast %v_6: Ptr
    %sizeClass = loads %v_7, 8: Long
    %v_8 = bitcast %allocation: Ptr
    %v_9 = load @heapFree, 8: Ptr
    %v_10 = shl %sizeClass, 3: Long
    %v_11 = add %v_9, %v_10: Ptr
    %v_12 = load %v_11, 8: Ptr
    store %v_8, %v_12, 8
    %v_13 = load @heapFree, 8: Ptr
    %v_14 = add %v_13, %v_10: Ptr
    store %v_14, %allocation, 8
    ret 
  }
}

Contiguous(Array(a), a).elements(Int)<complex>(%v_0: Ptr, %self: Ptr) {
  b_1 {
    %v_2 = add %self, 12: Ptr
    %v_3 = load %v_2, 4: Int
    %v_4 = cast %v_3: Int
    %v_5 = cast %v_4: Long
    %v_6 = load %self, 8: Ptr
    %v_7 = alloca 16, 8: Ptr
    call_complex slice(Int), %v_7, %v_6, %v_5, 0, %v_5
    copy %v_0, %v_7, 16
    ret 
  }
}

slice(Int)<complex>(%v_0: Ptr, %self$items: Ptr, %self$length: Long, %from: Long, %to: Long) {
  b_1 {
    %v_2 = cmp_ilt %from, 0: Int
    je %v_2, b_3, b_4
  }

  b_3 {
    jmp b_5
  }

  b_4 {
    jmp b_5
  }

  b_5 {
    %v_6 = phi [b_3, 0], [b_4, %from]: Long
    %v_7 = cmp_igt %v_6, %self$length: Int
    je %v_7, b_8, b_9
  }

  b_8 {
    jmp b_10
  }

  b_9 {
    jmp b_10
  }

  b_10 {
    %v_11 = phi [b_8, %self$length], [b_9, %v_6]: Long
    %v_12 = cmp_ilt %to, %v_11: Int
    je %v_12, b_13, b_14
  }

  b_13 {
    jmp b_15
  }

  b_14 {
    jmp b_15
  }

  b_15 {
    %v_16 = phi [b_13, %v_11], [b_14, %to]: Long
    %v_17 = cmp_igt %v_16, %self$length: Int
    je %v_17, b_18, b_19
  }

  b_18 {
    jmp b_20
  }

  b_19 {
    jmp b_20
  }

  b_20 {
    %v_21 = phi [b_18, %self$length], [b_19, %v_16]: Long
    %v_22 = shl %v_11, 2: Long
    %v_23 = add %self$items, %v_22: Ptr
    %v_24 = sub %v_21, %v_11: Long
    store %v_0, %v_23, 8
    %v_25 = add %v_0, 8: Ptr
    store %v_25, %v_24, 8
    ret 
  }
}

main<complex>(): Int {
  b_0 {
    %xs = alloca 16, 8: Ptr
    %v_1 = alloca 12, 4: Ptr
    store %xs, %v_1, 8
    %v_2 = add %xs, 8: Ptr
    %v_3 = load %v_2, 4: Int
    store %v_2, 3, 4
    store %v_1, 10, 4
    %v_4 = add %v_1, 4: Ptr
    store %v_4, 20, 4
    %v_5 = add %v_1, 8: Ptr
    store %v_5, 30, 4
    %v_6 = add %xs, 12: Ptr
    store %v_6, 3, 4
    %v_7 = alloca 16, 8: Ptr
    call_complex Contiguous(Array(a), a).elements(Int), %v_7, %xs
    %v_8 = add %v_7, 8: Ptr
    %v_9 = loads %v_8, 8: Long
    %v_10 = cast %v_9: Int
    %v_11 = add %v_10, 15: Int
    %v_12 = add %xs, 8: Ptr
    %v_13 = load %v_12, 4: Int
    %v_14 = shr %v_13, 30: Int
    %v_15 = cmp_eq %v_14, 1: Int
    je %v_15, b_16, b_17
  }

  b_16 {
    %v_18 = load %xs, 8: Ptr
    %v_19 = bitcast %v_18: Ptr
    call_complex freeHeap, %v_19
    jmp b_17
  }

  b_17 {
    ret %v_11
  }
}

