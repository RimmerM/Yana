@image$base = []
@heapFree = [0, 0, 0, 0, 0, 0, 0, 0]

freeHeap<complex>(%allocation: Ptr) {
  b_0 {
    %v_1 = bitcast %allocation: Long
    %v_2 = cmp_eq %v_1, 0: Int
    je %v_2, b_3, b_4
  }

  b_3 {
    ret 
  }

  b_4 {
    jmp b_5
  }

  b_5 {
    %v_6 = sub %allocation, 8: Ptr
    %v_7 = bitcast %v_6: Ptr
    %sizeClass = loads %v_7, 8: Long
    %v_8 = bitcast %allocation: Ptr
    %v_9 = load @heapFree, 8: Ptr
    %v_10 = shl %sizeClass, 3: Long
    %v_11 = add %v_9, %v_10: Ptr
    %v_12 = load %v_11, 8: Ptr
    store %v_8, %v_12, 8
    %v_13 = load @heapFree, 8: Ptr
    %v_14 = add %v_13, %v_10: Ptr
    store %v_14, %allocation, 8
    ret 
  }
}

Contiguous(Array(a), a).elements(Int)<complex>(%v_0: Ptr, %self: Ptr) {
  b_1 {
    %v_2 = add %self, 12: Ptr
    %v_3 = load %v_2, 4: Int
    %v_4 = cast %v_3: Int
    %v_5 = cast %v_4: Long
    %v_6 = load %self, 8: Ptr
    %v_7 = imm 0: Long
    %v_8 = cmp_igt %v_7, %v_5: Int
    je %v_8, b_9, b_10
  }

  b_9 {
    jmp b_10
  }

  b_10 {
    %v_11 = phi [b_1, %v_7], [b_9, %v_5]: Long
    %v_12 = cmp_ilt %v_5, %v_11: Int
    je %v_12, b_13, b_14
  }

  b_13 {
    jmp b_14
  }

  b_14 {
    %v_15 = phi [b_10, %v_5], [b_13, %v_11]: Long
    %v_16 = cmp_igt %v_15, %v_5: Int
    je %v_16, b_17, b_18
  }

  b_17 {
    jmp b_18
  }

  b_18 {
    %v_19 = phi [b_14, %v_15], [b_17, %v_5]: Long
    %v_20 = shl %v_11, 2: Long
    %v_21 = add %v_6, %v_20: Ptr
    %v_22 = sub %v_19, %v_11: Long
    store %v_0, %v_21, 8
    %v_23 = add %v_0, 8: Ptr
    store %v_23, %v_22, 8
    ret 
  }
}

main<complex>(): Int {
  b_0 {
    %xs = alloca 16, 8: Ptr
    %v_1 = alloca 12, 4: Ptr
    store %xs, %v_1, 8
    %v_2 = add %xs, 8: Ptr
    %v_3 = load %v_2, 4: Int
    store %v_2, 3, 4
    store %v_1, 10, 4
    %v_4 = add %v_1, 4: Ptr
    store %v_4, 20, 4
    %v_5 = add %v_1, 8: Ptr
    store %v_5, 30, 4
    %v_6 = add %xs, 12: Ptr
    store %v_6, 3, 4
    %v_7 = alloca 16, 8: Ptr
    call_complex Contiguous(Array(a), a).elements(Int), %v_7, %xs
    %v_8 = add %v_7, 8: Ptr
    %v_9 = loads %v_8, 8: Long
    %v_10 = cast %v_9: Int
    %v_11 = add %v_10, 15: Int
    %v_12 = add %xs, 8: Ptr
    %v_13 = load %v_12, 4: Int
    %v_14 = shr %v_13, 30: Int
    %v_15 = cmp_eq %v_14, 1: Int
    je %v_15, b_16, b_17
  }

  b_16 {
    %v_18 = load %xs, 8: Ptr
    %v_19 = bitcast %v_18: Ptr
    call_complex freeHeap, %v_19
    jmp b_17
  }

  b_17 {
    ret %v_11
  }
}

