target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

module asm "\09.set \22image$base\22, 0"

@"image$base" = external constant [0 x i8], align 8
@seed = global [4 x i8] c"\03\00\00\00", align 8

define fastcc i32 @main() #0 {
  br label %1

1:                                                ; preds = %0
  %2 = load i32, ptr @seed, align 1
  %.splatinsert = insertelement <8 x i32> poison, i32 %2, i64 0
  %base = shufflevector <8 x i32> %.splatinsert, <8 x i32> poison, <8 x i32> zeroinitializer
  %high = insertelement <8 x i32> %base, i32 40, i32 5
  %3 = extractelement <8 x i32> %high, i32 5
  %4 = icmp ne i32 %3, 40
  %5 = zext i1 %4 to i32
  br i1 %4, label %6, label %7

6:                                                ; preds = %1
  ret i32 -1

7:                                                ; preds = %1
  %8 = extractelement <8 x i32> %high, i32 4
  %9 = icmp ne i32 %8, 3
  %10 = zext i1 %9 to i32
  br i1 %9, label %11, label %12

11:                                               ; preds = %7
  ret i32 -2

12:                                               ; preds = %7
  %13 = extractelement <8 x i32> %high, i32 7
  %14 = icmp ne i32 %13, 3
  %15 = zext i1 %14 to i32
  br i1 %14, label %16, label %17

16:                                               ; preds = %12
  ret i32 -3

17:                                               ; preds = %12
  %18 = extractelement <8 x i32> %high, i32 0
  %19 = icmp ne i32 %18, 3
  %20 = zext i1 %19 to i32
  br i1 %19, label %21, label %22

21:                                               ; preds = %17
  ret i32 -4

22:                                               ; preds = %17
  %low = insertelement <8 x i32> %high, i32 20, i32 1
  %23 = extractelement <8 x i32> %low, i32 1
  %24 = icmp ne i32 %23, 20
  %25 = zext i1 %24 to i32
  br i1 %24, label %26, label %27

26:                                               ; preds = %22
  ret i32 -5

27:                                               ; preds = %22
  %28 = extractelement <8 x i32> %low, i32 5
  %29 = icmp ne i32 %28, 40
  %30 = zext i1 %29 to i32
  br i1 %29, label %31, label %32

31:                                               ; preds = %27
  ret i32 -6

32:                                               ; preds = %27
  %33 = extractelement <8 x i32> %low, i32 6
  %34 = icmp ne i32 %33, 3
  %35 = zext i1 %34 to i32
  br i1 %34, label %36, label %37

36:                                               ; preds = %32
  ret i32 -7

37:                                               ; preds = %32
  %38 = call i32 @llvm.vector.reduce.smax.v8i32(<8 x i32> %low)
  %39 = icmp ne i32 %38, 40
  %40 = zext i1 %39 to i32
  br i1 %39, label %41, label %42

41:                                               ; preds = %37
  ret i32 -8

42:                                               ; preds = %37
  %43 = call i32 @llvm.vector.reduce.smin.v8i32(<8 x i32> %low)
  %44 = icmp ne i32 %43, 3
  %45 = zext i1 %44 to i32
  br i1 %44, label %46, label %47

46:                                               ; preds = %42
  ret i32 -9

47:                                               ; preds = %42
  %48 = call i32 @llvm.vector.reduce.add.v8i32(<8 x i32> %low)
  %49 = icmp ne i32 %48, 78
  %50 = zext i1 %49 to i32
  br i1 %49, label %51, label %52

51:                                               ; preds = %47
  ret i32 -10

52:                                               ; preds = %47
  %53 = mul i32 %28, 10
  %54 = add i32 %53, %23
  ret i32 %54
}

; Function Attrs: nocallback nofree nosync nounwind speculatable willreturn memory(none)
declare i32 @llvm.vector.reduce.smax.v8i32(<8 x i32>) #1

; Function Attrs: nocallback nofree nosync nounwind speculatable willreturn memory(none)
declare i32 @llvm.vector.reduce.smin.v8i32(<8 x i32>) #1

; Function Attrs: nocallback nofree nosync nounwind speculatable willreturn memory(none)
declare i32 @llvm.vector.reduce.add.v8i32(<8 x i32>) #1

attributes #0 = { "probe-stack"="inline-asm" }
attributes #1 = { nocallback nofree nosync nounwind speculatable willreturn memory(none) }
