@image$base = []

resetThenAdd<clobber, x86_legacy_sse>(%lhs: i32x4, %rhs: i32x4): Int {
  b_0 {
    vzeroupper 
    %v_1 = add %lhs, %rhs: i32x4
    %v_2 = vlane %v_1, 0: Int
    ret %v_2
  }
}

plainReset<complex>(%x: Int): Int {
  b_0 {
    vzeroupper 
    %v_1 = add %x, 1: Int
    ret %v_1
  }
}

main<complex>(): Int {
  b_0 {
    %a = vsplat 3: i32x4
    %b = vsplat 4: i32x4
    %v_1 = call_clobber resetThenAdd, %a, %b: Int
    %v_2 = call_complex plainReset, 0: Int
    %v_3 = add %v_1, %v_2: Int
    ret %v_3
  }
}

