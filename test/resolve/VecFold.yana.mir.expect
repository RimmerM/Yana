module ResolveTest

let & a: Vec(I32) = [11, 11, 11, 11, 11, 11, 11, 11]

let & b: Vec(I32) = [31, 31, 31, 31, 31, 31, 31, 31]

fn sum'2(xs: Array(Vec(I32)) [shared call view]) -> Vec(I32) {
  local local1: Vec(I32) [shared slot 0]
  local local2: Vec(I32) [shared slot 0]

bb0:
  %0: Size = const 0
  %1: Array(Vec(I32)) [shared call view] = read borrow.shared (xs) loan0
  %2: Vec(I32) [shared slot 0] = call.subscript get(Array(Vec(I32)), Size, Vec(I32)) borrow.shared %1 borrow.shared %0 roots{0}
  write.init borrow.unique (local1) borrow.shared %2
  %4: Vec(I32) = read copy.trivial (local1)
  %5: Size = const 1
  %6: Array(Vec(I32)) [shared call view] = read borrow.shared (xs) loan1
  %7: Vec(I32) [shared slot 0] = call.subscript get(Array(Vec(I32)), Size, Vec(I32)) borrow.shared %6 borrow.shared %5 roots{1}
  write.init borrow.unique (local2) borrow.shared %7
  %9: Vec(I32) = read copy.trivial (local2)
  %10: Vec(I32) = add inspect %4 inspect %9
  return take %10
}

fn masked(xs: Array(Vec(I32)) [shared call view]) -> Vec(I32) {
  local local1: Vec(I32) [shared slot 0]
  local local2: Vec(I32) [shared slot 0]

bb0:
  %0: Size = const 0
  %1: Array(Vec(I32)) [shared call view] = read borrow.shared (xs) loan0
  %2: Vec(I32) [shared slot 0] = call.subscript get(Array(Vec(I32)), Size, Vec(I32)) borrow.shared %1 borrow.shared %0 roots{0}
  write.init borrow.unique (local1) borrow.shared %2
  %4: Vec(I32) = read copy.trivial (local1)
  %5: Size = const 1
  %6: Array(Vec(I32)) [shared call view] = read borrow.shared (xs) loan1
  %7: Vec(I32) [shared slot 0] = call.subscript get(Array(Vec(I32)), Size, Vec(I32)) borrow.shared %6 borrow.shared %5 roots{1}
  write.init borrow.unique (local2) borrow.shared %7
  %9: Vec(I32) = read copy.trivial (local2)
  %10: Vec(I32) = and inspect %4 inspect %9
  return take %10
}

fn main() -> I32 {
  local & local0: Array(Vec(I32)) object1
  local xs: Array(Vec(I32)) object1
  local s: Vec(I32)
  local m: Vec(I32)

bb0:
  %0: Vec(I32) = read copy.trivial (global a)
  %1: Vec(I32) = read copy.trivial (global b)
  %2: %Vec(I32) = run.slots Vec(I32) *2
  %3: Size = bitcast inspect %2
  %4: Size = const 0
  %5: Bool = eq inspect %3 inspect %4
  %6: {} = call checkCondition borrow.shared %5
  %7: @bits(30) U32 = const 2
  %8: @bits(2) U32 = const 1
  %9: Run(Vec(I32)) = aggregate.Run take %2 take %7 take %8
  %10: @bits(30) U32 = const 2
  %11: Array(Vec(I32)) = aggregate.Array take %9 take %10
  write.init borrow.unique (local0) take %11
  %13: Size = const 0
  write.init borrow.unique ([%%2][0]) take %0
  %15: Size = const 1
  write.init borrow.unique ([%%2][1]) take %1
  %17: Array(Vec(I32)) = read take (local0)
  write.init borrow.unique (xs) take %17
  %19: Array(Vec(I32)) [shared call] = read borrow.shared (xs) loan0
  %20: Array(Vec(I32)) [shared slot 0 view] = call.derivation elements(Array(Vec(I32)), Vec(I32)) borrow.shared %19 roots{0}
  %21: Vec(I32) = call sum'2 borrow.shared %20
  write.init borrow.unique (s) take %21
  %23: Array(Vec(I32)) [shared call] = read borrow.shared (xs) loan1
  %24: Array(Vec(I32)) [shared slot 0 view] = call.derivation elements(Array(Vec(I32)), Vec(I32)) borrow.shared %23 roots{1}
  %25: Vec(I32) = call masked borrow.shared %24
  drop (xs)
  write.init borrow.unique (m) take %25
  %27: Vec(I32) = read copy.trivial (s)
  %28: I32 = const 0
  %29: I32 = vec.lane #0 inspect %27
  %30: I32 = const 100
  %31: I32 = mul inspect %29 inspect %30
  %32: Vec(I32) = read copy.trivial (m)
  %33: I32 = const 1
  %34: I32 = vec.lane #1 inspect %32
  %35: I32 = add inspect %31 inspect %34
  return take %35
}

entry main
