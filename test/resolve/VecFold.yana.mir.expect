module ResolveTest

let & a: Vec(I32) = [11, 11, 11, 11, 11, 11, 11, 11]

let & b: Vec(I32) = [31, 31, 31, 31, 31, 31, 31, 31]

fn sum'2(xs: Array(Vec(I32)) [shared call view]) -> Vec(I32) {
  local local1: Vec(I32) [shared slot 0]
  local local2: Vec(I32) [shared slot 0]

bb0:
  %0: Size = const 0
  %1: Array(Vec(I32)) [shared call view] = read borrow.shared (xs) loan0
  %2: Vec(I32) [shared slot 0] = call.subscript get(Array(Vec(I32)), Size, Vec(I32)) borrow.shared %1 borrow.shared %0 roots{0}
  write.init borrow.unique (local1) borrow.shared %2
  %4: Vec(I32) = read copy.trivial (local1)
  %5: Size = const 1
  %6: Array(Vec(I32)) [shared call view] = read borrow.shared (xs) loan1
  %7: Vec(I32) [shared slot 0] = call.subscript get(Array(Vec(I32)), Size, Vec(I32)) borrow.shared %6 borrow.shared %5 roots{1}
  write.init borrow.unique (local2) borrow.shared %7
  %9: Vec(I32) = read copy.trivial (local2)
  %10: Vec(I32) = add inspect %4 inspect %9
  return take %10
}

fn masked(xs: Array(Vec(I32)) [shared call view]) -> Vec(I32) {
  local local1: Vec(I32) [shared slot 0]
  local local2: Vec(I32) [shared slot 0]

bb0:
  %0: Size = const 0
  %1: Array(Vec(I32)) [shared call view] = read borrow.shared (xs) loan0
  %2: Vec(I32) [shared slot 0] = call.subscript get(Array(Vec(I32)), Size, Vec(I32)) borrow.shared %1 borrow.shared %0 roots{0}
  write.init borrow.unique (local1) borrow.shared %2
  %4: Vec(I32) = read copy.trivial (local1)
  %5: Size = const 1
  %6: Array(Vec(I32)) [shared call view] = read borrow.shared (xs) loan1
  %7: Vec(I32) [shared slot 0] = call.subscript get(Array(Vec(I32)), Size, Vec(I32)) borrow.shared %6 borrow.shared %5 roots{1}
  write.init borrow.unique (local2) borrow.shared %7
  %9: Vec(I32) = read copy.trivial (local2)
  %10: Vec(I32) = and inspect %4 inspect %9
  return take %10
}

fn main() -> I32 {
  local & local0: Array(Vec(I32)) object0
  local xs: Array(Vec(I32)) object0
  local s: Vec(I32)
  local m: Vec(I32)

bb0:
  %0: Vec(I32) = read copy.trivial (global a)
  %1: Vec(I32) = read copy.trivial (global b)
  %2: Size = const 2
  %3: Array(Vec(I32)) = call literalArray(Vec(I32)) borrow.shared %2
  write.init borrow.unique (local0) take %3
  %5: Array(Vec(I32)) [unique slot 0] = read borrow.unique (local0) loan0
  %6: Array(Vec(I32)) [unique slot 0 view] = call.derivation elementsMut(Array(Vec(I32)), Vec(I32)) borrow.unique %5 roots{0}
  %7: %Vec(I32) [owned here shape6 .*=shared slot 0] = call valuesMut(Vec(I32)) borrow.unique %6 roots.0{0}
  %8: Size = const 0
  write.init borrow.unique ([%%7][0]) take %0
  %10: Size = const 1
  write.init borrow.unique ([%%7][1]) take %1
  %12: Array(Vec(I32)) = read take (local0)
  write.init borrow.unique (xs) take %12
  %14: Array(Vec(I32)) [shared call] = read borrow.shared (xs) loan1
  %15: Array(Vec(I32)) [shared slot 0 view] = call.derivation elements(Array(Vec(I32)), Vec(I32)) borrow.shared %14 roots{1}
  %16: Vec(I32) = call sum'2 borrow.shared %15
  write.init borrow.unique (s) take %16
  %18: Array(Vec(I32)) [shared call] = read borrow.shared (xs) loan2
  %19: Array(Vec(I32)) [shared slot 0 view] = call.derivation elements(Array(Vec(I32)), Vec(I32)) borrow.shared %18 roots{2}
  %20: Vec(I32) = call masked borrow.shared %19
  drop (xs)
  write.init borrow.unique (m) take %20
  %22: Vec(I32) = read copy.trivial (s)
  %23: I32 = const 0
  %24: I32 = vec.lane #0 inspect %22
  %25: I32 = const 100
  %26: I32 = mul inspect %24 inspect %25
  %27: Vec(I32) = read copy.trivial (m)
  %28: I32 = const 1
  %29: I32 = vec.lane #1 inspect %27
  %30: I32 = add inspect %26 inspect %29
  return take %30
}

entry main
