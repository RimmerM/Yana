fn maybeArr(n: I32 [shared call]) -> Maybe(Array(I32)) {
  local & local1: Array(I32)

bb0:
  %0: I32 = read copy.trivial (n)
  %1: I32 = const 0
  %2: Bool = gt inspect %0 inspect %1
  branch inspect %2 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %27: Maybe(Array(I32)) = aggregate.Nothing
  return take %27

bb3:
  %4: I32 = read copy.trivial (n)
  %5: I32 = read copy.trivial (n)
  %6: I32 = const 2
  %7: I32 = mul inspect %5 inspect %6
  %8: I32 = read copy.trivial (n)
  %9: I32 = const 3
  %10: I32 = mul inspect %8 inspect %9
  %11: Size = const 3
  %12: Array(I32) = call literalArray(I32) borrow.shared %11
  write.init borrow.unique (local1) take %12
  %14: Array(I32) [unique slot 0] = read borrow.unique (local1) loan0
  %15: Array(I32) [unique slot 0 view] = call.derivation elementsMut(Array(I32), I32) borrow.unique %14 roots{0}
  %16: %I32 [owned here shape6 .*=shared slot 0] = call valuesMut(I32) borrow.unique %15 roots.0{0}
  %17: Size = const 0
  write.init borrow.unique ([%%16][0]) take %4
  %19: Size = const 1
  write.init borrow.unique ([%%16][1]) take %7
  %21: Size = const 2
  write.init borrow.unique ([%%16][2]) take %10
  %23: Array(I32) = read take (local1)
  %24: Maybe(Array(I32)) = aggregate.Just take %23
  return take %24
}

