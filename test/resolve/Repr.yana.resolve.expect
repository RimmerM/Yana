let image$base: () = <none>

fn idOr(%m: Maybe(@bits(53) U64), %fallback: @bits(53) U64) -> @bits(53) U64 {
  b0:
    %v2 = load %m.discriminant : I32
    %v4 = cmp_eq %v2, 1 : Bool
    je %v4, b2, b1

  b1:
    jmp b3

  b2:
    %v = load %m@Just : @bits(53) U64
    jmp b3

  b3:
    %v9 = phi [b2, %v], [b1, %fallback] : @bits(53) U64
    ret %v9
}

