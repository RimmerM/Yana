module ResolveTest

data Flags {read: Bool, write: Bool}

fn score(f: Flags [shared call]) -> I32 {
bb0:
  %0: Bool = read copy.trivial (f.read)
  branch inspect %0 -> bb1 -> bb2

bb1:
  %2: I32 = const 10
  jump -> bb3(take %2)

bb2:
  %3: I32 = const 20
  jump -> bb3(take %3)

bb3(%4: I32):
  return take %4
}

fn straight() -> I32 {
  local f: Flags
  local handed: I32
  local before: I32
  local again: I32
  local after: I32

bb0:
  %0: Bool = const True
  %1: Bool = const False
  %2: Flags = aggregate take %0 take %1
  write.init borrow.unique (f) take %2
  %4: Flags = read copy.trivial (f)
  %5: I32 = call score borrow.shared %4
  write.init borrow.unique (handed) take %5
  %7: Bool = read copy.trivial (f.read)
  branch inspect %7 -> bb1 -> bb2

bb1:
  %9: I32 = const 1
  jump -> bb3(take %9)

bb2:
  %10: I32 = const 2
  jump -> bb3(take %10)

bb3(%11: I32):
  write.init borrow.unique (before) take %11
  %15: Flags = read copy.trivial (f)
  %16: I32 = call score borrow.shared %15
  write.init borrow.unique (again) take %16
  %18: Bool = read copy.trivial (f.write)
  branch inspect %18 -> bb4 -> bb5

bb4:
  %20: I32 = const 4
  jump -> bb6(take %20)

bb5:
  %21: I32 = const 8
  jump -> bb6(take %21)

bb6(%22: I32):
  write.init borrow.unique (after) take %22
  %26: I32 = read copy.trivial (handed)
  %27: I32 = read copy.trivial (before)
  %28: I32 = add inspect %26 inspect %27
  %29: I32 = read copy.trivial (again)
  %30: I32 = add inspect %28 inspect %29
  %31: I32 = read copy.trivial (after)
  %32: I32 = add inspect %30 inspect %31
  return take %32
}

fn branching() -> I32 {
  local f: Flags
  local ignored: I32

bb0:
  %0: Bool = const False
  %1: Bool = const True
  %2: Flags = aggregate take %0 take %1
  write.init borrow.unique (f) take %2
  %4: Flags = read copy.trivial (f)
  %5: I32 = call score borrow.shared %4
  write.init borrow.unique (ignored) take %5
  %7: Bool = read copy.trivial (f.write)
  branch inspect %7 -> bb1 -> bb2

bb1:
  %9: I32 = read copy.trivial (ignored)
  %10: I32 = const 100
  %11: I32 = add inspect %9 inspect %10
  return take %11

bb2:
  jump -> bb3

bb3:
  %14: I32 = read copy.trivial (ignored)
  return take %14
}

fn mutate(f: Flags [unique call]) -> I32 {
bb0:
  %0: Bool = const True
  write.assign borrow.unique (f.read) take %0
  %2: I32 = const 0
  return take %2
}

fn borrowed() -> I32 {
  local & f: Flags
  local zero: I32

bb0:
  %0: Bool = const False
  %1: Bool = const False
  %2: Flags = aggregate take %0 take %1
  write.init borrow.unique (f) take %2
  %4: Flags [unique call] = read borrow.unique (f) loan0
  %5: I32 = call mutate borrow.unique %4
  write.init borrow.unique (zero) take %5
  %7: Bool = read copy.trivial (f.read)
  branch inspect %7 -> bb1 -> bb2

bb1:
  %9: I32 = const 1000
  jump -> bb3(take %9)

bb2:
  %10: I32 = const 2000
  jump -> bb3(take %10)

bb3(%11: I32):
  %14: I32 = read copy.trivial (zero)
  %15: I32 = add inspect %11 inspect %14
  return take %15
}

fn main() -> I32 {
bb0:
  %0: I32 = call straight
  %1: I32 = call branching
  %2: I32 = add inspect %0 inspect %1
  %3: I32 = call borrowed
  %4: I32 = add inspect %2 inspect %3
  return take %4
}

entry main
