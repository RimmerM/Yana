  %11: Vec(I32) = read copy.trivial (a)
  %12: Vec(I32) = select inspect %9 inspect %10 inspect %11
  write.init borrow.unique (larger) take %12
  %14: Vec(I32) = read copy.trivial (smaller)
  %15: I32 = const 0
  %16: I32 = vec.lane #0 inspect %14
  %17: I32 = const 3
  %18: Bool = ne inspect %16 inspect %17
  branch inspect %18 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %23: Vec(I32) = read copy.trivial (larger)
  %24: I32 = const 1
  %25: I32 = vec.lane #1 inspect %23
  %26: I32 = const 4
  %27: Bool = ne inspect %25 inspect %26
