fn add(a: Int, b: Int) -> Int = a + b

fn noop() -> {}:
    return

fn local(value: Int) -> Int = let next = value + 1 in next * 2

fn choose(a: Int, b: Int) -> Int = if a > b then add(a, 1) else b

fn classify(value: Int) -> Int = if:
    value < 0 -> -1
    value == 0 -> 0
    else -> 1

fn main() -> Int:
    noop()
    let value = choose(2, 1)
    while False:
        return 99
    return value * 2 + classify(5) + local(0) - 2
