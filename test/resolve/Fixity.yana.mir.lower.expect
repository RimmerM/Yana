mut @counter = [0, 0, 0, 0]

main<complex>(): I32 {
  b_0 {
    %v_1 = call_complex lastWins.thunk: I32
    %v_2 = call_complex allEvaluated.thunk: I32
    %v_3 = add 1, %v_2: I32
    %v_4 = loads @counter, 4: I32
    %v_5 = add %v_3, %v_4: I32
    %v_6 = add %v_1, 219: I32
    %v_7 = add %v_6, %v_5: I32
    %v_8 = add %v_7, 1: I32
    ret %v_8
  }
}

@header(lastWins.thunk) = [0, 0, 0, 0]
lastWins.thunk<complex>(): I32 {
  b_0 {
    %v_1 = call_complex lastWins.thunk.thunk: I32
    ret %v_1
  }
}

@header(lastWins.thunk.thunk) = [0, 0, 0, 0]
lastWins.thunk.thunk<complex>(): I32 {
  b_0 {
    ret 3
  }
}

@header(allEvaluated.thunk) = [0, 0, 0, 0]
allEvaluated.thunk<complex>(): I32 {
  b_0 {
    %counter = global @counter: Ptr
    %v_1 = loads %counter, 4: I32
    %v_2 = add %v_1, 1: I32
    store %counter, %v_2, 4
    %v_3 = call_complex allEvaluated.thunk.thunk: I32
    ret %v_3
  }
}

@header(allEvaluated.thunk.thunk) = [0, 0, 0, 0]
allEvaluated.thunk.thunk<complex>(): I32 {
  b_0 {
    %counter = global @counter: Ptr
    %v_1 = loads %counter, 4: I32
    %v_2 = add %v_1, 1: I32
    store %counter, %v_2, 4
    ret 20
  }
}

