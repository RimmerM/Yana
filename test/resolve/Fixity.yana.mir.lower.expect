mut @counter = [0, 0, 0, 0]

main<complex>(): I32 {
  b_0 {
    %v_1 = bitcast 0: Ptr
    %v_2 = call_complex lastWins.thunk, %v_1: I32
    %v_3 = add 7, %v_2: I32
    %v_4 = bitcast 0: Ptr
    %v_5 = call_complex allEvaluated.thunk, %v_4: I32
    %v_6 = add 1, %v_5: I32
    %v_7 = loads @counter, 4: I32
    %v_8 = add %v_6, %v_7: I32
    %v_9 = add 212, %v_3: I32
    %v_10 = add %v_9, %v_8: I32
    %v_11 = add %v_10, 1: I32
    ret %v_11
  }
}

