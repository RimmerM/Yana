{-
   What the AES-NI and PCLMULQDQ intrinsics refuse - the trailing byte of `aesKeygenAssist` and of
   `carrylessMultiply`, checked where it is written because below that point it is a field of an
   instruction and there is nothing to point at.

   # extensions: avx512

   A round constant is any byte and must be a literal. A selector must be a literal and one of the
   four values `pclmulqdq` reads - a program that set one of the six bits the instruction ignores
   meant something else, so it is refused rather than masked.

   # resolver: ownership
-}
import Native

fn computedConstant(key: Vec(U8, 16), rcon: Int) -> Vec(U8, 16) = X86.aesKeygenAssist(key, rcon)

fn constantTooWide(key: Vec(U8, 16)) -> Vec(U8, 16) = X86.aesKeygenAssist(key, 256)

fn computedSelector(a: Vec(U64, 2), b: Vec(U64, 2), s: Int) -> Vec(U64, 2) = X86.carrylessMultiply(a, b, s)

fn otherBits(a: Vec(U64, 2), b: Vec(U64, 2)) -> Vec(U64, 2) = X86.carrylessMultiply(a, b, 0x02)

fn wideOtherBits(a: Vec(U64, 4), b: Vec(U64, 4)) -> Vec(U64, 4) = X86.carrylessMultiply2(a, b, 0x12)

fn main() -> Int = 0
