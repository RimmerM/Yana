module ResolveTest

data Diagnostics {count: I32, level: I32}

data Config {hot: I32, cold: @box Diagnostics} reclaim derived

data Pinned {tag: I32, detail: @box Diagnostics} reclaim derived

data Holder(a) {v: @box a, n: I32} drop derived reclaim derived

data Holder({}) {v: @box {}, n: I32} of Holder

fn levelOf(d: Diagnostics [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (d.level)
  return take %0
}

fn raise(d: Diagnostics [unique call]) -> {} {
bb0:
  %0: I32 [unique call] = read borrow.unique (d.count) loan0
  %1: I32 = const 1
  %2: {} = call +=(I32) borrow.unique %0 borrow.shared %1
  return
}

fn mutated() -> I32 {
  local & c: Config

bb0:
  %0: I32 = const 3
  %1: I32 = const 1
  %2: I32 = const 20
  %3: Diagnostics = aggregate.Diagnostics take %1 take %2
  %4: Config = aggregate.Config take %0 take %3
  write.init borrow.unique (c) take %4
  %6: Diagnostics [unique call] = read borrow.unique (c.cold) loan0
  %7: {} = call raise borrow.unique %6
  %8: I32 = read copy.trivial (c.cold.level)
  %9: I32 = const 1
  %10: I32 = add inspect %8 inspect %9
  write.assign borrow.unique (c.cold.level) take %10
  %12: I32 = read copy.trivial (c.hot)
  %13: I32 = const 1000
  %14: I32 = mul inspect %12 inspect %13
  %15: I32 = read copy.trivial (c.cold.count)
  %16: I32 = const 100
  %17: I32 = mul inspect %15 inspect %16
  %18: I32 = add inspect %14 inspect %17
  %19: Diagnostics = read copy.trivial (c.cold)
  drop (c)
  %20: I32 = call levelOf borrow.shared %19
  %21: I32 = add inspect %18 inspect %20
  return take %21
}

fn pinnedValue() -> I32 {
  local p: Pinned

bb0:
  %0: I32 = const 5
  %1: I32 = const 2
  %2: I32 = const 3
  %3: Diagnostics = aggregate.Diagnostics take %1 take %2
  %4: Pinned = aggregate.Pinned take %0 take %3
  write.init borrow.unique (p) take %4
  %6: I32 = read copy.trivial (p.tag)
  %7: I32 = const 100
  %8: I32 = mul inspect %6 inspect %7
  %9: I32 = read copy.trivial (p.detail.count)
  %10: I32 = const 10
  %11: I32 = mul inspect %9 inspect %10
  %12: I32 = add inspect %8 inspect %11
  %13: I32 = read copy.trivial (p.detail.level)
  drop (p)
  %14: I32 = add inspect %12 inspect %13
  return take %14
}

lens fn levelIn(c: Config [shared call], $body: (I32) -> $r [shared call]) -> $r {
  form specialized
  slot #0 type $r
  local $yielded: $r

bb0:
  %0: I32 = read copy.trivial (c.cold.level)
  %1: (I32) -> $r [shared call] = read borrow.shared ($body) loan0
  %2: $r = call inspect %1 borrow.shared %0
  write.init borrow.unique ($yielded) take %2
  %4: $r = read take ($yielded)
  return take %4
}

fn throughLens() -> I32 {
  local & c: Config
  local v: I32 [shared call]

bb0:
  %0: I32 = const 3
  %1: I32 = const 6
  %2: I32 = const 40
  %3: Diagnostics = aggregate.Diagnostics take %1 take %2
  %4: Config = aggregate.Config take %0 take %3
  write.init borrow.unique (c) take %4
  %6: Config [shared call] = read borrow.shared (c) loan0
  lens.call levelIn(I32) borrow.shared %6 -> bb1
  leave: drop (c)

bb1(%7: I32 [shared call]) handover(I32 [shared call]):
  write.init borrow.unique (v) borrow.shared %7
  %10: I32 = read copy.trivial (v)
  %11: I32 = read copy.trivial (c.cold.count)
  %12: I32 = add inspect %10 inspect %11
  return take %12
}

fn countOf(h: Holder({}) [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (h.n)
  return take %0
}

fn main() -> I32 {
  local m: I32
  local l: I32

bb0:
  %0: I32 = call mutated
  write.init borrow.unique (m) take %0
  %2: I32 = read copy.trivial (m)
  %3: I32 = const 3221
  %4: Bool = ne inspect %2 inspect %3
  branch inspect %4 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %9: I32 = call throughLens
  write.init borrow.unique (l) take %9
  %11: I32 = read copy.trivial (l)
  %12: I32 = const 46
  %13: Bool = ne inspect %11 inspect %12
  branch inspect %13 -> bb6 -> bb4

bb3:
  %6: I32 = const -2
  return take %6

bb4:
  jump -> bb5

bb5:
  %18: I32 = read copy.trivial (m)
  %19: I32 = read copy.trivial (l)
  %20: I32 = add inspect %18 inspect %19
  %21: I32 = call pinnedValue
  %22: I32 = add inspect %20 inspect %21
  return take %22

bb6:
  %15: I32 = const -3
  return take %15
}

lens fn levelIn(I32)(c: Config [shared call], $body: (I32) -> I32 [shared call]) -> I32 = <levelIn at I32>

entry main
