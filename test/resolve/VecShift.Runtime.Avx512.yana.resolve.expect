let image$base: () = <none>

let &counter: I32 = 0

fn opaque(%n: I32) -> I32 {
  b0:
    %v1 = load counter : I32
    %v2 = add %v1, %n : I32
    assign counter, %v2
    %v4 = load counter : I32
    %v7 = cmp_gt %v4, 1000 : Bool
    je %v7, b1, b2

  b1:
    ret 1

  b2:
    jmp b3

  b3:
    ret %n
}

fn shifts(%a: Vec(I32), %n: I32) -> I32 {
  b0:
    %count = vsplat %n : Vec(I32)
    %left = shl %a, %count : Vec(I32)
    %right = shr %a, %count : Vec(I32)
    %arith = sar %a, %count : Vec(I32)
    %v8 = vlane %left, 0 : I32
    %v11 = vlane %right, 1 : I32
    %v12 = add %v8, %v11 : I32
    %v15 = vlane %arith, 2 : I32
    %v16 = add %v12, %v15 : I32
    ret %v16
}

fn quad(%b: Vec(I64), %n: I64) -> I64 {
  b0:
    %v2 = vsplat %n : Vec(I64)
    %up = shl %b, %v2 : Vec(I64)
    %v6 = sub %n, 1 : I64
    %v7 = vsplat %v6 : Vec(I64)
    %down = shr %up, %v7 : Vec(I64)
    %v12 = vsplat 0 : Vec(I64)
    %v13 = sub %v12, %b : Vec(I64)
    %v14 = vsplat %n : Vec(I64)
    %signed = sar %v13, %v14 : Vec(I64)
    %v18 = vlane %down, 0 : I64
    %v21 = vlane %signed, 0 : I64
    %v22 = add %v18, %v21 : I64
    ret %v22
}

fn main() -> I32 {
  b0:
    %v2 = vsplat 64 : Vec(I32)
    %v7 = vwithlane %v2, 5, 0 : Vec(I32)
    %v12 = vwithlane %v7, 100, 1 : Vec(I32)
    %v18 = sub 0, 32 : I32
    %a = vwithlane %v12, %v18, 2 : Vec(I32)
    %b = vsplat 3 : Vec(I64)
    %n = call opaque, 2 : I32
    %v26 = call opaque, 3 : I32
    %m = cast %v26 : I64
    %v28 = call shifts, %a, %n : I32
    %v29 = call quad, %b, %m : I64
    %v30 = cast %v29 : I32
    %v31 = add %v28, %v30 : I32
    ret %v31
}
