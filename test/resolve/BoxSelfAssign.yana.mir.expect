module ResolveTest

data Boxed = Leaf | Node {next: @box Boxed, v: I32} reclaim derived

data Big {a: I64, b: I64, c: I64, d: I64}

data Wrap {inner: Big, n: I64}

fn depth(b: Boxed [shared call]) -> I32 {
  local next: Boxed [shared call]
  local v: I32

bb0:
  %0: U8 = read copy.trivial (b.#)
  %1: U8 = const 0
  %2: Bool = eq inspect %0 inspect %1
  branch inspect %2 -> bb3 -> bb1

bb1:
  %5: Boxed [shared call] = read borrow.shared (b.next) loan0
  write.init borrow.unique (next) borrow.shared %5
  %7: I32 = read copy.trivial (b.v)
  write.init borrow.unique (v) take %7
  %9: I32 = const 1
  %10: Boxed [shared call] = read borrow.shared (next) loan1 roots{0}
  %11: I32 = call depth borrow.shared %10
  %12: I32 = add inspect %9 inspect %11
  jump -> bb2(take %12)

bb2(%13: I32):
  return take %13

bb3:
  %4: I32 = const 0
  jump -> bb2(take %4)
}

fn sum'2(b: Boxed [shared call]) -> I32 {
  local next: Boxed [shared call]
  local v: I32

bb0:
  %0: U8 = read copy.trivial (b.#)
  %1: U8 = const 0
  %2: Bool = eq inspect %0 inspect %1
  branch inspect %2 -> bb3 -> bb1

bb1:
  %5: Boxed [shared call] = read borrow.shared (b.next) loan0
  write.init borrow.unique (next) borrow.shared %5
  %7: I32 = read copy.trivial (b.v)
  write.init borrow.unique (v) take %7
  %9: I32 = read copy.trivial (v)
  %10: Boxed [shared call] = read borrow.shared (next) loan1 roots{0}
  %11: I32 = call sum'2 borrow.shared %10
  %12: I32 = add inspect %9 inspect %11
  jump -> bb2(take %12)

bb2(%13: I32):
  return take %13

bb3:
  %4: I32 = const 0
  jump -> bb2(take %4)
}

fn once() -> I32 {
  local & b: Boxed

bb0:
  %0: Boxed = aggregate.Leaf
  write.init borrow.unique (b) take %0
  %2: Boxed = read take (b)
  %3: I32 = const 1
  %4: Boxed = aggregate.Node take %2 take %3
  write.reinit borrow.unique (b) take %4
  %6: Boxed [shared call] = read borrow.shared (b) loan0
  %7: I32 = call depth borrow.shared %6
  drop (b)
  return take %7
}

fn chain(n: I32 [shared call]) -> Boxed {
  local & b: Boxed
  local & local2: I32
  local i: I32

bb0:
  %0: Boxed = aggregate.Leaf
  write.init borrow.unique (b) take %0
  %2: I32 = read copy.trivial (n)
  %3: I32 = const 0
  %4: I32 = const 1
  write.init borrow.unique (local2) take %3
  jump -> bb1(take %2, take %4)

bb1(%5: I32, %6: I32):
  %13: I32 = read copy.trivial (local2)
  %14: Bool = lt inspect %13 inspect %5
  branch inspect %14 -> bb4(take %5, take %6) -> bb3(take %5, take %6)

bb2(%7: I32, %8: I32):
  %25: I32 = read copy.trivial (local2)
  %26: I32 = add inspect %25 inspect %8
  write.assign borrow.unique (local2) take %26
  jump -> bb1(take %7, take %8)

bb3(%9: I32, %10: I32):
  %29: Boxed = read take (b)
  return take %29

bb4(%15: I32, %16: I32):
  %18: I32 = read copy.trivial (local2)
  write.init borrow.unique (i) take %18
  %20: Boxed = read take (b)
  %21: I32 = read copy.trivial (i)
  %22: Boxed = aggregate.Node take %20 take %21
  write.reinit borrow.unique (b) take %22
  jump -> bb2(take %15, take %16)
}

fn nested() -> I64 {
  local & u: Wrap

bb0:
  %0: I64 = const 1
  %1: I64 = const 2
  %2: I64 = const 3
  %3: I64 = const 4
  %4: Big = aggregate.Big take %0 take %1 take %2 take %3
  %5: I64 = const 0
  %6: Wrap = aggregate.Wrap take %4 take %5
  write.init borrow.unique (u) take %6
  %8: I64 = read copy.trivial (u.inner.d)
  %9: I64 = read copy.trivial (u.inner.c)
  %10: I64 = read copy.trivial (u.inner.b)
  %11: I64 = read copy.trivial (u.inner.a)
  %12: Big = aggregate.Big take %8 take %9 take %10 take %11
  %13: I64 = read copy.trivial (u.inner.a)
  %14: Wrap = aggregate.Wrap take %12 take %13
  write.assign borrow.unique (u) take %14
  %16: I64 = read copy.trivial (u.inner.a)
  %17: I64 = const 1000
  %18: I64 = mul inspect %16 inspect %17
  %19: I64 = read copy.trivial (u.inner.b)
  %20: I64 = const 100
  %21: I64 = mul inspect %19 inspect %20
  %22: I64 = add inspect %18 inspect %21
  %23: I64 = read copy.trivial (u.inner.c)
  %24: I64 = const 10
  %25: I64 = mul inspect %23 inspect %24
  %26: I64 = add inspect %22 inspect %25
  %27: I64 = read copy.trivial (u.inner.d)
  %28: I64 = add inspect %26 inspect %27
  %29: I64 = read copy.trivial (u.n)
  %30: I64 = const 10000
  %31: I64 = mul inspect %29 inspect %30
  %32: I64 = add inspect %28 inspect %31
  return take %32
}

fn main() -> I32 {
  local c: Boxed

bb0:
  %0: I32 = const 5
  %1: Boxed = call chain borrow.shared %0
  write.init borrow.unique (c) take %1
  %3: I32 = call once
  %4: I32 = const 1000000
  %5: I32 = mul inspect %3 inspect %4
  %6: Boxed [shared call] = read borrow.shared (c) loan0
  %7: I32 = call depth borrow.shared %6
  %8: I32 = const 100000
  %9: I32 = mul inspect %7 inspect %8
  %10: I32 = add inspect %5 inspect %9
  %11: Boxed [shared call] = read borrow.shared (c) loan1
  %12: I32 = call sum'2 borrow.shared %11
  drop (c)
  %13: I32 = const 1000
  %14: I32 = mul inspect %12 inspect %13
  %15: I32 = add inspect %10 inspect %14
  %16: I64 = call nested
  %17: I64 = const 14000
  %18: I64 = sub inspect %16 inspect %17
  %19: I32 = convert inspect %18
  %20: I32 = add inspect %15 inspect %19
  return take %20
}

entry main
