@image$base = []

opaque<complex>(%n: I32): I32 {
  b_0 {
    %v_1 = add %n, 1: I32
    ret %v_1
  }
}

bumpRead<complex>(%x: Ptr): I32 {
  b_0 {
    %v_1 = load %x, 4: I32
    %v_2 = add %v_1, 20: I32
    store %x, %v_2, 4
    ret %v_2
  }
}

twiceWrite<complex>(%x: Ptr): I32 {
  b_0 {
    store %x, 101, 4
    ret 100
  }
}

bumpLoop<complex>(%x: Ptr, %n: I32): I32 {
  b_0 {
    jmp b_1
  }

  b_1 {
    %v_2 = phi [b_0, 0], [b_3, %v_4]: I32
    %v_5 = cmp_ilt %v_2, %n: I32
    je %v_5, b_6, b_7
  }

  b_6 {
    %v_8 = load %x, 4: I32
    %v_9 = add %v_8, 10: I32
    store %x, %v_9, 4
    %v_10 = call_complex opaque, %v_2: I32
    %v_11 = cmp_igt %v_10, 100: I32
    je %v_11, b_12, b_13
  }

  b_12 {
    %v_14 = load %x, 4: I32
    %v_15 = add %v_14, 1: I32
    store %x, %v_15, 4
    jmp b_3
  }

  b_13 {
    jmp b_3
  }

  b_3 {
    %v_4 = add %v_2, 1: I32
    jmp b_1
  }

  b_7 {
    %v_16 = load %x, 4: I32
    ret %v_16
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    store %v_1, 3, 4
    %r1 = call_complex bumpRead, %v_1: I32
    %v_2 = load %v_1, 4: I32
    %v_3 = and %v_2, 15: I32
    %v_4 = add %v_3, 20: I32
    %v_5 = and %v_4, 15: I32
    %v_6 = alloca 4, 4: Ptr
    store %v_6, 5, 4
    %r3 = call_complex twiceWrite, %v_6: I32
    %v_7 = load %v_6, 4: I32
    %v_8 = and %v_7, 7: I32
    %v_9 = alloca 4, 4: Ptr
    store %v_9, 1000, 4
    %r4 = call_complex bumpLoop, %v_9, 3: I32
    %v_10 = load %v_9, 4: I32
    %v_11 = and %v_10, 8191: I32
    %v_12 = alloca 4, 4: Ptr
    store %v_12, %v_5, 4
    %r5 = call_complex bumpLoop, %v_12, 2: I32
    %v_13 = load %v_12, 4: I32
    %v_14 = and %v_13, 15: I32
    %v_15 = add %r1, %v_4: I32
    %v_16 = add %v_15, %r3: I32
    %v_17 = add %v_16, %r4: I32
    %results = add %v_17, %r5: I32
    %v_18 = add %v_14, %v_8: I32
    %fields = add %v_18, %v_11: I32
    %v_19 = mul %results, 10000: I32
    %v_20 = add %v_19, %fields: I32
    ret %v_20
  }
}

