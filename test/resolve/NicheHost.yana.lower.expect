@image$base = []

pointOr<complex>(%m: Ptr, %fallback: Int): Int {
  b_0 {
    %v_1 = loads %m, 4: Int
    %v_2 = cmp_eq %v_1, 0: Int
    je %v_2, b_3, b_4
  }

  b_4 {
    %v_5 = add %m, 4: Ptr
    %v_6 = loads %v_5, 4: Int
    %v_7 = imul %v_6, 10: Int
    %v_8 = add %m, 8: Ptr
    %v_9 = loads %v_8, 4: Int
    %v_10 = add %v_7, %v_9: Int
    jmp b_11
  }

  b_3 {
    jmp b_11
  }

  b_11 {
    %v_12 = phi [b_3, %fallback], [b_4, %v_10]: Int
    ret %v_12
  }
}

depthOf<complex>(%m: Ptr): Int {
  b_0 {
    %v_1 = loads %m, 4: Int
    %v_2 = cmp_eq %v_1, 0: Int
    je %v_2, b_3, b_4
  }

  b_4 {
    %v_5 = add %m, 4: Ptr
    %v_6 = loads %v_5, 4: Int
    %v_7 = cmp_eq %v_6, 0: Int
    je %v_7, b_8, b_9
  }

  b_9 {
    %v_10 = add %m, 8: Ptr
    %v_11 = loads %v_10, 4: Int
    %v_12 = imul %v_11, 10: Int
    %v_13 = add %m, 12: Ptr
    %v_14 = loads %v_13, 4: Int
    %v_15 = add %v_12, %v_14: Int
    jmp b_16
  }

  b_8 {
    jmp b_16
  }

  b_16 {
    %v_17 = phi [b_8, 0], [b_9, %v_15]: Int
    %v_18 = add %v_17, 2: Int
    jmp b_19
  }

  b_3 {
    jmp b_19
  }

  b_19 {
    %v_20 = phi [b_3, 1], [b_16, %v_18]: Int
    ret %v_20
  }
}

pairValue<complex>(%p: Ptr): Int {
  b_0 {
    %v_1 = loads %p, 4: Int
    %v_2 = cmp_eq %v_1, 0: Int
    je %v_2, b_3, b_4
  }

  b_4 {
    %v_5 = add %p, 4: Ptr
    %v_6 = loads %v_5, 4: Int
    %v_7 = imul %v_6, 10: Int
    %v_8 = add %p, 8: Ptr
    %v_9 = loads %v_8, 4: Int
    %v_10 = add %v_7, %v_9: Int
    jmp b_11
  }

  b_3 {
    jmp b_11
  }

  b_11 {
    %v_12 = phi [b_3, 7], [b_4, %v_10]: Int
    %v_13 = imul %v_12, 100: Int
    %v_14 = add %p, 12: Ptr
    %v_15 = loads %v_14, 4: Int
    %v_16 = cmp_eq %v_15, 0: Int
    je %v_16, b_17, b_18
  }

  b_18 {
    %v_19 = add %p, 16: Ptr
    %n = loads %v_19, 4: Int
    jmp b_20
  }

  b_17 {
    jmp b_20
  }

  b_20 {
    %v_21 = phi [b_17, 7], [b_18, %n]: Int
    %v_22 = add %v_13, %v_21: Int
    ret %v_22
  }
}

main<complex>(): Int {
  b_0 {
    %v_1 = alloca 12, 4: Ptr
    %v_2 = alloca 8, 4: Ptr
    store %v_2, 3, 4
    %v_3 = add %v_2, 4: Ptr
    store %v_3, 4, 4
    store %v_1, 1, 4
    %v_4 = add %v_1, 4: Ptr
    copy %v_4, %v_2, 8
    %some = call_complex pointOr, %v_1, 9: Int
    %v_5 = alloca 12, 4: Ptr
    store %v_5, 0, 4
    %none = call_complex pointOr, %v_5, 9: Int
    %v_6 = imul %none, 1000: Int
    %v_7 = add %some, %v_6: Int
    %v_8 = add %v_7, 750: Int
    %v_9 = alloca 16, 4: Ptr
    store %v_9, 0, 4
    %outer = call_complex depthOf, %v_9: Int
    %v_10 = alloca 16, 4: Ptr
    %v_11 = alloca 12, 4: Ptr
    store %v_11, 0, 4
    store %v_10, 1, 4
    %v_12 = add %v_10, 4: Ptr
    copy %v_12, %v_11, 12
    %middle = call_complex depthOf, %v_10: Int
    %v_13 = alloca 16, 4: Ptr
    %v_14 = alloca 12, 4: Ptr
    %v_15 = alloca 8, 4: Ptr
    store %v_15, 1, 4
    %v_16 = add %v_15, 4: Ptr
    store %v_16, 2, 4
    store %v_14, 1, 4
    %v_17 = add %v_14, 4: Ptr
    copy %v_17, %v_15, 8
    store %v_13, 1, 4
    %v_18 = add %v_13, 4: Ptr
    copy %v_18, %v_14, 12
    %inner = call_complex depthOf, %v_13: Int
    %v_19 = imul %middle, 10: Int
    %v_20 = add %outer, %v_19: Int
    %v_21 = imul %inner, 100: Int
    %v_22 = add %v_20, %v_21: Int
    %v_23 = add %v_8, %v_22: Int
    %v_24 = alloca 20, 4: Ptr
    %v_25 = alloca 8, 4: Ptr
    store %v_25, 2, 4
    %v_26 = add %v_25, 4: Ptr
    store %v_26, 6, 4
    store %v_24, 1, 4
    %v_27 = add %v_24, 4: Ptr
    copy %v_27, %v_25, 8
    %v_28 = alloca 8, 4: Ptr
    store %v_28, 0, 4
    %v_29 = add %v_24, 12: Ptr
    copy %v_29, %v_28, 8
    %v_30 = call_complex pairValue, %v_24: Int
    %v_31 = alloca 20, 4: Ptr
    store %v_31, 0, 4
    %v_32 = alloca 8, 4: Ptr
    store %v_32, 1, 4
    %v_33 = add %v_32, 4: Ptr
    store %v_33, 3, 4
    %v_34 = add %v_31, 12: Ptr
    copy %v_34, %v_32, 8
    %v_35 = call_complex pairValue, %v_31: Int
    %v_36 = imul %v_35, 10000: Int
    %v_37 = add %v_30, %v_36: Int
    %v_38 = add %v_23, %v_37: Int
    ret %v_38
  }
}

