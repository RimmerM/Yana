fn add(%a: Int, %b: Int) -> Int {
  b0:
    %v2 = add %a, %b : Int
    ret %v2
}

fn noop() -> () {
  b0:
    ret
}

fn local(%value: Int) -> Int {
  b0:
    %next = add %value, 1 : Int
    %v4 = mul %next, 2 : Int
    ret %v4
}

fn choose(%a: Int, %b: Int) -> Int {
  b0:
    %v2 = cmp_gt %a, %b : Bool
    je %v2, b1, b2

  b1:
    %v5 = call add, %a, 1 : Int
    jmp b3

  b2:
    jmp b3

  b3:
    %v8 = phi [b1, %v5], [b2, %b] : Int
    ret %v8
}

fn classify(%value: Int) -> Int {
  b0:
    %v2 = cmp_lt %value, 0 : Bool
    je %v2, b1, b2

  b1:
    %v5 = neg 1 : Int
    jmp b5

  b2:
    %v7 = cmp_eq %value, 0 : Bool
    je %v7, b3, b4

  b3:
    jmp b5

  b4:
    jmp b5

  b5:
    %v14 = phi [b1, %v5], [b3, 0], [b4, 1] : Int
    ret %v14
}

fn main() -> Int {
  b0:
    call noop
    %value = call choose, 2, 1 : Int
    jmp b1

  b1:
    je False, b2, b3

  b2:
    ret 99

  b3:
    %v10 = mul %value, 2 : Int
    %v12 = call classify, 5 : Int
    %v13 = add %v10, %v12 : Int
    %v15 = call local, 0 : Int
    %v16 = add %v13, %v15 : Int
    %v18 = sub %v16, 2 : Int
    ret %v18
