import Native

data Node {value: I64, next: %Node}

-- Reading and writing through a raw pointer. `addressOf` is what forces `slot` into storage
-- rather than a register, and `*p` and `*p = v` are the same place read two ways.
fn roundTrip() -> I64:
    let slot = 7 :: I64
    let p = addressOf(slot)

    *p = *p + 1
    return *p

-- A field of an aggregate reached through a pointer to it, in both directions. Written with an
-- explicit dereference, which is now the long way round of the function below it: `(*p).value` and
-- `p.value` name the same place, and the parenthesized form composes with everything the direct
-- one does.
fn throughField() -> I64:
    let node = Node {value: 3, next: null()}
    let p = addressOf(node)

    (*p).value = (*p).value * 5
    return (*p).value

-- The same field, reached through the pointer directly. The place is rooted at the pointer rather
-- than at the binding holding it, which is what makes `n.value = 5` a write through an immutable
-- `let` while `n = m` on the same binding stays an error - the memory a pointer names is always
-- mutable, the pointer itself is not.
fn pointerFields() -> I64:
    let first = Node {value: 1, next: null()}
    let second = Node {value: 2, next: null()}

    let n = addressOf(first)
    let m = addressOf(second)

    n.value = 5
    n.next = m
    n.next.value = n.value + n.next.value

    return n.value * 100 + n.next.value

-- A chain reaches through as many pointers as it has links, and a pointer parameter needs no
-- storage of its own to have its fields read.
fn total(node: %Node) -> I64 = node.value + node.next.value + node.next.next.value

fn walkList() -> I64:
    let third = Node {value: 3, next: null()}
    let second = Node {value: 2, next: null()}
    let first = Node {value: 1, next: null()}

    let a = addressOf(first)
    a.next = addressOf(second)
    a.next.next = addressOf(third)

    return total(a)

-- Pointer arithmetic is in elements: `p + 1` moves by one Node however large a Node is, and the
-- same walk written in bytes has to say so.
fn elementStride() -> I64:
    let node = Node {value: 0, next: null()}
    let base = addressOf(node)
    let next = base + 1

    return difference(base, next) * 100 + difference(cast(base) :: %U8, cast(next) :: %U8)

-- Comparison and the null test, which are plain functions on `%a` rather than Eq/Ord instances.
fn compareAddresses() -> I64:
    let node = Node {value: 0, next: null()}
    let base = addressOf(node)

    let &score = 0 :: I64
    if base < base + 1 then score = score + 1
    if base == base then score = score + 2
    if isNull(null() :: %Node) then score = score + 4
    if !isNull(base) then score = score + 8

    return score

-- The block operations, over a byte view of an aggregate's storage.
fn blockOperations() -> I64:
    let source = Node {value: 9, next: null()}
    let target = Node {value: 0, next: null()}

    copyMemory(cast(addressOf(target)) :: %U8, cast(addressOf(source)) :: %U8, sizeOf(source))
    let copied = target.value

    setMemory(cast(addressOf(target)) :: %U8, 0, sizeOf(target))
    return copied * 10 + target.value

-- Sizes come from the same Repr the field offsets do.
fn sizes() -> I64 = sizeOf(0 :: I64) * 100 + alignOf(0 :: U8) * 10 + sizeOf(0 :: U16)

-- A pointer is an ordinary type argument, including where the argument has to come from an
-- ascription because the constructor carries nothing that could imply it.
fn maybePointer() -> I64:
    let slot = 0 :: U8
    let empty = Nothing :: Maybe(%U8)
    let full = Just(addressOf(slot)) :: Maybe(%U8)

    return unwrapPointer(empty) + unwrapPointer(full) * 2

fn unwrapPointer(value: Maybe(%U8)) -> I64 = match value:
    Just(p) -> if isNull(p) then 0 else 1
    Nothing -> 0

fn main() -> Int:
    let result = roundTrip() + throughField() + pointerFields() + walkList() +
                 elementStride() + compareAddresses() + blockOperations() + sizes() +
                 maybePointer()

    return result :: Int
