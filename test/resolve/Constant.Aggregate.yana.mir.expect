module ResolveTest

data Point {x: I32, y: I32}

data Line {from: Point, to: Point}

data Tagged {name: String, id: I32} reclaim derived

data Shape = Circle {Circle: I32} | Rect {w: I32, h: I32}

data Flags {low: @bits(4) U32, high: @bits(4) U32, set: Bool}

data Boxed = Packed {lo: @bits(4) U32, hi: @bits(4) U32} | Wrapped {only: I32} | Empty

data Settings {home: Point = Point {x: 2, y: 3}, label: String = "ok", mode: Shape = Rect {w: 2, h: 5}, limit: Maybe(I32) = Just(4)} reclaim derived

let origin: Point = Point {x: 3, y: 4}

let corner: Point = Point {x: 5, y: 6}

let diagonal: Line = Line {from: Point {x: 1, y: 2}, to: Point {x: 3, y: 5}}

let & cursor: Point = Point {x: 10, y: 20}

let pair: {left: I32, right: I32}

let some: Maybe(I32) = Just(9)

let none: Maybe(I32) = Nothing

let boxShape: Shape = Rect {w: 4, h: 6}

let roundShape: Shape = Circle(11)

let table: [I32 *3] = [12, 13, 14]

let corners: [Point *2] = [Point {x: 1, y: 1}, Point {x: 2, y: 4}]

let greeting: String = String {units: Array {run: Run {items: &string'144, capacity: 5, ownsHeap: 0}, length: 5}}

let labelled: Tagged = Tagged {name: String {units: Array {run: Run {items: &string'145, capacity: 6, ownsHeap: 0}, length: 6}}, id: 15}

let flags: Flags = Flags {low: 5, high: 9, set: True}

let packed: Boxed = Packed {lo: 3, hi: 6}

let wrapped: Boxed = Wrapped {only: 40}

let string'142: [CodeUnit *2] = "ok"

let string'144: [CodeUnit *5] = "hello"

let string'145: [CodeUnit *6] = "world!"

fn scaled(by: I32 [shared call], base: Point [shared call] = Point {x: 6, y: 7}) -> I32 {
bb0:
  %0: I32 = read copy.trivial (base.x)
  %1: I32 = read copy.trivial (base.y)
  %2: I32 = add inspect %0 inspect %1
  %3: I32 = read copy.trivial (by)
  %4: I32 = mul inspect %2 inspect %3
  return take %4
}

fn sum'2(p: Point [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (p.x)
  %1: I32 = read copy.trivial (p.y)
  %2: I32 = add inspect %0 inspect %1
  return take %2
}

fn area(s: Shape [shared call]) -> I32 {
  local r: I32
  local w: I32
  local h: I32

bb0:
  %0: U8 = read copy.trivial (s.#)
  %1: U8 = const 0
  %2: Bool = eq inspect %0 inspect %1
  branch inspect %2 -> bb3 -> bb1

bb1:
  %7: I32 = read copy.trivial (s.w)
  write.init borrow.unique (w) take %7
  %9: I32 = read copy.trivial (s.h)
  write.init borrow.unique (h) take %9
  %11: I32 = read copy.trivial (w)
  %12: I32 = read copy.trivial (h)
  %13: I32 = mul inspect %11 inspect %12
  jump -> bb2(take %13)

bb2(%14: I32):
  return take %14

bb3:
  %4: I32 = read copy.trivial (s.Circle)
  write.init borrow.unique (r) take %4
  %6: I32 = read copy.trivial (r)
  jump -> bb2(take %6)
}

fn unwrapOr(m: Maybe(I32) [shared call], fallback: I32 [shared call]) -> I32 {
  local v: I32

bb0:
  %0: U8 = read copy.trivial (m.#)
  %1: U8 = const 1
  %2: Bool = eq inspect %0 inspect %1
  branch inspect %2 -> bb3 -> bb1

bb1:
  %7: I32 = read copy.trivial (fallback)
  jump -> bb2(take %7)

bb2(%8: I32):
  return take %8

bb3:
  %4: I32 = read copy.trivial (m.Just)
  write.init borrow.unique (v) take %4
  %6: I32 = read copy.trivial (v)
  jump -> bb2(take %6)
}

fn boxedValue(b: Boxed [shared call]) -> I32 {
  local lo: @bits(4) U32
  local hi: @bits(4) U32
  local v: I32

bb0:
  %0: U8 = read copy.trivial (b.#)
  %1: U8 = const 0
  %2: Bool = eq inspect %0 inspect %1
  branch inspect %2 -> bb4 -> bb1

bb1:
  %15: U8 = read copy.trivial (b.#)
  %16: U8 = const 1
  %17: Bool = eq inspect %15 inspect %16
  branch inspect %17 -> bb5 -> bb2

bb2:
  %22: I32 = const 0
  jump -> bb3(take %22)

bb3(%23: I32):
  return take %23

bb4:
  %4: @bits(4) U32 = read copy.trivial (b.lo)
  write.init borrow.unique (lo) take %4
  %6: @bits(4) U32 = read copy.trivial (b.hi)
  write.init borrow.unique (hi) take %6
  %8: @bits(4) U32 = read copy.trivial (lo)
  %9: I32 = convert inspect %8
  %10: @bits(4) U32 = read copy.trivial (hi)
  %11: I32 = convert inspect %10
  %12: I32 = const 16
  %13: I32 = mul inspect %11 inspect %12
  %14: I32 = add inspect %9 inspect %13
  jump -> bb3(take %14)

bb5:
  %19: I32 = read copy.trivial (b.only)
  write.init borrow.unique (v) take %19
  %21: I32 = read copy.trivial (v)
  jump -> bb3(take %21)
}

fn flagValue(f: Flags [shared call]) -> I32 {
  local bits: I32

bb0:
  %0: @bits(4) U32 = read copy.trivial (f.low)
  %1: I32 = convert inspect %0
  %2: @bits(4) U32 = read copy.trivial (f.high)
  %3: I32 = convert inspect %2
  %4: I32 = const 16
  %5: I32 = mul inspect %3 inspect %4
  %6: I32 = add inspect %1 inspect %5
  write.init borrow.unique (bits) take %6
  %8: Bool = read copy.trivial (f.set)
  branch inspect %8 -> bb3 -> bb1

bb1:
  %13: I32 = read copy.trivial (bits)
  jump -> bb2(take %13)

bb2(%14: I32):
  return take %14

bb3:
  %10: I32 = read copy.trivial (bits)
  %11: I32 = const 256
  %12: I32 = add inspect %10 inspect %11
  jump -> bb2(take %12)
}

