  %195: Point = read copy.trivial (s.home)
  %196: I32 = call sum'2 borrow.shared %195
  %197: String [shared call] = read borrow.shared (s.label) loan2
  %198: String [shared slot 0 view] = call.derivation view(String) borrow.shared %197 roots{2}
  %199: Size = call length(String) borrow.shared %198
