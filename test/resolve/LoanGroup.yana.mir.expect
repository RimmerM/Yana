  %28: I32 = const 6
  %29: Cell = aggregate.Cell take %28
  write.init borrow.unique (fifth) take %29
  %31: I32 = const 8
  %32: Cell = aggregate.Cell take %31
  write.init borrow.unique (sixth) take %32
  %34: Cell [unique slot 0] = read borrow.unique (fifth) loan4
  %35: Cell [unique slot 0] = read borrow.unique (sixth) loan5
  %36: Cell [unique slot 0 owner] = call keepsBothMarked borrow.unique %34 borrow.unique %35 roots{4, 5}
