  %43: I32 = read copy.trivial (larger.value)
  %44: I32 = add inspect %42 inspect %43
  %45: (&Cell, &Cell) -> &Cell [owned here shape8 .0=unique call] = fun.value keepsLeft
  write.init borrow.unique (local9) take %45
  %47: (&Cell, &Cell) -> &Cell [shared call shape8 .0=unique call] = read borrow.shared (local9) loan6
  %48: I32 = call viaValue borrow.shared %47
  %49: I32 = add inspect %44 inspect %48
  return take %49
}

