module ResolveTest

data Cell {value: I32}

fn keepsBoth(a: Cell [unique slot 0], b: Cell [unique slot 0]) -> Cell [unique slot 0 owner] {
bb0:
  %0: I32 = read copy.trivial (a.value)
  %1: I32 = read copy.trivial (b.value)
  %2: Bool = gt inspect %0 inspect %1
  branch inspect %2 -> bb3 -> bb1

bb1:
  %5: Cell [unique slot 0] = read borrow.unique (b) loan1
  jump -> bb2(borrow.unique %5)

bb2(%6: Cell [unique slot 0]):
  return borrow.unique %6

bb3:
  %4: Cell [unique slot 0] = read borrow.unique (a) loan0
  jump -> bb2(borrow.unique %4)
}

fn keepsBothMarked(a: Cell [unique slot 0], b: Cell [unique slot 0]) -> Cell [unique slot 0 owner] {
bb0:
  %0: I32 = read copy.trivial (a.value)
  %1: I32 = read copy.trivial (b.value)
