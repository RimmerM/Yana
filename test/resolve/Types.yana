fn widen(value: Int) -> Long = value :: Long

fn longLiteral() -> Long = 9

fn floatLiteral() -> Float = 1.5 :: Float

fn doubleLiteral() -> Double = 1.5

fn floatProduct(a: Float, b: Float) -> Float = a * b

fn doubleSum(a: Double, b: Double) -> Double = a + b

fn both(a: Bool, b: Bool) -> Bool = a && b

fn main() -> Int = if both(True, False) then 0 else truncate(widen(7)) :: Int
