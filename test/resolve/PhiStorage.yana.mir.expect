module ResolveTest

data Colour = Red | Green | Blue

fn tagOf(m: Maybe(Colour) [shared call]) -> I32 {
bb0:
  %0: U8 = read copy.trivial (m.#)
  %1: U8 = const 1
  %2: Bool = eq inspect %0 inspect %1
  branch inspect %2 -> bb5 -> bb1

bb1:
  %9: U8 = read copy.trivial (m.#)
  %10: U8 = const 1
  %11: Bool = eq inspect %9 inspect %10
  branch inspect %11 -> bb7 -> bb2

bb2:
  %18: U8 = read copy.trivial (m.#)
  %19: U8 = const 1
  %20: Bool = eq inspect %18 inspect %19
  branch inspect %20 -> bb9 -> bb3

bb3:
  %27: I32 = const 0
  jump -> bb4(take %27)

bb4(%28: I32):
  return take %28

bb5:
  %4: U8 = read copy.trivial (m.Just.#)
  %5: U8 = const 0
  %6: Bool = eq inspect %4 inspect %5
  branch inspect %6 -> bb6 -> bb1

bb6:
  %8: I32 = const 1
  jump -> bb4(take %8)

bb7:
  %13: U8 = read copy.trivial (m.Just.#)
  %14: U8 = const 1
  %15: Bool = eq inspect %13 inspect %14
  branch inspect %15 -> bb8 -> bb2

bb8:
  %17: I32 = const 2
  jump -> bb4(take %17)

bb9:
  %22: U8 = read copy.trivial (m.Just.#)
  %23: U8 = const 2
  %24: Bool = eq inspect %22 inspect %23
  branch inspect %24 -> bb10 -> bb3

bb10:
  %26: I32 = const 3
  jump -> bb4(take %26)
}

fn taken() -> I32 {
  local m: Maybe(Colour)

bb0:
  %0: I32 = const 1
  %1: I32 = const 1
  %2: Bool = eq inspect %0 inspect %1
  branch inspect %2 -> bb3 -> bb1

bb1:
  %6: Maybe(Colour) = aggregate.Nothing
  jump -> bb2(take %6)

bb2(%7: Maybe(Colour)):
  write.init borrow.unique (m) take %7
  %11: Maybe(Colour) = read copy.trivial (m)
  %12: I32 = call tagOf borrow.shared %11
  return take %12

bb3:
  %4: Colour = const Green
  %5: Maybe(Colour) = aggregate.Just take %4
  jump -> bb2(take %5)
}

fn skipped() -> I32 {
  local m: Maybe(Colour)

bb0:
  %0: I32 = const 1
  %1: I32 = const 2
  %2: Bool = eq inspect %0 inspect %1
  branch inspect %2 -> bb3 -> bb1

bb1:
  %6: Maybe(Colour) = aggregate.Nothing
  jump -> bb2(take %6)

bb2(%7: Maybe(Colour)):
  write.init borrow.unique (m) take %7
  %11: Maybe(Colour) = read copy.trivial (m)
  %12: I32 = call tagOf borrow.shared %11
  return take %12

bb3:
  %4: Colour = const Blue
  %5: Maybe(Colour) = aggregate.Just take %4
  jump -> bb2(take %5)
}

fn payload() -> I32 {
  local n: Maybe(I32)
  local v: I32

bb0:
  %0: I32 = const 2
  %1: I32 = const 1
  %2: Bool = gt inspect %0 inspect %1
  branch inspect %2 -> bb3 -> bb1

bb1:
  %6: Maybe(I32) = aggregate.Nothing
  jump -> bb2(take %6)

bb2(%7: Maybe(I32)):
  write.init borrow.unique (n) take %7
  %11: U8 = read copy.trivial (n.#)
  %12: U8 = const 1
  %13: Bool = eq inspect %11 inspect %12
  branch inspect %13 -> bb6 -> bb4

bb3:
  %4: I32 = const 7
  %5: Maybe(I32) = aggregate.Just take %4
  jump -> bb2(take %5)

bb4:
  %18: I32 = const 0
  jump -> bb5(take %18)

bb5(%19: I32):
  return take %19

bb6:
  %15: I32 = read copy.trivial (n.Just)
  write.init borrow.unique (v) take %15
  %17: I32 = read copy.trivial (v)
  jump -> bb5(take %17)
}

fn main() -> I32 {
bb0:
  %0: I32 = call taken
  %1: I32 = const 100
  %2: I32 = mul inspect %0 inspect %1
  %3: I32 = call skipped
  %4: I32 = const 10
  %5: I32 = mul inspect %3 inspect %4
  %6: I32 = add inspect %2 inspect %5
  %7: I32 = call payload
  %8: I32 = add inspect %6 inspect %7
  return take %8
}

entry main
