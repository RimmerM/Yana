module ResolveTest

let & sink: Vec(I32) = [0, 0, 0, 0]

fn regrouping(v: Vec(I32) [shared call]) -> Vec(I16) {
bb0(%0: Vec(I32) trivial):
  %1: %Vec(I32) address = alloc frame Vec(I32) [shared call]
  store inspect %1 borrow %0
  %2: Vec(I32) trivial = load inspect %1
  %3: Vec(I16) trivial = bitcast inspect %2
  return consume %3
}

fn bytes'2(v: Vec(I16) [shared call]) -> Vec(U8) {
bb0(%0: Vec(I16) trivial):
  %1: %Vec(I16) address = alloc frame Vec(I16) [shared call]
  store inspect %1 borrow %0
  %2: Vec(I16) trivial = load inspect %1
  %3: Vec(U8) trivial = bitcast inspect %2
  return consume %3
}

fn back(v: Vec(U8) [shared call]) -> Vec(I32) {
bb0(%0: Vec(U8) trivial):
  %1: %Vec(U8) address = alloc frame Vec(U8) [shared call]
  store inspect %1 borrow %0
  %2: Vec(U8) trivial = load inspect %1
  %3: Vec(I32) trivial = bitcast inspect %2
  return consume %3
}

fn main() -> I32 {
bb0:
  %0: %Vec(I32) address = global.addr sink
  %1: Vec(I32) trivial = load inspect %0
  %2: Vec(I16) trivial = call regrouping borrow %1
  %3: Vec(U8) trivial = call bytes'2 borrow %2
  %4: Vec(I32) trivial = call back borrow %3
  %5: %Vec(I32) address = global.addr sink
  store inspect %5 consume %4
  %6: I32 trivial = const 1
  return consume %6
}

entry main
