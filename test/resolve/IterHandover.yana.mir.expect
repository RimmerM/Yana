  %7: Array(U8) [unique slot 0] = read borrow.unique (local0) loan0
  %8: Array(U8) [unique slot 0 view] = call.derivation elementsMut(Array(U8), U8) borrow.unique %7 roots{0}
  %9: %U8 [owned here shape6 .*=shared slot 0] = call valuesMut(U8) borrow.unique %8 roots.0{0}
  %10: Size = const 0
  write.init borrow.unique ([%%9][0]) take %0
  %12: Size = const 1
  write.init borrow.unique ([%%9][1]) take %1
  %14: Size = const 2
  write.init borrow.unique ([%%9][2]) take %2
  %16: Size = const 3
  write.init borrow.unique ([%%9][3]) take %3
  %18: Array(U8) = read take (local0)
  %19: Held = aggregate.Held take %18
  return take %19
}

fn consume(h: Held) -> Size {
bb0:
  %0: Array(U8) [shared call] = read borrow.shared (h.value) loan0
  %1: Array(U8) [shared slot 0 view] = call.derivation elements(Array(U8), U8) borrow.shared %0 roots{0}
  %2: Size = call length(Array(U8)) borrow.shared %1
  drop (h)
  return take %2
}

lens fn lent(times: I64 [shared call], $body: (Held) -> I32 [shared call]) -> I32 {
  local & $yielded: I32
  local & left: I64
  local local4: Held

bb0:
  %0: I32 = const 0
  write.init borrow.unique ($yielded) take %0
  %2: I64 = read copy.trivial (times)
  write.init borrow.unique (left) take %2
  jump -> bb1

bb1:
  %5: I64 = read copy.trivial (left)
  %6: I64 = const 0
  %7: Bool = gt inspect %5 inspect %6
  branch inspect %7 -> bb3 -> bb2

bb2:
  %24: I32 = read copy.trivial ($yielded)
  return take %24

bb3:
  %9: Held = call make
  write.init borrow.unique (local4) take %9
  %11: Held [shared call] = read borrow.shared (local4) loan0
  %12: (Held) -> I32 [shared call] = read borrow.shared ($body) loan1
  %13: I32 = call inspect %12 borrow.shared %11
  drop (local4)
  %14: I32 = const 0
  %15: Bool = eq inspect %13 inspect %14
  write.assign borrow.unique ($yielded) take %13
  branch inspect %15 -> bb4 -> bb5

bb4:
  %19: I64 = read copy.trivial (left)
  %20: I64 = const 1
  %21: I64 = sub inspect %19 inspect %20
  write.assign borrow.unique (left) take %21
  jump -> bb1

bb5:
  jump -> bb2
}

