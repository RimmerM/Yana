data Held {value: Array(U8)} reclaim derived

fn make() -> Held {
  local & local0: Array(U8)

bb0:
  %0: U8 = const 1
  %1: U8 = const 2
  %2: U8 = const 3
  %3: U8 = const 4
  %4: Size = const 4
  %5: Array(U8) = call literalArray(U8) borrow.shared %4
