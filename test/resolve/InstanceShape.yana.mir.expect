module ResolveTest

data Box(a) {value: a} drop derived reclaim derived

data Box(I32) {value: I32} of Box

data Box(I64) {value: I64} of Box

data Box(Bool) {value: Bool} of Box

class Named(v): name

instance Named(Box(I32)): Box(I32).name

instance Named(Box(I64)): Box(I64).name

instance (Named(a)) Named(Box(a)): Box(a).name

instance Named(I32): I32.name

instance Named(Bool): Bool.name

fn name(x: v [shared call]) -> I32 = <no body>

fn Box(I32).name(x: Box(I32) [shared call]) -> I32 {
bb0:
  %0: I32 = const 1
  return take %0
}

fn Box(I64).name(x: Box(I64) [shared call]) -> I32 {
bb0:
  %0: I32 = const 2
  return take %0
}

fn Box(a).name(x: Box(a) [shared call]) -> I32 {
  form specialized
  slot #0 type a
  slot #1 class Named(a)
bb0:
  %0: I32 = const 3
  %1: a [shared call] = read borrow.shared (x.value) loan0
  %2: I32 = call name(a) borrow.shared %1
  %3: I32 = add inspect %0 inspect %2
  return take %3
}

fn I32.name(x: I32 [shared call]) -> I32 {
bb0:
  %0: I32 = const 4
  return take %0
}

fn Bool.name(x: Bool [shared call]) -> I32 {
bb0:
  %0: Bool = read copy.trivial (x)
  branch inspect %0 -> bb3 -> bb1

bb1:
  %3: I32 = const 6
  jump -> bb2(take %3)

bb2(%4: I32):
  return take %4

bb3:
  %2: I32 = const 5
  jump -> bb2(take %2)
}

fn pinned() -> I32 {
bb0:
  %0: I32 = const 1
  %1: Box(I32) = aggregate.Box take %0
  %2: I32 = call name(Box(I32)) borrow.shared %1
  return take %2
}

fn wide() -> I32 {
bb0:
  %0: I64 = const 1
  %1: Box(I64) = aggregate.Box take %0
  %2: I32 = call name(Box(I64)) borrow.shared %1
  return take %2
}

fn open() -> I32 {
bb0:
  %0: Bool = const True
  %1: Box(Bool) = aggregate.Box take %0
  %2: I32 = call name(Box(Bool)) borrow.shared %1
  return take %2
}

fn main() -> I32 {
bb0:
  %0: I32 = call pinned
  %1: I32 = call wide
  %2: I32 = add inspect %0 inspect %1
  %3: I32 = call open
  %4: I32 = add inspect %2 inspect %3
  return take %4
}

fn Box(a).name(Bool)(x: Box(Bool) [shared call]) -> I32 = <Box(a).name at Bool>

entry main
