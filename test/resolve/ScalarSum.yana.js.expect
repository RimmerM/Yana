"use strict";
// ResolveTest
function payloadOf(s) {
  var v14;
  if (s.$tag === 0) {
    v14 = s.$p | 0;
  } else {
    v14 = (s.$p | 0) + 1000 | 0;
  }
  return v14;
}

function colourOf(c) {
  var v27;
  if (c.$tag === 0) {
    v27 = ((c.r | 0) + (Math.imul(c.g | 0, 10) | 0) | 0) + (Math.imul(c.b | 0, 100) | 0) | 0;
  } else {
    v27 = Math.imul(c.$p | 0, 1000) | 0;
  }
  return v27;
}

function fiveOf(f) {
  var v44;
  if (f.$tag === 0) {
    v44 = f.$p | 0;
  } else {
    if (f.$tag === 1) {
      v44 = Math.imul(f.$p | 0, 10) | 0;
    } else {
      if (f.$tag === 2) {
        v44 = Math.imul(f.$p | 0, 100) | 0;
      } else {
        if (f.$tag === 3) {
          v44 = Math.imul(f.$p | 0, 1000) | 0;
        } else {
          v44 = Math.imul(f.$p | 0, 10000) | 0;
        }
      }
    }
  }
  return v44;
}

function flagsValue(f) {
  var v9;
  var v18;
  if (f & 1) {
    v9 = 1;
  } else {
    v9 = 0;
  }
  if (f >>> 1 & 1) {
    v18 = 2;
  } else {
    v18 = 0;
  }
  return v9 + v18 | 0;
}

function taggedOf(t) {
  var v14;
  if (t.$tag === 0) {
    v14 = flagsValue(t.$p);
  } else {
    v14 = flagsValue(t.$p) + 100 | 0;
  }
  return v14;
}

function widthOf(w) {
  var v14;
  if (w.$tag === 0) {
    v14 = w.$p | 0;
  } else {
    v14 = Math.imul(w.$p | 0, 10) | 0;
  }
  return v14;
}

function bump(x) {
  x.$v = x.$v + 1 & 255;
  return;
}

function roundTrip() {
  return payloadOf({ $tag: 0, $p: 7 }) + payloadOf({ $tag: 1, $p: 9 }) | 0;
}

function coloured() {
  return colourOf({ $tag: 0, r: 1, g: 2, b: 3, $p: 0 }) + colourOf({ $tag: 1, r: 0, g: 0, b: 0, $p: 4 }) | 0;
}

function counted() {
  return fiveOf({ $tag: 0, $p: 1 }) + fiveOf({ $tag: 4, $p: 1 }) | 0;
}

function packedPayload() {
  var v0 = { $tag: 0, $p: 0 };
  var v3 = 0;
  v3 = v3 & 4294967294 | 1 & 1;
  v3 = v3 & ~(1 << 1) | (1 & 1) << 1;
  v0.$p = v3;
  var v9 = taggedOf(v0);
  var v10 = { $tag: 1, $p: 0 };
  var v13 = 0;
  v13 = v13 & 4294967294 | 0 & 1;
  v13 = v13 & ~(1 << 1) | (1 & 1) << 1;
  v10.$p = v13;
  return v9 + taggedOf(v10) | 0;
}

function mutated() {
  var s = { $tag: 0, $p: 41 };
  if (s.$tag === 0) {
    var v13 = { $v: s.$p };
    bump(v13);
    s.$p = v13.$v;
  } else {
    var v16 = { $v: s.$p };
    bump(v16);
    s.$p = v16.$v;
  }
  return payloadOf(s);
}

function copied() {
  var f = 0;
  f = f & 4294967294 | 1 & 1;
  f = f & ~(1 << 1) | (0 & 1) << 1;
  return taggedOf({ $tag: 1, $p: f });
}

function maybeOf(m) {
  var v10;
  if (m === null) {
    v10 = 500;
  } else {
    v10 = payloadOf(m);
  }
  return v10;
}

function folded() {
  return (maybeOf(null) + maybeOf({ $tag: 0, $p: 2 }) | 0) + maybeOf({ $tag: 1, $p: 3 }) | 0;
}

function wide() {
  return widthOf({ $tag: 0, $p: 5 }) + widthOf({ $tag: 1, $p: 6 }) | 0;
}

function main() {
  return ((((((roundTrip() + coloured() | 0) + counted() | 0) + packedPayload() | 0) + mutated() | 0) + copied() | 0) + folded() | 0) + wide() | 0;
}
