  b5:
    jmp b6

  b6:
    %v32 = neg %a : Vec(Float)
    %v35 = vlane %v32, 0 : Float
    %v38 = neg 1.5 : Float
    %v39 = cmp_ne %v35, %v38 : Bool
    je %v39, b7, b8

  b7:
    %v43 = neg 3 : Int
    ret %v43

  b8:
    jmp b9

  b9:
    ret 0
}

fn main() -> Int {
  b0:
    %v0 = call reductions : Int
    %v3 = cmp_ne %v0, 0 : Bool
    je %v3, b1, b2

  b1:
    %v5 = call reductions : Int
    ret %v5

