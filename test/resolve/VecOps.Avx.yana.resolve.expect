    %v13 = or %a, %b : Vec(Int)
    %v16 = vlane %v13, 0 : Int
    %v17 = add %v12, %v16 : Int
    %v18 = xor %a, %b : Vec(Int)
    %v21 = vlane %v18, 1 : Int
    %v22 = add %v17, %v21 : Int
