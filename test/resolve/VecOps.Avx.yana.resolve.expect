fn reductions() -> Int {
  b0:
    %ones = vsplat 1 : Vec(Int)
    %count = vreduce_add %ones : Int
    %v6 = cmp_lt %count, 2 : Bool
    je %v6, b1, b2

  b1:
    %v10 = neg 1 : Int
    ret %v10

  b2:
    jmp b3

  b3:
    %v13 = vreduce_mul %ones : Int
    %v16 = cmp_ne %v13, 1 : Bool
    je %v16, b4, b5

  b4:
    %v20 = neg 2 : Int
    ret %v20

  b5:
    jmp b6

  b6:
    %sevens = vsplat 7 : Vec(Int)
    %v26 = vreduce_add %sevens : Int
    %v29 = mul %count, 7 : Int
    %v30 = cmp_ne %v26, %v29 : Bool
    je %v30, b7, b8

  b7:
    %v34 = neg 3 : Int
    ret %v34

  b8:
    jmp b9

  b9:
    %v37 = vreduce_min %sevens : Int
    %v40 = cmp_ne %v37, 7 : Bool
    je %v40, b10, b11

  b10:
    %v44 = neg 4 : Int
    ret %v44

  b11:
    jmp b12

  b12:
    %v51 = vwithlane %sevens, 9, 0 : Vec(Int)
    %v52 = vreduce_max %v51 : Int
    %v55 = cmp_ne %v52, 9 : Bool
    je %v55, b13, b14

  b13:
    %v59 = neg 5 : Int
    ret %v59

  b14:
    jmp b15

  b15:
    %v66 = vwithlane %sevens, 2, 1 : Vec(Int)
    %v67 = vreduce_min %v66 : Int
    %v70 = cmp_ne %v67, 2 : Bool
    je %v70, b16, b17

  b16:
    %v74 = neg 6 : Int
    ret %v74

  b17:
    jmp b18

  b18:
    ret 0
}

fn floats() -> Int {
  b0:
    %a = vsplat 1.5 : Vec(Float)
    %b = vsplat 2 : Vec(Float)
    %scaled = mul %a, %b : Vec(Float)
    %v9 = vlane %scaled, 0 : Float
    %v12 = cmp_ne %v9, 3 : Bool
    je %v12, b1, b2

  b1:
    %v16 = neg 1 : Int
