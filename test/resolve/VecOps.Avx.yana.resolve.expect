let image$base: () = <none>

fn arithmetic() -> Int {
  b0:
    %a = vsplat 3 : Vec(Int)
    %b = vsplat 4 : Vec(Int)
    %sum = add %a, %b : Vec(Int)
    %product = mul %a, %b : Vec(Int)
    %difference = sub %b, %a : Vec(Int)
    %v11 = vlane %sum, 0 : Int
    %v14 = mul %v11, 100 : Int
    %v17 = vlane %product, 0 : Int
    %v18 = add %v14, %v17 : Int
    %v21 = vlane %difference, 1 : Int
    %v22 = add %v18, %v21 : Int
    ret %v22
}

fn bits() -> Int {
