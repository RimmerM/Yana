"use strict";
// ResolveTest
function classify(n) {
  var v5 = new Int32Array([10, 20, 30]);
  if (n === 0) {
    return -1;
  } else {
    if (n === 1) {
      return -2;
    } else {
      if (n === 2) {
        return -3;
      } else {
        return v5[0] + n | 0;
      }
    }
  }
}

function parity(n, salt) {
  if ((n & 1) === 0) {
    return 7;
  } else {
    if (salt > 90) {
      return 5;
    } else {
      return 9;
    }
  }
}

function main() {
  var total = 0;
  var i = 0;
  while (i < 5) {
    total = (total + classify(i) | 0) + parity(i, i) | 0;
    i = i + 1 | 0;
  }
  return total;
}
main();
