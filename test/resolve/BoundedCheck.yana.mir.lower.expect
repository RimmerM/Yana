    store %v_56, %v_54, 8
    jmp b_13
  }

  b_21 {
    %v_22 = bitcast 0: Ptr
    jmp b_13
  }

  b_31 {
    %v_32 = add %v_30, %v_30: I64
    %v_34 = add %v_33, 1: I64
    jmp b_29
  }

  b_23 {
    %v_24 = bitcast 0: Ptr
    jmp b_13
  }
}

