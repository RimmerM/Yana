lens fn bumping(c: Counter [unique call], $body: (&Counter) -> I32 [shared call]) -> bumping.outcome {
  local $yielded: I32

bb0:
  %0: I32 = read copy.trivial (c.value)
  %1: I32 = const 0
  %2: Bool = lt inspect %0 inspect %1
  branch inspect %2 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %8: I32 = read copy.trivial (c.value)
  %9: I32 = const 1
  %10: I32 = add inspect %8 inspect %9
  write.assign borrow.unique (c.value) take %10
  %12: Counter [unique call] = read borrow.unique (c) loan0
  %13: (&Counter) -> I32 [shared call] = read borrow.shared ($body) loan1
  %14: I32 = call inspect %13 borrow.unique %12
  write.init borrow.unique ($yielded) take %14
  %16: I32 = read copy.trivial (c.value)
  %17: I32 = const 2
  %18: I32 = mul inspect %16 inspect %17
  write.assign borrow.unique (c.value) take %18
  %20: I32 = read copy.trivial ($yielded)
  %21: bumping.outcome = aggregate.Proceed take %20
