  %53: I32 = add inspect %51 inspect %52
  write.assign borrow.unique (global trace) take %53
  %55: I32 = read copy.trivial ($yielded)
  %56: opening.outcome = aggregate.Proceed take %55
  return take %56

bb4(%15: I32, %16: I32):
  %18: I32 = read copy.trivial (local4)
  write.init borrow.unique (i) take %18
  %20: I32 = read copy.trivial (i)
  %21: I32 = read copy.trivial (stop)
  %22: Bool = eq inspect %20 inspect %21
  branch inspect %22 -> bb7(take %15, take %16) -> bb5(take %15, take %16)

bb5(%23: I32, %24: I32):
  jump -> bb6(take %23, take %24)

bb6(%32: I32, %33: I32):
  %35: I32 = read copy.trivial (i)
  %36: I32 = const 1
  %37: I32 = add inspect %35 inspect %36
  %38: Guard = aggregate.Guard take %37
  %39: (->Guard) -> I32 [shared call] = read borrow.shared ($body) loan0
  %40: I32 = call inspect %39 take %38
  %41: I32 = const 0
  %42: Bool = eq inspect %40 inspect %41
  write.assign borrow.unique ($yielded) take %40
  branch inspect %42 -> bb8 -> bb9

bb7(%25: I32, %26: I32):
  %28: I32 = const 500
  %29: Guard = aggregate.Guard take %28
  %30: opening.outcome = aggregate.Exit take %29
  return take %30

bb8:
  jump -> bb2(take %32, take %33)

bb9:
  jump -> bb3(take %32, take %33)
}

