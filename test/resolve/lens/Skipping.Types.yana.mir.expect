bb3(%4: Guard) handover(Guard) at.most.once -> bb1:
  write.init borrow.unique (g) take %4
  %7: I32 = read copy.trivial (sum)
  %8: I32 = read copy.trivial (g.id)
  drop (g)
  %9: I32 = add inspect %7 inspect %8
  write.assign borrow.unique (sum) take %9
  jump -> bb1
}

