module ResolveTest

data Guard {id: I32} drop authored

data Counter {value: I32}

instance Drop(Guard): Guard.drop

let & trace: I32 = 0

fn Guard.drop(value: Guard) -> {} {
bb0:
  %0: I32 = read copy.trivial (global trace)
  %1: I32 = read copy.trivial (value.id)
  %2: I32 = add inspect %0 inspect %1
  write.assign borrow.unique (global trace) take %2
  return
}

lens fn opened(id: I32 [shared call], $body: (->Guard) -> I32 [shared call]) -> opened.outcome {
  local $yielded: I32

bb0:
  %0: I32 = read copy.trivial (id)
  %1: I32 = const 0
  %2: Bool = le inspect %0 inspect %1
  branch inspect %2 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %10: I32 = read copy.trivial (id)
  %11: Guard = aggregate.Guard take %10
  %12: (->Guard) -> I32 [shared call] = read borrow.shared ($body) loan0
  %13: I32 = call inspect %12 take %11
  write.init borrow.unique ($yielded) take %13
  %15: I32 = read copy.trivial (global trace)
  %16: I32 = const 1000
  %17: I32 = add inspect %15 inspect %16
  write.assign borrow.unique (global trace) take %17
  %19: I32 = read copy.trivial ($yielded)
  %20: opened.outcome = aggregate.Proceed take %19
  return take %20

bb3:
  %4: I32 = const 0
  %5: I32 = read copy.trivial (id)
  %6: I32 = sub inspect %4 inspect %5
  %7: opened.outcome = aggregate.Exit take %6
  return take %7
}

