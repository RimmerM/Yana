  %4: %I32 address = alloc frame I32 [shared call]
  store inspect %4 borrow %1
  %5: I32 trivial = load inspect %3
  %6: I32 trivial = load inspect %4
  %7: I32 trivial = add inspect %5 inspect %6
  store inspect %3 consume %7
  %8: I32 trivial = const 0
  return consume %8
}

entry main
