  b_10 {
    %v_11 = loads %v_1, 4: I32
    ret %v_11
  }

  b_12 {
    %v_13 = phi [b_9, 0], [b_8, 1]: I32
    %v_14 = loads @log, 4: I32
    %v_15 = add %v_14, 100: I32
    store @log, %v_15, 4
    je %v_13, b_10, b_4
  }

  b_9 {
    %v_16 = loads @log, 4: I32
    %v_17 = add %v_16, 1000: I32
    store @log, %v_17, 4
    jmp b_12
  }

  b_8 {
    store %v_1, 0, 4
    jmp b_12
  }
}

