mut @log = [0, 0, 0, 0]

mixed<complex>(%x: I32): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    %v_2 = loads @log, 4: I32
    %v_3 = add %v_2, 1: I32
    store @log, %v_3, 4
    %v_4 = cmp_igt %x, 100: I32
    je %v_4, b_5, b_6
  }

  b_7 {
