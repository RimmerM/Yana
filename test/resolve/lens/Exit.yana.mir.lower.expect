    %v_14 = add %v_9, 1: I32
    %v_15 = select %v_8, %v_13, %v_14: I32
    ret %v_15
  }

  b_6 {
    %v_10 = add %x, 2: I32
    jmp b_7
  }

  b_5 {
    store %v_1, 0, 4
    jmp b_7
  }
}

insideArm<complex>(%x: I32): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    %v_2 = cmp_igt %x, 0: I32
    je %v_2, b_3, b_4
  }

  b_4 {
    ret 7
