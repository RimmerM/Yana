  b_3 {
    %v_5 = loads @log, 4: I32
    %v_6 = add %v_5, 1: I32
    store @log, %v_6, 4
    %v_7 = cmp_igt %x, 100: I32
    je %v_7, b_8, b_9
  }

  b_10 {
