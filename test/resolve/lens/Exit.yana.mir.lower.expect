mut @log = [0, 0, 0, 0]

insideArm<complex>(%x: I32): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    %v_2 = cmp_igt %x, 0: I32
    je %v_2, b_3, b_4
  }

  b_4 {
