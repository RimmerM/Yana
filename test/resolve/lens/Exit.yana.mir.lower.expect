mut @log = [0, 0, 0, 0]

main<complex>(): I32 {
  b_0 {
    store @log, 0, 4
    store @log, 1, 4
    store @log, 1808, 4
    store @log, 1809, 4
    store @log, 1810, 4
    store @log, 2011, 4
    jmp b_1
  }

  b_2 {
    %v_3 = cmp_ilt %v_4, 5: I32
    je %v_3, b_1, b_5
  }

  b_5 {
    jmp b_6
  }

  b_1 {
    %v_7 = phi [b_2, %v_4], [b_0, 0]: I32
    %v_4 = add %v_7, 1: I32
    %v_8 = cmp_eq %v_4, 2: I32
    je %v_8, b_9, b_2
  }

  b_9 {
    jmp b_6
  }

  b_6 {
    %v_10 = phi [b_5, %v_4], [b_9, 2000]: I32
    %v_11 = loads @log, 4: I32
    %v_12 = add %v_11, 100: I32
    store @log, 1005, 4
    %v_13 = add 56, %v_10: I32
    %v_14 = add %v_13, %v_12: I32
    %v_15 = add %v_14, 1016: I32
    ret %v_15
  }
}

