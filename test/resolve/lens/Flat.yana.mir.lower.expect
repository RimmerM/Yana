mut @log = [0, 0, 0, 0]

main<complex>(): I32 {
  b_0 {
    store @log, 0, 4
    store @log, 0, 4
    store @log, 1, 4
    store @log, 0, 4
    store @log, 0, 4
    store @log, 1, 4
    store @log, 0, 4
    store @log, 0, 4
    store @log, 1, 4
    store @log, 2, 4
    store @log, 0, 4
    store @log, 0, 4
    store @log, 12, 4
    store @log, 22, 4
    store @log, 0, 4
    jmp b_1
  }

  b_2 {
    %v_3 = cmp_ilt %v_4, 3: I32
    je %v_3, b_1, b_5
  }

  b_5 {
    store @log, 0, 4
    store @log, 12, 4
    store @log, 22, 4
    %v_6 = add %v_7, 504: I32
    ret %v_6
  }

  b_1 {
    %v_8 = phi [b_2, %v_4], [b_0, 0]: I32
    %v_9 = phi [b_2, %v_7], [b_0, 0]: I32
    %v_4 = add %v_8, 1: I32
    %v_10 = loads @log, 4: I32
    %v_11 = add %v_10, 1: I32
    %v_7 = add %v_9, %v_11: I32
    %v_12 = add %v_10, 11: I32
    store @log, %v_12, 4
    jmp b_2
  }
}

