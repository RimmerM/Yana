module ResolveTest

data Counter {value: I32}

let & log: I32 = 0

lens fn logged($body: (I32) -> $r [shared call]) -> $r {
  form specialized
  slot #0 type $r
  local $yielded: $r

bb0:
  %0: I32 = read copy.trivial (global log)
  %1: I32 = const 1
  %2: I32 = add inspect %0 inspect %1
  write.assign borrow.unique (global log) take %2
  %4: I32 = read copy.trivial (global log)
  %5: (I32) -> $r [shared call] = read borrow.shared ($body) loan0
  %6: $r = call inspect %5 borrow.shared %4
  write.init borrow.unique ($yielded) take %6
  %8: I32 = read copy.trivial (global log)
  %9: I32 = const 10
  %10: I32 = add inspect %8 inspect %9
  write.assign borrow.unique (global log) take %10
  %12: $r = read take ($yielded)
  return take %12
}

lens fn bumped(c: Counter [unique call], $body: (I32) -> $r [shared call]) -> $r {
  form specialized
  slot #0 type $r
  local $yielded: $r

bb0:
  %0: I32 = read copy.trivial (c.value)
  %1: I32 = const 1
  %2: I32 = add inspect %0 inspect %1
  write.assign borrow.unique (c.value) take %2
  %4: I32 = read copy.trivial (c.value)
  %5: (I32) -> $r [shared call] = read borrow.shared ($body) loan0
  %6: $r = call inspect %5 borrow.shared %4
  write.init borrow.unique ($yielded) take %6
  %8: I32 = read copy.trivial (c.value)
  %9: I32 = const 10
  %10: I32 = add inspect %8 inspect %9
  write.assign borrow.unique (c.value) take %10
  %12: $r = read take ($yielded)
  return take %12
}

fn lastUse() -> I32 {
  local & out: I32
  local seen: I32 [shared call]

bb0:
  %0: I32 = const 0
  write.assign borrow.unique (global log) take %0
  %2: I32 = const 0
  write.init borrow.unique (out) take %2
