bb1:
  %10: I32 = read copy.trivial (out)
  %11: I32 = read copy.trivial (global log)
  %12: I32 = add inspect %10 inspect %11
  return take %12

bb2(%4: I32 [shared call]) handover(I32 [shared call]) -> bb1:
  write.init borrow.unique (seen) borrow.shared %4
  %7: I32 = read copy.trivial (seen)
  write.assign borrow.unique (out) take %7
  jump -> bb1
}

