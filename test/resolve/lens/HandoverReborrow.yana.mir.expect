module ResolveTest

lens fn fromReborrow(xs: Array(I32) [shared slot 0 view], $body: (%I32) -> $r [shared call]) -> $r {
  form specialized
  slot #0 type $r
  local $yielded: $r
  local v: Array(I32) [shared slot 0 view]

bb0:
  %0: Array(I32) [shared slot 0 view] = read borrow.shared (xs) loan0
  write.init borrow.unique (v) borrow.shared %0
  %2: Array(I32) [shared slot 0 view] = read borrow.shared (v) loan1 roots{0}
  %3: %I32 [owned here shape6 .*=shared slot 0] = call values(I32) borrow.shared %2 roots.0{0, 1}
  %4: I32 = const 1
  %5: Size = convert inspect %4
  %6: Size = metric stride I32
  %7: Size = mul inspect %5 inspect %6
  %8: %I32 [owned here shape6 .*=shared slot 0] = add inspect %3 inspect %7 roots.0{0, 1}
  %9: (%I32) -> $r [shared call] = read borrow.shared ($body) loan2
  %10: $r = call inspect %9 borrow.shared %8
  write.init borrow.unique ($yielded) take %10
  %12: $r = read take ($yielded)
  return take %12
}

fn main() -> I32 {
  local & total: I32
  local local1: [I32 *2]
  local p: %I32 [shared call]

bb0:
  %0: I32 = const 0
  write.init borrow.unique (total) take %0
  %2: I32 = const 1
  %3: I32 = const 2
  %4: [I32 *2] = aggregate.0 take %2 take %3
  write.init borrow.unique (local1) take %4
  %6: [I32 *2] [shared slot 0] = read borrow.shared (local1) loan0
  %7: Array(I32) [shared slot 0 view] = call.derivation elements([I32 *2], I32) borrow.shared %6 roots{0}
  lens.call fromReborrow(I32) borrow.shared %7 -> bb2

bb1:
  %17: I32 = read copy.trivial (total)
  return take %17

bb2(%8: %I32 [shared call]) handover(%I32 [shared call]) -> bb1:
  write.init borrow.unique (p) borrow.shared %8
  %11: I32 [unique call] = read borrow.unique (total) loan1
  %12: %I32 = read copy.trivial (p)
  %13: I32 [shared slot 0] = read borrow.shared ([%%12]) loan2
  %14: I32 = call copy(I32) borrow.shared %13
  %15: {} = call +=(I32) borrow.unique %11 borrow.shared %14
  jump -> bb1
}

lens fn fromReborrow(I32)(xs: Array(I32) [shared slot 0 view], $body: (%I32) -> I32 [shared call]) -> I32 = <fromReborrow at I32>

entry main
