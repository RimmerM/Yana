module ResolveTest

let & log: I32 = 0

lens fn inner(n: I32 [shared call], stop: I32 [shared call], $body: (I32) -> I32 [shared call]) -> inner.outcome {
  local & $yielded: I32
  local & local4: I32
  local i: I32

bb0:
  %0: I32 = const 0
  write.init borrow.unique ($yielded) take %0
  %2: I32 = read copy.trivial (n)
  %3: I32 = const 0
  %4: I32 = const 1
  write.init borrow.unique (local4) take %3
  jump -> bb1(take %2, take %4)

bb1(%5: I32, %6: I32):
  %13: I32 = read copy.trivial (local4)
  %14: Bool = lt inspect %13 inspect %5
  branch inspect %14 -> bb4(take %5, take %6) -> bb3(take %5, take %6)

bb2(%7: I32, %8: I32):
  %43: I32 = read copy.trivial (local4)
  %44: I32 = add inspect %43 inspect %8
  write.assign borrow.unique (local4) take %44
  jump -> bb1(take %7, take %8)

bb3(%9: I32, %10: I32):
  %47: I32 = read copy.trivial ($yielded)
  %48: inner.outcome = aggregate.Proceed take %47
  return take %48

bb4(%15: I32, %16: I32):
  %18: I32 = read copy.trivial (local4)
  write.init borrow.unique (i) take %18
  %20: I32 = read copy.trivial (i)
  %21: I32 = read copy.trivial (stop)
  %22: Bool = eq inspect %20 inspect %21
  branch inspect %22 -> bb7(take %15, take %16) -> bb5(take %15, take %16)

bb5(%23: I32, %24: I32):
  jump -> bb6(take %23, take %24)

bb6(%31: I32, %32: I32):
  %34: I32 = read copy.trivial (i)
  %35: (I32) -> I32 [shared call] = read borrow.shared ($body) loan0
  %36: I32 = call inspect %35 borrow.shared %34
  %37: I32 = const 0
  %38: Bool = eq inspect %36 inspect %37
  write.assign borrow.unique ($yielded) take %36
  branch inspect %38 -> bb8 -> bb9

bb7(%25: I32, %26: I32):
  %28: I32 = const 9
  %29: inner.outcome = aggregate.Exit take %28
  return take %29

bb8:
  jump -> bb2(take %31, take %32)

bb9:
  jump -> bb3(take %31, take %32)
}

lens fn wrap(n: I32 [shared call], $body: (I32) -> I32 [shared call]) -> wrap.outcome {
  local $yielded: I32

bb0:
  %0: I32 = read copy.trivial (n)
  %1: I32 = const 0
  %2: Bool = gt inspect %0 inspect %1
  branch inspect %2 -> bb3 -> bb1

bb1:
  %8: I32 = const 3
  %9: wrap.outcome = aggregate.Exit take %8
  return take %9

bb2:
  %12: I32 = read copy.trivial ($yielded)
  %13: wrap.outcome = aggregate.Proceed take %12
  return take %13

bb3:
  %4: I32 = read copy.trivial (n)
  %5: (I32) -> I32 [shared call] = read borrow.shared ($body) loan0
  %6: I32 = call inspect %5 borrow.shared %4
  write.init borrow.unique ($yielded) take %6
  jump -> bb2
}

lens fn defaulting(n: I32 [shared call], stop: I32 [shared call], $body: (I32) -> I32 [shared call]) -> I32 {
  local & $yielded: I32
  local x: I32 [shared call]
  local e: I32

bb0:
  %0: I32 = const 0
  write.init borrow.unique ($yielded) take %0
  %2: I32 = read copy.trivial (n)
  %3: I32 = read copy.trivial (stop)
  lens.try inner borrow.shared %2 borrow.shared %3 -> bb3 -> bb2

bb1:
  %36: I32 = read copy.trivial ($yielded)
  return take %36

bb2(%4: I32):
  write.init borrow.unique (e) take %4
  %25: I32 = read copy.trivial ($yielded)
  %26: I32 = const 0
  %27: Bool = eq inspect %25 inspect %26
  branch inspect %27 -> bb8 -> bb9

bb3(%5: I32 [shared call]) handover(I32 [shared call]) many -> bb1:
  write.init borrow.unique (x) borrow.shared %5
  %8: I32 = read copy.trivial ($yielded)
  %9: I32 = const 0
  %10: Bool = eq inspect %8 inspect %9
  branch inspect %10 -> bb4 -> bb5

bb4 handover(I32 [shared call]) many:
  %12: I32 = read copy.trivial (x)
  %13: I32 = const 2
  %14: I32 = mul inspect %12 inspect %13
  %15: (I32) -> I32 [shared call] = read borrow.shared ($body) loan0
  %16: I32 = call inspect %15 borrow.shared %14
  %17: I32 = const 0
  %18: Bool = eq inspect %16 inspect %17
  write.assign borrow.unique ($yielded) take %16
  branch inspect %18 -> bb6 -> bb7

bb5 handover(I32 [shared call]) many:
  jump -> bb7

bb6 handover(I32 [shared call]) many:
  jump -> bb1

bb7 handover(I32 [shared call]) many:
  break -> bb1

bb8:
  %29: I32 = read copy.trivial (e)
  %30: (I32) -> I32 [shared call] = read borrow.shared ($body) loan1
  %31: I32 = call inspect %30 borrow.shared %29
  write.assign borrow.unique ($yielded) take %31
  jump -> bb10

bb9:
  jump -> bb10

bb10:
  jump -> bb1
}

fn nested(a: I32 [shared call], b: I32 [shared call]) -> I32 {
  local x: I32 [shared call]
  local y: I32 [shared call]
  local local4: I32
  local local5: I32

bb0:
  %0: I32 = read copy.trivial (a)
  lens.try wrap borrow.shared %0 -> bb3 -> bb2

bb1:
  %30: I32 = read copy.trivial (global log)
  return take %30

bb2(%1: I32):
  write.init borrow.unique (local5) take %1
  %25: I32 = read copy.trivial (global log)
  %26: I32 = const 100
  %27: I32 = add inspect %25 inspect %26
  write.assign borrow.unique (global log) take %27
  jump -> bb1

bb3(%2: I32 [shared call]) handover(I32 [shared call]) at.most.once -> bb1:
  write.init borrow.unique (x) borrow.shared %2
  %5: I32 = read copy.trivial (b)
  lens.try wrap borrow.shared %5 -> bb6 -> bb5

bb4 handover(I32 [shared call]) at.most.once:
  jump -> bb1

bb5(%6: I32) handover(I32 [shared call]) at.most.once:
  write.init borrow.unique (local4) take %6
  %18: I32 = read copy.trivial (global log)
  %19: I32 = const 1000
  %20: I32 = add inspect %18 inspect %19
  write.assign borrow.unique (global log) take %20
  jump -> bb4

bb6(%7: I32 [shared call]) handover(I32 [shared call]) at.most.once -> bb4:
  write.init borrow.unique (y) borrow.shared %7
  %10: I32 = read copy.trivial (global log)
  %11: I32 = read copy.trivial (x)
  %12: I32 = add inspect %10 inspect %11
  %13: I32 = read copy.trivial (y)
  %14: I32 = add inspect %12 inspect %13
  write.assign borrow.unique (global log) take %14
  jump -> bb4
}

fn adapted(n: I32 [shared call], stop: I32 [shared call]) -> I32 {
  local v: I32 [shared call]

bb0:
  %0: I32 = read copy.trivial (n)
  %1: I32 = read copy.trivial (stop)
  lens.call defaulting borrow.shared %0 borrow.shared %1 -> bb2

bb1:
  %10: I32 = read copy.trivial (global log)
  return take %10

bb2(%2: I32 [shared call]) handover(I32 [shared call]) many -> bb1:
  write.init borrow.unique (v) borrow.shared %2
  %5: I32 = read copy.trivial (global log)
  %6: I32 = read copy.trivial (v)
  %7: I32 = add inspect %5 inspect %6
  write.assign borrow.unique (global log) take %7
  jump -> bb1
}

fn main() -> I32 {
  local both: I32
  local outerSkipped: I32
  local innerSkipped: I32
  local defaulted: I32

bb0:
  %0: I32 = const 0
  write.assign borrow.unique (global log) take %0
  %2: I32 = const 1
  %3: I32 = const 2
  %4: I32 = call nested borrow.shared %2 borrow.shared %3
  write.init borrow.unique (both) take %4
  %6: I32 = const 0
  write.assign borrow.unique (global log) take %6
  %8: I32 = const -1
  %9: I32 = const 2
  %10: I32 = call nested borrow.shared %8 borrow.shared %9
  write.init borrow.unique (outerSkipped) take %10
  %12: I32 = const 0
  write.assign borrow.unique (global log) take %12
  %14: I32 = const 1
  %15: I32 = const -2
  %16: I32 = call nested borrow.shared %14 borrow.shared %15
  write.init borrow.unique (innerSkipped) take %16
  %18: I32 = const 0
  write.assign borrow.unique (global log) take %18
  %20: I32 = const 4
  %21: I32 = const 2
  %22: I32 = call adapted borrow.shared %20 borrow.shared %21
  write.init borrow.unique (defaulted) take %22
  %24: I32 = read copy.trivial (both)
  %25: I32 = const 1000000
  %26: I32 = mul inspect %24 inspect %25
  %27: I32 = read copy.trivial (outerSkipped)
  %28: I32 = const 10000
  %29: I32 = mul inspect %27 inspect %28
  %30: I32 = add inspect %26 inspect %29
  %31: I32 = read copy.trivial (innerSkipped)
  %32: I32 = const 100
  %33: I32 = mul inspect %31 inspect %32
  %34: I32 = add inspect %30 inspect %33
  %35: I32 = read copy.trivial (defaulted)
  %36: I32 = add inspect %34 inspect %35
  return take %36
}

entry main
