}

fn opening(n: I32 [shared call]) -> I32 {
  local & r: I32
  local d: I32 [shared call]
  local e: I32

bb0:
  %0: I32 = const 0
  write.init borrow.unique (r) take %0
  %2: I32 = read copy.trivial (n)
  %3: Gate = aggregate.Gate take %2
  lens.try opened(Gate) borrow.shared %3 -> bb3 -> bb2

bb1:
  %17: I32 = read copy.trivial (r)
