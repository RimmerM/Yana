  form erased
  slot #0 type a
  slot #1 class Guard(a)
  local d: I32 [shared call]

bb0:
  %0: a [shared call] = read borrow.shared (x) loan0
  lens.call depthOf(a) borrow.shared %0 -> bb1

bb1(%1: I32 [shared call]) handover(I32 [shared call]):
  write.init borrow.unique (d) borrow.shared %1
  %4: I32 = read copy.trivial (d)
  %5: I32 = const 2
  %6: I32 = mul inspect %4 inspect %5
  return take %6
}

fn inheritedDefault() -> I32 {
  local d: I32 [shared call]

bb0:
  %0: I32 = const 6
