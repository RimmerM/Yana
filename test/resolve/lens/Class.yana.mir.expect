module ResolveTest

data Gate {depth: I32}

class Guard(a): depth, hold, depthOf, opened, twiceDeep, steps

instance Guard(Gate): Gate.depth, Gate.hold, Gate.depthOf, Gate.opened, Guard.twiceDeep, Guard.steps

fn depth(self: a [shared call]) -> I32 = <no body>

lens fn hold(self: a [shared call], $body: ({}) -> I32 [shared call]) -> I32 = <no body>

lens fn depthOf(self: a [shared call], $body: (I32) -> I32 [shared call]) -> I32 = <no body>

lens fn opened(self: a [shared call], $body: (I32) -> I32 [shared call]) -> opened.outcome = <no body>

lens fn twiceDeep(self: a [shared call], $body: (I32) -> I32 [shared call]) -> I32 {
  form specialized
  slot #0 type a
  slot #1 class Guard(a)
  local $yielded: I32

bb0:
  %0: a [shared call] = read borrow.shared (self) loan0
  %1: I32 = call depth(a) borrow.shared %0
  %2: I32 = const 2
  %3: I32 = mul inspect %1 inspect %2
  %4: (I32) -> I32 [shared call] = read borrow.shared ($body) loan1
  %5: I32 = call inspect %4 borrow.shared %3
  write.init borrow.unique ($yielded) take %5
  %7: I32 = read copy.trivial ($yielded)
  return take %7
}

lens fn steps(self: a [shared call], $body: (I32) -> I32 [shared call]) -> I32 {
  form specialized
  slot #0 type a
  slot #1 class Guard(a)
  local & $yielded: I32
  local & i: I32

bb0:
  %0: I32 = const 0
  write.init borrow.unique ($yielded) take %0
  %2: I32 = const 0
  write.init borrow.unique (i) take %2
  jump -> bb1

bb1:
  %5: I32 = read copy.trivial (i)
  %6: a [shared call] = read borrow.shared (self) loan0
  %7: I32 = call depth(a) borrow.shared %6
  %8: Bool = lt inspect %5 inspect %7
  branch inspect %8 -> bb3 -> bb2

bb2:
  %23: I32 = read copy.trivial ($yielded)
  return take %23

bb3:
  %10: I32 = read copy.trivial (i)
  %11: (I32) -> I32 [shared call] = read borrow.shared ($body) loan1
  %12: I32 = call inspect %11 borrow.shared %10
  %13: I32 = const 0
  %14: Bool = eq inspect %12 inspect %13
  write.assign borrow.unique ($yielded) take %12
  branch inspect %14 -> bb4 -> bb5

bb4:
  %18: I32 = read copy.trivial (i)
  %19: I32 = const 1
  %20: I32 = add inspect %18 inspect %19
  write.assign borrow.unique (i) take %20
  jump -> bb1

bb5:
  jump -> bb2
}

fn Gate.depth(self: Gate [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (self.depth)
  return take %0
}

lens fn Gate.hold(self: Gate [shared call], $body: ({}) -> I32 [shared call]) -> I32 {
  local $yielded: I32

bb0:
  %0: {} = const {}
  %1: ({}) -> I32 [shared call] = read borrow.shared ($body) loan0
  %2: I32 = call inspect %1 borrow.shared %0
  write.init borrow.unique ($yielded) take %2
  %4: I32 = read copy.trivial ($yielded)
  return take %4
}

lens fn Gate.depthOf(self: Gate [shared call], $body: (I32) -> I32 [shared call]) -> I32 {
  local $yielded: I32

bb0:
  %0: I32 = read copy.trivial (self.depth)
  %1: (I32) -> I32 [shared call] = read borrow.shared ($body) loan0
  %2: I32 = call inspect %1 borrow.shared %0
  write.init borrow.unique ($yielded) take %2
  %4: I32 = read copy.trivial ($yielded)
  return take %4
}

lens fn Gate.opened(self: Gate [shared call], $body: (I32) -> I32 [shared call]) -> opened.outcome {
  local $yielded: I32

bb0:
  %0: I32 = read copy.trivial (self.depth)
  %1: I32 = const 0
  %2: Bool = le inspect %0 inspect %1
  branch inspect %2 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %8: I32 = read copy.trivial (self.depth)
  %9: I32 = const 10
  %10: I32 = mul inspect %8 inspect %9
  %11: (I32) -> I32 [shared call] = read borrow.shared ($body) loan0
  %12: I32 = call inspect %11 borrow.shared %10
  write.init borrow.unique ($yielded) take %12
  %14: I32 = read copy.trivial ($yielded)
  %15: opened.outcome = aggregate.Proceed take %14
  return take %15

bb3:
  %4: I32 = const 5
  %5: opened.outcome = aggregate.Exit take %4
  return take %5
}

fn concrete() -> I32 {
  local d: I32 [shared call]

bb0:
  %0: I32 = const 3
  %1: Gate = aggregate.Gate take %0
  lens.call depthOf(Gate) borrow.shared %1 -> bb1

bb1(%2: I32 [shared call]) handover(I32 [shared call]):
  write.init borrow.unique (d) borrow.shared %2
  %5: I32 = read copy.trivial (d)
  %6: I32 = const 1
  %7: I32 = add inspect %5 inspect %6
  return take %7
}

fn unitHandover() -> I32 {
  local g: Gate
  local & n: I32
  local local2: {} [shared call]

bb0:
  %0: I32 = const 7
  %1: Gate = aggregate.Gate take %0
  write.init borrow.unique (g) take %1
  %3: I32 = const 0
  write.init borrow.unique (n) take %3
  %5: Gate = read copy.trivial (g)
  lens.call hold(Gate) borrow.shared %5 -> bb2

bb1:
  %14: I32 = read copy.trivial (n)
  return take %14

bb2(%6: {} [shared call]) handover({} [shared call]) -> bb1:
  write.init borrow.unique (local2) borrow.shared %6
  %9: I32 = read copy.trivial (n)
  %10: I32 = read copy.trivial (g.depth)
  %11: I32 = add inspect %9 inspect %10
  write.assign borrow.unique (n) take %11
  jump -> bb1
}

