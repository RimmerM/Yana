fn main() -> I32 {
  local g: Gate

bb0:
  %0: I32 = const 2
  %1: Gate = aggregate.Gate take %0
  write.init borrow.unique (g) take %1
  %3: I32 = call concrete
  %4: I32 = call unitHandover
  %5: I32 = add inspect %3 inspect %4
  %6: Gate = read copy.trivial (g)
  %7: I32 = call deferred(Gate) borrow.shared %6
  %8: I32 = add inspect %5 inspect %7
  %9: I32 = call inheritedDefault
  %10: I32 = add inspect %8 inspect %9
  %11: Gate = read copy.trivial (g)
  %12: I32 = call deferredDefault(Gate) borrow.shared %11
  %13: I32 = add inspect %10 inspect %12
  %14: I32 = call iterated
  %15: I32 = add inspect %13 inspect %14
  %16: Gate = read copy.trivial (g)
  %17: I32 = call deferredIter(Gate) borrow.shared %16
  %18: I32 = add inspect %15 inspect %17
  %19: I32 = const 2
  %20: I32 = call opening borrow.shared %19
  %21: I32 = add inspect %18 inspect %20
  %22: I32 = const 0
  %23: I32 = call opening borrow.shared %22
  %24: I32 = add inspect %21 inspect %23
  %25: I32 = const 4
  %26: Gate = aggregate.Gate take %25
  %27: I32 = call deferredSkip(Gate) borrow.shared %26
  %28: I32 = add inspect %24 inspect %27
  %29: I32 = const 0
  %30: Gate = aggregate.Gate take %29
  %31: I32 = call deferredSkip(Gate) borrow.shared %30
  %32: I32 = add inspect %28 inspect %31
  %33: Gate = read copy.trivial (g)
  %34: I32 = call erasedLens(Gate) borrow.shared %33
  %35: I32 = add inspect %32 inspect %34
  %36: I32 = const 3
  %37: Gate = aggregate.Gate take %36
  %38: I32 = call erasedIter(Gate) borrow.shared %37
  %39: I32 = add inspect %35 inspect %38
  return take %39
}

lens fn twiceDeep(Gate)(self: Gate [shared call], $body: (I32) -> I32 [shared call]) -> I32 = <twiceDeep at Gate>

lens fn steps(Gate)(self: Gate [shared call], $body: (I32) -> I32 [shared call]) -> I32 = <steps at Gate>

entry main
