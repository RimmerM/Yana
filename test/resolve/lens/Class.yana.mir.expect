  local i: I32 [shared call]

bb0:
  %0: I32 = const 0
  write.init borrow.unique (t) take %0
  %2: a [shared call] = read borrow.shared (x) loan0
  lens.call steps(a) borrow.shared %2 -> bb2

bb1:
  %13: I32 = read copy.trivial (t)
  return take %13

bb2(%3: I32 [shared call]) handover(I32 [shared call]) many -> bb1:
  write.init borrow.unique (i) borrow.shared %3
  %6: I32 = read copy.trivial (t)
  %7: I32 = read copy.trivial (i)
  %8: I32 = add inspect %6 inspect %7
  %9: I32 = const 1
  %10: I32 = add inspect %8 inspect %9
  write.assign borrow.unique (t) take %10
