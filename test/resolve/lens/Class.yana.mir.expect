bb3(%5: I32 [shared call]) handover(I32 [shared call]) at.most.once -> bb1:
  write.init borrow.unique (d) borrow.shared %5
  %8: I32 = read copy.trivial (d)
  %9: I32 = const 1
  %10: I32 = add inspect %8 inspect %9
