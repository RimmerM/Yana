fn iterated() -> I32 {
  local & t: I32
  local i: I32 [shared call]

bb0:
  %0: I32 = const 0
  write.init borrow.unique (t) take %0
  %2: I32 = const 4
  %3: Gate = aggregate.Gate take %2
  lens.call steps(Gate) borrow.shared %3 -> bb2

bb1:
  %12: I32 = read copy.trivial (t)
  return take %12

bb2(%4: I32 [shared call]) handover(I32 [shared call]) many -> bb1:
  write.init borrow.unique (i) borrow.shared %4
  %7: I32 = read copy.trivial (t)
  %8: I32 = read copy.trivial (i)
  %9: I32 = add inspect %7 inspect %8
  write.assign borrow.unique (t) take %9
  jump -> bb1
}

fn deferredIter(x: a [shared call]) -> I32 {
  form erased
  slot #0 type a
