  %11: Outcome(Step, I32) = call inspect %10 borrow.shared %9
  write.init borrow.unique (local4) take %11
  %13: U8 = read copy.trivial (local4.#)
  %14: U8 = const 1
  %15: Bool = eq inspect %13 inspect %14
  branch inspect %15 -> bb5 -> bb4

bb4:
  %21: Step = read copy.trivial (local4.Proceed)
  jump -> bb7(take %21)

bb5:
  %17: I32 = read copy.trivial (local4.Exit)
  write.assign borrow.unique ($yielded) take %17
  jump -> bb6

bb6:
  jump -> bb2

bb7(%22: Step):
  write.init borrow.unique (cmd) take %22
  %25: U8 = read copy.trivial (cmd.#)
  %26: U8 = const 0
  %27: Bool = eq inspect %25 inspect %26
  branch inspect %27 -> bb11 -> bb8

bb8:
  %33: U8 = read copy.trivial (cmd.#)
  %34: U8 = const 1
  %35: Bool = eq inspect %33 inspect %34
  branch inspect %35 -> bb12 -> bb9

bb9:
  %41: I32 = read copy.trivial (i)
  %42: I32 = const 3
  %43: I32 = add inspect %41 inspect %42
  write.assign borrow.unique (i) take %43
  jump -> bb10

bb10:
  jump -> bb1

bb11:
  %29: I32 = read copy.trivial (i)
  %30: I32 = const 1
  %31: I32 = add inspect %29 inspect %30
  write.assign borrow.unique (i) take %31
  jump -> bb10

bb12:
  %37: I32 = read copy.trivial (i)
  %38: I32 = const 2
  %39: I32 = add inspect %37 inspect %38
  write.assign borrow.unique (i) take %39
  jump -> bb10
}

