  %18: U8 = read copy.trivial (local5.#)
  %19: U8 = const 1
  %20: Bool = eq inspect %18 inspect %19
  branch inspect %20 -> bb5 -> bb4

bb4:
  %26: I32 = read copy.trivial (local5.Proceed)
  jump -> bb7(take %26)

bb5:
  drop (b)
