module ResolveTest

data Box {value: I32} drop authored

data Step = Again | Skip | Twice

data Command {code: I32, box: Box} drop derived

data Note {mark: I32, box: Box} drop derived

data Trouble = TooFar

instance Drop(Box): Box.drop

let & gone: I32 = 0

let & trail: I32 = 0

fn Box.drop(value: Box) -> {} {
bb0:
  %0: I32 = read copy.trivial (global gone)
  %1: I32 = const 1
  %2: I32 = add inspect %0 inspect %1
  write.assign borrow.unique (global gone) take %2
  return
}

lens fn walk(n: I32 [shared call], $body: (I32) -> Outcome(Step, I32) [shared call]) -> I32 {
