mut @log = [0, 0, 0, 0]

main<complex>(): I32 {
  b_0 {
    store @log, 0, 4
    %v_1 = loads @log, 4: I32
    %v_2 = add %v_1, 3: I32
    store @log, %v_2, 4
    %v_3 = loads @log, 4: I32
    store @log, 0, 4
    %v_4 = loads @log, 4: I32
    %v_5 = add %v_4, 100: I32
    store @log, %v_5, 4
    %v_6 = loads @log, 4: I32
    store @log, 0, 4
    %v_7 = loads @log, 4: I32
    %v_8 = add %v_7, 1000: I32
    store @log, %v_8, 4
    %v_9 = loads @log, 4: I32
    store @log, 0, 4
    jmp b_10
  }

  b_11 {
    %v_12 = alloca 8, 4: Ptr
    store %v_12, 0, 1
    %v_13 = add %v_12, 4: Ptr
    store %v_13, 0, 4
    jmp b_14
  }

  b_15 {
    %v_16 = cmp_eq %v_17, 2: I32
    je %v_16, b_18, b_10
  }

  b_10 {
    %v_19 = phi [b_15, %v_17], [b_0, 0]: I32
    %v_20 = shl %v_19, 1: I32
    %v_21 = loads @log, 4: I32
    %v_22 = add %v_21, %v_20: I32
    store @log, %v_22, 4
    %v_17 = add %v_19, 1: I32
    %v_23 = cmp_ilt %v_17, 4: I32
    je %v_23, b_15, b_11
  }

  b_18 {
    %v_24 = alloca 8, 4: Ptr
    store %v_24, 1, 1
    %v_25 = add %v_24, 4: Ptr
    store %v_25, 9, 4
    jmp b_14
  }

  b_14 {
    %v_26 = phi [b_11, %v_12], [b_18, %v_24]: Ptr
    %v_27 = load %v_26, 1: I32
    %v_28 = cmp_eq %v_27, 1: I32
    je %v_28, b_29, b_30
  }

  b_29 {
    %v_31 = add %v_26, 4: Ptr
    %v_32 = loads %v_31, 4: I32
    %v_33 = loads @log, 4: I32
    %v_34 = add %v_33, %v_32: I32
    store @log, %v_34, 4
    jmp b_30
  }

  b_30 {
    %v_35 = loads @log, 4: I32
    %v_36 = imul %v_3, 1000000: I32
    %v_37 = imul %v_6, 10000: I32
    %v_38 = add %v_36, %v_37: I32
    %v_39 = imul %v_9, 100: I32
    %v_40 = add %v_38, %v_39: I32
    %v_41 = add %v_40, %v_35: I32
    ret %v_41
  }
}

