    %v_6 = add %v_5, 8: Ptr
    store %v_6, %v_3, 8
    call_complex inner, %v_2, %n, %stop, %v_5
    %v_7 = load %v_2, 1: I32
    %v_8 = cmp_eq %v_7, 1: I32
    je %v_8, b_9, b_10
  }

