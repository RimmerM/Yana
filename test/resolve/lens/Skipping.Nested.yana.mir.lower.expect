    %v_3 = phi [b_1, 0], [b_4, %v_5]: I32
    %v_6 = phi [b_1, 0], [b_4, %v_7]: I32
    %v_8 = cmp_ilt %v_6, %n: I32
    je %v_8, b_9, b_10
  }

  b_10 {
    %v_11 = phi [b_2, %v_3], [b_12, %v_5]: I32
    store %v_0, 0, 1
    %v_13 = add %v_0, 4: Ptr
    store %v_13, %v_11, 4
    ret 
