mut @log = [0, 0, 0, 0]

main<complex>(): I32 {
  b_0 {
    store @log, 3, 4
    store @log, 0, 4
    store @log, 0, 4
    store @log, 1000, 4
    store @log, 0, 4
    jmp b_1
  }

  b_2 {
    jmp b_3
  }

  b_4 {
    %v_5 = cmp_eq %v_6, 2: I32
    je %v_5, b_7, b_1
  }

  b_1 {
    %v_8 = phi [b_4, %v_6], [b_0, 0]: I32
    %v_9 = shl %v_8, 1: I32
    %v_10 = loads @log, 4: I32
    %v_11 = add %v_10, %v_9: I32
    store @log, %v_11, 4
    %v_6 = add %v_8, 1: I32
    %v_12 = cmp_ilt %v_6, 4: I32
    je %v_12, b_4, b_2
  }

  b_7 {
    %v_13 = loads @log, 4: I32
    %v_14 = add %v_13, 9: I32
    store @log, %v_14, 4
    jmp b_3
  }

  b_3 {
    %v_15 = loads @log, 4: I32
    %v_16 = add 4100000, %v_15: I32
    ret %v_16
  }
}

