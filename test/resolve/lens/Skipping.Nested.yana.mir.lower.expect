    %v_18 = add %$body, 8: Ptr
    %v_19 = load %v_18, 8: Ptr
    %v_5 = call_complex %v_17, %v_19, %v_6: I32
    %v_20 = cmp_eq %v_5, 0: I32
    je %v_20, b_4, b_12
  }

  b_15 {
    store %v_0, 1, 1
    %v_21 = add %v_0, 4: Ptr
    store %v_21, 9, 4
    ret 
  }

  b_4 {
    %v_7 = add %v_6, 1: I32
    jmp b_2
  }

  b_12 {
    jmp b_10
  }
}

wrap<complex>(%v_0: Ptr, %n: I32, %$body: Ptr) {
  b_1 {
    %v_2 = cmp_igt %n, 0: I32
    je %v_2, b_3, b_4
  }

  b_4 {
    store %v_0, 1, 1
    %v_5 = add %v_0, 4: Ptr
