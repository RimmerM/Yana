mut @log = [0, 0, 0, 0]

nested<complex>(%a: I32, %b: I32): I32 {
  b_0 {
    %v_1 = alloca 7, 8: Ptr
    %v_2 = cmp_igt %a, 0: I32
    je %v_2, b_3, b_4
  }

  b_5 {
    %v_6 = loads @log, 4: I32
    ret %v_6
  }

  b_7 {
    %v_8 = loads @log, 4: I32
    %v_9 = add %v_8, 100: I32
    store @log, %v_9, 4
    jmp b_5
  }

  b_10 {
    %v_11 = phi [b_4, %v_12], [b_13, %v_14]: Ptr
    %v_15 = load %v_11, 1: I32
    %v_16 = add %v_11, 1: Ptr
    copy %v_1, %v_16, 7
    %v_17 = cmp_eq %v_15, 1: I32
    je %v_17, b_7, b_5
  }

  b_4 {
    %v_12 = alloca 8, 4: Ptr
    store %v_12, 1, 1
    %v_18 = add %v_12, 4: Ptr
    store %v_18, 3, 4
    jmp b_10
  }

  b_3 {
    %v_19 = alloca 7, 8: Ptr
    %v_20 = cmp_igt %b, 0: I32
    je %v_20, b_21, b_22
  }

  b_23 {
    %v_24 = loads @log, 4: I32
    %v_25 = add %v_24, 1000: I32
    store @log, %v_25, 4
    jmp b_13
  }

  b_13 {
    %v_14 = alloca 8, 4: Ptr
    store %v_14, 0, 1
    %v_26 = add %v_14, 4: Ptr
    store %v_26, 0, 4
    jmp b_10
  }

  b_27 {
    %v_28 = phi [b_22, %v_29], [b_21, %v_30]: Ptr
    %v_31 = load %v_28, 1: I32
    %v_32 = add %v_28, 1: Ptr
    copy %v_19, %v_32, 7
    %v_33 = cmp_eq %v_31, 1: I32
    je %v_33, b_23, b_13
  }

  b_22 {
    %v_29 = alloca 8, 4: Ptr
    store %v_29, 1, 1
    %v_34 = add %v_29, 4: Ptr
    store %v_34, 3, 4
    jmp b_27
  }

  b_21 {
    %v_35 = loads @log, 4: I32
    %v_36 = add %v_35, %a: I32
    %v_37 = add %v_36, %b: I32
    store @log, %v_37, 4
    %v_30 = alloca 8, 4: Ptr
    store %v_30, 0, 1
    %v_38 = add %v_30, 4: Ptr
    store %v_38, 0, 4
    jmp b_27
  }
}

main<complex>(): I32 {
  b_0 {
    store @log, 0, 4
    %v_1 = call_complex nested, 1, 2: I32
    store @log, 0, 4
    %v_2 = call_complex nested, 18446744073709551615, 2: I32
    store @log, 0, 4
    %v_3 = call_complex nested, 1, 18446744073709551614: I32
    store @log, 0, 4
    %v_4 = alloca 3, 4: Ptr
    jmp b_5
  }

  b_6 {
    %v_7 = cmp_ilt %v_8, 4: I32
    je %v_7, b_9, b_10
  }

  b_10 {
    %v_11 = alloca 8, 4: Ptr
    store %v_11, 0, 1
    %v_12 = add %v_11, 4: Ptr
    store %v_12, 0, 4
    jmp b_13
  }

  b_9 {
    %v_14 = cmp_eq %v_8, 2: I32
    je %v_14, b_15, b_5
  }

  b_5 {
    %v_16 = phi [b_9, %v_8], [b_0, 0]: I32
    %v_17 = shl %v_16, 1: I32
    %v_18 = loads @log, 4: I32
    %v_19 = add %v_18, %v_17: I32
    store @log, %v_19, 4
    %v_8 = add %v_16, 1: I32
    jmp b_6
  }

  b_15 {
    %v_20 = alloca 8, 4: Ptr
    store %v_20, 1, 1
    %v_21 = add %v_20, 4: Ptr
    store %v_21, 9, 4
    jmp b_13
  }

  b_13 {
    %v_22 = phi [b_10, %v_11], [b_15, %v_20]: Ptr
    %v_23 = load %v_22, 1: I32
    %v_24 = add %v_22, 1: Ptr
    copy %v_4, %v_24, 3
    %v_25 = add %v_22, 4: Ptr
    %v_26 = load %v_25, 4: I32
    %v_27 = cmp_eq %v_23, 1: I32
    je %v_27, b_28, b_29
  }

  b_28 {
    %v_30 = loads @log, 4: I32
    %v_31 = add %v_30, %v_26: I32
    store @log, %v_31, 4
    jmp b_29
  }

  b_29 {
    %v_32 = loads @log, 4: I32
    %v_33 = imul %v_1, 1000000: I32
    %v_34 = imul %v_2, 10000: I32
    %v_35 = add %v_33, %v_34: I32
    %v_36 = imul %v_3, 100: I32
    %v_37 = add %v_35, %v_36: I32
    %v_38 = add %v_37, %v_32: I32
    ret %v_38
  }
}

