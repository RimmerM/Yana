mut @log = [0, 0, 0, 0]

nested<complex>(%a: I32, %b: I32): I32 {
  b_0 {
    %v_1 = cmp_igt %a, 0: I32
    je %v_1, b_2, b_3
  }

  b_4 {
    %v_5 = loads @log, 4: I32
    ret %v_5
  }

  b_6 {
    %v_7 = loads @log, 4: I32
    %v_8 = add %v_7, 100: I32
    store @log, %v_8, 4
    jmp b_4
  }

  b_9 {
    %v_10 = phi [b_3, %v_11], [b_12, %v_13]: Ptr
    %v_14 = load %v_10, 1: I32
    %v_15 = cmp_eq %v_14, 1: I32
    je %v_15, b_6, b_4
  }

  b_3 {
    %v_11 = alloca 8, 4: Ptr
    store %v_11, 1, 1
    %v_16 = add %v_11, 4: Ptr
    store %v_16, 3, 4
    jmp b_9
  }

  b_2 {
    %v_17 = cmp_igt %b, 0: I32
    je %v_17, b_18, b_19
  }

  b_20 {
    %v_21 = loads @log, 4: I32
    %v_22 = add %v_21, 1000: I32
    store @log, %v_22, 4
    jmp b_12
  }

  b_12 {
    %v_13 = alloca 8, 4: Ptr
    store %v_13, 0, 1
    %v_23 = add %v_13, 4: Ptr
    store %v_23, 0, 4
    jmp b_9
  }

  b_24 {
    %v_25 = phi [b_19, %v_26], [b_18, %v_27]: Ptr
    %v_28 = load %v_25, 1: I32
    %v_29 = cmp_eq %v_28, 1: I32
    je %v_29, b_20, b_12
  }

  b_19 {
    %v_26 = alloca 8, 4: Ptr
    store %v_26, 1, 1
    %v_30 = add %v_26, 4: Ptr
    store %v_30, 3, 4
    jmp b_24
  }

  b_18 {
    %v_31 = loads @log, 4: I32
    %v_32 = add %v_31, %a: I32
    %v_33 = add %v_32, %b: I32
    store @log, %v_33, 4
    %v_27 = alloca 8, 4: Ptr
    store %v_27, 0, 1
    %v_34 = add %v_27, 4: Ptr
    store %v_34, 0, 4
    jmp b_24
  }
}

main<complex>(): I32 {
  b_0 {
    store @log, 0, 4
    %v_1 = call_complex nested, 1, 2: I32
    store @log, 0, 4
    %v_2 = call_complex nested, 18446744073709551615, 2: I32
    store @log, 0, 4
    %v_3 = call_complex nested, 1, 18446744073709551614: I32
    store @log, 0, 4
    jmp b_4
  }

  b_5 {
    %v_6 = alloca 8, 4: Ptr
    store %v_6, 0, 1
    %v_7 = add %v_6, 4: Ptr
    store %v_7, 0, 4
    jmp b_8
  }

  b_9 {
    %v_10 = cmp_eq %v_11, 2: I32
    je %v_10, b_12, b_4
  }

  b_4 {
    %v_13 = phi [b_9, %v_11], [b_0, 0]: I32
    %v_14 = shl %v_13, 1: I32
    %v_15 = loads @log, 4: I32
    %v_16 = add %v_15, %v_14: I32
    store @log, %v_16, 4
    %v_11 = add %v_13, 1: I32
    %v_17 = cmp_ilt %v_11, 4: I32
    je %v_17, b_9, b_5
  }

  b_12 {
    %v_18 = alloca 8, 4: Ptr
    store %v_18, 1, 1
    %v_19 = add %v_18, 4: Ptr
    store %v_19, 9, 4
    jmp b_8
  }

  b_8 {
    %v_20 = phi [b_5, %v_6], [b_12, %v_18]: Ptr
    %v_21 = load %v_20, 1: I32
    %v_22 = cmp_eq %v_21, 1: I32
    je %v_22, b_23, b_24
  }

  b_23 {
    %v_25 = add %v_20, 4: Ptr
    %v_26 = loads %v_25, 4: I32
    %v_27 = loads @log, 4: I32
    %v_28 = add %v_27, %v_26: I32
    store @log, %v_28, 4
    jmp b_24
  }

  b_24 {
    %v_29 = loads @log, 4: I32
    %v_30 = imul %v_1, 1000000: I32
    %v_31 = imul %v_2, 10000: I32
    %v_32 = add %v_30, %v_31: I32
    %v_33 = imul %v_3, 100: I32
    %v_34 = add %v_32, %v_33: I32
    %v_35 = add %v_34, %v_29: I32
    ret %v_35
  }
}

