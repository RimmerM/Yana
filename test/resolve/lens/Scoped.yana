{-
   Lens calls in the scoped form.

   A lens *is* called, and the callee is opaque: its body is resolved once, against its own
   variables, and what the caller reads of it is its signature. What makes it one construct rather
   than a callback convention is the shape the call site takes - the continuation is a region of the
   caller's own blocks (Analysis-IR.md §10.1), so its exits are ordinary CFG edges that liveness, the
   loan extents and drop elaboration walk without knowing what a lens is.

   The extent is written here, which is what the scoped form is (Analysis-Lens.md §11.2):
   `let x = f(...) in: ...` says how much of the caller is inside the lens, and `f(...):` is the same
   thing for a lens with nothing worth binding. `Flat.yana` is the other form, where the same extent
   is derived from the last use of what was handed over instead.
-}

-- What the cleanup after a `yield` writes into, so that a test can observe it having run. It has to
-- be read *outside* the continuation to see it, since the continuation is what runs first - which is
-- the whole shape of the construct stated as a fixture.
let &log = 0 :: Int

-- The `yield` form, handing over a value. Everything after the `yield` is cleanup and runs once the
-- continuation is done.
lens fn logged() -> Int:
    log = log + 1
    yield log
    log = log + 10

-- A lens that hands over nothing, which is the `withLock` shape - five of the seven lenses in `lib/`
-- are this. Its continuation is written the same way; what it binds is the unit.
lens fn scope():
    log = log * 2
    yield {}
    log = log + 100

data Counter {value: Int}

-- A lens over an exclusive borrow. What the continuation receives is what the *declaration* says it
-- receives - `Continuation::handover` - because the callee is opaque and where it rooted the value
-- is not something this caller can see.
lens fn bumped(&c: Counter) -> Int:
    c.value = c.value + 1
    yield c.value
    c.value = c.value + 10

-- The value is read inside the continuation, where the cleanup has not run yet.
fn bound() -> Int:
    let &total = 0 :: Int

    let seen = logged() in:
        total = seen

    return total + log

-- ... and outside it, where it has. A lens with nothing worth binding is written as the call and a
-- block, which is `let _ = scope() in:` and desugars to exactly that - Analysis-Lens.md §11.8's two
-- spellings, with the one that reads better becoming the one that generalizes.
fn statement() -> Int:
    log = 3

    scope():
        log = log + 1

    -- 3 * 2 = 6 before the hand-over and 7 inside the continuation; the `return` is *after* the
    -- construct, so what it reads is 107 and the +100 is the whole assertion.
    return log

fn borrowed() -> Int:
    let &c = Counter {value: 5}
    let &out = 0 :: Int

    let seen = bumped(c) in:
        out = seen

    return out + c.value

-- Nesting: the second call is written inside the first one's continuation, so the two frames are
-- live at once and the cleanups run in the reverse order. The inner call names the same lens as the
-- outer one, which is not recursion - it is a second frame of the caller's.
fn nested() -> Int:
    let &total = 0 :: Int

    let a = logged() in:
        let b = logged() in:
            total = a * 10 + b

    return total

-- A lens call inside a loop body: the frame ends with each iteration, so its cleanup runs once per
-- pass rather than once for the loop.
fn inLoop(n: Int) -> Int:
    let &i = 0 :: Int
    let &total = 0 :: Int

    while i < n:
        i = i + 1

        let seen = logged() in:
            total = total + seen

    return total

-- A branch *inside* the frame, before the `yield`: every path still hands over exactly once, which
-- is what the frame's forward walk checks rather than counting `yield` statements.
lens fn branched(x: Int) -> Int:
    if x > 0:
        log = log + 1
    else:
        log = log + 2

    yield log

fn branchedBoth() -> Int:
    log = 0
    let &sum = 0 :: Int

    let a = branched(1) in:
        sum = a

    let b = branched(-1) in:
        sum = sum + b

    return sum

-- Both arms hand over, which is still exactly once on every path. The caller's block appears once
-- whichever arm ran: the callee is a function and both of its `yield`s are calls of the one
-- continuation, which is what an opaque boundary buys over resolving the body into the caller.
lens fn either(c: Bool) -> Int:
    if c:
        yield 1
    else:
        yield 2

    log = log + 100

fn eitherArm(c: Bool) -> Int:
    log = 0
    let &out = 0 :: Int

    let n = either(c) in:
        out = n

    return out + log

-- A branch in the *continuation*, which is ordinary control flow of the caller's: both arms rejoin
-- and the frame's cleanup follows the merge.
fn branchedContinuation(x: Int) -> Int:
    log = 0
    let &sum = 0 :: Int

    let seen = logged() in:
        if x > 0:
            sum = seen * 2
        else:
            sum = seen * 3

    return sum * 100 + log

-- A **generic** lens, and a lens called from a generic body. Both were refused while a lens was
-- resolved into its caller - `Resolver::genContext` says which declaration a written type is read
-- in, and there is one of it - and both are ordinary once a lens is a call: the callee's own body is
-- resolved once against its own variables, and the call site specializes it like any other.
lens fn (a) counted(x: a) -> a:
    log = log + 1
    yield x
    log = log + 1000

fn (a) twice(x: a) -> Int:
    let seen = counted(x) in:
        log = log + 1

    return log

fn generic() -> Int:
    log = 0
    let a = twice(1)              -- 1 before the hand-over, 2 in the continuation, 1002 after the
    return a + log                -- cleanup - and `twice` reads it after the call, so 1002

fn main() -> Int:
    log = 0
    let a = bound()               -- 1 inside, log 11 after: 1 + 11 = 12
    log = 0
    let b = statement()           -- 107, which is the cleanup having run after the continuation
    let c = borrowed()            -- 6 + 16 = 22
    log = 0
    let d = nested()              -- 1 * 10 + 2 = 12, and the cleanups run outermost last
    log = 0
    let e = inLoop(3)             -- 1 + 12 + 23 = 36, one cleanup per pass
    let f = branchedBoth()        -- 1 + 3 = 4
    let g = branchedContinuation(1)  -- 2 * 100 + 11 = 211
    let h = eitherArm(True)       -- 1 + 100
    let i = eitherArm(False)      -- 2 + 100
    let j = generic()             -- 1002 + 1002 = 2004

    return a + b + c + d + e + f + g + h + i + j
