module ResolveTest

let & log: I32 = 0

lens fn logged(step: I32 [shared call], $body: (I32) -> $r [shared call]) -> $r {
  form specialized
  slot #0 type $r
  local $yielded: $r

bb0:
  %0: I32 = read copy.trivial (global log)
  %1: I32 = read copy.trivial (step)
  %2: I32 = add inspect %0 inspect %1
  write.assign borrow.unique (global log) take %2
  %4: I32 = read copy.trivial (global log)
  %5: (I32) -> $r [shared call] = read borrow.shared ($body) loan0
  %6: $r = call inspect %5 borrow.shared %4
  write.init borrow.unique ($yielded) take %6
  %8: I32 = read copy.trivial (global log)
  %9: I32 = const 100
  %10: I32 = add inspect %8 inspect %9
  write.assign borrow.unique (global log) take %10
  %12: $r = read take ($yielded)
  return take %12
}

lens fn outer(step: I32 [shared call], $body: (I32) -> $r [shared call]) -> $r {
  form specialized
  slot #0 type $r
  local $yielded: $r

bb0:
  %0: I32 = read copy.trivial (global log)
  %1: I32 = read copy.trivial (step)
  %2: I32 = add inspect %0 inspect %1
  write.assign borrow.unique (global log) take %2
  %4: I32 = read copy.trivial (global log)
  %5: (I32) -> $r [shared call] = read borrow.shared ($body) loan0
  %6: $r = call inspect %5 borrow.shared %4
  write.init borrow.unique ($yielded) take %6
  %8: I32 = read copy.trivial (global log)
  %9: I32 = const 1000
  %10: I32 = add inspect %8 inspect %9
  write.assign borrow.unique (global log) take %10
  %12: $r = read take ($yielded)
  return take %12
}

fn twice(x: I32 [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (x)
  %1: I32 = read copy.trivial (x)
  %2: I32 = add inspect %0 inspect %1
  return take %2
}

fn nestedInArgument() -> I32 {
  local $lens0: I32 [shared call]
  local $lens1: I32 [shared call]

bb0:
  %0: I32 = const 0
  write.assign borrow.unique (global log) take %0
  %2: I32 = const 1
  lens.call logged(I32) borrow.shared %2 -> bb1

bb1(%3: I32 [shared call]) handover(I32 [shared call]):
  write.init borrow.unique ($lens0) borrow.shared %3
  %6: I32 = read copy.trivial ($lens0)
  lens.call outer(I32) borrow.shared %6 -> bb2

bb2(%7: I32 [shared call]) handover(I32 [shared call]):
  write.init borrow.unique ($lens1) borrow.shared %7
  %10: I32 = read copy.trivial ($lens1)
  %11: I32 = call twice borrow.shared %10
  return take %11
}

fn afterNested() -> I32 {
  local seen: I32

bb0:
  %0: I32 = call nestedInArgument
  write.init borrow.unique (seen) take %0
  %2: I32 = read copy.trivial (seen)
  %3: I32 = read copy.trivial (global log)
  %4: I32 = add inspect %2 inspect %3
  return take %4
}

fn main() -> I32 {
bb0:
  %0: I32 = call afterNested
  return take %0
}

lens fn logged(I32)(step: I32 [shared call], $body: (I32) -> I32 [shared call]) -> I32 = <logged at I32>

lens fn outer(I32)(step: I32 [shared call], $body: (I32) -> I32 [shared call]) -> I32 = <outer at I32>

entry main
