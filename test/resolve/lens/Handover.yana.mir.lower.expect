    %v_5 = add %v_3, 8: Ptr
    store %v_5, 7, 4
    %v_6 = add %v_3, 12: Ptr
    store %v_6, 8, 4
    copy %v_2, %v_3, 16
    %v_7 = mul 1, 4: I64
    %v_8 = add %v_2, %v_7: Ptr
    %v_9 = bitcast %v_8: Ptr
    %v_10 = load %$body, 8: Ptr
    %v_11 = add %$body, 8: Ptr
    %v_12 = load %v_11, 8: Ptr
    %v_13 = call_complex %v_10, %v_12, %v_9: I32
    store %v_1, %v_13, 4
    %v_14 = loads @log, 4: I32
    %v_15 = add %v_14, 100: I32
    store @log, %v_15, 4
    %v_16 = loads %v_1, 4: I32
    ret %v_16
  }
}

