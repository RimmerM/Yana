mut @log = [0, 0, 0, 0]

addresses<complex>(%from: I32, %$body: Ptr): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    store %v_1, %from, 4
    %v_2 = load %$body, 8: Ptr
    %v_3 = add %$body, 8: Ptr
    %v_4 = load %v_3, 8: Ptr
    %v_5 = call_complex %v_2, %v_4, %v_1: I32
    %v_6 = add %from, 1: I32
    store %v_1, %v_6, 4
    %v_7 = cmp_eq %v_5, 0: I32
    je %v_7, b_8, b_9
  }

  b_8 {
    %v_10 = load %$body, 8: Ptr
    %v_11 = add %$body, 8: Ptr
    %v_12 = load %v_11, 8: Ptr
    %v_13 = call_complex %v_10, %v_12, %v_1: I32
    jmp b_14
  }

  b_9 {
    jmp b_14
  }

  b_14 {
    %v_15 = phi [b_9, %v_5], [b_8, %v_13]: I32
    ret %v_15
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 1, 1: Ptr
    %v_2 = alloca 16, 8: Ptr
    store %v_2, main.cont'3, 8
    %v_3 = add %v_2, 8: Ptr
    store %v_3, %v_1, 8
    %v_4 = call_complex withBuffer(I32), %v_2: I32
    %v_5 = alloca 1, 1: Ptr
    %v_6 = alloca 16, 8: Ptr
    store %v_6, main.cont'2, 8
    %v_7 = add %v_6, 8: Ptr
    store %v_7, %v_5, 8
    %v_8 = call_complex withCell(I32), %v_6: I32
    %v_9 = alloca 1, 1: Ptr
    %v_10 = alloca 16, 8: Ptr
    store %v_10, main.cont, 8
    %v_11 = add %v_10, 8: Ptr
    store %v_11, %v_9, 8
    %v_12 = call_complex addresses, 20, %v_10: I32
    %v_13 = loads @log, 4: I32
    ret %v_13
  }
}

withBuffer(I32)<complex>(%$body: Ptr): I32 {
  b_0 {
    %v_1 = alloca 16, 4: Ptr
    store %v_1, 5, 4
    %v_2 = add %v_1, 4: Ptr
    store %v_2, 6, 4
    %v_3 = add %v_1, 8: Ptr
    store %v_3, 7, 4
    %v_4 = add %v_1, 12: Ptr
    store %v_4, 8, 4
    %v_5 = load %$body, 8: Ptr
    %v_6 = add %$body, 8: Ptr
    %v_7 = load %v_6, 8: Ptr
    %v_8 = call_complex %v_5, %v_7, %v_2: I32
    %v_9 = loads @log, 4: I32
    %v_10 = add %v_9, 100: I32
    store @log, %v_10, 4
    ret %v_8
  }
}

withCell(I32)<complex>(%$body: Ptr): I32 {
  b_0 {
    %v_1 = load %$body, 8: Ptr
    %v_2 = add %$body, 8: Ptr
    %v_3 = load %v_2, 8: Ptr
    %v_4 = call_complex %v_1, %v_3, 9: I32
    %v_5 = loads @log, 4: I32
    %v_6 = add %v_5, 1: I32
    store @log, %v_6, 4
    ret %v_4
  }
}

main.cont<complex>(%main.cont.env: Ptr, %$handed: Ptr): I32 {
  b_0 {
    %v_1 = loads @log, 4: I32
    %v_2 = loads %$handed, 4: I32
    %v_3 = add %v_1, %v_2: I32
    store @log, %v_3, 4
    ret 0
  }
}

main.cont'2<complex>(%main.cont'2.env: Ptr, %$handed: I32): I32 {
  b_0 {
    %v_1 = loads @log, 4: I32
    %v_2 = add %v_1, %$handed: I32
    store @log, %v_2, 4
    ret 0
  }
}

main.cont'3<complex>(%main.cont'3.env: Ptr, %$handed: Ptr): I32 {
  b_0 {
    %v_1 = loads %$handed, 4: I32
    %v_2 = imul %v_1, 3: I32
    store %$handed, %v_2, 4
    %v_3 = loads @log, 4: I32
    %v_4 = add %v_3, %v_2: I32
    store @log, %v_4, 4
    ret 0
  }
}

