mut @log = [0, 0, 0, 0]

addresses<complex>(%from: I32, %$body: Ptr): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    %v_2 = alloca 4, 4: Ptr
    %v_3 = alloca 4, 4: Ptr
    store %v_1, %from, 4
    store %v_2, 0, 4
    store %v_3, 0, 4
    %v_4 = loads %v_1, 4: I32
    store %v_3, %v_4, 4
    %v_5 = loads %v_2, 4: I32
    %v_6 = cmp_eq %v_5, 0: I32
    je %v_6, b_7, b_8
  }

  b_7 {
    %v_9 = bitcast %v_3: Ptr
    %v_10 = load %$body, 8: Ptr
    %v_11 = add %$body, 8: Ptr
    %v_12 = load %v_11, 8: Ptr
    %v_13 = call_complex %v_10, %v_12, %v_9: I32
    store %v_2, %v_13, 4
    jmp b_14
  }

  b_8 {
    jmp b_14
  }

  b_14 {
    %v_15 = loads %v_1, 4: I32
    %v_16 = add %v_15, 1: I32
    store %v_3, %v_16, 4
    %v_17 = loads %v_2, 4: I32
    %v_18 = cmp_eq %v_17, 0: I32
    je %v_18, b_19, b_20
  }

  b_19 {
    %v_21 = bitcast %v_3: Ptr
    %v_22 = load %$body, 8: Ptr
    %v_23 = add %$body, 8: Ptr
    %v_24 = load %v_23, 8: Ptr
    %v_25 = call_complex %v_22, %v_24, %v_21: I32
    store %v_2, %v_25, 4
    jmp b_26
  }

  b_20 {
    jmp b_26
  }

  b_26 {
    %v_27 = loads %v_2, 4: I32
    ret %v_27
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 1, 1: Ptr
    %v_2 = alloca 16, 8: Ptr
    store %v_2, main.cont'3, 8
    %v_3 = add %v_2, 8: Ptr
    store %v_3, %v_1, 8
    %v_4 = call_complex withBuffer(I32), %v_2: I32
    jmp b_5
  }

  b_5 {
    %v_6 = alloca 1, 1: Ptr
    %v_7 = alloca 16, 8: Ptr
    store %v_7, main.cont'2, 8
    %v_8 = add %v_7, 8: Ptr
    store %v_8, %v_6, 8
    %v_9 = call_complex withCell(I32), %v_7: I32
    jmp b_10
  }

  b_10 {
    %v_11 = alloca 1, 1: Ptr
    %v_12 = alloca 16, 8: Ptr
    store %v_12, main.cont, 8
    %v_13 = add %v_12, 8: Ptr
    store %v_13, %v_11, 8
    %v_14 = call_complex addresses, 20, %v_12: I32
    jmp b_15
  }

  b_15 {
    %v_16 = loads @log, 4: I32
    ret %v_16
  }
}

withBuffer(I32)<complex>(%$body: Ptr): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    %v_2 = alloca 16, 4: Ptr
    %v_3 = alloca 16, 4: Ptr
    store %v_3, 5, 4
    %v_4 = add %v_3, 4: Ptr
