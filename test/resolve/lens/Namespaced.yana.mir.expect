module ResolveTest

data Counter {value: I32, entered: I32}

data Holder {counter: Counter}

let & log: I32 = 0

lens fn Counter.scoped(self: Counter [unique call], step: I32 [shared call], $body: (I32) -> $r [shared call]) -> $r {
  form specialized
  slot #0 type $r
  local $yielded: $r

bb0:
  %0: I32 [unique call] = read borrow.unique (self.entered) loan0
  %1: I32 = const 1
  %2: {} = call +=(I32) borrow.unique %0 borrow.shared %1
  %3: I32 = read copy.trivial (self.value)
  %4: (I32) -> $r [shared call] = read borrow.shared ($body) loan1
  %5: $r = call inspect %4 borrow.shared %3
  write.init borrow.unique ($yielded) take %5
  %7: I32 [unique call] = read borrow.unique (self.value) loan2
  %8: I32 = read copy.trivial (step)
  %9: {} = call +=(I32) borrow.unique %7 borrow.shared %8
  %10: $r = read take ($yielded)
  return take %10
}

lens fn Counter.touch(self: Counter [unique call], $body: (->{}) -> $r [shared call]) -> $r {
  form specialized
  slot #0 type $r
  local $yielded: $r

bb0:
  %0: I32 [unique call] = read borrow.unique (self.entered) loan0
  %1: I32 = const 10
  %2: {} = call +=(I32) borrow.unique %0 borrow.shared %1
  %3: {} = const {}
  %4: (->{}) -> $r [shared call] = read borrow.shared ($body) loan1
  %5: $r = call inspect %4 take {}
  write.init borrow.unique ($yielded) take %5
  %7: I32 [unique call] = read borrow.unique (self.entered) loan2
  %8: I32 = const 100
  %9: {} = call +=(I32) borrow.unique %7 borrow.shared %8
  %10: $r = read take ($yielded)
  return take %10
}

lens fn scoped(x: I32 [shared call], step: I32 [shared call], $body: (I32) -> $r [shared call]) -> $r {
  form specialized
  slot #0 type $r
  local $yielded: $r

bb0:
  %0: I32 [unique call] = read borrow.unique (global log) loan0
  %1: I32 = const 1000
  %2: {} = call +=(I32) borrow.unique %0 borrow.shared %1
  %3: I32 = read copy.trivial (x)
  %4: I32 = read copy.trivial (step)
  %5: I32 = add inspect %3 inspect %4
  %6: (I32) -> $r [shared call] = read borrow.shared ($body) loan1
  %7: $r = call inspect %6 borrow.shared %5
  write.init borrow.unique ($yielded) take %7
  %9: $r = read take ($yielded)
  return take %9
}

fn main() -> I32 {
  local & c: Counter
  local v: I32 [shared call]
  local local2: {}
  local & h: Holder
  local w: I32 [shared call]
  local bare: I32
  local u: I32 [shared call]

bb0:
  %0: I32 = const 5
  %1: I32 = const 0
  %2: Counter = aggregate.Counter take %0 take %1
  write.init borrow.unique (c) take %2
  %4: Counter [unique call] = read borrow.unique (c) loan0
  %5: I32 = const 2
  lens.call Counter.scoped(I32) borrow.unique %4 borrow.shared %5 -> bb2

bb1:
  %13: Counter [unique call] = read borrow.unique (c) loan2
  lens.call Counter.touch(I32) borrow.unique %13 -> bb4

bb2(%6: I32 [shared call]) handover(I32 [shared call]) -> bb1:
  write.init borrow.unique (v) borrow.shared %6
  %9: I32 [unique call] = read borrow.unique (global log) loan1
  %10: I32 = read copy.trivial (v)
  %11: {} = call +=(I32) borrow.unique %9 borrow.shared %10
  jump -> bb1

bb3:
  %21: Counter = read copy.trivial (c)
  %22: Holder = aggregate.Holder take %21
  write.init borrow.unique (h) take %22
  %24: Counter [unique call] = read borrow.unique (h.counter) loan4
  %25: I32 = const 3
  lens.call Counter.scoped(I32) borrow.unique %24 borrow.shared %25 -> bb6

bb4(%14: {}) handover({}) -> bb3:
  write.init borrow.unique (local2) take {}
  %17: I32 [unique call] = read borrow.unique (global log) loan3
  %18: I32 = const 1
  %19: {} = call +=(I32) borrow.unique %17 borrow.shared %18
  jump -> bb3

bb5:
  %33: I32 = const 1
  write.init borrow.unique (bare) take %33
  %35: I32 = const 1
  %36: I32 = const 1
  lens.call scoped(I32) borrow.shared %35 borrow.shared %36 -> bb8

bb6(%26: I32 [shared call]) handover(I32 [shared call]) -> bb5:
  write.init borrow.unique (w) borrow.shared %26
  %29: I32 [unique call] = read borrow.unique (global log) loan5
  %30: I32 = read copy.trivial (w)
  %31: {} = call +=(I32) borrow.unique %29 borrow.shared %30
  jump -> bb5

bb7:
  %44: I32 = read copy.trivial (global log)
  %45: I32 = read copy.trivial (h.counter.value)
  %46: I32 = add inspect %44 inspect %45
  %47: I32 = read copy.trivial (h.counter.entered)
  %48: I32 = add inspect %46 inspect %47
  return take %48

bb8(%37: I32 [shared call]) handover(I32 [shared call]) -> bb7:
  write.init borrow.unique (u) borrow.shared %37
  %40: I32 [unique call] = read borrow.unique (global log) loan6
  %41: I32 = read copy.trivial (u)
  %42: {} = call +=(I32) borrow.unique %40 borrow.shared %41
  jump -> bb7
}

lens fn Counter.scoped(I32)(self: Counter [unique call], step: I32 [shared call], $body: (I32) -> I32 [shared call]) -> I32 = <Counter.scoped at I32>

lens fn Counter.touch(I32)(self: Counter [unique call], $body: (->{}) -> I32 [shared call]) -> I32 = <Counter.touch at I32>

lens fn scoped(I32)(x: I32 [shared call], step: I32 [shared call], $body: (I32) -> I32 [shared call]) -> I32 = <scoped at I32>

entry main
