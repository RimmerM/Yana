mut @log = [0, 0, 0, 0]

ignoring<complex>(%n: I32): I32 {
  b_0 {
    %v_1 = cmp_ilt %n, 0: I32
    je %v_1, b_2, b_3
  }

  b_4 {
    %v_5 = loads @log, 4: I32
    ret %v_5
  }

  b_6 {
    %v_7 = loads @log, 4: I32
    %v_8 = add %v_7, 7: I32
    store @log, %v_8, 4
    jmp b_4
  }

  b_9 {
    %v_10 = phi [b_3, %v_11], [b_2, %v_12]: Ptr
    %v_13 = load %v_10, 1: I32
    %v_14 = cmp_eq %v_13, 1: I32
    je %v_14, b_6, b_4
  }

  b_3 {
    %v_15 = imul %n, 10: I32
    %v_16 = loads @log, 4: I32
    %v_17 = add %v_16, %v_15: I32
    store @log, %v_17, 4
    %v_18 = loads @log, 4: I32
    %v_19 = add %v_18, 1: I32
    store @log, %v_19, 4
    %v_11 = alloca 8, 4: Ptr
    store %v_11, 0, 1
    %v_20 = add %v_11, 4: Ptr
    store %v_20, 0, 4
    jmp b_9
  }

  b_2 {
    %v_21 = sub 0, %n: I32
    %v_12 = alloca 8, 4: Ptr
    store %v_12, 1, 1
    %v_22 = add %v_12, 4: Ptr
    store %v_22, %v_21, 4
    jmp b_9
  }
}

taking<complex>(%n: I32): I32 {
  b_0 {
    %v_1 = cmp_ilt %n, 0: I32
    je %v_1, b_2, b_3
  }

  b_4 {
    %v_5 = loads @log, 4: I32
    ret %v_5
  }

  b_6 {
    %v_7 = add %v_8, 4: Ptr
    %v_9 = loads %v_7, 4: I32
    %v_10 = loads @log, 4: I32
    %v_11 = add %v_10, %v_9: I32
    store @log, %v_11, 4
    jmp b_4
  }

  b_12 {
    %v_8 = phi [b_3, %v_13], [b_2, %v_14]: Ptr
    %v_15 = load %v_8, 1: I32
    %v_16 = cmp_eq %v_15, 1: I32
    je %v_16, b_6, b_4
  }

  b_3 {
    %v_17 = imul %n, 10: I32
    %v_18 = loads @log, 4: I32
    %v_19 = add %v_18, %v_17: I32
    store @log, %v_19, 4
    %v_20 = loads @log, 4: I32
    %v_21 = add %v_20, 1: I32
    store @log, %v_21, 4
    %v_13 = alloca 8, 4: Ptr
    store %v_13, 0, 1
    %v_22 = add %v_13, 4: Ptr
    store %v_22, 0, 4
    jmp b_12
  }

  b_2 {
    %v_23 = sub 0, %n: I32
    %v_14 = alloca 8, 4: Ptr
    store %v_14, 1, 1
    %v_24 = add %v_14, 4: Ptr
    store %v_24, %v_23, 4
    jmp b_12
  }
}

main<complex>(): I32 {
  b_0 {
    store @log, 0, 4
    %v_1 = call_complex ignoring, 3: I32
    store @log, 0, 4
    %v_2 = call_complex ignoring, 18446744073709551611: I32
    store @log, 0, 4
    %v_3 = call_complex taking, 4: I32
    store @log, 0, 4
    %v_4 = call_complex taking, 18446744073709551611: I32
    %v_5 = imul %v_1, 1000000: I32
    %v_6 = imul %v_2, 10000: I32
    %v_7 = add %v_5, %v_6: I32
    %v_8 = imul %v_3, 100: I32
    %v_9 = add %v_7, %v_8: I32
    %v_10 = add %v_9, %v_4: I32
    ret %v_10
  }
}

