mut @log = [0, 0, 0, 0]

checking<complex>(%v_0: Ptr, %n: I32, %$body: Ptr) {
  b_1 {
    %v_2 = cmp_ilt %n, 0: I32
    je %v_2, b_3, b_4
  }

  b_4 {
    %v_5 = imul %n, 10: I32
    %v_6 = load %$body, 8: Ptr
    %v_7 = add %$body, 8: Ptr
    %v_8 = load %v_7, 8: Ptr
    %v_9 = call_complex %v_6, %v_8, %v_5: I32
    %v_10 = loads @log, 4: I32
    %v_11 = add %v_10, 1: I32
    store @log, %v_11, 4
    store %v_0, 0, 1
    %v_12 = add %v_0, 4: Ptr
    store %v_12, %v_9, 4
    ret 
  }

  b_3 {
    %v_13 = sub 0, %n: I32
    store %v_0, 1, 1
    %v_14 = add %v_0, 4: Ptr
    store %v_14, %v_13, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    store @log, 0, 4
    %v_1 = alloca 8, 4: Ptr
    %v_2 = alloca 1, 1: Ptr
    %v_3 = alloca 16, 8: Ptr
    store %v_3, ignoring.cont, 8
    %v_4 = add %v_3, 8: Ptr
    store %v_4, %v_2, 8
    call_complex checking, %v_1, 3, %v_3
    %v_5 = load %v_1, 1: I32
    %v_6 = cmp_eq %v_5, 1: I32
    je %v_6, b_7, b_8
  }

  b_8 {
    %v_9 = add %v_1, 4: Ptr
    %v_10 = loads %v_9, 4: I32
    jmp b_11
  }

  b_7 {
    %v_12 = add %v_1, 4: Ptr
    %v_13 = loads %v_12, 4: I32
    %v_14 = loads @log, 4: I32
    %v_15 = add %v_14, 7: I32
    store @log, %v_15, 4
    jmp b_11
  }

  b_11 {
    %v_16 = loads @log, 4: I32
    store @log, 0, 4
    %v_17 = alloca 8, 4: Ptr
    %v_18 = alloca 1, 1: Ptr
    %v_19 = alloca 16, 8: Ptr
    store %v_19, ignoring.cont, 8
    %v_20 = add %v_19, 8: Ptr
    store %v_20, %v_18, 8
    call_complex checking, %v_17, 18446744073709551611, %v_19
    %v_21 = load %v_17, 1: I32
    %v_22 = cmp_eq %v_21, 1: I32
    je %v_22, b_23, b_24
  }

  b_24 {
    %v_25 = add %v_17, 4: Ptr
    %v_26 = loads %v_25, 4: I32
    jmp b_27
  }

  b_23 {
    %v_28 = add %v_17, 4: Ptr
    %v_29 = loads %v_28, 4: I32
    %v_30 = loads @log, 4: I32
    %v_31 = add %v_30, 7: I32
    store @log, %v_31, 4
    jmp b_27
  }

  b_27 {
    %v_32 = loads @log, 4: I32
    store @log, 0, 4
    %v_33 = alloca 8, 4: Ptr
    %v_34 = alloca 1, 1: Ptr
    %v_35 = alloca 16, 8: Ptr
    store %v_35, taking.cont, 8
    %v_36 = add %v_35, 8: Ptr
    store %v_36, %v_34, 8
    call_complex checking, %v_33, 4, %v_35
    %v_37 = load %v_33, 1: I32
    %v_38 = cmp_eq %v_37, 1: I32
    je %v_38, b_39, b_40
  }

  b_40 {
    %v_41 = add %v_33, 4: Ptr
    %v_42 = loads %v_41, 4: I32
    jmp b_43
  }

  b_39 {
    %v_44 = add %v_33, 4: Ptr
    %v_45 = loads %v_44, 4: I32
    %v_46 = loads @log, 4: I32
    %v_47 = add %v_46, %v_45: I32
    store @log, %v_47, 4
    jmp b_43
  }

  b_43 {
    %v_48 = loads @log, 4: I32
    store @log, 0, 4
    %v_49 = alloca 8, 4: Ptr
    %v_50 = alloca 1, 1: Ptr
    %v_51 = alloca 16, 8: Ptr
    store %v_51, taking.cont, 8
    %v_52 = add %v_51, 8: Ptr
    store %v_52, %v_50, 8
    call_complex checking, %v_49, 18446744073709551611, %v_51
    %v_53 = load %v_49, 1: I32
    %v_54 = cmp_eq %v_53, 1: I32
    je %v_54, b_55, b_56
  }

  b_56 {
    %v_57 = add %v_49, 4: Ptr
    %v_58 = loads %v_57, 4: I32
    jmp b_59
  }

  b_55 {
    %v_60 = add %v_49, 4: Ptr
    %v_61 = loads %v_60, 4: I32
    %v_62 = loads @log, 4: I32
    %v_63 = add %v_62, %v_61: I32
    store @log, %v_63, 4
    jmp b_59
  }

  b_59 {
    %v_64 = loads @log, 4: I32
    %v_65 = imul %v_16, 1000000: I32
    %v_66 = imul %v_32, 10000: I32
    %v_67 = add %v_65, %v_66: I32
    %v_68 = imul %v_48, 100: I32
    %v_69 = add %v_67, %v_68: I32
    %v_70 = add %v_69, %v_64: I32
    ret %v_70
  }
}

ignoring.cont<complex>(%ignoring.cont.env: Ptr, %$handed: I32): I32 {
  b_0 {
    %v_1 = loads @log, 4: I32
    %v_2 = add %v_1, %$handed: I32
    store @log, %v_2, 4
    ret 0
  }
}

taking.cont<complex>(%taking.cont.env: Ptr, %$handed: I32): I32 {
  b_0 {
    %v_1 = loads @log, 4: I32
    %v_2 = add %v_1, %$handed: I32
    store @log, %v_2, 4
