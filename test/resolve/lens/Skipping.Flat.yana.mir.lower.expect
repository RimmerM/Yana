mut @log = [0, 0, 0, 0]

checking<complex>(%v_0: Ptr, %n: I32, %$body: Ptr) {
  b_1 {
    %v_2 = alloca 4, 4: Ptr
    %v_3 = alloca 4, 4: Ptr
    store %v_2, %n, 4
    %v_4 = loads %v_2, 4: I32
    %v_5 = cmp_ilt %v_4, 0: I32
    je %v_5, b_6, b_7
  }

  b_7 {
    jmp b_8
  }

  b_8 {
    %v_9 = loads %v_2, 4: I32
    %v_10 = imul %v_9, 10: I32
    %v_11 = load %$body, 8: Ptr
    %v_12 = add %$body, 8: Ptr
    %v_13 = load %v_12, 8: Ptr
    %v_14 = call_complex %v_11, %v_13, %v_10: I32
    store %v_3, %v_14, 4
    %v_15 = loads @log, 4: I32
    %v_16 = add %v_15, 1: I32
    store @log, %v_16, 4
    %v_17 = loads %v_3, 4: I32
    %v_18 = alloca 8, 4: Ptr
    store %v_18, 0, 1
    %v_19 = add %v_18, 4: Ptr
    store %v_19, %v_17, 4
    copy %v_0, %v_18, 8
    ret 
  }

  b_6 {
    %v_20 = loads %v_2, 4: I32
    %v_21 = sub 0, %v_20: I32
    %v_22 = alloca 8, 4: Ptr
    store %v_22, 1, 1
    %v_23 = add %v_22, 4: Ptr
    store %v_23, %v_21, 4
    copy %v_0, %v_22, 8
    ret 
  }
}

ignoring<complex>(%n: I32): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    %v_2 = alloca 4, 4: Ptr
    %v_3 = alloca 8, 4: Ptr
    store %v_1, %n, 4
    %v_4 = loads %v_1, 4: I32
    %v_5 = alloca 1, 1: Ptr
    %v_6 = alloca 16, 8: Ptr
    store %v_6, ignoring.cont, 8
    %v_7 = add %v_6, 8: Ptr
    store %v_7, %v_5, 8
    %v_8 = alloca 8, 4: Ptr
    call_complex checking, %v_8, %v_4, %v_6
    copy %v_3, %v_8, 8
    %v_9 = load %v_3, 1: I32
    %v_10 = cmp_eq %v_9, 1: I32
    je %v_10, b_11, b_12
  }

  b_13 {
    %v_14 = loads @log, 4: I32
    ret %v_14
  }

  b_15 {
    %v_16 = phi [b_11, %v_17]: I32
    store %v_2, %v_16, 4
    %v_18 = loads @log, 4: I32
    %v_19 = add %v_18, 7: I32
    store @log, %v_19, 4
    jmp b_13
  }

  b_12 {
    %v_20 = add %v_3, 4: Ptr
    %v_21 = loads %v_20, 4: I32
    jmp b_13
  }

  b_11 {
    %v_22 = add %v_3, 4: Ptr
    %v_17 = loads %v_22, 4: I32
    jmp b_15
  }
}

taking<complex>(%n: I32): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    %v_2 = alloca 4, 4: Ptr
    %v_3 = alloca 8, 4: Ptr
    store %v_1, %n, 4
    %v_4 = loads %v_1, 4: I32
    %v_5 = alloca 1, 1: Ptr
    %v_6 = alloca 16, 8: Ptr
    store %v_6, taking.cont, 8
    %v_7 = add %v_6, 8: Ptr
    store %v_7, %v_5, 8
    %v_8 = alloca 8, 4: Ptr
    call_complex checking, %v_8, %v_4, %v_6
    copy %v_3, %v_8, 8
    %v_9 = load %v_3, 1: I32
    %v_10 = cmp_eq %v_9, 1: I32
    je %v_10, b_11, b_12
  }

  b_13 {
    %v_14 = loads @log, 4: I32
    ret %v_14
  }

  b_15 {
    %v_16 = phi [b_11, %v_17]: I32
    store %v_2, %v_16, 4
    %v_18 = loads @log, 4: I32
    %v_19 = loads %v_2, 4: I32
    %v_20 = add %v_18, %v_19: I32
    store @log, %v_20, 4
    jmp b_13
  }

  b_12 {
    %v_21 = add %v_3, 4: Ptr
    %v_22 = loads %v_21, 4: I32
    jmp b_13
  }

  b_11 {
    %v_23 = add %v_3, 4: Ptr
    %v_17 = loads %v_23, 4: I32
    jmp b_15
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    %v_2 = alloca 4, 4: Ptr
    %v_3 = alloca 4, 4: Ptr
    %v_4 = alloca 4, 4: Ptr
    store @log, 0, 4
    %v_5 = call_complex ignoring, 3: I32
    store %v_1, %v_5, 4
    store @log, 0, 4
    %v_6 = sub 0, 5: I32
    %v_7 = call_complex ignoring, %v_6: I32
    store %v_2, %v_7, 4
    store @log, 0, 4
    %v_8 = call_complex taking, 4: I32
    store %v_3, %v_8, 4
    store @log, 0, 4
    %v_9 = sub 0, 5: I32
    %v_10 = call_complex taking, %v_9: I32
    store %v_4, %v_10, 4
    %v_11 = loads %v_1, 4: I32
    %v_12 = imul %v_11, 1000000: I32
    %v_13 = loads %v_2, 4: I32
    %v_14 = imul %v_13, 10000: I32
    %v_15 = add %v_12, %v_14: I32
    %v_16 = loads %v_3, 4: I32
    %v_17 = imul %v_16, 100: I32
    %v_18 = add %v_15, %v_17: I32
    %v_19 = loads %v_4, 4: I32
    %v_20 = add %v_18, %v_19: I32
    ret %v_20
  }
}

ignoring.cont<complex>(%ignoring.cont.env: Ptr, %$handed: I32): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    store %v_1, %$handed, 4
    %v_2 = loads @log, 4: I32
    %v_3 = loads %v_1, 4: I32
    %v_4 = add %v_2, %v_3: I32
    store @log, %v_4, 4
    ret 0
  }
}

taking.cont<complex>(%taking.cont.env: Ptr, %$handed: I32): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    store %v_1, %$handed, 4
    %v_2 = loads @log, 4: I32
    %v_3 = loads %v_1, 4: I32
    %v_4 = add %v_2, %v_3: I32
    store @log, %v_4, 4
    ret 0
  }
}

