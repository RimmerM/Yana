mut @log = [0, 0, 0, 0]

ignoring<complex>(%n: I32): I32 {
  b_0 {
    %v_1 = alloca 7, 8: Ptr
    %v_2 = cmp_ilt %n, 0: I32
    je %v_2, b_3, b_4
  }

  b_5 {
    %v_6 = loads @log, 4: I32
    ret %v_6
  }

  b_7 {
    %v_8 = loads @log, 4: I32
    %v_9 = add %v_8, 7: I32
    store @log, %v_9, 4
    jmp b_5
  }

  b_10 {
    %v_11 = phi [b_4, %v_12], [b_3, %v_13]: Ptr
    %v_14 = load %v_11, 1: I32
    %v_15 = add %v_11, 1: Ptr
    copy %v_1, %v_15, 7
    %v_16 = cmp_eq %v_14, 1: I32
    je %v_16, b_7, b_5
  }

  b_4 {
    %v_17 = imul %n, 10: I32
    %v_18 = loads @log, 4: I32
    %v_19 = add %v_18, %v_17: I32
    store @log, %v_19, 4
    %v_20 = loads @log, 4: I32
    %v_21 = add %v_20, 1: I32
    store @log, %v_21, 4
    %v_12 = alloca 8, 4: Ptr
    store %v_12, 0, 1
    %v_22 = add %v_12, 4: Ptr
    store %v_22, 0, 4
    jmp b_10
  }

  b_3 {
    %v_23 = sub 0, %n: I32
    %v_13 = alloca 8, 4: Ptr
    store %v_13, 1, 1
    %v_24 = add %v_13, 4: Ptr
    store %v_24, %v_23, 4
    jmp b_10
  }
}

taking<complex>(%n: I32): I32 {
  b_0 {
    %v_1 = alloca 3, 4: Ptr
    %v_2 = cmp_ilt %n, 0: I32
    je %v_2, b_3, b_4
  }

  b_5 {
    %v_6 = loads @log, 4: I32
    ret %v_6
  }

  b_7 {
    %v_8 = loads @log, 4: I32
    %v_9 = add %v_8, %v_10: I32
    store @log, %v_9, 4
    jmp b_5
  }

  b_11 {
    %v_12 = phi [b_4, %v_13], [b_3, %v_14]: Ptr
    %v_15 = load %v_12, 1: I32
    %v_16 = add %v_12, 1: Ptr
    copy %v_1, %v_16, 3
    %v_17 = add %v_12, 4: Ptr
    %v_10 = load %v_17, 4: I32
    %v_18 = cmp_eq %v_15, 1: I32
    je %v_18, b_7, b_5
  }

  b_4 {
    %v_19 = imul %n, 10: I32
    %v_20 = loads @log, 4: I32
    %v_21 = add %v_20, %v_19: I32
    store @log, %v_21, 4
    %v_22 = loads @log, 4: I32
    %v_23 = add %v_22, 1: I32
    store @log, %v_23, 4
    %v_13 = alloca 8, 4: Ptr
    store %v_13, 0, 1
    %v_24 = add %v_13, 4: Ptr
    store %v_24, 0, 4
    jmp b_11
  }

  b_3 {
    %v_25 = sub 0, %n: I32
    %v_14 = alloca 8, 4: Ptr
    store %v_14, 1, 1
    %v_26 = add %v_14, 4: Ptr
    store %v_26, %v_25, 4
    jmp b_11
  }
}

main<complex>(): I32 {
  b_0 {
    store @log, 0, 4
    %v_1 = call_complex ignoring, 3: I32
    store @log, 0, 4
    %v_2 = call_complex ignoring, 18446744073709551611: I32
    store @log, 0, 4
    %v_3 = call_complex taking, 4: I32
    store @log, 0, 4
    %v_4 = call_complex taking, 18446744073709551611: I32
    %v_5 = imul %v_1, 1000000: I32
    %v_6 = imul %v_2, 10000: I32
    %v_7 = add %v_5, %v_6: I32
    %v_8 = imul %v_3, 100: I32
    %v_9 = add %v_7, %v_8: I32
    %v_10 = add %v_9, %v_4: I32
    ret %v_10
  }
}

