mut @trace = [0, 0, 0, 0]

Guard.drop<complex>(%value: Ptr) {
  b_0 {
    %v_1 = load %value, 4: I32
    %v_2 = loads @trace, 4: I32
    %v_3 = add %v_2, %v_1: I32
    store @trace, %v_3, 4
    ret 
  }
}

leaving<complex>(%x: I32): I32 {
