  %23: I32 = const 1
  %24: I32 = add inspect %22 inspect %23
  write.assign borrow.unique (global log) take %24
  %26: I32 = read copy.trivial ($yielded)
  return take %26

bb3:
  %9: I32 = read copy.trivial (i)
  %10: (I32) -> I32 [shared call] = read borrow.shared ($body) loan0
  %11: I32 = call inspect %10 borrow.shared %9
  %12: I32 = const 0
  %13: Bool = eq inspect %11 inspect %12
  write.assign borrow.unique ($yielded) take %11
  branch inspect %13 -> bb4 -> bb5

bb4:
  %17: I32 = read copy.trivial (i)
  %18: I32 = const 1
  %19: I32 = add inspect %17 inspect %18
  write.assign borrow.unique (i) take %19
  jump -> bb1

bb5:
  jump -> bb2
}

