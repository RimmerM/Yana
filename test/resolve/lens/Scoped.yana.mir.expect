bb2(%8: {}) handover({}) -> bb3:
  write.init borrow.unique (local0) take %8
  %11: I32 = read copy.trivial (global log)
  %12: I32 = const 1
  %13: I32 = add inspect %11 inspect %12
  write.assign borrow.unique (global log) take %13
  jump -> bb3

bb3 frame:
  %16: I32 = read copy.trivial (global log)
  %17: I32 = const 100
  %18: I32 = add inspect %16 inspect %17
  write.assign borrow.unique (global log) take %18
  jump -> bb4

bb4:
  %21: I32 = read copy.trivial (global log)
  return take %21
}

fn borrowed() -> I32 {
  local & c: Counter
  local & out: I32
  local & c: Counter [unique call]
  local seen: I32

bb0:
  %0: I32 = const 5
  %1: Counter = aggregate take %0
  write.init borrow.unique (c) take %1
  %3: I32 = const 0
  write.init borrow.unique (out) take %3
  %5: Counter [unique call] = read borrow.unique (c) loan0
  write.init borrow.unique (c) borrow.unique %5
  jump -> bb1

bb1 frame -> bb4:
  %8: I32 = read copy.trivial (c.value)
  %9: I32 = const 1
  %10: I32 = add inspect %8 inspect %9
  write.assign borrow.unique (c.value) take %10
  %12: I32 = read copy.trivial (c.value)
  yield -> bb2(take %12)

bb2(%13: I32) handover(I32 [shared call]) -> bb3:
  write.init borrow.unique (seen) take %13
  %16: I32 = read copy.trivial (seen)
  write.assign borrow.unique (out) take %16
  jump -> bb3

bb3 frame:
  %19: I32 = read copy.trivial (c.value)
  %20: I32 = const 10
  %21: I32 = add inspect %19 inspect %20
  write.assign borrow.unique (c.value) take %21
  jump -> bb4

bb4:
  %24: I32 = read copy.trivial (out)
  %25: I32 = read copy.trivial (c.value)
  %26: I32 = add inspect %24 inspect %25
  return take %26
}

