module ResolveTest

data Counter {value: I32}

let & log: I32 = 0

lens fn logged() -> I32 [shared call] = <flattened at each call>

lens fn scope() -> {} = <flattened at each call>

lens fn bumped(c: Counter [unique call]) -> I32 [shared call] = <flattened at each call>

fn bound() -> I32 {
  local & total: I32
  local seen: I32

bb0:
  %0: I32 = const 0
  write.init borrow.unique (total) take %0
  jump -> bb1

bb1 frame -> bb4:
  %3: I32 = read copy.trivial (global log)
  %4: I32 = const 1
  %5: I32 = add inspect %3 inspect %4
  write.assign borrow.unique (global log) take %5
  %7: I32 = read copy.trivial (global log)
  yield -> bb2(take %7)

bb2(%8: I32) handover(I32 [shared call]) -> bb3:
  write.init borrow.unique (seen) take %8
  %11: I32 = read copy.trivial (seen)
  write.assign borrow.unique (total) take %11
  jump -> bb3

bb3 frame:
  %14: I32 = read copy.trivial (global log)
  %15: I32 = const 10
  %16: I32 = add inspect %14 inspect %15
  write.assign borrow.unique (global log) take %16
  jump -> bb4

bb4:
  %19: I32 = read copy.trivial (total)
  %20: I32 = read copy.trivial (global log)
  %21: I32 = add inspect %19 inspect %20
  return take %21
}

