fn main() -> I32 {
  local a: I32
  local b: I32
  local c: I32
  local d: I32
  local e: I32
  local f: I32
  local g: I32
  local h: I32
  local i: I32

bb0:
  %0: I32 = const 0
  write.assign borrow.unique (global log) take %0
  %2: I32 = call bound
  write.init borrow.unique (a) take %2
  %4: I32 = const 0
