lens fn logged(I32)($body: (I32) -> I32 [shared call]) -> I32 = <logged at I32>

lens fn scope(I32)($body: (->{}) -> I32 [shared call]) -> I32 = <scope at I32>

lens fn bumped(I32)(c: Counter [unique call], $body: (I32) -> I32 [shared call]) -> I32 = <bumped at I32>

lens fn branched(I32)(x: I32 [shared call], $body: (I32) -> I32 [shared call]) -> I32 = <branched at I32>

lens fn either(I32)(c: Bool [shared call], $body: (I32) -> I32 [shared call]) -> I32 = <either at I32>

fn twice(I32)(x: I32 [shared call]) -> I32 = <twice at I32>

lens fn counted(I32, I32)(x: I32 [shared call], $body: (I32) -> I32 [shared call]) -> I32 = <counted at I32, I32>

