lens fn either(c: Bool [shared call]) -> I32 [shared call] = <flattened at each call>

fn eitherArm(c: Bool [shared call]) -> I32 {
  local & out: I32
  local c: Bool
  local n: I32
  local n: I32

bb0:
  %0: I32 = const 0
  write.assign borrow.unique (global log) take %0
  %2: I32 = const 0
  write.init borrow.unique (out) take %2
  %4: Bool = read copy.trivial (c)
  write.init borrow.unique (c) take %4
  jump -> bb1

bb1 frame -> bb9:
  %7: Bool = read copy.trivial (c)
  branch inspect %7 -> bb2 -> bb3

bb2 frame:
  %9: I32 = const 1
  yield -> bb5(take %9)

bb3 frame:
  %17: I32 = const 2
  yield -> bb7(take %17)

bb4 frame:
  %25: I32 = read copy.trivial (global log)
  %26: I32 = const 100
  %27: I32 = add inspect %25 inspect %26
  write.assign borrow.unique (global log) take %27
