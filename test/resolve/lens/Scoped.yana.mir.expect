bb0:
  %0: I32 = const 0
  write.init borrow.unique (i) take %0
  %2: I32 = const 0
  write.init borrow.unique (total) take %2
  jump -> bb1

bb1:
  %5: I32 = read copy.trivial (i)
  %6: I32 = read copy.trivial (n)
  %7: Bool = lt inspect %5 inspect %6
  branch inspect %7 -> bb2 -> bb3

bb2:
  %9: I32 = read copy.trivial (i)
  %10: I32 = const 1
  %11: I32 = add inspect %9 inspect %10
  write.assign borrow.unique (i) take %11
