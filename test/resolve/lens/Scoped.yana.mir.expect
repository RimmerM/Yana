bb6 frame:
  %27: I32 = read copy.trivial (global log)
  %28: I32 = const 10
  %29: I32 = add inspect %27 inspect %28
  write.assign borrow.unique (global log) take %29
  jump -> bb7

bb7:
  jump -> bb1
}

lens fn branched(x: I32 [shared call]) -> I32 [shared call] = <flattened at each call>

