  %40: I32 = add inspect %38 inspect %39
  %41: I32 = read copy.trivial (g)
  %42: I32 = add inspect %40 inspect %41
  %43: I32 = read copy.trivial (h)
  %44: I32 = add inspect %42 inspect %43
  %45: I32 = read copy.trivial (i)
  %46: I32 = add inspect %44 inspect %45
