  %30: I32 = read copy.trivial (a)
  %31: I32 = read copy.trivial (b)
  %32: I32 = add inspect %30 inspect %31
  %33: I32 = read copy.trivial (c)
  %34: I32 = add inspect %32 inspect %33
  %35: I32 = read copy.trivial (d)
