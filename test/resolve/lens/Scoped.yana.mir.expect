  %13: I32 = read copy.trivial (n)
  write.assign borrow.unique (out) take %13
  jump -> bb6

bb6 frame:
  jump -> bb4

bb7(%18: I32) handover(I32 [shared call]) -> bb8:
  write.init borrow.unique (n) take %18
  %21: I32 = read copy.trivial (n)
  write.assign borrow.unique (out) take %21
  jump -> bb8

bb8 frame:
  jump -> bb4

bb9:
  %30: I32 = read copy.trivial (out)
  %31: I32 = read copy.trivial (global log)
  %32: I32 = add inspect %30 inspect %31
  return take %32
}

