fn alwaysLeaves(x: I32 [shared call]) -> I32 {
  local local1: {}
  local local2: I32

bb0:
  jump -> bb1

bb1 frame:
  %1: I32 = read copy.trivial (global log)
  %2: I32 = const 1
  %3: I32 = add inspect %1 inspect %2
  write.assign borrow.unique (global log) take %3
  %5: {} = const {}
  yield -> bb2(take %5)

bb2(%6: {}) handover({}):
  write.init borrow.unique (local1) take %6
  %9: I32 = read copy.trivial (x)
  %10: I32 = const 1
  %11: I32 = add inspect %9 inspect %10
  write.init borrow.unique (local2) take %11
  %13: I32 = read copy.trivial (global log)
  %14: I32 = const 100
  %15: I32 = add inspect %13 inspect %14
  write.assign borrow.unique (global log) take %15
  %17: I32 = read copy.trivial (local2)
  return take %17
}

