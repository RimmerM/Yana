lens fn returningCleanup(c: Bool [shared call]) -> I32 [shared call] = <flattened at each call>

fn fromCleanup(c: Bool [shared call]) -> I32 {
  local & out: I32
  local c: Bool
  local n: I32

bb0:
  %0: I32 = const 0
  write.assign borrow.unique (global log) take %0
  %2: I32 = const 0
  write.init borrow.unique (out) take %2
  %4: Bool = read copy.trivial (c)
  write.init borrow.unique (c) take %4
  jump -> bb1

bb1 frame -> bb7:
  %7: I32 = const 3
  yield -> bb2(take %7)

bb2(%8: I32) handover(I32 [shared call]) -> bb3:
  write.init borrow.unique (n) take %8
  %11: I32 = read copy.trivial (n)
  write.assign borrow.unique (out) take %11
  jump -> bb3

bb3 frame:
  %14: I32 = read copy.trivial (global log)
  %15: I32 = const 5
  %16: I32 = add inspect %14 inspect %15
  write.assign borrow.unique (global log) take %16
  %18: Bool = read copy.trivial (c)
  branch inspect %18 -> bb4 -> bb5

bb4 frame:
  %20: I32 = const 77
  return take %20

bb5 frame:
  jump -> bb6

bb6 frame:
  %23: I32 = read copy.trivial (global log)
  %24: I32 = const 1000
  %25: I32 = add inspect %23 inspect %24
  write.assign borrow.unique (global log) take %25
  jump -> bb7

bb7:
  %28: I32 = read copy.trivial (out)
  %29: I32 = read copy.trivial (global log)
  %30: I32 = add inspect %28 inspect %29
  return take %30
}

fn main() -> I32 {
