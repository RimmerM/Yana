  %58: I32 = read copy.trivial (i)
  %59: I32 = add inspect %57 inspect %58
  %60: I32 = read copy.trivial (j)
  %61: I32 = add inspect %59 inspect %60
  %62: I32 = read copy.trivial (k)
  %63: I32 = add inspect %61 inspect %62
  %64: I32 = read copy.trivial (counted)
