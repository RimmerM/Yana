mut @trace = [0, 0, 0, 0]

Guard.drop<complex>(%v_0: I32) {
  b_1 {
    %v_2 = loads @trace, 4: I32
    %v_3 = add %v_2, %v_0: I32
    store @trace, %v_3, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    store @trace, 0, 4
    store @trace, 1004, 4
    store @trace, 0, 4
    store @trace, 0, 4
    %v_1 = imm 7: I32
    call_complex Guard.drop, %v_1
    %v_2 = loads @trace, 4: I32
    %v_3 = add %v_1, %v_2: I32
    store @trace, 0, 4
    call_complex Guard.drop, 7
    %v_4 = loads @trace, 4: I32
    %v_5 = add 1, %v_4: I32
    store @trace, 0, 4
    store @trace, 100, 4
    store @trace, 0, 4
    store @trace, 0, 4
    store @trace, 0, 4
    jmp b_6
  }

  b_6 {
    %v_7 = phi [b_0, 0], [b_8, %v_9]: I32
    %v_10 = phi [b_0, 0], [b_8, %v_11]: I32
    %v_12 = cmp_ilt %v_7, 4: I32
    je %v_12, b_13, b_14
  }

  b_14 {
    %v_15 = loads @trace, 4: I32
    %v_16 = add %v_15, 10000: I32
    store @trace, %v_16, 4
    jmp b_17
  }

  b_13 {
    %v_18 = cmp_eq %v_7, 2: I32
    je %v_18, b_19, b_8
  }

  b_8 {
    %v_9 = add %v_7, 1: I32
    %v_20 = loads @trace, 4: I32
    %v_21 = add %v_20, %v_9: I32
    store @trace, %v_21, 4
    %v_11 = add %v_10, %v_9: I32
    jmp b_6
  }

  b_19 {
    jmp b_17
  }

  b_17 {
    %v_22 = phi [b_14, 0], [b_19, 1]: I32
    %v_23 = phi [b_14, 0], [b_19, 500]: I32
    je %v_22, b_24, b_25
  }

  b_24 {
    call_complex Guard.drop, %v_23
    %v_26 = add %v_10, %v_23: I32
    jmp b_25
  }

  b_25 {
    %v_27 = phi [b_17, %v_10], [b_24, %v_26]: I32
    %v_28 = loads @trace, 4: I32
    %v_29 = add %v_27, %v_28: I32
    store @trace, 0, 4
    jmp b_30
  }

  b_31 {
    %v_32 = cmp_ilt %v_33, 3: I32
    je %v_32, b_30, b_34
  }

  b_34 {
    %v_35 = loads @trace, 4: I32
    %v_36 = add %v_35, 10000: I32
    store @trace, %v_36, 4
    %v_37 = add %v_38, %v_36: I32
    %v_39 = add 1011, %v_3: I32
    %v_40 = add %v_39, %v_5: I32
    %v_41 = add %v_40, 316: I32
    %v_42 = add %v_41, %v_29: I32
    %v_43 = add %v_42, %v_37: I32
    ret %v_43
  }

  b_30 {
    %v_44 = phi [b_31, %v_33], [b_25, 0]: I32
    %v_45 = phi [b_31, %v_38], [b_25, 0]: I32
    %v_33 = add %v_44, 1: I32
    %v_46 = loads @trace, 4: I32
    %v_47 = add %v_46, %v_33: I32
    store @trace, %v_47, 4
    %v_38 = add %v_45, %v_33: I32
    jmp b_31
  }
}

