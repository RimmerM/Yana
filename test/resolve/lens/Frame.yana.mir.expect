fn leaving(x: I32 [shared call]) -> I32 {
  local & seen: I32
  local view: Guard [shared call]
  local mine: Guard

bb0:
  %0: I32 = const 0
  write.init borrow.unique (seen) take %0
  %2: I32 = const 7
  lens.call held(I32) borrow.shared %2 -> bb1

bb1(%3: Guard [shared call]) handover(Guard [shared call]):
  write.init borrow.unique (view) borrow.shared %3
  %6: I32 = const 1000
  %7: Guard = aggregate.Guard take %6
  write.init borrow.unique (mine) take %7
  %9: I32 = read copy.trivial (x)
  %10: I32 = const 0
  %11: Bool = gt inspect %9 inspect %10
  branch inspect %11 -> bb4 -> bb2

bb2 handover(Guard [shared call]):
  jump -> bb3

bb3 handover(Guard [shared call]):
  %20: I32 = read copy.trivial (mine.id)
  drop (mine)
  write.assign borrow.unique (seen) take %20
  %22: I32 = read copy.trivial (seen)
  %23: I32 = const 1
  %24: I32 = add inspect %22 inspect %23
  return take %24

bb4 handover(Guard [shared call]):
  %13: I32 = read copy.trivial (view.id)
  %14: I32 = read copy.trivial (mine.id)
  drop (mine)
  %15: I32 = add inspect %13 inspect %14
  write.assign borrow.unique (seen) take %15
  %17: I32 = read copy.trivial (seen)
  return take %17
}

