module ResolveTest

data Guard {id: I32} drop authored

data Counter {value: I32}

instance Drop(Guard): Guard.drop

let & trace: I32 = 0

fn Guard.drop(value: Guard) -> {} {
bb0:
  %0: I32 = read copy.trivial (global trace)
  %1: I32 = read copy.trivial (value.id)
  %2: I32 = add inspect %0 inspect %1
  write.assign borrow.unique (global trace) take %2
  return
}

lens fn held(id: I32 [shared call], $body: (Guard) -> $r [shared call]) -> $r {
  form specialized
  slot #0 type $r
  local $yielded: $r
  local g: Guard

bb0:
  %0: I32 = read copy.trivial (id)
  %1: Guard = aggregate.Guard take %0
  write.init borrow.unique (g) take %1
  %3: Guard [shared call] = read borrow.shared (g) loan0
  %4: (Guard) -> $r [shared call] = read borrow.shared ($body) loan1
  %5: $r = call inspect %4 borrow.shared %3
  drop (g)
  write.init borrow.unique ($yielded) take %5
  %7: I32 = read copy.trivial (global trace)
  %8: I32 = const 100
  %9: I32 = add inspect %7 inspect %8
  write.assign borrow.unique (global trace) take %9
  %11: $r = read take ($yielded)
  return take %11
}

lens fn window(c: Counter [unique call], $body: (&Counter) -> $r [shared call]) -> $r {
  form specialized
  slot #0 type $r
  local $yielded: $r

bb0:
  %0: I32 = read copy.trivial (c.value)
  %1: I32 = const 1
  %2: I32 = add inspect %0 inspect %1
  write.assign borrow.unique (c.value) take %2
  %4: Counter [unique call] = read borrow.unique (c) loan0
  %5: (&Counter) -> $r [shared call] = read borrow.shared ($body) loan1
  %6: $r = call inspect %5 borrow.unique %4
  write.init borrow.unique ($yielded) take %6
  %8: I32 = read copy.trivial (c.value)
  %9: I32 = const 2
  %10: I32 = mul inspect %8 inspect %9
  write.assign borrow.unique (c.value) take %10
  %12: $r = read take ($yielded)
  return take %12
}

lens fn consuming(g: Guard, $body: (I32) -> $r [shared call]) -> $r {
  form specialized
  slot #0 type $r
  local $yielded: $r

bb0:
  %0: I32 = read copy.trivial (g.id)
  drop (g)
  %1: I32 = const 3
  %2: I32 = mul inspect %0 inspect %1
  %3: (I32) -> $r [shared call] = read borrow.shared ($body) loan0
  %4: $r = call inspect %3 borrow.shared %2
  write.init borrow.unique ($yielded) take %4
  %6: $r = read take ($yielded)
  return take %6
}

fn frameStorage() -> I32 {
  local & atUse: I32
  local & afterUse: I32
  local g: Guard [shared call]

bb0:
  %0: I32 = const 0
  write.init borrow.unique (atUse) take %0
  %2: I32 = const 0
  write.init borrow.unique (afterUse) take %2
  %4: I32 = const 4
  lens.call held(I32) borrow.shared %4 -> bb2

bb1:
  %13: I32 = read copy.trivial (atUse)
  %14: I32 = read copy.trivial (afterUse)
  %15: I32 = const 2
  %16: I32 = mul inspect %14 inspect %15
  %17: I32 = add inspect %13 inspect %16
  %18: I32 = read copy.trivial (global trace)
  %19: I32 = add inspect %17 inspect %18
  return take %19

bb2(%5: Guard [shared call]) handover(Guard [shared call]) -> bb1:
  write.init borrow.unique (g) borrow.shared %5
  %8: I32 = read copy.trivial (g.id)
  write.assign borrow.unique (atUse) take %8
  %10: I32 = read copy.trivial (global trace)
  write.assign borrow.unique (afterUse) take %10
  jump -> bb1
}

fn written() -> I32 {
  local & c: Counter
  local & w: Counter [unique call]

bb0:
  %0: I32 = const 7
  %1: Counter = aggregate.Counter take %0
  write.init borrow.unique (c) take %1
  %3: Counter [unique call] = read borrow.unique (c) loan0
  lens.call window(I32) borrow.unique %3 -> bb2

bb1:
  %12: I32 = read copy.trivial (c.value)
  return take %12

bb2(%4: Counter [unique call]) handover(Counter [unique call]) -> bb1:
  write.init borrow.unique (w) borrow.unique %4
  %7: I32 = read copy.trivial (w.value)
  %8: I32 = const 100
  %9: I32 = add inspect %7 inspect %8
  write.assign borrow.unique (w.value) take %9
  jump -> bb1
}

