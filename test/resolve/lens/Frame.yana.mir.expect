  %36: I32 = add inspect %34 inspect %35
  %37: I32 = read copy.trivial (f)
  %38: I32 = add inspect %36 inspect %37
  %39: I32 = read copy.trivial (g)
  %40: I32 = add inspect %38 inspect %39
  %41: I32 = read copy.trivial (h)
  %42: I32 = add inspect %40 inspect %41
  return take %42
}

lens fn held(I32)(id: I32 [shared call], $body: (Guard) -> I32 [shared call]) -> I32 = <held at I32>

lens fn window(I32)(c: Counter [unique call], $body: (&Counter) -> I32 [shared call]) -> I32 = <window at I32>

lens fn consuming(I32)(g: Guard, $body: (I32) -> I32 [shared call]) -> I32 = <consuming at I32>

lens fn scaled(I32)(id: I32 [shared call], $body: (I32) -> I32 [shared call]) -> I32 = <scaled at I32>

entry main
