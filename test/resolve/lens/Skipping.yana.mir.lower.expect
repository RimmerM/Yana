mut @log = [0, 0, 0, 0]

summing<complex>(%n: I32, %stop: I32): I32 {
  b_0 {
    jmp b_1
  }

  b_2 {
    %v_3 = loads @log, 4: I32
    ret %v_3
  }

  b_4 {
    %v_5 = add %v_6, 4: Ptr
    %v_7 = loads %v_5, 4: I32
    %v_8 = loads @log, 4: I32
    %v_9 = add %v_8, %v_7: I32
    store @log, %v_9, 4
    jmp b_2
  }

  b_10 {
    %v_6 = phi [b_11, %v_12], [b_13, %v_14]: Ptr
    %v_15 = load %v_6, 1: I32
    %v_16 = cmp_eq %v_15, 1: I32
    je %v_16, b_4, b_2
  }

  b_1 {
    %v_17 = phi [b_0, 0], [b_18, %v_19]: I32
    %v_20 = cmp_ilt %v_17, %n: I32
    je %v_20, b_21, b_11
  }

  b_21 {
    %v_22 = cmp_eq %v_17, %stop: I32
    je %v_22, b_13, b_18
  }

  b_18 {
    %v_23 = loads @log, 4: I32
    %v_24 = add %v_23, %v_17: I32
    store @log, %v_24, 4
    %v_19 = add %v_17, 1: I32
    jmp b_1
  }

  b_11 {
    %v_25 = loads @log, 4: I32
    %v_26 = add %v_25, 1000: I32
    store @log, %v_26, 4
    %v_12 = alloca 8, 4: Ptr
    store %v_12, 0, 1
    %v_27 = add %v_12, 4: Ptr
    store %v_27, 0, 4
    jmp b_10
  }

  b_13 {
    %v_14 = alloca 8, 4: Ptr
    store %v_14, 1, 1
    %v_28 = add %v_14, 4: Ptr
    store %v_28, 7, 4
    jmp b_10
  }
}

main<complex>(): I32 {
  b_0 {
    store @log, 0, 4
    %v_1 = loads @log, 4: I32
    %v_2 = add %v_1, 1: I32
    store @log, %v_2, 4
    %v_3 = loads @log, 4: I32
    %v_4 = add %v_3, 30: I32
    store @log, %v_4, 4
    %v_5 = loads @log, 4: I32
    %v_6 = add %v_5, 100: I32
    store @log, %v_6, 4
    %v_7 = loads @log, 4: I32
    store @log, 0, 4
    %v_8 = loads @log, 4: I32
    %v_9 = add %v_8, 1: I32
    store @log, %v_9, 4
    %v_10 = loads @log, 4: I32
    %v_11 = add %v_10, 5: I32
    store @log, %v_11, 4
    %v_12 = loads @log, 4: I32
    store @log, 0, 4
    %v_13 = loads @log, 4: I32
    %v_14 = add %v_13, 1: I32
    store @log, %v_14, 4
    %v_15 = loads @log, 4: I32
    %v_16 = add %v_15, 7: I32
    store @log, %v_16, 4
    %v_17 = loads @log, 4: I32
    store @log, 0, 4
    %v_18 = call_complex summing, 5, 3: I32
    store @log, 0, 4
    %v_19 = call_complex summing, 4, 9: I32
    %v_20 = imul %v_7, 1000000: I32
    %v_21 = imul %v_12, 100000: I32
    %v_22 = add %v_20, %v_21: I32
    %v_23 = imul %v_17, 10000: I32
    %v_24 = add %v_22, %v_23: I32
    %v_25 = imul %v_18, 1000: I32
    %v_26 = add %v_24, %v_25: I32
    %v_27 = add %v_26, %v_19: I32
    ret %v_27
  }
}

