mut @log = [0, 0, 0, 0]

positive<complex>(%v_0: Ptr, %n: I32, %$body: Ptr) {
  b_1 {
    %v_2 = loads @log, 4: I32
    %v_3 = add %v_2, 1: I32
    store @log, %v_3, 4
    %v_4 = cmp_igt %n, 0: I32
    je %v_4, b_5, b_6
  }

  b_6 {
    %v_7 = sub 0, %n: I32
    store %v_0, 1, 1
    %v_8 = add %v_0, 4: Ptr
    store %v_8, %v_7, 4
    ret 
  }

  b_5 {
    %v_9 = imul %n, 10: I32
    %v_10 = load %$body, 8: Ptr
    %v_11 = add %$body, 8: Ptr
    %v_12 = load %v_11, 8: Ptr
    %v_13 = call_complex %v_10, %v_12, %v_9: I32
    %v_14 = loads @log, 4: I32
    %v_15 = add %v_14, 100: I32
    store @log, %v_15, 4
    store %v_0, 0, 1
    %v_16 = add %v_0, 4: Ptr
    store %v_16, %v_13, 4
    ret 
  }
}

upToFailing<complex>(%v_0: Ptr, %n: I32, %stop: I32, %$body: Ptr) {
  b_1 {
    jmp b_2
  }

  b_2 {
    %v_3 = phi [b_1, 0], [b_4, %v_5]: I32
    %v_6 = phi [b_1, 0], [b_4, %v_7]: I32
    %v_8 = cmp_ilt %v_6, %n: I32
    je %v_8, b_9, b_10
  }

  b_10 {
    %v_11 = phi [b_2, %v_3], [b_12, %v_5]: I32
    %v_13 = loads @log, 4: I32
    %v_14 = add %v_13, 1000: I32
    store @log, %v_14, 4
    store %v_0, 0, 1
    %v_15 = add %v_0, 4: Ptr
    store %v_15, %v_11, 4
    ret 
  }

  b_9 {
    %v_16 = cmp_eq %v_6, %stop: I32
    je %v_16, b_17, b_18
  }

  b_18 {
    %v_19 = load %$body, 8: Ptr
    %v_20 = add %$body, 8: Ptr
    %v_21 = load %v_20, 8: Ptr
    %v_5 = call_complex %v_19, %v_21, %v_6: I32
    %v_22 = cmp_eq %v_5, 0: I32
    je %v_22, b_4, b_12
  }

  b_17 {
    store %v_0, 1, 1
    %v_23 = add %v_0, 4: Ptr
    store %v_23, 7, 4
    ret 
  }

  b_4 {
    %v_7 = add %v_6, 1: I32
    jmp b_2
  }

  b_12 {
    jmp b_10
  }
}

main<complex>(): I32 {
  b_0 {
    store @log, 0, 4
    %v_1 = alloca 8, 4: Ptr
    %v_2 = alloca 1, 1: Ptr
    %v_3 = alloca 16, 8: Ptr
    store %v_3, taking.cont, 8
    %v_4 = add %v_3, 8: Ptr
    store %v_4, %v_2, 8
    call_complex positive, %v_1, 3, %v_3
    %v_5 = load %v_1, 1: I32
    %v_6 = cmp_eq %v_5, 1: I32
    je %v_6, b_7, b_8
  }

  b_8 {
    %v_9 = add %v_1, 4: Ptr
    %v_10 = loads %v_9, 4: I32
    jmp b_11
  }

  b_7 {
    %v_12 = add %v_1, 4: Ptr
    %v_13 = loads %v_12, 4: I32
    %v_14 = loads @log, 4: I32
    %v_15 = add %v_14, %v_13: I32
    store @log, %v_15, 4
    jmp b_11
  }

  b_11 {
    %v_16 = loads @log, 4: I32
    store @log, 0, 4
    %v_17 = alloca 8, 4: Ptr
    %v_18 = alloca 1, 1: Ptr
    %v_19 = alloca 16, 8: Ptr
    store %v_19, taking.cont, 8
    %v_20 = add %v_19, 8: Ptr
    store %v_20, %v_18, 8
    call_complex positive, %v_17, 18446744073709551611, %v_19
    %v_21 = load %v_17, 1: I32
    %v_22 = cmp_eq %v_21, 1: I32
    je %v_22, b_23, b_24
  }

  b_24 {
    %v_25 = add %v_17, 4: Ptr
    %v_26 = loads %v_25, 4: I32
    jmp b_27
  }

  b_23 {
    %v_28 = add %v_17, 4: Ptr
    %v_29 = loads %v_28, 4: I32
    %v_30 = loads @log, 4: I32
    %v_31 = add %v_30, %v_29: I32
    store @log, %v_31, 4
    jmp b_27
  }

  b_27 {
    %v_32 = loads @log, 4: I32
    store @log, 0, 4
    %v_33 = alloca 8, 4: Ptr
    %v_34 = alloca 1, 1: Ptr
    %v_35 = alloca 16, 8: Ptr
    store %v_35, ignoring.cont, 8
    %v_36 = add %v_35, 8: Ptr
    store %v_36, %v_34, 8
    call_complex positive, %v_33, 18446744073709551615, %v_35
    %v_37 = load %v_33, 1: I32
    %v_38 = cmp_eq %v_37, 1: I32
    je %v_38, b_39, b_40
  }

  b_40 {
    %v_41 = add %v_33, 4: Ptr
    %v_42 = loads %v_41, 4: I32
    jmp b_43
  }

  b_39 {
    %v_44 = add %v_33, 4: Ptr
    %v_45 = loads %v_44, 4: I32
    %v_46 = loads @log, 4: I32
    %v_47 = add %v_46, 7: I32
    store @log, %v_47, 4
    jmp b_43
  }

  b_43 {
    %v_48 = loads @log, 4: I32
    store @log, 0, 4
    %v_49 = alloca 8, 4: Ptr
    %v_50 = alloca 1, 1: Ptr
    %v_51 = alloca 16, 8: Ptr
    store %v_51, summing.cont, 8
    %v_52 = add %v_51, 8: Ptr
    store %v_52, %v_50, 8
    call_complex upToFailing, %v_49, 5, 3, %v_51
    %v_53 = load %v_49, 1: I32
    %v_54 = cmp_eq %v_53, 1: I32
    je %v_54, b_55, b_56
  }

  b_56 {
    %v_57 = add %v_49, 4: Ptr
    %v_58 = loads %v_57, 4: I32
    jmp b_59
  }

  b_55 {
    %v_60 = add %v_49, 4: Ptr
    %v_61 = loads %v_60, 4: I32
    %v_62 = loads @log, 4: I32
    %v_63 = add %v_62, %v_61: I32
    store @log, %v_63, 4
    jmp b_59
  }

  b_59 {
    %v_64 = loads @log, 4: I32
    store @log, 0, 4
    %v_65 = alloca 8, 4: Ptr
    %v_66 = alloca 1, 1: Ptr
    %v_67 = alloca 16, 8: Ptr
    store %v_67, summing.cont, 8
    %v_68 = add %v_67, 8: Ptr
    store %v_68, %v_66, 8
    call_complex upToFailing, %v_65, 4, 9, %v_67
    %v_69 = load %v_65, 1: I32
    %v_70 = cmp_eq %v_69, 1: I32
    je %v_70, b_71, b_72
  }

  b_72 {
    %v_73 = add %v_65, 4: Ptr
    %v_74 = loads %v_73, 4: I32
    jmp b_75
  }

  b_71 {
    %v_76 = add %v_65, 4: Ptr
    %v_77 = loads %v_76, 4: I32
    %v_78 = loads @log, 4: I32
    %v_79 = add %v_78, %v_77: I32
    store @log, %v_79, 4
    jmp b_75
  }

  b_75 {
    %v_80 = loads @log, 4: I32
    %v_81 = imul %v_16, 1000000: I32
    %v_82 = imul %v_32, 100000: I32
    %v_83 = add %v_81, %v_82: I32
    %v_84 = imul %v_48, 10000: I32
    %v_85 = add %v_83, %v_84: I32
    %v_86 = imul %v_64, 1000: I32
    %v_87 = add %v_85, %v_86: I32
    %v_88 = add %v_87, %v_80: I32
    ret %v_88
  }
}

taking.cont<complex>(%taking.cont.env: Ptr, %$handed: I32): I32 {
  b_0 {
    %v_1 = loads @log, 4: I32
    %v_2 = add %v_1, %$handed: I32
    store @log, %v_2, 4
    ret 0
  }
}

