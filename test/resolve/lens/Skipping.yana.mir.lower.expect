mut @log = [0, 0, 0, 0]

summing<complex>(%n: I32, %stop: I32): I32 {
  b_0 {
    jmp b_1
  }

  b_2 {
    %v_3 = loads @log, 4: I32
    ret %v_3
  }

  b_4 {
    %v_5 = loads @log, 4: I32
    %v_6 = add %v_5, %v_7: I32
    store @log, %v_6, 4
    jmp b_2
  }

  b_8 {
    %v_9 = phi [b_10, 0], [b_11, 1]: I32
    %v_7 = phi [b_10, 0], [b_11, 7]: I32
    je %v_9, b_4, b_2
  }

  b_1 {
    %v_12 = phi [b_0, 0], [b_13, %v_14]: I32
    %v_15 = cmp_ilt %v_12, %n: I32
    je %v_15, b_16, b_10
  }

  b_16 {
    %v_17 = cmp_eq %v_12, %stop: I32
    je %v_17, b_11, b_13
  }

  b_13 {
    %v_18 = loads @log, 4: I32
    %v_19 = add %v_18, %v_12: I32
    store @log, %v_19, 4
    %v_14 = add %v_12, 1: I32
    jmp b_1
  }

  b_10 {
    %v_20 = loads @log, 4: I32
    %v_21 = add %v_20, 1000: I32
    store @log, %v_21, 4
    jmp b_8
  }

  b_11 {
    jmp b_8
  }
}

main<complex>(): I32 {
  b_0 {
    store @log, 0, 4
    store @log, 131, 4
    %v_1 = loads @log, 4: I32
    store @log, 0, 4
    store @log, 1, 4
    store @log, 6, 4
    %v_2 = loads @log, 4: I32
    store @log, 0, 4
    store @log, 1, 4
    store @log, 8, 4
    %v_3 = loads @log, 4: I32
    store @log, 0, 4
    %v_4 = call_complex summing, 5, 3: I32
    store @log, 0, 4
    %v_5 = call_complex summing, 4, 9: I32
    %v_6 = imul %v_1, 1000000: I32
    %v_7 = imul %v_2, 100000: I32
    %v_8 = add %v_6, %v_7: I32
    %v_9 = imul %v_3, 10000: I32
    %v_10 = add %v_8, %v_9: I32
    %v_11 = imul %v_4, 1000: I32
    %v_12 = add %v_10, %v_11: I32
    %v_13 = add %v_12, %v_5: I32
    ret %v_13
  }
}

