mut @log = [0, 0, 0, 0]

taking<complex>(%n: I32): I32 {
  b_0 {
    %v_1 = alloca 3, 4: Ptr
    %v_2 = loads @log, 4: I32
    %v_3 = add %v_2, 1: I32
    store @log, %v_3, 4
    %v_4 = cmp_igt %n, 0: I32
    je %v_4, b_5, b_6
  }

  b_7 {
    %v_8 = loads @log, 4: I32
    ret %v_8
  }

  b_9 {
    %v_10 = loads @log, 4: I32
    %v_11 = add %v_10, %v_12: I32
    store @log, %v_11, 4
    jmp b_7
  }

  b_13 {
    %v_14 = phi [b_6, %v_15], [b_5, %v_16]: Ptr
    %v_17 = load %v_14, 1: I32
    %v_18 = add %v_14, 1: Ptr
    copy %v_1, %v_18, 3
    %v_19 = add %v_14, 4: Ptr
    %v_12 = load %v_19, 4: I32
    %v_20 = cmp_eq %v_17, 1: I32
    je %v_20, b_9, b_7
  }

  b_6 {
    %v_21 = sub 0, %n: I32
    %v_15 = alloca 8, 4: Ptr
    store %v_15, 1, 1
    %v_22 = add %v_15, 4: Ptr
    store %v_22, %v_21, 4
    jmp b_13
  }

  b_5 {
    %v_23 = imul %n, 10: I32
    %v_24 = loads @log, 4: I32
    %v_25 = add %v_24, %v_23: I32
    store @log, %v_25, 4
    %v_26 = loads @log, 4: I32
    %v_27 = add %v_26, 100: I32
    store @log, %v_27, 4
    %v_16 = alloca 8, 4: Ptr
    store %v_16, 0, 1
    %v_28 = add %v_16, 4: Ptr
    store %v_28, 0, 4
    jmp b_13
  }
}

summing<complex>(%n: I32, %stop: I32): I32 {
  b_0 {
    %v_1 = alloca 3, 4: Ptr
    jmp b_2
  }

  b_3 {
    %v_4 = loads @log, 4: I32
    ret %v_4
  }

  b_5 {
    %v_6 = loads @log, 4: I32
    %v_7 = add %v_6, %v_8: I32
    store @log, %v_7, 4
    jmp b_3
  }

  b_9 {
    %v_10 = phi [b_11, %v_12], [b_13, %v_14]: Ptr
    %v_15 = load %v_10, 1: I32
    %v_16 = add %v_10, 1: Ptr
    copy %v_1, %v_16, 3
    %v_17 = add %v_10, 4: Ptr
    %v_8 = load %v_17, 4: I32
    %v_18 = cmp_eq %v_15, 1: I32
    je %v_18, b_5, b_3
  }

  b_2 {
    %v_19 = phi [b_0, 0], [b_20, %v_21]: I32
    %v_22 = cmp_ilt %v_19, %n: I32
    je %v_22, b_23, b_11
  }

  b_23 {
    %v_24 = cmp_eq %v_19, %stop: I32
    je %v_24, b_13, b_20
  }

  b_20 {
    %v_25 = loads @log, 4: I32
    %v_26 = add %v_25, %v_19: I32
    store @log, %v_26, 4
    %v_21 = add %v_19, 1: I32
    jmp b_2
  }

  b_11 {
    %v_27 = loads @log, 4: I32
    %v_28 = add %v_27, 1000: I32
    store @log, %v_28, 4
    %v_12 = alloca 8, 4: Ptr
    store %v_12, 0, 1
    %v_29 = add %v_12, 4: Ptr
    store %v_29, 0, 4
    jmp b_9
  }

  b_13 {
    %v_14 = alloca 8, 4: Ptr
    store %v_14, 1, 1
    %v_30 = add %v_14, 4: Ptr
    store %v_30, 7, 4
    jmp b_9
  }
}

main<complex>(): I32 {
  b_0 {
    store @log, 0, 4
    %v_1 = call_complex taking, 3: I32
    store @log, 0, 4
    %v_2 = call_complex taking, 18446744073709551611: I32
    store @log, 0, 4
    %v_3 = loads @log, 4: I32
    %v_4 = add %v_3, 1: I32
    store @log, %v_4, 4
    jmp b_5
  }

  b_5 {
    %v_6 = loads @log, 4: I32
    %v_7 = add %v_6, 7: I32
    store @log, %v_7, 4
    jmp b_8
  }

  b_8 {
    %v_9 = loads @log, 4: I32
    store @log, 0, 4
    %v_10 = call_complex summing, 5, 3: I32
    store @log, 0, 4
    %v_11 = call_complex summing, 4, 9: I32
    %v_12 = imul %v_1, 1000000: I32
    %v_13 = imul %v_2, 100000: I32
    %v_14 = add %v_12, %v_13: I32
    %v_15 = imul %v_9, 10000: I32
    %v_16 = add %v_14, %v_15: I32
    %v_17 = imul %v_10, 1000: I32
    %v_18 = add %v_16, %v_17: I32
    %v_19 = add %v_18, %v_11: I32
    ret %v_19
  }
}

