mut @log = [0, 0, 0, 0]

main<complex>(): I32 {
  b_0 {
    store @log, 131, 4
    store @log, 1, 4
    store @log, 1, 4
    store @log, 0, 4
    jmp b_1
  }

  b_2 {
    %v_3 = loads @log, 4: I32
    %v_4 = add %v_3, 1000: I32
    store @log, %v_4, 4
    jmp b_5
  }

  b_6 {
    %v_7 = cmp_eq %v_8, 3: I32
    je %v_7, b_9, b_1
  }

  b_1 {
    %v_10 = phi [b_6, %v_8], [b_0, 0]: I32
    %v_11 = loads @log, 4: I32
    %v_12 = add %v_11, %v_10: I32
    store @log, %v_12, 4
    %v_8 = add %v_10, 1: I32
    %v_13 = cmp_ilt %v_8, 5: I32
    je %v_13, b_6, b_2
  }

  b_9 {
    %v_14 = loads @log, 4: I32
    %v_15 = add %v_14, 7: I32
    store @log, %v_15, 4
    jmp b_5
  }

  b_5 {
    %v_16 = loads @log, 4: I32
    store @log, 0, 4
    jmp b_17
  }

  b_18 {
    %v_19 = cmp_ilt %v_20, 4: I32
    je %v_19, b_17, b_21
  }

  b_21 {
    %v_22 = loads @log, 4: I32
    %v_23 = add %v_22, 1000: I32
    store @log, %v_23, 4
    %v_24 = imul %v_16, 1000: I32
    %v_25 = add 131680000, %v_24: I32
    %v_26 = add %v_25, %v_23: I32
    ret %v_26
  }

  b_17 {
    %v_27 = phi [b_18, %v_20], [b_5, 0]: I32
    %v_28 = loads @log, 4: I32
    %v_29 = add %v_28, %v_27: I32
    store @log, %v_29, 4
    %v_20 = add %v_27, 1: I32
    jmp b_18
  }
}

