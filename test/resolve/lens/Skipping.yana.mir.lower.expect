mut @log = [0, 0, 0, 0]

taking<complex>(%n: I32): I32 {
  b_0 {
    %v_1 = loads @log, 4: I32
    %v_2 = add %v_1, 1: I32
    store @log, %v_2, 4
    %v_3 = cmp_igt %n, 0: I32
    je %v_3, b_4, b_5
  }

  b_6 {
    %v_7 = loads @log, 4: I32
    ret %v_7
  }

  b_8 {
    %v_9 = add %v_10, 4: Ptr
    %v_11 = loads %v_9, 4: I32
    %v_12 = loads @log, 4: I32
    %v_13 = add %v_12, %v_11: I32
    store @log, %v_13, 4
    jmp b_6
  }

  b_14 {
    %v_10 = phi [b_5, %v_15], [b_4, %v_16]: Ptr
    %v_17 = load %v_10, 1: I32
    %v_18 = cmp_eq %v_17, 1: I32
    je %v_18, b_8, b_6
  }

  b_5 {
    %v_19 = sub 0, %n: I32
    %v_15 = alloca 8, 4: Ptr
    store %v_15, 1, 1
    %v_20 = add %v_15, 4: Ptr
    store %v_20, %v_19, 4
    jmp b_14
  }

  b_4 {
    %v_21 = imul %n, 10: I32
    %v_22 = loads @log, 4: I32
    %v_23 = add %v_22, %v_21: I32
    store @log, %v_23, 4
    %v_24 = loads @log, 4: I32
    %v_25 = add %v_24, 100: I32
    store @log, %v_25, 4
    %v_16 = alloca 8, 4: Ptr
    store %v_16, 0, 1
    %v_26 = add %v_16, 4: Ptr
    store %v_26, 0, 4
    jmp b_14
  }
}

summing<complex>(%n: I32, %stop: I32): I32 {
  b_0 {
    jmp b_1
  }

  b_2 {
    %v_3 = loads @log, 4: I32
    ret %v_3
  }

  b_4 {
    %v_5 = add %v_6, 4: Ptr
    %v_7 = loads %v_5, 4: I32
    %v_8 = loads @log, 4: I32
    %v_9 = add %v_8, %v_7: I32
    store @log, %v_9, 4
    jmp b_2
  }

  b_10 {
    %v_6 = phi [b_11, %v_12], [b_13, %v_14]: Ptr
    %v_15 = load %v_6, 1: I32
    %v_16 = cmp_eq %v_15, 1: I32
    je %v_16, b_4, b_2
  }

  b_1 {
    %v_17 = phi [b_0, 0], [b_18, %v_19]: I32
    %v_20 = cmp_ilt %v_17, %n: I32
    je %v_20, b_21, b_11
  }

  b_21 {
    %v_22 = cmp_eq %v_17, %stop: I32
    je %v_22, b_13, b_18
  }

  b_18 {
    %v_23 = loads @log, 4: I32
    %v_24 = add %v_23, %v_17: I32
    store @log, %v_24, 4
    %v_19 = add %v_17, 1: I32
    jmp b_1
  }

  b_11 {
    %v_25 = loads @log, 4: I32
    %v_26 = add %v_25, 1000: I32
    store @log, %v_26, 4
    %v_12 = alloca 8, 4: Ptr
    store %v_12, 0, 1
    %v_27 = add %v_12, 4: Ptr
    store %v_27, 0, 4
    jmp b_10
  }

  b_13 {
    %v_14 = alloca 8, 4: Ptr
    store %v_14, 1, 1
    %v_28 = add %v_14, 4: Ptr
    store %v_28, 7, 4
    jmp b_10
  }
}

main<complex>(): I32 {
  b_0 {
    store @log, 0, 4
    %v_1 = call_complex taking, 3: I32
    store @log, 0, 4
    %v_2 = call_complex taking, 18446744073709551611: I32
    store @log, 0, 4
    %v_3 = loads @log, 4: I32
    %v_4 = add %v_3, 1: I32
    store @log, %v_4, 4
    jmp b_5
  }

  b_5 {
    %v_6 = loads @log, 4: I32
    %v_7 = add %v_6, 7: I32
    store @log, %v_7, 4
    jmp b_8
  }

  b_8 {
    %v_9 = loads @log, 4: I32
    store @log, 0, 4
    %v_10 = call_complex summing, 5, 3: I32
    store @log, 0, 4
    %v_11 = call_complex summing, 4, 9: I32
    %v_12 = imul %v_1, 1000000: I32
    %v_13 = imul %v_2, 100000: I32
    %v_14 = add %v_12, %v_13: I32
    %v_15 = imul %v_9, 10000: I32
    %v_16 = add %v_14, %v_15: I32
    %v_17 = imul %v_10, 1000: I32
    %v_18 = add %v_16, %v_17: I32
    %v_19 = add %v_18, %v_11: I32
    ret %v_19
  }
}

