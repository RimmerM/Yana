steps(Gate)<complex>(%v_0: I32, %$body: Ptr): I32 {
  b_1 {
    jmp b_2
  }

  b_2 {
    %v_3 = phi [b_1, 0], [b_4, %v_5]: I32
    %v_6 = cmp_ilt %v_3, %v_0: I32
    je %v_6, b_7, b_8
  }

  b_8 {
    %v_9 = phi [b_2, 0], [b_10, %v_11]: I32
    ret %v_9
  }

  b_7 {
    %v_12 = load %$body, 8: Ptr
    %v_13 = add %$body, 8: Ptr
    %v_14 = load %v_13, 8: Ptr
    %v_11 = call_complex %v_12, %v_14, %v_3: I32
    %v_15 = cmp_eq %v_11, 0: I32
    je %v_15, b_4, b_10
  }

  b_4 {
    %v_5 = add %v_3, 1: I32
    jmp b_2
  }

  b_10 {
    jmp b_8
  }
}

