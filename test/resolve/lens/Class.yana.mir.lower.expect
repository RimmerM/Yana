@image$base = []
@environment(erasedLens(Gate)) = [0, 0, 0, 0, 0, 0, 0, 0] {slot 0: @descriptor(Gate), slot 4: @witness(Guard(Gate.depth, Gate.hold, Gate.depthOf, Gate.opened, twiceDeep(Gate), steps(Gate)))}
