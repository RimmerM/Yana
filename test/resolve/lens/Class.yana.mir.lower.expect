Gate.opened<complex>(%v_0: I32, %$body: Ptr): I32, I32 {
  b_1 {
    %v_2 = cmp_ile %v_0, 0: I32
    je %v_2, b_3, b_4
  }

  b_4 {
    %v_5 = imul %v_0, 10: I32
    %v_6 = load %$body, 8: Ptr
    %v_7 = add %$body, 8: Ptr
    %v_8 = load %v_7, 8: Ptr
    %v_9 = call_complex %v_6, %v_8, %v_5: I32
    ret 0, %v_9
  }

  b_3 {
    ret 1, 5
  }
}

erasedLens<complex>(%v_0: Ptr, %x: Ptr): I32 {
  b_1 {
    %v_2 = alloca 4, 4: Ptr
    %v_3 = alloca 8, 8: Ptr
    store %v_3, %v_2, 8
    %v_4 = alloca 16, 8: Ptr
    store %v_4, erasedLens.cont, 8
    %v_5 = add %v_4, 8: Ptr
    store %v_5, %v_3, 8
    %v_6 = add %v_0, 4: Ptr
    %v_7 = loads %v_6, 4: I32
    %v_8 = sext %v_7: I64
    %v_9 = add %v_8, @image$base: Ptr
    %v_10 = add %v_9, 8: Ptr
    %v_11 = loads %v_10, 4: I32
    %v_12 = sext %v_11: I64
    %v_13 = add %v_12, @image$base: Ptr
    %v_14 = call_complex %v_13, 0, %x, %v_4: I32
    %v_15 = loads %v_2, 4: I32
    ret %v_15
  }
}

erasedIter<complex>(%v_0: Ptr, %x: Ptr): I32 {
