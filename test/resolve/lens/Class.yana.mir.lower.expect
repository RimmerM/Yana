    %v_2 = alloca 4, 4: Ptr
    store %v_2, 0, 4
    %v_3 = alloca 8, 8: Ptr
    store %v_3, %v_2, 8
    %v_4 = alloca 16, 8: Ptr
    store %v_4, erasedIter.cont, 8
    %v_5 = add %v_4, 8: Ptr
