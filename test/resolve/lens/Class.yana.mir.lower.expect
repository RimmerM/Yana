    %v_6 = add %v_0, 4: Ptr
    %v_7 = loads %v_6, 4: I32
    %v_8 = sext %v_7: I64
    %v_9 = add %v_8, @image$base: Ptr
    %v_10 = add %v_9, 20: Ptr
    %v_11 = loads %v_10, 4: I32
    %v_12 = sext %v_11: I64
    %v_13 = add %v_12, @image$base: Ptr
    %v_14 = call_complex %v_13, 0, %x, %v_4: I32
    %v_15 = loads %v_2, 4: I32
    ret %v_15
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = imm 2: I32
    jmp b_2
  }

  b_3 {
    %v_4 = cmp_ilt %v_5, 4: I32
    je %v_4, b_2, b_6
  }

  b_6 {
    %v_7 = add 32, %v_8: I32
    jmp b_9
  }

  b_2 {
    %v_10 = phi [b_3, %v_5], [b_0, 0]: I32
    %v_11 = phi [b_3, %v_8], [b_0, 0]: I32
    %v_8 = add %v_11, %v_10: I32
    %v_5 = add %v_10, 1: I32
    jmp b_3
  }

  b_12 {
    %v_13 = cmp_ilt %v_14, %v_1: I32
    je %v_13, b_9, b_15
  }

  b_9 {
    %v_16 = phi [b_12, %v_14], [b_6, 0]: I32
    %v_17 = phi [b_12, %v_18], [b_6, 0]: I32
    %v_19 = add %v_17, %v_16: I32
    %v_18 = add %v_19, 1: I32
    %v_14 = add %v_16, 1: I32
    jmp b_12
  }

  b_15 {
    %v_20 = add %v_7, %v_18: I32
    %v_21 = add %v_20, 26: I32
    %v_22 = add %v_21, 43: I32
    %v_23 = add %v_22, 10: I32
    %v_24 = alloca 4, 4: Ptr
    store %v_24, %v_1, 4
    %v_25 = call_complex erasedLens, @environment(erasedLens(Gate)), %v_24: I32
    %v_26 = add %v_23, %v_25: I32
    %v_27 = alloca 4, 4: Ptr
    store %v_27, 3, 4
    %v_28 = call_complex erasedIter, @environment(erasedIter(Gate)), %v_27: I32
    %v_29 = add %v_26, %v_28: I32
    ret %v_29
  }
}

twiceDeep(Gate)<complex>(%v_0: I32, %$body: Ptr): I32 {
  b_1 {
    %v_2 = shl %v_0, 1: I32
    %v_3 = load %$body, 8: Ptr
    %v_4 = add %$body, 8: Ptr
    %v_5 = load %v_4, 8: Ptr
    %v_6 = call_complex %v_3, %v_5, %v_2: I32
