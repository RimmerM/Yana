let image$base: () = <none>

fn firstOverBoth(%n: I32, %m: I32, %stop: I32) -> I32 {
  b0:
    %i = alloc : I32
    init %i, 0
    jmp b1

  b1:
    %v8 = load %i : I32
    %v9 = cmp_lt %v8, %n : Bool
