fn total(xs: Array(I32) [shared call view]) -> I32 {
  local & sum: I32
  local & i: I32
  local local3: I32 [shared slot 0]

bb0:
  %0: I32 = const 0
  write.init borrow.unique (sum) take %0
  %2: I32 = const 0
  write.init borrow.unique (i) take %2
  jump -> bb1

bb1:
  %5: I32 = read copy.trivial (i)
  %6: Array(I32) [shared call view] = read borrow.shared (xs) loan0
  %7: Size = call length(Array(I32)) borrow.shared %6
  %8: I32 = convert inspect %7
  %9: Bool = lt inspect %5 inspect %8
  branch inspect %9 -> bb3 -> bb2

bb2:
  %25: I32 = read copy.trivial (sum)
  return take %25

bb3:
  %11: I32 = read copy.trivial (sum)
  %12: I32 = read copy.trivial (i)
  %13: Array(I32) [shared call view] = read borrow.shared (xs) loan1
  %14: Size = convert inspect %12
  %15: I32 [shared slot 0] = call.subscript get(Array(I32), Size, I32) borrow.shared %13 borrow.shared %14 roots{1}
  write.init borrow.unique (local3) borrow.shared %15
  %17: I32 = read copy.trivial (local3)
  %18: I32 = add inspect %11 inspect %17
  write.assign borrow.unique (sum) take %18
  %20: I32 = read copy.trivial (i)
  %21: I32 = const 1
  %22: I32 = add inspect %20 inspect %21
  write.assign borrow.unique (i) take %22
  jump -> bb1
}

