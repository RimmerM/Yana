  %22: I32 [unique slot 0 owner] = call.subscript getMut(Array(I32), Size, I32) borrow.unique %20 borrow.shared %21 roots{2}
  write.init borrow.unique (local4) borrow.unique %22
  write.assign borrow.unique (local4) take %19
  %25: I32 = read copy.trivial (i)
