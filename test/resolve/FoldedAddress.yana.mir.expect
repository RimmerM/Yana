fn oneSize() -> I64 {
  local & local0: Array(I32) object1
  local xs: Array(I32) object1

bb0:
  %0: I32 = const 1
  %1: I32 = const 2
  %2: I32 = const 3
  %3: I32 = const 4
  %4: %I32 = run.slots I32 *4
  %5: Size = bitcast inspect %4
  %6: Size = const 0
  %7: Bool = eq inspect %5 inspect %6
  %8: {} = call checkCondition borrow.shared %7
  %9: @bits(30) U32 = const 4
  %10: @bits(2) U32 = const 1
  %11: Run(I32) = aggregate.Run take %4 take %9 take %10
  %12: @bits(30) U32 = const 4
  %13: Array(I32) = aggregate.Array take %11 take %12
  write.init borrow.unique (local0) take %13
  %15: Size = const 0
  write.init borrow.unique ([%%4][0]) take %0
  %17: Size = const 1
  write.init borrow.unique ([%%4][1]) take %1
  %19: Size = const 2
  write.init borrow.unique ([%%4][2]) take %2
  %21: Size = const 3
  write.init borrow.unique ([%%4][3]) take %3
  %23: Array(I32) = read take (local0)
  write.init borrow.unique (xs) take %23
  %25: Array(I32) [shared call] = read borrow.shared (xs) loan0
  %26: Array(I32) [shared slot 0 view] = call.derivation elements(Array(I32), I32) borrow.shared %25 roots{0}
  %27: Size = call sizeOf(Array(I32)) borrow.shared %26
  drop (xs)
  %28: I64 = convert inspect %27
  return take %28
}

