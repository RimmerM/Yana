module ResolveTest

fn reciprocalIsNegative(value: F64 [shared call]) -> Bool {
bb0:
  %0: F64 = read copy.trivial (value)
  %1: F64 = const 1
  %2: F64 = div inspect %1 inspect %0
  %3: F64 = const 0
  %4: Bool = lt inspect %2 inspect %3
  return take %4
}

fn scaledDown(v: a [shared call]) -> a {
  form specialized
  slot #0 type a
  slot #1 class Num(a)
  local local1: a

bb0:
  %0: I64 = const 4
  %1: a = call fromInt(a) borrow.shared %0
  write.init borrow.unique (local1) take %1
  %3: a [shared call] = read borrow.shared (local1) loan0
  %4: a [shared call] = read borrow.shared (v) loan1
  %5: a = call *(a) borrow.shared %3 borrow.shared %4
  drop (local1)
  return take %5
}

fn widened(n: I64 [shared call]) -> Bool {
bb0:
  %0: I64 = read copy.trivial (n)
  %1: I64 = const 1
  %2: Bool = lt inspect %1 inspect %0
  return take %2
}

fn main() -> I32 {
bb0:
  %0: F64 = const 0
  %1: F64 = const 2
  %2: F64 = sub inspect %0 inspect %1
  %3: Bool = call reciprocalIsNegative borrow.shared %2
  %4: Bool = not inspect %3
  branch inspect %4 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %11: I64 = const 3
  %12: I64 = call scaledDown(I64) borrow.shared %11
  %13: I64 = const 12
  %14: Bool = ne inspect %12 inspect %13
  branch inspect %14 -> bb6 -> bb4

bb3:
  %6: I32 = const 0
  %7: I32 = const 1
  %8: I32 = sub inspect %6 inspect %7
  return take %8

bb4:
  jump -> bb5

bb5:
  %21: I64 = const 9
  %22: Bool = call widened borrow.shared %21
  %23: Bool = not inspect %22
  branch inspect %23 -> bb9 -> bb7

bb6:
  %16: I32 = const 0
  %17: I32 = const 2
  %18: I32 = sub inspect %16 inspect %17
  return take %18

bb7:
  jump -> bb8

bb8:
  %30: I32 = const 41
  return take %30

bb9:
  %25: I32 = const 0
  %26: I32 = const 3
  %27: I32 = sub inspect %25 inspect %26
  return take %27
}

fn scaledDown(I64)(v: I64 [shared call]) -> I64 = <scaledDown at I64>

entry main
