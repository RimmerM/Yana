Bool: size 1, align 1, stride 1, tag word at 0, payload at 0, scalar of 1 bits, niche at 0 width 1, valid 0..1, free 0 below / 254 above

Ordering: size 1, align 1, stride 1, tag word at 0, payload at 0, scalar of 2 bits, niche at 0 width 1, valid 0..2, free 0 below / 253 above

Sum: size 8, align 4, stride 8, tag word at 0, payload at 4, niche none

Colour: size 8, align 4, stride 8, tag word at 0, payload at 4, niche none

Five: size 8, align 4, stride 8, tag word at 0, payload at 4, niche none

Flags: size 2, align 1, stride 2, niche at 0 width 1, valid 0..1, free 0 below / 254 above
  .0 at 0: Bool
  .1 at 1: Bool

Tagged: size 8, align 4, stride 8, tag word at 0, payload at 4, niche none

Wide: size 8, align 4, stride 8, tag word at 0, payload at 4, niche none

Maybe(Sum): size 12, align 4, stride 12, tag word at 0, payload at 4, niche none
