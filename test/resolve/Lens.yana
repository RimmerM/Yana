-- Transparent lenses - Design.md's Lens functions, Analysis-Lens.md's V1.
--
-- A lens is called by writing the call and nothing else: the rest of the enclosing block becomes
-- the argument the call site did not write. Everything here is transparent, which means the
-- continuation runs exactly once and no call site carries a fallback.

-- What the cleanup after a `yield` writes into, so that a test can observe it having run. It has to
-- be read *outside* the continuation to see the cleanup, since the continuation is what runs first -
-- which is the whole shape of the construct stated as a fixture.
let &log = 0 :: Int

-- The `yield` form, handing over a value. Everything after the `yield` is cleanup and runs once the
-- block below the call site is done, on the normal path and on the leaving one alike.
lens fn logged() -> Int:
    log = log + 1
    yield log
    log = log + 10

-- The `yield` form handing over nothing, which is the `withLock` shape: called as a bare statement,
-- and the block below it is what runs between the two halves.
lens fn scope() -> {}:
    log = log * 2
    yield {}
    log = log + 100

-- The explicit-callback form, written out. Transparent because the declared result *is* the
-- continuation's result, which is what makes the two forms one declaration.
lens fn plusOne(x: Int, body: (Int) -> a) -> a = body(x + 1)

-- A lens handing over several values, which a `let` destructures as the record they read as.
lens fn split(x: Int, body: (low: Int, high: Int) -> a) -> a = body(x % 10, x / 10)

-- A generic lens. The continuation's parameter type is one of the lens's *own* variables, so the
-- written argument is what decides it before the block below can be lifted against it.
lens fn twiceOver(value: a) -> a:
    log = log + 1
    yield value

-- A lens over a mutable borrow. The borrow is exclusive for the whole call, so the block below sees
-- what the lens handed it rather than the storage the lens is holding.
data Counter {value: Int}

lens fn bumped(&c: Counter) -> Int:
    c.value = c.value + 1
    yield c.value
    c.value = c.value + 10

fn bound() -> Int:
    -- The continuation is `return seen`, so `seen` is what the lens yielded and the cleanup has not
    -- run yet when it is read.
    let seen = logged()
    return seen

-- ... and here it has: `bound` returned, so `logged`'s post-yield line has run.
fn cleanupRan() -> Int:
    let seen = bound()
    return seen + log

fn statement() -> Int:
    log = 3
    scope()
    log = log + 1

    -- 3 * 2 + 1 = 7 here; the +100 happens after this block, which is the continuation.
    return log

fn explicit() -> Int:
    let n = plusOne(9)
    return n * 2

fn destructured() -> Int:
    let {low, high} = split(37)
    return low * 100 + high

fn generic() -> Int:
    let x = twiceOver(4)
    let y = twiceOver(True)
    return if y then x * 2 else 0

fn borrowed() -> Int:
    let &c = Counter {value: 5}
    let seen = bumped(c)
    return seen

-- The continuation written out at the call site is an ordinary call and stays one, which is what
-- makes the sugar sugar rather than the only way in.
fn written() -> Int = plusOne(4, (n: Int) -> n * 3)

-- Nesting: the second lens call is a statement of the first one's continuation, so the two frames
-- are live at once and the cleanups run in the reverse order.
fn nested() -> Int:
    let a = logged()
    let b = plusOne(a)
    return b

-- A lens call inside a loop body: the continuation is the rest of *that* body, so the lens's own
-- frame ends with each iteration and its cleanup runs once per pass.
fn inLoop(n: Int) -> Int:
    let &i = 0 :: Int
    let &total = 0 :: Int

    while i < n:
        i = i + 1
        let seen = logged()
        total = total + seen

    return total

fn main() -> Int:
    log = 0
    let a = cleanupRan()      -- 1 + 11 = 12
    log = 0
    let b = statement()       -- 7
    let c = explicit()        -- 20
    let d = destructured()    -- 7 * 100 + 3 = 703
    let e = borrowed()        -- 6
    let j = generic()         -- 8
    let f = written()         -- 15
    log = 0
    let g = nested()          -- 1 + 1 = 2
    log = 0
    let h = inLoop(3)         -- 1 + 12 + 23 = 36

    return a + b + c + d + e + f + g + h + j
