fn boxedValue(box: Boxed(I32) [shared call]) -> I32 {
bb0(%0: Boxed(I32) [shared call] guaranteed):
  %1: %I32 address = field.addr .value inspect %0
  %2: I32 trivial = load inspect %1
  return consume %2
}

fn nestedValue(box: Boxed(Boxed(I32)) [shared call]) -> I32 {
bb0(%0: Boxed(Boxed(I32)) [shared call] guaranteed):
  %1: %Boxed(I32) address = field.addr .value inspect %0
  %2: %I32 address = field.addr .value inspect %1
  %3: I32 trivial = load inspect %2
  return consume %3
}

fn pairSum(pair: Pair(I32, I32) [shared call]) -> I32 {
bb0(%0: Pair(I32, I32) [shared call] guaranteed):
  %1: %I32 address = field.addr .left inspect %0
  %2: I32 trivial = load inspect %1
  %3: %I32 address = field.addr .right inspect %0
  %4: I32 trivial = load inspect %3
  %5: I32 trivial = add inspect %2 inspect %4
  return consume %5
}

fn main() -> I32 {
bb0:
  %1: %I32 address = alloc frame I32
  %2: %Bool address = alloc frame Bool
  %3: %I32 address = alloc frame I32
  %4: %I32 address = alloc frame I32
  %5: %I32 address = alloc frame I32
