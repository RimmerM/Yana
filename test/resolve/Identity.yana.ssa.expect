  %7: I32 trivial = const 1
  %8: I32 trivial = call id(I32) consume %7
  store inspect %1 consume %8
  %9: Bool trivial = const True
  %10: Bool trivial = call also(Bool) consume %9
  store inspect %2 consume %10
  %11: I32 trivial = const 20
  %12: Boxed(I32) trivial = call rewrap(I32) consume %11
  %13: I32 trivial = call boxedValue borrow %12
  store inspect %3 consume %13
  %14: I32 trivial = const 300
  %15: Boxed(Boxed(I32)) trivial = call twice(I32) consume %14
  %16: I32 trivial = call nestedValue borrow %15
  store inspect %4 consume %16
  %17: I32 trivial = const 4000
  %18: I32 trivial = const 50000
  %19: Pair(I32, I32) trivial = call swapped(I32, I32) consume %17 consume %18
  %20: I32 trivial = call pairSum borrow %19
  store inspect %5 consume %20
  %21: Bool trivial = load inspect %2
  branch inspect %21 -> bb3 -> bb1

bb1:
  %22: I32 trivial = const 0
  jump -> bb2(consume %22)

bb2(%0: I32 trivial):
  store inspect %6 consume %0
  %23: I32 trivial = load inspect %1
  %24: I32 trivial = load inspect %6
  %25: I32 trivial = add inspect %23 inspect %24
  %26: I32 trivial = load inspect %3
  %27: I32 trivial = add inspect %25 inspect %26
  %28: I32 trivial = load inspect %4
  %29: I32 trivial = add inspect %27 inspect %28
  %30: I32 trivial = load inspect %5
  %31: I32 trivial = add inspect %29 inspect %30
  return consume %31

bb3:
  %32: I32 trivial = const 2
  jump -> bb2(consume %32)
}

fn id(I32)(x: I32) -> I32 {
bb0(%0: I32 trivial):
  %1: %I32 address = alloc frame I32
