module ResolveTest

let & counter: I32 = 0

fn opaque(n: I32 [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (global counter)
  %1: I32 = read copy.trivial (n)
  %2: I32 = add inspect %0 inspect %1
  write.assign borrow.unique (global counter) take %2
  %4: I32 = read copy.trivial (global counter)
  %5: I32 = const 1000
  %6: Bool = gt inspect %4 inspect %5
  branch inspect %6 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %11: I32 = read copy.trivial (n)
  return take %11

bb3:
  %8: I32 = const 1
  return take %8
}

fn shifts(a: Vec(I32) [shared call], n: I32 [shared call]) -> I32 {
  local count: Vec(I32)
  local left: Vec(I32)
  local right: Vec(I32)
  local arith: Vec(I32)

bb0:
  %0: I32 = read copy.trivial (n)
  %1: Vec(I32) = vec.splat inspect %0
  write.init borrow.unique (count) take %1
  %3: Vec(I32) = read copy.trivial (a)
  %4: Vec(I32) = read copy.trivial (count)
  %5: Vec(I32) = shl inspect %3 inspect %4
  write.init borrow.unique (left) take %5
  %7: Vec(I32) = read copy.trivial (a)
  %8: Vec(I32) = read copy.trivial (count)
  %9: Vec(I32) = shr inspect %7 inspect %8
  write.init borrow.unique (right) take %9
  %11: Vec(I32) = read copy.trivial (a)
  %12: Vec(I32) = read copy.trivial (count)
  %13: Vec(I32) = sar inspect %11 inspect %12
  write.init borrow.unique (arith) take %13
  %15: Vec(I32) = read copy.trivial (left)
  %16: I32 = const 0
  %17: I32 = vec.lane #0 inspect %15
  %18: Vec(I32) = read copy.trivial (right)
  %19: I32 = const 1
  %20: I32 = vec.lane #1 inspect %18
  %21: I32 = add inspect %17 inspect %20
  %22: Vec(I32) = read copy.trivial (arith)
  %23: I32 = const 2
  %24: I32 = vec.lane #2 inspect %22
  %25: I32 = add inspect %21 inspect %24
  return take %25
}

fn quad(b: Vec(I64) [shared call], n: I64 [shared call]) -> I64 {
  local up: Vec(I64)
  local down: Vec(I64)
  local signed: Vec(I64)

bb0:
  %0: Vec(I64) = read copy.trivial (b)
  %1: I64 = read copy.trivial (n)
  %2: Vec(I64) = vec.splat inspect %1
  %3: Vec(I64) = shl inspect %0 inspect %2
  write.init borrow.unique (up) take %3
  %5: Vec(I64) = read copy.trivial (up)
  %6: I64 = read copy.trivial (n)
  %7: I64 = const 1
  %8: I64 = sub inspect %6 inspect %7
  %9: Vec(I64) = vec.splat inspect %8
  %10: Vec(I64) = shr inspect %5 inspect %9
  write.init borrow.unique (down) take %10
  %12: Vec(I64) = read copy.trivial (b)
  %13: I64 = const 0
  %14: I64 = const 0
  %15: Vec(I64) = vec.splat inspect %14
  %16: Vec(I64) = sub inspect %15 inspect %12
  %17: I64 = read copy.trivial (n)
  %18: Vec(I64) = vec.splat inspect %17
  %19: Vec(I64) = sar inspect %16 inspect %18
  write.init borrow.unique (signed) take %19
  %21: Vec(I64) = read copy.trivial (down)
  %22: I32 = const 0
  %23: I64 = vec.lane #0 inspect %21
  %24: Vec(I64) = read copy.trivial (signed)
  %25: I32 = const 0
  %26: I64 = vec.lane #0 inspect %24
  %27: I64 = add inspect %23 inspect %26
  return take %27
}

fn main() -> I32 {
  local a: Vec(I32)
  local b: Vec(I64)
  local n: I32
  local m: I64

bb0:
