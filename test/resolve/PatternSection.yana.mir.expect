module ResolveTest

fn ~=(lhs: I32 [shared call], rhs: I32 [shared call]) -> Bool {
bb0:
  %0: I32 = read copy.trivial (lhs)
  %1: I32 = read copy.trivial (rhs)
  %2: I32 = sub inspect %0 inspect %1
  %3: I32 = read copy.trivial (lhs)
  %4: I32 = read copy.trivial (rhs)
  %5: I32 = sub inspect %3 inspect %4
  %6: I32 = mul inspect %2 inspect %5
  %7: I32 = const 1
  %8: Bool = le inspect %6 inspect %7
  return take %8
}

fn sign(value: I32 [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (value)
  %1: I32 = const 0
  %2: Bool = gt inspect %0 inspect %1
  branch inspect %2 -> bb4 -> bb1

bb1:
  %5: I32 = read copy.trivial (value)
  %6: I32 = const 0
  %7: Bool = lt inspect %5 inspect %6
  branch inspect %7 -> bb5 -> bb2

bb2:
  %10: I32 = const 0
  jump -> bb3(take %10)

bb3(%11: I32):
  return take %11

bb4:
  %4: I32 = const 1
  jump -> bb3(take %4)

bb5:
  %9: I32 = const -1
  jump -> bb3(take %9)
}

fn near(value: I32 [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (value)
  %1: I32 = const 10
  %2: Bool = call ~= borrow.shared %0 borrow.shared %1
  branch inspect %2 -> bb4 -> bb1

bb1:
  %5: I32 = read copy.trivial (value)
  %6: I32 = const 100
  %7: Bool = ge inspect %5 inspect %6
  branch inspect %7 -> bb5 -> bb2

bb2:
  %10: I32 = const 0
  jump -> bb3(take %10)

bb3(%11: I32):
  return take %11

bb4:
  %4: I32 = const 1
  jump -> bb3(take %4)

bb5:
  %9: I32 = const 2
  jump -> bb3(take %9)
}

fn positivePayload(m: Maybe(I32) [shared call]) -> I32 {
bb0:
  %0: U8 = read copy.trivial (m.#)
  %1: U8 = const 1
  %2: Bool = eq inspect %0 inspect %1
  branch inspect %2 -> bb4 -> bb1

bb1:
  %9: U8 = read copy.trivial (m.#)
  %10: U8 = const 1
  %11: Bool = eq inspect %9 inspect %10
  branch inspect %11 -> bb6 -> bb2

bb2:
  %14: I32 = const 3
  jump -> bb3(take %14)

bb3(%15: I32):
  return take %15

bb4:
  %4: I32 = read copy.trivial (m.Just)
  %5: I32 = const 0
  %6: Bool = gt inspect %4 inspect %5
  branch inspect %6 -> bb5 -> bb1

bb5:
  %8: I32 = const 1
  jump -> bb3(take %8)

bb6:
  %13: I32 = const 2
  jump -> bb3(take %13)
}

fn main() -> I32 {
bb0:
  %0: I32 = const -5
  %1: I32 = call sign borrow.shared %0
  %2: I32 = const 100
  %3: I32 = mul inspect %1 inspect %2
  %4: I32 = const 0
  %5: I32 = call sign borrow.shared %4
  %6: I32 = const 10
  %7: I32 = mul inspect %5 inspect %6
  %8: I32 = add inspect %3 inspect %7
  %9: I32 = const 7
  %10: I32 = call sign borrow.shared %9
  %11: I32 = add inspect %8 inspect %10
  %12: I32 = const 11
  %13: I32 = call near borrow.shared %12
  %14: I32 = add inspect %11 inspect %13
  %15: I32 = const 300
  %16: I32 = call near borrow.shared %15
  %17: I32 = add inspect %14 inspect %16
  %18: I32 = const 50
  %19: I32 = call near borrow.shared %18
  %20: I32 = add inspect %17 inspect %19
  %21: I32 = const 4
  %22: Maybe(I32) = aggregate.Just take %21
  %23: I32 = call positivePayload borrow.shared %22
  %24: I32 = add inspect %20 inspect %23
  %25: I32 = const -4
  %26: Maybe(I32) = aggregate.Just take %25
  %27: I32 = call positivePayload borrow.shared %26
  %28: I32 = const 10
  %29: I32 = mul inspect %27 inspect %28
  %30: I32 = add inspect %24 inspect %29
  %31: Maybe(I32) = aggregate.Nothing
  %32: I32 = call positivePayload borrow.shared %31
  %33: I32 = const 100
  %34: I32 = mul inspect %32 inspect %33
  %35: I32 = add inspect %30 inspect %34
  return take %35
}

entry main
