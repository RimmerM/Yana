mut @dropped = [0, 0, 0, 0]

Held.drop<complex>(%v_0: I32) {
  b_1 {
    %v_2 = loads @dropped, 4: I32
    %v_3 = add %v_2, %v_0: I32
    store @dropped, %v_3, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = loads @dropped, 4: I32
    %v_2 = add %v_1, 1: I32
    store @dropped, %v_2, 4
    %v_3 = alloca 8, 4: Ptr
    store %v_3, 1, 1
    %v_4 = add %v_3, 4: Ptr
    store %v_4, 2, 4
    call_complex teardown(Maybe(Held)), %v_3
    %v_5 = alloca 4, 4: Ptr
    store %v_5, 4, 4
    jmp b_6
  }

  b_7 {
    %v_8 = cmp_ilt %v_9, 1: I32
    je %v_8, b_6, b_10
  }

  b_10 {
    call_complex Held.drop, 8
    call_complex Held.drop, 16
    call_complex Held.drop, 32
    call_complex Held.drop, 64
    %v_11 = loads @dropped, 4: I32
    %v_12 = add %v_11, 128: I32
    store @dropped, %v_12, 4
    %v_13 = add %v_12, 128: I32
    store @dropped, %v_13, 4
    ret %v_13
  }

  b_6 {
    %v_14 = phi [b_7, %v_9], [b_0, 0]: I32
    %v_15 = sext %v_14: I64
    %v_16 = shl %v_15, 2: I64
    %v_17 = add %v_5, %v_16: Ptr
    %v_18 = load %v_17, 4: I32
    call_complex Held.drop, %v_18
    %v_9 = add %v_14, 1: I32
    jmp b_7
  }
}

teardown(Maybe(Held))<complex>(%v_0: Ptr) {
  b_1 {
    %v_2 = load %v_0, 1: I32
    %v_3 = cmp_eq %v_2, 1: I32
    je %v_3, b_4, b_5
  }

  b_6 {
    ret 
  }

  b_4 {
    %v_7 = add %v_0, 4: Ptr
    %v_8 = load %v_7, 4: I32
    call_complex Held.drop, %v_8
    jmp b_6
  }

  b_5 {
    jmp b_6
  }
}

