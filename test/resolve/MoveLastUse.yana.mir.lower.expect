mut @dropped = [0, 0, 0, 0]
mut @heapFree = [0, 0, 0, 0, 0, 0, 0, 0]

Held.drop<complex>(%self: Ptr) {
  b_0 {
    %v_1 = load %self, 4: I32
    %v_2 = loads @dropped, 4: I32
    %v_3 = add %v_2, %v_1: I32
    store @dropped, %v_3, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 8, 4: Ptr
    store %v_1, 1, 4
    %v_2 = add %v_1, 4: Ptr
    store %v_2, 0, 4
    call_complex Held.drop, %v_1
    %v_3 = alloca 8, 4: Ptr
    store %v_3, 1, 1
    %v_4 = add %v_3, 4: Ptr
    store %v_4, 2, 4
    call_complex teardown(Maybe(Held)), %v_3
    %v_5 = alloca 16, 8: Ptr
    %v_6 = alloca 4, 4: Ptr
    store %v_5, %v_6, 8
    %v_7 = add %v_5, 8: Ptr
    store %v_7, 1, 4
    %v_8 = add %v_5, 12: Ptr
    store %v_8, 1, 4
    store %v_6, 4, 4
    call_complex Array(a).reclaim(Held), %v_5
    %v_9 = alloca 4, 4: Ptr
    store %v_9, 8, 4
    call_complex Held.drop, %v_9
    store %v_9, 16, 4
    call_complex Held.drop, %v_9
    %v_10 = alloca 8, 4: Ptr
    store %v_10, 32, 4
    %v_11 = add %v_10, 4: Ptr
    store %v_11, 0, 4
    call_complex Held.drop, %v_10
    store %v_10, 64, 4
    call_complex Held.drop, %v_10
    %v_12 = alloca 8, 4: Ptr
    store %v_12, 128, 4
    %v_13 = add %v_12, 4: Ptr
    store %v_13, 0, 4
    call_complex Held.drop, %v_12
    %v_14 = alloca 4, 4: Ptr
    %v_15 = alloca 8, 4: Ptr
    store %v_14, 128, 4
    call_complex Held.drop, %v_14
    %v_16 = loads @dropped, 4: I32
    ret %v_16
  }
}

Array(a).reclaim(Held)<complex>(%value: Ptr) {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    %v_2 = load %value, 8: Ptr
    %v_3 = add %value, 8: Ptr
    %v_4 = load %v_3, 4: I64
    %v_5 = add %value, 12: Ptr
    %v_6 = load %v_5, 4: I32
    %v_7 = sext %v_6: I64
    jmp b_8
  }

  b_8 {
    %v_9 = phi [b_0, 0], [b_10, %v_11]: I64
    %v_12 = cmp_ilt %v_9, %v_7: I32
    je %v_12, b_10, b_13
  }

  b_13 {
    %v_14 = shr %v_4, 30: I64
    %v_15 = cast %v_14: I32
    %v_16 = cmp_eq %v_15, 1: I32
    je %v_16, b_17, b_18
  }

  b_10 {
    %v_19 = shl %v_9, 2: I64
    %v_20 = add %v_2, %v_19: Ptr
    copy %v_1, %v_20, 4
    call_complex Held.drop, %v_1
    %v_11 = add %v_9, 1: I64
    jmp b_8
  }

  b_17 {
    call_complex freeHeap, %v_2
    jmp b_18
  }

  b_18 {
    ret 
  }
}

freeHeap<complex>(%allocation: Ptr) {
  b_0 {
    %v_1 = bitcast %allocation: I64
    %v_2 = cmp_eq %v_1, 0: I32
    je %v_2, b_3, b_4
  }

  b_4 {
    %v_5 = sub %allocation, 8: Ptr
    %v_6 = loads %v_5, 8: I64
    %v_7 = load @heapFree, 8: Ptr
    %v_8 = shl %v_6, 3: I64
    %v_9 = add %v_7, %v_8: Ptr
    %v_10 = load %v_9, 8: Ptr
    store %allocation, %v_10, 8
    %v_11 = load @heapFree, 8: Ptr
    %v_12 = add %v_11, %v_8: Ptr
    store %v_12, %allocation, 8
    ret 
  }

  b_3 {
    ret 
  }
}

Run(a).reclaim(Held)<complex>(%value: Ptr) {
  b_0 {
    %v_1 = load %value, 8: Ptr
    %v_2 = add %value, 8: Ptr
    %v_3 = load %v_2, 4: I64
    %v_4 = shr %v_3, 30: I64
    %v_5 = cast %v_4: I32
    %v_6 = cmp_eq %v_5, 1: I32
    je %v_6, b_7, b_8
  }

  b_7 {
    call_complex freeHeap, %v_1
    jmp b_8
  }

  b_8 {
    ret 
  }
}

teardown(Maybe(Held))<complex>(%v_0: Ptr) {
  b_1 {
    %v_2 = load %v_0, 1: I32
    %v_3 = cmp_eq %v_2, 1: I32
    je %v_3, b_4, b_5
  }

  b_6 {
    ret 
  }

  b_4 {
    %v_7 = add %v_0, 4: Ptr
    call_complex Held.drop, %v_7
    jmp b_6
  }

  b_5 {
    jmp b_6
  }
}

