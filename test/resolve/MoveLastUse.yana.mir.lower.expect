mut @dropped = [0, 0, 0, 0]
mut @heapFree = [0, 0, 0, 0, 0, 0, 0, 0]

Held.drop<complex>(%v_0: I32) {
  b_1 {
    %v_2 = loads @dropped, 4: I32
    %v_3 = add %v_2, %v_0: I32
    store @dropped, %v_3, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    call_complex Held.drop, 1
    %v_1 = alloca 8, 4: Ptr
    store %v_1, 1, 1
    %v_2 = add %v_1, 4: Ptr
    store %v_2, 2, 4
    call_complex teardown(Maybe(Held)), %v_1
    %v_3 = alloca 4, 8: Ptr
    %v_4 = alloca 4, 4: Ptr
    %v_5 = bitcast %v_4: I64
    store %v_3, 1, 4
    store %v_4, 4, 4
    %v_6 = load %v_3, 4: I32
    call_complex Array(a).reclaim(Held), %v_5, %v_6, 1
    call_complex Held.drop, 8
    call_complex Held.drop, 16
    call_complex Held.drop, 32
    call_complex Held.drop, 64
    call_complex Held.drop, 128
    %v_7 = alloca 8, 4: Ptr
    call_complex Held.drop, 128
    %v_8 = loads @dropped, 4: I32
    ret %v_8
  }
}

Array(a).reclaim(Held)<complex>(%v_0: I64, %v_1: I32, %v_2: I32) {
  b_3 {
    %v_4 = cast %v_1: I64
    %v_5 = bitcast %v_0: Ptr
    %v_6 = sext %v_2: I64
    jmp b_7
  }

  b_7 {
    %v_8 = phi [b_3, 0], [b_9, %v_10]: I64
    %v_11 = cmp_ilt %v_8, %v_6: I32
    je %v_11, b_9, b_12
  }

  b_12 {
    %v_13 = shr %v_4, 30: I64
    %v_14 = cast %v_13: I32
    %v_15 = cmp_eq %v_14, 1: I32
    je %v_15, b_16, b_17
  }

  b_9 {
    %v_18 = shl %v_8, 2: I64
    %v_19 = add %v_5, %v_18: Ptr
    %v_20 = load %v_19, 4: I32
    call_complex Held.drop, %v_20
    %v_10 = add %v_8, 1: I64
    jmp b_7
  }

  b_16 {
    call_complex freeHeap, %v_5
    jmp b_17
  }

  b_17 {
    ret 
  }
}

freeHeap<complex>(%allocation: Ptr) {
  b_0 {
    %v_1 = bitcast %allocation: I64
    %v_2 = cmp_eq %v_1, 0: I32
    je %v_2, b_3, b_4
  }

  b_4 {
    %v_5 = sub %allocation, 8: Ptr
    %v_6 = loads %v_5, 8: I64
    %v_7 = load @heapFree, 8: Ptr
    %v_8 = shl %v_6, 3: I64
    %v_9 = add %v_7, %v_8: Ptr
    %v_10 = load %v_9, 8: Ptr
    store %allocation, %v_10, 8
    %v_11 = load @heapFree, 8: Ptr
    %v_12 = add %v_11, %v_8: Ptr
    store %v_12, %allocation, 8
    ret 
  }

  b_3 {
    ret 
  }
}

Run(a).reclaim(Held)<complex>(%v_0: I64, %v_1: I32) {
  b_2 {
    %v_3 = cast %v_1: I64
    %v_4 = shr %v_3, 30: I64
    %v_5 = cast %v_4: I32
    %v_6 = cmp_eq %v_5, 1: I32
    je %v_6, b_7, b_8
  }

  b_7 {
    %v_9 = bitcast %v_0: Ptr
    call_complex freeHeap, %v_9
    jmp b_8
  }

  b_8 {
    ret 
  }
}

teardown(Maybe(Held))<complex>(%v_0: Ptr) {
  b_1 {
    %v_2 = load %v_0, 1: I32
    %v_3 = cmp_eq %v_2, 1: I32
    je %v_3, b_4, b_5
  }

  b_6 {
    ret 
  }

  b_4 {
    %v_7 = add %v_0, 4: Ptr
    %v_8 = load %v_7, 4: I32
    call_complex Held.drop, %v_8
    jmp b_6
  }

  b_5 {
    jmp b_6
  }
}

