target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

module asm "\09.set \22image$base\22, 0"

@"image$base" = external constant [0 x i8], align 8

define fastcc i32 @floats() #0 {
  br label %1

1:                                                ; preds = %0
  br i1 false, label %2, label %3

2:                                                ; preds = %1
  ret i32 -1

3:                                                ; preds = %1
  br i1 false, label %4, label %5

4:                                                ; preds = %3
  ret i32 -2

5:                                                ; preds = %3
  br i1 false, label %6, label %7

6:                                                ; preds = %5
  ret i32 -3

7:                                                ; preds = %5
  br i1 false, label %8, label %9

8:                                                ; preds = %7
  ret i32 -4

9:                                                ; preds = %7
  ret i32 0
}

define fastcc i32 @indices() #0 {
  br label %1

1:                                                ; preds = %0
  br i1 false, label %2, label %3

2:                                                ; preds = %1
  ret i32 -1

3:                                                ; preds = %1
  br i1 false, label %4, label %5

4:                                                ; preds = %3
  ret i32 -2

5:                                                ; preds = %3
  br i1 false, label %6, label %7

6:                                                ; preds = %5
  ret i32 -3

7:                                                ; preds = %5
  ret i32 0
}

define fastcc i32 @main() #0 {
  br label %1

1:                                                ; preds = %0
  %2 = call fastcc i32 @floats()
  %3 = icmp ne i32 %2, 0
  %4 = zext i1 %3 to i32
  br i1 %3, label %5, label %8

5:                                                ; preds = %1
  %6 = call fastcc i32 @floats()
  %7 = mul i32 %6, 10
  ret i32 %7

8:                                                ; preds = %1
  %9 = call fastcc i32 @indices()
  %10 = icmp ne i32 %9, 0
  %11 = zext i1 %10 to i32
  br i1 %10, label %12, label %15

12:                                               ; preds = %8
  %13 = call fastcc i32 @indices()
  %14 = mul i32 %13, 100
  ret i32 %14

15:                                               ; preds = %8
  ret i32 7955
}

attributes #0 = { "probe-stack"="inline-asm" }
