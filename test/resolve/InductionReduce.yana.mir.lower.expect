    %v_1 = load %value, 8: Ptr
    %v_2 = add %value, 8: Ptr
    %v_3 = load %v_2, 4: I64
    %v_4 = shr %v_3, 30: I64
    %v_5 = cast %v_4: I32
    %v_6 = cmp_eq %v_5, 1: I32
    je %v_6, b_7, b_8
  }

  b_7 {
    call_complex freeHeap, %v_1
    jmp b_8
  }

  b_8 {
    ret 
  }
}

