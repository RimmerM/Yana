module ResolveTest

data Detail = NoTime | Minutes | Seconds | Millis

data Unit = Nanos = 0 | Millis = 1 | Seconds = 2 | Minutes = 3

data Wrapped {Wrapped: I32}

fn detailOf(d: Detail [shared call]) -> I32 {
bb0:
  %0: U8 = read copy.trivial (d.#)
  %1: U8 = const 0
  %2: Bool = eq inspect %0 inspect %1
  branch inspect %2 -> bb5 -> bb1

bb1:
  %5: U8 = read copy.trivial (d.#)
  %6: U8 = const 1
  %7: Bool = eq inspect %5 inspect %6
  branch inspect %7 -> bb6 -> bb2

bb2:
  %10: U8 = read copy.trivial (d.#)
  %11: U8 = const 2
  %12: Bool = eq inspect %10 inspect %11
  branch inspect %12 -> bb7 -> bb3

bb3:
  %15: I32 = const 3
  jump -> bb4(take %15)

bb4(%16: I32):
  return take %16

bb5:
  %4: I32 = const 0
  jump -> bb4(take %4)

bb6:
  %9: I32 = const 1
  jump -> bb4(take %9)

bb7:
  %14: I32 = const 2
  jump -> bb4(take %14)
}

fn unitOf(u: Unit [shared call]) -> I32 {
bb0:
  %0: U8 = read copy.trivial (u.#)
  %1: U8 = const 0
  %2: Bool = eq inspect %0 inspect %1
  branch inspect %2 -> bb5 -> bb1

bb1:
  %5: U8 = read copy.trivial (u.#)
  %6: U8 = const 1
  %7: Bool = eq inspect %5 inspect %6
  branch inspect %7 -> bb6 -> bb2

bb2:
  %10: U8 = read copy.trivial (u.#)
  %11: U8 = const 2
  %12: Bool = eq inspect %10 inspect %11
  branch inspect %12 -> bb7 -> bb3

bb3:
  %15: I32 = const 40
  jump -> bb4(take %15)

bb4(%16: I32):
  return take %16

bb5:
  %4: I32 = const 10
  jump -> bb4(take %4)

bb6:
  %9: I32 = const 20
  jump -> bb4(take %9)

bb7:
  %14: I32 = const 30
  jump -> bb4(take %14)
}

fn bare() -> I32 {
bb0:
  %0: Detail = const Millis
  %1: I32 = call detailOf borrow.shared %0
  %2: Detail = const Seconds
  %3: I32 = call detailOf borrow.shared %2
  %4: I32 = add inspect %1 inspect %3
  return take %4
}

fn qualifiedName() -> I32 {
bb0:
  %0: Unit = const Millis
  %1: I32 = call unitOf borrow.shared %0
  %2: Unit = const Seconds
  %3: I32 = call unitOf borrow.shared %2
  %4: I32 = add inspect %1 inspect %3
  return take %4
}

fn wrapped() -> I32 {
  local local0: Wrapped
  local v: I32

bb0:
  %0: I32 = const 7
  %1: Wrapped = aggregate.Wrapped take %0
  write.init borrow.unique (local0) take %1
  %3: I32 = read copy.trivial (local0.Wrapped)
  write.init borrow.unique (v) take %3
  %5: I32 = read copy.trivial (v)
  jump -> bb1(take %5)

bb1(%6: I32):
  return take %6
}

fn main() -> I32 {
bb0:
  %0: I32 = call bare
  %1: I32 = call qualifiedName
  %2: I32 = add inspect %0 inspect %1
  %3: I32 = call wrapped
  %4: I32 = add inspect %2 inspect %3
  return take %4
}

entry main
