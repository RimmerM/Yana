module ResolveTest

data Flags {read: Bool = True, write: Bool = False, level: I32 = 7}

data Window {title: I32, width: I32 = 80, height: I32 = 24}

data Report = Ok | Warn {code: I32 = 1} | Fail {code: I32 = 2}

fn bit(b: Bool [shared call]) -> I32 {
bb0:
  %0: Bool = read copy.trivial (b)
  branch inspect %0 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %5: I32 = const 0
  return take %5

bb3:
  %2: I32 = const 1
  return take %2
}

fn flags() -> I32 {
  local all: Flags
  local some: Flags
  local none: Flags

bb0:
  %0: Bool = const True
  %1: Bool = const False
  %2: I32 = const 7
  %3: Flags = aggregate.Flags take %0 take %1 take %2
  write.init borrow.unique (all) take %3
  %5: Bool = read copy.trivial (all.read)
  %6: I32 = call bit borrow.shared %5
  %7: I32 = const 1
  %8: Bool = ne inspect %6 inspect %7
  branch inspect %8 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %13: Bool = read copy.trivial (all.write)
  %14: I32 = call bit borrow.shared %13
  %15: I32 = const 0
  %16: Bool = ne inspect %14 inspect %15
  branch inspect %16 -> bb6 -> bb4

bb3:
  %10: I32 = const -1
  return take %10

bb4:
  jump -> bb5

bb5:
  %21: I32 = read copy.trivial (all.level)
  %22: I32 = const 7
  %23: Bool = ne inspect %21 inspect %22
  branch inspect %23 -> bb9 -> bb7

bb6:
  %18: I32 = const -2
  return take %18

bb7:
  jump -> bb8

bb8:
  %28: Bool = const True
  %29: I32 = const 3
  %30: Bool = const True
  %31: Flags = aggregate.Flags take %30 take %28 take %29
  write.init borrow.unique (some) take %31
  %33: Bool = read copy.trivial (some.read)
  %34: I32 = call bit borrow.shared %33
  %35: I32 = const 1
  %36: Bool = ne inspect %34 inspect %35
  branch inspect %36 -> bb12 -> bb10

bb9:
  %25: I32 = const -3
  return take %25

bb10:
  jump -> bb11

bb11:
  %41: Bool = read copy.trivial (some.write)
  %42: I32 = call bit borrow.shared %41
  %43: I32 = const 1
  %44: Bool = ne inspect %42 inspect %43
  branch inspect %44 -> bb15 -> bb13

bb12:
  %38: I32 = const -4
  return take %38

bb13:
  jump -> bb14

bb14:
  %49: I32 = read copy.trivial (some.level)
  %50: I32 = const 3
  %51: Bool = ne inspect %49 inspect %50
  branch inspect %51 -> bb18 -> bb16

bb15:
  %46: I32 = const -5
  return take %46

bb16:
  jump -> bb17

bb17:
  %56: Bool = const False
  %57: Bool = const True
  %58: I32 = const 9
  %59: Flags = aggregate.Flags take %56 take %57 take %58
  write.init borrow.unique (none) take %59
  %61: Bool = read copy.trivial (none.read)
  %62: I32 = call bit borrow.shared %61
  %63: I32 = const 0
  %64: Bool = ne inspect %62 inspect %63
  branch inspect %64 -> bb21 -> bb19

bb18:
  %53: I32 = const -6
  return take %53

bb19:
  jump -> bb20

bb20:
  %69: Bool = read copy.trivial (none.write)
  %70: I32 = call bit borrow.shared %69
  %71: I32 = const 1
  %72: Bool = ne inspect %70 inspect %71
  branch inspect %72 -> bb24 -> bb22

bb21:
  %66: I32 = const -7
  return take %66

bb22:
  jump -> bb23

bb23:
  %77: I32 = read copy.trivial (none.level)
  %78: I32 = const 9
  %79: Bool = ne inspect %77 inspect %78
  branch inspect %79 -> bb27 -> bb25

bb24:
  %74: I32 = const -8
  return take %74

bb25:
  jump -> bb26

bb26:
  %84: I32 = read copy.trivial (some.level)
  %85: I32 = const 10
  %86: I32 = mul inspect %84 inspect %85
  %87: I32 = read copy.trivial (all.level)
  %88: I32 = add inspect %86 inspect %87
  return take %88

bb27:
  %81: I32 = const -9
  return take %81
}

fn windows() -> I32 {
  local plain: Window
  local tall: Window

bb0:
  %0: I32 = const 1
  %1: I32 = const 80
  %2: I32 = const 24
  %3: Window = aggregate.Window take %0 take %1 take %2
  write.init borrow.unique (plain) take %3
  %5: I32 = read copy.trivial (plain.width)
  %6: I32 = const 80
  %7: Bool = ne inspect %5 inspect %6
  branch inspect %7 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %12: I32 = read copy.trivial (plain.height)
  %13: I32 = const 24
  %14: Bool = ne inspect %12 inspect %13
  branch inspect %14 -> bb6 -> bb4

bb3:
  %9: I32 = const -10
  return take %9

bb4:
  jump -> bb5

bb5:
  %19: I32 = const 2
  %20: I32 = const 50
  %21: I32 = const 80
  %22: Window = aggregate.Window take %19 take %21 take %20
  write.init borrow.unique (tall) take %22
  %24: I32 = read copy.trivial (tall.width)
  %25: I32 = const 80
  %26: Bool = ne inspect %24 inspect %25
  branch inspect %26 -> bb9 -> bb7

bb6:
  %16: I32 = const -11
  return take %16

bb7:
  jump -> bb8

bb8:
  %31: I32 = read copy.trivial (tall.height)
  %32: I32 = const 50
  %33: Bool = ne inspect %31 inspect %32
  branch inspect %33 -> bb12 -> bb10

bb9:
  %28: I32 = const -12
  return take %28

bb10:
  jump -> bb11

bb11:
  %38: I32 = read copy.trivial (plain.title)
  %39: I32 = const 100
  %40: I32 = mul inspect %38 inspect %39
  %41: I32 = read copy.trivial (tall.height)
  %42: I32 = add inspect %40 inspect %41
  return take %42

bb12:
  %35: I32 = const -13
  return take %35
}

fn value(r: Report [shared call]) -> I32 {
  local c: I32
  local c: I32

bb0:
  %0: U8 = read copy.trivial (r.#)
  %1: U8 = const 0
  %2: Bool = eq inspect %0 inspect %1
  branch inspect %2 -> bb4 -> bb1

bb1:
  %5: U8 = read copy.trivial (r.#)
  %6: U8 = const 1
  %7: Bool = eq inspect %5 inspect %6
  branch inspect %7 -> bb5 -> bb2

bb2:
  %12: I32 = read copy.trivial (r.code)
  write.init borrow.unique (c) take %12
  %14: I32 = read copy.trivial (c)
  %15: I32 = const 10
  %16: I32 = mul inspect %14 inspect %15
  jump -> bb3(take %16)

bb3(%17: I32):
  return take %17

bb4:
  %4: I32 = const -100
  jump -> bb3(take %4)

bb5:
  %9: I32 = read copy.trivial (r.code)
  write.init borrow.unique (c) take %9
  %11: I32 = read copy.trivial (c)
  jump -> bb3(take %11)
}

fn reports() -> I32 {
bb0:
  %0: I32 = const 1
  %1: Report = aggregate.Warn take %0
  %2: I32 = call value borrow.shared %1
  %3: I32 = const 9
  %4: Report = aggregate.Fail take %3
  %5: I32 = call value borrow.shared %4
  %6: I32 = add inspect %2 inspect %5
  return take %6
}

fn main() -> I32 {
bb0:
  %0: I32 = call flags
  %1: I32 = call windows
  %2: I32 = add inspect %0 inspect %1
  %3: I32 = call reports
  %4: I32 = add inspect %2 inspect %3
  return take %4
}

entry main
