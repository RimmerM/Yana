"use strict";
// ResolveTest
function choiceValue(choice) {
  var v12;
  if (choice.$tag === 0) {
    v12 = choice.$p;
  } else {
    v12 = choice.value + choice.extra | 0;
  }
  return v12;
}

function selectedPair(value) {
  var v15;
  if (value) {
    v15 = { x: 3, y: 4 };
  } else {
    v15 = { x: 0, y: 0 };
  }
  return v15;
}

function main() {
  var v31 = ((choiceValue({ $tag: 0, value: 0, extra: 0, $p: 4 }) + 5 | 0) + choiceValue({ $tag: 1, value: 2, extra: 3, $p: 0 }) | 0) + 19 | 0;
  var v33 = selectedPair(1);
  return (v31 + (v33.x + v33.y | 0) | 0) + 3 | 0;
}
main();
