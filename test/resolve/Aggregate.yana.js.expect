"use strict";
// ResolveTest
function choiceValue(choice) {
  var v12;
  if (choice.$tag === 0) {
    v12 = choice.$p;
  } else {
    v12 = choice.value + choice.extra | 0;
  }
  return v12;
}

function main() {
  return ((choiceValue({ $tag: 0, value: 0, extra: 0, $p: 4 }) + 5 | 0) + choiceValue({ $tag: 1, value: 2, extra: 3, $p: 0 }) | 0) + 29 | 0;
}
main();
