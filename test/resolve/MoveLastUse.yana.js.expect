"use strict";
var dropped = 0;

// Core
function Reclaim_Array_a_reclaim_Held(value) {
  var count = value.length;
  var i = 0;
  L0: for (;;) {
    if (i < count) {
      Drop_Held_drop(value[i]);
      i = i + 1 | 0;
      continue L0;
    }
    break L0;
  }
}

// ResolveTest
function branched(flag) {
  var v1 = 128;
  if (flag) {
    Drop_Held_drop({ left: v1, right: 0 }.left);
  } else {
