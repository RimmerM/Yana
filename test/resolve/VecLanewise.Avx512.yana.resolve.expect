let image$base: () = <none>

let &seed: I32 = 3

fn comparisons(%a: Vec(I32), %b: Vec(I32)) -> I32 {
  b0:
    %v2 = cmp_lt %a, %b : Mask(I32)
    %v3 = vreduce_and %v2 : Bool
    %v5 = xor %v3, True : Bool
    je %v5, b1, b2

  b1:
    ret -1

  b2:
    jmp b3

  b3:
    %v10 = cmp_le %a, %b : Mask(I32)
    %v11 = vreduce_and %v10 : Bool
    %v13 = xor %v11, True : Bool
    je %v13, b4, b5

  b4:
    ret -2

  b5:
    jmp b6

  b6:
    %v18 = cmp_gt %b, %a : Mask(I32)
    %v19 = vreduce_and %v18 : Bool
    %v21 = xor %v19, True : Bool
    je %v21, b7, b8

  b7:
    ret -3

  b8:
    jmp b9

  b9:
    %v26 = cmp_ge %b, %a : Mask(I32)
    %v27 = vreduce_and %v26 : Bool
    %v29 = xor %v27, True : Bool
    je %v29, b10, b11

  b10:
    ret -4

  b11:
    jmp b12

  b12:
    %v34 = cmp_ne %a, %b : Mask(I32)
    %v35 = vreduce_and %v34 : Bool
    %v37 = xor %v35, True : Bool
    je %v37, b13, b14

  b13:
    ret -5

  b14:
    jmp b15

  b15:
    %v42 = cmp_eq %a, %b : Mask(I32)
    %v43 = vreduce_or %v42 : Bool
    je %v43, b16, b17

  b16:
    ret -6

  b17:
    jmp b18

  b18:
    %v48 = cmp_gt %a, %b : Mask(I32)
    %v49 = vreduce_or %v48 : Bool
    %v51 = xor %v49, True : Bool
    %v53 = xor %v51, True : Bool
    je %v53, b19, b20

  b19:
    ret -7

  b20:
    jmp b21

  b21:
    ret 0
}

fn selection(%a: Vec(I32), %b: Vec(I32)) -> I32 {
  b0:
    %v2 = cmp_lt %a, %b : Mask(I32)
    %smaller = select %v2 ? %a : %b : Vec(I32)
    %v4 = cmp_lt %a, %b : Mask(I32)
    %larger = select %v4 ? %b : %a : Vec(I32)
    %v8 = vlane %smaller, 0 : I32
    %v11 = cmp_ne %v8, 3 : Bool
    je %v11, b1, b2

  b1:
    ret -1

  b2:
    jmp b3

  b3:
    %v18 = vlane %larger, 1 : I32
    %v21 = cmp_ne %v18, 4 : Bool
    je %v21, b4, b5

  b4:
    ret -2

  b5:
    jmp b6

  b6:
    ret 0
}

fn combining(%a: Vec(I32), %b: Vec(I32)) -> I32 {
  b0:
    %below = cmp_lt %a, %b : Mask(I32)
    %equal = cmp_eq %a, %b : Mask(I32)
    %v4 = or %below, %equal : Mask(I32)
    %v5 = vreduce_and %v4 : Bool
    %v7 = xor %v5, True : Bool
    je %v7, b1, b2

  b1:
    ret -1

  b2:
    jmp b3

  b3:
    %v12 = and %below, %equal : Mask(I32)
    %v13 = vreduce_or %v12 : Bool
    je %v13, b4, b5

  b4:
    ret -2

  b5:
    jmp b6

  b6:
    %v18 = xor %below, %equal : Mask(I32)
    %v19 = vreduce_and %v18 : Bool
    %v21 = xor %v19, True : Bool
    je %v21, b7, b8

  b7:
    ret -3

  b8:
    jmp b9

  b9:
    %v26 = not %equal : Mask(I32)
    %v27 = vreduce_and %v26 : Bool
    %v29 = xor %v27, True : Bool
    je %v29, b10, b11

  b10:
    ret -4

  b11:
    jmp b12

  b12:
    ret 0
}

fn counting() -> I32 {
  b0:
    %v1 = vsplat 0 : Vec(I32)
    %v3 = vwithlane %v1, 1, 1 : Vec(I32)
    %v5 = vwithlane %v3, 2, 2 : Vec(I32)
    %v7 = vwithlane %v5, 3, 3 : Vec(I32)
    %v9 = vwithlane %v7, 4, 4 : Vec(I32)
    %v11 = vwithlane %v9, 5, 5 : Vec(I32)
    %v13 = vwithlane %v11, 6, 6 : Vec(I32)
    %v15 = vwithlane %v13, 7, 7 : Vec(I32)
    %v17 = vwithlane %v15, 8, 8 : Vec(I32)
    %v19 = vwithlane %v17, 9, 9 : Vec(I32)
    %v21 = vwithlane %v19, 10, 10 : Vec(I32)
    %v23 = vwithlane %v21, 11, 11 : Vec(I32)
    %v25 = vwithlane %v23, 12, 12 : Vec(I32)
    %v27 = vwithlane %v25, 13, 13 : Vec(I32)
    %v29 = vwithlane %v27, 14, 14 : Vec(I32)
    %indices = vwithlane %v29, 15, 15 : Vec(I32)
    %v34 = vsplat 1 : Vec(I32)
    %past = cmp_ge %indices, %v34 : Mask(I32)
    %v36 = vreduce_add %past : I32
    %v40 = sub 16, 1 : I32
    %v41 = cmp_ne %v36, %v40 : Bool
    je %v41, b1, b2

  b1:
    ret -1

  b2:
    jmp b3

  b3:
    %v46 = vreduce_first %past : I32
    %v49 = cmp_ne %v46, 1 : Bool
    je %v49, b4, b5

  b4:
    ret -2

  b5:
    jmp b6

  b6:
    %empty = vsplat 0 : Vec(I32)
    %never = cmp_lt %indices, %empty : Mask(I32)
    %v57 = vreduce_first %never : I32
    %v59 = cmp_ne %v57, 16 : Bool
    je %v59, b7, b8

  b7:
    ret -3

  b8:
    jmp b9

  b9:
    %v64 = vreduce_add %never : I32
    %v67 = cmp_ne %v64, 0 : Bool
    je %v67, b10, b11

  b10:
    ret -4

  b11:
    jmp b12

  b12:
    %always = cmp_ge %indices, %empty : Mask(I32)
    %v73 = vreduce_first %always : I32
    %v76 = cmp_ne %v73, 0 : Bool
    je %v76, b13, b14

  b13:
    ret -5

  b14:
    jmp b15

  b15:
    %v81 = vreduce_add %always : I32
    %v83 = cmp_ne %v81, 16 : Bool
    je %v83, b16, b17

  b16:
    ret -6

  b17:
    jmp b18

  b18:
    ret 0
}

fn floats() -> I32 {
  b0:
    %a = vsplat 1.5 : Vec(F32)
    %b = vsplat 2.5 : Vec(F32)
    %v6 = cmp_lt %a, %b : Mask(F32)
    %v7 = vreduce_and %v6 : Bool
    %v9 = xor %v7, True : Bool
    je %v9, b1, b2

  b1:
    ret -1

  b2:
    jmp b3

  b3:
    %v14 = cmp_lt %a, %b : Mask(F32)
    %v15 = select %v14 ? %a : %b : Vec(F32)
    %v18 = vlane %v15, 0 : F32
    %v21 = cmp_ne %v18, 1.5 : Bool
    je %v21, b4, b5

  b4:
    ret -2

  b5:
    jmp b6

  b6:
    ret 0
}

fn main() -> I32 {
  b0:
    %v0 = load seed : I32
    %a = vsplat %v0 : Vec(I32)
    %v2 = load seed : I32
    %v5 = add %v2, 1 : I32
    %b = vsplat %v5 : Vec(I32)
    %v7 = call comparisons, %a, %b : I32
    %v10 = cmp_ne %v7, 0 : Bool
    je %v10, b1, b2

  b1:
    %v12 = call comparisons, %a, %b : I32
    ret %v12

  b2:
    jmp b3

  b3:
    %v15 = call selection, %a, %b : I32
    %v18 = cmp_ne %v15, 0 : Bool
    je %v18, b4, b5

  b4:
    %v20 = call selection, %a, %b : I32
    %v23 = mul %v20, 10 : I32
    ret %v23

  b5:
    jmp b6

  b6:
    %v26 = call combining, %a, %b : I32
    %v29 = cmp_ne %v26, 0 : Bool
    je %v29, b7, b8

  b7:
    %v31 = call combining, %a, %b : I32
    %v34 = mul %v31, 100 : I32
    ret %v34

  b8:
    jmp b9

  b9:
    %v37 = call counting : I32
    %v40 = cmp_ne %v37, 0 : Bool
    je %v40, b10, b11

  b10:
    %v42 = call counting : I32
    %v45 = mul %v42, 1000 : I32
    ret %v45

  b11:
    jmp b12

  b12:
    %v48 = call floats : I32
    %v51 = cmp_ne %v48, 0 : Bool
    je %v51, b13, b14

  b13:
    %v53 = call floats : I32
    %v56 = mul %v53, 10000 : I32
    ret %v56

  b14:
    jmp b15

  b15:
    ret 4839
}
