isPowerOf2(I32)<complex>(%value: I32): I32 {
  b_0 {
    %v_1 = cmp_neq %value, 0: I32
    je %v_1, b_2, b_3
  }

  b_3 {
    jmp b_4
  }

  b_4 {
    %v_5 = phi [b_3, 0], [b_2, %v_6]: I32
    ret %v_5
  }

  b_2 {
    %v_7 = sub %value, 1: I32
    %v_8 = and %value, %v_7: I32
    %v_6 = cmp_eq %v_8, 0: I32
    jmp b_4
  }
}

nextPowerOf2(I32)<complex>(%value: I32): I32 {
  b_0 {
    %v_1 = cmp_ile %value, 1: I32
    je %v_1, b_2, b_3
  }

  b_3 {
    %v_4 = sub %value, 1: I32
    %v_5 = clz_width %v_4: I32
    %v_6 = sub 32, %v_5: I32
    %v_7 = shl 1, %v_6: I32
    jmp b_8
  }

  b_8 {
    %v_9 = phi [b_3, %v_7], [b_2, 1]: I32
