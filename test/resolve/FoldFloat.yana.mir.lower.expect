
notANumber<complex>(): F64 {
  b_0 {
    %v_1 = div 0, 0: F64
    ret %v_1
  }
}

infinite<complex>(): F64 {
  b_0 {
    %v_1 = div 1, 0: F64
    ret %v_1
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = ftoi 1E30: I32
    %v_2 = cmp_eq %v_1, 2147483647: I32
    je %v_2, b_3, b_4
  }

  b_3 {
    %v_5 = ftoi -1E30: I32
    %v_6 = cmp_ilt %v_5, 18446744071562067969: I32
    je %v_6, b_7, b_4
  }

  b_4 {
    jmp b_8
  }

  b_7 {
    jmp b_8
  }

  b_8 {
    %v_9 = phi [b_4, 0], [b_7, 40]: I32
    %v_10 = add 60, %v_9: I32
    %v_11 = call_complex notANumber: F64
    %v_12 = ftoi %v_11: I32
    %v_13 = cmp_eq %v_12, 0: I32
    je %v_13, b_14, b_15
  }

  b_14 {
    %v_16 = call_complex infinite: F64
    %v_17 = ftoi %v_16: I32
    %v_18 = cmp_eq %v_17, 2147483647: I32
    je %v_18, b_19, b_15
  }

  b_15 {
    jmp b_20
  }

  b_19 {
    jmp b_20
  }

  b_20 {
    %v_21 = phi [b_15, 0], [b_19, 50]: I32
    %v_22 = add %v_10, %v_21: I32
    %v_23 = div 1, 0: F64
    %v_24 = cmp_gt %v_23, 1000000: I32
    %v_25 = select %v_24, 20, 0: I32
    %v_26 = add %v_22, %v_25: I32
    ret %v_26
  }
}

