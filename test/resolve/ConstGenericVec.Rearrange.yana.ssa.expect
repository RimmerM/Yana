bb0(%0: Vec(I32) trivial):
  %1: %Vec(I32) address = alloc frame Vec(I32) [shared call]
  store inspect %1 borrow %0
  %2: Vec(I32) trivial = load inspect %1
  %3: I32 trivial = const 0
  %4: I32 trivial = vec.lane #0 inspect %2
  %5: Vec(I32) trivial = load inspect %1
  %6: I32 trivial = const 1
  %7: I32 trivial = vec.lane #1 inspect %5
  %8: I32 trivial = const 2
  %9: I32 trivial = mul inspect %8 inspect %7
  %10: I32 trivial = add inspect %4 inspect %9
  %11: Vec(I32) trivial = load inspect %1
  %12: I32 trivial = const 2
  %13: I32 trivial = vec.lane #2 inspect %11
  %14: I32 trivial = const 3
  %15: I32 trivial = mul inspect %14 inspect %13
  %16: I32 trivial = add inspect %10 inspect %15
  %17: Vec(I32) trivial = load inspect %1
  %18: I32 trivial = const 3
  %19: I32 trivial = vec.lane #3 inspect %17
  %20: I32 trivial = const 4
  %21: I32 trivial = mul inspect %20 inspect %19
  %22: I32 trivial = add inspect %16 inspect %21
  return consume %22
}

