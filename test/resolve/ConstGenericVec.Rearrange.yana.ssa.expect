  %16: I32 trivial = const 2
  %17: I32 trivial = load inspect %6
  %18: Vec(I32) trivial = vec.withlane #2 inspect %15 inspect %17
  %19: I32 trivial = const 3
  %20: I32 trivial = load inspect %7
  %21: Vec(I32) trivial = vec.withlane #3 inspect %18 inspect %20
  return consume %21
}

fn rotated(v: Vec(I32, n) [shared call]) -> Vec(I32, n) = <no body>

