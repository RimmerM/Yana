  store inspect %7 borrow %3
  %8: %Vec(I32) address = global.addr sink
  %9: Vec(I32) trivial = load inspect %8
  %10: I32 trivial = const 0
  %11: I32 trivial = load inspect %4
  %12: Vec(I32) trivial = vec.withlane #0 inspect %9 inspect %11
  %13: I32 trivial = const 1
