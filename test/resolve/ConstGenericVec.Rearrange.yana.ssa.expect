module ResolveTest

let & sink: Vec(I32) = [0, 0, 0, 0]

fn four(a: I32 [shared call], b: I32 [shared call], c: I32 [shared call], d: I32 [shared call]) -> Vec(I32) {
bb0(%0: I32 trivial, %1: I32 trivial, %2: I32 trivial, %3: I32 trivial):
  %4: %I32 address = alloc frame I32 [shared call]
  %5: %I32 address = alloc frame I32 [shared call]
