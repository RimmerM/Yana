teardown(Maybe(Handle))<complex>(%v_0: Ptr) {
  b_1 {
    %v_2 = load %v_0, 1: I32
    %v_3 = cmp_eq %v_2, 1: I32
    je %v_3, b_4, b_5
  }

  b_6 {
    ret 
  }

  b_4 {
    %v_7 = add %v_0, 8: Ptr
    call_complex Handle.drop, %v_7
    jmp b_6
  }

  b_5 {
    jmp b_6
  }
}

