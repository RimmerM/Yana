mut @calls = [0, 0, 0, 0]

setViaBox<complex>(%into: Ptr): I32 {
  b_0 {
    store %into, 42, 8
    ret 1
  }
}

setViaArray<complex>(%into: Ptr): I32 {
  b_0 {
    %v_1 = add %into, 8: Ptr
    store %v_1, 7, 8
    ret 1
  }
}

setP<complex>(%b: Ptr, %p: Ptr) {
  b_0 {
    store %b, %p, 8
    ret 
  }
}

setViaCall<complex>(%into: Ptr): I32 {
  b_0 {
    %v_1 = alloca 12, 8: Ptr
    setpattern %v_1, 12, 0
    %v_2 = add %into, 8: Ptr
    call_complex setP, %v_1, %v_2
    %v_3 = load %v_1, 8: Ptr
    store %v_3, 66, 8
    ret 1
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 16, 8: Ptr
    %calls = global @calls: Ptr
    %v_2 = loads %calls, 4: I32
    %v_3 = add %v_2, 1: I32
    store %calls, %v_3, 4
    setpattern %v_1, 16, 0
    %v_4 = call_complex setViaBox, %v_1: I32
    %v_5 = cmp_ilt %v_4, 0: I32
    je %v_5, b_6, b_7
  }

  b_8 {
    jmp b_9
  }

  b_9 {
    %v_10 = phi [b_8, 0], [b_6, 1]: I32
    %v_11 = alloca 16, 8: Ptr
    %calls = global @calls: Ptr
    %v_12 = loads %calls, 4: I32
    %v_13 = add %v_12, 1: I32
    store %calls, %v_13, 4
    setpattern %v_11, 16, 0
    %v_14 = call_complex setViaArray, %v_11: I32
    %v_15 = cmp_ilt %v_14, 0: I32
    je %v_15, b_16, b_17
  }

  b_6 {
    jmp b_9
  }

  b_18 {
    jmp b_19
  }

  b_19 {
    %v_20 = phi [b_18, %v_10], [b_16, %v_21]: I32
    %v_22 = alloca 16, 8: Ptr
    %calls = global @calls: Ptr
    %v_23 = loads %calls, 4: I32
    %v_24 = add %v_23, 1: I32
    store %calls, %v_24, 4
    setpattern %v_22, 16, 0
    %v_25 = call_complex setViaBox, %v_22: I32
    %v_26 = loads %v_22, 8: I64
    %v_27 = cmp_neq %v_26, 42: I32
    %v_28 = add %v_20, 4: I32
    %v_29 = select %v_27, %v_28, %v_20: I32
    %v_30 = alloca 16, 8: Ptr
    %calls = global @calls: Ptr
    %v_31 = loads %calls, 4: I32
    %v_32 = add %v_31, 1: I32
    store %calls, %v_32, 4
    setpattern %v_30, 16, 0
    %v_33 = call_complex setViaCall, %v_30: I32
    %v_34 = cmp_ilt %v_33, 0: I32
    je %v_34, b_35, b_36
  }

  b_16 {
    %v_21 = add %v_10, 2: I32
    jmp b_19
  }

  b_37 {
    jmp b_38
  }

  b_38 {
    %v_39 = phi [b_37, %v_29], [b_35, %v_40]: I32
    %v_41 = loads @calls, 4: I32
    %v_42 = cmp_neq %v_41, 4: I32
    %v_43 = add %v_39, 16: I32
    %v_44 = select %v_42, %v_43, %v_39: I32
    ret %v_44
  }

  b_35 {
    %v_40 = add %v_29, 8: I32
    jmp b_38
  }

  b_7 {
    %v_45 = loads %v_1, 8: I64
    %v_46 = cmp_neq %v_45, 42: I32
    je %v_46, b_6, b_8
  }

  b_17 {
    %v_47 = add %v_11, 8: Ptr
    %v_48 = loads %v_47, 8: I64
    %v_49 = cmp_neq %v_48, 7: I32
    je %v_49, b_16, b_18
  }

  b_36 {
    %v_50 = add %v_30, 8: Ptr
    %v_51 = loads %v_50, 8: I64
    %v_52 = cmp_neq %v_51, 66: I32
    je %v_52, b_35, b_37
  }
}

