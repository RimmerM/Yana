    %v10 = mul 8, %v9 : Size
    %v11 = sub %allocation, %v10 : %U8
    %v12 = bitcast %v11 : %Size
    %sizeClass = load [%v12] : Size
    %v14 = bitcast %allocation : %%U8
    %v15 = call freeListHead, %sizeClass : %U8
