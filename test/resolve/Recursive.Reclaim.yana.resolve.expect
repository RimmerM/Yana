fn main() -> I32 {
  b0:
    %warm = call buildAndDrop : I32
    %settled = load heapNext : %U8
    %again = call buildAndDrop : I32
    %v3 = load heapNext : %U8
    %v4 = cmp_eq %v3, %settled : Bool
    %v6 = xor %v4, True : Bool
