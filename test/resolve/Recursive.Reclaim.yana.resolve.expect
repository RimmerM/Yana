let image$base: () = <none>

let &heapNext: %U8 = 0

let &heapLimit: %U8 = 0

let &heapFree: %%U8 = 0

let &heapRegionNext: I64 = 0

fn initHeap() -> () {
  b0:
    %region = call mapMemory, 4194304 : %U8
    %v2 = bitcast %region : Long
    %v4 = cmp_eq %v2, 0 : Bool
    je %v4, b1, b2

  b1:
    ret

  b2:
    jmp b3

  b3:
    %table = mul 32, 8 : I64
    setmemory %region, 0, %table
    %v14 = bitcast %region : %%U8
    assign heapFree, %v14
    %v16 = strideof U8 : I64
    %v17 = mul %table, %v16 : I64
    %v18 = add %region, %v17 : %U8
    assign heapNext, %v18
    %v21 = strideof U8 : I64
    %v22 = mul 4194304, %v21 : I64
    %v23 = add %region, %v22 : %U8
    assign heapLimit, %v23
    %v27 = add 4194304, 4194304 : I64
    assign heapRegionNext, %v27
    ret
}

fn growHeap(%needed: I64) -> Bool {
  b0:
    %v1 = load heapRegionNext : I64
    %size = alloc : I64
    init %size, %v1
    %v4 = load %size : I64
    %v5 = cmp_lt %v4, %needed : Bool
    je %v5, b1, b2

  b1:
    assign %size, %needed
    jmp b3

  b2:
    jmp b3

  b3:
    %v10 = load %size : I64
    %v11 = call mapMemory, %v10 : %U8
    %region = alloc : %U8
    init %region, %v11
    %v14 = load %region : %U8
    %v15 = bitcast %v14 : Long
    %v17 = cmp_eq %v15, 0 : Bool
    je %v17, b4, b5

  b4:
    %v20 = cmp_gt %needed, 4194304 : Bool
    je %v20, b6, b7

  b5:
    jmp b15

  b6:
    jmp b8

  b7:
    jmp b8

  b8:
    %least = phi [b6, %needed], [b7, 4194304] : I64
    %v26 = load %size : I64
    %v27 = cmp_ge %least, %v26 : Bool
    je %v27, b9, b10

  b9:
    ret False

  b10:
    jmp b11

  b11:
    assign %size, %least
    %v33 = load %size : I64
    %v34 = call mapMemory, %v33 : %U8
    assign %region, %v34
    %v36 = load %region : %U8
    %v37 = bitcast %v36 : Long
    %v39 = cmp_eq %v37, 0 : Bool
    je %v39, b12, b13

  b12:
    ret False

  b13:
    jmp b14

  b14:
    jmp b15

  b15:
    %v46 = load %region : %U8
    assign heapNext, %v46
    %v48 = load %region : %U8
    %v49 = load %size : I64
    %v50 = strideof U8 : I64
    %v51 = mul %v49, %v50 : I64
    %v52 = add %v48, %v51 : %U8
    assign heapLimit, %v52
    %v54 = load %size : I64
    %v55 = load %size : I64
    %v56 = add %v54, %v55 : I64
    assign heapRegionNext, %v56
    ret True
}

fn heapClassOf(%total: I64) -> I64 {
  b0:
    %size = alloc : I64
    init %size, 16
    %sizeClass = alloc : I64
    init %sizeClass, 0
    jmp b1

  b1:
    %v8 = load %size : I64
    %v9 = cmp_lt %v8, %total : Bool
    je %v9, b3, b2

  b2:
    %v21 = load %sizeClass : I64
    ret %v21

  b3:
    %v11 = load %size : I64
    %v12 = load %size : I64
    %v13 = add %v11, %v12 : I64
    assign %size, %v13
    %v15 = load %sizeClass : I64
    %v18 = add %v15, 1 : I64
    assign %sizeClass, %v18
    jmp b1
}

fn heapBlockSize(%sizeClass: I64) -> I64 {
  b0:
    %v2 = shl 16, %sizeClass : I64
    ret %v2
}

fn freeListHead(%sizeClass: I64) -> %U8 {
  b0:
    %v1 = load heapFree : %%U8
    %v2 = strideof %U8 : I64
    %v3 = mul %sizeClass, %v2 : I64
    %v4 = add %v1, %v3 : %%U8
    %v5 = load [%v4] : %U8
    ret %v5
}

fn setFreeListHead(%sizeClass: I64, %block: %U8) -> () {
  b0:
    %v2 = load heapFree : %%U8
    %v3 = strideof %U8 : I64
    %v4 = mul %sizeClass, %v3 : I64
    %v5 = add %v2, %v4 : %%U8
    assign [%v5], %block
    ret
}

fn allocateHeap(%size: I64) -> %U8 {
  b0:
    %v1 = load heapFree : %%U8
    %v2 = bitcast %v1 : Long
    %v4 = cmp_eq %v2, 0 : Bool
    je %v4, b1, b2

  b1:
    call initHeap
    %v7 = load heapFree : %%U8
    %v8 = bitcast %v7 : Long
    %v10 = cmp_eq %v8, 0 : Bool
    je %v10, b3, b4

  b2:
    jmp b6

  b3:
    %v13 = bitcast 0 : %U8
    ret %v13

  b4:
    jmp b5

  b5:
    jmp b6

  b6:
    %v20 = add %size, 8 : I64
    %sizeClass = call heapClassOf, %v20 : I64
    %v23 = cmp_ge %sizeClass, 32 : Bool
    je %v23, b7, b8

  b7:
    %v26 = bitcast 0 : %U8
    ret %v26

  b8:
    jmp b9

  b9:
    %reused = call freeListHead, %sizeClass : %U8
    %v30 = bitcast %reused : Long
    %v32 = cmp_eq %v30, 0 : Bool
    %v34 = xor %v32, True : Bool
    je %v34, b10, b11

  b10:
    %v36 = bitcast %reused : %%U8
    %v37 = load [%v36] : %U8
    call setFreeListHead, %sizeClass, %v37
    ret %reused

  b11:
    jmp b12

  b12:
    %blockSize = call heapBlockSize, %sizeClass : I64
    %v42 = load heapNext : %U8
    %v43 = strideof U8 : I64
    %v44 = mul %blockSize, %v43 : I64
    %v45 = add %v42, %v44 : %U8
    %v46 = load heapLimit : %U8
    %v47 = cmp_gt %v45, %v46 : Bool
    je %v47, b13, b14

  b13:
    %v49 = call growHeap, %blockSize : Bool
    %v51 = xor %v49, True : Bool
    je %v51, b15, b16

  b14:
    jmp b18

  b15:
    %v54 = bitcast 0 : %U8
    ret %v54

  b16:
    jmp b17

  b17:
    jmp b18

  b18:
    %block = load heapNext : %U8
    %v60 = strideof U8 : I64
    %v61 = mul %blockSize, %v60 : I64
    %v62 = add %block, %v61 : %U8
    assign heapNext, %v62
    %v64 = bitcast %block : %I64
    assign [%v64], %sizeClass
    %v68 = strideof U8 : I64
    %v69 = mul 8, %v68 : I64
    %v70 = add %block, %v69 : %U8
    ret %v70
}

fn freeHeap(%allocation: %U8) -> () {
  b0:
    %v1 = bitcast %allocation : Long
    %v3 = cmp_eq %v1, 0 : Bool
    je %v3, b1, b2

  b1:
    ret

  b2:
    jmp b3

  b3:
    %v9 = strideof U8 : I64
    %v10 = mul 8, %v9 : I64
    %v11 = sub %allocation, %v10 : %U8
    %v12 = bitcast %v11 : %I64
    %sizeClass = load [%v12] : I64
    %v14 = bitcast %allocation : %%U8
    %v15 = call freeListHead, %sizeClass : %U8
    assign [%v14], %v15
    call setFreeListHead, %sizeClass, %allocation
    ret
}

fn mapMemory(%size: I64) -> %U8 {
  b0:
    %v7 = neg 1 : I64
    %result = syscall 9, 0, %size, 3, 34, %v7, 0 : I64
    %v12 = cmp_lt %result, 0 : Bool
    je %v12, b1, b2

  b1:
    %v15 = bitcast 0 : %U8
    ret %v15

  b2:
    jmp b3

  b3:
    %v18 = bitcast %result : %U8
    ret %v18
}

fn sum(%xs: List) -> Int {
  b0:
    %v1 = load %xs.discriminant : Int
    %v3 = cmp_eq %v1, 0 : Bool
    je %v3, b2, b1

  b1:
    %c = load %xs@Cons : {head: Int, tail: @box List}
    %v7 = load %xs@Cons.head : Int
    %v8 = load %xs@Cons.tail.* : List
    %v9 = call sum, %v8 : Int
    %v10 = add %v7, %v9 : Int
    jmp b3

  b2:
    jmp b3

  b3:
    %v13 = phi [b2, 0], [b1, %v10] : Int
    ret %v13
}

fn buildAndDrop() -> Int {
  b0:
    %xs = alloc : List
    %v3 = alloc : List
    %v6 = alloc : List
    %v9 = alloc : List
    init %local3.discriminant, 0
    init %local2.discriminant, 1
    init %local2@Cons.head, 39
    %v14 = alloc heap escaping : List
    %v15 = addressof %local4 : %List
    init %local2@Cons.tail, %v15
    init %local2@Cons.tail.*, %v9
    init %local1.discriminant, 1
    init %local1@Cons.head, 2
    %v20 = alloc heap escaping : List
    %v21 = addressof %local5 : %List
    init %local1@Cons.tail, %v21
    init %local1@Cons.tail.*, %v6
    init %local0.discriminant, 1
    init %local0@Cons.head, 1
    %v26 = alloc heap escaping : List
    %v27 = addressof %local6 : %List
    init %local0@Cons.tail, %v27
    init %local0@Cons.tail.*, %v3
    %v30 = call sum, %xs : Int
    drop_derived %local0 reclaim reclaim$List
    ret %v30
}

fn main() -> Int {
  b0:
    %warm = call buildAndDrop : Int
    %settled = load heapNext : %U8
    %again = call buildAndDrop : Int
    %v3 = load heapNext : %U8
    %v4 = cmp_eq %v3, %settled : Bool
    %v6 = xor %v4, True : Bool
    je %v6, b1, b2

  b1:
    %v10 = neg 1 : Int
    ret %v10

  b2:
    jmp b3

  b3:
    %v13 = cmp_ne %again, %warm : Bool
    je %v13, b4, b5

  b4:
    %v17 = neg 2 : Int
    ret %v17

  b5:
    jmp b6

  b6:
    ret %again
}

fn reclaim$List(%value: List) -> () {
  b0:
    %v1 = load %value.discriminant : Int
    %v3 = cmp_eq %v1, 1 : Bool
    je %v3, b2, b3

  b1:
    ret

  b2:
    drop_derived %value@Cons.tail.* reclaim reclaim$List release
    jmp b1

  b3:
    jmp b1
}
