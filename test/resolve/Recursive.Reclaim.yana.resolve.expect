fn sum(%xs: List) -> I32 {
  b0:
    %v1 = load %xs.discriminant : I32
    %v3 = cmp_eq %v1, 0 : Bool
    je %v3, b2, b1

  b1:
    %c = load %xs@Cons : {head: I32, tail: @box List}
    %v7 = load %xs@Cons.head : I32
    %v8 = load %xs@Cons.tail.* : List
    %v9 = call sum, %v8 : I32
    %v10 = add %v7, %v9 : I32
    jmp b3

  b2:
    jmp b3

  b3:
    %v13 = phi [b2, 0], [b1, %v10] : I32
    ret %v13
