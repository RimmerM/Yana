  b2:
    jmp b3

  b3:
    %v10 = load %size : Size
    %v12 = add %v10, 4096 : Size
    %v13 = call mapMemory, %v12 : %U8
    %region = alloc : %U8
    init %region, %v13
    %v16 = load %region : %U8
    %v17 = bitcast %v16 : I64
    %v19 = cmp_eq %v17, 0 : Bool
    je %v19, b4, b5

  b4:
    %v22 = cmp_gt %needed, 4194304 : Bool
    je %v22, b6, b7

  b5:
    jmp b15

  b6:
    jmp b8

  b7:
    jmp b8

  b8:
    %least = phi [b6, %needed], [b7, 4194304] : Size
    %v28 = load %size : Size
    %v29 = cmp_ge %least, %v28 : Bool
    je %v29, b9, b10

  b9:
    ret False

  b10:
    jmp b11

  b11:
    assign %size, %least
    %v35 = load %size : Size
    %v37 = add %v35, 4096 : Size
    %v38 = call mapMemory, %v37 : %U8
    assign %region, %v38
    %v40 = load %region : %U8
    %v41 = bitcast %v40 : I64
    %v43 = cmp_eq %v41, 0 : Bool
    je %v43, b12, b13

  b12:
    ret False

  b13:
    jmp b14

  b14:
    jmp b15

  b15:
    %v50 = load %region : %U8
    assign heapNext, %v50
    %v52 = load %region : %U8
    %v53 = load %size : Size
    %v54 = strideof U8 : Size
