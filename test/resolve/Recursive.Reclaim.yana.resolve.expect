fn heapClassOf(%total: Size) -> Size {
  b0:
    %size = alloc : Size
    init %size, 16
    %sizeClass = alloc : Size
    init %sizeClass, 0
    jmp b1

  b1:
    %v8 = load %size : Size
    %v9 = cmp_lt %v8, %total : Bool
    je %v9, b3, b2

