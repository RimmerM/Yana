    %anonymous = bitcast -1 : USize
    %v4 = call numberOf, SysMunmap : USize
    %v6 = bitcast %size : USize
    %result = syscall %v4, 0, %v6, 3, 34, %anonymous, 0 : Size
    %v13 = cmp_lt %result, 0 : Bool
    je %v13, b1, b2

  b1:
    %v16 = bitcast 0 : %U8
    ret %v16

  b2:
    jmp b3

  b3:
    %v19 = bitcast %result : %U8
