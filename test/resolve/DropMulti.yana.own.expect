}

fn Drop(Buffer).drop {
  arg value readonly
  %value: Buffer borrowed droppable readonly live [0, 2)
}

fn drop$Slot {
  arg value readonly
  %value: Slot borrowed droppable readonly live [0, 3) [4, 5) [6, 11)
}
