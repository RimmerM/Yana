fn allocateHeap {
  arg size readonly
  result escapes
}

fn freeHeap {
  arg allocation readonly
}

fn mapMemory {
  arg size readonly
}

fn makeBuffer {
  arg size readonly
  result escapes
  %local0: Buffer droppable readonly live [3, 7)
}

fn touch {
  arg it readonly
  %it: Slot borrowed droppable readonly live never
}

fn holdsTwo {
  %local0: Slot droppable readonly live [0, 1) [3, 6)
  %local1: Buffer droppable readonly live [1, 4)
  %local2: Buffer droppable readonly live [2, 4)
}

fn holdsOne {
  %local0: Slot droppable readonly live [0, 1) [2, 5)
  %local1: Buffer droppable readonly live [1, 3)
}

fn holdsNothing {
  %local0: Slot droppable readonly live [0, 4)
}

