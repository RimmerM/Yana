}

fn heapClassOf {
  arg total readonly
  %size: I64 writable live [0, 8) [10, 18)
  %sizeClass: I64 writable live [2, 9) [10, 18)
}

fn heapBlockSize {
  arg sizeClass readonly
}

fn freeListHead {
  arg sizeClass readonly
  result escapes
}

fn setFreeListHead {
  arg sizeClass readonly
  arg block readonly
