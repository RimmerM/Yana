    store %v_1, 0, 8
    %v_2 = load %v_1, 8: Ptr
    %v_3 = call_complex funvalue(double), %v_2, 10: I32
    store %v_1, 0, 8
    %v_4 = load %v_1, 8: Ptr
    %v_5 = call_complex funvalue(triple), %v_4, 10: I32
    store %v_1, 0, 8
    %v_6 = load %v_1, 8: Ptr
    %v_7 = call_complex funvalue(negate), %v_6, 10: I32
    %v_8 = shl %v_7, 2: I32
    %v_9 = add %v_3, %v_5: I32
    %v_10 = add %v_9, %v_8: I32
    ret %v_10
  }
}

funvalue(double)<complex>(%v_0: Ptr, %v_1: I32): I32 {
