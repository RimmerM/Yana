@image$base = []

double<complex>(%x: I32): I32 {
  b_0 {
    %v_1 = shl %x, 1: I32
    ret %v_1
  }
}

triple<complex>(%x: I32): I32 {
  b_0 {
    %v_1 = imul %x, 3: I32
    ret %v_1
  }
}

negate<complex>(%x: I32): I32 {
  b_0 {
    %v_1 = sub 0, %x: I32
    ret %v_1
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 20, 8: Ptr
    %funvalue(double) = fun funvalue(double): Ptr
    %v_2 = add %v_1, 16: Ptr
    store %v_2, 1, 4
    store %v_1, %funvalue(double), 8
    %v_3 = add %v_1, 8: Ptr
    store %v_3, 0, 8
    %v_4 = load %v_3, 8: Ptr
    %v_5 = call_complex %funvalue(double), %v_4, 10: I32
    %v_6 = add %v_1, 16: Ptr
    %v_7 = loads %v_6, 4: I32
    %v_8 = imul %v_5, %v_7: I32
    %funvalue(triple) = fun funvalue(triple): Ptr
    call_complex teardown(fun), %v_1
    store %v_1, %funvalue(triple), 8
    %v_9 = add %v_1, 8: Ptr
    store %v_9, 0, 8
    %v_10 = load %v_9, 8: Ptr
    %v_11 = call_complex %funvalue(triple), %v_10, 10: I32
    %v_12 = loads %v_6, 4: I32
    %v_13 = imul %v_11, %v_12: I32
    %v_14 = add %v_1, 16: Ptr
    store %v_14, 4, 4
    %funvalue(negate) = fun funvalue(negate): Ptr
    call_complex teardown(fun), %v_1
    store %v_1, %funvalue(negate), 8
    %v_15 = add %v_1, 8: Ptr
    store %v_15, 0, 8
    %v_16 = load %v_15, 8: Ptr
    %v_17 = call_complex %funvalue(negate), %v_16, 10: I32
    %v_18 = loads %v_6, 4: I32
    call_complex teardown(fun), %v_1
    %v_19 = imul %v_17, %v_18: I32
    %v_20 = add %v_8, %v_13: I32
    %v_21 = add %v_20, %v_19: I32
    ret %v_21
  }
}

funvalue(double)<complex>(%v_0: Ptr, %v_1: I32): I32 {
  b_2 {
    %v_3 = call_complex double, %v_1: I32
    ret %v_3
  }
}

funvalue(triple)<complex>(%v_0: Ptr, %v_1: I32): I32 {
  b_2 {
    %v_3 = call_complex triple, %v_1: I32
    ret %v_3
  }
}

teardown(fun)<complex>(%v_0: Ptr) {
  b_1 {
    %v_2 = add %v_0, 8: Ptr
    %v_3 = load %v_2, 8: I64
    %v_4 = cmp_eq %v_3, 0: I32
    je %v_4, b_5, b_6
  }

  b_6 {
    %v_7 = load %v_0, 8: Ptr
    %v_8 = sub %v_7, 4: Ptr
    %v_9 = loads %v_8, 4: I32
    %v_10 = sext %v_9: I64
    %v_11 = cmp_eq %v_10, 0: I32
    je %v_11, b_5, b_12
  }

  b_12 {
    %v_13 = add %v_10, @image$base: Ptr
    %v_14 = bitcast %v_3: Ptr
    call_complex %v_13, %v_14
    jmp b_5
  }

  b_5 {
    ret 
  }
}

funvalue(negate)<complex>(%v_0: Ptr, %v_1: I32): I32 {
  b_2 {
    %v_3 = call_complex negate, %v_1: I32
    ret %v_3
  }
}

