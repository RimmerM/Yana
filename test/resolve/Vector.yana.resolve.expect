fn natural(%v: Vec(F32)) -> Vec(F32) {
  b0:
    ret %v
}

fn explicit(%v: Vec(F32)) -> Vec(F32) {
  b0:
    ret %v
}

fn half(%v: Vec(F32, 2)) -> Vec(F32, 2) {
  b0:
    ret %v
}

fn bytes(%v: Vec(U8)) -> Vec(U8) {
  b0:
    ret %v
}

fn maskFloat(%m: Mask(F32)) -> Mask(F32) {
  b0:
    ret %m
}

fn maskLanes(%m: Mask(I32)) -> Mask(I32) {
  b0:
    ret %m
}

fn refined(%v: Vec(@bits(30) U32)) -> Vec(@bits(30) U32) {
  b0:
    ret %v
}

fn second(%a: Vec(F32), %b: Vec(F32)) -> Vec(F32) {
  b0:
    ret %b
}

fn unwrap(%w: Wrapped) -> Vec(F32) {
  b0:
    %v1 = load %w@Wrapped.lanes : Vec(F32)
    ret %v1
}

fn tagOf(%w: Wrapped) -> I32 {
  b0:
    %v1 = load %w@Wrapped.tag : I32
    ret %v1
}
