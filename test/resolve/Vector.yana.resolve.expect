fn natural(%v: Vec(Float)) -> Vec(Float) {
  b0:
    ret %v
}

fn explicit(%v: Vec(Float)) -> Vec(Float) {
  b0:
    ret %v
}

fn half(%v: Vec(Float, 2)) -> Vec(Float, 2) {
  b0:
    ret %v
}

fn bytes(%v: Vec(U8)) -> Vec(U8) {
  b0:
    ret %v
}

fn maskFloat(%m: Mask(Float)) -> Mask(Float) {
  b0:
    ret %m
}

fn maskLanes(%m: Mask(I32)) -> Mask(I32) {
  b0:
    ret %m
}

fn refined(%v: Vec(@bits(30) U32)) -> Vec(@bits(30) U32) {
  b0:
    ret %v
}

fn second(%a: Vec(Float), %b: Vec(Float)) -> Vec(Float) {
  b0:
    ret %b
}

fn unwrap(%w: Wrapped) -> Vec(Float) {
  b0:
    %v1 = load %w@Wrapped.lanes : Vec(Float)
    ret %v1
}

fn tagOf(%w: Wrapped) -> Int {
  b0:
    %v1 = load %w@Wrapped.tag : Int
    ret %v1
}
