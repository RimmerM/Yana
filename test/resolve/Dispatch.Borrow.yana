-- A generic dispatch that reaches a class function declared `&self`.
--
-- The one call form whose arguments do not go through prepareArguments: the callee is not a
-- function this call site reaches, so lowering adapts each argument to the erased ABI itself and a
-- caller-side borrow would sit in front of that adaptation. What the call site *does* share with
-- every other form is substituteArguments - the parameter read at the types the call bound, the
-- conversion, and the positional rule.
--
-- `getMut(xs, at)` is the case: `Index.getMut` declares `return &self: c`, and `c` here is this
-- function's own type variable, so the instance cannot be chosen until `bump` is instantiated.
-- Nothing else in the corpus reaches a `&` parameter this way, which is why this exists.
fn (Index(c, k, v), Num(v), FromInt(v)) bump(&xs: c, at: k) -> Int:
    let &slot = getMut(xs, at)
    slot = slot + 1
    return 0

fn main() -> Int:
    let &xs = [5, 6, 7]
    let ignored = bump(xs, 0)

    -- 6 + 6: the bump wrote through the borrow the dispatch handed over, so element 0 is now 6.
    return xs[0] + xs[1]
