bb6:
  %17: I32 = read copy.trivial ($yielded)
  %18: I32 = const 0
  %19: Bool = eq inspect %17 inspect %18
  branch inspect %19 -> bb7 -> bb8

bb7:
  %21: Array(I32) [shared call] = read borrow.shared (self.b) loan2
  %22: Array(I32) [shared slot 0 view] = call.derivation elements(Array(I32), I32) borrow.shared %21 roots{2}
  %23: (Array(I32)) -> I32 [shared call] = read borrow.shared ($body) loan3
  %24: I32 = call inspect %23 borrow.shared %22
  write.assign borrow.unique ($yielded) take %24
  jump -> bb9

bb8:
