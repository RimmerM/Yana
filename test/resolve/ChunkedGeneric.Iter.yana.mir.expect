fn main() -> I32 {
  local & local0: Array(I32)
  local & local1: Array(I32)
  local local2: Chunks

bb0:
  %0: I32 = const 1
  %1: I32 = const 2
  %2: Size = const 2
  %3: Array(I32) = call literalArray(I32) borrow.shared %2
  write.init borrow.unique (local0) take %3
  %5: Array(I32) [unique slot 0] = read borrow.unique (local0) loan0
  %6: Array(I32) [unique slot 0 view] = call.derivation elementsMut(Array(I32), I32) borrow.unique %5 roots{0}
  %7: %I32 [owned here shape6 .*=shared slot 0] = call valuesMut(I32) borrow.unique %6 roots.0{0}
  %8: Size = const 0
  write.init borrow.unique ([%%7][0]) take %0
  %10: Size = const 1
  write.init borrow.unique ([%%7][1]) take %1
  %12: Array(I32) = read take (local0)
  %13: I32 = const 3
  %14: I32 = const 4
  %15: Size = const 2
  %16: Array(I32) = call literalArray(I32) borrow.shared %15
  write.init borrow.unique (local1) take %16
  %18: Array(I32) [unique slot 0] = read borrow.unique (local1) loan1
  %19: Array(I32) [unique slot 0 view] = call.derivation elementsMut(Array(I32), I32) borrow.unique %18 roots{1}
  %20: %I32 [owned here shape6 .*=shared slot 0] = call valuesMut(I32) borrow.unique %19 roots.0{1}
  %21: Size = const 0
  write.init borrow.unique ([%%20][0]) take %13
  %23: Size = const 1
  write.init borrow.unique ([%%20][1]) take %14
  %25: Array(I32) = read take (local1)
  %26: I32 = const 2
  %27: Chunks = aggregate.Chunks take %12 take %25 take %26
  write.init borrow.unique (local2) take %27
  %29: Chunks [shared call] = read borrow.shared (local2) loan2
  %30: I32 = call sumItems borrow.shared %29
  drop (local2)
  %31: I32 = const 10
  %32: I32 = const 20
  %33: [I32 *2] = aggregate.0 take %31 take %32
  %34: Array(I32) [shared slot 0 view] = call.derivation elements([I32 *2], I32) borrow.shared %33
  %35: I32 = call sumArray borrow.shared %34
  %36: I32 = add inspect %30 inspect %35
