bb2(%3: Array(a) [shared call view]) handover(Array(a) [shared call view]) many -> bb1:
  write.init borrow.unique (chunk) borrow.shared %3
  %6: Array(a) [shared call view] = read borrow.shared (chunk) loan1 roots{0}
