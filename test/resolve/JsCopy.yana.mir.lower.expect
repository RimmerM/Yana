
seed<complex>(): I32 {
  b_0 {
    ret 5
  }
}

next<complex>(%n: I32): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    store %v_1, %n, 4
    %v_2 = loads %v_1, 4: I32
    %v_3 = add %v_2, 1: I32
    ret %v_3
  }
}

barrier<complex>(%flag: I32): I32 {
  b_0 {
    %v_1 = alloca 1, 1: Ptr
    %v_2 = alloca 4, 4: Ptr
    %v_3 = alloca 4, 4: Ptr
    store %v_1, %flag, 1
    %v_4 = call_complex seed: I32
    store %v_2, %v_4, 4
    %v_5 = load %v_1, 1: I32
    je %v_5, b_6, b_7
  }

  b_7 {
    jmp b_8
  }

  b_8 {
    %v_9 = loads %v_2, 4: I32
    store %v_3, %v_9, 4
    %v_10 = loads %v_2, 4: I32
    %v_11 = call_complex next, %v_10: I32
    store %v_2, %v_11, 4
    %v_12 = loads %v_3, 4: I32
    %v_13 = imul %v_12, 100: I32
    %v_14 = loads %v_2, 4: I32
    %v_15 = add %v_13, %v_14: I32
    ret %v_15
  }

  b_6 {
    %v_16 = loads %v_2, 4: I32
    %v_17 = call_complex next, %v_16: I32
    store %v_2, %v_17, 4
    jmp b_8
  }
}

taken<complex>(%flag: I32): I32 {
  b_0 {
    %v_1 = alloca 1, 1: Ptr
    %v_2 = alloca 4, 4: Ptr
    %v_3 = alloca 4, 4: Ptr
    store %v_1, %flag, 1
    %v_4 = call_complex seed: I32
    store %v_2, %v_4, 4
    %v_5 = load %v_1, 1: I32
    je %v_5, b_6, b_7
  }

  b_7 {
    jmp b_8
  }

  b_8 {
    %v_9 = loads %v_2, 4: I32
    store %v_3, %v_9, 4
    %v_10 = loads %v_3, 4: I32
    %v_11 = imul %v_10, 100: I32
    %v_12 = loads %v_3, 4: I32
    %v_13 = add %v_11, %v_12: I32
    %v_14 = loads %v_2, 4: I32
    %v_15 = add %v_13, %v_14: I32
    ret %v_15
  }

  b_6 {
    %v_16 = loads %v_2, 4: I32
    %v_17 = call_complex next, %v_16: I32
    store %v_2, %v_17, 4
    jmp b_8
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = call_complex barrier, 1: I32
    %v_2 = call_complex barrier, 0: I32
    %v_3 = imul %v_2, 1000: I32
    %v_4 = add %v_1, %v_3: I32
    %v_5 = call_complex taken, 1: I32
    %v_6 = imul %v_5, 1000000: I32
    %v_7 = add %v_4, %v_6: I32
    ret %v_7
  }
}

