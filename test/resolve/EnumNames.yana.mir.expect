fn colourOf(name: String [shared call view]) -> Maybe(Colour) {
bb0:
  %0: String [shared call view] = read borrow.shared (name) loan0
  %1: Maybe(Colour) = call fromName(Colour, I32) borrow.shared %0
  return take %1
}

fn signalOf(name: String [shared call view]) -> Maybe(Signal) {
bb0:
