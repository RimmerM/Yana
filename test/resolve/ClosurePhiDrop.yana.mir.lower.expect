mut @dropCalls = [0, 0, 0, 0]

Guard.drop<complex>(%self: Ptr) {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    copy %v_1, %self, 4
    %v_2 = loads @dropCalls, 4: I32
    %v_3 = add %v_2, 1: I32
    store @dropCalls, %v_3, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    %v_2 = alloca 8, 8: Ptr
    store %v_1, 3, 4
    store %v_2, %v_1, 8
    %v_3 = loads %v_1, 4: I32
    %v_4 = add 10, %v_3: I32
    call_complex Guard.drop, %v_1
    %v_5 = alloca 4, 4: Ptr
    %v_6 = alloca 8, 8: Ptr
    store %v_5, 5, 4
    store %v_6, %v_5, 8
    %v_7 = loads %v_5, 4: I32
    %v_8 = imul 10, %v_7: I32
    call_complex Guard.drop, %v_5
    %v_9 = add %v_4, %v_8: I32
    %v_10 = loads @dropCalls, 4: I32
    %v_11 = add %v_9, %v_10: I32
    ret %v_11
  }
}

either.lambda<complex>(%either.lambda.env: Ptr, %x: I32): I32 {
  b_0 {
    %v_1 = load %either.lambda.env, 8: Ptr
    %v_2 = loads %v_1, 4: I32
    %v_3 = add %x, %v_2: I32
    ret %v_3
  }
}

either.lambda'2<complex>(%either.lambda'2.env: Ptr, %x: I32): I32 {
  b_0 {
    %v_1 = load %either.lambda'2.env, 8: Ptr
    %v_2 = loads %v_1, 4: I32
    %v_3 = imul %x, %v_2: I32
    ret %v_3
  }
}

