mut @dropCalls = [0, 0, 0, 0]

Guard.drop<complex>(%self: Ptr) {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    copy %v_1, %self, 4
    %v_2 = loads @dropCalls, 4: I32
    %v_3 = add %v_2, 1: I32
    store @dropCalls, %v_3, 4
    ret 
  }
}

either<complex>(%pick: I32, %id: I32): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    %v_2 = alloca 8, 8: Ptr
    %v_3 = alloca 8, 8: Ptr
    store %v_1, %id, 4
    %v_4 = cmp_ilt %pick, 1: I32
    je %v_4, b_5, b_6
  }

  b_6 {
    store %v_3, %v_1, 8
    %v_7 = alloca 16, 8: Ptr
    store %v_7, either.lambda'2, 8
    %v_8 = add %v_7, 8: Ptr
    store %v_8, %v_3, 8
    jmp b_9
  }

  b_9 {
    %v_10 = phi [b_6, %v_7], [b_5, %v_11]: Ptr
    %v_12 = load %v_10, 8: Ptr
    %v_13 = add %v_10, 8: Ptr
    %v_14 = load %v_13, 8: Ptr
    %v_15 = call_complex %v_12, %v_14, 10: I32
    call_complex Guard.drop, %v_1
    ret %v_15
  }

  b_5 {
    store %v_2, %v_1, 8
    %v_11 = alloca 16, 8: Ptr
    store %v_11, either.lambda, 8
    %v_16 = add %v_11, 8: Ptr
    store %v_16, %v_2, 8
    jmp b_9
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = call_complex either, 0, 3: I32
    %v_2 = call_complex either, 2, 5: I32
    %v_3 = add %v_1, %v_2: I32
    %v_4 = loads @dropCalls, 4: I32
    %v_5 = add %v_3, %v_4: I32
    ret %v_5
  }
}

either.lambda<complex>(%either.lambda.env: Ptr, %x: I32): I32 {
  b_0 {
    %v_1 = load %either.lambda.env, 8: Ptr
    %v_2 = loads %v_1, 4: I32
    %v_3 = add %x, %v_2: I32
    ret %v_3
  }
}

either.lambda'2<complex>(%either.lambda'2.env: Ptr, %x: I32): I32 {
  b_0 {
    %v_1 = load %either.lambda'2.env, 8: Ptr
    %v_2 = loads %v_1, 4: I32
    %v_3 = imul %x, %v_2: I32
    ret %v_3
  }
}

