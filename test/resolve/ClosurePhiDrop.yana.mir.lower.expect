mut @dropCalls = [0, 0, 0, 0]

Guard.drop<complex>(%v_0: I32) {
  b_1 {
    %v_2 = loads @dropCalls, 4: I32
    %v_3 = add %v_2, 1: I32
    store @dropCalls, %v_3, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    call_complex Guard.drop, 3
    call_complex Guard.drop, 5
    %v_1 = loads @dropCalls, 4: I32
    %v_2 = add 63, %v_1: I32
    ret %v_2
  }
}

@header(either.lambda) = [0, 0, 0, 0]
either.lambda<complex>(%either.lambda.env: Ptr, %x: I32): I32 {
  b_0 {
    %v_1 = load %either.lambda.env, 8: Ptr
    %v_2 = loads %v_1, 4: I32
    %v_3 = add %x, %v_2: I32
    ret %v_3
  }
}

@header(either.lambda'2) = [0, 0, 0, 0]
either.lambda'2<complex>(%either.lambda'2.env: Ptr, %x: I32): I32 {
  b_0 {
    %v_1 = load %either.lambda'2.env, 8: Ptr
    %v_2 = loads %v_1, 4: I32
    %v_3 = imul %x, %v_2: I32
    ret %v_3
  }
}

