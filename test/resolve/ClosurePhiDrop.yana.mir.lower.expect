mut @dropCalls = [0, 0, 0, 0]

Guard.drop<complex>(%self: Ptr) {
  b_0 {
    %v_1 = loads @dropCalls, 4: I32
    %v_2 = add %v_1, 1: I32
    store @dropCalls, %v_2, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    store %v_1, 3, 4
    call_complex Guard.drop, %v_1
    %v_2 = alloca 4, 4: Ptr
    store %v_2, 5, 4
    call_complex Guard.drop, %v_2
    %v_3 = loads @dropCalls, 4: I32
    %v_4 = add 63, %v_3: I32
    ret %v_4
  }
}

either.lambda<complex>(%either.lambda.env: Ptr, %x: I32): I32 {
  b_0 {
    %v_1 = load %either.lambda.env, 8: Ptr
    %v_2 = loads %v_1, 4: I32
    %v_3 = add %x, %v_2: I32
    ret %v_3
  }
}

either.lambda'2<complex>(%either.lambda'2.env: Ptr, %x: I32): I32 {
  b_0 {
    %v_1 = load %either.lambda'2.env, 8: Ptr
    %v_2 = loads %v_1, 4: I32
    %v_3 = imul %x, %v_2: I32
    ret %v_3
  }
}

