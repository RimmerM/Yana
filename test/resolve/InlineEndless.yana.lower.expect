@image$base = []
mut @seed = [3, 0, 0, 0]

endless<complex>(%n: I32): I32 {
  b_0 {
    jmp b_1
  }

  b_1 {
    %v_2 = phi [b_0, %n], [b_1, %v_3]: I32
    %v_3 = add %v_2, 1: I32
    jmp b_1
  }
}

spins<complex>(): I32 {
  b_0 {
    jmp b_1
  }

  b_1 {
    %v_2 = loads @seed, 4: I32
    %v_3 = add %v_2, 1: I32
    store @seed, %v_3, 4
    jmp b_1
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = loads @seed, 4: I32
    %v_2 = cmp_igt %v_1, 1000000: I32
    je %v_2, b_3, b_4
  }

  b_4 {
    %v_5 = shl %v_1, 1: I32
    jmp b_6
  }

  b_3 {
    %v_7 = call_complex endless, %v_1: I32
    jmp b_6
  }

  b_6 {
    %v_8 = phi [b_4, %v_5], [b_3, %v_7]: I32
    %v_9 = imul %v_8, 3: I32
    %v_10 = loads @seed, 4: I32
    %v_11 = shl %v_10, 1: I32
    %v_12 = add %v_11, 1: I32
    %v_13 = add %v_9, %v_12: I32
    %v_14 = cmp_igt %v_10, 1000000: I32
    je %v_14, b_15, b_16
  }

  b_16 {
    %v_17 = imul %v_10, 3: I32
    jmp b_18
  }

  b_15 {
    %v_19 = call_complex spins: I32
    jmp b_18
  }

  b_18 {
    %v_20 = phi [b_16, %v_17], [b_15, %v_19]: I32
    %v_21 = imul %v_20, 5: I32
    %v_22 = add %v_13, %v_21: I32
    ret %v_22
  }
}

