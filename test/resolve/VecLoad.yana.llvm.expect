  %live = fcmp olt <4 x float> <float 0.000000e+00, float 1.000000e+00, float 2.000000e+00, float 3.000000e+00>, %.splat
  %23 = sext i32 %4 to i64
  %24 = shl i64 %23, 2
  %25 = getelementptr i8, ptr %"xs$items", i64 %24
  %26 = load <4 x float>, ptr %25, align 1
  %x = select <4 x i1> %live, <4 x float> %26, <4 x float> zeroinitializer
  %27 = getelementptr i8, ptr %"ys$items", i64 %24
