  %3 = load i32, ptr %2, align 1
  %4 = lshr i32 %3, 30
  %5 = icmp eq i32 %4, 1
  %6 = zext i1 %5 to i32
  br i1 %5, label %7, label %9

7:                                                ; preds = %1
  %8 = load ptr, ptr %value, align 1
  call fastcc void @freeHeap(ptr %8)
  br label %9

9:                                                ; preds = %7, %1
  ret void
}

