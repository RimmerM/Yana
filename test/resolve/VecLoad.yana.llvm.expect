6:                                                ; preds = %1
  br label %7

7:                                                ; preds = %6
  %8 = getelementptr i8, ptr %allocation, i64 -8
  %9 = load i64, ptr %8, align 1
  %10 = load ptr, ptr @heapFree, align 1
  %11 = shl i64 %9, 3
  %12 = getelementptr i8, ptr %10, i64 %11
  %13 = load ptr, ptr %12, align 1
  store ptr %13, ptr %allocation, align 1
  %14 = load ptr, ptr @heapFree, align 1
  %15 = getelementptr i8, ptr %14, i64 %11
  store ptr %allocation, ptr %15, align 1
