2:                                                ; preds = %11, %1
  %3 = phi <4 x i32> [ zeroinitializer, %1 ], [ %16, %11 ]
  %4 = phi i32 [ 0, %1 ], [ %17, %11 ]
  %5 = add i32 %4, 4
  %6 = icmp sle i32 %5, %n
  %7 = zext i1 %6 to i32
  br i1 %6, label %11, label %8

8:                                                ; preds = %2
  %9 = icmp slt i32 %4, %n
  %10 = zext i1 %9 to i32
  br i1 %9, label %18, label %26

11:                                               ; preds = %2
  %12 = sext i32 %4 to i64
  %13 = shl i64 %12, 2
  %14 = getelementptr i8, ptr %"xs$items", i64 %13
  %15 = load <4 x i32>, ptr %14, align 1
  %16 = add <4 x i32> %3, %15
  %17 = add i32 %4, 4
  br label %2

18:                                               ; preds = %8
  %19 = sub i32 %n, %4
  %.splatinsert = insertelement <4 x i32> poison, i32 %19, i32 0
  %.splat = shufflevector <4 x i32> %.splatinsert, <4 x i32> poison, <4 x i32> zeroinitializer
  %live = icmp slt <4 x i32> <i32 0, i32 1, i32 2, i32 3>, %.splat
  %20 = sext i32 %4 to i64
  %21 = shl i64 %20, 2
  %22 = getelementptr i8, ptr %"xs$items", i64 %21
  %23 = load <4 x i32>, ptr %22, align 1
  %24 = select <4 x i1> %live, <4 x i32> %23, <4 x i32> zeroinitializer
  %25 = add <4 x i32> %3, %24
  br label %27

26:                                               ; preds = %8
  br label %27

27:                                               ; preds = %18, %26
  %28 = phi <4 x i32> [ %25, %18 ], [ %3, %26 ]
  %29 = call i32 @llvm.vector.reduce.add.v4i32(<4 x i32> %28)
  ret i32 %29
}

