target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

@"image$base" = constant [0 x i8] zeroinitializer, align 8
@heapFree = global [8 x i8] zeroinitializer, align 8

define fastcc void @freeHeap(ptr %allocation) {
  br label %1

1:                                                ; preds = %0
  %2 = ptrtoint ptr %allocation to i64
  %3 = icmp eq i64 %2, 0
  %4 = zext i1 %3 to i32
  br i1 %3, label %5, label %6

5:                                                ; preds = %1
  ret void

6:                                                ; preds = %1
  br label %7

7:                                                ; preds = %6
  %8 = getelementptr i8, ptr %allocation, i64 -8
  %9 = load i64, ptr %8, align 1
  %10 = load ptr, ptr @heapFree, align 1
  %11 = shl i64 %9, 3
  %12 = getelementptr i8, ptr %10, i64 %11
  %13 = load ptr, ptr %12, align 1
  store ptr %13, ptr %allocation, align 1
  %14 = load ptr, ptr @heapFree, align 1
  %15 = getelementptr i8, ptr %14, i64 %11
  store ptr %allocation, ptr %15, align 1
  ret void
}

define fastcc void @"Reclaim(Array(a)).reclaim(Float)"(ptr %value) {
  br label %1

1:                                                ; preds = %0
  %2 = getelementptr i8, ptr %value, i64 8
  %3 = load i32, ptr %2, align 1
  %4 = lshr i32 %3, 30
  %5 = icmp eq i32 %4, 1
  %6 = zext i1 %5 to i32
  br i1 %5, label %7, label %9

7:                                                ; preds = %1
  %8 = load ptr, ptr %value, align 1
  call fastcc void @freeHeap(ptr %8)
  br label %9

9:                                                ; preds = %7, %1
  ret void
}

define fastcc void @"Reclaim(Array(a)).reclaim(Int)"(ptr %value) {
  br label %1

1:                                                ; preds = %0
  %2 = getelementptr i8, ptr %value, i64 8
  %3 = load i32, ptr %2, align 1
  %4 = lshr i32 %3, 30
  %5 = icmp eq i32 %4, 1
  %6 = zext i1 %5 to i32
  br i1 %5, label %7, label %9

