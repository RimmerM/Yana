-- The accepting half of Reject.NestedBorrow.yana: the same relations with their roots declared.
--
-- What this pins is that the group crosses an aggregate and a call, at depth. Neither used to: the
-- walk that asks whether a result contains a reference stopped at a fixed depth of eight, and the
-- one that composes a callee's declared group into the caller only ran for a result that *was* a
-- reference rather than one that held one.

data L1 {r: 'Int}
data L2 {a: L1}
data L3 {a: L2}
data L4 {a: L3}
data L5 {a: L4}

fn wrap1(n: 'Int) -> L1 = L1 {r: n}

fn wrap2(n: 'Int) -> L2 = L2 {a: wrap1(n)}

fn wrap3(n: 'Int) -> L3 = L3 {a: wrap2(n)}

fn wrap4(n: 'Int) -> L4 = L4 {a: wrap3(n)}

-- Five records deep, which is one past where the old bound stopped looking.
fn wrap5(n: 'Int) -> L5 = L5 {a: wrap4(n)}

fn readBack(v: L5) -> Int = v.a.a.a.a.r

fn main() -> Int:
    let &n = 7 :: Int
    let deep = wrap5(n)
    return readBack(deep)
