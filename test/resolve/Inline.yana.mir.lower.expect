
countDown<complex>(%n: I32): I32 {
  b_0 {
    %v_1 = phi [b_2, %n], [b_3, %v_4]: I32
    %v_5 = phi [b_2, 0], [b_3, %v_6]: I32
    %v_7 = cmp_ile %v_1, 0: I32
    je %v_7, b_8, b_3
  }

  b_3 {
    %v_4 = sub %v_1, 1: I32
    %v_6 = add %v_5, %v_1: I32
    jmp b_0
  }

  b_8 {
    ret %v_5
  }

  b_2 {
    jmp b_0
  }
}

evenLength<complex>(%n: I32): I32 {
  b_0 {
    %v_1 = cmp_ile %n, 0: I32
    je %v_1, b_2, b_3
  }

  b_3 {
    %v_4 = sub %n, 1: I32
    %v_5 = call_complex oddLength, %v_4: I32
    ret %v_5
  }

  b_2 {
    ret 1
  }
}

oddLength<complex>(%n: I32): I32 {
  b_0 {
    %v_1 = cmp_ile %n, 0: I32
    je %v_1, b_2, b_3
  }

  b_3 {
    %v_4 = sub %n, 1: I32
    %v_5 = call_complex evenLength, %v_4: I32
    ret %v_5
  }

  b_2 {
    ret 0
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = call_complex countDown, 4: I32
    %v_2 = add 247, %v_1: I32
    %v_3 = add %v_2, 13: I32
    %v_4 = add %v_3, 5: I32
    %v_5 = add %v_4, 213: I32
    %v_6 = add %v_5, 6: I32
    jmp b_7
  }

  b_8 {
    %v_9 = cmp_ilt %v_10, 20: I32
    je %v_9, b_7, b_11
  }

  b_11 {
    %v_12 = add %v_6, %v_13: I32
    %v_14 = add %v_12, 18: I32
    %v_15 = call_complex evenLength, 6: I32
    %v_16 = call_complex oddLength, 6: I32
    %v_17 = add %v_15, %v_16: I32
    %v_18 = add %v_14, %v_17: I32
    ret %v_18
  }

  b_7 {
    %v_19 = phi [b_8, %v_10], [b_0, 1]: I32
    %v_20 = phi [b_8, %v_13], [b_0, 0]: I32
    %v_10 = add %v_19, %v_19: I32
    %v_13 = add %v_20, 1: I32
    jmp b_8
