50:                                               ; preds = %43
  %51 = extractelement <4 x i32> %3, i32 1
  %52 = mul i32 %51, 100
  %53 = extractelement <4 x i32> %4, i32 0
  %54 = add i32 %52, %53
  %55 = extractelement <4 x i32> %14, i32 0
