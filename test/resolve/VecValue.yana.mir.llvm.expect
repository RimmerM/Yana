26:                                               ; preds = %33
  %27 = icmp slt i32 %37, 4
  %28 = zext i1 %27 to i32
  br i1 %27, label %33, label %29

29:                                               ; preds = %26
  %30 = extractelement <4 x i32> %36, i32 0
