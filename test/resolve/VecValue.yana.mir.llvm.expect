43:                                               ; preds = %38
  %44 = call i32 @llvm.vector.reduce.add.v4i32(<4 x i32> splat (i32 1))
  %45 = call i32 @llvm.vector.reduce.add.v4i32(<4 x i32> %36)
  %46 = mul i32 %44, 15
  %47 = icmp ne i32 %45, %46
  %48 = zext i1 %47 to i32
  br i1 %47, label %57, label %50

49:                                               ; preds = %38
