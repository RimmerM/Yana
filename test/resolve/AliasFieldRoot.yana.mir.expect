module ResolveTest

data Point {x: I32, y: I32}

data Holder {p: Point, tag: I32}

fn both(a: Point [shared call], h: Holder [unique call]) -> I32 {
bb0:
  %0: I32 = const 100
  write.assign borrow.unique (h.p.x) take %0
  %2: I32 = read copy.trivial (a.x)
  %3: I32 = read copy.trivial (a.y)
  %4: I32 = add inspect %2 inspect %3
  return take %4
}

fn main() -> I32 {
  local & h: Holder

bb0:
  %0: I32 = const 1
  %1: I32 = const 2
  %2: Point = aggregate.Point take %0 take %1
  %3: I32 = const 0
  %4: Holder = aggregate.Holder take %2 take %3
  write.init borrow.unique (h) take %4
  %6: Point = read copy.trivial (h.p)
  %7: Holder [unique call] = read borrow.unique (h) loan0
  %8: I32 = call both borrow.shared %6 borrow.unique %7
  return take %8
}

entry main
