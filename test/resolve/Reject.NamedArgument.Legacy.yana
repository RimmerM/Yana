-- The rules of `Reject.NamedArgument.yana` the default stage does not state yet: a wrong name
-- through a function value, a default that is a call, and a `for` over an `iter fn` given too many
-- arguments. It refuses each, but as something not built rather than as the rule: "does not
-- implement a named argument yet", "does not implement this constant expression yet" and "no rule
-- finds one from the type of a value". Move each back when it states the rule.

fn required(a: Int, b: Int, c: Int = 3) -> Int = a + b + c

fn throughValueName(f: (from: Int, take: Int) -> Int) -> Int = f(from: 1, count: 2)

fn computed(x: Int, y: Int = required(1, 2)) -> Int = x + y

iter fn steps(limit: Int, from: Int = 0) -> Int:
    let &i = from :: Int

    while i < limit:
        yield i
        i = i + 1

fn loopTooMany() -> Int:
    let &total = 0 :: Int

    for i in steps(1, 2, 3):
        total = total + i

    return total

fn main() -> Int = 0
