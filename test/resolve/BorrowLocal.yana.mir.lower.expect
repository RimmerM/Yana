
addTo<complex>(%target: Ptr, %amount: I32) {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    store %v_1, %amount, 4
    %v_2 = loads %target, 4: I32
    %v_3 = loads %v_1, 4: I32
    %v_4 = add %v_2, %v_3: I32
    store %target, %v_4, 4
    ret 
  }
}

accumulate<complex>(%n: I32): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    %v_2 = alloca 4, 4: Ptr
    store %v_1, %n, 4
    store %v_2, 0, 4
    %v_3 = loads %v_2, 4: I32
    %v_4 = loads %v_1, 4: I32
    %v_5 = add %v_3, %v_4: I32
    store %v_2, %v_5, 4
    %v_6 = loads %v_2, 4: I32
    %v_7 = imul %v_6, 2: I32
    store %v_2, %v_7, 4
    %v_8 = loads %v_2, 4: I32
    ret %v_8
  }
}

shared<complex>(%n: I32): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    %v_2 = alloca 4, 4: Ptr
    store %v_1, %n, 4
    store %v_2, 0, 4
    %v_3 = loads %v_1, 4: I32
    call_complex addTo, %v_2, %v_3
    %v_4 = loads %v_2, 4: I32
    %v_5 = add %v_4, 1: I32
    store %v_2, %v_5, 4
    %v_6 = loads %v_2, 4: I32
    ret %v_6
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = call_complex accumulate, 5: I32
    %v_2 = call_complex shared, 5: I32
    %v_3 = add %v_1, %v_2: I32
    ret %v_3
  }
}

