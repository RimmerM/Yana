bb8:
  %34: Vec(I32) = read copy.trivial (sevens)
  %35: I32 = vec.reduce min inspect %34
  %36: I32 = const 7
  %37: Bool = ne inspect %35 inspect %36
  branch inspect %37 -> bb12 -> bb10

bb9:
  %31: I32 = const -3
  return take %31

bb10:
  jump -> bb11

bb11:
  %42: Vec(I32) = read copy.trivial (sevens)
  %43: I32 = const 0
  %44: I32 = const 9
  %45: Vec(I32) = vec.withlane #0 inspect %42 inspect %44
  %46: I32 = vec.reduce max inspect %45
  %47: I32 = const 9
  %48: Bool = ne inspect %46 inspect %47
  branch inspect %48 -> bb15 -> bb13

bb12:
  %39: I32 = const -4
  return take %39

bb13:
  jump -> bb14

bb14:
  %53: Vec(I32) = read copy.trivial (sevens)
  %54: I32 = const 1
  %55: I32 = const 2
  %56: Vec(I32) = vec.withlane #1 inspect %53 inspect %55
  %57: I32 = vec.reduce min inspect %56
  %58: I32 = const 2
  %59: Bool = ne inspect %57 inspect %58
  branch inspect %59 -> bb18 -> bb16

bb15:
  %50: I32 = const -5
  return take %50

bb16:
  jump -> bb17

bb17:
  %64: I32 = const 0
  return take %64

bb18:
  %61: I32 = const -6
  return take %61
}

fn floats() -> I32 {
  local a: Vec(F32)
  local b: Vec(F32)
