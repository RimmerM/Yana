module ResolveTest

fn arithmetic() -> I32 {
  local a: Vec(I32)
  local b: Vec(I32)
  local sum: Vec(I32)
  local product: Vec(I32)
  local difference: Vec(I32)

bb0:
  %0: I32 = const 3
  %1: Vec(I32) = vec.splat inspect %0
  write.init borrow.unique (a) take %1
  %3: I32 = const 4
  %4: Vec(I32) = vec.splat inspect %3
  write.init borrow.unique (b) take %4
  %6: Vec(I32) = read copy.trivial (a)
  %7: Vec(I32) = read copy.trivial (b)
  %8: Vec(I32) = add inspect %6 inspect %7
  write.init borrow.unique (sum) take %8
  %10: Vec(I32) = read copy.trivial (a)
  %11: Vec(I32) = read copy.trivial (b)
  %12: Vec(I32) = mul inspect %10 inspect %11
  write.init borrow.unique (product) take %12
  %14: Vec(I32) = read copy.trivial (b)
  %15: Vec(I32) = read copy.trivial (a)
  %16: Vec(I32) = sub inspect %14 inspect %15
  write.init borrow.unique (difference) take %16
  %18: Vec(I32) = read copy.trivial (sum)
  %19: I32 = const 0
  %20: I32 = vec.lane #0 inspect %18
  %21: I32 = const 100
  %22: I32 = mul inspect %20 inspect %21
  %23: Vec(I32) = read copy.trivial (product)
  %24: I32 = const 0
  %25: I32 = vec.lane #0 inspect %23
  %26: I32 = add inspect %22 inspect %25
  %27: Vec(I32) = read copy.trivial (difference)
  %28: I32 = const 1
  %29: I32 = vec.lane #1 inspect %27
  %30: I32 = add inspect %26 inspect %29
  return take %30
}

fn bits'2() -> I32 {
