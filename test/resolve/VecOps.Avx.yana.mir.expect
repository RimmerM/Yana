  %6: Vec(I32) = read copy.trivial (a)
  %7: Vec(I32) = read copy.trivial (b)
  %8: Vec(I32) = and inspect %6 inspect %7
  %9: I32 = const 0
  %10: I32 = vec.lane #0 inspect %8
  %11: I32 = const 100
  %12: I32 = mul inspect %10 inspect %11
  %13: Vec(I32) = read copy.trivial (a)
  %14: Vec(I32) = read copy.trivial (b)
  %15: Vec(I32) = or inspect %13 inspect %14
  %16: I32 = const 0
  %17: I32 = vec.lane #0 inspect %15
  %18: I32 = add inspect %12 inspect %17
  %19: Vec(I32) = read copy.trivial (a)
  %20: Vec(I32) = read copy.trivial (b)
  %21: Vec(I32) = xor inspect %19 inspect %20
  %22: I32 = const 1
  %23: I32 = vec.lane #1 inspect %21
  %24: I32 = add inspect %18 inspect %23
  return take %24
}

fn lanes'2() -> I32 {
  local v: Vec(I32)
  local changed: Vec(I32)

bb0:
  %0: I32 = const 5
  %1: Vec(I32) = vec.splat inspect %0
  write.init borrow.unique (v) take %1
  %3: Vec(I32) = read copy.trivial (v)
  %4: I32 = const 1
  %5: I32 = const 9
  %6: Vec(I32) = vec.withlane #1 inspect %3 inspect %5
  write.init borrow.unique (changed) take %6
  %8: Vec(I32) = read copy.trivial (changed)
  %9: I32 = const 0
  %10: I32 = vec.lane #0 inspect %8
  %11: I32 = const 100
  %12: I32 = mul inspect %10 inspect %11
  %13: Vec(I32) = read copy.trivial (changed)
  %14: I32 = const 1
  %15: I32 = vec.lane #1 inspect %13
  %16: I32 = add inspect %12 inspect %15
  return take %16
}

fn reductions() -> I32 {
  local ones: Vec(I32)
  local count: I32
  local sevens: Vec(I32)

bb0:
  %0: I32 = const 1
  %1: Vec(I32) = vec.splat inspect %0
  write.init borrow.unique (ones) take %1
  %3: Vec(I32) = read copy.trivial (ones)
  %4: I32 = vec.reduce add inspect %3
  write.init borrow.unique (count) take %4
  %6: I32 = read copy.trivial (count)
  %7: I32 = const 2
  %8: Bool = lt inspect %6 inspect %7
  branch inspect %8 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %13: Vec(I32) = read copy.trivial (ones)
  %14: I32 = vec.reduce mul inspect %13
  %15: I32 = const 1
  %16: Bool = ne inspect %14 inspect %15
