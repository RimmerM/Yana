}

fn main() -> I32 {
bb0:
  %0: I32 = call reductions
  %1: I32 = const 0
  %2: Bool = ne inspect %0 inspect %1
  branch inspect %2 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %7: I32 = call floats
