target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

@counter = global [4 x i8] zeroinitializer, align 8

define fastcc i32 @main() #0 {
  br label %1

1:                                                ; preds = %0
  %2 = load i32, ptr @counter, align 1
  %3 = add i32 %2, 2
  %4 = icmp sgt i32 %3, 1000
  %5 = zext i1 %4 to i32
  %6 = select i1 %4, i32 1, i32 2
  %7 = add i32 %2, 5
  store i32 %7, ptr @counter, align 1
  %8 = icmp sgt i32 %7, 1000
  %9 = zext i1 %8 to i32
  %10 = select i1 %8, i32 1, i32 3
  %11 = sext i32 %10 to i64
  %.splatinsert = insertelement <4 x i32> poison, i32 %6, i64 0
  %.splat = shufflevector <4 x i32> %.splatinsert, <4 x i32> poison, <4 x i32> zeroinitializer
  %12 = shl <4 x i32> <i32 5, i32 100, i32 -32, i32 64>, %.splat
  %13 = lshr <4 x i32> <i32 5, i32 100, i32 -32, i32 64>, %.splat
  %14 = ashr <4 x i32> <i32 5, i32 100, i32 -32, i32 64>, %.splat
  %15 = extractelement <4 x i32> %12, i32 0
  %16 = extractelement <4 x i32> %13, i32 1
  %17 = add i32 %15, %16
  %18 = extractelement <4 x i32> %14, i32 2
  %19 = add i32 %17, %18
  %.splatinsert1 = insertelement <2 x i64> poison, i64 %11, i64 0
  %.splat2 = shufflevector <2 x i64> %.splatinsert1, <2 x i64> poison, <2 x i32> zeroinitializer
  %20 = shl <2 x i64> splat (i64 3), %.splat2
  %21 = sub i64 %11, 1
  %.splatinsert3 = insertelement <2 x i64> poison, i64 %21, i64 0
  %.splat4 = shufflevector <2 x i64> %.splatinsert3, <2 x i64> poison, <2 x i32> zeroinitializer
  %22 = lshr <2 x i64> %20, %.splat4
  %23 = ashr <2 x i64> splat (i64 -3), %.splat2
  %24 = extractelement <2 x i64> %22, i32 0
  %25 = extractelement <2 x i64> %23, i32 0
  %26 = add i64 %24, %25
  %27 = trunc i64 %26 to i32
  %28 = add i32 %19, %27
  ret i32 %28
}

attributes #0 = { "probe-stack"="inline-asm" }
