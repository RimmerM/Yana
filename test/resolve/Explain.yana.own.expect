fn +=(I64) {
  arg target writable
  arg amount readonly
  %target: I64 borrowed writable live [0, 3)
  %amount: I64 borrowed readonly live [0, 2)
  %local2: I64 readonly live [1, 3)
}

fn initHeap {
}

fn heapClassOf {
  arg total readonly
  %size: I64 writable live [0, 8) [10, 18)
  %sizeClass: I64 writable live [2, 9) [10, 18)
}

fn heapBlockSize {
  arg sizeClass readonly
}

fn freeListHead {
  arg sizeClass readonly
  result escapes
}

fn setFreeListHead {
  arg sizeClass readonly
  arg block readonly
}

fn allocateHeap {
  arg size readonly
  result escapes
}

fn freeHeap {
  arg allocation readonly
}

fn mapMemory {
  arg size readonly
}

fn replace {
  arg slot writable
  arg with readonly retained
  %slot: Pair borrowed writable live [0, 1)
  %with: Pair readonly escapes live [0, 1)
}

fn borrowed {
  arg p readonly return
  result arguments
  %p: Pair borrowed readonly live [0, 3)
}

fn placed {
  %p: Pair droppable writable heap live [0, 11)
}

fn bump {
  arg counter writable
  %counter: I64 borrowed writable live [0, 3)
}

fn main {
  %pair: Pair writable live [0, 21)
  %local1: Pair readonly live [4, 9)
  %local2: Pair readonly live [8, 10)
  %count: I64 writable live [13, 24)
}

fn identity(Int) {
  arg x readonly
  %x: Int borrowed readonly live [0, 1)
}
