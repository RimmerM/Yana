fn +=(I64) {
  arg target writable
  arg amount readonly
  %target: I64 borrowed writable live [0, 3)
  %amount: I64 borrowed readonly live [0, 2)
  %local2: I64 readonly live [1, 3)
}

fn numberOf {
  arg call readonly
}

fn mapMemory {
  arg size readonly
}

fn initHeap {
}

fn growHeap {
  arg needed readonly
  %size: Size writable live [1, 27) [28, 38) [39, 51)
  %region: %U8 writable live [12, 27) [28, 38) [39, 48)
}

fn heapClassOf {
  arg total readonly
  %size: Size writable live [0, 8) [10, 18)
  %sizeClass: Size writable live [2, 9) [10, 18)
}

fn heapBlockSize {
  arg sizeClass readonly
}

fn freeListHead {
  arg sizeClass readonly
  result escapes
}

fn setFreeListHead {
  arg sizeClass readonly
  arg block readonly
}

fn allocateHeap {
  arg size readonly
  result escapes
}

fn freeHeap {
  arg allocation readonly
}

fn replace {
  arg slot writable
  arg with readonly retained
  %slot: Pair borrowed writable live [0, 1)
  %with: Pair readonly escapes live [0, 1)
}

fn borrowed {
  arg p readonly return
  result arguments
  %p: Pair borrowed readonly live [0, 3)
}

fn placed {
  %p: Pair droppable writable heap live [0, 10)
}

fn bump {
  arg counter writable
  %counter: I64 borrowed writable live [0, 3)
}

fn main {
  %pair: Pair writable live [0, 19)
  %local1: Pair readonly live [3, 7)
  %local2: Pair readonly live [6, 8)
  %count: I64 writable live [11, 22)
}

fn identity(Int) {
  arg x readonly
  %x: Int readonly live [0, 1)
}
