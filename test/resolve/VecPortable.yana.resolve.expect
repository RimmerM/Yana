fn rearrangement() -> Int {
  b0:
    %v1 = vsplat 0 : Vec(Int)
    %v3 = vwithlane %v1, 1, 1 : Vec(Int)
    %v5 = vwithlane %v3, 2, 2 : Vec(Int)
    %indices = vwithlane %v5, 3, 3 : Vec(Int)
    %backwards = vshuffle %indices, %indices, 3, 2, 1, 0 : Vec(Int)
    %v12 = vlane %backwards, 0 : Int
    %v15 = sub %width, 1 : Int
    %v16 = cmp_ne %v12, %v15 : Bool
