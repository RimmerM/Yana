  b17:
    jmp b18

  b18:
    ret 0
}

fn arithmetic(%v: Vec(Int)) -> Int {
  b0:
    %v2 = vsplat 0 : Vec(Int)
    %v4 = vwithlane %v2, 1, 1 : Vec(Int)
    %v6 = vwithlane %v4, 2, 2 : Vec(Int)
    %indices = vwithlane %v6, 3, 3 : Vec(Int)
    %empty = vsplat 0 : Vec(Int)
    %v11 = cmp_lt %v, %indices : Mask(Int)
    %lower = select %v11 ? %v : %indices : Vec(Int)
    %v13 = cmp_gt %v, %indices : Mask(Int)
    %upper = select %v13 ? %v : %indices : Vec(Int)
    %v17 = vlane %lower, 0 : Int
    %v20 = cmp_ne %v17, 0 : Bool
    je %v20, b1, b2

  b1:
    ret -1

  b2:
    jmp b3

  b3:
    %v27 = vlane %upper, 0 : Int
    %v30 = cmp_ne %v27, 2 : Bool
    je %v30, b4, b5

  b4:
    ret -2

  b5:
    jmp b6

  b6:
    %v37 = vlane %lower, 1 : Int
    %v40 = cmp_ne %v37, 1 : Bool
    je %v40, b7, b8

  b7:
    ret -3

  b8:
    jmp b9

  b9:
    %v47 = vlane %upper, 1 : Int
    %v50 = cmp_ne %v47, 2 : Bool
    je %v50, b10, b11

  b10:
    ret -4

  b11:
    jmp b12

  b12:
    %negated = sub %empty, %v : Vec(Int)
    %v56 = abs %negated : Vec(Int)
    %v59 = vlane %v56, 0 : Int
    %v62 = cmp_ne %v59, 2 : Bool
    je %v62, b13, b14

  b13:
    ret -5

  b14:
    jmp b15

  b15:
    %v67 = abs %v : Vec(Int)
    %v70 = vlane %v67, 1 : Int
    %v73 = cmp_ne %v70, 2 : Bool
    je %v73, b16, b17

  b16:
    ret -6

  b17:
    jmp b18

  b18:
    ret 0
}

fn floats() -> Int {
  b0:
    %v2 = neg 1.5 : Float
    %a = vsplat %v2 : Vec(Float)
    %zeros = vsplat 0 : Vec(Float)
    %v6 = abs %a : Vec(Float)
    %v9 = vlane %v6, 0 : Float
    %v12 = cmp_ne %v9, 1.5 : Bool
    je %v12, b1, b2

  b1:
    ret -1

  b2:
    jmp b3

  b3:
    %v17 = cmp_lt %a, %zeros : Mask(Float)
    %v18 = select %v17 ? %a : %zeros : Vec(Float)
    %v21 = vlane %v18, 0 : Float
    %v24 = neg 1.5 : Float
    %v25 = cmp_ne %v21, %v24 : Bool
    je %v25, b4, b5

  b4:
    ret -2

  b5:
    jmp b6

  b6:
    %v30 = cmp_gt %a, %zeros : Mask(Float)
    %v31 = select %v30 ? %a : %zeros : Vec(Float)
    %v34 = vlane %v31, 1 : Float
    %v37 = cmp_ne %v34, 0 : Bool
    je %v37, b7, b8

  b7:
    ret -3

  b8:
    jmp b9

  b9:
    %v43 = abs %zeros : Vec(Float)
    %v46 = vlane %v43, 0 : Float
    %v48 = div 1, %v46 : Float
    %v51 = cmp_lt %v48, 0 : Bool
    je %v51, b10, b11

  b10:
    ret -4

  b11:
    jmp b12

  b12:
    ret 0
}

fn rearrangement() -> Int {
  b0:
    %v1 = vsplat 0 : Vec(Int)
    %v3 = vwithlane %v1, 1, 1 : Vec(Int)
    %v5 = vwithlane %v3, 2, 2 : Vec(Int)
    %indices = vwithlane %v5, 3, 3 : Vec(Int)
    %backwards = vshuffle %indices, %indices, 3, 2, 1, 0 : Vec(Int)
    %v12 = vlane %backwards, 0 : Int
    %v15 = sub %width, 1 : Int
    %v16 = cmp_ne %v12, %v15 : Bool
    je %v16, b1, b2

  b1:
    ret -1

  b2:
    jmp b3

  b3:
    %v23 = vlane %backwards, 1 : Int
    %v26 = sub %width, 2 : Int
    %v27 = cmp_ne %v23, %v26 : Bool
    je %v27, b4, b5

  b4:
    ret -2

  b5:
    jmp b6

  b6:
    %v34 = vshuffle %indices, %indices, 1, 2, 3, 0 : Vec(Int)
    %v37 = vlane %v34, 0 : Int
    %v40 = cmp_ne %v37, 1 : Bool
    je %v40, b7, b8

  b7:
    ret -3

  b8:
    jmp b9

  b9:
    %v47 = neg 1 : Int
    %v48 = vshuffle %indices, %indices, 3, 0, 1, 2 : Vec(Int)
    %v51 = vlane %v48, 0 : Int
    %v54 = sub %width, 1 : Int
    %v55 = cmp_ne %v51, %v54 : Bool
    je %v55, b10, b11

  b10:
    ret -4

  b11:
    jmp b12

  b12:
    %nines = vsplat 9 : Vec(Int)
    %low = vshuffle %indices, %nines, 0, 4, 1, 5 : Vec(Int)
    %high = vshuffle %indices, %nines, 2, 6, 3, 7 : Vec(Int)
    %v67 = vlane %low, 0 : Int
    %v70 = cmp_ne %v67, 0 : Bool
    je %v70, b13, b14

  b13:
    ret -5

  b14:
    jmp b15

  b15:
    %v77 = vlane %low, 1 : Int
    %v80 = cmp_ne %v77, 9 : Bool
    je %v80, b16, b17

  b16:
    ret -6

  b17:
    jmp b18

  b18:
    %v87 = vlane %high, 0 : Int
    %v90 = div %width, 2 : Int
    %v91 = cmp_ne %v87, %v90 : Bool
    je %v91, b19, b20

  b19:
    ret -7

  b20:
    jmp b21

  b21:
    %v98 = vlane %high, 1 : Int
    %v101 = cmp_ne %v98, 9 : Bool
    je %v101, b22, b23

  b22:
    ret -8

  b23:
    jmp b24

  b24:
    ret 0
}

fn regrouping(%v: Vec(I32)) -> Int {
  b0:
    %other = vwithlane %v, 5, 0 : Vec(I32)
    %v6 = cast %v : Vec(I16, 4)
    %v7 = cast %other : Vec(I16, 4)
    %packed = vshuffle %v6, %v7, 0, 1, 2, 3, 4, 5, 6, 7 : Vec(I16)
    %v13 = mul 4, 2 : Int
    %v14 = cmp_ne 8, %v13 : Bool
    je %v14, b1, b2

  b1:
    ret -1

  b2:
    jmp b3

  b3:
    %v21 = vlane %packed, 0 : I16
    %v24 = cmp_ne %v21, 2 : Bool
    je %v24, b4, b5

  b4:
    ret -2

  b5:
    jmp b6

  b6:
    %v30 = vlane %packed, 4 : I16
    %v33 = cmp_ne %v30, 5 : Bool
    je %v33, b7, b8

  b7:
    ret -3

  b8:
    jmp b9

  b9:
    %v38 = vshuffle %packed, %packed, 0, 1, 2, 3 : Vec(I16, 4)
    %low = cast %v38 : Vec(I32)
    %v40 = vshuffle %packed, %packed, 4, 5, 6, 7 : Vec(I16, 4)
    %high = cast %v40 : Vec(I32)
    %v44 = vlane %low, 0 : I32
    %v47 = cmp_ne %v44, 2 : Bool
    je %v47, b10, b11

  b10:
    ret -4

  b11:
    jmp b12

  b12:
    %v54 = vlane %high, 0 : I32
    %v57 = cmp_ne %v54, 5 : Bool
    je %v57, b13, b14

  b13:
    ret -5

  b14:
    jmp b15

  b15:
    ret 0
}

fn main() -> Int {
  b0:
    %v0 = load seed : Int
    %v = vsplat %v0 : Vec(Int)
    %v2 = call construction : Int
    %v5 = cmp_ne %v2, 0 : Bool
    je %v5, b1, b2

  b1:
    %v7 = call construction : Int
    ret %v7

  b2:
    jmp b3

  b3:
    %v10 = call arithmetic, %v : Int
    %v13 = cmp_ne %v10, 0 : Bool
    je %v13, b4, b5

  b4:
    %v15 = call arithmetic, %v : Int
    %v18 = mul %v15, 10 : Int
    ret %v18

  b5:
    jmp b6

  b6:
    %v21 = call floats : Int
    %v24 = cmp_ne %v21, 0 : Bool
    je %v24, b7, b8

  b7:
    %v26 = call floats : Int
    %v29 = mul %v26, 100 : Int
    ret %v29

  b8:
    jmp b9

  b9:
    %v32 = call rearrangement : Int
    %v35 = cmp_ne %v32, 0 : Bool
    je %v35, b10, b11

  b10:
    %v37 = call rearrangement : Int
    %v40 = mul %v37, 1000 : Int
    ret %v40

  b11:
    jmp b12

  b12:
    %v43 = load seed : Int
    %v44 = vsplat %v43 : Vec(Int)
    %v45 = cast %v44 : Vec(I32)
    %v46 = call regrouping, %v45 : Int
    %v49 = cmp_ne %v46, 0 : Bool
    je %v49, b13, b14

  b13:
    %v51 = load seed : Int
    %v52 = vsplat %v51 : Vec(Int)
    %v53 = cast %v52 : Vec(I32)
    %v54 = call regrouping, %v53 : Int
    %v57 = mul %v54, 10000 : Int
    ret %v57

  b14:
    jmp b15

  b15:
    ret 271
}
