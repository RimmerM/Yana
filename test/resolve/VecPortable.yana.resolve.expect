fn regrouping(%v: Vec(I32)) -> Int {
  b0:
    %other = vwithlane %v, 5, 0 : Vec(I32)
    %v6 = cast %v : Vec(I16, 4)
    %v7 = cast %other : Vec(I16, 4)
    %packed = vshuffle %v6, %v7, 0, 1, 2, 3, 4, 5, 6, 7 : Vec(I16)
