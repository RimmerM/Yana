let image$base: () = <none>

let &seed: I32 = 2

fn construction() -> I32 {
  b0:
    %empty = vsplat 0 : Vec(I32)
    %v3 = vsplat 0 : Vec(I32)
    %v5 = vwithlane %v3, 1, 1 : Vec(I32)
    %v7 = vwithlane %v5, 2, 2 : Vec(I32)
    %indices = vwithlane %v7, 3, 3 : Vec(I32)
    %v12 = vlane %empty, 0 : I32
    %v15 = cmp_ne %v12, 0 : Bool
    je %v15, b1, b2

  b1:
    ret -1

  b2:
    jmp b3

  b3:
    %v22 = vlane %empty, 1 : I32
    %v25 = cmp_ne %v22, 0 : Bool
    je %v25, b4, b5

  b4:
    ret -2

  b5:
    jmp b6

  b6:
    %v32 = vlane %indices, 0 : I32
    %v35 = cmp_ne %v32, 0 : Bool
    je %v35, b7, b8

  b7:
    ret -3

  b8:
    jmp b9

  b9:
    %v42 = vlane %indices, 1 : I32
    %v45 = cmp_ne %v42, 1 : Bool
    je %v45, b10, b11

  b10:
    ret -4

  b11:
    jmp b12

  b12:
    %v53 = cmp_lt 4, 2 : Bool
    je %v53, b13, b14

  b13:
    ret -5

  b14:
    jmp b15

  b15:
    %v58 = vreduce_add %indices : I32
    %v63 = sub 4, 1 : I32
    %v64 = mul 4, %v63 : I32
    %v67 = div %v64, 2 : I32
    %v68 = cmp_ne %v58, %v67 : Bool
    je %v68, b16, b17

  b16:
    ret -6

  b17:
    jmp b18

  b18:
    ret 0
}

fn arithmetic(%v: Vec(I32)) -> I32 {
  b0:
    %v2 = vsplat 0 : Vec(I32)
    %v4 = vwithlane %v2, 1, 1 : Vec(I32)
    %v6 = vwithlane %v4, 2, 2 : Vec(I32)
    %indices = vwithlane %v6, 3, 3 : Vec(I32)
    %empty = vsplat 0 : Vec(I32)
    %v11 = cmp_lt %v, %indices : Mask(I32)
    %lower = select %v11 ? %v : %indices : Vec(I32)
    %v13 = cmp_gt %v, %indices : Mask(I32)
    %upper = select %v13 ? %v : %indices : Vec(I32)
    %v17 = vlane %lower, 0 : I32
    %v20 = cmp_ne %v17, 0 : Bool
    je %v20, b1, b2

  b1:
    ret -1

  b2:
    jmp b3

  b3:
    %v27 = vlane %upper, 0 : I32
    %v30 = cmp_ne %v27, 2 : Bool
    je %v30, b4, b5

  b4:
    ret -2

  b5:
    jmp b6

  b6:
    %v37 = vlane %lower, 1 : I32
    %v40 = cmp_ne %v37, 1 : Bool
    je %v40, b7, b8

  b7:
    ret -3

  b8:
    jmp b9

  b9:
    %v47 = vlane %upper, 1 : I32
    %v50 = cmp_ne %v47, 2 : Bool
    je %v50, b10, b11

  b10:
    ret -4

  b11:
    jmp b12

  b12:
    %negated = sub %empty, %v : Vec(I32)
    %v56 = abs %negated : Vec(I32)
    %v59 = vlane %v56, 0 : I32
    %v62 = cmp_ne %v59, 2 : Bool
    je %v62, b13, b14

  b13:
    ret -5

  b14:
    jmp b15

  b15:
    %v67 = abs %v : Vec(I32)
    %v70 = vlane %v67, 1 : I32
    %v73 = cmp_ne %v70, 2 : Bool
    je %v73, b16, b17

  b16:
    ret -6

  b17:
    jmp b18

  b18:
    ret 0
}

fn floats() -> I32 {
  b0:
    %v2 = neg 1.5 : F32
    %a = vsplat %v2 : Vec(F32)
    %zeros = vsplat 0 : Vec(F32)
    %v6 = abs %a : Vec(F32)
    %v9 = vlane %v6, 0 : F32
    %v12 = cmp_ne %v9, 1.5 : Bool
    je %v12, b1, b2

  b1:
    ret -1

  b2:
    jmp b3

  b3:
    %v17 = cmp_lt %a, %zeros : Mask(F32)
    %v18 = select %v17 ? %a : %zeros : Vec(F32)
    %v21 = vlane %v18, 0 : F32
    %v24 = neg 1.5 : F32
    %v25 = cmp_ne %v21, %v24 : Bool
    je %v25, b4, b5

  b4:
    ret -2

  b5:
    jmp b6

  b6:
    %v30 = cmp_gt %a, %zeros : Mask(F32)
    %v31 = select %v30 ? %a : %zeros : Vec(F32)
    %v34 = vlane %v31, 1 : F32
    %v37 = cmp_ne %v34, 0 : Bool
    je %v37, b7, b8

  b7:
    ret -3

  b8:
    jmp b9

  b9:
    %v43 = abs %zeros : Vec(F32)
    %v46 = vlane %v43, 0 : F32
    %v48 = div 1, %v46 : F32
    %v51 = cmp_lt %v48, 0 : Bool
    je %v51, b10, b11

  b10:
    ret -4

  b11:
    jmp b12

  b12:
    ret 0
}

fn rearrangement() -> I32 {
  b0:
    %v1 = vsplat 0 : Vec(I32)
    %v3 = vwithlane %v1, 1, 1 : Vec(I32)
    %v5 = vwithlane %v3, 2, 2 : Vec(I32)
    %indices = vwithlane %v5, 3, 3 : Vec(I32)
    %backwards = vshuffle %indices, %indices, 3, 2, 1, 0 : Vec(I32)
    %v12 = vlane %backwards, 0 : I32
    %v15 = sub %width, 1 : I32
    %v16 = cmp_ne %v12, %v15 : Bool
    je %v16, b1, b2

  b1:
    ret -1

  b2:
    jmp b3

  b3:
    %v23 = vlane %backwards, 1 : I32
    %v26 = sub %width, 2 : I32
    %v27 = cmp_ne %v23, %v26 : Bool
    je %v27, b4, b5

  b4:
    ret -2

  b5:
    jmp b6

  b6:
    %v34 = vshuffle %indices, %indices, 1, 2, 3, 0 : Vec(I32)
    %v37 = vlane %v34, 0 : I32
    %v40 = cmp_ne %v37, 1 : Bool
    je %v40, b7, b8

  b7:
    ret -3

  b8:
    jmp b9

  b9:
    %v47 = neg 1 : I32
    %v48 = vshuffle %indices, %indices, 3, 0, 1, 2 : Vec(I32)
    %v51 = vlane %v48, 0 : I32
    %v54 = sub %width, 1 : I32
    %v55 = cmp_ne %v51, %v54 : Bool
    je %v55, b10, b11

  b10:
    ret -4

  b11:
    jmp b12

  b12:
    %nines = vsplat 9 : Vec(I32)
    %low = vshuffle %indices, %nines, 0, 4, 1, 5 : Vec(I32)
    %high = vshuffle %indices, %nines, 2, 6, 3, 7 : Vec(I32)
    %v67 = vlane %low, 0 : I32
    %v70 = cmp_ne %v67, 0 : Bool
    je %v70, b13, b14

  b13:
    ret -5

  b14:
    jmp b15

  b15:
    %v77 = vlane %low, 1 : I32
    %v80 = cmp_ne %v77, 9 : Bool
    je %v80, b16, b17

  b16:
    ret -6

  b17:
    jmp b18

  b18:
    %v87 = vlane %high, 0 : I32
    %v90 = div %width, 2 : I32
    %v91 = cmp_ne %v87, %v90 : Bool
    je %v91, b19, b20

  b19:
    ret -7

  b20:
    jmp b21

  b21:
    %v98 = vlane %high, 1 : I32
    %v101 = cmp_ne %v98, 9 : Bool
    je %v101, b22, b23

  b22:
    ret -8

  b23:
    jmp b24

  b24:
    ret 0
}

fn regrouping(%v: Vec(I32)) -> I32 {
  b0:
    %other = vwithlane %v, 5, 0 : Vec(I32)
    %v6 = cast %v : Vec(I16, 4)
    %v7 = cast %other : Vec(I16, 4)
    %packed = vshuffle %v6, %v7, 0, 1, 2, 3, 4, 5, 6, 7 : Vec(I16)
    %v13 = mul 4, 2 : I32
    %v14 = cmp_ne 8, %v13 : Bool
    je %v14, b1, b2

  b1:
    ret -1

  b2:
    jmp b3

  b3:
    %v21 = vlane %packed, 0 : I16
    %v24 = cmp_ne %v21, 2 : Bool
    je %v24, b4, b5

  b4:
    ret -2

  b5:
    jmp b6

  b6:
    %v30 = vlane %packed, 4 : I16
    %v33 = cmp_ne %v30, 5 : Bool
    je %v33, b7, b8

  b7:
    ret -3

  b8:
    jmp b9

  b9:
    %v38 = vshuffle %packed, %packed, 0, 1, 2, 3 : Vec(I16, 4)
    %low = cast %v38 : Vec(I32)
    %v40 = vshuffle %packed, %packed, 4, 5, 6, 7 : Vec(I16, 4)
    %high = cast %v40 : Vec(I32)
    %v44 = vlane %low, 0 : I32
    %v47 = cmp_ne %v44, 2 : Bool
    je %v47, b10, b11

  b10:
    ret -4

  b11:
    jmp b12

  b12:
    %v54 = vlane %high, 0 : I32
    %v57 = cmp_ne %v54, 5 : Bool
    je %v57, b13, b14

  b13:
    ret -5

  b14:
    jmp b15

  b15:
    ret 0
}

fn main() -> I32 {
  b0:
    %v0 = load seed : I32
    %v = vsplat %v0 : Vec(I32)
    %v2 = call construction : I32
    %v5 = cmp_ne %v2, 0 : Bool
    je %v5, b1, b2

  b1:
    %v7 = call construction : I32
    ret %v7

  b2:
    jmp b3

  b3:
    %v10 = call arithmetic, %v : I32
    %v13 = cmp_ne %v10, 0 : Bool
    je %v13, b4, b5

  b4:
    %v15 = call arithmetic, %v : I32
    %v18 = mul %v15, 10 : I32
    ret %v18

  b5:
    jmp b6

  b6:
    %v21 = call floats : I32
    %v24 = cmp_ne %v21, 0 : Bool
    je %v24, b7, b8

  b7:
    %v26 = call floats : I32
    %v29 = mul %v26, 100 : I32
    ret %v29

  b8:
    jmp b9

  b9:
    %v32 = call rearrangement : I32
    %v35 = cmp_ne %v32, 0 : Bool
    je %v35, b10, b11

  b10:
    %v37 = call rearrangement : I32
    %v40 = mul %v37, 1000 : I32
    ret %v40

  b11:
    jmp b12

  b12:
    %v43 = load seed : I32
    %v44 = vsplat %v43 : Vec(I32)
    %v45 = call regrouping, %v44 : I32
    %v48 = cmp_ne %v45, 0 : Bool
    je %v48, b13, b14

  b13:
    %v50 = load seed : I32
    %v51 = vsplat %v50 : Vec(I32)
    %v52 = call regrouping, %v51 : I32
    %v55 = mul %v52, 10000 : I32
    ret %v55

  b14:
    jmp b15

  b15:
    ret 271
}
