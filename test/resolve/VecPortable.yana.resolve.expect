let image$base: () = <none>

let &seed: Int = 2

fn construction() -> Int {
  b0:
    %empty = vsplat 0 : Vec(Int)
    %v3 = vsplat 0 : Vec(Int)
    %v5 = vwithlane %v3, 1, 1 : Vec(Int)
    %v7 = vwithlane %v5, 2, 2 : Vec(Int)
    %indices = vwithlane %v7, 3, 3 : Vec(Int)
    %v12 = vlane %empty, 0 : Int
    %v15 = cmp_ne %v12, 0 : Bool
    je %v15, b1, b2

  b1:
    ret -1

  b2:
    jmp b3

  b3:
    %v22 = vlane %empty, 1 : Int
    %v25 = cmp_ne %v22, 0 : Bool
    je %v25, b4, b5

  b4:
    ret -2

  b5:
    jmp b6

  b6:
    %v32 = vlane %indices, 0 : Int
    %v35 = cmp_ne %v32, 0 : Bool
    je %v35, b7, b8

  b7:
    ret -3

  b8:
    jmp b9

  b9:
    %v42 = vlane %indices, 1 : Int
    %v45 = cmp_ne %v42, 1 : Bool
    je %v45, b10, b11

  b10:
    ret -4

  b11:
    jmp b12

  b12:
    %v53 = cmp_lt 4, 2 : Bool
    je %v53, b13, b14

  b13:
    ret -5

  b14:
    jmp b15

  b15:
    %v58 = vreduce_add %indices : Int
    %v63 = sub 4, 1 : Int
    %v64 = mul 4, %v63 : Int
    %v67 = div %v64, 2 : Int
    %v68 = cmp_ne %v58, %v67 : Bool
    je %v68, b16, b17

  b16:
