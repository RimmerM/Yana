  %21: Size = read copy.trivial (i)
  %22: Array(String) [shared call view] = read borrow.shared (xs) loan1
  %23: String [shared slot 0 view] = call.subscript get(Array(String), Size, String) borrow.shared %22 borrow.shared %21 roots{1}
  write.init borrow.unique (local5) borrow.shared %23
  %25: String [shared slot 0 view] = read borrow.shared (local5) loan2 roots{1}
  %26: (String) -> I32 [shared call] = read borrow.shared ($body) loan3
  %27: I32 = call inspect %26 borrow.shared %25
  %28: I32 = const 0
  %29: Bool = eq inspect %27 inspect %28
  write.assign borrow.unique ($yielded) take %27
