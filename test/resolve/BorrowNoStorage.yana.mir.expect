bb2(%3: String [shared call view]) handover(String [shared call view]) many -> bb1:
  write.init borrow.unique (v) borrow.shared %3
  %6: String [shared call view] = read borrow.shared (v) loan1 roots{0}
  %7: String [shared call view] = read borrow.shared (wanted) loan2
  %8: Bool = call ==(String) borrow.shared %6 borrow.shared %7
  branch inspect %8 -> bb5 -> bb3

bb3 handover(String [shared call view]) many:
