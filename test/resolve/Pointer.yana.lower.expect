compareAddresses<complex>(): Long {
  b_0 {
    %node = alloca 16, 8: Ptr
    %v_1 = bitcast 0: Ptr
    store %node, 0, 8
    %v_2 = add %node, 8: Ptr
    store %v_2, %v_1, 8
    %v_3 = add %node, 16: Ptr
    %v_4 = cmp_lt %node, %v_3: Int
    je %v_4, b_5, b_6
  }

  b_5 {
    jmp b_6
  }

  b_6 {
    %v_7 = phi [b_0, 0], [b_5, 1]: Long
    %v_8 = add %v_7, 2: Long
    %v_9 = bitcast %v_1: Long
    %v_10 = cmp_eq %v_9, 0: Int
    je %v_10, b_11, b_12
  }

  b_11 {
    %v_13 = add %v_8, 4: Long
    jmp b_12
  }

  b_12 {
    %v_14 = phi [b_6, %v_8], [b_11, %v_13]: Long
    %v_15 = bitcast %node: Long
    %v_16 = cmp_eq %v_15, 0: Int
    je %v_16, b_17, b_18
  }

  b_18 {
    %v_19 = add %v_14, 8: Long
    jmp b_17
  }

  b_17 {
    %v_20 = phi [b_12, %v_14], [b_18, %v_19]: Long
    ret %v_20
  }
}

unwrapPointer<complex>(%value: Ptr): Long {
  b_0 {
    %v_1 = loads %value, 4: Int
    %v_2 = cmp_eq %v_1, 1: Int
    je %v_2, b_3, b_4
  }

  b_4 {
    jmp b_5
  }

  b_3 {
    %v_6 = add %value, 8: Ptr
    %p = load %v_6, 8: Ptr
    %v_7 = bitcast %p: Long
    %v_8 = cmp_eq %v_7, 0: Int
    %v_9 = select %v_8, 0, 1: Long
    jmp b_5
  }

  b_5 {
    %v_10 = phi [b_3, %v_9], [b_4, 0]: Long
    ret %v_10
  }
}

