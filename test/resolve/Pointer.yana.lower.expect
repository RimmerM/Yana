    %v_2 = add %node, 8: Ptr
    store %v_2, %v_1, 8
    %v_3 = add %node, 16: Ptr
    %v_4 = cmp_lt %node, %v_3: Int
    je %v_4, b_5, b_6
  }

  b_5 {
    jmp b_6
  }

  b_6 {
    %v_7 = phi [b_0, 0], [b_5, 1]: Long
    %v_8 = add %v_7, 2: Long
    %v_9 = bitcast %v_1: Long
    %v_10 = cmp_eq %v_9, 0: Int
    je %v_10, b_11, b_12
