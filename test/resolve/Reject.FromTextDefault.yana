{-
   A string literal in a constant position at a type whose `FromText` instance is a program's own.

   # resolver: ownership

   That `fromText` is a call with a body, and a field default is a constant, so the literal is refused
   in the words a number gets at a type with a declared `FromInt`. At a `Char` or an integer the same
   position folds (`FromText.yana`'s `Separators`).
-}

data Token {text: String}

instance FromText(Token):
    fn fromText(value: String) -> Token = Token {text: copy(value)}

data Holder {token: Token = "t"}

fn main() -> Int = 0
