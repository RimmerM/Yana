{-
   The conversions that change a vector's lane count - `unpackLow`, `unpackHigh` and `packLanes` -
   at every integer lane width and both signednesses, at 256 bits.

   # extensions: v3

   The interleaves and the byte gather work inside each 128-bit half at this width, so the rewrite
   adds an exchange of halves to the one and a `vpermd` to the other.

   The x64 backend has no register for the half-width value between the two instructions each of
   these is written as, so `expandLaneCountConversions` rewrites the pair into interleaves, gathers
   and bitcasts. Every lane is checked against the scalar conversion of the lane it came from, so a
   gather reading the wrong byte or an interleave reading the wrong half answers a number other than
   zero, and the number names the pair and the lane. A lane index has to be written down, which is
   why the checks are spelled out one lane at a time.
-}

@noinline fn widenU8(v: Vec(U8)) -> Int:
    let low = unpackLow(v) :: Vec(U16)
    let high = unpackHigh(v) :: Vec(U16)

    if lane(low, 0) != (lane(v, 0) :: U16) then return 1000
    if lane(high, 0) != (lane(v, 16) :: U16) then return 1100
    if lane(low, 1) != (lane(v, 1) :: U16) then return 1001
    if lane(high, 1) != (lane(v, 17) :: U16) then return 1101
    if lane(low, 2) != (lane(v, 2) :: U16) then return 1002
    if lane(high, 2) != (lane(v, 18) :: U16) then return 1102
    if lane(low, 3) != (lane(v, 3) :: U16) then return 1003
    if lane(high, 3) != (lane(v, 19) :: U16) then return 1103
    if lane(low, 4) != (lane(v, 4) :: U16) then return 1004
    if lane(high, 4) != (lane(v, 20) :: U16) then return 1104
    if lane(low, 5) != (lane(v, 5) :: U16) then return 1005
    if lane(high, 5) != (lane(v, 21) :: U16) then return 1105
    if lane(low, 6) != (lane(v, 6) :: U16) then return 1006
    if lane(high, 6) != (lane(v, 22) :: U16) then return 1106
    if lane(low, 7) != (lane(v, 7) :: U16) then return 1007
    if lane(high, 7) != (lane(v, 23) :: U16) then return 1107
    if lane(low, 8) != (lane(v, 8) :: U16) then return 1008
    if lane(high, 8) != (lane(v, 24) :: U16) then return 1108
    if lane(low, 9) != (lane(v, 9) :: U16) then return 1009
    if lane(high, 9) != (lane(v, 25) :: U16) then return 1109
    if lane(low, 10) != (lane(v, 10) :: U16) then return 1010
    if lane(high, 10) != (lane(v, 26) :: U16) then return 1110
    if lane(low, 11) != (lane(v, 11) :: U16) then return 1011
    if lane(high, 11) != (lane(v, 27) :: U16) then return 1111
    if lane(low, 12) != (lane(v, 12) :: U16) then return 1012
    if lane(high, 12) != (lane(v, 28) :: U16) then return 1112
    if lane(low, 13) != (lane(v, 13) :: U16) then return 1013
    if lane(high, 13) != (lane(v, 29) :: U16) then return 1113
    if lane(low, 14) != (lane(v, 14) :: U16) then return 1014
    if lane(high, 14) != (lane(v, 30) :: U16) then return 1114
    if lane(low, 15) != (lane(v, 15) :: U16) then return 1015
    if lane(high, 15) != (lane(v, 31) :: U16) then return 1115

    return 0

@noinline fn narrowU8(a: Vec(U16), b: Vec(U16)) -> Int:
    let packed = packLanes(a, b) :: Vec(U8)

    if lane(packed, 0) != (truncate(lane(a, 0)) :: U8) then return 1200
    if lane(packed, 16) != (truncate(lane(b, 0)) :: U8) then return 1300
    if lane(packed, 1) != (truncate(lane(a, 1)) :: U8) then return 1201
    if lane(packed, 17) != (truncate(lane(b, 1)) :: U8) then return 1301
    if lane(packed, 2) != (truncate(lane(a, 2)) :: U8) then return 1202
    if lane(packed, 18) != (truncate(lane(b, 2)) :: U8) then return 1302
    if lane(packed, 3) != (truncate(lane(a, 3)) :: U8) then return 1203
    if lane(packed, 19) != (truncate(lane(b, 3)) :: U8) then return 1303
    if lane(packed, 4) != (truncate(lane(a, 4)) :: U8) then return 1204
    if lane(packed, 20) != (truncate(lane(b, 4)) :: U8) then return 1304
    if lane(packed, 5) != (truncate(lane(a, 5)) :: U8) then return 1205
    if lane(packed, 21) != (truncate(lane(b, 5)) :: U8) then return 1305
    if lane(packed, 6) != (truncate(lane(a, 6)) :: U8) then return 1206
    if lane(packed, 22) != (truncate(lane(b, 6)) :: U8) then return 1306
    if lane(packed, 7) != (truncate(lane(a, 7)) :: U8) then return 1207
    if lane(packed, 23) != (truncate(lane(b, 7)) :: U8) then return 1307
    if lane(packed, 8) != (truncate(lane(a, 8)) :: U8) then return 1208
    if lane(packed, 24) != (truncate(lane(b, 8)) :: U8) then return 1308
    if lane(packed, 9) != (truncate(lane(a, 9)) :: U8) then return 1209
    if lane(packed, 25) != (truncate(lane(b, 9)) :: U8) then return 1309
    if lane(packed, 10) != (truncate(lane(a, 10)) :: U8) then return 1210
    if lane(packed, 26) != (truncate(lane(b, 10)) :: U8) then return 1310
    if lane(packed, 11) != (truncate(lane(a, 11)) :: U8) then return 1211
    if lane(packed, 27) != (truncate(lane(b, 11)) :: U8) then return 1311
    if lane(packed, 12) != (truncate(lane(a, 12)) :: U8) then return 1212
    if lane(packed, 28) != (truncate(lane(b, 12)) :: U8) then return 1312
    if lane(packed, 13) != (truncate(lane(a, 13)) :: U8) then return 1213
    if lane(packed, 29) != (truncate(lane(b, 13)) :: U8) then return 1313
    if lane(packed, 14) != (truncate(lane(a, 14)) :: U8) then return 1214
    if lane(packed, 30) != (truncate(lane(b, 14)) :: U8) then return 1314
    if lane(packed, 15) != (truncate(lane(a, 15)) :: U8) then return 1215
    if lane(packed, 31) != (truncate(lane(b, 15)) :: U8) then return 1315

    return 0

