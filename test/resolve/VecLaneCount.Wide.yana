@noinline fn narrowU32(a: Vec(U64), b: Vec(U64)) -> Int:
    let packed = packLanes(a, b) :: Vec(U32)

    if lane(packed, 0) != (truncate(lane(a, 0)) :: U32) then return 5200
    if lane(packed, 4) != (truncate(lane(b, 0)) :: U32) then return 5300
    if lane(packed, 1) != (truncate(lane(a, 1)) :: U32) then return 5201
    if lane(packed, 5) != (truncate(lane(b, 1)) :: U32) then return 5301
    if lane(packed, 2) != (truncate(lane(a, 2)) :: U32) then return 5202
    if lane(packed, 6) != (truncate(lane(b, 2)) :: U32) then return 5302
