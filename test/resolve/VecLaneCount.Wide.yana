@noinline fn widenI32(v: Vec(I32)) -> Int:
    let low = unpackLow(v) :: Vec(I64)
    let high = unpackHigh(v) :: Vec(I64)

    if lane(low, 0) != (lane(v, 0) :: I64) then return 6000
    if lane(high, 0) != (lane(v, 4) :: I64) then return 6100
    if lane(low, 1) != (lane(v, 1) :: I64) then return 6001
    if lane(high, 1) != (lane(v, 5) :: I64) then return 6101
    if lane(low, 2) != (lane(v, 2) :: I64) then return 6002
    if lane(high, 2) != (lane(v, 6) :: I64) then return 6102
    if lane(low, 3) != (lane(v, 3) :: I64) then return 6003
    if lane(high, 3) != (lane(v, 7) :: I64) then return 6103

    return 0

@noinline fn narrowI32(a: Vec(I64), b: Vec(I64)) -> Int:
    let packed = packLanes(a, b) :: Vec(I32)

    if lane(packed, 0) != (truncate(lane(a, 0)) :: I32) then return 6200
    if lane(packed, 4) != (truncate(lane(b, 0)) :: I32) then return 6300
    if lane(packed, 1) != (truncate(lane(a, 1)) :: I32) then return 6201
    if lane(packed, 5) != (truncate(lane(b, 1)) :: I32) then return 6301
    if lane(packed, 2) != (truncate(lane(a, 2)) :: I32) then return 6202
    if lane(packed, 6) != (truncate(lane(b, 2)) :: I32) then return 6302
    if lane(packed, 3) != (truncate(lane(a, 3)) :: I32) then return 6203
    if lane(packed, 7) != (truncate(lane(b, 3)) :: I32) then return 6303

    return 0

fn main() -> Int:
    let valuesU8 = (iota() :: Vec(U8)) * splat(37 :: U8) + splat(201 :: U8)
    if widenU8(valuesU8) != 0 then return widenU8(valuesU8)

    let wideU8 = (iota() :: Vec(U16)) * splat(37 :: U16) + splat(201 :: U16) * splat(3 :: U16)
    let otherU8 = (iota() :: Vec(U16)) * splat(7 :: U16) - splat(201 :: U16)
    if narrowU8(wideU8, otherU8) != 0 then return narrowU8(wideU8, otherU8)

    let valuesI8 = (iota() :: Vec(I8)) * splat(-45 :: I8) + splat(77 :: I8)
    if widenI8(valuesI8) != 0 then return widenI8(valuesI8)

    let wideI8 = (iota() :: Vec(I16)) * splat(-45 :: I16) + splat(77 :: I16) * splat(3 :: I16)
    let otherI8 = (iota() :: Vec(I16)) * splat(7 :: I16) - splat(77 :: I16)
    if narrowI8(wideI8, otherI8) != 0 then return narrowI8(wideI8, otherI8)

    let valuesU16 = (iota() :: Vec(U16)) * splat(4099 :: U16) + splat(65001 :: U16)
    if widenU16(valuesU16) != 0 then return widenU16(valuesU16)

    let wideU16 = (iota() :: Vec(U32)) * splat(4099 :: U32) + splat(65001 :: U32) * splat(3 :: U32)
    let otherU16 = (iota() :: Vec(U32)) * splat(7 :: U32) - splat(65001 :: U32)
    if narrowU16(wideU16, otherU16) != 0 then return narrowU16(wideU16, otherU16)

    let valuesI16 = (iota() :: Vec(I16)) * splat(-12345 :: I16) + splat(301 :: I16)
    if widenI16(valuesI16) != 0 then return widenI16(valuesI16)

    let wideI16 = (iota() :: Vec(I32)) * splat(-12345 :: I32) + splat(301 :: I32) * splat(3 :: I32)
    let otherI16 = (iota() :: Vec(I32)) * splat(7 :: I32) - splat(301 :: I32)
    if narrowI16(wideI16, otherI16) != 0 then return narrowI16(wideI16, otherI16)

    let valuesU32 = (iota() :: Vec(U32)) * splat(2654435761 :: U32) + splat(4000000000 :: U32)
    if widenU32(valuesU32) != 0 then return widenU32(valuesU32)

    let wideU32 = (iota() :: Vec(U64)) * splat(2654435761 :: U64) + splat(4000000000 :: U64) * splat(3 :: U64)
    let otherU32 = (iota() :: Vec(U64)) * splat(7 :: U64) - splat(4000000000 :: U64)
    if narrowU32(wideU32, otherU32) != 0 then return narrowU32(wideU32, otherU32)

    let valuesI32 = (iota() :: Vec(I32)) * splat(-1640531535 :: I32) + splat(123 :: I32)
    if widenI32(valuesI32) != 0 then return widenI32(valuesI32)

    let wideI32 = (iota() :: Vec(I64)) * splat(-1640531535 :: I64) + splat(123 :: I64) * splat(3 :: I64)
    let otherI32 = (iota() :: Vec(I64)) * splat(7 :: I64) - splat(123 :: I64)
    if narrowI32(wideI32, otherI32) != 0 then return narrowI32(wideI32, otherI32)

    return 7
