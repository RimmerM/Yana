{-
   `&` parameters, and the compound assignments Core writes on top of them.

   `.opt.expect` is here for what happens *after* the calls are inlined. A borrow whose only uses are
   reads and writes through it is not a reference anything needs, and opt_borrow.cpp splices it out -
   which is what takes `total`, `left` and `right` out of the boxes a managed target keeps a mutably
   borrowed local in, and lets the whole of `main` except `here` fold to a constant.

   `here` is the one that stays, and it is the assertion that matters as much as the others: `moveBy`
   borrows a *field*, which is Design.md's tier 1 - a target may have packed it, so the borrow is a
   temporary that has to be written back when the loan ends, and the loan ends at the call. Inlining
   the call would take the write-back with it, so opt_inline.cpp declines a `&` argument with a path
   and the object survives.
-}

fn bump(&counter: Int, by: Int) -> {}:
    counter = counter + by

fn swap(&a: Int, &b: Int) -> {}:
    let old = a
    a = b
    b = old

data Point {x: Int, y: Int}

-- A `&` parameter of a memory type is the same thing: the argument is the address of the caller's
-- storage either way, and a field of it is an ordinary projection off that root.
fn moveBy(&p: Point, dx: Int, dy: Int) -> {}:
    p.x += dx
    p.y += dy

-- Reading a TrivialCopy value out through a live mutable borrow is legal, and deliberately so.
-- Design.md: producing a copy is a different operation from handing out a second borrow, so it
-- does not require suspending exclusivity - which is exactly why `let &y = 0; let z = y` leaves
-- `y` exclusive and valid while `z` becomes an independent copy.
fn copyThroughBorrow(&target: Int, amount: Int) -> {}:
    target = target + amount

fn main() -> Int:
    let &total = 0 :: Int
    bump(total, 5)
    total += 3
    total *= 2

    let &left = 1 :: Int
    let &right = 2 :: Int
    swap(left, right)

    let &here = Point {x: 10, y: 20}
    moveBy(here, 1, 2)

    -- `total` is both mutably borrowed and read by copy in one call.
    copyThroughBorrow(total, total)

    -- 32 + (2 - 1) + 11 + 22 = 66
    return total + (left - right) + here.x + here.y
