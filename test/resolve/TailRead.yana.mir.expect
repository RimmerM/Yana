module ResolveTest

let guardWidth: Size = 63

fn readPast(block: %U8 [shared call], size: Size [shared call]) -> I64 {
  local & sum: I64
  local & i: Size

bb0:
  %0: I64 = const 0
  write.init borrow.unique (sum) take %0
  %2: Size = const 0
  write.init borrow.unique (i) take %2
  jump -> bb1

bb1:
  %5: Size = read copy.trivial (i)
  %6: Size = const 63
  %7: Bool = lt inspect %5 inspect %6
  branch inspect %7 -> bb3 -> bb2

bb2:
  %26: I64 = read copy.trivial (sum)
  return take %26

bb3:
  %9: I64 = read copy.trivial (sum)
  %10: %U8 = read copy.trivial (block)
  %11: Size = read copy.trivial (size)
  %12: Size = read copy.trivial (i)
  %13: Size = add inspect %11 inspect %12
  %14: Size = metric stride U8
  %15: Size = mul inspect %13 inspect %14
  %16: %U8 [owned here shape6 .*=shared slot 0] = add inspect %10 inspect %15
  %17: U8 = read copy.trivial ([%%16])
  %18: I64 = convert inspect %17
  %19: I64 = add inspect %9 inspect %18
  write.assign borrow.unique (sum) take %19
  %21: Size = read copy.trivial (i)
  %22: Size = const 1
  %23: Size = add inspect %21 inspect %22
  write.assign borrow.unique (i) take %23
  jump -> bb1
}

fn main() -> I32 {
  local & request: Size
  local & seen: I64
  local block: %U8
  local & last: %U8
  local & steps: I64
  local block: %U8

bb0:
