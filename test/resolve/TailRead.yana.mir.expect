bb4:
  jump -> bb5

bb5:
  %18: %U8 = read copy.trivial (block)
  %19: Size = read copy.trivial (request)
  %20: I64 = call readPast borrow.shared %18 borrow.shared %19
  %21: I64 = const 0
  %22: Bool = lt inspect %20 inspect %21
  branch inspect %22 -> bb9 -> bb7

bb6:
  %15: I32 = const -1
  return take %15

bb7:
  jump -> bb8

bb8:
  %27: I64 = read copy.trivial (seen)
  %28: I64 = const 1
  %29: I64 = add inspect %27 inspect %28
  write.assign borrow.unique (seen) take %29
  %31: Size = read copy.trivial (request)
  %32: Size = read copy.trivial (request)
  %33: Size = add inspect %31 inspect %32
  write.assign borrow.unique (request) take %33
  jump -> bb1

bb9:
  %24: I32 = const -2
  return take %24

bb10:
  jump -> bb11

bb11:
  %43: %U8 = call null(U8)
  write.init borrow.unique (last) take %43
  %45: I64 = const 0
  write.init borrow.unique (steps) take %45
  jump -> bb13

bb12:
  %40: I32 = const -3
  return take %40

bb13:
  %48: %U8 = read copy.trivial (global heapNext)
  %49: %U8 = read copy.trivial (global heapLimit)
  %50: Size = bitcast inspect %49
  %51: Size = bitcast inspect %48
  %52: Size = sub inspect %50 inspect %51
  %53: Size = metric stride U8
  %54: Size = div inspect %52 inspect %53
  %55: Size = const 63
  %56: Bool = gt inspect %54 inspect %55
  branch inspect %56 -> bb15 -> bb14

bb14:
  %81: %U8 = read copy.trivial (last)
  %82: Bool = call isNull(U8) borrow.shared %81
  branch inspect %82 -> bb24 -> bb22

bb15:
  %58: Size = const 8
  %59: %U8 = call allocateHeap borrow.shared %58
  write.init borrow.unique (block) take %59
  %61: %U8 = read copy.trivial (block)
  %62: Bool = call isNull(U8) borrow.shared %61
  branch inspect %62 -> bb18 -> bb16

bb16:
  jump -> bb17

bb17:
  %67: %U8 = read copy.trivial (block)
  write.assign borrow.unique (last) take %67
  %69: I64 = read copy.trivial (steps)
  %70: I64 = const 1
  %71: I64 = add inspect %69 inspect %70
  write.assign borrow.unique (steps) take %71
  %73: I64 = read copy.trivial (steps)
  %74: I64 = const 300000
  %75: Bool = gt inspect %73 inspect %74
  branch inspect %75 -> bb21 -> bb19

bb18:
  %64: I32 = const -4
  return take %64

bb19:
  jump -> bb20

bb20:
  jump -> bb13

bb21:
  %77: I32 = const -5
  return take %77

bb22:
  jump -> bb23

bb23:
  %87: %U8 = read copy.trivial (last)
  %88: Size = const 8
  %89: I64 = call readPast borrow.shared %87 borrow.shared %88
  %90: I64 = const 0
  %91: Bool = lt inspect %89 inspect %90
