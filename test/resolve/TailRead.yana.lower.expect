    %v_8 = phi [b_2, %v_4], [b_0, 0]: I64
    %v_9 = add %size, %v_8: I64
    %v_10 = add %block, %v_9: Ptr
    %v_11 = load %v_10, 1: I32
    %v_12 = cast %v_11: I64
    %v_6 = add %v_7, %v_12: I64
    %v_4 = add %v_8, 1: I64
