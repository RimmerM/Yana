  b_38 {
    %block = load @heapNext, 8: Ptr
    %v_41 = add %block, %v_31: Ptr
    store @heapNext, %v_41, 8
    store %block, %v_17, 8
    %v_42 = add %block, 8: Ptr
    ret %v_42
  }

  b_10 {
    %v_43 = bitcast 0: Ptr
    ret %v_43
  }

  b_30 {
    %v_44 = load %v_26, 8: Ptr
    store %v_25, %v_44, 8
    ret %v_26
  }

  b_15 {
    %v_16 = add %v_14, %v_14: I64
    %v_18 = add %v_17, 1: I64
    jmp b_13
  }
}

readPast<complex>(%block: Ptr, %size: I64): I64 {
  b_0 {
