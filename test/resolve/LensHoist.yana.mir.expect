fn add(x: I32 [shared call], y: I32 [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (x)
  %1: I32 = read copy.trivial (y)
  %2: I32 = add inspect %0 inspect %1
  return take %2
}

fn hoisted() -> I32 {
  local $lens0: I32 [shared call]
  local seen: I32

bb0:
  %0: I32 = const 1
  lens.call logged(I32) borrow.shared %0 -> bb1

bb1(%1: I32 [shared call]) handover(I32 [shared call]):
  write.init borrow.unique ($lens0) borrow.shared %1
  %4: I32 = read copy.trivial ($lens0)
  %5: I32 = call twice borrow.shared %4
  write.init borrow.unique (seen) take %5
  %7: I32 = read copy.trivial (seen)
  return take %7
}

fn cleanupRan() -> I32 {
  local seen: I32

bb0:
  %0: I32 = call hoisted
  write.init borrow.unique (seen) take %0
  %2: I32 = read copy.trivial (seen)
  %3: I32 = read copy.trivial (global log)
  %4: I32 = add inspect %2 inspect %3
  return take %4
}

