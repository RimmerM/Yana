fn main() -> I32 {
  local a: I32
  local b: I32
  local c: I32
  local d: I32

bb0:
  %0: I32 = call cleanupRan
  write.init borrow.unique (a) take %0
  %2: I32 = call twoInOne
  write.init borrow.unique (b) take %2
  %4: I32 = call nested
  write.init borrow.unique (c) take %4
  %6: I32 = call inReturn
  write.init borrow.unique (d) take %6
  %8: I32 = read copy.trivial (a)
  %9: I32 = const 1000000
  %10: I32 = mul inspect %8 inspect %9
  %11: I32 = read copy.trivial (b)
  %12: I32 = const 1000
  %13: I32 = mul inspect %11 inspect %12
  %14: I32 = add inspect %10 inspect %13
  %15: I32 = read copy.trivial (c)
  %16: I32 = const 10
  %17: I32 = mul inspect %15 inspect %16
  %18: I32 = add inspect %14 inspect %17
  %19: I32 = read copy.trivial (d)
  %20: I32 = add inspect %18 inspect %19
