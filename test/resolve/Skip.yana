-- Skipping lenses - Design.md's Transparent and skipping lenses, doc/spec/lenses.md.
--
-- A lens that declares a failure channel may return without entering its continuation at all. The
-- ability to skip is in the signature, as the `| E` of the result `-> (T | E)`, and it is at the
-- call site, as the alternative that channel makes mandatory. Neither half can be left out.

{-
   # resolver: ownership

   This fixture used to be written in the explicit-callback form with
   a *wrapper* result - `lens fn f(n, body: (x: Int) -> a) -> Maybe(a)`, skipping with
   `return Nothing` and proceeding with `return Just(body(...))` - which lenses.md no longer
   specifies: skipping is the failure channel, `return e` fails, and `yield` proceeds. The shipping
   stage builds only the old form, so this is the rewritten stage's alone;
   `lens/Skipping*.yana` are its neighbours.
-}

let &log = 0 :: Int

-- The `findChar` shape: what the lens hands over does not exist for every input, so the not-found
-- path fails and the continuation never runs. It fails with `{}`, which carries nothing, and that is
-- why `| else -> ...` is all a call site here writes. The line after the `yield` runs once the
-- continuation is done, on every path out of it.
lens fn findFirst(n: Int) -> (Int | {}):
    log = log + 1
    if n <= 0: return {}

    yield n * 2
    log = log + 100

-- A channel that says *why* it skipped. The alternatives match what the failure carried: the
-- continuation did not run, so nothing of its shape exists here to match on.
lens fn checked(n: Int) -> (Int | Int):
    if n > 9: return 1
    if n < 0: return 2

    yield n

-- A skipping lens that hands nothing over, which is `tryLock`'s shape. An extent covering nothing is
-- an error, so the extent is written - `let _ = ... in:` - and the wildcard binds nothing; the
-- declaration exists for its block and its alternative.
lens fn attempt(open: Bool) -> ({} | {}):
    if !open: return {}

    log = log + 1000
    yield {}

-- Every path of the block below leaves the enclosing function, so what the continuation returns is
-- that function's own result and the alternative leaves too.
fn always(n: Int) -> Int:
    let found = findFirst(n) | else -> return 0
    return found + 1

-- The alternative does something instead of leaving, which is a rule the guard form does not have:
-- there is no rest of the block for a binding to have to be live across, because the rest of the
-- block *is* the continuation and on this path it did not run. This used to be an `if` expression
-- whose branch's *value* was the continuation's, with `| else -> 7` producing it; the rewritten
-- stage does not build an extent that covers the value of its block yet, so both sides assign.
fn valued(n: Int) -> Int:
    if n >= 100: return 0

    let &result = 0 :: Int
    let found = findFirst(n) | else -> result = 7
    result = found * 3
    return result

-- The block below both falls through and leaves, which is the one shape the exit signal is wrapped
-- for. The two joins then nest: the outer test asks whether the continuation ran at all, and the
-- inner one whether it left the enclosing function when it did.
fn mixed(n: Int) -> Int:
    let &total = 0 :: Int

    if n != 0:
        let found = findFirst(n) | else -> return 5
        if found > 100: return found
        total = total + found

    return total + 1

-- The reason bound. A wildcard alternative would work here too; naming it is what a channel that
-- carries something is for.
fn reasoned(n: Int) -> Int:
    let value = checked(n) | code -> return code * 10
    return value + 1

fn guarded(open: Bool) -> Int:
    let _ = attempt(open) | else -> return 0 in:
        return 3

lens fn doubled(x: Int) -> Int:
    log = log + 1
    yield x * 2
    log = log + 10

-- A skipping call inside a transparent lens's continuation. The alternative is an ordinary statement
-- of the block it was written in, so its `return` is the exit signal of the frame *that* block was
-- split out of - and `doubled`'s cleanup runs on the skip path exactly as it does on the other.
fn nested(n: Int) -> Int:
    let d = doubled(n)
    let found = findFirst(d) | else -> return 0
    return found + d

-- This was the continuation written out at the call site, `findFirst(n, (found: Int) -> found * 5)`
-- matched as a `Maybe`. A lens declared with `yield` is not called that way, and the explicit-callback
-- form is the `Lens` gap in the rewritten stage, so the same computation is the flat form here.
fn written(n: Int) -> Int:
    let found = findFirst(n) | else -> return 0
    return found * 5

fn main() -> Int:
    log = 0
    let a = always(3)        -- 7,   log 101
    let b = always(-1)       -- 0,   log 102
    let c = valued(4)        -- 24,  log 203
    let d = valued(-2)       -- 7,   log 204
    let e = mixed(2)         -- 5,   log 305
    let f = mixed(-3)        -- 5,   log 306
    let g = reasoned(4)      -- 5
    let h = reasoned(20)     -- 10
    let i = reasoned(-1)     -- 20
    let j = guarded(True)    -- 3,   log 1306
    let k = guarded(False)   -- 0
    let l = written(6)       -- 60,  log 1407
    let m = nested(3)        -- 18,  log 1519
    let n = nested(-1)       -- 0,   log 1531

    -- 164, plus log 1531.
    return a + b + c + d + e + f + g + h + i + j + k + l + m + n + log
