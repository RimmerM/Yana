  b_11 {
    %v_12 = loads %v_6, 4: I32
    call_complex Array(a).reclaim(I32), %v_2
    %v_13 = add %v_9, %v_12: I32
    %v_14 = add %v_1, %v_13: I32
    %v_15 = alloca 16, 8: Ptr
    %v_16 = alloca 12, 4: Ptr
    store %v_15, %v_16, 8
    %v_17 = add %v_15, 8: Ptr
    store %v_17, 3, 4
    %v_18 = add %v_15, 12: Ptr
    store %v_18, 3, 4
    store %v_16, 1, 4
    %v_19 = add %v_16, 4: Ptr
    store %v_19, 2, 4
    %v_20 = add %v_16, 8: Ptr
