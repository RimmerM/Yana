  }

  b_22 {
    %v_23 = loads %v_16, 4: I32
    jmp b_24
  }

  b_24 {
    %v_25 = loads %v_19, 4: I32
    %v_26 = add %v_23, %v_25: I32
    jmp b_27
  }

  b_27 {
    %v_28 = loads %v_20, 4: I32
    call_complex Array(a).reclaim(I32), %v_15
    %v_29 = add %v_26, %v_28: I32
    %v_30 = add %v_14, %v_29: I32
    %v_31 = loads @log, 4: I32
    %v_32 = add %v_30, %v_31: I32
