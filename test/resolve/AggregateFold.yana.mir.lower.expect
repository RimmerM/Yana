mut @log = [0, 0, 0, 0]
mut @heapFree = [0, 0, 0, 0, 0, 0, 0, 0]

later<complex>(%seed: I32): I32 {
  b_0 {
    %v_1 = alloca 16, 8: Ptr
    %v_2 = alloca 12, 4: Ptr
    store %v_1, %v_2, 8
    %v_3 = add %v_1, 8: Ptr
    store %v_3, 3, 4
    %v_4 = add %v_1, 12: Ptr
    store %v_4, 3, 4
    store %v_2, 1, 4
    %v_5 = add %v_2, 4: Ptr
    store %v_5, 2, 4
    %v_6 = add %v_2, 8: Ptr
    store %v_6, 3, 4
    %v_7 = loads @log, 4: I32
    %v_8 = add %v_7, %seed: I32
    store @log, %v_8, 4
    %v_9 = loads @log, 4: I32
    %v_10 = cmp_igt %v_9, 1000: I32
    %v_11 = select %v_10, 0, %seed: I32
    jmp b_12
  }

  b_12 {
    store %v_5, %v_11, 4
    jmp b_13
  }

  b_13 {
    %v_14 = loads %v_2, 4: I32
    jmp b_15
  }

  b_15 {
    %v_16 = loads %v_5, 4: I32
    %v_17 = add %v_14, %v_16: I32
    jmp b_18
  }

  b_18 {
    %v_19 = loads %v_6, 4: I32
    call_complex Array(a).reclaim(I32), %v_1
    %v_20 = add %v_17, %v_19: I32
    ret %v_20
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = call_complex later, 20: I32
    %v_2 = alloca 16, 8: Ptr
    %v_3 = alloca 12, 4: Ptr
    store %v_2, %v_3, 8
    %v_4 = add %v_2, 8: Ptr
