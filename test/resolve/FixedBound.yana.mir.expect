fn sumOf(xs: [I32 *n] [shared call]) -> I32 {
  form specialized
  slot #0 const n
  local & total: I32
  local & i: I32

bb0:
  %0: I32 = const 0
  write.init borrow.unique (total) take %0
  %2: I32 = const 0
  write.init borrow.unique (i) take %2
  jump -> bb1

bb1:
  %5: I32 = read copy.trivial (i)
  %6: I32 = gen.value n
  %7: Bool = lt inspect %5 inspect %6
  branch inspect %7 -> bb3 -> bb2

bb2:
  %25: I32 = read copy.trivial (total)
  return take %25

bb3:
  %9: I32 = read copy.trivial (total)
  %10: I32 = read copy.trivial (i)
  %11: Size = convert inspect %10
  %12: I32 = gen.value n
  %13: USize = convert inspect %12
  %14: USize = bitcast inspect %11
  %15: Bool = ge inspect %14 inspect %13
  %16: {} = call checkCondition borrow.shared %15
