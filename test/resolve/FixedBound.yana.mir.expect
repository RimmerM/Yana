  %18: I32 = add inspect %9 inspect %17
  write.assign borrow.unique (total) take %18
  %20: I32 = read copy.trivial (i)
  %21: I32 = const 1
  %22: I32 = add inspect %20 inspect %21
  write.assign borrow.unique (i) take %22
