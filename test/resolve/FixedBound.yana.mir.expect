}

fn main() -> I32 {
  local block: [I32 *4]

bb0:
  %0: I32 = const 1
  %1: I32 = const 2
  %2: I32 = const 3
  %3: I32 = const 4
  %4: [I32 *4] = aggregate.0 take %0 take %1 take %2 take %3
  write.init borrow.unique (block) take %4
