trailingPattern<complex>(%m: Ptr): I32 {
  b_0 {
    %v_1 = alloca 1, 1: Ptr
    %v_2 = load %m, 1: I64
    %v_3 = cmp_le %v_2, 2: I32
    %v_4 = select %v_3, 1, 0: I32
    %v_5 = cmp_eq %v_4, 1: I32
    je %v_5, b_6, b_7
  }

  b_7 {
    ret 0
