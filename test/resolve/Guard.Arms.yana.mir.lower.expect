
colorValue<complex>(%c: I32): I32 {
  b_0 {
    %v_1 = alloca 1, 1: Ptr
    store %v_1, %c, 1
    %v_2 = load %v_1, 1: I32
    %v_3 = cmp_eq %v_2, 0: I32
    je %v_3, b_4, b_5
  }

  b_5 {
    %v_6 = load %v_1, 1: I32
    %v_7 = cmp_eq %v_6, 1: I32
    je %v_7, b_8, b_9
  }

  b_9 {
    jmp b_10
  }

  b_10 {
    %v_11 = phi [b_9, 3], [b_4, 1], [b_8, 2]: I32
    ret %v_11
  }

  b_4 {
    jmp b_10
  }

  b_8 {
    jmp b_10
  }
}

bare<complex>(%m: Ptr): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    %v_2 = load %m, 1: I32
    %v_3 = cmp_eq %v_2, 1: I32
