  b_6 {
    %v_8 = load %m, 1: I32
    store %v_1, %v_8, 1
    %v_9 = load %v_1, 1: I32
    %v_10 = call_complex colorValue, %v_9: I32
    ret %v_10
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 8, 4: Ptr
    store %v_1, 1, 1
    %v_2 = add %v_1, 4: Ptr
    store %v_2, 1, 4
    %v_3 = call_complex bare, %v_1: I32
