module ResolveTest

fn classify(n: I32 [shared call]) -> I32 {
  local & local1: Array(I32) object1
  local & xs: Array(I32) object1
  local local3: I32 [shared slot 0]

bb0:
  %0: I32 = const 10
  %1: I32 = const 20
  %2: I32 = const 30
  %3: %I32 = run.slots I32 *3
  %4: Size = bitcast inspect %3
  %5: Size = const 0
  %6: Bool = eq inspect %4 inspect %5
  %7: {} = call checkCondition borrow.shared %6
  %8: @bits(30) U32 = const 3
  %9: @bits(2) U32 = const 1
  %10: Run(I32) = aggregate.Run take %3 take %8 take %9
  %11: @bits(30) U32 = const 3
  %12: Array(I32) = aggregate.Array take %10 take %11
  write.init borrow.unique (local1) take %12
  %14: Size = const 0
  write.init borrow.unique ([%%3][0]) take %0
  %16: Size = const 1
  write.init borrow.unique ([%%3][1]) take %1
  %18: Size = const 2
  write.init borrow.unique ([%%3][2]) take %2
  %20: Array(I32) = read take (local1)
  write.init borrow.unique (xs) take %20
  %22: I32 = read copy.trivial (n)
  %23: I32 = const 0
  %24: Bool = eq inspect %22 inspect %23
  branch inspect %24 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %29: I32 = read copy.trivial (n)
  %30: I32 = const 1
  %31: Bool = eq inspect %29 inspect %30
  branch inspect %31 -> bb6 -> bb4

bb3:
  drop (xs)
  %26: I32 = const -1
  return take %26

bb4:
  jump -> bb5

bb5:
  %36: I32 = read copy.trivial (n)
  %37: I32 = const 2
  %38: Bool = eq inspect %36 inspect %37
  branch inspect %38 -> bb9 -> bb7

bb6:
  drop (xs)
  %33: I32 = const -2
  return take %33

bb7:
  jump -> bb8

bb8:
  %43: Size = const 0
  %44: Array(I32) [shared call] = read borrow.shared (xs) loan0
  %45: Array(I32) [shared slot 0 view] = call.derivation elements(Array(I32), I32) borrow.shared %44 roots{0}
  %46: I32 [shared slot 0] = call.subscript get(Array(I32), Size, I32) borrow.shared %45 borrow.shared %43 roots{0}
  write.init borrow.unique (local3) borrow.shared %46
  %48: I32 = read copy.trivial (local3)
  drop (xs)
  %49: I32 = read copy.trivial (n)
  %50: I32 = add inspect %48 inspect %49
  return take %50

bb9:
  drop (xs)
  %40: I32 = const -3
  return take %40
}

fn parity(n: I32 [shared call], salt: I32 [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (n)
  %1: I32 = const 1
  %2: I32 = and inspect %0 inspect %1
  %3: I32 = const 0
  %4: Bool = eq inspect %2 inspect %3
  branch inspect %4 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %9: I32 = read copy.trivial (salt)
  %10: I32 = const 90
  %11: Bool = gt inspect %9 inspect %10
  branch inspect %11 -> bb6 -> bb4

bb3:
  %6: I32 = const 7
  return take %6

bb4:
  jump -> bb5

bb5:
  %16: I32 = const 9
  return take %16

bb6:
  %13: I32 = const 5
  return take %13
}

fn main() -> I32 {
  local & total: I32
  local & i: I32

bb0:
  %0: I32 = const 0
  write.init borrow.unique (total) take %0
  %2: I32 = const 0
  write.init borrow.unique (i) take %2
  jump -> bb1

bb1:
  %5: I32 = read copy.trivial (i)
  %6: I32 = const 5
  %7: Bool = lt inspect %5 inspect %6
  branch inspect %7 -> bb3 -> bb2

bb2:
  %23: I32 = read copy.trivial (total)
  return take %23

bb3:
  %9: I32 = read copy.trivial (total)
  %10: I32 = read copy.trivial (i)
  %11: I32 = call classify borrow.shared %10
  %12: I32 = add inspect %9 inspect %11
  %13: I32 = read copy.trivial (i)
  %14: I32 = read copy.trivial (i)
  %15: I32 = call parity borrow.shared %13 borrow.shared %14
  %16: I32 = add inspect %12 inspect %15
  write.assign borrow.unique (total) take %16
  %18: I32 = read copy.trivial (i)
  %19: I32 = const 1
  %20: I32 = add inspect %18 inspect %19
  write.assign borrow.unique (i) take %20
  jump -> bb1
}

entry main
