module ResolveTest

data Quad {values: [I32 *4], tag: I32}

data Pad {wide: I64, narrow: U8}

fn fixedSize() -> I64 {
  local xs: [I32 *4]

bb0:
  %0: I32 = const 1
  %1: I32 = const 2
  %2: I32 = const 3
  %3: I32 = const 4
  %4: [I32 *4] = aggregate.0 take %0 take %1 take %2 take %3
  write.init borrow.unique (xs) take %4
  %6: [I32 *4] = read copy.trivial (xs)
  %7: Size = call sizeOf([I32 *4]) borrow.shared %6
  %8: I64 = convert inspect %7
  return take %8
}

fn nestedSize() -> I64 {
  local q: Quad

bb0:
  %0: I32 = const 1
  %1: I32 = const 2
  %2: I32 = const 3
  %3: I32 = const 4
  %4: [I32 *4] = aggregate.0 take %0 take %1 take %2 take %3
  %5: I32 = const 0
  %6: Quad = aggregate.Quad take %4 take %5
  write.init borrow.unique (q) take %6
  %8: Quad = read copy.trivial (q)
  %9: Size = call sizeOf(Quad) borrow.shared %8
  %10: I32 = read copy.trivial (q.tag)
  %11: Size = call sizeOf(I32) borrow.shared %10
  %12: Size = sub inspect %9 inspect %11
  %13: I64 = convert inspect %12
  return take %13
}

fn total(xs: Array(I32) [shared call view]) -> I32 {
  local & sum: I32
  local & i: Size
  local local3: I32 [shared slot 0]

bb0:
  %0: I32 = const 0
  write.init borrow.unique (sum) take %0
  %2: Size = const 0
  write.init borrow.unique (i) take %2
  jump -> bb1

bb1:
  %5: Size = read copy.trivial (i)
  %6: Array(I32) [shared call view] = read borrow.shared (xs) loan0
  %7: Size = call length(Array(I32)) borrow.shared %6
  %8: Bool = lt inspect %5 inspect %7
  branch inspect %8 -> bb3 -> bb2

bb2:
  %23: I32 = read copy.trivial (sum)
  return take %23

bb3:
  %10: I32 = read copy.trivial (sum)
  %11: Size = read copy.trivial (i)
  %12: Array(I32) [shared call view] = read borrow.shared (xs) loan1
  %13: I32 [shared slot 0] = call.subscript get(Array(I32), Size, I32) borrow.shared %12 borrow.shared %11 roots{1}
  write.init borrow.unique (local3) borrow.shared %13
  %15: I32 = read copy.trivial (local3)
  %16: I32 = add inspect %10 inspect %15
  write.assign borrow.unique (sum) take %16
  %18: Size = read copy.trivial (i)
  %19: Size = const 1
  %20: Size = add inspect %18 inspect %19
  write.assign borrow.unique (i) take %20
  jump -> bb1
}

fn double(xs: Array(I32) [unique call view]) -> {} {
  local & i: Size
  local local2: I32 [shared slot 0]
  local value: I32
  local & local4: I32 [unique slot 0 owner]

bb0:
  %0: Size = const 0
