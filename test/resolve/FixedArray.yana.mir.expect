bb2:
  return

bb3:
  %8: Size = read copy.trivial (i)
  %9: Array(I32) [shared call view] = read borrow.shared (xs) loan1
  %10: I32 [shared slot 0] = call.subscript get(Array(I32), Size, I32) borrow.shared %9 borrow.shared %8 roots{1}
  write.init borrow.unique (local2) borrow.shared %10
  %12: I32 = read copy.trivial (local2)
  write.init borrow.unique (value) take %12
  %14: Size = read copy.trivial (i)
  %15: I32 = read copy.trivial (value)
  %16: I32 = read copy.trivial (value)
  %17: I32 = add inspect %15 inspect %16
  %18: Array(I32) [unique call view] = read borrow.unique (xs) loan2
  %19: I32 [unique slot 0 owner] = call.subscript getMut(Array(I32), Size, I32) borrow.unique %18 borrow.shared %14 roots{2}
  write.init borrow.unique (local4) borrow.unique %19
  write.assign borrow.unique (local4) take %17
  %22: Size = read copy.trivial (i)
  %23: Size = const 1
  %24: Size = add inspect %22 inspect %23
  write.assign borrow.unique (i) take %24
  jump -> bb1
}

fn middle(xs: Array(I32) [shared call view]) -> I32 {
bb0:
  %0: Array(I32) [shared call view] = read borrow.shared (xs) loan0
  %1: Size = const 1
  %2: Size = const 3
  %3: Array(I32) [shared slot 0 view] = call slice(I32) borrow.shared %0 borrow.shared %1 borrow.shared %2 roots{0}
  %4: I32 = call total borrow.shared %3
  return take %4
}

fn pairSum(p: [I32 *2] [shared call]) -> I32 {
bb0:
  %0: [I32 *2] [shared call] = read borrow.shared (p) loan0
  %1: Array(I32) [shared slot 0 view] = call.derivation elements([I32 *2], I32) borrow.shared %0 roots{0}
  %2: I32 = call total borrow.shared %1
  return take %2
}

fn bump(p: [I32 *2] [unique call]) -> {} {
bb0:
  %0: Size = const 0
  %1: Size = const 0
  %2: I32 = read copy.trivial (p[0])
  %3: I32 = const 1
  %4: I32 = add inspect %2 inspect %3
  write.assign borrow.unique (p[0]) take %4
  %6: Size = const 1
  %7: Size = const 1
  %8: I32 = read copy.trivial (p[1])
  %9: I32 = const 1
  %10: I32 = add inspect %8 inspect %9
  write.assign borrow.unique (p[1]) take %10
  return
}

fn padStride() -> I64 {
  local ps: [Pad *3]

bb0:
  %0: I64 = const 1
  %1: U8 = const 2
  %2: Pad = aggregate.Pad take %0 take %1
  %3: I64 = const 3
  %4: U8 = const 4
  %5: Pad = aggregate.Pad take %3 take %4
  %6: I64 = const 5
  %7: U8 = const 6
  %8: Pad = aggregate.Pad take %6 take %7
  %9: [Pad *3] = aggregate.0 take %2 take %5 take %8
  write.init borrow.unique (ps) take %9
  %11: [Pad *3] = read copy.trivial (ps)
  %12: Size = call sizeOf([Pad *3]) borrow.shared %11
  %13: I64 = convert inspect %12
  return take %13
}

