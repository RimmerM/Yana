  %16: Size = const 2
  %17: I64 = read copy.trivial (ps[2].wide)
  %18: I64 = add inspect %15 inspect %17
  return take %18
}

fn emptySize() -> I64 {
  local none: [I32 *0]

bb0:
  %0: [I32 *0] = aggregate.0
  write.init borrow.unique (none) take %0
  %2: [I32 *0] = read copy.trivial (none)
  %3: Size = call sizeOf([I32 *0]) borrow.shared %2
