mut @zero = [0, 0, 0, 0]
mut @one = [0, 0, 128, 63]

main<complex>(): I32 {
  b_0 {
    %v_1 = load @zero, 4: F32
    %v_2 = load @zero, 4: F32
    %v_3 = div %v_1, %v_2: F32
    %v_4 = load @one, 4: F32
    %v_5 = cmp_lt %v_3, %v_4: I32
    je %v_5, b_6, b_7
  }

  b_7 {
    %v_8 = phi [b_0, 0], [b_6, 1]: I32
    %v_9 = cmp_le %v_3, %v_4: I32
    je %v_9, b_10, b_11
  }

  b_6 {
    jmp b_7
  }

  b_11 {
    %v_12 = phi [b_7, %v_8], [b_10, %v_13]: I32
    %v_14 = cmp_gt %v_3, %v_4: I32
    je %v_14, b_15, b_16
  }

  b_10 {
    %v_13 = add %v_8, 2: I32
    jmp b_11
  }

  b_16 {
    %v_17 = phi [b_11, %v_12], [b_15, %v_18]: I32
    %v_19 = cmp_ge %v_3, %v_4: I32
    je %v_19, b_20, b_21
  }

  b_15 {
    %v_18 = add %v_12, 4: I32
    jmp b_16
  }

  b_21 {
    %v_22 = phi [b_16, %v_17], [b_20, %v_23]: I32
    %v_24 = cmp_eq %v_3, %v_4: I32
    je %v_24, b_25, b_26
  }

  b_20 {
    %v_23 = add %v_17, 8: I32
    jmp b_21
  }

  b_26 {
    %v_27 = phi [b_21, %v_22], [b_25, %v_28]: I32
    %v_29 = cmp_neq %v_3, %v_4: I32
    je %v_29, b_30, b_31
  }

  b_25 {
    %v_28 = add %v_22, 16: I32
    jmp b_26
  }

  b_31 {
    %v_32 = phi [b_26, %v_27], [b_30, %v_33]: I32
    %v_34 = cmp_eq %v_3, %v_3: I32
    je %v_34, b_35, b_36
  }

  b_30 {
    %v_33 = add %v_27, 32: I32
    jmp b_31
  }

  b_36 {
    %v_37 = phi [b_31, %v_32], [b_35, %v_38]: I32
    %v_39 = cmp_neq %v_3, %v_3: I32
    je %v_39, b_40, b_41
  }

  b_35 {
    %v_38 = add %v_32, 64: I32
    jmp b_36
  }

  b_41 {
    %v_42 = phi [b_36, %v_37], [b_40, %v_43]: I32
    %v_44 = load @one, 4: F32
    %v_45 = load @zero, 4: F32
    %v_46 = cmp_gt %v_44, %v_45: I32
    je %v_46, b_47, b_48
  }

  b_40 {
    %v_43 = add %v_37, 128: I32
    jmp b_41
  }

  b_48 {
    %v_49 = phi [b_41, %v_42], [b_47, %v_50]: I32
    %v_51 = load @zero, 4: F32
    %v_52 = load @one, 4: F32
    %v_53 = cmp_lt %v_51, %v_52: I32
    je %v_53, b_54, b_55
  }

  b_47 {
    %v_50 = add %v_42, 256: I32
    jmp b_48
  }

  b_55 {
    %v_56 = phi [b_48, %v_49], [b_54, %v_57]: I32
    %v_58 = load @one, 4: F32
    %v_59 = load @one, 4: F32
    %v_60 = cmp_eq %v_58, %v_59: I32
    je %v_60, b_61, b_62
  }

  b_54 {
    %v_57 = add %v_49, 512: I32
    jmp b_55
  }

  b_62 {
    %v_63 = phi [b_55, %v_56], [b_61, %v_64]: I32
    %v_65 = load @one, 4: F32
    %v_66 = load @zero, 4: F32
    %v_67 = cmp_neq %v_65, %v_66: I32
    je %v_67, b_68, b_69
  }

  b_61 {
    %v_64 = add %v_56, 1024: I32
    jmp b_62
  }

  b_69 {
    %v_70 = phi [b_62, %v_63], [b_68, %v_71]: I32
    ret %v_70
  }

  b_68 {
    %v_71 = add %v_63, 2048: I32
    jmp b_69
  }
}

