module ResolveTest

let & sink: Vec(I16, 4) = [0, 0, 0, 0]

fn secondLane(v: Vec(I16, n) [shared call]) -> I16 {
  form specialized
  slot #0 const n
bb0:
  %0: Vec(I16, n) = read copy.trivial (v)
  %1: I32 = const 1
  %2: I16 = vec.lane #1 inspect %0
  return take %2
}

fn widthOf(v: Vec(I16, n) [shared call]) -> I32 {
  form specialized
  slot #0 const n
bb0:
  %0: I32 = gen.value n
  return take %0
}

fn doubled(v: Vec(I16, n) [shared call]) -> Vec(I16, n) {
  form specialized
  slot #0 const n
bb0:
  %0: Vec(I16, n) = read copy.trivial (v)
  %1: Vec(I16, n) = vec.shuffle [reversed] inspect %0 inspect %0
  %2: Vec(I16, n) = read copy.trivial (v)
  %3: Mask(I16, n) = gt inspect %1 inspect %2
  %4: Vec(I16, n) = select inspect %3 inspect %1 inspect %2
  return take %4
}

fn twice(v: Vec(I16, n) [shared call]) -> Vec(I16, n) {
  form specialized
  slot #0 const n
  slot #1 class Num(Vec(I16, n))
bb0:
  %0: Vec(I16, n) = read copy.trivial (v)
  %1: Vec(I16, n) = read copy.trivial (v)
  %2: Vec(I16, n) = call +(Vec(I16, n)) borrow.shared %0 borrow.shared %1
  return take %2
}

fn sameCount(v: Vec(I16, n) [shared call], w: Vec(I16, n) [shared call]) -> Vec(I16, n) {
  form specialized
  slot #0 const n
  slot #1 class Num(Vec(I16, n))
bb0:
  %0: Vec(I16, n) = read copy.trivial (v)
  %1: Vec(I16, n) = read copy.trivial (w)
  %2: Vec(I16, n) = call +(Vec(I16, n)) borrow.shared %0 borrow.shared %1
  return take %2
}

fn quadWidth(v: Vec(I16, 4) [shared call]) -> I32 {
bb0:
  %0: Vec(I16, 4) = read copy.trivial (v)
  %1: I32 = call widthOf(4) borrow.shared %0
  return take %1
}

fn main() -> I32 {
  local v: Vec(I16, 4)
  local wide: Vec(I16, 4)
  local summed: Vec(I16, 4)

bb0:
  %0: Vec(I16, 4) = read copy.trivial (global sink)
  %1: I32 = const 1
  %2: I16 = const 9
  %3: Vec(I16, 4) = vec.withlane #1 inspect %0 inspect %2
  write.init borrow.unique (v) take %3
  %5: Vec(I16, 4) = read copy.trivial (v)
  %6: Vec(I16, 4) = call doubled(4) borrow.shared %5
  write.init borrow.unique (wide) take %6
  %8: Vec(I16, 4) = read copy.trivial (v)
  %9: Vec(I16, 4) = call twice(4) borrow.shared %8
  %10: Vec(I16, 4) = read copy.trivial (v)
  %11: Vec(I16, 4) = read copy.trivial (wide)
  %12: Vec(I16, 4) = call sameCount(4) borrow.shared %10 borrow.shared %11
  %13: Vec(I16, 4) = call sameCount(4) borrow.shared %9 borrow.shared %12
  write.init borrow.unique (summed) take %13
  %15: Vec(I16, 4) = read copy.trivial (wide)
  write.assign borrow.unique (global sink) take %15
  %17: Vec(I16, 4) = read copy.trivial (v)
  %18: I32 = call widthOf(4) borrow.shared %17
  %19: Vec(I16, 4) = read copy.trivial (v)
  %20: I32 = call quadWidth borrow.shared %19
  %21: I32 = add inspect %18 inspect %20
  %22: Vec(I16, 4) = read copy.trivial (wide)
  %23: I16 = call secondLane(4) borrow.shared %22
  %24: I32 = convert inspect %23
  %25: I32 = add inspect %21 inspect %24
  %26: Vec(I16, 4) = read copy.trivial (summed)
  %27: I16 = call secondLane(4) borrow.shared %26
  %28: I32 = convert inspect %27
  %29: I32 = add inspect %25 inspect %28
  %30: Vec(I16, 4) = read copy.trivial (summed)
  %31: I32 = const 2
  %32: I16 = vec.lane #2 inspect %30
  %33: I32 = convert inspect %32
  %34: I32 = add inspect %29 inspect %33
  return take %34
}

fn doubled(4)(v: Vec(I16, 4) [shared call]) -> Vec(I16, 4) = <doubled at 4>

fn twice(4)(v: Vec(I16, 4) [shared call]) -> Vec(I16, 4) = <twice at 4>

fn sameCount(4)(v: Vec(I16, 4) [shared call], w: Vec(I16, 4) [shared call]) -> Vec(I16, 4) = <sameCount at 4>

fn widthOf(4)(v: Vec(I16, 4) [shared call]) -> I32 = <widthOf at 4>

fn secondLane(4)(v: Vec(I16, 4) [shared call]) -> I16 = <secondLane at 4>

entry main
