import Native
import Native.Linux

-- A derived drop for a multi-constructor record: the glue reads the discriminant and releases the
-- members of whichever constructor is there.

let &liveBuffers = 0 :: I64

data Buffer {bytes: %U8}

fn makeBuffer(size: I64) -> Buffer:
    liveBuffers += 1
    return Buffer {bytes: allocateHeap(size)}

instance Drop(Buffer):
    fn drop(->value: Buffer) -> {}:
        freeHeap(value.bytes)
        liveBuffers -= 1

-- One constructor owns nothing, one owns a buffer, one owns two. Nothing is written for any of
-- them: the drop is derived from the shape.
data Slot = Empty | One {only: Buffer} | Two {first: Buffer, second: Buffer}

-- `touch` is what gives each value a last use *after* the count is read. Without it the value's
-- lifetime would end at the `let`, the drop would run before the read, and every count would be
-- zero whether or not the glue did the right thing.
fn touch(it: Slot) -> I64 = 0

fn holdsTwo() -> I64:
    let s = Two {first: makeBuffer(16), second: makeBuffer(16)}
    let counted = liveBuffers
    return counted + touch(s)

fn holdsOne() -> I64:
    let s = One {only: makeBuffer(16)}
    let counted = liveBuffers
    return counted + touch(s)

fn holdsNothing() -> I64:
    let s = Empty
    let counted = liveBuffers
    return counted + touch(s)

fn main() -> Int:
    -- Each count is read while the value is still live, so it is an assertion about placement:
    -- 2 while `Two` lives, 1 while `One` lives, 0 for `Empty`, and 0 again once all have died.
    let two = holdsTwo()
    let one = holdsOne()
    let none = holdsNothing()

    return (two * 100 + one * 10 + none + liveBuffers) :: Int
