    %v7 = load heapFree : %%U8
    %v8 = bitcast %v7 : Long
    %v10 = cmp_eq %v8, 0 : Bool
    je %v10, b3, b4

  b2:
    jmp b6

  b3:
    %v13 = bitcast 0 : %U8
