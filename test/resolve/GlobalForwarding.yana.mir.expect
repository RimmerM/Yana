  %21: I32 = const 40
  write.assign borrow.unique ([%%20]) take %21
  %23: {} = const {}
  %24: I32 = read copy.trivial (global pair.left)
  %25: I32 = read copy.trivial (global pair.right)
  %26: I32 = add inspect %24 inspect %25
  write.init borrow.unique (b) take %26
  %28: I32 [shared slot 0] = read borrow.shared (global kept) loan2
  %29: %I32 [owned here shape6 .*=shared slot 0] = address inspect %28 roots.0{2}
  %30: {} = call aim borrow.shared %29
  %31: I32 = const 7
