  %48: I32 = read copy.trivial (b)
  %49: I32 = const 100
  %50: I32 = mul inspect %48 inspect %49
  %51: I32 = add inspect %47 inspect %50
  %52: I32 = read copy.trivial (c)
  %53: I32 = add inspect %51 inspect %52
  return take %53
}

fn main$() -> I32 {
bb0:
  %0: I32 [shared slot 0] = read borrow.shared (global kept) loan0
  %1: %I32 [owned here shape6 .*=shared slot 0] = address inspect %0 roots.0{0}
