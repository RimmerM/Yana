module ResolveTest

let & seed: I32 = 3

fn doubled(v: Vec(I32) [shared call]) -> Vec(I32) {
bb0:
  %0: Vec(I32) = read copy.trivial (v)
  %1: Vec(I32) = read copy.trivial (v)
  %2: Vec(I32) = add inspect %0 inspect %1
  return take %2
}

fn scaled(v: Vec(I32) [shared call], by: I32 [shared call]) -> Vec(I32) {
bb0:
  %0: Vec(I32) = read copy.trivial (v)
  %1: I32 = read copy.trivial (by)
  %2: Vec(I32) = vec.splat inspect %1
  %3: Vec(I32) = mul inspect %0 inspect %2
  return take %3
}

fn main() -> I32 {
  local base: Vec(I32)
  local twice: Vec(I32)
  local six: Vec(I32)
  local mixed: Vec(I32)
  local & total: Vec(I32)
  local & i: I32
  local lanes: I32

bb0:
  %0: I32 = read copy.trivial (global seed)
  %1: Vec(I32) = vec.splat inspect %0
  write.init borrow.unique (base) take %1
  %3: Vec(I32) = read copy.trivial (base)
  %4: Vec(I32) = call doubled borrow.shared %3
  write.init borrow.unique (twice) take %4
  %6: Vec(I32) = read copy.trivial (base)
  %7: I32 = const 2
  %8: Vec(I32) = call scaled borrow.shared %6 borrow.shared %7
  write.init borrow.unique (six) take %8
  %10: Vec(I32) = read copy.trivial (twice)
  %11: I32 = const 0
  %12: I32 = vec.lane #0 inspect %10
  %13: I32 = const 6
  %14: Bool = ne inspect %12 inspect %13
  branch inspect %14 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %19: Vec(I32) = read copy.trivial (six)
  %20: I32 = const 1
  %21: I32 = vec.lane #1 inspect %19
  %22: I32 = const 6
  %23: Bool = ne inspect %21 inspect %22
  branch inspect %23 -> bb6 -> bb4

bb3:
  %16: I32 = const -1
  return take %16

bb4:
  jump -> bb5

bb5:
  %28: Vec(I32) = read copy.trivial (base)
  %29: I32 = const 0
  %30: I32 = const 10
  %31: Vec(I32) = vec.withlane #0 inspect %28 inspect %30
  write.init borrow.unique (mixed) take %31
  %33: Vec(I32) = read copy.trivial (mixed)
  %34: I32 = vec.reduce max inspect %33
  %35: I32 = const 10
  %36: Bool = ne inspect %34 inspect %35
  branch inspect %36 -> bb9 -> bb7

bb6:
  %25: I32 = const -2
  return take %25

bb7:
  jump -> bb8

bb8:
  %41: Vec(I32) = read copy.trivial (mixed)
  %42: I32 = vec.reduce min inspect %41
  %43: I32 = const 3
  %44: Bool = ne inspect %42 inspect %43
  branch inspect %44 -> bb12 -> bb10

bb9:
  %38: I32 = const -3
  return take %38

bb10:
  jump -> bb11

bb11:
  %49: Vec(I32) = read copy.trivial (base)
  write.init borrow.unique (total) take %49
  %51: I32 = const 0
  write.init borrow.unique (i) take %51
  jump -> bb13

bb12:
  %46: I32 = const -4
  return take %46

bb13:
  %54: I32 = read copy.trivial (i)
  %55: I32 = const 4
  %56: Bool = lt inspect %54 inspect %55
  branch inspect %56 -> bb15 -> bb14

bb14:
  %67: Vec(I32) = read copy.trivial (total)
  %68: I32 = const 0
  %69: I32 = vec.lane #0 inspect %67
  %70: I32 = const 15
  %71: Bool = ne inspect %69 inspect %70
  branch inspect %71 -> bb18 -> bb16

bb15:
  %58: Vec(I32) = read copy.trivial (total)
  %59: Vec(I32) = read copy.trivial (base)
  %60: Vec(I32) = add inspect %58 inspect %59
  write.assign borrow.unique (total) take %60
  %62: I32 = read copy.trivial (i)
  %63: I32 = const 1
  %64: I32 = add inspect %62 inspect %63
  write.assign borrow.unique (i) take %64
  jump -> bb13

bb16:
  jump -> bb17

bb17:
  %76: Vec(I32) = read copy.trivial (total)
  %77: I32 = const 1
  %78: I32 = vec.lane #1 inspect %76
  %79: I32 = const 15
  %80: Bool = ne inspect %78 inspect %79
  branch inspect %80 -> bb21 -> bb19

bb18:
  %73: I32 = const -5
  return take %73

bb19:
  jump -> bb20

bb20:
  %85: I32 = const 1
  %86: Vec(I32) = vec.splat inspect %85
  %87: I32 = vec.reduce add inspect %86
  write.init borrow.unique (lanes) take %87
  %89: Vec(I32) = read copy.trivial (total)
  %90: I32 = vec.reduce add inspect %89
  %91: I32 = read copy.trivial (lanes)
  %92: I32 = const 15
  %93: I32 = mul inspect %91 inspect %92
  %94: Bool = ne inspect %90 inspect %93
  branch inspect %94 -> bb24 -> bb22

bb21:
  %82: I32 = const -6
  return take %82

bb22:
  jump -> bb23

bb23:
  %99: Vec(I32) = read copy.trivial (twice)
  %100: I32 = const 1
  %101: I32 = vec.lane #1 inspect %99
  %102: I32 = const 100
  %103: I32 = mul inspect %101 inspect %102
  %104: Vec(I32) = read copy.trivial (six)
  %105: I32 = const 0
  %106: I32 = vec.lane #0 inspect %104
  %107: I32 = add inspect %103 inspect %106
  %108: Vec(I32) = read copy.trivial (mixed)
  %109: I32 = const 0
  %110: I32 = vec.lane #0 inspect %108
  %111: I32 = add inspect %107 inspect %110
  return take %111

bb24:
  %96: I32 = const -7
  return take %96
}

entry main
