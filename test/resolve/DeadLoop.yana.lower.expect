@image$base = []
mut @live = [0, 0, 0, 0]

main<complex>(): I32 {
  b_0 {
    jmp b_1
  }

  b_2 {
    %v_3 = cmp_ilt %v_4, 5: I32
    je %v_3, b_1, b_5
  }

  b_5 {
    %v_6 = imul %v_7, 3: I32
    %v_8 = add %v_6, 6: I32
    jmp b_9
  }

  b_10 {
    %v_11 = cmp_ilt %v_12, 6: I32
    je %v_11, b_9, b_13
  }

  b_13 {
    %v_14 = imul %v_12, 5: I32
    %v_15 = add %v_8, %v_14: I32
    jmp b_16
  }

  b_17 {
    %v_18 = cmp_ilt %v_19, 4: I32
    je %v_18, b_16, b_20
  }

  b_20 {
    jmp b_21
  }

  b_21 {
    %v_22 = phi [b_20, 0], [b_23, %v_24]: I32
    %v_25 = cmp_ilt %v_22, 9: I32
    je %v_25, b_26, b_27
  }

  b_26 {
    %v_28 = cmp_eq %v_22, 4: I32
    je %v_28, b_27, b_23
  }

  b_23 {
    %v_24 = add %v_22, 1: I32
    jmp b_21
  }

  b_27 {
    %v_29 = imul %v_22, 11: I32
    %v_30 = add %v_15, %v_29: I32
    jmp b_31
  }

  b_32 {
    %v_33 = cmp_ilt %v_34, 3: I32
    je %v_33, b_31, b_35
  }

  b_35 {
    %v_36 = imul %v_37, 13: I32
    %v_38 = add %v_30, %v_36: I32
    %v_39 = add %v_38, 585: I32
    %v_40 = loads @live, 4: I32
    %v_41 = imul %v_40, 23: I32
    %v_42 = add %v_39, %v_41: I32
    ret %v_42
  }

  b_31 {
    %v_43 = phi [b_32, %v_37], [b_27, 0]: I32
    %v_44 = phi [b_32, %v_34], [b_27, 0]: I32
    %v_37 = add %v_43, %v_44: I32
    %v_34 = add %v_44, 1: I32
    jmp b_32
  }

  b_16 {
    %v_45 = phi [b_17, %v_19], [b_13, 0]: I32
    %v_46 = loads @live, 4: I32
    %v_47 = add %v_46, 1: I32
    %v_48 = sub %v_47, 1: I32
    store @live, %v_48, 4
    %v_19 = add %v_45, 1: I32
    jmp b_17
  }

  b_9 {
    %v_49 = phi [b_10, %v_12], [b_5, 0]: I32
    %v_12 = add %v_49, 1: I32
    jmp b_10
  }

  b_1 {
    %v_50 = phi [b_2, %v_7], [b_0, 0]: I32
    %v_51 = phi [b_2, %v_4], [b_0, 0]: I32
    %v_7 = add %v_50, %v_51: I32
    %v_4 = add %v_51, 1: I32
    jmp b_2
