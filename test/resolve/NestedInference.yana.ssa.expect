fn refined(p: @bits(20) U32 [shared call], q: Box(U32)) -> I32 {
bb0(%0: @bits(20) U32 trivial, %1: Box(U32) trivial):
  %2: %@bits(20) U32 address = alloc frame @bits(20) U32 [shared call]
  %3: %Box(U32) address = alloc frame Box(U32)
  store inspect %2 borrow %0
  store inspect %3 consume %1
  %4: @bits(20) U32 trivial = load inspect %2
  %5: U32 trivial = convert inspect %4
  %6: Box(U32) trivial = copy inspect %3
  %7: I32 trivial = call mixedDepth(U32) borrow %5 consume %6
  return consume %7
}

fn main() -> I32 {
bb0:
  %0: %@bits(20) U32 address = alloc frame @bits(20) U32
  %1: @bits(20) U32 trivial = const 3
  store inspect %0 consume %1
