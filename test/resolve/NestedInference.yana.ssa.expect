  %12: I32 trivial = add inspect %7 inspect %11
  %13: @bits(20) U32 trivial = const 3
  %14: U32 trivial = const 5
  %15: I32 trivial = const 9
  %16: Box(U32) trivial = aggregate.Box consume %14 consume %15
  %17: I32 trivial = call refined borrow %13 consume %16
  %18: I32 trivial = add inspect %12 inspect %17
  return consume %18
