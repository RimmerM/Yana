module ResolveTest

data Boxed(a) {value: a} drop derived reclaim derived

data Pair(a, b) {left: a, right: b} drop derived reclaim derived

data Boxed(I32) {value: I32} of Boxed

data Boxed(Boxed(I32)) {value: Boxed(I32)} of Boxed

data Pair(I32, I32) {left: I32, right: I32} of Pair

fn id(x: a) -> a {
  slot #0 type a
bb0:
  %0: a = read take (x)
  return take %0
}

fn also(x: a) -> a {
  slot #0 type a
bb0:
  %0: a = read take (x)
  return take %0
}

fn boxed(x: a) -> Boxed(a) {
  slot #0 type a
bb0:
  %0: a = read take (x)
  %1: Boxed(a) = aggregate take %0
  return take %1
}

fn rewrap(x: a) -> Boxed(a) {
  slot #0 type a
bb0:
  %0: a = read take (x)
  %1: a = call id(a) take %0
  %2: Boxed(a) = call boxed(a) take %1
  return take %2
}

fn twice(x: a) -> Boxed(Boxed(a)) {
  slot #0 type a
bb0:
  %0: a = read take (x)
  %1: Boxed(a) = aggregate take %0
  %2: Boxed(Boxed(a)) = aggregate take %1
  return take %2
}

fn swapped(left: a, right: b) -> Pair(b, a) {
  slot #0 type a
  slot #1 type b
bb0:
  %0: b = read take (right)
  %1: a = read take (left)
  %2: Pair(b, a) = aggregate take %0 take %1
  return take %2
}

fn boxedValue(box: Boxed(I32) [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (box.value)
  return take %0
}

fn nestedValue(box: Boxed(Boxed(I32)) [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (box.value.value)
  return take %0
}

fn pairSum(pair: Pair(I32, I32) [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (pair.left)
  %1: I32 = read copy.trivial (pair.right)
  %2: I32 = add inspect %0 inspect %1
  return take %2
}

fn main() -> I32 {
  local one: I32
  local flag: Bool
  local rewrapped: I32
  local nested: I32
  local swapped2: I32
  local checked: I32

bb0:
  %0: I32 = const 1
  %1: I32 = call id(I32) take %0
  write.init borrow.unique (one) take %1
  %3: Bool = const True
  %4: Bool = call also(Bool) take %3
  write.init borrow.unique (flag) take %4
  %6: I32 = const 20
  %7: Boxed(I32) = call rewrap(I32) take %6
  %8: I32 = call boxedValue borrow.shared %7
  write.init borrow.unique (rewrapped) take %8
  %10: I32 = const 300
  %11: Boxed(Boxed(I32)) = call twice(I32) take %10
  %12: I32 = call nestedValue borrow.shared %11
  write.init borrow.unique (nested) take %12
  %14: I32 = const 4000
  %15: I32 = const 50000
  %16: Pair(I32, I32) = call swapped(I32, I32) take %14 take %15
  %17: I32 = call pairSum borrow.shared %16
  write.init borrow.unique (swapped2) take %17
  %19: Bool = read copy.trivial (flag)
  branch inspect %19 -> bb1 -> bb2

bb1:
  %21: I32 = const 2
  jump -> bb3(take %21)

bb2:
  %22: I32 = const 0
  jump -> bb3(take %22)

bb3(%23: I32):
  write.init borrow.unique (checked) take %23
  %27: I32 = read copy.trivial (one)
  %28: I32 = read copy.trivial (checked)
  %29: I32 = add inspect %27 inspect %28
  %30: I32 = read copy.trivial (rewrapped)
  %31: I32 = add inspect %29 inspect %30
  %32: I32 = read copy.trivial (nested)
  %33: I32 = add inspect %31 inspect %32
  %34: I32 = read copy.trivial (swapped2)
  %35: I32 = add inspect %33 inspect %34
  return take %35
}

fn id(I32)(x: I32) -> I32 = <id at I32>

fn also(Bool)(x: Bool) -> Bool = <also at Bool>

fn rewrap(I32)(x: I32) -> Boxed(I32) = <rewrap at I32>

fn twice(I32)(x: I32) -> Boxed(Boxed(I32)) = <twice at I32>

fn swapped(I32, I32)(left: I32, right: I32) -> Pair(I32, I32) = <swapped at I32, I32>

fn boxed(I32)(x: I32) -> Boxed(I32) = <boxed at I32>

entry main
