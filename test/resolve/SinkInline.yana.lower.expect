@image$base = []
mut @dropped = [0, 0, 0, 0]

identify<complex>(%v_0: Ptr, %value: Ptr) {
  b_1 {
    %v_2 = alloca 16, 8: Ptr
    store %v_2, ResolveTest.lambda$24, 8
    %v_3 = bitcast 0: Ptr
    %v_4 = add %v_2, 8: Ptr
    store %v_4, %v_3, 8
    call_complex Functor(Maybe(x), b, Maybe(b), x).map(Token, I32), %v_0, %value, %v_2
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 8, 4: Ptr
    store %v_1, 1, 4
    %v_2 = add %v_1, 4: Ptr
    store %v_2, 7, 4
    %v_3 = alloca 8, 4: Ptr
    call_complex identify, %v_3, %v_1
    %v_4 = loads %v_3, 4: I32
    %v_5 = cmp_eq %v_4, 1: I32
    %v_6 = add %v_3, 4: Ptr
    %v = loads %v_6, 4: I32
    %v_7 = select %v_5, %v, 0: I32
    %v_8 = add 15, %v_7: I32
    %v_9 = alloca 8, 4: Ptr
    store %v_9, 0, 4
    %v_10 = alloca 8, 4: Ptr
    call_complex identify, %v_10, %v_9
    %v_11 = loads %v_10, 4: I32
    %v_12 = cmp_eq %v_11, 1: I32
    %v_13 = add %v_10, 4: Ptr
    %v = loads %v_13, 4: I32
    %v_14 = select %v_12, %v, 100: I32
    %v_15 = add %v_8, %v_14: I32
    %v_16 = imul %v_15, 10: I32
    %v_17 = loads @dropped, 4: I32
    %v_18 = add %v_16, %v_17: I32
    ret %v_18
  }
}

ResolveTest.lambda$24<complex>(%env: Ptr, %t: Ptr): I32 {
  b_0 {
    %v_1 = loads %t, 4: I32
    ret %v_1
  }
}

Functor(Maybe(x), b, Maybe(b), x).map(Token, I32)<complex>(%v_0: Ptr, %value: Ptr, %f: Ptr) {
  b_1 {
    %v_2 = loads %value, 4: I32
    %v_3 = cmp_eq %v_2, 1: I32
    je %v_3, b_4, b_5
  }

  b_5 {
    %v_6 = alloca 8, 4: Ptr
    store %v_6, 0, 4
    jmp b_7
  }

  b_4 {
    %v_8 = add %value, 4: Ptr
    %inner = alloca 4, 4: Ptr
    copy %inner, %v_8, 4
    %v_9 = alloca 8, 4: Ptr
    %v_10 = add %f, 8: Ptr
    %v_11 = load %f, 8: Ptr
    %v_12 = load %v_10, 8: Ptr
    %v_13 = call_complex %v_11, %v_12, %inner: I32
    %v_14 = loads @dropped, 4: I32
    %v_15 = add %v_14, 1: I32
    store @dropped, %v_15, 4
    store %v_9, 1, 4
    %v_16 = add %v_9, 4: Ptr
    store %v_16, %v_13, 4
    jmp b_7
  }

  b_7 {
    %v_17 = phi [b_4, %v_9], [b_5, %v_6]: Ptr
    copy %v_0, %v_17, 8
    ret 
  }
}

