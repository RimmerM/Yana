  %1: k [shared call] = read borrow.shared (at) loan1
  %2: v [unique slot 0 owner] = call getMut(c, k, v) borrow.unique %0 borrow.shared %1 roots{0}
  write.init borrow.unique (slot) borrow.unique %2
  %4: v [shared slot 0 owner] = read borrow.shared (slot) loan2 roots{0}
  %5: I64 = const 1
  %6: v = call fromInt(v) borrow.shared %5
  write.init borrow.unique (local3) take %6
  %8: v [shared call] = read borrow.shared (local3) loan3
  %9: v = call +(v) borrow.shared %4 borrow.shared %8
  drop (local3)
  drop (slot)
  write.assign borrow.unique (slot) take %9
  %11: I32 = const 0
  return take %11
}

