module ResolveTest

fn bump(xs: c [unique call], at: k [shared call]) -> I32 {
  form specialized
  slot #0 type c
  slot #1 type k
  slot #2 type v
  slot #3 class Index(c, k, v)
  slot #4 class Num(v)
  slot #5 class FromInt(v)
  local & slot: v [unique slot 0 owner]
  local local3: v

bb0:
  %0: c [unique slot 0] = read borrow.unique (xs) loan0
  %1: k [shared call] = read borrow.shared (at) loan1
  %2: v [unique slot 0 owner] = call getMut(c, k, v) borrow.unique %0 borrow.shared %1 roots{0}
  write.init borrow.unique (slot) borrow.unique %2
  %4: v [shared slot 0 owner] = read borrow.shared (slot) loan2 roots{0}
  %5: I64 = const 1
  %6: v = call fromInt(v) borrow.shared %5
  write.init borrow.unique (local3) take %6
  %8: v [shared call] = read borrow.shared (local3) loan3
  %9: v = call +(v) borrow.shared %4 borrow.shared %8
  drop (local3)
  drop (slot)
  write.assign borrow.unique (slot) take %9
  %11: I32 = const 0
  return take %11
}

fn main() -> I32 {
  local & local0: Array(I32) object1
  local & xs: Array(I32) object1
  local ignored: I32
  local local3: I32 [shared slot 0]
  local local4: I32 [shared slot 0]

bb0:
  %0: I32 = const 5
  %1: I32 = const 6
  %2: I32 = const 7
  %3: %I32 = run.slots I32 *3
  %4: Size = bitcast inspect %3
  %5: Size = const 0
  %6: Bool = eq inspect %4 inspect %5
  %7: {} = call checkCondition borrow.shared %6
  %8: @bits(30) U32 = const 3
  %9: @bits(2) U32 = const 1
  %10: Run(I32) = aggregate.Run take %3 take %8 take %9
  %11: @bits(30) U32 = const 3
  %12: Array(I32) = aggregate.Array take %10 take %11
  write.init borrow.unique (local0) take %12
  %14: Size = const 0
  write.init borrow.unique ([%%3][0]) take %0
  %16: Size = const 1
  write.init borrow.unique ([%%3][1]) take %1
  %18: Size = const 2
  write.init borrow.unique ([%%3][2]) take %2
  %20: Array(I32) = read take (local0)
  write.init borrow.unique (xs) take %20
  %22: Array(I32) [unique call] = read borrow.unique (xs) loan0
  %23: Array(I32) [unique slot 0 view] = call.derivation elementsMut(Array(I32), I32) borrow.unique %22 roots{0}
  %24: I32 = const 0
  %25: Size = convert inspect %24
  %26: I32 = call bump(Array(I32), Size, I32) borrow.unique %23 borrow.shared %25
  write.init borrow.unique (ignored) take %26
  %28: Size = const 0
  %29: Array(I32) [shared call] = read borrow.shared (xs) loan1
  %30: Array(I32) [shared slot 0 view] = call.derivation elements(Array(I32), I32) borrow.shared %29 roots{1}
  %31: I32 [shared slot 0] = call.subscript get(Array(I32), Size, I32) borrow.shared %30 borrow.shared %28 roots{1}
  write.init borrow.unique (local3) borrow.shared %31
  %33: I32 = read copy.trivial (local3)
  %34: Size = const 1
  %35: Array(I32) [shared call] = read borrow.shared (xs) loan2
  %36: Array(I32) [shared slot 0 view] = call.derivation elements(Array(I32), I32) borrow.shared %35 roots{2}
  %37: I32 [shared slot 0] = call.subscript get(Array(I32), Size, I32) borrow.shared %36 borrow.shared %34 roots{2}
  write.init borrow.unique (local4) borrow.shared %37
  %39: I32 = read copy.trivial (local4)
  drop (xs)
  %40: I32 = add inspect %33 inspect %39
  return take %40
}

fn bump(Array(I32), Size, I32)(xs: Array(I32) [unique call view], at: Size [shared call]) -> I32 = <bump at Array(I32), Size, I32>

entry main
