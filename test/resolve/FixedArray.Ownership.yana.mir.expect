  %5: Size = length inspect %4
  %6: Bool = lt inspect %3 inspect %5
  branch inspect %6 -> bb3 -> bb2

bb2:
  return

bb3:
  %8: Size = read copy.trivial (i)
  %9: Size = read copy.trivial (i)
  %10: I32 = read copy.trivial (xs[...])
  %11: Size = read copy.trivial (i)
  %12: I32 = read copy.trivial (xs[...])
  %13: I32 = add inspect %10 inspect %12
  write.assign borrow.unique (xs[...]) take %13
  %15: Size = read copy.trivial (i)
  %16: Size = const 1
  %17: Size = add inspect %15 inspect %16
  write.assign borrow.unique (i) take %17
  jump -> bb1
}

fn middle(xs: Array(I32) [shared call window]) -> I32 {
bb0:
  %0: Array(I32) [shared call window] = read borrow.shared (xs) loan0
  %1: Size = const 1
  %2: Size = const 3
  %3: Size = sub inspect %2 inspect %1
  %4: Array(I32) [shared call window] = window inspect %0 inspect %1 inspect %3 roots{0}
  %5: I32 = call total borrow.shared %4
  return take %5
}

fn pairSum(p: [I32 *2] [shared call]) -> I32 {
bb0:
  %0: [I32 *2] [shared call] = read borrow.shared (p) loan0
  %1: Size = const 0
  %2: Size = const 2
  %3: Array(I32) [shared call window] = window inspect %0 inspect %1 inspect %2 roots{0}
