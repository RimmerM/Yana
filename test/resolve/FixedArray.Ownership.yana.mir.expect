}

fn middle(xs: Array(I32) [shared call view]) -> I32 {
bb0:
  %0: Array(I32) [shared call view] = read borrow.shared (xs) loan0
  %1: Size = const 1
  %2: Size = const 3
  %3: Array(I32) [shared slot 0 view] = call slice(I32) borrow.shared %0 borrow.shared %1 borrow.shared %2 roots{0}
  %4: I32 = call total borrow.shared %3
  return take %4
}

fn pairSum(p: [I32 *2] [shared call]) -> I32 {
bb0:
  %0: [I32 *2] [shared call] = read borrow.shared (p) loan0
  %1: Array(I32) [shared slot 0 view] = call.derivation elements([I32 *2], I32) borrow.shared %0 roots{0}
  %2: I32 = call total borrow.shared %1
  return take %2
}

fn bump(p: [I32 *2] [unique call]) -> {} {
bb0:
  %0: Size = const 0
  %1: Size = const 0
  %2: I32 = read copy.trivial (p[0])
  %3: I32 = const 1
  %4: I32 = add inspect %2 inspect %3
  write.assign borrow.unique (p[0]) take %4
  %6: Size = const 1
  %7: Size = const 1
  %8: I32 = read copy.trivial (p[1])
  %9: I32 = const 1
  %10: I32 = add inspect %8 inspect %9
  write.assign borrow.unique (p[1]) take %10
  return
}

fn firstTwo(xs: [I32 *n] [shared call]) -> I32 {
  form specialized
  slot #0 const n
bb0:
  %0: [I32 *n] = read copy.trivial (xs)
  %1: Size = const 0
  %2: Size = const 2
  %3: [I32 *n] [shared slot 0] = read borrow.shared (xs) loan0
  %4: Array(I32) [shared slot 0 view] = call.derivation elements([I32 *n], I32) borrow.shared %3 roots{0}
  %5: Array(I32) [shared slot 0 view] = call slice(I32) borrow.shared %4 borrow.shared %1 borrow.shared %2 roots{0}
  %6: I32 = call total borrow.shared %5
  return take %6
}

fn quadSum(q: Quad [shared call]) -> I32 {
bb0:
  %0: [I32 *4] [shared call] = read borrow.shared (q.values) loan0
  %1: Array(I32) [shared slot 0 view] = call.derivation elements([I32 *4], I32) borrow.shared %0 roots{0}
  %2: I32 = call total borrow.shared %1
  %3: I32 = read copy.trivial (q.tag)
  %4: I32 = add inspect %2 inspect %3
  return take %4
}

fn copied(xs: Array(I32) [shared call view]) -> Size {
  local ys: Array(I32) [shared call view]
