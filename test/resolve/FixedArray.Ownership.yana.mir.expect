fn bump(p: [I32 *2] [unique call]) -> {} {
bb0:
  %0: Size = const 0
  %1: Size = const 0
  %2: I32 = read copy.trivial (p[0])
  %3: I32 = const 1
  %4: I32 = add inspect %2 inspect %3
  write.assign borrow.unique (p[0]) take %4
  %6: Size = const 1
  %7: Size = const 1
  %8: I32 = read copy.trivial (p[1])
  %9: I32 = const 1
  %10: I32 = add inspect %8 inspect %9
  write.assign borrow.unique (p[1]) take %10
  return
}

fn firstTwo(xs: [I32 *n] [shared call]) -> I32 {
  form specialized
  slot #0 const n
bb0:
  %0: [I32 *n] [shared call] = read borrow.shared (xs) loan0
  %1: Size = const 0
  %2: Size = const 2
  %3: Size = sub inspect %2 inspect %1
  %4: Array(I32) [shared call window] = window inspect %0 inspect %1 inspect %3 roots{0}
  %5: I32 = call total borrow.shared %4
  return take %5
}

fn quadSum(q: Quad [shared call]) -> I32 {
bb0:
  %0: [I32 *4] [shared call] = read borrow.shared (q.values) loan0
