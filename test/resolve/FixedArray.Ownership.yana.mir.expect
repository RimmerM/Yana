  write.init borrow.unique (local3) borrow.shared %16
  %18: I32 = read copy.trivial (local3)
  %19: I32 = add inspect %13 inspect %18
  %20: Array(I32) [unique call view] = read borrow.unique (xs) loan3
  %21: I32 [unique slot 0 owner] = call.subscript getMut(Array(I32), Size, I32) borrow.unique %20 borrow.shared %8 roots{3}
  write.init borrow.unique (local4) borrow.unique %21
  write.assign borrow.unique (local4) take %19
  %24: Size = read copy.trivial (i)
  %25: Size = const 1
