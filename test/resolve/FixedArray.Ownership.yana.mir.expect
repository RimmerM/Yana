bb0:
  %0: Array(I32) [shared call view] = read borrow.shared (xs) loan0
  write.init borrow.unique (ys) borrow.shared %0
  %2: Array(I32) [shared call view] = read borrow.shared (xs) loan1
  write.init borrow.unique (zs) borrow.shared %2
  %4: Array(I32) [shared call view] = read borrow.shared (ys) loan2 roots{0}
  %5: Size = call length(Array(I32)) borrow.shared %4
  %6: Array(I32) [shared call view] = read borrow.shared (zs) loan3 roots{1}
  %7: Size = call length(Array(I32)) borrow.shared %6
  %8: Size = add inspect %5 inspect %7
  %9: Array(I32) [shared call view] = read borrow.shared (xs) loan4
  %10: Size = call length(Array(I32)) borrow.shared %9
  %11: Size = add inspect %8 inspect %10
  return take %11
}

