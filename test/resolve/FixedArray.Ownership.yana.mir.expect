fn total(xs: Array(I32) [shared call window]) -> I32 {
  local & sum: I32
  local & i: Size

bb0:
  %0: I32 = const 0
  write.init borrow.unique (sum) take %0
  %2: Size = const 0
  write.init borrow.unique (i) take %2
  jump -> bb1

bb1:
  %5: Size = read copy.trivial (i)
  %6: Array(I32) [shared call window] = read borrow.shared (xs) loan0
  %7: Size = length inspect %6
  %8: Bool = lt inspect %5 inspect %7
  branch inspect %8 -> bb3 -> bb2

bb2:
  %20: I32 = read copy.trivial (sum)
  return take %20

bb3:
  %10: I32 = read copy.trivial (sum)
  %11: Size = read copy.trivial (i)
  %12: I32 = read copy.trivial (xs[...])
  %13: I32 = add inspect %10 inspect %12
  write.assign borrow.unique (sum) take %13
  %15: Size = read copy.trivial (i)
  %16: Size = const 1
  %17: Size = add inspect %15 inspect %16
  write.assign borrow.unique (i) take %17
  jump -> bb1
}

