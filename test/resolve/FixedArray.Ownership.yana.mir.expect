  %2: Size = const 4
  %3: Array(I32) [shared call window] = window inspect %0 inspect %1 inspect %2 roots{0}
  %4: I32 = call total borrow.shared %3
  %5: I32 = read copy.trivial (q.tag)
  %6: I32 = add inspect %4 inspect %5
  return take %6
}

