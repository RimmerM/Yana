"use strict";
// ResolveTest
function notANumber() {
  return 0 / 0;
}

function infinite() {
  return 1 / 0;
}

function main() {
  var v34;
  if ((Math.min(Math.max(Math.trunc(notANumber()), -2.147483648E9), 2.147483647E9) | 0) === 0) {
    v34 = (Math.min(Math.max(Math.trunc(infinite()), -2.147483648E9), 2.147483647E9) | 0) === 2147483647;
  } else {
    v34 = 0;
  }
  return (v34 ? 50 : 0) + 100 + (1 / 0 > 1000000 ? 20 : 0);
}
main();
