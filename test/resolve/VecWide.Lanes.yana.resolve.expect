let image$base: () = <none>

let &seed: Int = 3

fn main() -> Int {
  b0:
    %v0 = load seed : Int
    %base = vsplat %v0 : Vec(Int)
    %high = vwithlane %base, 40, 5 : Vec(Int)
    %v9 = vlane %high, 5 : Int
    %v12 = cmp_ne %v9, 40 : Bool
    je %v12, b1, b2

  b1:
    ret -1

  b2:
    jmp b3

  b3:
    %v19 = vlane %high, 4 : Int
    %v22 = cmp_ne %v19, 3 : Bool
    je %v22, b4, b5

  b4:
    ret -2

  b5:
    jmp b6

  b6:
    %v29 = vlane %high, 7 : Int
    %v32 = cmp_ne %v29, 3 : Bool
    je %v32, b7, b8

  b7:
    ret -3

  b8:
    jmp b9

  b9:
    %v39 = vlane %high, 0 : Int
    %v42 = cmp_ne %v39, 3 : Bool
    je %v42, b10, b11

  b10:
    ret -4

  b11:
    jmp b12

  b12:
    %low = vwithlane %high, 20, 1 : Vec(Int)
    %v54 = vlane %low, 1 : Int
    %v57 = cmp_ne %v54, 20 : Bool
    je %v57, b13, b14

  b13:
    ret -5

  b14:
    jmp b15

  b15:
    %v64 = vlane %low, 5 : Int
    %v67 = cmp_ne %v64, 40 : Bool
    je %v67, b16, b17

  b16:
    ret -6

  b17:
    jmp b18

  b18:
    %v74 = vlane %low, 6 : Int
    %v77 = cmp_ne %v74, 3 : Bool
    je %v77, b19, b20

  b19:
    ret -7

  b20:
    jmp b21

  b21:
    %v82 = vreduce_max %low : Int
    %v85 = cmp_ne %v82, 40 : Bool
    je %v85, b22, b23

  b22:
    ret -8

  b23:
    jmp b24

  b24:
    %v90 = vreduce_min %low : Int
    %v93 = cmp_ne %v90, 3 : Bool
    je %v93, b25, b26

  b25:
    ret -9

  b26:
    jmp b27

  b27:
    %v98 = vreduce_add %low : Int
    %v101 = cmp_ne %v98, 78 : Bool
    je %v101, b28, b29

  b28:
    ret -10

  b29:
    jmp b30

  b30:
    %v108 = vlane %low, 5 : Int
    %v111 = mul %v108, 10 : Int
    %v114 = vlane %low, 1 : Int
    %v115 = add %v111, %v114 : Int
    ret %v115
}
