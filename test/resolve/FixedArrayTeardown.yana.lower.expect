initHeap<complex>() {
  b_0 {
    %result = syscall 9, 0, 4198400, 3, 34, 18446744073709551615, 0: I64
    %v_1 = cmp_ilt %result, 0: I32
    %v_2 = bitcast 0: Ptr
    %v_3 = bitcast %result: Ptr
    %region = select %v_1, %v_2, %v_3: Ptr
    %v_4 = bitcast %region: I64
    %v_5 = cmp_eq %v_4, 0: I32
    je %v_5, b_6, b_7
  }

  b_7 {
    setpattern %region, 256, 0
    store @heapFree, %region, 8
    %v_8 = add %region, 256: Ptr
    store @heapNext, %v_8, 8
    %v_9 = add %region, 4194304: Ptr
    store @heapLimit, %v_9, 8
    store @heapRegionNext, 8388608, 8
    ret 
  }

  b_6 {
    ret 
  }
}

growHeap<complex>(%needed: I64): I32 {
