    %v_22 = phi [b_11, %v_7], [b_20, %v_17]: Ptr
    store @heapNext, %v_22, 8
    %v_23 = add %v_22, %v_21: Ptr
    store @heapLimit, %v_23, 8
    %v_24 = add %v_21, %v_21: Long
