module ResolveTest

data Held {id: I32} drop authored

instance Drop(Held): Held.drop

let & live: I32 = 0

fn Held.drop(self: Held) -> {} {
bb0:
  %0: I32 = read copy.trivial (global live)
  %1: I32 = const 1
  %2: I32 = sub inspect %0 inspect %1
  write.assign borrow.unique (global live) take %2
  return
}

fn held(id: I32 [shared call]) -> Held {
bb0:
  %0: I32 = read copy.trivial (global live)
  %1: I32 = const 1
  %2: I32 = add inspect %0 inspect %1
  write.assign borrow.unique (global live) take %2
  %4: I32 = read copy.trivial (id)
  %5: Held = aggregate.Held take %4
  return take %5
}

fn counted(n: I32 [shared call], k: I32 [shared call]) -> I32 {
  local & i: I32
  local unused: I32

bb0:
  %0: I32 = const 0
  write.init borrow.unique (i) take %0
  jump -> bb1

bb1:
  %3: I32 = read copy.trivial (i)
  %4: I32 = read copy.trivial (n)
  %5: Bool = lt inspect %3 inspect %4
  branch inspect %5 -> bb3 -> bb2

bb2:
  %18: I32 = read copy.trivial (k)
  return take %18

bb3:
  %7: I32 = read copy.trivial (k)
  %8: I32 = read copy.trivial (i)
  %9: I32 = mul inspect %7 inspect %8
  %10: I32 = const 7
  %11: I32 = add inspect %9 inspect %10
  write.init borrow.unique (unused) take %11
  %13: I32 = read copy.trivial (i)
  %14: I32 = const 1
  %15: I32 = add inspect %13 inspect %14
  write.assign borrow.unique (i) take %15
  jump -> bb1
}

