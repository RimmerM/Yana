fn guarded(x: I32 [shared call], d: I32 [shared call]) -> I32 {
  local quotient: I32

bb0:
  %0: I32 = read copy.trivial (d)
  %1: I32 = const 0
  %2: Bool = ne inspect %0 inspect %1
  branch inspect %2 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %18: I32 = const 0
  return take %18

bb3:
  %4: I32 = read copy.trivial (x)
  %5: I32 = read copy.trivial (d)
  %6: I32 = div inspect %4 inspect %5
  write.init borrow.unique (quotient) take %6
  %8: I32 = read copy.trivial (d)
  %9: I32 = const 0
  %10: Bool = eq inspect %8 inspect %9
  branch inspect %10 -> bb6 -> bb4

bb4:
  jump -> bb5

bb5:
  %15: I32 = read copy.trivial (quotient)
  return take %15

bb6:
  %12: I32 = const -1
  return take %12
}

fn widened(i: I32 [shared call], n: U32 [shared call]) -> I64 {
  local wide: I64
  local unsignedWide: U64

bb0:
  %0: I32 = read copy.trivial (i)
  %1: U32 = bitcast inspect %0
  %2: U32 = read copy.trivial (n)
  %3: Bool = lt inspect %1 inspect %2
  branch inspect %3 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %18: I64 = const 0
  return take %18

bb3:
  %5: I32 = read copy.trivial (i)
  %6: I64 = convert inspect %5
  write.init borrow.unique (wide) take %6
  %8: I32 = read copy.trivial (i)
  %9: U32 = bitcast inspect %8
  %10: U64 = convert inspect %9
  write.init borrow.unique (unsignedWide) take %10
  %12: I64 = read copy.trivial (wide)
  %13: U64 = read copy.trivial (unsignedWide)
  %14: I64 = bitcast inspect %13
  %15: I64 = add inspect %12 inspect %14
  return take %15
}

fn main() -> I32 {
bb0:
  %0: I32 = const 4
  %1: I32 = const 3
  %2: I32 = call counted borrow.shared %0 borrow.shared %1
  %3: I32 = const 2
  %4: I32 = mul inspect %2 inspect %3
