fn owning(n: I32 [shared call]) -> I32 {
  local & i: I32
  local doomed: Held

bb0:
  %0: I32 = const 0
  write.init borrow.unique (i) take %0
  jump -> bb1

bb1:
  %3: I32 = read copy.trivial (i)
  %4: I32 = read copy.trivial (n)
  %5: Bool = lt inspect %3 inspect %4
  branch inspect %5 -> bb3 -> bb2

bb2:
  %15: I32 = const 0
  return take %15

bb3:
  %7: I32 = read copy.trivial (i)
  %8: Held = call held borrow.shared %7
  write.init borrow.unique (doomed) take %8
  drop (doomed)
  %10: I32 = read copy.trivial (i)
  %11: I32 = const 1
  %12: I32 = add inspect %10 inspect %11
  write.assign borrow.unique (i) take %12
  jump -> bb1
}

fn escapes(n: I32 [shared call], stop: I32 [shared call]) -> I32 {
  local & i: I32

bb0:
  %0: I32 = const 0
  write.init borrow.unique (i) take %0
  jump -> bb1

bb1:
  %3: I32 = read copy.trivial (i)
