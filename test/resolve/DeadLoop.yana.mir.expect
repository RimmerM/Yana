bb4:
  jump -> bb5

bb5:
  %13: I32 = read copy.trivial (i)
  %14: I32 = const 1
  %15: I32 = add inspect %13 inspect %14
  write.assign borrow.unique (i) take %15
  jump -> bb1

bb6:
  jump -> bb2
}

fn nested(rows: I32 [shared call], columns: I32 [shared call]) -> I32 {
  local & total: I32
  local & row: I32
  local & column: I32
  local unused: I32

bb0:
  %0: I32 = const 0
  write.init borrow.unique (total) take %0
