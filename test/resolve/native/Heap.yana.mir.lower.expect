    %v_16 = add %v_14, %v_11: Ptr
    store @heapLimit, %v_16, 8
    %v_17 = add %v_11, %v_11: I64
    store @heapRegionNext, %v_17, 8
    ret 1
  }

  b_8 {
    %v_18 = cmp_igt %needed, 4194304: I32
    %v_13 = select %v_18, %needed, 4194304: I64
    %v_19 = cmp_ige %v_13, %v_3: I32
    je %v_19, b_20, b_21
  }

  b_21 {
    %v_22 = add %v_13, 4096: I64
    %v_15 = call_complex mapMemory, %v_22: Ptr
    %v_23 = bitcast %v_15: I64
    %v_24 = cmp_eq %v_23, 0: I32
    je %v_24, b_20, b_12
  }

  b_20 {
    ret 0
  }

  b_12 {
    jmp b_10
  }
}

