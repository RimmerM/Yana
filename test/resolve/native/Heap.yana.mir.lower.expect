    %v_19 = cmp_ige %v_13, %v_3: I32
    je %v_19, b_20, b_21
  }

  b_21 {
    %v_22 = add %v_13, 4096: I64
    %v_15 = call_complex mapMemory, %v_22: Ptr
    %v_23 = bitcast %v_15: I64
    %v_24 = cmp_eq %v_23, 0: I32
    je %v_24, b_20, b_12
  }

  b_20 {
    ret 0
  }

  b_12 {
    jmp b_10
  }
}

