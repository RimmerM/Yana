fn bumped() -> I32 {
  local before: %U8
  local block: %U8

bb0:
  %0: %U8 = read copy.trivial (global heapNext)
  write.init borrow.unique (before) take %0
  %2: Size = const 100
  %3: %U8 = call allocateHeap borrow.shared %2
  write.init borrow.unique (block) take %3
  %5: %U8 = read copy.trivial (block)
  %6: Bool = call isNull(U8) borrow.shared %5
  branch inspect %6 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %11: %U8 = read copy.trivial (before)
  %12: %U8 = read copy.trivial (global heapNext)
  %13: Size = bitcast inspect %12
  %14: Size = bitcast inspect %11
  %15: Size = sub inspect %13 inspect %14
  %16: Size = metric stride U8
  %17: Size = div inspect %15 inspect %16
  %18: I32 = convert inspect %17
  return take %18

bb3:
  %8: I32 = const 0
  return take %8
}

fn main() -> I32 {
bb0:
  %0: I32 = call roundTrip
  %1: I32 = call reuse
  %2: I32 = add inspect %0 inspect %1
  %3: I32 = call classes
  %4: I32 = add inspect %2 inspect %3
  %5: I32 = call bumped
  %6: I32 = add inspect %4 inspect %5
