module ResolveTest

fn roundTrip() -> I32 {
  local p: %U8
  local cells: %I32

bb0:
  %0: Size = const 64
  %1: %U8 = call allocateHeap borrow.shared %0
  write.init borrow.unique (p) take %1
  %3: %U8 = read copy.trivial (p)
  %4: Bool = call isNull(U8) borrow.shared %3
  branch inspect %4 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %9: %U8 = read copy.trivial (p)
  %10: %I32 = bitcast inspect %9
  write.init borrow.unique (cells) take %10
  %12: %I32 = read copy.trivial (cells)
  %13: I32 = const 11
  write.assign borrow.unique ([%%12]) take %13
  %15: {} = const {}
  %16: %I32 = read copy.trivial (cells)
  %17: Size = const 3
  %18: Size = metric stride I32
  %19: Size = mul inspect %17 inspect %18
  %20: %I32 [owned here shape6 .*=shared slot 0] = add inspect %16 inspect %19
  %21: I32 = const 22
  write.assign borrow.unique ([%%20]) take %21
  %23: {} = const {}
  %24: %I32 = read copy.trivial (cells)
  %25: I32 = read copy.trivial ([%%24])
  %26: I32 = const 100
  %27: I32 = mul inspect %25 inspect %26
  %28: %I32 = read copy.trivial (cells)
  %29: Size = const 3
  %30: Size = metric stride I32
  %31: Size = mul inspect %29 inspect %30
  %32: %I32 [owned here shape6 .*=shared slot 0] = add inspect %28 inspect %31
  %33: I32 = read copy.trivial ([%%32])
  %34: I32 = add inspect %27 inspect %33
  return take %34

bb3:
  %6: I32 = const 0
  return take %6
}

fn reuse() -> I32 {
  local first: %U8
  local again: %U8

bb0:
  %0: Size = const 40
  %1: %U8 = call allocateHeap borrow.shared %0
  write.init borrow.unique (first) take %1
  %3: %U8 = read copy.trivial (first)
  %4: Bool = call isNull(U8) borrow.shared %3
  branch inspect %4 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %9: %U8 = read copy.trivial (first)
  %10: {} = call freeHeap borrow.shared %9
  %11: Size = const 40
  %12: %U8 = call allocateHeap borrow.shared %11
  write.init borrow.unique (again) take %12
  %14: %U8 = read copy.trivial (first)
  %15: %U8 = read copy.trivial (again)
  %16: Bool = eq inspect %14 inspect %15
  branch inspect %16 -> bb6 -> bb4

bb3:
  %6: I32 = const 0
  return take %6

bb4:
  %19: I32 = const 1
  jump -> bb5(take %19)

bb5(%20: I32):
  return take %20

bb6:
  %18: I32 = const 7
  jump -> bb5(take %18)
}

