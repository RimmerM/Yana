mut @sink = [0, 0, 0, 0, 0, 0, 0, 0]

quadWidth<complex>(%v: i16x4): I32 {
  b_0 {
    %v_1 = call_complex widthOf(4), %v: I32
    ret %v_1
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = load @sink, 8: i16x4
    %v_2 = vwithlane %v_1, 9, 1: i16x4
    %v_3 = call_complex doubled(4), %v_2: i16x4
    %v_4 = call_complex twice(4), %v_2: i16x4
    %v_5 = call_complex sameCount(4), %v_2, %v_3: i16x4
    %v_6 = call_complex sameCount(4), %v_4, %v_5: i16x4
    store @sink, %v_3, 8
    %v_7 = call_complex widthOf(4), %v_2: I32
    %v_8 = call_complex quadWidth, %v_2: I32
    %v_9 = add %v_7, %v_8: I32
    %v_10 = call_complex secondLane(4), %v_3: I32
    %v_11 = add %v_9, %v_10: I32
    %v_12 = call_complex secondLane(4), %v_6: I32
    %v_13 = add %v_11, %v_12: I32
    %v_14 = vlane %v_6, 2: I32
    %v_15 = imm 16: I32
    %v_16 = shl %v_14, %v_15: I32
    %v_17 = sar %v_16, %v_15: I32
    %v_18 = add %v_13, %v_17: I32
    ret %v_18
  }
}

doubled(4)<complex>(%v: i16x4): i16x4 {
  b_0 {
    %v_1 = vshuffle %v, %v, 3, 2, 1, 0: i16x4
    %v_2 = cmp_igt %v_1, %v: m16x4
    %v_3 = select %v_2, %v_1, %v: i16x4
    ret %v_3
  }
}

twice(4)<complex>(%v: i16x4): i16x4 {
  b_0 {
    %v_1 = add %v, %v: i16x4
    ret %v_1
  }
}

sameCount(4)<complex>(%v: i16x4, %w: i16x4): i16x4 {
  b_0 {
    %v_1 = add %v, %w: i16x4
    ret %v_1
  }
}

widthOf(4)<complex>(%v: i16x4): I32 {
  b_0 {
    ret 4
  }
}

secondLane(4)<complex>(%v: i16x4): I32 {
  b_0 {
    %v_1 = vlane %v, 1: I32
    %v_2 = imm 16: I32
    %v_3 = shl %v_1, %v_2: I32
    %v_4 = sar %v_3, %v_2: I32
    ret %v_4
  }
}

