// Shapes
function origin() {
  return { x: 0, y: 0 };
}

function scale(value$x, value$y, by) {
  var v2 = { x: 0, y: 0 };
  var v4 = Math.imul(value$x, by) | 0;
  var v6 = Math.imul(value$y, by) | 0;
  v2.x = v4;
  v2.y = v6;
