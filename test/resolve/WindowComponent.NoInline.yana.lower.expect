@image$base = []
mut @calls = [0, 0, 0, 0]

checkFailed<complex>() {
  b_0 {
    call_complex abortProcess
    ret 
  }
}

checkCondition<complex>(%failed: I32) {
  b_0 {
    je %failed, b_1, b_2
  }

  b_1 {
    call_complex checkFailed
    unreachable 
  }

  b_2 {
    ret 
  }
}

+=(I32)<complex>(%target: Ptr, %amount: I32) {
  b_0 {
    %v_1 = loads %target, 4: I32
    %v_2 = add %v_1, %amount: I32
    store %target, %v_2, 4
    ret 
  }
}

abortProcess<complex>() {
  b_0 {
    call_complex exitProcess, 134
    ret 
  }
}

numberOf<complex>(%call: I32): I64 {
  b_0 {
    %v_1 = cast %call: I64
    ret %v_1
  }
}

exitProcess<complex>(%status: I64) {
  b_0 {
    %v_1 = call_complex numberOf, 60: I64
    %v_2 = syscall %v_1, %status: I64
    ret 
  }
}

poke<complex>(%h: Ptr) {
  b_0 {
    %v_1 = add %h, 8: Ptr
    %v_2 = loads %v_1, 8: I64
    %v_3 = cmp_eq %v_2, 0: I32
    call_complex checkCondition, %v_3
    %v_4 = load %h, 8: Ptr
    store %v_4, 99, 4
    ret 
  }
}

pokeMove<complex>(%h: Ptr) {
  b_0 {
    %v_1 = add %h, 8: Ptr
    %v_2 = loads %v_1, 8: I64
    %v_3 = cmp_ge 1, %v_2: I32
    call_complex checkCondition, %v_3
    %v_4 = load %h, 8: Ptr
    %v_5 = add %v_4, 4: Ptr
    store %v_5, 77, 4
    ret 
  }
}

viaRecord<complex>(): I32 {
  b_0 {
    call_complex +=(I32), @calls, 1
    %v_1 = alloca 16, 4: Ptr
    setpattern %v_1, 16, 0
    store %v_1, 5, 4
    %v_2 = add %v_1, 4: Ptr
    store %v_2, 6, 4
    %v_3 = alloca 20, 8: Ptr
    store %v_3, %v_1, 8
    %v_4 = add %v_3, 8: Ptr
    store %v_4, 4, 8
    %v_5 = add %v_3, 16: Ptr
    store %v_5, 1, 4
    call_complex poke, %v_3
    call_complex pokeMove, %v_3
    %v_6 = loads %v_1, 4: I32
    %v_7 = imul %v_6, 100: I32
    %v_8 = add %v_1, 4: Ptr
    %v_9 = loads %v_8, 4: I32
    %v_10 = add %v_7, %v_9: I32
    ret %v_10
  }
}

viaRecordSameBlock<complex>(): I32 {
  b_0 {
    call_complex +=(I32), @calls, 1
    %v_1 = alloca 16, 4: Ptr
    setpattern %v_1, 16, 0
    store %v_1, 5, 4
    %v_2 = add %v_1, 4: Ptr
    store %v_2, 4, 4
    %v_3 = alloca 20, 8: Ptr
    store %v_3, %v_1, 8
    %v_4 = add %v_3, 8: Ptr
    store %v_4, 4, 8
    %v_5 = add %v_3, 16: Ptr
    store %v_5, 1, 4
    call_complex pokeMove, %v_3
    %v_6 = add %v_1, 4: Ptr
    %v_7 = loads %v_6, 4: I32
    %v_8 = sub %v_7, 72: I32
    ret %v_8
  }
}

main<complex>(): I32 {
  b_0 {
    %failed = alloca 4, 4: Ptr
    store %failed, 0, 4
    %v_1 = call_complex viaRecord: I32
    %v_2 = cmp_neq %v_1, 9977: I32
    je %v_2, b_3, b_4
  }

  b_3 {
    call_complex +=(I32), %failed, 1
    jmp b_5
  }

  b_4 {
    jmp b_5
  }

  b_5 {
    %v_6 = call_complex viaRecordSameBlock: I32
    %v_7 = cmp_neq %v_6, 5: I32
    je %v_7, b_8, b_9
  }

  b_8 {
    call_complex +=(I32), %failed, 2
    jmp b_10
  }

  b_9 {
    jmp b_10
  }

  b_10 {
    %v_11 = loads @calls, 4: I32
    %v_12 = cmp_neq %v_11, 2: I32
    je %v_12, b_13, b_14
  }

  b_13 {
    call_complex +=(I32), %failed, 4
    jmp b_15
  }

  b_14 {
    jmp b_15
  }

  b_15 {
    %v_16 = loads %failed, 4: I32
    ret %v_16
  }
}

