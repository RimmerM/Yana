{-
   `VecUpTo.yana` at `avx2`, where a four- or eight-byte lane is `vpmaskmovd`/`q` under a vector of

   # extensions: avx2
   whole-lane masks, and a byte or a word lane is still the ladder - at thirty-two bytes, so with the
   sixteen-byte rung the floor has no use for. The source is the same; see that file.
-}
import Native

-- Two pages, the second one a guard: a byte at `page + 4096` or past it is a fault.
fn guardedPage() -> %U8:
    let page = mapMemory(8192)
    protectNone(page + (4096 :: Size), 4096)
    return page

-- Odd bytes, so that no lane of the pattern is zero and a lane read past the count could not pass
-- for the zero it should have been.
fn fillPattern(page: %U8):
    let &i = 0 :: Size
    while i < 4096:
        store(page + i, truncate(i * 14 + 3) :: U8)
        i = i + 1

fn fillSentinel(page: %U8):
    let &i = 0 :: Size
    while i < 4096:
        store(page + i, 0xab :: U8)
        i = i + 1

-- How many of the first `total` bytes at `got` differ from those at `want`, where `want` is null for
-- zeros.
fn differing(got: %U8, want: %U8, live: Int, total: Int) -> Int:
    let &wrong = 0
    let &b = 0
    while b < total:
        let expected = if b < live then *(want + (b :: Size)) else 0 :: U8
        if *(got + (b :: Size)) != expected then wrong = wrong + 1
        b = b + 1
    return wrong

-- How many bytes of the page differ from the sentinel below `start` and from `values` above it.
fn storedWrong(page: %U8, start: Int, values: %U8) -> Int:
    let &wrong = 0
    let &b = 0
    while b < 4096:
        let expected = if b < start then 0xab :: U8 else *(values + ((b - start) :: Size))
        if *(page + (b :: Size)) != expected then wrong = wrong + 1
        b = b + 1
    return wrong

-- U8: every count, the load and the store each ending at the guard.
fn upToU8(page: %U8, scratch: %U8) -> Int:
    let lanesOf = lanes(zero() :: Vec(U8))
    let width = 1
    let total = lanesOf * width
    let values = (iota() :: Vec(U8)) * splat(2 :: U8) + splat(1 :: U8)
    let &wrong = 0
    let &c = 0 - 2

    while c <= lanesOf + 2:
        let live = if c < 0 then 0 else if c > lanesOf then lanesOf else c
        let start = 4096 - live * width
        let at = page + (start :: Size)

        fillPattern(page)
        setVectorAt(bitcast(scratch) :: %U8, loadUpTo(bitcast(at) :: %U8, c) :: Vec(U8))
        wrong = wrong + differing(scratch, at, live * width, total)

        fillSentinel(page)
        storeUpTo(bitcast(at) :: %U8, c, values)
        setVectorAt(bitcast(scratch) :: %U8, values)
        wrong = wrong + storedWrong(page, start, scratch)

        c = c + 1

    return wrong

-- U16: every count, the load and the store each ending at the guard.
fn upToU16(page: %U8, scratch: %U8) -> Int:
    let lanesOf = lanes(zero() :: Vec(U16))
    let width = 2
    let total = lanesOf * width
    let values = (iota() :: Vec(U16)) * splat(2 :: U16) + splat(1 :: U16)
    let &wrong = 0
    let &c = 0 - 2

    while c <= lanesOf + 2:
        let live = if c < 0 then 0 else if c > lanesOf then lanesOf else c
        let start = 4096 - live * width
        let at = page + (start :: Size)

        fillPattern(page)
        setVectorAt(bitcast(scratch) :: %U16, loadUpTo(bitcast(at) :: %U16, c) :: Vec(U16))
        wrong = wrong + differing(scratch, at, live * width, total)

        fillSentinel(page)
        storeUpTo(bitcast(at) :: %U16, c, values)
        setVectorAt(bitcast(scratch) :: %U16, values)
        wrong = wrong + storedWrong(page, start, scratch)

        c = c + 1

    return wrong

