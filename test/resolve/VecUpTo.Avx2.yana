fn upToF32(page: %U8, scratch: %U8) -> Int:
    let lanesOf = lanes(zero() :: Vec(F32))
    let width = 4
    let total = lanesOf * width
    let values = bitcast((iota() :: Vec(U32)) * splat(2 :: U32) + splat(1 :: U32)) :: Vec(F32)
    let &wrong = 0
    let &c = 0 - 2

    while c <= lanesOf + 2:
        let live = if c < 0 then 0 else if c > lanesOf then lanesOf else c
