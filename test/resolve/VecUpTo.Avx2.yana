-- F64: every count, the load and the store each ending at the guard.
fn upToF64(page: %U8, scratch: %U8) -> Int:
    let lanesOf = lanes(zero() :: Vec(F64))
    let width = 8
    let total = lanesOf * width
    let values = bitcast((iota() :: Vec(U64)) * splat(2 :: U64) + splat(1 :: U64)) :: Vec(F64)
    let &wrong = 0
    let &c = 0 - 2

    while c <= lanesOf + 2:
        let live = if c < 0 then 0 else if c > lanesOf then lanesOf else c
        let start = 4096 - live * width
        let at = page + (start :: Size)

        fillPattern(page)
        setVectorAt(bitcast(scratch) :: %F64, loadUpTo(bitcast(at) :: %F64, c) :: Vec(F64))
        wrong = wrong + differing(scratch, at, live * width, total)

        fillSentinel(page)
        storeUpTo(bitcast(at) :: %F64, c, values)
        setVectorAt(bitcast(scratch) :: %F64, values)
        wrong = wrong + storedWrong(page, start, scratch)

        c = c + 1

    return wrong

-- The three counts a constant decides: none, some and all, at the natural byte vector.
fn constants(page: %U8, scratch: %U8) -> Int:
    let lanesOf = lanes(zero() :: Vec(U8))
    let whole = 4096 - lanesOf
    let &wrong = 0

    fillPattern(page)
    setVectorAt(scratch, loadUpTo(page + (whole :: Size), 0) :: Vec(U8))
    wrong = wrong + differing(scratch, page, 0, lanesOf)
    setVectorAt(scratch, loadUpTo(page + (whole :: Size), lanesOf) :: Vec(U8))
    wrong = wrong + differing(scratch, page + (whole :: Size), lanesOf, lanesOf)
    setVectorAt(scratch, loadUpTo(page + (4093 :: Size), 3) :: Vec(U8))
    wrong = wrong + differing(scratch, page + (4093 :: Size), 3, lanesOf)

    fillSentinel(page)
    storeUpTo(page + (whole :: Size), 0, splat(1 :: U8) :: Vec(U8))
    storeUpTo(page + (4093 :: Size), 3, splat(7 :: U8) :: Vec(U8))
    setVectorAt(scratch, splat(7 :: U8) :: Vec(U8))
    wrong = wrong + storedWrong(page, 4093, scratch)

    return wrong

fn main() -> Int:
    let page = guardedPage()
    let scratch = mapMemory(4096)
    let &wrong = constants(page, scratch)
    wrong = wrong + upToU8(page, scratch)
    wrong = wrong + upToU16(page, scratch)
    wrong = wrong + upToU32(page, scratch)
    wrong = wrong + upToU64(page, scratch)
    wrong = wrong + upToF32(page, scratch)
    wrong = wrong + upToF64(page, scratch)
    return wrong
