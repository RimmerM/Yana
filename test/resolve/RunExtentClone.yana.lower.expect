@image$base = []
mut @heapNext = [0, 0, 0, 0, 0, 0, 0, 0]
mut @heapLimit = [0, 0, 0, 0, 0, 0, 0, 0]
mut @heapFree = [0, 0, 0, 0, 0, 0, 0, 0]
mut @heapRegionNext = [0, 0, 0, 0, 0, 0, 0, 0]

mapMemory<complex>(%size: I64): Ptr {
  b_0 {
    %result = syscall 9, 0, %size, 3, 34, 18446744073709551615, 0: I64
    %v_1 = cmp_ilt %result, 0: I32
    je %v_1, b_2, b_3
  }

  b_2 {
    %v_4 = bitcast 0: Ptr
    ret %v_4
  }

  b_3 {
    jmp b_5
  }

  b_5 {
    %v_6 = bitcast %result: Ptr
    ret %v_6
  }
}

growHeap<complex>(%needed: I64): I32 {
  b_0 {
    %v_1 = loads @heapRegionNext, 8: I64
    %v_2 = cmp_ilt %v_1, %needed: I32
    je %v_2, b_3, b_4
  }

  b_3 {
    jmp b_5
  }

  b_4 {
    jmp b_5
  }

  b_5 {
    %v_6 = phi [b_3, %needed], [b_4, %v_1]: I64
    %v_7 = add %v_6, 4096: I64
    %v_8 = call_complex mapMemory, %v_7: Ptr
    %v_9 = bitcast %v_8: I64
    %v_10 = cmp_eq %v_9, 0: I32
    je %v_10, b_11, b_12
  }

  b_11 {
    %v_13 = cmp_igt %needed, 4194304: I32
    %least = select %v_13, %needed, 4194304: I64
    %v_14 = cmp_ige %least, %v_6: I32
    je %v_14, b_15, b_16
  }

  b_12 {
    jmp b_17
  }

  b_15 {
    ret 0
  }

  b_16 {
    %v_18 = add %least, 4096: I64
    %v_19 = call_complex mapMemory, %v_18: Ptr
    %v_20 = bitcast %v_19: I64
    %v_21 = cmp_eq %v_20, 0: I32
    je %v_21, b_15, b_22
  }

  b_22 {
    jmp b_17
  }

  b_17 {
    %v_23 = phi [b_12, %v_6], [b_22, %least]: I64
    %v_24 = phi [b_12, %v_8], [b_22, %v_19]: Ptr
    store @heapNext, %v_24, 8
    %v_25 = add %v_24, %v_23: Ptr
    store @heapLimit, %v_25, 8
    %v_26 = add %v_23, %v_23: I64
    store @heapRegionNext, %v_26, 8
    ret 1
  }
}

allocateHeap<complex>(%size: I64): Ptr {
  b_0 {
    %v_1 = load @heapFree, 8: Ptr
    %v_2 = bitcast %v_1: I64
    %v_3 = cmp_eq %v_2, 0: I32
    je %v_3, b_4, b_5
  }

  b_5 {
    jmp b_6
  }

  b_4 {
    %result = syscall 9, 0, 4198400, 3, 34, 18446744073709551615, 0: I64
    %v_7 = cmp_ilt %result, 0: I32
    %v_8 = bitcast 0: Ptr
    %v_9 = bitcast %result: Ptr
    %region = select %v_7, %v_8, %v_9: Ptr
    %v_10 = bitcast %region: I64
    %v_11 = cmp_eq %v_10, 0: I32
    je %v_11, b_12, b_13
  }

  b_13 {
    setpattern %region, 256, 0
    store @heapFree, %region, 8
    %v_14 = add %region, 256: Ptr
    store @heapNext, %v_14, 8
    %v_15 = add %region, 4194304: Ptr
    store @heapLimit, %v_15, 8
    store @heapRegionNext, 8388608, 8
    jmp b_16
  }

  b_12 {
    jmp b_16
  }

  b_16 {
    %v_17 = load @heapFree, 8: Ptr
    %v_18 = bitcast %v_17: I64
    %v_19 = cmp_eq %v_18, 0: I32
    je %v_19, b_20, b_21
  }

  b_21 {
    jmp b_6
  }

  b_6 {
    %v_22 = add %size, 8: I64
    jmp b_23
  }

  b_23 {
    %v_24 = phi [b_6, 16], [b_25, %v_26]: I64
    %v_27 = phi [b_6, 0], [b_25, %v_28]: I64
    %v_29 = cmp_ilt %v_24, %v_22: I32
    je %v_29, b_25, b_30
  }

  b_30 {
    %v_31 = cmp_ige %v_27, 32: I32
    je %v_31, b_32, b_33
  }

  b_33 {
    %v_34 = load @heapFree, 8: Ptr
    %v_35 = shl %v_27, 3: I64
    %v_36 = add %v_34, %v_35: Ptr
    %v_37 = load %v_36, 8: Ptr
    %v_38 = bitcast %v_37: I64
    %v_39 = cmp_eq %v_38, 0: I32
    je %v_39, b_40, b_41
  }

  b_40 {
    %v_42 = shl 16, %v_27: I64
    %v_43 = load @heapNext, 8: Ptr
    %v_44 = add %v_43, %v_42: Ptr
    %v_45 = load @heapLimit, 8: Ptr
    %v_46 = cmp_gt %v_44, %v_45: I32
    je %v_46, b_47, b_48
  }

  b_48 {
    jmp b_49
  }

  b_47 {
    %v_50 = call_complex growHeap, %v_42: I32
    je %v_50, b_51, b_32
  }

  b_51 {
    jmp b_49
  }

  b_49 {
    %block = load @heapNext, 8: Ptr
    %v_52 = add %block, %v_42: Ptr
    store @heapNext, %v_52, 8
    store %block, %v_27, 8
    %v_53 = add %block, 8: Ptr
    ret %v_53
  }

  b_32 {
    %v_54 = bitcast 0: Ptr
    ret %v_54
  }

  b_41 {
    %v_55 = load %v_37, 8: Ptr
    store %v_36, %v_55, 8
    ret %v_37
  }

  b_25 {
    %v_26 = add %v_24, %v_24: I64
    %v_28 = add %v_27, 1: I64
    jmp b_23
  }

  b_20 {
    ret %v_8
  }
}

freeHeap<complex>(%allocation: Ptr) {
  b_0 {
    %v_1 = bitcast %allocation: I64
    %v_2 = cmp_eq %v_1, 0: I32
    je %v_2, b_3, b_4
  }

  b_3 {
    ret 
  }

  b_4 {
    jmp b_5
  }

  b_5 {
    %v_6 = sub %allocation, 8: Ptr
    %sizeClass = loads %v_6, 8: I64
    %v_7 = load @heapFree, 8: Ptr
    %v_8 = shl %sizeClass, 3: I64
    %v_9 = add %v_7, %v_8: Ptr
    %v_10 = load %v_9, 8: Ptr
    store %allocation, %v_10, 8
    %v_11 = load @heapFree, 8: Ptr
    %v_12 = add %v_11, %v_8: Ptr
    store %v_12, %allocation, 8
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    jmp b_1
  }

  b_2 {
    %v_3 = cmp_ilt %v_4, 3: I32
    je %v_3, b_1, b_5
  }

  b_1 {
    %v_6 = phi [b_2, %v_7], [b_0, 0]: I64
    %v_8 = phi [b_2, %v_4], [b_0, 0]: I64
    %v_4 = add %v_8, 1: I64
    %v_9 = shl %v_4, 2: I64
    %v_10 = alloca 4, 8: Ptr
    %v_11 = call_complex allocateHeap, %v_9: Ptr
    %v_12 = cast %v_9: I32
    %v_13 = and %v_12, 1073741820: I32
    %v_14 = load %v_10, 4: I32
    %v_15 = or %v_13, 1073741824: I32
    store %v_10, %v_15, 4
    %v_16 = cast %v_13: I64
    %last = sub %v_16, 1: I64
    %target = add %v_11, %last: Ptr
    store %target, 42, 1
    %v_17 = imul %v_16, 1000: I64
    call_complex freeHeap, %v_11
    %v_18 = add %v_17, 42: I64
    %v_7 = add %v_6, %v_18: I64
    jmp b_2
  }

  b_5 {
    %v_19 = cast %v_7: I32
    ret %v_19
  }
}

