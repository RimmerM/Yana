fn apply(f: (I32) -> I32 [shared call], x: I32 [shared call]) -> I32 {
bb0:
  %0: (I32) -> I32 [shared call] = read borrow.shared (f) loan0
  %1: I32 = read copy.trivial (x)
  %2: I32 = call inspect %0 borrow.shared %1
  return take %2
}

fn direct(base: I32 [shared call]) -> I32 {
  local direct.lambda.env: direct.lambda.env
  local local2: (I32) -> I32 [owned here shape8 .0=shared call]

bb0:
  %0: I32 = read copy.trivial (base)
  %1: direct.lambda.env = aggregate.direct.lambda.env take %0
  write.init borrow.unique (direct.lambda.env) take %1
  %3: direct.lambda.env [shared call] = read borrow.shared (direct.lambda.env) loan0
  %4: (I32) -> I32 [owned here shape8 .0=shared call] = fun.value direct.lambda inspect %3 roots.0{0}
  write.init borrow.unique (local2) take %4
  %6: (I32) -> I32 [shared call shape8 .0=shared call] = read borrow.shared (local2) loan1 roots.0{0}
  %7: I32 = const 1
  %8: I32 = call apply borrow.shared %6 borrow.shared %7
  return take %8
}

fn either(pick: I32 [shared call], a: I32 [shared call], b: I32 [shared call]) -> I32 {
  local local3: either.lambda.env
  local local4: either.lambda'2.env
  local f: (I32) -> I32 [owned here shape8 .0=shared call]

bb0:
  %0: I32 = read copy.trivial (pick)
  %1: I32 = const 1
  %2: Bool = lt inspect %0 inspect %1
  branch inspect %2 -> bb3 -> bb1

bb1:
  %6: I32 = read copy.trivial (b)
  %7: either.lambda'2.env = aggregate.either.lambda'2.env take %6
  write.init borrow.unique (local4) take %7
  %12: either.lambda'2.env [shared call] = read borrow.shared (local4) loan1
  %13: (I32) -> I32 [owned here shape8 .0=shared call] = fun.value either.lambda'2 inspect %12 roots.0{1}
  jump -> bb2(take %13)

bb2(%14: (I32) -> I32 [owned here shape8 .0=shared call]):
  write.init borrow.unique (f) take %14
  %18: (I32) -> I32 [shared call shape8 .0=shared call] = read borrow.shared (f) loan2 roots.0{0, 1}
  %19: I32 = const 10
  %20: I32 = call apply borrow.shared %18 borrow.shared %19
  return take %20

bb3:
  %4: I32 = read copy.trivial (a)
  %5: either.lambda.env = aggregate.either.lambda.env take %4
  write.init borrow.unique (local3) take %5
  %9: either.lambda.env [shared call] = read borrow.shared (local3) loan0
  %10: (I32) -> I32 [owned here shape8 .0=shared call] = fun.value either.lambda inspect %9 roots.0{0}
  jump -> bb2(take %10)
}

fn escaping(amount: I32 [shared call]) -> (I32) -> I32 {
  local escaping.lambda.env: escaping.lambda.env

bb0:
  %0: I32 = read copy.trivial (amount)
  %1: escaping.lambda.env = aggregate.escaping.lambda.env take %0
  write.init borrow.unique (escaping.lambda.env) take %1
  %3: escaping.lambda.env = read copy.trivial (escaping.lambda.env)
  %4: (I32) -> I32 = fun.value escaping.lambda take %3
  return take %4
}

fn main() -> I32 {
  local a: I32
  local b: I32
  local c: I32
  local f: (I32) -> I32
  local d: I32

bb0:
  %0: I32 = const 5
  %1: I32 = call direct borrow.shared %0
  write.init borrow.unique (a) take %1
  %3: I32 = const 0
  %4: I32 = const 3
  %5: I32 = const 7
  %6: I32 = call either borrow.shared %3 borrow.shared %4 borrow.shared %5
  write.init borrow.unique (b) take %6
  %8: I32 = const 2
  %9: I32 = const 3
  %10: I32 = const 7
  %11: I32 = call either borrow.shared %8 borrow.shared %9 borrow.shared %10
  write.init borrow.unique (c) take %11
  %13: I32 = const 100
  %14: (I32) -> I32 = call escaping borrow.shared %13
  write.init borrow.unique (f) take %14
  %16: (I32) -> I32 [shared call] = read borrow.shared (f) loan0
  %17: I32 = const 1
  %18: I32 = call inspect %16 borrow.shared %17
  drop (f)
  write.init borrow.unique (d) take %18
  %20: I32 = read copy.trivial (a)
  %21: I32 = read copy.trivial (b)
  %22: I32 = add inspect %20 inspect %21
  %23: I32 = read copy.trivial (c)
  %24: I32 = add inspect %22 inspect %23
  %25: I32 = read copy.trivial (d)
  %26: I32 = add inspect %24 inspect %25
  return take %26
}

