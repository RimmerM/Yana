  }

  b_25 {
    %v_35 = phi [b_26, %v_31], [b_24, %base]: i32x4
    %v_36 = phi [b_26, %v_28], [b_24, 0]: I32
    %v_31 = add %v_35, %base: i32x4
    %v_28 = add %v_36, 1: I32
    jmp b_26
  }

  b_33 {
    ret 18446744073709551611
  }

  b_34 {
    jmp b_37
