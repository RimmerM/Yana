  b_26 {
    %v_27 = cmp_ilt %v_28, 4: I32
    je %v_27, b_25, b_29
  }

  b_29 {
    %v_30 = vlane %v_31, 0: I32
    %v_32 = cmp_neq %v_30, 15: I32
