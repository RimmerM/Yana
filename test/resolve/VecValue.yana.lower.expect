  b_48 {
    %v_49 = vlane %v_2, 1: I32
    %v_50 = imul %v_49, 100: I32
    %v_51 = vlane %v_4, 0: I32
    %v_52 = add %v_50, %v_51: I32
    %v_53 = vlane %mixed, 0: I32
