  }

  b_40 {
    ret 18446744073709551610
  }

  b_41 {
    jmp b_42
  }

  b_42 {
    %lanes = vreduce_add %v_3: I32
    %v_43 = vreduce_add %v_31: I32
    %v_44 = imul %lanes, 15: I32
    %v_45 = cmp_neq %v_43, %v_44: I32
    je %v_45, b_46, b_47
  }

