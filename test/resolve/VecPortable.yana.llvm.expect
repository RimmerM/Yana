target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

@"image$base" = constant [0 x i8] zeroinitializer, align 8
@seed = global [4 x i8] c"\02\00\00\00", align 8

define fastcc i32 @construction() {
  br label %1

1:                                                ; preds = %0
  br i1 false, label %2, label %3

2:                                                ; preds = %1
  ret i32 -1

3:                                                ; preds = %1
  br i1 false, label %4, label %5

4:                                                ; preds = %3
  ret i32 -2

5:                                                ; preds = %3
  br i1 false, label %6, label %7

6:                                                ; preds = %5
  ret i32 -3

7:                                                ; preds = %5
  %8 = call i32 @llvm.vector.reduce.add.v4i32(<4 x i32> <i32 0, i32 1, i32 2, i32 3>)
  %9 = icmp ne i32 %8, 6
  %10 = zext i1 %9 to i32
  %11 = select i1 %9, i32 -6, i32 0
  %12 = select i1 false, i32 -4, i32 %11
  ret i32 %12
}

define fastcc i32 @arithmetic(<4 x i32> %v) {
  br label %1

1:                                                ; preds = %0
  %2 = icmp slt <4 x i32> %v, <i32 0, i32 1, i32 2, i32 3>
  %lower = select <4 x i1> %2, <4 x i32> %v, <4 x i32> <i32 0, i32 1, i32 2, i32 3>
  %3 = icmp sgt <4 x i32> %v, <i32 0, i32 1, i32 2, i32 3>
  %upper = select <4 x i1> %3, <4 x i32> %v, <4 x i32> <i32 0, i32 1, i32 2, i32 3>
  %4 = extractelement <4 x i32> %lower, i32 0
  %5 = icmp ne i32 %4, 0
  %6 = zext i1 %5 to i32
  br i1 %5, label %7, label %8

7:                                                ; preds = %1
  ret i32 -1

8:                                                ; preds = %1
  br label %9

9:                                                ; preds = %8
  %10 = extractelement <4 x i32> %upper, i32 0
  %11 = icmp ne i32 %10, 2
  %12 = zext i1 %11 to i32
  br i1 %11, label %13, label %14

13:                                               ; preds = %9
  ret i32 -2

14:                                               ; preds = %9
  br label %15

15:                                               ; preds = %14
  %16 = extractelement <4 x i32> %lower, i32 1
  %17 = icmp ne i32 %16, 1
  %18 = zext i1 %17 to i32
  br i1 %17, label %19, label %20

19:                                               ; preds = %15
  ret i32 -3

20:                                               ; preds = %15
  br label %21

21:                                               ; preds = %20
  %22 = extractelement <4 x i32> %upper, i32 1
  %23 = icmp ne i32 %22, 2
  %24 = zext i1 %23 to i32
  br i1 %23, label %25, label %26

25:                                               ; preds = %21
  ret i32 -4

26:                                               ; preds = %21
  br label %27

27:                                               ; preds = %26
  %negated = sub <4 x i32> zeroinitializer, %v
  %28 = call <4 x i32> @llvm.abs.v4i32(<4 x i32> %negated, i1 false)
  %29 = extractelement <4 x i32> %28, i32 0
  %30 = icmp ne i32 %29, 2
  %31 = zext i1 %30 to i32
  br i1 %30, label %32, label %33

32:                                               ; preds = %27
  ret i32 -5

33:                                               ; preds = %27
  br label %34

34:                                               ; preds = %33
  %35 = call <4 x i32> @llvm.abs.v4i32(<4 x i32> %v, i1 false)
  %36 = extractelement <4 x i32> %35, i32 1
  %37 = icmp ne i32 %36, 2
  %38 = zext i1 %37 to i32
  br i1 %37, label %39, label %40

39:                                               ; preds = %34
  ret i32 -6

40:                                               ; preds = %34
  br label %41

41:                                               ; preds = %40
  ret i32 0
}

define fastcc i32 @floats() {
  br label %1

1:                                                ; preds = %0
  %2 = call <4 x float> @llvm.fabs.v4f32(<4 x float> <float -1.500000e+00, float -1.500000e+00, float -1.500000e+00, float -1.500000e+00>)
  %3 = extractelement <4 x float> %2, i32 0
  %4 = fcmp une float %3, 1.500000e+00
  %5 = zext i1 %4 to i32
  br i1 %4, label %6, label %7

6:                                                ; preds = %1
  ret i32 -1

7:                                                ; preds = %1
  br label %8

8:                                                ; preds = %7
  br i1 false, label %9, label %10

9:                                                ; preds = %8
  ret i32 -2

10:                                               ; preds = %8
  br label %11

11:                                               ; preds = %10
  br i1 false, label %12, label %13

12:                                               ; preds = %11
  ret i32 -3

13:                                               ; preds = %11
  br label %14

14:                                               ; preds = %13
  %15 = call <4 x float> @llvm.fabs.v4f32(<4 x float> zeroinitializer)
  %16 = extractelement <4 x float> %15, i32 0
  %17 = fdiv float 1.000000e+00, %16
  %18 = fcmp olt float %17, 0.000000e+00
  %19 = zext i1 %18 to i32
  br i1 %18, label %20, label %21

20:                                               ; preds = %14
  ret i32 -4

21:                                               ; preds = %14
  br label %22

22:                                               ; preds = %21
  ret i32 0
}

define fastcc i32 @rearrangement() {
  br label %1

1:                                                ; preds = %0
  br i1 false, label %2, label %3

2:                                                ; preds = %1
  ret i32 -1

3:                                                ; preds = %1
  br label %4

4:                                                ; preds = %3
