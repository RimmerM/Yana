6:                                                ; preds = %4
  br label %7

7:                                                ; preds = %6
  br i1 false, label %8, label %9

8:                                                ; preds = %7
  ret i32 -3

9:                                                ; preds = %7
  br label %10

10:                                               ; preds = %9
  br i1 false, label %11, label %12

11:                                               ; preds = %10
  ret i32 -4

12:                                               ; preds = %10
  br label %13

13:                                               ; preds = %12
  br i1 false, label %14, label %15

14:                                               ; preds = %13
  ret i32 -5

15:                                               ; preds = %13
  br label %16

16:                                               ; preds = %15
  br i1 false, label %17, label %18

17:                                               ; preds = %16
  ret i32 -6

18:                                               ; preds = %16
  br label %19

19:                                               ; preds = %18
  br i1 false, label %20, label %21

20:                                               ; preds = %19
  ret i32 -7

21:                                               ; preds = %19
  br label %22

22:                                               ; preds = %21
  br i1 false, label %23, label %24

23:                                               ; preds = %22
  ret i32 -8

24:                                               ; preds = %22
  br label %25

25:                                               ; preds = %24
  ret i32 0
}

define fastcc i32 @regrouping(<4 x i32> %v) {
  br label %1

1:                                                ; preds = %0
  %other = insertelement <4 x i32> %v, i32 5, i32 0
  %2 = trunc <4 x i32> %v to <4 x i16>
  %3 = trunc <4 x i32> %other to <4 x i16>
  %packed = shufflevector <4 x i16> %2, <4 x i16> %3, <8 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7>
  %4 = extractelement <8 x i16> %packed, i32 0
  %5 = zext i16 %4 to i32
  %6 = icmp ne i32 %5, 2
  %7 = zext i1 %6 to i32
  br i1 %6, label %8, label %9

8:                                                ; preds = %1
  ret i32 -2

9:                                                ; preds = %1
  %10 = extractelement <8 x i16> %packed, i32 4
  %11 = zext i16 %10 to i32
  %12 = icmp ne i32 %11, 5
  %13 = zext i1 %12 to i32
  br i1 %12, label %14, label %15

14:                                               ; preds = %9
  ret i32 -3

15:                                               ; preds = %9
  %16 = shufflevector <8 x i16> %packed, <8 x i16> %packed, <4 x i32> <i32 0, i32 1, i32 2, i32 3>
  %low = zext <4 x i16> %16 to <4 x i32>
  %17 = shufflevector <8 x i16> %packed, <8 x i16> %packed, <4 x i32> <i32 4, i32 5, i32 6, i32 7>
  %high = zext <4 x i16> %17 to <4 x i32>
  %18 = extractelement <4 x i32> %low, i32 0
  %19 = icmp ne i32 %18, 2
  %20 = zext i1 %19 to i32
  %21 = extractelement <4 x i32> %high, i32 0
  %22 = icmp ne i32 %21, 5
  %23 = zext i1 %22 to i32
  %24 = select i1 %22, i32 -5, i32 0
  %25 = select i1 %19, i32 -4, i32 %24
  ret i32 %25
}

define fastcc i32 @main() {
  br label %1

1:                                                ; preds = %0
  %2 = load i32, ptr @seed, align 1
  %.splatinsert = insertelement <4 x i32> poison, i32 %2, i32 0
  %v = shufflevector <4 x i32> %.splatinsert, <4 x i32> poison, <4 x i32> zeroinitializer
  %3 = call fastcc i32 @construction()
  %4 = icmp ne i32 %3, 0
  %5 = zext i1 %4 to i32
  br i1 %4, label %6, label %8

6:                                                ; preds = %1
  %7 = call fastcc i32 @construction()
  ret i32 %7

8:                                                ; preds = %1
  br label %9

9:                                                ; preds = %8
  %10 = call fastcc i32 @arithmetic(<4 x i32> %v)
  %11 = icmp ne i32 %10, 0
  %12 = zext i1 %11 to i32
  br i1 %11, label %13, label %16

13:                                               ; preds = %9
  %14 = call fastcc i32 @arithmetic(<4 x i32> %v)
  %15 = mul i32 %14, 10
  ret i32 %15

16:                                               ; preds = %9
  br label %17

17:                                               ; preds = %16
  %18 = call fastcc i32 @floats()
  %19 = icmp ne i32 %18, 0
  %20 = zext i1 %19 to i32
  br i1 %19, label %21, label %24

21:                                               ; preds = %17
  %22 = call fastcc i32 @floats()
  %23 = mul i32 %22, 100
  ret i32 %23

24:                                               ; preds = %17
  br label %25

25:                                               ; preds = %24
  %26 = call fastcc i32 @rearrangement()
  %27 = icmp ne i32 %26, 0
  %28 = zext i1 %27 to i32
  br i1 %27, label %29, label %32

29:                                               ; preds = %25
  %30 = call fastcc i32 @rearrangement()
  %31 = mul i32 %30, 1000
  ret i32 %31

32:                                               ; preds = %25
  br label %33

33:                                               ; preds = %32
  %34 = load i32, ptr @seed, align 1
  %.splatinsert1 = insertelement <4 x i32> poison, i32 %34, i32 0
  %.splat = shufflevector <4 x i32> %.splatinsert1, <4 x i32> poison, <4 x i32> zeroinitializer
  %35 = call fastcc i32 @regrouping(<4 x i32> %.splat)
  %36 = icmp ne i32 %35, 0
  %37 = zext i1 %36 to i32
  br i1 %36, label %38, label %42

38:                                               ; preds = %33
  %39 = load i32, ptr @seed, align 1
  %.splatinsert2 = insertelement <4 x i32> poison, i32 %39, i32 0
  %.splat3 = shufflevector <4 x i32> %.splatinsert2, <4 x i32> poison, <4 x i32> zeroinitializer
  %40 = call fastcc i32 @regrouping(<4 x i32> %.splat3)
  %41 = mul i32 %40, 10000
  ret i32 %41

42:                                               ; preds = %33
  br label %43

43:                                               ; preds = %42
  ret i32 271
}

; Function Attrs: nocallback nofree nosync nounwind readnone willreturn
declare i32 @llvm.vector.reduce.add.v4i32(<4 x i32>) #0

; Function Attrs: nocallback nofree nosync nounwind readnone speculatable willreturn
declare <4 x i32> @llvm.abs.v4i32(<4 x i32>, i1 immarg) #1

; Function Attrs: nocallback nofree nosync nounwind readnone speculatable willreturn
declare <4 x float> @llvm.fabs.v4f32(<4 x float>) #1

attributes #0 = { nocallback nofree nosync nounwind readnone willreturn }
attributes #1 = { nocallback nofree nosync nounwind readnone speculatable willreturn }
