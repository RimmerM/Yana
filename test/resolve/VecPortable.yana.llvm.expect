target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

module asm "\09.set \22image$base\22, 0"

@"image$base" = external constant [0 x i8], align 8
@seed = global [4 x i8] c"\02\00\00\00", align 8

define fastcc i32 @construction() #0 {
  br label %1

1:                                                ; preds = %0
  br i1 false, label %12, label %2

2:                                                ; preds = %1
  br i1 false, label %11, label %3

3:                                                ; preds = %2
  br i1 false, label %10, label %4

4:                                                ; preds = %3
  %5 = call i32 @llvm.vector.reduce.add.v4i32(<4 x i32> <i32 0, i32 1, i32 2, i32 3>)
  %6 = icmp ne i32 %5, 6
  %7 = zext i1 %6 to i32
  %8 = select i1 %6, i32 -6, i32 0
  %9 = select i1 false, i32 -4, i32 %8
  ret i32 %9

10:                                               ; preds = %3
  ret i32 -3

11:                                               ; preds = %2
  ret i32 -2

12:                                               ; preds = %1
  ret i32 -1
}

define fastcc i32 @arithmetic(<4 x i32> %v) #0 {
  br label %1

1:                                                ; preds = %0
  %2 = icmp slt <4 x i32> %v, <i32 0, i32 1, i32 2, i32 3>
  %lower = select <4 x i1> %2, <4 x i32> %v, <4 x i32> <i32 0, i32 1, i32 2, i32 3>
  %3 = icmp sgt <4 x i32> %v, <i32 0, i32 1, i32 2, i32 3>
  %upper = select <4 x i1> %3, <4 x i32> %v, <4 x i32> <i32 0, i32 1, i32 2, i32 3>
  %4 = extractelement <4 x i32> %lower, i32 0
  %5 = icmp ne i32 %4, 0
  %6 = zext i1 %5 to i32
  br i1 %5, label %7, label %8

7:                                                ; preds = %1
  ret i32 -1

8:                                                ; preds = %1
  %9 = extractelement <4 x i32> %upper, i32 0
  %10 = icmp ne i32 %9, 2
  %11 = zext i1 %10 to i32
  br i1 %10, label %12, label %13

12:                                               ; preds = %8
  ret i32 -2

13:                                               ; preds = %8
  %14 = extractelement <4 x i32> %lower, i32 1
  %15 = icmp ne i32 %14, 1
  %16 = zext i1 %15 to i32
  br i1 %15, label %17, label %18

17:                                               ; preds = %13
  ret i32 -3

18:                                               ; preds = %13
  %19 = extractelement <4 x i32> %upper, i32 1
  %20 = icmp ne i32 %19, 2
  %21 = zext i1 %20 to i32
  br i1 %20, label %22, label %23

22:                                               ; preds = %18
  ret i32 -4

23:                                               ; preds = %18
  %negated = sub <4 x i32> zeroinitializer, %v
  %24 = call <4 x i32> @llvm.abs.v4i32(<4 x i32> %negated, i1 false)
  %25 = extractelement <4 x i32> %24, i32 0
  %26 = icmp ne i32 %25, 2
  %27 = zext i1 %26 to i32
  br i1 %26, label %28, label %29

28:                                               ; preds = %23
  ret i32 -5

29:                                               ; preds = %23
  %30 = call <4 x i32> @llvm.abs.v4i32(<4 x i32> %v, i1 false)
  %31 = extractelement <4 x i32> %30, i32 1
  %32 = icmp ne i32 %31, 2
  %33 = zext i1 %32 to i32
  br i1 %32, label %34, label %35

34:                                               ; preds = %29
  ret i32 -6

35:                                               ; preds = %29
  ret i32 0
}

define fastcc i32 @floats() #0 {
  br label %1

1:                                                ; preds = %0
  %2 = call <4 x float> @llvm.fabs.v4f32(<4 x float> splat (float -1.500000e+00))
  %3 = extractelement <4 x float> %2, i32 0
  %4 = fcmp une float %3, 1.500000e+00
  %5 = zext i1 %4 to i32
  br i1 %4, label %6, label %7

6:                                                ; preds = %1
  ret i32 -1

7:                                                ; preds = %1
  br i1 false, label %8, label %9

8:                                                ; preds = %7
  ret i32 -2

9:                                                ; preds = %7
  br i1 false, label %10, label %11

10:                                               ; preds = %9
  ret i32 -3

11:                                               ; preds = %9
  %12 = call <4 x float> @llvm.fabs.v4f32(<4 x float> zeroinitializer)
  %13 = extractelement <4 x float> %12, i32 0
  %14 = fdiv float 1.000000e+00, %13
  %15 = fcmp olt float %14, 0.000000e+00
  %16 = zext i1 %15 to i32
  br i1 %15, label %17, label %18

17:                                               ; preds = %11
  ret i32 -4

18:                                               ; preds = %11
  ret i32 0
}

define fastcc i32 @rearrangement() #0 {
  br label %1

1:                                                ; preds = %0
  br i1 false, label %2, label %3

2:                                                ; preds = %1
  ret i32 -1

3:                                                ; preds = %1
  br i1 false, label %4, label %5

4:                                                ; preds = %3
  ret i32 -2

5:                                                ; preds = %3
  br i1 false, label %6, label %7

6:                                                ; preds = %5
  ret i32 -3

7:                                                ; preds = %5
  br i1 false, label %8, label %9

8:                                                ; preds = %7
  ret i32 -4

9:                                                ; preds = %7
  br i1 false, label %10, label %11

10:                                               ; preds = %9
  ret i32 -5

11:                                               ; preds = %9
  br i1 false, label %12, label %13

12:                                               ; preds = %11
  ret i32 -6

13:                                               ; preds = %11
  br i1 false, label %14, label %15

14:                                               ; preds = %13
  ret i32 -7

15:                                               ; preds = %13
  br i1 false, label %16, label %17

16:                                               ; preds = %15
  ret i32 -8

17:                                               ; preds = %15
  ret i32 0
}

define fastcc i32 @regrouping(<4 x i32> %v) #0 {
  br label %1

1:                                                ; preds = %0
  %other = insertelement <4 x i32> %v, i32 5, i32 0
  %2 = trunc <4 x i32> %v to <4 x i16>
  %3 = trunc <4 x i32> %other to <4 x i16>
  %packed = shufflevector <4 x i16> %2, <4 x i16> %3, <8 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7>
  %4 = extractelement <8 x i16> %packed, i32 0
  %5 = zext i16 %4 to i32
  %6 = shl i32 %5, 16
  %7 = ashr i32 %6, 16
  %8 = icmp ne i32 %7, 2
  %9 = zext i1 %8 to i32
  br i1 %8, label %29, label %10

10:                                               ; preds = %1
  %11 = extractelement <8 x i16> %packed, i32 4
  %12 = zext i16 %11 to i32
  %13 = shl i32 %12, 16
  %14 = ashr i32 %13, 16
  %15 = icmp ne i32 %14, 5
  %16 = zext i1 %15 to i32
  br i1 %15, label %28, label %17

17:                                               ; preds = %10
  %18 = shufflevector <8 x i16> %packed, <8 x i16> %packed, <4 x i32> <i32 0, i32 1, i32 2, i32 3>
  %low = sext <4 x i16> %18 to <4 x i32>
  %19 = shufflevector <8 x i16> %packed, <8 x i16> %packed, <4 x i32> <i32 4, i32 5, i32 6, i32 7>
  %high = sext <4 x i16> %19 to <4 x i32>
  %20 = extractelement <4 x i32> %low, i32 0
  %21 = icmp ne i32 %20, 2
  %22 = zext i1 %21 to i32
  %23 = extractelement <4 x i32> %high, i32 0
  %24 = icmp ne i32 %23, 5
  %25 = zext i1 %24 to i32
  %26 = select i1 %24, i32 -5, i32 0
  %27 = select i1 %21, i32 -4, i32 %26
  ret i32 %27

28:                                               ; preds = %10
  ret i32 -3

29:                                               ; preds = %1
  ret i32 -2
}

define fastcc i32 @main() #0 {
  br label %1

1:                                                ; preds = %0
  %2 = load i32, ptr @seed, align 1
  %.splatinsert = insertelement <4 x i32> poison, i32 %2, i64 0
  %v = shufflevector <4 x i32> %.splatinsert, <4 x i32> poison, <4 x i32> zeroinitializer
  %3 = call fastcc i32 @construction()
  %4 = icmp ne i32 %3, 0
  %5 = zext i1 %4 to i32
  br i1 %4, label %6, label %8

6:                                                ; preds = %1
  %7 = call fastcc i32 @construction()
  ret i32 %7

8:                                                ; preds = %1
  %9 = call fastcc i32 @arithmetic(<4 x i32> %v)
  %10 = icmp ne i32 %9, 0
  %11 = zext i1 %10 to i32
  br i1 %10, label %12, label %15

12:                                               ; preds = %8
  %13 = call fastcc i32 @arithmetic(<4 x i32> %v)
  %14 = mul i32 %13, 10
  ret i32 %14

15:                                               ; preds = %8
  %16 = call fastcc i32 @floats()
  %17 = icmp ne i32 %16, 0
  %18 = zext i1 %17 to i32
  br i1 %17, label %19, label %22

19:                                               ; preds = %15
  %20 = call fastcc i32 @floats()
  %21 = mul i32 %20, 100
  ret i32 %21

22:                                               ; preds = %15
  %23 = call fastcc i32 @rearrangement()
  %24 = icmp ne i32 %23, 0
  %25 = zext i1 %24 to i32
  br i1 %24, label %26, label %29

26:                                               ; preds = %22
  %27 = call fastcc i32 @rearrangement()
  %28 = mul i32 %27, 1000
  ret i32 %28

29:                                               ; preds = %22
  %30 = load i32, ptr @seed, align 1
  %.splatinsert1 = insertelement <4 x i32> poison, i32 %30, i64 0
  %.splat = shufflevector <4 x i32> %.splatinsert1, <4 x i32> poison, <4 x i32> zeroinitializer
  %31 = call fastcc i32 @regrouping(<4 x i32> %.splat)
  %32 = icmp ne i32 %31, 0
  %33 = zext i1 %32 to i32
  br i1 %32, label %34, label %38

34:                                               ; preds = %29
  %35 = load i32, ptr @seed, align 1
  %.splatinsert2 = insertelement <4 x i32> poison, i32 %35, i64 0
  %.splat3 = shufflevector <4 x i32> %.splatinsert2, <4 x i32> poison, <4 x i32> zeroinitializer
  %36 = call fastcc i32 @regrouping(<4 x i32> %.splat3)
  %37 = mul i32 %36, 10000
  ret i32 %37

38:                                               ; preds = %29
  ret i32 271
}

; Function Attrs: nocallback nofree nosync nounwind speculatable willreturn memory(none)
declare i32 @llvm.vector.reduce.add.v4i32(<4 x i32>) #1

; Function Attrs: nocallback nofree nosync nounwind speculatable willreturn memory(none)
declare <4 x i32> @llvm.abs.v4i32(<4 x i32>, i1 immarg) #1

; Function Attrs: nocallback nocreateundeforpoison nofree nosync nounwind speculatable willreturn memory(none)
declare <4 x float> @llvm.fabs.v4f32(<4 x float>) #2

attributes #0 = { "probe-stack"="inline-asm" }
attributes #1 = { nocallback nofree nosync nounwind speculatable willreturn memory(none) }
attributes #2 = { nocallback nocreateundeforpoison nofree nosync nounwind speculatable willreturn memory(none) }
