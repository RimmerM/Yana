  b9:
    %v39 = load %xs : Array(I32)
    %v42 = borrow %xs : 'Array(I32)
    %v43 = load [%v42]@Array.length : @bits(30) U32
    %v44 = cast 0 : USize
    %v45 = cast %v43 : USize
