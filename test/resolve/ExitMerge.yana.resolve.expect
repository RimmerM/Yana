fn classify(%n: I32) -> I32 {
  b0:
    %v4 = alloc : Array(I32)
    %v7 = alloc *3 : I32
    %v8 = addressof %local1 : %I32
    init %xs@Array.run@Run.items, %v8
    init %xs@Array.run@Run.capacity, 3
    init %xs@Array.run@Run.ownsHeap, 0
    aggregate [%v8][0] = 10, [%v8][1] = 20, [%v8][2] = 30
    init %xs@Array.length, 3
    %v20 = cmp_eq %n, 0 : Bool
    je %v20, b10, b2

  b1:
