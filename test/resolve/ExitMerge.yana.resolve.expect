    %v18 = mul %v16, %v17 : I64
    %v19 = add %v14, %v18 : %Int
    %v20 = load [%v19] : Int
    %doomed = alloc : Int
    init %local3, %v20
    %v23 = load %i : Int
    %v25 = add %v23, 1 : Int
    assign %i, %v25
