fn releaseRun(I32)(%self: Run(I32)) -> () {
  b0:
    %v1 = load %self@Run.ownsHeap : @bits(2) U32
    %v2 = cast %v1 : U32
    %v4 = cast 1 : U32
    %v5 = cmp_eq %v2, %v4 : Bool
