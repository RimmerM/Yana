module ResolveTest

fn add(a: I32 [shared call], b: I32 [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (a)
  %1: I32 = read copy.trivial (b)
  %2: I32 = add inspect %0 inspect %1
  return take %2
}

fn noop() -> {} {
bb0:
  return
}

fn local(value: I32 [shared call]) -> I32 {
  local next: I32

bb0:
  %0: I32 = read copy.trivial (value)
  %1: I32 = const 1
  %2: I32 = add inspect %0 inspect %1
  write.init borrow.unique (next) take %2
  %4: I32 = read copy.trivial (next)
  %5: I32 = const 2
  %6: I32 = mul inspect %4 inspect %5
  return take %6
