bb4:
  %4: I32 = const -1
  jump -> bb3(take %4)

bb5:
  %9: I32 = const 0
  jump -> bb3(take %9)
}

fn main() -> I32 {
  local value: I32

bb0:
  %0: {} = call noop
  %1: I32 = const 2
  %2: I32 = const 1
  %3: I32 = call choose borrow.shared %1 borrow.shared %2
  write.init borrow.unique (value) take %3
  jump -> bb1

