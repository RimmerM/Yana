bb2:
  %10: I32 = read copy.trivial (value)
  %11: I32 = const 2
  %12: I32 = mul inspect %10 inspect %11
  %13: I32 = const 5
  %14: I32 = call classify borrow.shared %13
  %15: I32 = add inspect %12 inspect %14
  %16: I32 = const 0
  %17: I32 = call local borrow.shared %16
  %18: I32 = add inspect %15 inspect %17
  %19: I32 = const 2
  %20: I32 = sub inspect %18 inspect %19
  return take %20

bb3:
  %8: I32 = const 99
  return take %8
}

entry main
