module ResolveTest

data Wrapped {tag: I32, lanes: Vec(F32)}

fn natural(v: Vec(F32) [shared call]) -> Vec(F32) {
bb0:
  %0: Vec(F32) = read copy.trivial (v)
  return take %0
}

