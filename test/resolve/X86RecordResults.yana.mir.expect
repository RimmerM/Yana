module ResolveTest

fn cpuidEax(leaf: U32 [shared call], subleaf: U32 [shared call]) -> U32 {
  local result: CpuidResult

bb0:
  %0: U32 = read copy.trivial (leaf)
  %1: U32 = read copy.trivial (subleaf)
  %2: CpuidResult = native cpuid inspect %0 inspect %1
  write.init borrow.unique (result) take %2
  %4: U32 = read copy.trivial (result.eax)
  return take %4
}

fn rdtscpValue() -> U64 {
bb0:
  %0: U64 = native rdtscp
  return take %0
}

fn rdmsrValue(msr: U32 [shared call]) -> U64 {
bb0:
  %0: U32 = read copy.trivial (msr)
  %1: U64 = native rdmsr inspect %0
  return take %1
}

fn xgetbvValue(index: U32 [shared call]) -> U64 {
bb0:
  %0: U32 = read copy.trivial (index)
  %1: U64 = native xgetbv inspect %0
  return take %1
}
