let image$base: () = <none>

fn point(%x: I32, %y: I32) -> Point {
  b0:
    %v2 = alloc : Point
    aggregate %local0@Point.x = %x, %local0@Point.y = %y
    ret %v2
}

fn manhattan(%p: Point) -> I32 {
  b0:
    %v1 = load %p@Point.x : I32
    %v2 = load %p@Point.y : I32
    %v3 = add %v1, %v2 : I32
    ret %v3
}

fn width(%l: Line) -> I32 {
  b0:
    %v1 = load %l@Line.to : Point
    %v2 = load %l@Line.to@Point.x : I32
    %v3 = load %l@Line.from : Point
    %v4 = load %l@Line.from@Point.x : I32
    %v5 = sub %v2, %v4 : I32
    ret %v5
}

fn shifted(%dy: I32) -> I32 {
  b0:
    %v1 = alloc : Point
    aggregate %p@Point.x = 3, %p@Point.y = 4
    %v5 = load %p : Point
    %v6 = load %p@Point.y : I32
    %v7 = add %v6, %dy : I32
    assign %p@Point.y, %v7
    %v9 = load %p : Point
    %v10 = call manhattan, %v9 : I32
    ret %v10
}

fn copied() -> I32 {
  b0:
    %a = call point, 10, 20 : Point
    %v3 = call manhattan, %a : I32
    %v4 = call manhattan, %a : I32
    %v5 = add %v3, %v4 : I32
    ret %v5
}

fn main() -> I32 {
  b0:
    %line = alloc : Line
    %v3 = call point, 1, 2 : Point
    %v6 = call point, 8, 5 : Point
    aggregate %local0@Line.from = %v3, %local0@Line.to = %v6
    %v8 = call width, %line : I32
    %v10 = call shifted, 5 : I32
    %v11 = add %v8, %v10 : I32
    %v12 = call copied : I32
    %v13 = add %v11, %v12 : I32
    ret %v13
}
