  %27: Vec(U8) = vec.withlane #13 inspect %25 inspect %26
  %28: U8 = const 14
  %29: Vec(U8) = vec.withlane #14 inspect %27 inspect %28
  %30: U8 = const 15
  %31: Vec(U8) = vec.withlane #15 inspect %29 inspect %30
  write.init borrow.unique (v) take %31
  %33: Vec(U8) = read copy.trivial (v)
  %34: I32 = const 0
  %35: I32 = const 2
  %36: I32 = const 4
  %37: I32 = const 6
  %38: I32 = const 8
  %39: I32 = const 10
  %40: I32 = const 12
  %41: I32 = const 14
  %42: I32 = const 0
  %43: I32 = const 0
  %44: I32 = const 0
  %45: I32 = const 0
  %46: I32 = const 0
  %47: I32 = const 0
  %48: I32 = const 0
  %49: I32 = const 0
  %50: [I32 *16] = aggregate.0 take %34 take %35 take %36 take %37 take %38 take %39 take %40 take %41 take %42 take %43 take %44 take %45 take %46 take %47 take %48 take %49
  %51: Vec(U8) = vec.shuffle [0, 2, 4, 6, 8, 10, 12, 14, 0, 0, 0, 0, 0, 0, 0, 0] inspect %33 inspect %33
  write.init borrow.unique (evens) take %51
  %53: Vec(U8) = read copy.trivial (v)
  %54: Vec(U8) = read copy.trivial (v)
  %55: I32 = const 0
  %56: I32 = const 16
  %57: I32 = const 1
  %58: I32 = const 17
  %59: I32 = const 2
  %60: I32 = const 18
  %61: I32 = const 3
  %62: I32 = const 19
