module ResolveTest

fn total(xs: [I32 *n] [shared call]) -> I32 {
  form erased
  slot #0 const n
  local & sum: I32
  local & local2: I32
  local i: I32

bb0:
  %0: I32 = const 0
  write.init borrow.unique (sum) take %0
  %2: I32 = gen.value n
  %3: I32 = const 0
  %4: I32 = const 1
  write.init borrow.unique (local2) take %3
  jump -> bb1(take %2, take %4)

bb1(%5: I32, %6: I32):
  %13: I32 = read copy.trivial (local2)
  %14: Bool = lt inspect %13 inspect %5
  branch inspect %14 -> bb4(take %5, take %6) -> bb3(take %5, take %6)

bb2(%7: I32, %8: I32):
  %34: I32 = read copy.trivial (local2)
  %35: I32 = add inspect %34 inspect %8
  write.assign borrow.unique (local2) take %35
  jump -> bb1(take %7, take %8)

bb3(%9: I32, %10: I32):
  %38: I32 = read copy.trivial (sum)
  return take %38

bb4(%15: I32, %16: I32):
  %18: I32 = read copy.trivial (local2)
  write.init borrow.unique (i) take %18
  %20: I32 = read copy.trivial (sum)
  %21: I32 = const 3
  %22: I32 = mul inspect %20 inspect %21
  %23: I32 = read copy.trivial (i)
  %24: Size = convert inspect %23
  %25: I32 = gen.value n
  %26: USize = convert inspect %25
  %27: USize = bitcast inspect %24
  %28: Bool = ge inspect %27 inspect %26
  %29: {} = call checkCondition borrow.shared %28
  %30: I32 = read copy.trivial (xs[...])
  %31: I32 = add inspect %22 inspect %30
  write.assign borrow.unique (sum) take %31
  jump -> bb2(take %15, take %16)
}

fn main() -> I32 {
  local v: Vec(U8)
  local evens: Vec(U8)
  local zipped: Vec(U8)

bb0:
  %0: U8 = const 0
  %1: Vec(U8) = vec.splat inspect %0
  %2: U8 = const 1
