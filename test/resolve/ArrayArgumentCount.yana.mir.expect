  %64: I32 = const 20
  %65: I32 = const 5
  %66: I32 = const 21
  %67: I32 = const 6
  %68: I32 = const 22
  %69: I32 = const 7
  %70: I32 = const 23
  %71: [I32 *16] = aggregate.0 take %55 take %56 take %57 take %58 take %59 take %60 take %61 take %62 take %63 take %64 take %65 take %66 take %67 take %68 take %69 take %70
  %72: Vec(U8) = vec.shuffle [0, 16, 1, 17, 2, 18, 3, 19, 4, 20, 5, 21, 6, 22, 7, 23] inspect %53 inspect %54
  write.init borrow.unique (zipped) take %72
  %74: I32 = const 4
  %75: I32 = const 1
  %76: I32 = const 5
  %77: [I32 *3] = aggregate.0 take %74 take %75 take %76
  %78: I32 = call total(3) borrow.shared %77
  %79: I32 = const 2
  %80: I32 = const 7
  %81: [I32 *2] = aggregate.0 take %79 take %80
  %82: I32 = call total(2) borrow.shared %81
  %83: I32 = const 100
  %84: I32 = mul inspect %82 inspect %83
  %85: I32 = add inspect %78 inspect %84
  %86: Vec(U8) = read copy.trivial (evens)
  %87: I32 = const 3
  %88: U8 = vec.lane #3 inspect %86
  %89: I32 = convert inspect %88
  %90: I32 = const 10000
  %91: I32 = mul inspect %89 inspect %90
  %92: I32 = add inspect %85 inspect %91
  %93: Vec(U8) = read copy.trivial (zipped)
  %94: I32 = const 5
