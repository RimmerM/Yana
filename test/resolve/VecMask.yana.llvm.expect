target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

@"image$base" = constant [0 x i8] zeroinitializer, align 8

define fastcc i32 @main() {
  %live = alloca i8, i64 16, align 16
  br label %1

1:                                                ; preds = %0
  store <4 x i1> <i1 true, i1 true, i1 true, i1 false>, ptr %live, align 1
  %2 = call i1 @llvm.vector.reduce.or.v4i1(<4 x i1> <i1 true, i1 true, i1 true, i1 false>)
  %3 = zext i1 %2 to i32
  %4 = xor i32 %3, 1
  %5 = icmp ne i32 %4, 0
  br i1 %5, label %13, label %6

6:                                                ; preds = %1
  %7 = call i32 @llvm.vector.reduce.add.v4i32(<4 x i32> <i32 0, i32 1, i32 2, i32 0>)
  %8 = mul i32 %7, 10
  %9 = load <4 x i1>, ptr %live, align 1
  %10 = zext <4 x i1> %9 to <4 x i32>
  %11 = call i32 @llvm.vector.reduce.add.v4i32(<4 x i32> %10)
  %12 = add i32 %8, %11
  br label %14

13:                                               ; preds = %1
  br label %14

14:                                               ; preds = %13, %6
  %counted = phi i32 [ %12, %6 ], [ -1, %13 ]
  %15 = add i32 710000, %counted
  ret i32 %15
}

; Function Attrs: nocallback nofree nosync nounwind readnone willreturn
declare i1 @llvm.vector.reduce.or.v4i1(<4 x i1>) #0

; Function Attrs: nocallback nofree nosync nounwind readnone willreturn
declare i32 @llvm.vector.reduce.add.v4i32(<4 x i32>) #0

attributes #0 = { nocallback nofree nosync nounwind readnone willreturn }
