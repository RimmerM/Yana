target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

@"image$base" = constant [0 x i8] zeroinitializer, align 8

define fastcc i32 @main() {
  br label %1

1:                                                ; preds = %0
  %2 = call i1 @llvm.vector.reduce.or.v4i1(<4 x i1> <i1 true, i1 true, i1 true, i1 false>)
  %3 = zext i1 %2 to i32
  br i1 %2, label %4, label %9

4:                                                ; preds = %1
  %5 = call i32 @llvm.vector.reduce.add.v4i32(<4 x i32> <i32 0, i32 1, i32 2, i32 0>)
  %6 = mul i32 %5, 10
  %7 = call i32 @llvm.vector.reduce.add.v4i32(<4 x i32> <i32 1, i32 1, i32 1, i32 0>)
  %8 = add i32 %6, %7
  br label %10

9:                                                ; preds = %1
  br label %10

10:                                               ; preds = %4, %9
  %counted = phi i32 [ %8, %4 ], [ -1, %9 ]
  %11 = add i32 710000, %counted
  ret i32 %11
}

; Function Attrs: nocallback nofree nosync nounwind readnone willreturn
declare i1 @llvm.vector.reduce.or.v4i1(<4 x i1>) #0

; Function Attrs: nocallback nofree nosync nounwind readnone willreturn
declare i32 @llvm.vector.reduce.add.v4i32(<4 x i32>) #0

attributes #0 = { nocallback nofree nosync nounwind readnone willreturn }
