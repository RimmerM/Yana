fn xOf {
  arg p readonly return
  result arguments
  %p: Point borrowed readonly live [0, 3)
}

fn larger {
  arg a writable return
  arg b writable return
  result arguments
  %a: Int borrowed writable live [0, 7)
  %b: Int borrowed writable live [0, 4) [7, 10)
}

fn main {
  %local0: Point readonly live [0, 15)
  %left: Int writable live [4, 16)
  %right: Int writable live [6, 16)
}
