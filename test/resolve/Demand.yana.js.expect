"use strict";
// ResolveTest
function read(it$x, it$y) {
  return it$x + it$y | 0;
}

function bump(it) {
  it.x = it.x + 1 | 0;
  return;
}

function onlyRead() {
  return read(1, 2) + read(1, 2) | 0;
}

function mutableOnOneArm(flag) {
  var p = { x: 1, y: 2 };
  if (flag) {
    var v10 = p;
    v10.x = v10.x + 1 | 0;
  }
  return read(p.x, p.y);
}

function copyIsIndependent() {
  var duplicate = { x: 1, y: 2 };
  var v13 = duplicate;
  v13.x = v13.x + 1 | 0;
  return read(1, 2) + read(duplicate.x, duplicate.y) | 0;
}

function addressed() {
  var at = { x: 1, y: 2 };
  return at.x + at.y | 0;
}

function main() {
  return (((read(1, 2) + read(1, 2) | 0) + mutableOnOneArm(1) | 0) + copyIsIndependent() | 0) + addressed() | 0;
}
