"use strict";
// ResolveTest
function read(it$x, it$y) {
  return it$x + it$y | 0;
}

function bump(it) {
  it.x = it.x + 1 | 0;
  return;
}

function onlyRead() {
  var p = { x: 1, y: 2 };
  return read(1, 2) + read(p.x, p.y) | 0;
}

function mutableOnOneArm(flag) {
  var p = { x: 1, y: 2 };
  if (flag) {
    bump(p);
  }
  return read(p.x, p.y);
}

function copyIsIndependent() {
  var source = { x: 1, y: 2 };
  var duplicate = { x: 1, y: 2 };
  bump(duplicate);
  return read(source.x, source.y) + read(duplicate.x, duplicate.y) | 0;
}

function addressed() {
  var at = { x: 1, y: 2 };
  return at.x + at.y | 0;
}

function main() {
  return ((onlyRead() + mutableOnOneArm(1) | 0) + copyIsIndependent() | 0) + addressed() | 0;
}
