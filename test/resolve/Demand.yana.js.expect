"use strict";
// ResolveTest
function read(it$x, it$y) {
  return it$x + it$y | 0;
}

function bump(it) {
  it.x = it.x + 1 | 0;
  return;
}

function onlyRead() {
  return read(1, 2) + read(1, 2) | 0;
}

function mutableOnOneArm(flag) {
  return (flag ? 2 : 1) + 2 | 0;
}

function copyIsIndependent() {
  return 7;
}

function addressed() {
  var p = { x: 1, y: 2 };
  return p.x + p.y | 0;
}

function main() {
  return addressed() + 17 | 0;
}
