target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

module asm "\09.set \22image$base\22, 0"

@"image$base" = external constant [0 x i8], align 8

define fastcc i32 @wide() {
  br label %1

1:                                                ; preds = %0
  br i1 false, label %2, label %3

2:                                                ; preds = %1
  ret i32 -1

3:                                                ; preds = %1
  br label %4

4:                                                ; preds = %3
  br i1 false, label %5, label %6

5:                                                ; preds = %4
  ret i32 -2

6:                                                ; preds = %4
  br label %7

7:                                                ; preds = %6
  br i1 false, label %8, label %9

8:                                                ; preds = %7
  ret i32 -3

9:                                                ; preds = %7
  br label %10

10:                                               ; preds = %9
  br i1 false, label %11, label %12

11:                                               ; preds = %10
  ret i32 -4

12:                                               ; preds = %10
  br label %13

13:                                               ; preds = %12
  ret i32 0
}

define fastcc i32 @main() {
  br label %1

1:                                                ; preds = %0
  %2 = call fastcc i32 @wide()
  %3 = icmp ne i32 %2, 0
  %4 = zext i1 %3 to i32
  br i1 %3, label %5, label %7

5:                                                ; preds = %1
  %6 = call fastcc i32 @wide()
  ret i32 %6

7:                                                ; preds = %1
  br label %8

8:                                                ; preds = %7
  ret i32 301174
}
