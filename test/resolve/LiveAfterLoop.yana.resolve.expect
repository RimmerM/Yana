let image$base: () = <none>

fn pick(%a: I64, %b: I64, %first: Bool) -> &mut I64 {
  b0:
    je %first, b1, b2

  b1:
    %v4 = load %a : I64
    %v5 = borrow_mut %a : &mut I64
    jmp b3

  b2:
    %v6 = load %b : I64
    %v7 = borrow_mut %b : &mut I64
    jmp b3

  b3:
    %v10 = phi [b1, %v5], [b2, %v7] : &mut I64
    ret %v10
}

fn borrowAfterLoop(%x: I64, %y: I64, %flag: Bool) -> I64 {
  b0:
    %i = alloc : I64
    init %i, 0
    jmp b1

  b1:
    %v7 = load %i : I64
    %v10 = cmp_lt %v7, 4 : Bool
    je %v10, b3, b2

  b2:
    %v23 = load %x : I64
    %v24 = load %y : I64
    %v26 = borrow_mut %x : &mut I64
    %v27 = borrow_mut %y : &mut I64
    %v28 = call pick, %v26, %v27, True : &mut I64
    je %flag, b4, b5

  b3:
    %v12 = load %x : I64
    %v15 = add %v12, 1 : I64
    assign %x, %v15
    %v17 = load %i : I64
    %v20 = add %v17, 1 : I64
    assign %i, %v20
    jmp b1

  b4:
    %v30 = load [%v28] : I64
    ret %v30

  b5:
    jmp b6

  b6:
    %v33 = load [%v28] : I64
    %v36 = add %v33, 1 : I64
    ret %v36
}

fn endsBeforeWrite(%x: I64, %y: I64) -> I64 {
  b0:
    %v2 = load %x : I64
    %v3 = load %y : I64
    %v5 = borrow_mut %x : &mut I64
    %v6 = borrow_mut %y : &mut I64
    %v7 = call pick, %v5, %v6, True : &mut I64
    %held = load [%v7] : I64
    %v9 = load %x : I64
    %v12 = add %v9, 1 : I64
    assign %x, %v12
    %v14 = load %x : I64
    %v15 = add %held, %v14 : I64
    ret %v15
}

fn otherArm(%x: I64, %y: I64, %flag: Bool) -> I64 {
  b0:
    je %flag, b1, b2

  b1:
    %v4 = load %x : I64
    %v5 = load %y : I64
    %v7 = borrow_mut %x : &mut I64
    %v8 = borrow_mut %y : &mut I64
    %v9 = call pick, %v7, %v8, True : &mut I64
    %v10 = load [%v9] : I64
    ret %v10

  b2:
    jmp b3

  b3:
    %v13 = load %x : I64
    %v16 = add %v13, 1 : I64
    assign %x, %v16
    %v18 = load %x : I64
    ret %v18
}

fn insideOneIteration(%x: I64, %y: I64) -> I64 {
  b0:
    %i = alloc : I64
    init %i, 0
    %total = alloc : I64
    init %total, 0
    jmp b1

  b1:
    %v9 = load %i : I64
    %v12 = cmp_lt %v9, 3 : Bool
    je %v12, b3, b2

  b2:
    %v35 = load %total : I64
    ret %v35

  b3:
    %v14 = load %x : I64
    %v15 = load %y : I64
    %v17 = borrow_mut %x : &mut I64
    %v18 = borrow_mut %y : &mut I64
    %v19 = call pick, %v17, %v18, True : &mut I64
    %v20 = load %total : I64
    %v21 = load [%v19] : I64
    %v22 = add %v20, %v21 : I64
    assign %total, %v22
    %v24 = load %x : I64
    %v27 = add %v24, 1 : I64
    assign %x, %v27
    %v29 = load %i : I64
    %v32 = add %v29, 1 : I64
    assign %i, %v32
    jmp b1
}

fn main() -> Int {
  b0:
    %a = alloc : I64
    init %a, 10
    %b = alloc : I64
    init %b, 20
    %total = alloc : I64
    init %total, 0
    %v9 = load %total : I64
    %v10 = load %a : I64
    %v11 = load %b : I64
    %v13 = borrow_mut %a : &mut I64
    %v14 = borrow_mut %b : &mut I64
    %v15 = call borrowAfterLoop, %v13, %v14, True : I64
    %v16 = add %v9, %v15 : I64
    assign %total, %v16
    assign %a, 10
    %v20 = load %total : I64
    %v21 = load %a : I64
    %v22 = load %b : I64
    %v23 = borrow_mut %a : &mut I64
    %v24 = borrow_mut %b : &mut I64
    %v25 = call endsBeforeWrite, %v23, %v24 : I64
    %v26 = add %v20, %v25 : I64
    assign %total, %v26
    assign %a, 10
    %v30 = load %total : I64
    %v31 = load %a : I64
    %v32 = load %b : I64
    %v34 = borrow_mut %a : &mut I64
    %v35 = borrow_mut %b : &mut I64
    %v36 = call otherArm, %v34, %v35, True : I64
    %v37 = add %v30, %v36 : I64
    assign %total, %v37
    assign %a, 10
    %v41 = load %total : I64
    %v42 = load %a : I64
    %v43 = load %b : I64
    %v45 = borrow_mut %a : &mut I64
    %v46 = borrow_mut %b : &mut I64
    %v47 = call otherArm, %v45, %v46, False : I64
    %v48 = add %v41, %v47 : I64
    assign %total, %v48
    assign %a, 10
    %v52 = load %total : I64
    %v53 = load %a : I64
    %v54 = load %b : I64
    %v55 = borrow_mut %a : &mut I64
    %v56 = borrow_mut %b : &mut I64
    %v57 = call insideOneIteration, %v55, %v56 : I64
    %v58 = add %v52, %v57 : I64
    assign %total, %v58
    %v60 = load %total : I64
    %v61 = cast %v60 : Int
    ret %v61
}
