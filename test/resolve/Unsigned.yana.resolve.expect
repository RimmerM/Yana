fn divide(%a: U64, %b: U64) -> U64 {
  b0:
    %v2 = div %a, %b : U64
    ret %v2
}

fn remainder(%a: U64, %b: U64) -> U64 {
  b0:
    %v2 = rem %a, %b : U64
    ret %v2
}

fn signedDivide(%a: I64, %b: I64) -> I64 {
  b0:
    %v2 = div %a, %b : I64
    ret %v2
}

fn main() -> Int {
  b0:
    %v4 = sub 0, 2 : Int
    %big = cast %v4 : U64
    %half = call divide, %big, 2 : U64
    %rest = call remainder, %big, 3 : U64
    %v11 = cmp_gt %half, 0 : Bool
    je %v11, b1, b2

  b1:
    jmp b3

  b2:
    jmp b3

  b3:
    %quotientIsPositive = phi [b1, 1], [b2, 0] : Int
    %v24 = sub 0, 7 : Int
    %v25 = cast %v24 : I64
    %v27 = call signedDivide, %v25, 2 : I64
    %v32 = sub 0, 3 : Int
    %v33 = cast %v32 : I64
    %v34 = cmp_eq %v27, %v33 : Bool
    je %v34, b4, b5

  b4:
    jmp b6

  b5:
    jmp b6

  b6:
    %signedStillSigned = phi [b4, 10], [b5, 0] : Int
    %v43 = add %quotientIsPositive, %signedStillSigned : Int
    %v44 = cast %rest : Int
    %v45 = add %v43, %v44 : Int
    ret %v45
}
