-- `@lazy`, and the three operators built on it - Design.md's Deferred arguments.
--
-- A `@lazy` parameter is not evaluated at the call site. The argument compiles to a nullary thunk
-- over the caller's frame, and reading the parameter inside the callee is what runs it. That is the
-- whole mechanism; `&&`, `||` and `??` are library declarations that use it, not compiler syntax.
--
-- Every function here counts its own calls into a global, because the property worth asserting is
-- not what the IR looks like but what did and did not run: a right operand that was skipped and one
-- that was evaluated and then discarded are the same bytes and different programs.

let &effects = 0 :: Int

fn bump() -> Bool:
    effects = effects + 1
    return True

fn bumpFalse() -> Bool:
    effects = effects + 1
    return False

fn bumpValue() -> Int:
    effects = effects + 1
    return 7

-- The two cases that matter for `&&`: a False left operand never runs the right, and a True one
-- does. `Bool`'s instance is an intrinsic the resolver sees through, so this is a branch with the
-- right operand emitted under it - no closure, no call, and nothing allocated.
fn andSkips() -> Bool = False && bump()

fn andRuns() -> Bool = True && bump()

-- `||` is the same shape read the other way round.
fn orSkips() -> Bool = True || bump()

fn orRuns() -> Bool = False || bump()

-- What the feature exists for - `!isNull(p) && *p > 0`, which reads through a null pointer under
-- strict evaluation - is in LazyPointer.yana rather than here. A raw pointer is not something the JS
-- target has, so it is asserted where only amd64 runs it and everything in this file runs on both.

-- The right operand is a whole sub-chain of the flattened infix expression rather than one node,
-- which is what the deferred chain in expr.h exists for: `bump() && bumpFalse()` is what `&&`'s
-- right operand is here, and none of it runs.
fn chained() -> Bool = False && bump() && bumpFalse()

-- A pattern test as the left operand. What is *not* here is `m is Just(v) && v > 0`: `is` outside
-- condition position discards what it bound, so nothing is in scope for the right operand to name.
-- Making that work is Analysis-Lens.md §4's flow-sensitive case, and it needs the condition path to
-- read `&&` as control flow rather than as a call - which is a separate thing from `@lazy`.
fn bound(m: Maybe(Int)) -> Bool = m is Just(3) && True

-- `??` is an ordinary generic function with a `@lazy` fallback, so the fallback is a thunk the
-- callee runs only when there was nothing to return.
fn fallbackSkipped(m: Maybe(Int)) -> Int = m ?? bumpValue()

-- A user type's own `&&`. The marker is the class's, so the implementation repeats it rather than
-- choosing it, and the call site defers on the strength of the class signature alone - which is
-- what makes strictness readable off `Logic`'s declaration for every type that will ever join it.
--
-- This one is not an intrinsic, so the argument really does become a nullary closure the body
-- calls. It is still skipped when the left operand decided the answer, which is the whole property.
data Mask {bits: Int}

instance Logic(Mask):
    fn &&(lhs: Mask, @lazy rhs: Mask) -> Mask = if lhs.bits == 0 then lhs else and(lhs, rhs)
    fn and(lhs: Mask, rhs: Mask) -> Mask = Mask {bits: lhs.bits `and` rhs.bits}
    fn or(lhs: Mask, rhs: Mask) -> Mask = Mask {bits: lhs.bits `or` rhs.bits}
    fn xor(lhs: Mask, rhs: Mask) -> Mask = Mask {bits: lhs.bits `xor` rhs.bits}
    fn not(value: Mask) -> Mask = Mask {bits: value.bits `xor` 15}

fn bumpMask() -> Mask:
    effects = effects + 1
    return Mask {bits: 3}

fn maskSkips() -> Int = (Mask {bits: 0} && bumpMask()).bits

fn maskRuns() -> Int = (Mask {bits: 7} && bumpMask()).bits

-- A user function may declare one. `once` reads its parameter on one arm and not on the other,
-- which is the at-most-once rule holding on both paths rather than on the syntax.
fn once(flag: Bool, @lazy value: Int) -> Int:
    if flag:
        return value + 1

    return 0

fn main() -> Int:
    let &score = 0

    if !andSkips(): score = score + 1
    if andRuns(): score = score + 2
    if orSkips(): score = score + 4
    if orRuns(): score = score + 8
    if !chained(): score = score + 16
    if bound(Just(3)): score = score + 32
    if !bound(Just(4)): score = score + 64
    if fallbackSkipped(Just(5)) == 5: score = score + 128
    if fallbackSkipped(Nothing) == 7: score = score + 256
    if once(False, bumpValue()) == 0: score = score + 512
    if once(True, bumpValue()) == 8: score = score + 1024
    if maskSkips() == 0: score = score + 2048
    if maskRuns() == 3: score = score + 4096

    -- Five arguments ran and no more: `andRuns`'s, `orRuns`'s, the `??` that had nothing to unwrap,
    -- the one `once` that read its parameter, and the `Mask` instance's. Everything else was
    -- skipped, and the tail of this number is what says so - `819105` and `819109` are the same
    -- score and different programs.
    return score * 100 + effects
