@image$base = []
mut @heapFree = [0, 0, 0, 0, 0, 0, 0, 0]

freeHeap<complex>(%allocation: Ptr) {
  b_0 {
    %v_1 = bitcast %allocation: I64
    %v_2 = cmp_eq %v_1, 0: I32
    je %v_2, b_3, b_4
  }

  b_3 {
    ret 
  }

  b_4 {
    %v_5 = sub %allocation, 8: Ptr
    %sizeClass = loads %v_5, 8: I64
    %v_6 = load @heapFree, 8: Ptr
    %v_7 = shl %sizeClass, 3: I64
    %v_8 = add %v_6, %v_7: Ptr
    %v_9 = load %v_8, 8: Ptr
    store %allocation, %v_9, 8
    %v_10 = load @heapFree, 8: Ptr
    %v_11 = add %v_10, %v_7: Ptr
    store %v_11, %allocation, 8
    ret 
  }
}

step<complex>(%s: Ptr, %rounds: I32): I32 {
  b_0 {
    %v_1 = add %s, 12: Ptr
    %first = load %v_1, 4: I32
    %v_2 = add %s, 4: Ptr
    %v_3 = load %v_2, 4: I32
    %v_4 = add %s, 8: Ptr
    %v_5 = load %v_4, 4: I32
    %v_6 = load %s, 4: I32
    %v_7 = add %s, 12: Ptr
    %v_8 = load %v_7, 4: I32
    jmp b_9
  }

  b_9 {
    %v_10 = phi [b_0, 0], [b_11, %v_12]: I32
    %v_13 = phi [b_0, %v_3], [b_11, %v_14]: I32
    %v_15 = phi [b_0, %v_5], [b_11, %v_16]: I32
    %v_17 = phi [b_0, %v_6], [b_11, %v_18]: I32
    %v_19 = phi [b_0, %v_8], [b_11, %v_20]: I32
    %v_21 = cmp_ilt %v_10, %rounds: I32
    je %v_21, b_11, b_22
  }

  b_22 {
    %v_23 = load %s, 4: I32
    %v_24 = add %s, 4: Ptr
    %v_25 = load %v_24, 4: I32
    %v_26 = add %v_23, %v_25: I32
    %v_27 = add %v_26, %first: I32
    ret %v_27
  }

  b_11 {
    %v_28 = add %s, 4: Ptr
    %t = shl %v_13, 9: I32
    %v_29 = add %s, 8: Ptr
    %v_30 = xor %v_15, %v_17: I32
    %v_31 = xor %v_19, %v_13: I32
    %v_14 = xor %v_13, %v_30: I32
    store %v_28, %v_14, 4
    %v_18 = xor %v_17, %v_31: I32
    store %s, %v_18, 4
    %v_16 = xor %v_30, %t: I32
    store %v_29, %v_16, 4
    %v_20 = rol %v_31, 11: I32
    store %v_1, %v_20, 4
    %v_12 = add %v_10, 1: I32
    jmp b_9
  }
}

tally<complex>(%n: I32, %stop: I32): I32 {
  b_0 {
    jmp b_1
  }

  b_1 {
    %v_2 = phi [b_0, 0], [b_3, %v_4]: I32
    %v_5 = phi [b_0, 0], [b_3, %v_6]: I32
    %v_7 = phi [b_0, 0], [b_3, %v_8]: I32
    %v_9 = cmp_ilt %v_2, %n: I32
    je %v_9, b_10, b_11
  }

  b_10 {
    %v_12 = cmp_eq %v_2, %stop: I32
    je %v_12, b_11, b_13
  }

  b_13 {
    %v_4 = add %v_2, 1: I32
    %v_14 = sar %v_2, 31: I32
    %v_15 = shr %v_14, 31: I32
    %v_16 = add %v_2, %v_15: I32
    %v_17 = and %v_16, 4294967294: I32
    %v_18 = sub %v_2, %v_17: I32
    %v_19 = cmp_eq %v_18, 0: I32
    je %v_19, b_20, b_3
  }

  b_20 {
    %v_21 = add %v_5, %v_2: I32
    jmp b_3
  }

  b_3 {
    %v_6 = phi [b_13, %v_5], [b_20, %v_21]: I32
    %v_8 = add %v_7, %v_6: I32
    jmp b_1
  }

  b_11 {
    %v_22 = imul %v_2, 10000: I32
    %v_23 = imul %v_5, 100: I32
    %v_24 = add %v_22, %v_23: I32
    %v_25 = add %v_24, %v_7: I32
    ret %v_25
