    %v_24 = shl %v_20, 2: I64
    %v_25 = add %v_23, %v_24: Ptr
    %v_26 = loads %v_25, 4: I32
    %v_27 = add %box, 16: Ptr
    %v_28 = loads %v_27, 4: I32
    %v_29 = add %v_26, %v_28: I32
    store %v_25, %v_29, 4
    %v_30 = loads %v_27, 4: I32
    %v_31 = add %v_30, 1: I32
    store %v_27, %v_31, 4
    %v_4 = add %v_2, 1: I32
