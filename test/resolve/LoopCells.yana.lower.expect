main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 16, 4: Ptr
    store %v_1, 1, 4
    %v_2 = add %v_1, 4: Ptr
    store %v_2, 2, 4
    %v_3 = add %v_1, 8: Ptr
