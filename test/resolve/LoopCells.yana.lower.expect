}

aliased<complex>(%box: Ptr): I32 {
  b_0 {
    jmp b_1
  }

  b_1 {
    %v_2 = phi [b_0, 0], [b_3, %v_4]: I32
    %v_5 = add %box, 12: Ptr
    %v_6 = load %v_5, 4: I32
    %v_7 = cmp_ilt %v_2, %v_6: I32
    je %v_7, b_8, b_9
  }

  b_9 {
