  b_41 {
    jmp b_34
  }

  b_40 {
    %v_42 = shl %a, %v_35: I64
    %v_43 = xor %v_33, %v_42: I64
    jmp b_34
  }

  b_34 {
    %v_5 = phi [b_41, %v_33], [b_40, %v_43]: I64
    %v_36 = add %v_35, 1: I64
    %v_44 = cmp_lt %v_36, 64: I32
    je %v_44, b_2, b_3
  }
}

carryless<complex>(): I32 {
  b_0 {
    %v_1 = load @keyLow, 8: I64
    %a0 = mul %v_1, 11400714819323198485: I64
    %v_2 = load @plainHigh, 8: I64
    %a1 = mul %v_2, 14029467366897019727: I64
    %v_3 = load @plainLow, 8: I64
    %b0 = rol %v_3, 17: I64
    %v_4 = load @keyHigh, 8: I64
    %b1 = mul %v_4, 1609587929392839161: I64
    %v_5 = vsplat 0: i64x2
    %v_6 = vwithlane %v_5, %a0, 0: i64x2
    %v_7 = vwithlane %v_6, %a1, 1: i64x2
