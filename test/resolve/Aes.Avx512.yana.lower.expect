@image$base = []
mut @keyLow = [0, 1, 2, 3, 4, 5, 6, 7]
mut @keyHigh = [8, 9, 10, 11, 12, 13, 14, 15]
mut @plainLow = [0, 17, 34, 51, 68, 85, 102, 119]
mut @plainHigh = [136, 153, 170, 187, 204, 221, 238, 255]

nextKey<complex>(%key: i8x16, %assist: i8x16): i8x16 {
  b_0 {
    %v_1 = bitcast %assist: i32x4
    %t = vshuffle %v_1, %v_1, 3, 3, 3, 3: i32x4
    %z = vsplat 0: i32x4
    %k0 = bitcast %key: i32x4
    %v_2 = vshuffle %k0, %z, 7, 0, 1, 2: i32x4
    %k1 = xor %k0, %v_2: i32x4
    %v_3 = vshuffle %k1, %z, 6, 7, 0, 1: i32x4
    %k2 = xor %k1, %v_3: i32x4
    %v_4 = xor %k2, %t: i32x4
    %v_5 = bitcast %v_4: i8x16
    ret %v_5
  }
}

aes128<complex>(): I32 {
  b_0 {
    %v_1 = load @keyLow, 8: I64
    %v_2 = load @keyHigh, 8: I64
    %v_3 = vsplat 0: i64x2
    %v_4 = vwithlane %v_3, %v_1, 0: i64x2
    %v_5 = vwithlane %v_4, %v_2, 1: i64x2
    %v_6 = bitcast %v_5: i8x16
    %v_7 = aeskeygenassist %v_6, 1: i8x16
    %k1 = call_complex nextKey, %v_6, %v_7: i8x16
    %v_8 = aeskeygenassist %k1, 2: i8x16
    %k2 = call_complex nextKey, %k1, %v_8: i8x16
    %v_9 = aeskeygenassist %k2, 4: i8x16
    %k3 = call_complex nextKey, %k2, %v_9: i8x16
    %v_10 = aeskeygenassist %k3, 8: i8x16
    %k4 = call_complex nextKey, %k3, %v_10: i8x16
    %v_11 = aeskeygenassist %k4, 16: i8x16
    %k5 = call_complex nextKey, %k4, %v_11: i8x16
    %v_12 = aeskeygenassist %k5, 32: i8x16
    %k6 = call_complex nextKey, %k5, %v_12: i8x16
    %v_13 = aeskeygenassist %k6, 64: i8x16
    %k7 = call_complex nextKey, %k6, %v_13: i8x16
    %v_14 = aeskeygenassist %k7, 128: i8x16
    %k8 = call_complex nextKey, %k7, %v_14: i8x16
    %v_15 = aeskeygenassist %k8, 27: i8x16
    %k9 = call_complex nextKey, %k8, %v_15: i8x16
    %v_16 = aeskeygenassist %k9, 54: i8x16
    %k10 = call_complex nextKey, %k9, %v_16: i8x16
    %v_17 = bitcast %k10: i64x2
    %v_18 = vlane %v_17, 0: I64
    %v_19 = cmp_neq %v_18, 1678317515960029459: I32
    je %v_19, b_20, b_21
  }

  b_20 {
    jmp b_22
  }

  b_21 {
    jmp b_22
  }

  b_22 {
    %v_23 = phi [b_20, 1], [b_21, 0]: I32
    %v_24 = vlane %v_17, 1: I64
    %v_25 = cmp_neq %v_24, 14208904436409370611: I32
    je %v_25, b_26, b_27
  }

  b_26 {
    %v_28 = add %v_23, 1: I32
    jmp b_29
  }

  b_27 {
    jmp b_29
  }

  b_29 {
    %v_30 = phi [b_26, %v_28], [b_27, %v_23]: I32
    %v_31 = load @plainLow, 8: I64
    %v_32 = load @plainHigh, 8: I64
    %v_33 = vsplat 0: i64x2
    %v_34 = vwithlane %v_33, %v_31, 0: i64x2
    %v_35 = vwithlane %v_34, %v_32, 1: i64x2
    %v_36 = bitcast %v_35: i8x16
    %v_37 = xor %v_36, %v_6: i8x16
    %v_38 = aesenc %v_37, %k1: i8x16
    %v_39 = aesenc %v_38, %k2: i8x16
    %v_40 = aesenc %v_39, %k3: i8x16
    %v_41 = aesenc %v_40, %k4: i8x16
    %v_42 = aesenc %v_41, %k5: i8x16
    %v_43 = aesenc %v_42, %k6: i8x16
    %v_44 = aesenc %v_43, %k7: i8x16
    %v_45 = aesenc %v_44, %k8: i8x16
    %v_46 = aesenc %v_45, %k9: i8x16
    %cipher = aesenclast %v_46, %k10: i8x16
    %v_47 = bitcast %cipher: i64x2
    %v_48 = vlane %v_47, 0: I64
    %v_49 = cmp_neq %v_48, 3460026112562742377: I32
    je %v_49, b_50, b_51
  }

  b_50 {
    %v_52 = add %v_30, 1: I32
    jmp b_53
  }

  b_51 {
    jmp b_53
  }

  b_53 {
    %v_54 = phi [b_50, %v_52], [b_51, %v_30]: I32
    %v_55 = vlane %v_47, 1: I64
    %v_56 = cmp_neq %v_55, 6540832429114379736: I32
    je %v_56, b_57, b_58
  }

  b_57 {
    %v_59 = add %v_54, 1: I32
    jmp b_60
  }

  b_58 {
    jmp b_60
  }

  b_60 {
    %v_61 = phi [b_57, %v_59], [b_58, %v_54]: I32
    %v_62 = xor %cipher, %k10: i8x16
    %v_63 = aesimc %k9: i8x16
    %v_64 = aesdec %v_62, %v_63: i8x16
    %v_65 = aesimc %k8: i8x16
    %v_66 = aesdec %v_64, %v_65: i8x16
    %v_67 = aesimc %k7: i8x16
    %v_68 = aesdec %v_66, %v_67: i8x16
    %v_69 = aesimc %k6: i8x16
    %v_70 = aesdec %v_68, %v_69: i8x16
    %v_71 = aesimc %k5: i8x16
    %v_72 = aesdec %v_70, %v_71: i8x16
    %v_73 = aesimc %k4: i8x16
    %v_74 = aesdec %v_72, %v_73: i8x16
    %v_75 = aesimc %k3: i8x16
    %v_76 = aesdec %v_74, %v_75: i8x16
    %v_77 = aesimc %k2: i8x16
    %v_78 = aesdec %v_76, %v_77: i8x16
    %v_79 = aesimc %k1: i8x16
    %v_80 = aesdec %v_78, %v_79: i8x16
    %back = aesdeclast %v_80, %v_6: i8x16
    %v_81 = bitcast %back: i64x2
    %v_82 = vlane %v_81, 0: I64
    %v_83 = cmp_neq %v_82, %v_31: I32
    je %v_83, b_84, b_85
  }

  b_84 {
    %v_86 = add %v_61, 1: I32
    jmp b_87
  }

  b_85 {
    jmp b_87
  }

  b_87 {
    %v_88 = phi [b_84, %v_86], [b_85, %v_61]: I32
    %v_89 = vlane %v_81, 1: I64
    %v_90 = cmp_neq %v_89, %v_32: I32
    je %v_90, b_91, b_92
  }

  b_91 {
    %v_93 = add %v_88, 1: I32
    jmp b_94
  }

  b_92 {
    jmp b_94
  }

  b_94 {
    %v_95 = phi [b_91, %v_93], [b_92, %v_88]: I32
    ret %v_95
  }
}

checkProduct<complex>(%v: i64x2, %a: I64, %b: I64): I32 {
  b_0 {
    %v_1 = vlane %v, 0: I64
    jmp b_2
  }

  b_3 {
    %v_4 = cmp_neq %v_1, %v_5: I32
    je %v_4, b_6, b_7
  }

  b_7 {
    jmp b_8
  }

  b_6 {
    jmp b_8
  }

  b_8 {
    %v_9 = phi [b_7, 0], [b_6, 1]: I32
    %v_10 = vlane %v, 1: I64
    jmp b_11
  }

  b_12 {
    %v_13 = cmp_neq %v_10, %v_14: I32
    je %v_13, b_15, b_16
  }

  b_16 {
    jmp b_17
  }

  b_15 {
    %v_18 = add %v_9, 1: I32
    jmp b_17
  }

  b_17 {
    %v_19 = phi [b_16, %v_9], [b_15, %v_18]: I32
    ret %v_19
  }

  b_11 {
    %v_20 = phi [b_21, %v_14], [b_8, 0]: I64
    %v_22 = phi [b_21, %v_23], [b_8, 1]: I64
    %v_24 = shr %b, %v_22: I64
    %v_25 = and %v_24, 1: I64
    %v_26 = cmp_neq %v_25, 0: I32
    je %v_26, b_27, b_28
  }

  b_28 {
    jmp b_21
  }

  b_27 {
    %v_29 = sub 64, %v_22: I64
    %v_30 = shr %a, %v_29: I64
    %v_31 = xor %v_20, %v_30: I64
    jmp b_21
  }

  b_21 {
    %v_14 = phi [b_28, %v_20], [b_27, %v_31]: I64
    %v_23 = add %v_22, 1: I64
    %v_32 = cmp_lt %v_23, 64: I32
    je %v_32, b_11, b_12
  }

  b_2 {
    %v_33 = phi [b_34, %v_5], [b_0, 0]: I64
    %v_35 = phi [b_34, %v_36], [b_0, 0]: I64
    %v_37 = shr %b, %v_35: I64
    %v_38 = and %v_37, 1: I64
    %v_39 = cmp_neq %v_38, 0: I32
    je %v_39, b_40, b_41
