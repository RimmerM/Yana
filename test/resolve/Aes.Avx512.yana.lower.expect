    %v_9 = vwithlane %v_8, %b1, 1: i64x2
    %v_10 = pclmullqlqdq %v_7, %v_9: i64x2
    %v_11 = call_complex checkProduct, %v_10, %a0, %b0: I32
    %v_12 = pclmulhqlqdq %v_7, %v_9: i64x2
    %v_13 = call_complex checkProduct, %v_12, %a1, %b0: I32
    %v_14 = add %v_11, %v_13: I32
    %v_15 = pclmullqhqdq %v_7, %v_9: i64x2
    %v_16 = call_complex checkProduct, %v_15, %a0, %b1: I32
    %v_17 = add %v_14, %v_16: I32
    %v_18 = pclmulhqhqdq %v_7, %v_9: i64x2
    %v_19 = call_complex checkProduct, %v_18, %a1, %b1: I32
    %v_20 = add %v_17, %v_19: I32
