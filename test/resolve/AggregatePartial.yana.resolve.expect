let image$base: () = <none>

let &log: I32 = 0

fn opaque(%n: I32) -> I32 {
  b0:
    %v1 = load log : I32
    %v2 = add %v1, %n : I32
    assign log, %v2
    %v4 = load log : I32
    %v7 = cmp_gt %v4, 1000 : Bool
    je %v7, b1, b2

  b1:
    ret 0

  b2:
    jmp b3

  b3:
    ret %n
}

fn computed(%seed: I32) -> I32 {
  b0:
    %v1 = alloc : Pair
    aggregate %p@Pair.a = 10, %p@Pair.b = 20
    %v5 = call opaque, %seed : I32
    assign %p@Pair.b, %v5
    %v7 = load %p : Pair
    %v8 = load %p@Pair.a : I32
    %v11 = mul %v8, 100 : I32
    %v12 = load %p : Pair
    %v13 = load %p@Pair.b : I32
    %v14 = add %v11, %v13 : I32
    ret %v14
}

fn readBetween() -> I32 {
  b0:
    %v0 = alloc : Pair
    aggregate %p@Pair.a = 3, %p@Pair.b = 4
    %v4 = load %p : Pair
    %first = load %p@Pair.b : I32
    assign %p@Pair.b, 9
    %v8 = load %p : Pair
    %v9 = load %p@Pair.a : I32
    %v12 = mul %v9, 100 : I32
    %v15 = mul %first, 10 : I32
    %v16 = add %v12, %v15 : I32
    %v17 = load %p : Pair
    %v18 = load %p@Pair.b : I32
    %v19 = add %v16, %v18 : I32
    ret %v19
}

fn both(%seed: I32) -> I32 {
  b0:
    %inner = alloc : Pair
    aggregate %local0@Pair.a = 1, %local0@Pair.b = 2
    %v5 = alloc : Held
    aggregate %outer@Held.tag = 7, %outer@Held.held = %inner
    %v8 = call opaque, %seed : I32
    assign %outer@Held.tag, %v8
    %v10 = load %outer : Held
    %v11 = load %outer@Held.held : Pair
    %v12 = load %outer@Held.held@Pair.a : I32
    %v15 = mul %v12, 100 : I32
    %v16 = load %outer : Held
    %v17 = load %outer@Held.held : Pair
    %v18 = load %outer@Held.held@Pair.b : I32
    %v21 = mul %v18, 10 : I32
    %v22 = add %v15, %v21 : I32
    %v23 = load %outer : Held
    %v24 = load %outer@Held.tag : I32
    %v25 = add %v22, %v24 : I32
    ret %v25
}

fn derived(%seed: I32) -> I32 {
  b0:
    %v1 = alloc : Held
    %v3 = alloc : Pair
    aggregate %local1@Pair.a = 1, %local1@Pair.b = 2
    aggregate %h@Held.tag = 7, %h@Held.held = %v3
    %v8 = load %h : Held
    %v9 = load %h@Held.tag : I32
    %v10 = call opaque, %seed : I32
    %v11 = add %v9, %v10 : I32
    assign %h@Held.tag, %v11
    %v13 = load %h : Held
    %v14 = load %h@Held.held : Pair
    %v15 = load %h@Held.held@Pair.a : I32
    %v18 = mul %v15, 100 : I32
    %v19 = load %h : Held
    %v20 = load %h@Held.held : Pair
    %v21 = load %h@Held.held@Pair.b : I32
    %v24 = mul %v21, 10 : I32
    %v25 = add %v18, %v24 : I32
    %v26 = load %h : Held
    %v27 = load %h@Held.tag : I32
    %v28 = add %v25, %v27 : I32
    ret %v28
}

fn main() -> I32 {
  b0:
    %v1 = call computed, 5 : I32
    %v2 = call readBetween : I32
    %v3 = add %v1, %v2 : I32
    %v5 = call both, 6 : I32
    %v6 = add %v3, %v5 : I32
    %v8 = call derived, 7 : I32
    %v9 = add %v6, %v8 : I32
    %v10 = load log : I32
    %v11 = add %v9, %v10 : I32
    ret %v11
}
