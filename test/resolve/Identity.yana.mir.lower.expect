
boxedValue<complex>(%box: Ptr): I32 {
  b_0 {
    %v_1 = loads %box, 4: I32
    ret %v_1
  }
}

nestedValue<complex>(%box: Ptr): I32 {
  b_0 {
    %v_1 = loads %box, 4: I32
    ret %v_1
  }
}

pairSum<complex>(%pair: Ptr): I32 {
  b_0 {
    %v_1 = loads %pair, 4: I32
    %v_2 = add %pair, 4: Ptr
    %v_3 = loads %v_2, 4: I32
    %v_4 = add %v_1, %v_3: I32
    ret %v_4
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    %v_2 = alloca 1, 1: Ptr
    %v_3 = alloca 4, 4: Ptr
    %v_4 = alloca 4, 4: Ptr
    %v_5 = alloca 4, 4: Ptr
    %v_6 = alloca 4, 4: Ptr
    %v_7 = call_complex id(I32), 1: I32
    store %v_1, %v_7, 4
    %v_8 = call_complex also(Bool), 1: I32
    store %v_2, %v_8, 1
    %v_9 = alloca 4, 4: Ptr
    call_complex rewrap(I32), %v_9, 20
    %v_10 = call_complex boxedValue, %v_9: I32
    store %v_3, %v_10, 4
    %v_11 = alloca 4, 4: Ptr
    call_complex twice(I32), %v_11, 300
    %v_12 = call_complex nestedValue, %v_11: I32
    store %v_4, %v_12, 4
    %v_13 = alloca 8, 4: Ptr
    call_complex swapped(I32, I32), %v_13, 4000, 50000
    %v_14 = call_complex pairSum, %v_13: I32
    store %v_5, %v_14, 4
    %v_15 = load %v_2, 1: I32
    je %v_15, b_16, b_17
  }

  b_17 {
    jmp b_18
  }

  b_18 {
    %v_19 = phi [b_17, 0], [b_16, 2]: I32
    store %v_6, %v_19, 4
    %v_20 = loads %v_1, 4: I32
    %v_21 = loads %v_6, 4: I32
    %v_22 = add %v_20, %v_21: I32
    %v_23 = loads %v_3, 4: I32
    %v_24 = add %v_22, %v_23: I32
    %v_25 = loads %v_4, 4: I32
    %v_26 = add %v_24, %v_25: I32
    %v_27 = loads %v_5, 4: I32
    %v_28 = add %v_26, %v_27: I32
    ret %v_28
  }

  b_16 {
    jmp b_18
  }
}

id(I32)<complex>(%x: I32): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    store %v_1, %x, 4
    %v_2 = loads %v_1, 4: I32
    ret %v_2
  }
}

also(Bool)<complex>(%x: I32): I32 {
  b_0 {
    %v_1 = alloca 1, 1: Ptr
    store %v_1, %x, 1
    %v_2 = load %v_1, 1: I32
    ret %v_2
  }
}

rewrap(I32)<complex>(%v_0: Ptr, %x: I32) {
  b_1 {
    %v_2 = alloca 4, 4: Ptr
    store %v_2, %x, 4
    %v_3 = loads %v_2, 4: I32
    %v_4 = call_complex id(I32), %v_3: I32
    %v_5 = alloca 4, 4: Ptr
    call_complex boxed(I32), %v_5, %v_4
    copy %v_0, %v_5, 4
    ret 
  }
}

twice(I32)<complex>(%v_0: Ptr, %x: I32) {
  b_1 {
    %v_2 = alloca 4, 4: Ptr
    store %v_2, %x, 4
    %v_3 = loads %v_2, 4: I32
    %v_4 = alloca 4, 4: Ptr
    store %v_4, %v_3, 4
    %v_5 = alloca 4, 4: Ptr
    copy %v_5, %v_4, 4
    copy %v_0, %v_5, 4
    ret 
  }
}

swapped(I32, I32)<complex>(%v_0: Ptr, %left: I32, %right: I32) {
  b_1 {
    %v_2 = alloca 4, 4: Ptr
    %v_3 = alloca 4, 4: Ptr
    store %v_2, %left, 4
    store %v_3, %right, 4
    %v_4 = loads %v_3, 4: I32
    %v_5 = loads %v_2, 4: I32
    %v_6 = alloca 8, 4: Ptr
    store %v_6, %v_4, 4
    %v_7 = add %v_6, 4: Ptr
    store %v_7, %v_5, 4
    copy %v_0, %v_6, 8
    ret 
  }
}

boxed(I32)<complex>(%v_0: Ptr, %x: I32) {
  b_1 {
    %v_2 = alloca 4, 4: Ptr
    store %v_2, %x, 4
    %v_3 = loads %v_2, 4: I32
    %v_4 = alloca 4, 4: Ptr
    store %v_4, %v_3, 4
    copy %v_0, %v_4, 4
    ret 
  }
}

