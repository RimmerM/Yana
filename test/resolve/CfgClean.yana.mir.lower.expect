    %v_22 = imul %v_12, 5: I32
    %v_23 = add 35, %v_22: I32
    %v_24 = imm 6: I32
    %v_25 = loads @live, 4: I32
    %v_26 = add %v_25, 1: I32
    store @live, %v_26, 4
    jmp b_27
  }

  b_27 {
    %v_28 = phi [b_15, 0], [b_29, %v_30]: I32
    %v_31 = phi [b_15, 0], [b_29, %v_32]: I32
    %v_33 = cmp_ilt %v_28, %v_24: I32
    je %v_33, b_34, b_35
  }

  b_34 {
    %v_36 = cmp_igt %v_28, 2: I32
    je %v_36, b_37, b_29
  }

  b_29 {
    %v_38 = imul %v_31, 10: I32
    %v_32 = add %v_38, %v_28: I32
    %v_30 = add %v_28, 1: I32
    jmp b_27
  }

  b_37 {
    %v_39 = loads @live, 4: I32
    %v_40 = sub %v_39, 1: I32
    store @live, %v_40, 4
    %v_41 = loads @trace, 4: I32
    %v_42 = imul %v_41, 10: I32
    %v_43 = add %v_42, %v_24: I32
    store @trace, %v_43, 4
    jmp b_35
  }

  b_35 {
    %v_44 = phi [b_27, 1], [b_37, 0]: I32
    je %v_44, b_45, b_46
  }

  b_45 {
    %v_47 = loads @live, 4: I32
    %v_48 = sub %v_47, 1: I32
    store @live, %v_48, 4
    %v_49 = loads @trace, 4: I32
    %v_50 = imul %v_49, 10: I32
    %v_51 = add %v_50, %v_24: I32
    store @trace, %v_51, 4
    jmp b_46
  }

  b_46 {
    %v_52 = imul %v_31, 7: I32
    %v_53 = add %v_23, %v_52: I32
    %v_54 = add %v_53, 769: I32
    %v_55 = imul %v_54, 1000: I32
    %v_56 = loads @trace, 4: I32
    %v_57 = imul %v_56, 10: I32
    %v_58 = add %v_55, %v_57: I32
