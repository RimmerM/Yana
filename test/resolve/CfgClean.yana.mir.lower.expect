mut @live = [0, 0, 0, 0]
mut @trace = [0, 0, 0, 0]

Held.drop<complex>(%self: Ptr) {
  b_0 {
    %v_1 = load %self, 4: I32
    %v_2 = loads @live, 4: I32
    %v_3 = sub %v_2, 1: I32
    store @live, %v_3, 4
    %v_4 = loads @trace, 4: I32
    %v_5 = imul %v_4, 10: I32
    %v_6 = add %v_5, %v_1: I32
    store @trace, %v_6, 4
    ret 
  }
}

nested<complex>(%n: I32): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    %v_2 = loads @live, 4: I32
    %v_3 = add %v_2, 1: I32
    store @live, %v_3, 4
    store %v_1, %n, 4
    jmp b_4
  }

  b_4 {
    %v_5 = phi [b_0, 0], [b_6, %v_7]: I32
    %v_8 = phi [b_0, 0], [b_6, %v_9]: I32
    %v_10 = cmp_ilt %v_5, %n: I32
    je %v_10, b_11, b_12
  }

  b_11 {
    %v_13 = cmp_igt %v_5, 2: I32
    je %v_13, b_14, b_15
  }

  b_15 {
    %v_16 = cmp_igt %v_5, 4: I32
    je %v_16, b_17, b_6
  }

  b_18 {
    call_complex Held.drop, %v_1
    jmp b_19
  }

  b_19 {
    jmp b_12
  }

  b_14 {
    %v_20 = alloca 4, 4: Ptr
    copy %v_20, %v_1, 4
    %v_21 = loads %v_20, 4: I32
    call_complex Held.drop, %v_20
    %v_22 = cmp_igt %v_21, 4: I32
    %v_23 = imul %v_8, 10: I32
    %v_24 = add %v_23, %v_21: I32
    %v_25 = select %v_22, %v_8, %v_24: I32
    jmp b_12
  }

  b_12 {
    %v_26 = phi [b_4, 1], [b_19, 0], [b_14, 0]: I32
    %v_27 = phi [b_4, %v_8], [b_19, %v_8], [b_14, %v_25]: I32
    je %v_26, b_28, b_29
  }

  b_28 {
    call_complex Held.drop, %v_1
    jmp b_29
  }

  b_29 {
    ret %v_27
  }

  b_6 {
    %v_30 = imul %v_8, 10: I32
    %v_9 = add %v_30, %v_5: I32
    %v_7 = add %v_5, 1: I32
    jmp b_4
  }

  b_17 {
    jmp b_18
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    %v_2 = alloca 4, 4: Ptr
    %v_3 = call_complex nested, 0: I32
    %v_4 = imul %v_3, 3: I32
    %v_5 = add 35, %v_4: I32
    %v_6 = call_complex nested, 3: I32
    %v_7 = imul %v_6, 5: I32
    %v_8 = add %v_5, %v_7: I32
    %v_9 = call_complex nested, 6: I32
    %v_10 = imul %v_9, 7: I32
    %v_11 = add %v_8, %v_10: I32
    %v_12 = add %v_11, 769: I32
    %v_13 = imul %v_12, 1000: I32
    %v_14 = loads @trace, 4: I32
    %v_15 = imul %v_14, 10: I32
    %v_16 = add %v_13, %v_15: I32
    %v_17 = loads @live, 4: I32
    %v_18 = add %v_16, %v_17: I32
    ret %v_18
  }
}

