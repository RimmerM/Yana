mut @live = [0, 0, 0, 0]
mut @trace = [0, 0, 0, 0]

main<complex>(): I32 {
  b_0 {
    %v_1 = loads @live, 4: I32
    %v_2 = add %v_1, 1: I32
    store @live, %v_2, 4
    %v_3 = sub %v_2, 1: I32
    store @live, %v_3, 4
    %v_4 = loads @trace, 4: I32
    %v_5 = imul %v_4, 10: I32
    store @trace, %v_5, 4
    %v_6 = imm 3: I32
    %v_7 = add %v_3, 1: I32
    store @live, %v_7, 4
    jmp b_8
  }

  b_9 {
    %v_10 = cmp_ilt %v_11, %v_6: I32
    je %v_10, b_8, b_12
  }

  b_8 {
    %v_13 = phi [b_9, %v_11], [b_0, 0]: I32
    %v_14 = phi [b_9, %v_15], [b_0, 0]: I32
    %v_16 = imul %v_14, 10: I32
    %v_15 = add %v_16, %v_13: I32
    %v_11 = add %v_13, 1: I32
    jmp b_9
  }

  b_12 {
    %v_17 = loads @live, 4: I32
    %v_18 = sub %v_17, 1: I32
    store @live, %v_18, 4
    %v_19 = loads @trace, 4: I32
    %v_20 = imul %v_19, 10: I32
    %v_21 = add %v_20, %v_6: I32
    store @trace, %v_21, 4
    %v_22 = imul %v_15, 5: I32
    %v_23 = add 35, %v_22: I32
    %v_24 = imm 6: I32
    %v_25 = add %v_18, 1: I32
    store @live, %v_25, 4
    jmp b_26
  }

  b_26 {
    %v_27 = phi [b_12, 0], [b_28, %v_29]: I32
    %v_30 = phi [b_12, 0], [b_28, %v_31]: I32
    %v_32 = cmp_ilt %v_27, %v_24: I32
    je %v_32, b_33, b_34
  }

  b_33 {
    %v_35 = cmp_igt %v_27, 2: I32
    je %v_35, b_36, b_28
  }

  b_28 {
    %v_37 = imul %v_30, 10: I32
    %v_31 = add %v_37, %v_27: I32
    %v_29 = add %v_27, 1: I32
    jmp b_26
  }

  b_36 {
    %v_38 = loads @live, 4: I32
    %v_39 = sub %v_38, 1: I32
    store @live, %v_39, 4
    %v_40 = loads @trace, 4: I32
    %v_41 = imul %v_40, 10: I32
    %v_42 = add %v_41, %v_24: I32
    store @trace, %v_42, 4
    jmp b_43
  }

  b_34 {
    %v_44 = loads @live, 4: I32
    %v_45 = sub %v_44, 1: I32
    store @live, %v_45, 4
    %v_46 = loads @trace, 4: I32
    %v_47 = imul %v_46, 10: I32
    %v_48 = add %v_47, %v_24: I32
    store @trace, %v_48, 4
    jmp b_43
  }

  b_43 {
    %v_49 = imul %v_30, 7: I32
    %v_50 = add %v_23, %v_49: I32
    %v_51 = add %v_50, 769: I32
    %v_52 = imul %v_51, 1000: I32
    %v_53 = loads @trace, 4: I32
    %v_54 = imul %v_53, 10: I32
    %v_55 = add %v_52, %v_54: I32
    %v_56 = loads @live, 4: I32
    %v_57 = add %v_55, %v_56: I32
    ret %v_57
  }
}

