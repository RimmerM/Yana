mut @live = [0, 0, 0, 0]
mut @trace = [0, 0, 0, 0]

main<complex>(): I32 {
  b_0 {
    %v_1 = loads @live, 4: I32
    %v_2 = add %v_1, 1: I32
    store @live, %v_2, 4
    %v_3 = sub %v_2, 1: I32
    store @live, %v_3, 4
    %v_4 = loads @trace, 4: I32
    %v_5 = imul %v_4, 10: I32
    store @trace, %v_5, 4
    %v_6 = imm 3: I32
    %v_7 = add %v_3, 1: I32
    store @live, %v_7, 4
    jmp b_8
  }

  b_8 {
    %v_9 = phi [b_0, 0], [b_10, %v_11]: I32
    %v_12 = phi [b_0, 0], [b_10, %v_13]: I32
    %v_14 = cmp_ilt %v_9, %v_6: I32
    je %v_14, b_10, b_15
  }

  b_10 {
    %v_16 = imul %v_12, 10: I32
    %v_13 = add %v_16, %v_9: I32
    %v_11 = add %v_9, 1: I32
    jmp b_8
  }

  b_15 {
    %v_17 = loads @live, 4: I32
    %v_18 = sub %v_17, 1: I32
    store @live, %v_18, 4
    %v_19 = loads @trace, 4: I32
    %v_20 = imul %v_19, 10: I32
    %v_21 = add %v_20, %v_6: I32
    store @trace, %v_21, 4
    %v_22 = imul %v_12, 5: I32
    %v_23 = add 35, %v_22: I32
    %v_24 = imm 6: I32
    %v_25 = loads @live, 4: I32
    %v_26 = add %v_25, 1: I32
    store @live, %v_26, 4
    jmp b_27
  }

  b_27 {
    %v_28 = phi [b_15, 0], [b_29, %v_30]: I32
    %v_31 = phi [b_15, 0], [b_29, %v_32]: I32
    %v_33 = cmp_ilt %v_28, %v_24: I32
    je %v_33, b_34, b_35
  }

  b_34 {
    %v_36 = cmp_igt %v_28, 2: I32
    je %v_36, b_37, b_29
  }

  b_29 {
    %v_38 = imul %v_31, 10: I32
    %v_32 = add %v_38, %v_28: I32
    %v_30 = add %v_28, 1: I32
    jmp b_27
  }

  b_37 {
    %v_39 = loads @live, 4: I32
    %v_40 = sub %v_39, 1: I32
    store @live, %v_40, 4
    %v_41 = loads @trace, 4: I32
    %v_42 = imul %v_41, 10: I32
    %v_43 = add %v_42, %v_24: I32
    store @trace, %v_43, 4
    jmp b_44
  }

  b_35 {
    %v_45 = loads @live, 4: I32
    %v_46 = sub %v_45, 1: I32
    store @live, %v_46, 4
    %v_47 = loads @trace, 4: I32
    %v_48 = imul %v_47, 10: I32
    %v_49 = add %v_48, %v_24: I32
    store @trace, %v_49, 4
    jmp b_44
  }

  b_44 {
    %v_50 = imul %v_31, 7: I32
    %v_51 = add %v_23, %v_50: I32
    %v_52 = add %v_51, 769: I32
    %v_53 = imul %v_52, 1000: I32
    %v_54 = loads @trace, 4: I32
    %v_55 = imul %v_54, 10: I32
    %v_56 = add %v_53, %v_55: I32
    %v_57 = loads @live, 4: I32
    %v_58 = add %v_56, %v_57: I32
    ret %v_58
  }
