    %v_22 = add %v_21, 8: Ptr
    store %v_22, %v_20, 8
    %v_23 = call_complex steps, 6, %v_21: I32
    %v_24 = loads %v_19, 4: I32
    %v_25 = imul %v_24, 7: I32
    %v_26 = add %v_18, %v_25: I32
    %v_27 = add %v_26, 11: I32
    %v_28 = add %v_27, 13: I32
    %v_29 = add %v_28, 17: I32
    %v_30 = add %v_29, 38: I32
    %v_31 = add %v_30, 23: I32
    %v_32 = add %v_31, 58: I32
    %v_33 = add %v_32, 31: I32
    %v_34 = add %v_33, 74: I32
    %v_35 = add %v_34, 246: I32
    %v_36 = add %v_35, 258: I32
    %v_37 = imul %v_36, 1000: I32
    %v_38 = loads @trace, 4: I32
    %v_39 = imul %v_38, 10: I32
    %v_40 = add %v_37, %v_39: I32
    %v_41 = loads @live, 4: I32
    %v_42 = add %v_40, %v_41: I32
