mut @live = [0, 0, 0, 0]
mut @trace = [0, 0, 0, 0]

main<complex>(): I32 {
  b_0 {
    %v_1 = loads @live, 4: I32
    %v_2 = add %v_1, 1: I32
    store @live, %v_2, 4
    %v_3 = sub %v_2, 1: I32
    store @live, %v_3, 4
    %v_4 = loads @trace, 4: I32
    %v_5 = imul %v_4, 10: I32
    store @trace, %v_5, 4
    %v_6 = imm 3: I32
    %v_7 = add %v_3, 1: I32
    store @live, %v_7, 4
    jmp b_8
  }

  b_8 {
    %v_9 = phi [b_0, 0], [b_10, %v_11]: I32
    %v_12 = phi [b_0, 0], [b_10, %v_13]: I32
    %v_14 = cmp_ilt %v_9, %v_6: I32
    je %v_14, b_10, b_15
  }

  b_10 {
    %v_16 = imul %v_12, 10: I32
    %v_13 = add %v_16, %v_9: I32
    %v_11 = add %v_9, 1: I32
    jmp b_8
  }

