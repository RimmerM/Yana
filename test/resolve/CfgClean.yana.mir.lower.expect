mut @live = [0, 0, 0, 0]
mut @trace = [0, 0, 0, 0]

Held.drop<complex>(%self: Ptr) {
  b_0 {
    %v_1 = load %self, 4: I32
    %v_2 = loads @live, 4: I32
    %v_3 = sub %v_2, 1: I32
    store @live, %v_3, 4
    %v_4 = loads @trace, 4: I32
    %v_5 = imul %v_4, 10: I32
    %v_6 = add %v_5, %v_1: I32
    store @trace, %v_6, 4
    ret 
  }
}

nested<complex>(%n: I32): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    %v_2 = loads @live, 4: I32
    %v_3 = add %v_2, 1: I32
    store @live, %v_3, 4
    store %v_1, %n, 4
    jmp b_4
  }

  b_4 {
    %v_5 = phi [b_0, 0], [b_6, %v_7]: I32
    %v_8 = phi [b_0, 0], [b_6, %v_9]: I32
    %v_10 = cmp_ilt %v_5, %n: I32
    je %v_10, b_11, b_12
  }

  b_11 {
    %v_13 = cmp_igt %v_5, 2: I32
    je %v_13, b_14, b_15
  }

  b_15 {
    %v_16 = cmp_igt %v_5, 4: I32
    je %v_16, b_17, b_6
  }

  b_14 {
    %v_18 = alloca 4, 4: Ptr
    copy %v_18, %v_1, 4
    %v_19 = loads %v_18, 4: I32
    call_complex Held.drop, %v_18
    %v_20 = cmp_igt %v_19, 4: I32
    je %v_20, b_21, b_22
  }

  b_12 {
    %v_23 = phi [b_4, 1], [b_17, 0], [b_21, 0]: I32
    %v_24 = phi [b_4, %v_8], [b_17, %v_8], [b_21, %v_25]: I32
    je %v_23, b_26, b_27
  }

  b_26 {
    call_complex Held.drop, %v_1
    jmp b_27
  }

  b_27 {
    ret %v_24
  }

  b_6 {
    %v_28 = imul %v_8, 10: I32
    %v_9 = add %v_28, %v_5: I32
    %v_7 = add %v_5, 1: I32
    jmp b_4
  }

  b_17 {
    call_complex Held.drop, %v_1
    jmp b_12
  }

  b_21 {
    %v_25 = phi [b_14, %v_8], [b_22, %v_29]: I32
    jmp b_12
  }

  b_22 {
    %v_30 = imul %v_8, 10: I32
    %v_29 = add %v_30, %v_19: I32
    jmp b_21
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    %v_2 = alloca 4, 4: Ptr
    %v_3 = alloca 4, 4: Ptr
    %v_4 = loads @live, 4: I32
    %v_5 = add %v_4, 1: I32
    store @live, %v_5, 4
    store %v_3, 0, 4
    call_complex Held.drop, %v_3
    %v_6 = call_complex nested, 3: I32
    %v_7 = imul %v_6, 5: I32
    %v_8 = add 35, %v_7: I32
    %v_9 = call_complex nested, 6: I32
    %v_10 = imul %v_9, 7: I32
    %v_11 = add %v_8, %v_10: I32
    %v_12 = add %v_11, 769: I32
    %v_13 = imul %v_12, 1000: I32
    %v_14 = loads @trace, 4: I32
    %v_15 = imul %v_14, 10: I32
    %v_16 = add %v_13, %v_15: I32
    %v_17 = loads @live, 4: I32
    %v_18 = add %v_16, %v_17: I32
    ret %v_18
  }
}

