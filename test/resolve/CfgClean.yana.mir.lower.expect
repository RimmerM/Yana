    %v_15 = call_complex steps, 3, %v_13: I32
    %v_16 = loads %v_11, 4: I32
    %v_17 = imul %v_16, 5: I32
    %v_18 = add %v_10, %v_17: I32
    %v_19 = alloca 4, 4: Ptr
