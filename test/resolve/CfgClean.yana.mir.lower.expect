  }
}

nested.cont<complex>(%nested.cont.env: Ptr, %$handed: I32): I32 {
  b_0 {
    %v_1 = load %nested.cont.env, 8: Ptr
    %v_2 = cmp_igt %$handed, 4: I32
    je %v_2, b_3, b_4
  }

  b_4 {
    %v_5 = loads %v_1, 4: I32
    %v_6 = imul %v_5, 10: I32
    %v_7 = add %v_6, %$handed: I32
    store %v_1, %v_7, 4
    ret 0
  }

  b_3 {
    ret 2
  }
}

