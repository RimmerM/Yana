mut @live = [0, 0, 0, 0]
mut @trace = [0, 0, 0, 0]

Held.drop<complex>(%v_0: I32) {
  b_1 {
    %v_2 = loads @live, 4: I32
    %v_3 = sub %v_2, 1: I32
    store @live, %v_3, 4
    %v_4 = loads @trace, 4: I32
    %v_5 = imul %v_4, 10: I32
    %v_6 = add %v_5, %v_0: I32
    store @trace, %v_6, 4
    ret 
  }
}

nested<complex>(%n: I32): I32 {
  b_0 {
    %v_1 = loads @live, 4: I32
    %v_2 = add %v_1, 1: I32
    store @live, %v_2, 4
    jmp b_3
  }

  b_3 {
    %v_4 = phi [b_0, 0], [b_5, %v_6]: I32
    %v_7 = phi [b_0, 0], [b_5, %v_8]: I32
    %v_9 = cmp_ilt %v_4, %n: I32
    je %v_9, b_10, b_11
  }

  b_10 {
    %v_12 = cmp_igt %v_4, 2: I32
    je %v_12, b_13, b_5
  }

  b_13 {
    call_complex Held.drop, %n
    %v_14 = cmp_igt %n, 4: I32
    je %v_14, b_15, b_16
  }

  b_11 {
    %v_17 = phi [b_3, 1], [b_15, 0]: I32
    %v_18 = phi [b_3, %v_7], [b_15, %v_19]: I32
    je %v_17, b_20, b_21
  }

  b_20 {
    call_complex Held.drop, %n
    jmp b_21
  }

  b_21 {
    ret %v_18
  }

  b_5 {
    %v_22 = imul %v_7, 10: I32
    %v_8 = add %v_22, %v_4: I32
    %v_6 = add %v_4, 1: I32
    jmp b_3
  }

  b_15 {
    %v_19 = phi [b_13, %v_7], [b_16, %v_23]: I32
    jmp b_11
  }

  b_16 {
    %v_24 = imul %v_7, 10: I32
    %v_23 = add %v_24, %n: I32
    jmp b_15
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    %v_2 = alloca 4, 4: Ptr
    %v_3 = loads @live, 4: I32
    %v_4 = add %v_3, 1: I32
    store @live, %v_4, 4
    call_complex Held.drop, 0
    %v_5 = call_complex nested, 3: I32
    %v_6 = imul %v_5, 5: I32
    %v_7 = add 35, %v_6: I32
    %v_8 = call_complex nested, 6: I32
    %v_9 = imul %v_8, 7: I32
    %v_10 = add %v_7, %v_9: I32
    %v_11 = add %v_10, 769: I32
    %v_12 = imul %v_11, 1000: I32
    %v_13 = loads @trace, 4: I32
    %v_14 = imul %v_13, 10: I32
    %v_15 = add %v_12, %v_14: I32
    %v_16 = loads @live, 4: I32
    %v_17 = add %v_15, %v_16: I32
    ret %v_17
  }
}

