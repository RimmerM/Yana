mut @live = [0, 0, 0, 0]
mut @trace = [0, 0, 0, 0]

Held.drop<complex>(%self: Ptr) {
  b_0 {
    %v_1 = load %self, 4: I32
    %v_2 = loads @live, 4: I32
    %v_3 = sub %v_2, 1: I32
    store @live, %v_3, 4
    %v_4 = loads @trace, 4: I32
    %v_5 = imul %v_4, 10: I32
    %v_6 = add %v_5, %v_1: I32
    store @trace, %v_6, 4
    ret 
  }
}

steps<complex>(%n: I32, %$body: Ptr): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    %v_2 = loads @live, 4: I32
    %v_3 = add %v_2, 1: I32
    store @live, %v_3, 4
    store %v_1, %n, 4
    %v_4 = imm 1: I32
    jmp b_5
  }

  b_5 {
    %v_6 = phi [b_0, 0], [b_7, %v_8]: I32
    %v_9 = phi [b_0, 0], [b_7, %v_10]: I32
    %v_11 = cmp_ilt %v_9, %n: I32
    je %v_11, b_12, b_13
  }

  b_13 {
    %v_14 = phi [b_5, %v_6], [b_15, %v_16], [b_17, %v_18], [b_19, %v_20]: I32
    %v_21 = phi [b_5, %v_4], [b_15, 0], [b_17, 0], [b_19, 0]: I32
    je %v_21, b_22, b_23
  }

  b_12 {
    %v_24 = cmp_igt %v_9, 2: I32
    je %v_24, b_25, b_26
  }

  b_26 {
    %v_27 = cmp_eq %v_6, 0: I32
    je %v_27, b_28, b_29
  }

  b_25 {
    %v_30 = cmp_eq %v_6, 0: I32
    je %v_30, b_31, b_32
  }

  b_31 {
    %v_33 = alloca 4, 4: Ptr
    copy %v_33, %v_1, 4
    %v_34 = loads %v_33, 4: I32
    call_complex Held.drop, %v_33
    %v_35 = load %$body, 8: Ptr
    %v_36 = add %$body, 8: Ptr
    %v_37 = load %v_36, 8: Ptr
    %v_20 = call_complex %v_35, %v_37, %v_34: I32
    %v_38 = cmp_eq %v_20, 0: I32
    je %v_38, b_19, b_17
  }

  b_32 {
    call_complex Held.drop, %v_1
    jmp b_17
  }

  b_19 {
    jmp b_13
  }

  b_17 {
    %v_18 = phi [b_32, %v_6], [b_31, %v_20]: I32
    jmp b_13
  }

  b_28 {
    %v_39 = load %$body, 8: Ptr
    %v_40 = add %$body, 8: Ptr
    %v_41 = load %v_40, 8: Ptr
    %v_8 = call_complex %v_39, %v_41, %v_9: I32
    %v_42 = cmp_eq %v_8, 0: I32
    je %v_42, b_7, b_43
  }

  b_29 {
    call_complex Held.drop, %v_1
    jmp b_43
  }

  b_7 {
    %v_10 = add %v_9, 1: I32
    jmp b_5
  }

  b_43 {
    %v_16 = phi [b_29, %v_6], [b_28, %v_8]: I32
    %v_44 = phi [b_29, 0], [b_28, %v_4]: I32
    je %v_44, b_45, b_15
  }

  b_22 {
    call_complex Held.drop, %v_1
    jmp b_23
  }

  b_23 {
    ret %v_14
  }

  b_45 {
    call_complex Held.drop, %v_1
    jmp b_15
  }

  b_15 {
    jmp b_13
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    %v_2 = alloca 4, 4: Ptr
    %v_3 = alloca 4, 4: Ptr
    store %v_3, 0, 4
    %v_4 = alloca 8, 8: Ptr
    store %v_4, %v_3, 8
    %v_5 = alloca 16, 8: Ptr
    store %v_5, nested.cont, 8
    %v_6 = add %v_5, 8: Ptr
    store %v_6, %v_4, 8
    %v_7 = call_complex steps, 0, %v_5: I32
    %v_8 = loads %v_3, 4: I32
    %v_9 = imul %v_8, 3: I32
    %v_10 = add 35, %v_9: I32
    %v_11 = alloca 4, 4: Ptr
    store %v_11, 0, 4
    %v_12 = alloca 8, 8: Ptr
    store %v_12, %v_11, 8
    %v_13 = alloca 16, 8: Ptr
