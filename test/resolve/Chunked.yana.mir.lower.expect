  b_5 {
    %v_6 = add %size, 8: I64
    jmp b_7
  }

  b_4 {
    call_complex initHeap
    %v_8 = load @heapFree, 8: Ptr
    %v_9 = bitcast %v_8: I64
    %v_10 = cmp_eq %v_9, 0: I32
    je %v_10, b_11, b_5
  }

  b_11 {
    %v_12 = bitcast 0: Ptr
    ret %v_12
  }

  b_13 {
    %v_14 = load @heapFree, 8: Ptr
    %v_15 = shl %v_16, 3: I64
    %v_17 = add %v_14, %v_15: Ptr
    %v_18 = load %v_17, 8: Ptr
    %v_19 = bitcast %v_18: I64
    %v_20 = cmp_eq %v_19, 0: I32
    je %v_20, b_21, b_22
  }

  b_21 {
    %v_23 = shl 16, %v_16: I64
    %v_24 = load @heapNext, 8: Ptr
    %v_25 = add %v_24, %v_23: Ptr
    %v_26 = load @heapLimit, 8: Ptr
    %v_27 = cmp_gt %v_25, %v_26: I32
    je %v_27, b_28, b_29
  }

  b_22 {
    %v_30 = load %v_18, 8: Ptr
    store %v_17, %v_30, 8
    ret %v_18
  }

  b_29 {
    %v_31 = load @heapNext, 8: Ptr
    %v_32 = add %v_31, %v_23: Ptr
    store @heapNext, %v_32, 8
    store %v_31, %v_16, 8
    %v_33 = add %v_31, 8: Ptr
    ret %v_33
  }

  b_28 {
    %v_34 = call_complex growHeap, %v_23: I32
    je %v_34, b_29, b_11
  }

  b_7 {
    %v_35 = phi [b_5, 16], [b_36, %v_37]: I64
    %v_16 = phi [b_5, 0], [b_36, %v_38]: I64
    %v_39 = cmp_ilt %v_35, %v_6: I32
    je %v_39, b_36, b_40
  }

  b_40 {
    %v_41 = cmp_ige %v_16, 32: I32
    je %v_41, b_11, b_13
  }

  b_36 {
    %v_37 = add %v_35, %v_35: I64
    %v_38 = add %v_16, 1: I64
    jmp b_7
  }
}

freeHeap<complex>(%allocation: Ptr) {
  b_0 {
    %v_1 = bitcast %allocation: I64
    %v_2 = cmp_eq %v_1, 0: I32
    je %v_2, b_3, b_4
  }

  b_4 {
    %v_5 = sub %allocation, 8: Ptr
    %v_6 = loads %v_5, 8: I64
    %v_7 = load @heapFree, 8: Ptr
    %v_8 = shl %v_6, 3: I64
    %v_9 = add %v_7, %v_8: Ptr
    %v_10 = load %v_9, 8: Ptr
    store %allocation, %v_10, 8
    store %v_9, %allocation, 8
    ret 
  }

  b_3 {
    ret 
  }
}

