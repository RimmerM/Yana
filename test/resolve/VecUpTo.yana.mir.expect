  %3: %U8 = read copy.trivial (page)
  %4: Size = const 4096
  %5: Size = metric stride U8
  %6: Size = mul inspect %4 inspect %5
  %7: %U8 [owned here shape6 .*=shared slot 0] = add inspect %3 inspect %6
  %8: Size = const 4096
  %9: Size = call protectNone borrow.shared %7 borrow.shared %8
  %10: %U8 = read copy.trivial (page)
  return take %10
}

