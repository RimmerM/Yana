mut @live = [0, 0, 0, 0]

main<complex>(): I32 {
  b_0 {
    jmp b_1
  }

  b_2 {
    %v_3 = cmp_ilt %v_4, 4: I32
    je %v_3, b_1, b_5
  }

  b_5 {
    %v_6 = imul %v_7, 1000: I32
    %v_8 = loads @live, 4: I32
    %v_9 = add %v_6, %v_8: I32
    ret %v_9
  }

  b_1 {
    %v_10 = phi [b_2, %v_7], [b_0, 0]: I32
    %v_11 = phi [b_2, %v_4], [b_0, 1]: I32
    %v_12 = loads @live, 4: I32
    %v_13 = add %v_12, 1: I32
    store @live, %v_13, 4
    %v_14 = shl %v_11, 1: I32
    %v_15 = imul %v_11, 3: I32
    %v_16 = add %v_11, %v_14: I32
    %v_17 = add %v_16, %v_15: I32
    %v_18 = sub %v_13, 1: I32
    store @live, %v_18, 4
    %v_7 = add %v_10, %v_17: I32
    %v_4 = add %v_11, 1: I32
    jmp b_2
  }
}

