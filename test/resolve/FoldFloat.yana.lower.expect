@image$base = []

notANumber<complex>(): F64 {
  b_0 {
    %v_1 = div 0, 0: F64
    ret %v_1
  }
}

infinite<complex>(): F64 {
  b_0 {
    %v_1 = div 1, 0: F64
    ret %v_1
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = call_complex notANumber: F64
    %v_2 = ftoi %v_1: I32
    %v_3 = cmp_eq %v_2, 0: I32
    je %v_3, b_4, b_5
  }

  b_5 {
    jmp b_6
  }

  b_4 {
    %v_7 = call_complex infinite: F64
    %v_8 = ftoi %v_7: I32
    %v_9 = cmp_eq %v_8, 2147483647: I32
    jmp b_6
  }

  b_6 {
    %v_10 = phi [b_4, %v_9], [b_5, 0]: I32
    %v_11 = select %v_10, 50, 0: I32
    %v_12 = add %v_11, 100: I32
    %v_13 = div 1, 0: F64
    %v_14 = cmp_gt %v_13, 1000000: I32
    %v_15 = select %v_14, 20, 0: I32
    %v_16 = add %v_12, %v_15: I32
    ret %v_16
  }
}

