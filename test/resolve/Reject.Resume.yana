-- The resume channel's consumer end written where there is nothing to resume.
--
-- # resolver: ownership
--
-- `test/resolve/lens/Resume.yana` is the channel built. This file was the shipping stage refusing
-- both ends by name; since J135 it is the new stage's, where the declaration below is accepted -
-- `-> (Int <- Int)` is the resume channel, built - and `continue s` in a `while` is refused by the
-- rule rather than as something missing: a `while` has no traversal to send a value to.

iter fn walk(n: Int) -> (Int <- Int):
    yield n

fn consumer(n: Int) -> Int:
    let &s = 0 :: Int

    while s < n:
        s = s + 1
        continue s

    return s

fn main() -> Int = 0
