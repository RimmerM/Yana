
classify<complex>(%n: I32): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    store %v_1, %n, 4
    %v_2 = loads %v_1, 4: I32
    %v_3 = cmp_eq %v_2, 1: I32
    je %v_3, b_4, b_5
  }

  b_5 {
    %v_6 = loads %v_1, 4: I32
    %v_7 = cmp_eq %v_6, 2: I32
    je %v_7, b_8, b_9
  }

  b_9 {
    %v_10 = loads %v_1, 4: I32
    %v_11 = cmp_eq %v_10, 3: I32
    je %v_11, b_12, b_13
  }

  b_13 {
    jmp b_14
  }

  b_14 {
    %v_15 = phi [b_13, 3], [b_4, 0], [b_8, 1], [b_12, 2]: I32
    ret %v_15
  }

  b_4 {
    jmp b_14
  }

  b_8 {
    jmp b_14
  }

  b_12 {
    jmp b_14
  }
}

