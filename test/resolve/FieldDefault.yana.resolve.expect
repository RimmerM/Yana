let image$base: () = <none>

fn bit(%b: Bool) -> I32 {
  b0:
    je %b, b1, b2

  b1:
    ret 1

  b2:
    jmp b3

  b3:
    ret 0
}

fn flags() -> I32 {
  b0:
    %all = alloc : Flags
    init %local0@Flags.read, True
    init %local0@Flags.write, False
    init %local0@Flags.level, 7
    %v7 = load %local0@Flags.read : Bool
    %v8 = call bit, %v7 : I32
    %v11 = cmp_ne %v8, 1 : Bool
    je %v11, b1, b2

  b1:
    ret -1

  b2:
    jmp b3

  b3:
    %v16 = load %local0@Flags.write : Bool
    %v17 = call bit, %v16 : I32
    %v20 = cmp_ne %v17, 0 : Bool
    je %v20, b4, b5

  b4:
    ret -2

  b5:
    jmp b6

  b6:
    %v25 = load %local0@Flags.level : I32
    %v28 = cmp_ne %v25, 7 : Bool
    je %v28, b7, b8

  b7:
    ret -3

  b8:
    jmp b9

  b9:
    %some = alloc : Flags
    init %local1@Flags.read, True
    init %local1@Flags.write, True
    init %local1@Flags.level, 3
    %v40 = load %local1@Flags.read : Bool
    %v41 = call bit, %v40 : I32
    %v44 = cmp_ne %v41, 1 : Bool
    je %v44, b10, b11

  b10:
    ret -4

  b11:
    jmp b12

  b12:
    %v49 = load %local1@Flags.write : Bool
    %v50 = call bit, %v49 : I32
    %v53 = cmp_ne %v50, 1 : Bool
    je %v53, b13, b14

  b13:
    ret -5

  b14:
    jmp b15

  b15:
    %v58 = load %local1@Flags.level : I32
    %v61 = cmp_ne %v58, 3 : Bool
    je %v61, b16, b17

  b16:
    ret -6

  b17:
    jmp b18

  b18:
    %none = alloc : Flags
    init %local2@Flags.read, False
    init %local2@Flags.write, True
    init %local2@Flags.level, 9
    %v73 = load %local2@Flags.read : Bool
    %v74 = call bit, %v73 : I32
    %v77 = cmp_ne %v74, 0 : Bool
    je %v77, b19, b20

  b19:
    ret -7

  b20:
    jmp b21

  b21:
    %v82 = load %local2@Flags.write : Bool
    %v83 = call bit, %v82 : I32
    %v86 = cmp_ne %v83, 1 : Bool
    je %v86, b22, b23

  b22:
    ret -8

  b23:
    jmp b24

  b24:
    %v91 = load %local2@Flags.level : I32
    %v94 = cmp_ne %v91, 9 : Bool
    je %v94, b25, b26

  b25:
    ret -9

  b26:
    jmp b27

  b27:
    %v99 = load %local1@Flags.level : I32
    %v102 = mul %v99, 10 : I32
    %v103 = load %local0@Flags.level : I32
    %v104 = add %v102, %v103 : I32
    ret %v104
}

fn windows() -> I32 {
  b0:
    %plain = alloc : Window
    aggregate %local0@Window.title = 1, %local0@Window.width = 80, %local0@Window.height = 24
    %v5 = load %local0@Window.width : I32
    %v8 = cmp_ne %v5, 80 : Bool
    je %v8, b1, b2

  b1:
    ret -10

  b2:
    jmp b3

  b3:
    %v13 = load %local0@Window.height : I32
    %v16 = cmp_ne %v13, 24 : Bool
    je %v16, b4, b5

  b4:
    ret -11

  b5:
    jmp b6

  b6:
    %tall = alloc : Window
    aggregate %local1@Window.title = 2, %local1@Window.width = 80, %local1@Window.height = 50
    %v26 = load %local1@Window.width : I32
    %v29 = cmp_ne %v26, 80 : Bool
    je %v29, b7, b8

  b7:
    ret -12

  b8:
    jmp b9

  b9:
    %v34 = load %local1@Window.height : I32
    %v37 = cmp_ne %v34, 50 : Bool
    je %v37, b10, b11

  b10:
    ret -13

  b11:
    jmp b12

  b12:
    %v42 = load %local0@Window.title : I32
    %v45 = mul %v42, 100 : I32
    %v46 = load %local1@Window.height : I32
    %v47 = add %v45, %v46 : I32
    ret %v47
}

fn value(%r: Report) -> I32 {
  b0:
    %v1 = load %r.discriminant : I32
    %v3 = cmp_eq %v1, 0 : Bool
    je %v3, b2, b1

  b1:
    %v6 = load %r.discriminant : I32
    %v8 = cmp_eq %v6, 1 : Bool
    je %v8, b4, b3

  b2:
    jmp b5

  b3:
    %v12 = load %r@Fail : {code: I32}
    %c = load %r@Fail.code : I32
    %v16 = mul %c, 10 : I32
    jmp b5

  b4:
    %v10 = load %r@Warn : {code: I32}
    %c = load %r@Warn.code : I32
    jmp b5

  b5:
    %v20 = phi [b2, -100], [b4, %c], [b3, %v16] : I32
    ret %v20
}

fn reports() -> I32 {
  b0:
    %v0 = alloc : Report
    aggregate %local0.discriminant = 1, %local0@Warn.code = 1
    %v4 = call value, %v0 : I32
    %v5 = alloc : Report
    aggregate %local1.discriminant = 2, %local1@Fail.code = 9
    %v9 = call value, %v5 : I32
    %v10 = add %v4, %v9 : I32
    ret %v10
}

fn main() -> I32 {
  b0:
    %v0 = call flags : I32
    %v1 = call windows : I32
    %v2 = add %v0, %v1 : I32
    %v3 = call reports : I32
    %v4 = add %v2, %v3 : I32
    ret %v4
}
