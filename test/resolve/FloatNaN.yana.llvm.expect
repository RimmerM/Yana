target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

@"image$base" = constant [0 x i8] zeroinitializer, align 8
@zero = global [4 x i8] zeroinitializer, align 8
@one = global [4 x i8] c"\00\00\80?", align 8

define fastcc i32 @main() {
  br label %1

1:                                                ; preds = %0
  %2 = load float, ptr @zero, align 1
  %3 = fdiv float %2, %2
  %v = load float, ptr @one, align 1
  %4 = fcmp olt float %3, %v
  %5 = zext i1 %4 to i32
  br i1 %4, label %6, label %7

6:                                                ; preds = %1
  br label %8

7:                                                ; preds = %1
  br label %8

8:                                                ; preds = %6, %7
  %9 = phi i32 [ 1, %6 ], [ 0, %7 ]
  %10 = fcmp ole float %3, %v
  %11 = zext i1 %10 to i32
  br i1 %10, label %12, label %14

12:                                               ; preds = %8
  %13 = add i32 %9, 2
  br label %15

14:                                               ; preds = %8
  br label %15

15:                                               ; preds = %12, %14
  %16 = phi i32 [ %13, %12 ], [ %9, %14 ]
  %17 = fcmp ogt float %3, %v
  %18 = zext i1 %17 to i32
  br i1 %17, label %19, label %21

19:                                               ; preds = %15
  %20 = add i32 %16, 4
  br label %22

21:                                               ; preds = %15
  br label %22

22:                                               ; preds = %19, %21
  %23 = phi i32 [ %20, %19 ], [ %16, %21 ]
  %24 = fcmp oge float %3, %v
  %25 = zext i1 %24 to i32
  br i1 %24, label %26, label %28

26:                                               ; preds = %22
  %27 = add i32 %23, 8
  br label %29

28:                                               ; preds = %22
  br label %29

29:                                               ; preds = %26, %28
  %30 = phi i32 [ %27, %26 ], [ %23, %28 ]
  %31 = fcmp oeq float %3, %v
  %32 = zext i1 %31 to i32
  br i1 %31, label %33, label %35

33:                                               ; preds = %29
  %34 = add i32 %30, 16
  br label %36

35:                                               ; preds = %29
  br label %36

36:                                               ; preds = %33, %35
  %37 = phi i32 [ %34, %33 ], [ %30, %35 ]
  %38 = fcmp une float %3, %v
  %39 = zext i1 %38 to i32
  br i1 %38, label %40, label %42

40:                                               ; preds = %36
  %41 = add i32 %37, 32
  br label %43

42:                                               ; preds = %36
  br label %43

43:                                               ; preds = %40, %42
  %44 = phi i32 [ %41, %40 ], [ %37, %42 ]
  %45 = fcmp oeq float %3, %3
  %46 = zext i1 %45 to i32
  br i1 %45, label %47, label %49

47:                                               ; preds = %43
  %48 = add i32 %44, 64
  br label %50

49:                                               ; preds = %43
  br label %50

50:                                               ; preds = %47, %49
  %51 = phi i32 [ %48, %47 ], [ %44, %49 ]
  %52 = fcmp une float %3, %3
  %53 = zext i1 %52 to i32
  br i1 %52, label %54, label %56

54:                                               ; preds = %50
  %55 = add i32 %51, 128
  br label %57

56:                                               ; preds = %50
  br label %57

57:                                               ; preds = %54, %56
  %58 = phi i32 [ %55, %54 ], [ %51, %56 ]
  %59 = fcmp ogt float %v, %2
  %60 = zext i1 %59 to i32
  br i1 %59, label %61, label %63

61:                                               ; preds = %57
  %62 = add i32 %58, 256
  br label %64

63:                                               ; preds = %57
  br label %64

64:                                               ; preds = %61, %63
  %65 = phi i32 [ %62, %61 ], [ %58, %63 ]
  %66 = fcmp olt float %2, %v
  %67 = zext i1 %66 to i32
  br i1 %66, label %68, label %70

68:                                               ; preds = %64
  %69 = add i32 %65, 512
  br label %71

70:                                               ; preds = %64
  br label %71

71:                                               ; preds = %68, %70
  %72 = phi i32 [ %69, %68 ], [ %65, %70 ]
  %73 = fcmp oeq float %v, %v
  %74 = zext i1 %73 to i32
  br i1 %73, label %75, label %77

75:                                               ; preds = %71
  %76 = add i32 %72, 1024
  br label %78

77:                                               ; preds = %71
  br label %78

78:                                               ; preds = %75, %77
  %79 = phi i32 [ %76, %75 ], [ %72, %77 ]
  %80 = fcmp une float %v, %2
  %81 = zext i1 %80 to i32
  br i1 %80, label %82, label %84

82:                                               ; preds = %78
  %83 = add i32 %79, 2048
  br label %85

84:                                               ; preds = %78
  br label %85

85:                                               ; preds = %82, %84
  %86 = phi i32 [ %83, %82 ], [ %79, %84 ]
  ret i32 %86
}
