module ResolveTest

data Tracked {value: I32}

data Point {x: I32, y: I32}

data Quad {values: [I32 *4], places: [Point *2], tag: I32}

instance Copy(Tracked): Tracked.copy

let & copyCalls: I32 = 0

fn Tracked.copy(from: Tracked [shared call]) -> Tracked {
bb0:
  %0: I32 = read copy.trivial (global copyCalls)
  %1: I32 = const 1
  %2: I32 = add inspect %0 inspect %1
  write.assign borrow.unique (global copyCalls) take %2
  %4: I32 = read copy.trivial (from.value)
  %5: Tracked = aggregate.Tracked take %4
  return take %5
}

fn copyInto(slot: a [unique call], from: a [shared call]) -> {} {
  form specialized
  slot #0 type a
  slot #1 class TrivialCopy(a)
bb0:
  %0: a = read copy.trivial (from)
  write.assign borrow.unique (slot) take %0
  return
}

