fn budget(op: Op [shared call]) -> I32 {
bb0:
  %0: U8 = read copy.trivial (op.#)
  %1: I32 = map [0 -> 5, 1 -> 5, 2 -> 5, 3 -> 5, 4 -> 5, 5 -> 5] inspect %0
