@image$base = []
mut @started = [0, 0, 0, 0]
mut @tally = [0, 0, 0, 0]

main<complex>() {
  b_0 {
    %v_1 = loads @tally, 4: I32
    %v_2 = loads @started, 4: I32
    %v_3 = add %v_1, %v_2: I32
    store @tally, %v_3, 4
    ret 
  }
}

main$<complex>() {
  b_0 {
    store @started, 42, 4
    call_complex main
    ret 
  }
}

