
Metres.size<complex>(%value: Ptr): I32 {
  b_0 {
    %v_1 = loads %value, 4: I32
    ret %v_1
  }
}

Metres.doubled<complex>(%v_0: Ptr, %value: Ptr) {
  b_1 {
    %v_2 = loads %value, 4: I32
    %v_3 = imul %v_2, 2: I32
    %v_4 = alloca 4, 4: Ptr
    store %v_4, %v_3, 4
    copy %v_0, %v_4, 4
    ret 
  }
}

Feet.size<complex>(%value: Ptr): I32 {
  b_0 {
    %v_1 = loads %value, 4: I32
    ret %v_1
  }
}

metreSize<complex>(): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    store %v_1, 7, 4
    %v_2 = call_complex Metres.size, %v_1: I32
    ret %v_2
  }
}

feetSize<complex>(): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    store %v_1, 5, 4
    %v_2 = call_complex Feet.size, %v_1: I32
    ret %v_2
  }
}

doubledMetres<complex>(): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    store %v_1, 3, 4
    %v_2 = alloca 4, 4: Ptr
    call_complex Metres.doubled, %v_2, %v_1
    %v_3 = call_complex Metres.size, %v_2: I32
    ret %v_3
  }
}

Metres.==<complex>(%lhs: Ptr, %rhs: Ptr): I32 {
  b_0 {
    %v_1 = loads %lhs, 4: I32
    %v_2 = loads %rhs, 4: I32
    %v_3 = cmp_eq %v_1, %v_2: I32
    ret %v_3
  }
}

sameMetres<complex>(%a: I32, %b: I32): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    %v_2 = alloca 4, 4: Ptr
    store %v_1, %a, 4
    store %v_2, %b, 4
    %v_3 = loads %v_1, 4: I32
    %v_4 = alloca 4, 4: Ptr
    store %v_4, %v_3, 4
    %v_5 = loads %v_2, 4: I32
    %v_6 = alloca 4, 4: Ptr
    store %v_6, %v_5, 4
    %v_7 = call_complex Metres.==, %v_4, %v_6: I32
    je %v_7, b_8, b_9
  }

  b_9 {
    jmp b_10
  }

  b_10 {
    %v_11 = phi [b_9, 0], [b_8, 1]: I32
    ret %v_11
  }

  b_8 {
    jmp b_10
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = call_complex metreSize: I32
    %v_2 = call_complex feetSize: I32
    %v_3 = add %v_1, %v_2: I32
    %v_4 = call_complex doubledMetres: I32
    %v_5 = add %v_3, %v_4: I32
    %v_6 = call_complex sameMetres, 4, 4: I32
    %v_7 = add %v_5, %v_6: I32
    %v_8 = call_complex sameMetres, 4, 5: I32
    %v_9 = add %v_7, %v_8: I32
    ret %v_9
  }
}

