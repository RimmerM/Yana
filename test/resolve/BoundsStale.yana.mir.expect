  %37: Size = call length(Array(I32)) borrow.shared %36
  %38: Bool = lt inspect %35 inspect %37
  write.assign borrow.unique (prev) take %38
  %40: Size [unique call] = read borrow.unique (i) loan6
  %41: Size = const 1
  %42: {} = call +=(Size) borrow.unique %40 borrow.shared %41
  jump -> bb1

bb6:
  %20: Size = read copy.trivial (v)
  %21: Array(I32) [shared call view] = read borrow.shared (xs) loan2
  %22: Size = call length(Array(I32)) borrow.shared %21
