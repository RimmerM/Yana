}

fn indices() -> Int {
  b0:
    %v1 = vsplat 0 : Vec(Int)
    %v3 = vwithlane %v1, 1, 1 : Vec(Int)
    %v5 = vwithlane %v3, 2, 2 : Vec(Int)
    %v = vwithlane %v5, 3, 3 : Vec(Int)
    %v10 = vlane %v, 0 : Int
    %v13 = cmp_ne %v10, 0 : Bool
    je %v13, b1, b2

  b1:
    %v17 = neg 1 : Int
    ret %v17

  b2:
    jmp b3

  b3:
    %v22 = vlane %v, 1 : Int
    %v25 = cmp_ne %v22, 1 : Bool
    je %v25, b4, b5

  b4:
    %v29 = neg 2 : Int
    ret %v29

  b5:
    jmp b6

  b6:
    %r = vshuffle %v, %v, 3, 2, 1, 0 : Vec(Int)
    %v35 = vlane %r, 0 : Int
    %v39 = sub 4, 1 : Int
    %v40 = cmp_ne %v35, %v39 : Bool
    je %v40, b7, b8

  b7:
    %v44 = neg 3 : Int
    ret %v44

  b8:
    jmp b9

  b9:
    ret 0
