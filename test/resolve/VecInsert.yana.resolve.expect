let image$base: () = <none>

fn integers() -> Int {
  b0:
    %v = vsplat 5 : Vec(Int)
    %a = vwithlane %v, 9, 1 : Vec(Int)
    %b = vwithlane %a, 7, 0 : Vec(Int)
    %v15 = vlane %b, 0 : Int
    %v18 = mul %v15, 1000 : Int
    %v21 = vlane %b, 1 : Int
    %v24 = mul %v21, 100 : Int
    %v25 = add %v18, %v24 : Int
    %v28 = vlane %v, 0 : Int
    %v31 = mul %v28, 10 : Int
    %v32 = add %v25, %v31 : Int
    %v35 = vlane %v, 1 : Int
    %v36 = add %v32, %v35 : Int
    ret %v36
