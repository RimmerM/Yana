fn floats() -> Int {
  b0:
    %f = vsplat 1.5 : Vec(Float)
    %v6 = neg 0 : Float
    %g = vwithlane %f, %v6, 0 : Vec(Float)
    %v11 = vlane %g, 1 : Float
    %v14 = cmp_ne %v11, 1.5 : Bool
    je %v14, b1, b2

  b1:
    ret -1

  b2:
    jmp b3

  b3:
    %v22 = vlane %g, 0 : Float
    %v24 = div 1, %v22 : Float
    %v27 = cmp_gt %v24, 0 : Bool
    je %v27, b4, b5

  b4:
    ret -2

  b5:
    jmp b6

  b6:
    %d = vsplat 1.5 : Vec(Double)
    %e = vwithlane %d, 4.25, 1 : Vec(Double)
    %v41 = vlane %e, 0 : Double
    %v44 = cmp_ne %v41, 1.5 : Bool
    je %v44, b7, b8

  b7:
    ret -3

  b8:
    jmp b9

  b9:
    %v51 = vlane %e, 1 : Double
    %v54 = cmp_ne %v51, 4.25 : Bool
    je %v54, b10, b11

  b10:
    ret -4

  b11:
    jmp b12

  b12:
    ret 0
