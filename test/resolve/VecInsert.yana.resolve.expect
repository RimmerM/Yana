fn floats() -> Int {
  b0:
    %f = vsplat 1.5 : Vec(Float)
    %v6 = neg 0 : Float
    %g = vwithlane %f, %v6, 0 : Vec(Float)
    %v11 = vlane %g, 1 : Float
    %v14 = cmp_ne %v11, 1.5 : Bool
    je %v14, b1, b2

  b1:
    %v18 = neg 1 : Int
    ret %v18

  b2:
    jmp b3

  b3:
    %v24 = vlane %g, 0 : Float
    %v26 = div 1, %v24 : Float
    %v29 = cmp_gt %v26, 0 : Bool
    je %v29, b4, b5

  b4:
    %v33 = neg 2 : Int
    ret %v33

  b5:
    jmp b6

  b6:
    %d = vsplat 1.5 : Vec(Double)
    %e = vwithlane %d, 4.25, 1 : Vec(Double)
    %v45 = vlane %e, 0 : Double
    %v48 = cmp_ne %v45, 1.5 : Bool
    je %v48, b7, b8

  b7:
    %v52 = neg 3 : Int
    ret %v52

  b8:
    jmp b9

  b9:
    %v57 = vlane %e, 1 : Double
    %v60 = cmp_ne %v57, 4.25 : Bool
    je %v60, b10, b11

  b10:
    %v64 = neg 4 : Int
    ret %v64

  b11:
    jmp b12

  b12:
