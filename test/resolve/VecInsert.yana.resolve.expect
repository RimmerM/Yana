fn main() -> Int {
  b0:
    %v0 = call floats : Int
    %v3 = cmp_ne %v0, 0 : Bool
    je %v3, b1, b2

  b1:
    %v5 = call floats : Int
    %v8 = mul %v5, 10 : Int
    ret %v8

  b2:
    jmp b3

  b3:
    %v11 = call indices : Int
    %v14 = cmp_ne %v11, 0 : Bool
    je %v14, b4, b5

  b4:
    %v16 = call indices : Int
    %v19 = mul %v16, 100 : Int
