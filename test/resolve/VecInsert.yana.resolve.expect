  b5:
    jmp b6

  b6:
    %r = vshuffle %v, %v, 3, 2, 1, 0 : Vec(Int)
    %v31 = vlane %r, 0 : Int
    %v35 = sub 4, 1 : Int
    %v36 = cmp_ne %v31, %v35 : Bool
    je %v36, b7, b8

  b7:
    ret -3

  b8:
    jmp b9

  b9:
    ret 0
