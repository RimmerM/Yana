fn indices() -> Int {
  b0:
    %v1 = vsplat 0 : Vec(Int)
    %v3 = vwithlane %v1, 1, 1 : Vec(Int)
    %v5 = vwithlane %v3, 2, 2 : Vec(Int)
    %v = vwithlane %v5, 3, 3 : Vec(Int)
    %v10 = vlane %v, 0 : Int
    %v13 = cmp_ne %v10, 0 : Bool
    je %v13, b1, b2

