@image$base = []

main<complex>(): I32 {
  b_0 {
    %a = vsplat 1: f32x16
    %b = vsplat 2: f32x16
    %ints = vsplat 7: i32x16
    %others = vsplat 3: i32x16
    %v_1 = cmp_lt %a, %b: m32x16
    %v_2 = select %v_1, %ints, %others: i32x16
    %v_3 = cmp_ilt %others, %ints: m32x16
    %v_4 = select %v_3, %a, %b: f32x16
    %v_5 = vsplat 0: i32x16
    %v_6 = vwithlane %v_5, 1, 1: i32x16
    %v_7 = vwithlane %v_6, 2, 2: i32x16
    %v_8 = vwithlane %v_7, 3, 3: i32x16
    %v_9 = vwithlane %v_8, 4, 4: i32x16
    %v_10 = vwithlane %v_9, 5, 5: i32x16
    %v_11 = vwithlane %v_10, 6, 6: i32x16
    %v_12 = vwithlane %v_11, 7, 7: i32x16
    %v_13 = vwithlane %v_12, 8, 8: i32x16
    %v_14 = vwithlane %v_13, 9, 9: i32x16
    %v_15 = vwithlane %v_14, 10, 10: i32x16
    %v_16 = vwithlane %v_15, 11, 11: i32x16
    %v_17 = vwithlane %v_16, 12, 12: i32x16
    %v_18 = vwithlane %v_17, 13, 13: i32x16
    %v_19 = vwithlane %v_18, 14, 14: i32x16
    %v_20 = vwithlane %v_19, 15, 15: i32x16
    %v_21 = cmp_ilt %v_20, %others: m32x16
    %kept = select %v_21, %v_20, %v_5: i32x16
    %v_22 = vreduce_or %v_21: I32
    je %v_22, b_23, b_24
  }

  b_23 {
    %v_25 = vreduce_add %kept: I32
    %v_26 = imul %v_25, 10: I32
    %v_27 = vreduce_add %v_21: I32
    %v_28 = add %v_26, %v_27: I32
    jmp b_29
  }

  b_24 {
    jmp b_29
  }

  b_29 {
    %counted = phi [b_23, %v_28], [b_24, 18446744073709551615]: I32
    %v_30 = vlane %v_2, 0: I32
    %v_31 = imul %v_30, 100000: I32
    %v_32 = vlane %v_4, 0: F32
    %v_33 = cmp_eq %v_32, 1: I32
    %v_34 = imul %v_33, 10000: I32
    %v_35 = add %v_31, %v_34: I32
    %v_36 = add %v_35, %counted: I32
    ret %v_36
  }
}

