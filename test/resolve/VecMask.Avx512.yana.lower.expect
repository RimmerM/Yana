@image$base = []

main<complex>(): I32 {
  b_0 {
    %a = vsplat 1: f32x8
    %b = vsplat 2: f32x8
    %ints = vsplat 7: i32x8
    %others = vsplat 3: i32x8
    %v_1 = cmp_lt %a, %b: m32x8
    %v_2 = select %v_1, %ints, %others: i32x8
    %v_3 = cmp_ilt %others, %ints: m32x8
    %v_4 = select %v_3, %a, %b: f32x8
    %v_5 = vsplat 0: i32x8
    %v_6 = vwithlane %v_5, 1, 1: i32x8
    %v_7 = vwithlane %v_6, 2, 2: i32x8
    %v_8 = vwithlane %v_7, 3, 3: i32x8
    %v_9 = vwithlane %v_8, 4, 4: i32x8
    %v_10 = vwithlane %v_9, 5, 5: i32x8
    %v_11 = vwithlane %v_10, 6, 6: i32x8
    %v_12 = vwithlane %v_11, 7, 7: i32x8
    %v_13 = cmp_ilt %v_12, %others: m32x8
    %kept = select %v_13, %v_12, %v_5: i32x8
    %v_14 = vreduce_or %v_13: I32
    je %v_14, b_15, b_16
  }

  b_15 {
    %v_17 = vreduce_add %kept: I32
    %v_18 = imul %v_17, 10: I32
    %v_19 = vreduce_add %v_13: I32
    %v_20 = add %v_18, %v_19: I32
    jmp b_21
  }

  b_16 {
    jmp b_21
  }

  b_21 {
    %counted = phi [b_15, %v_20], [b_16, 18446744073709551615]: I32
    %v_22 = vlane %v_2, 0: I32
    %v_23 = imul %v_22, 100000: I32
    %v_24 = vlane %v_4, 0: F32
    %v_25 = cmp_eq %v_24, 1: I32
    %v_26 = imul %v_25, 10000: I32
    %v_27 = add %v_23, %v_26: I32
    %v_28 = add %v_27, %counted: I32
    ret %v_28
  }
}

