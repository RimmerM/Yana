// Generated by the Yana compiler - the ownership pipeline (Analysis-IR-JS.md)
function main() {
  var p0 = 0n;
  var p1 = 10n;
  while (p0 < 4n) {
    p1 = BigInt.asIntN(64, p1 + 1n);
    p0 = BigInt.asIntN(64, p0 + 1n);
  }
  var v13 = BigInt.asIntN(64, p1 + 42n);
  var p2 = 0n;
  var p3 = 0n;
  var p4 = 10n;
  while (p2 < 3n) {
    p3 = BigInt.asIntN(64, p3 + p4);
    p4 = BigInt.asIntN(64, p4 + 1n);
    p2 = BigInt.asIntN(64, p2 + 1n);
