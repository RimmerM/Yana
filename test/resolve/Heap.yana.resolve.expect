fn setFreeListHead(%sizeClass: I64, %block: %U8) -> () {
  b0:
    %v2 = load heapFree : %%U8
    %v4 = mul %sizeClass, 8 : I64
    %v5 = add %v2, %v4 : %%U8
    init [%v5], %block
    ret
