}

fn allocateHeap(%size: Size) -> %U8 {
  b0:
    %v1 = load heapFree : %%U8
    %v2 = bitcast %v1 : Long
    %v4 = cmp_eq %v2, 0 : Bool
    je %v4, b1, b2

  b1:
    call initHeap
    %v7 = load heapFree : %%U8
    %v8 = bitcast %v7 : Long
    %v10 = cmp_eq %v8, 0 : Bool
    je %v10, b3, b4

  b2:
    jmp b6

  b3:
    %v13 = bitcast 0 : %U8
    ret %v13

  b4:
    jmp b5

  b5:
    jmp b6

  b6:
    %v20 = add %size, 8 : Size
    %sizeClass = call heapClassOf, %v20 : Size
    %v23 = cmp_ge %sizeClass, 32 : Bool
    je %v23, b7, b8

  b7:
    %v26 = bitcast 0 : %U8
    ret %v26

  b8:
    jmp b9

  b9:
    %reused = call freeListHead, %sizeClass : %U8
    %v30 = bitcast %reused : Long
    %v32 = cmp_eq %v30, 0 : Bool
    %v34 = xor %v32, True : Bool
    je %v34, b10, b11

  b10:
    %v36 = bitcast %reused : %%U8
    %v37 = load [%v36] : %U8
    call setFreeListHead, %sizeClass, %v37
    ret %reused

  b11:
    jmp b12

  b12:
    %blockSize = call heapBlockSize, %sizeClass : Size
    %v42 = load heapNext : %U8
    %v43 = strideof U8 : Size
    %v44 = mul %blockSize, %v43 : Size
    %v45 = add %v42, %v44 : %U8
    %v46 = load heapLimit : %U8
    %v47 = cmp_gt %v45, %v46 : Bool
    je %v47, b13, b14

  b13:
    %v49 = call growHeap, %blockSize : Bool
    %v51 = xor %v49, True : Bool
    je %v51, b15, b16

  b14:
    jmp b18

  b15:
    %v54 = bitcast 0 : %U8
    ret %v54

  b16:
    jmp b17

  b17:
    jmp b18

  b18:
    %block = load heapNext : %U8
    %v60 = strideof U8 : Size
    %v61 = mul %blockSize, %v60 : Size
    %v62 = add %block, %v61 : %U8
    assign heapNext, %v62
    %v64 = bitcast %block : %Size
    assign [%v64], %sizeClass
    %v68 = strideof U8 : Size
    %v69 = mul 8, %v68 : Size
    %v70 = add %block, %v69 : %U8
    ret %v70
}

fn freeHeap(%allocation: %U8) -> () {
  b0:
    %v1 = bitcast %allocation : Long
    %v3 = cmp_eq %v1, 0 : Bool
    je %v3, b1, b2

  b1:
    ret

  b2:
    jmp b3

  b3:
    %v9 = strideof U8 : Size
    %v10 = mul 8, %v9 : Size
    %v11 = sub %allocation, %v10 : %U8
    %v12 = bitcast %v11 : %Size
    %sizeClass = load [%v12] : Size
    %v14 = bitcast %allocation : %%U8
    %v15 = call freeListHead, %sizeClass : %U8
    assign [%v14], %v15
    call setFreeListHead, %sizeClass, %allocation
    ret
}

fn distinctBlocks() -> I64 {
  b0:
    %first = call allocateHeap, 32 : %U8
    %second = call allocateHeap, 32 : %U8
    %v4 = bitcast %first : Long
    %v6 = cmp_eq %v4, 0 : Bool
    je %v6, b2, b1

  b1:
    %v8 = bitcast %second : Long
    %v10 = cmp_eq %v8, 0 : Bool
    jmp b3

  b2:
    jmp b3

  b3:
    %v14 = phi [b1, %v10], [b2, True] : Bool
    je %v14, b4, b5

  b4:
    ret 0

  b5:
    jmp b6

  b6:
    %v19 = sub %second, %first : Size
    %v20 = strideof U8 : Size
    %v21 = div %v19, %v20 : Size
    %v24 = cmp_lt %v21, 32 : Bool
    je %v24, b7, b8

  b7:
    ret 0

  b8:
    jmp b9

  b9:
