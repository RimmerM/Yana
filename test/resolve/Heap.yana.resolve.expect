let image$base: () = <none>

let &heapNext: %U8 = 0

let &heapLimit: %U8 = 0

let &heapFree: %%U8 = 0

let &heapRegionNext: Size = 0

fn numberOf(%call: Syscall) -> USize {
  b0:
    %v1 = cast %call : I64
    %v2 = cast %v1 : USize
    ret %v2
}

fn mapMemory(%size: Size) -> %U8 {
  b0:
    %anonymous = bitcast -1 : USize
    %v4 = call numberOf, SysMunmap : USize
    %v6 = bitcast %size : USize
    %result = syscall %v4, 0, %v6, 3, 34, %anonymous, 0 : Size
    %v13 = cmp_lt %result, 0 : Bool
    je %v13, b1, b2

  b1:
    %v16 = bitcast 0 : %U8
    ret %v16

  b2:
    jmp b3

  b3:
    %v19 = bitcast %result : %U8
    ret %v19
}

fn initHeap() -> () {
  b0:
    %v2 = add 4194304, 4096 : Size
    %region = call mapMemory, %v2 : %U8
    %v4 = bitcast %region : Long
    %v6 = cmp_eq %v4, 0 : Bool
    je %v6, b1, b2

  b1:
    ret

  b2:
    jmp b3

  b3:
    %table = mul 32, 8 : Size
    setmemory %region, 0, %table
    %v16 = bitcast %region : %%U8
    assign heapFree, %v16
    %v18 = strideof U8 : Size
    %v19 = mul %table, %v18 : Size
    %v20 = add %region, %v19 : %U8
    assign heapNext, %v20
    %v23 = strideof U8 : Size
    %v24 = mul 4194304, %v23 : Size
    %v25 = add %region, %v24 : %U8
    assign heapLimit, %v25
    %v29 = add 4194304, 4194304 : Size
    assign heapRegionNext, %v29
