  b3:
    %v16 = phi [b1, %v12], [b2, True] : Bool
    je %v16, b4, b5

  b4:
    ret 0

  b5:
    jmp b6

  b6:
    assign [%a], 40
    assign [%b], 2
    %v25 = load [%a] : I64
    %v26 = load [%b] : I64
    %v27 = add %v25, %v26 : I64
    ret %v27
}

fn reuseAfterFree() -> I64 {
  b0:
    %first = call allocateHeap, 100 : %U8
    call freeHeap, %first
    %second = call allocateHeap, 100 : %U8
    %v5 = cmp_eq %first, %second : Bool
    je %v5, b1, b2

  b1:
    ret 1

  b2:
    jmp b3

  b3:
