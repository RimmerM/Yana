}

fn writeAndRead() -> I64 {
  b0:
    %v1 = call allocateHeap, 8 : %U8
    %a = bitcast %v1 : %I64
    %v4 = call allocateHeap, 8 : %U8
    %b = bitcast %v4 : %I64
    %v6 = bitcast %a : Long
    %v8 = cmp_eq %v6, 0 : Bool
