fn main() -> Int {
  b0:
    %v0 = call distinctBlocks : I64
    %v3 = mul %v0, 1000 : I64
    %v4 = call writeAndRead : I64
    %v7 = mul %v4, 10 : I64
    %v8 = add %v3, %v7 : I64
    %v9 = call reuseAfterFree : I64
    %v12 = mul %v9, 5 : I64
    %v13 = add %v8, %v12 : I64
