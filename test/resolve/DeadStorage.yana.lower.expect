    %v_12 = loads @live, 4: I32
    %v_13 = imul %v_12, 1000: I32
    %v_14 = add %v_11, %v_13: I32
    %v_15 = loads @trace, 4: I32
    %v_16 = add %v_14, %v_15: I32
