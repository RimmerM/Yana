size<complex>(%s: Ptr): I32 {
  b_0 {
    %v_1 = add %s, 12: Ptr
    %v_2 = load %v_1, 4: I32
    %v_3 = add %s, 8: Ptr
    %v_4 = load %v_3, 4: I64
    %v_5 = shr %v_4, 30: I64
    %v_6 = cast %v_5: I32
    %v_7 = cmp_eq %v_6, 1: I32
