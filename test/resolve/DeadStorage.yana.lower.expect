  b_3 {
    ret 
  }

  b_4 {
    %v_5 = sub %allocation, 8: Ptr
    %sizeClass = loads %v_5, 8: I64
    %v_6 = load @heapFree, 8: Ptr
    %v_7 = shl %sizeClass, 3: I64
    %v_8 = add %v_6, %v_7: Ptr
    %v_9 = load %v_8, 8: Ptr
    store %allocation, %v_9, 8
    %v_10 = load @heapFree, 8: Ptr
    %v_11 = add %v_10, %v_7: Ptr
    store %v_11, %allocation, 8
