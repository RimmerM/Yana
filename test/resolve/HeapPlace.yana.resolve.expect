fn allocateHeap(%size: I64) -> %U8 {
  b0:
    %v1 = load heapFree : %%U8
    %v2 = cast %v1 : Long
    %v4 = cmp_eq %v2, 0 : Bool
    je %v4, b1, b2

  b1:
    call initHeap
    %v7 = load heapFree : %%U8
    %v8 = cast %v7 : Long
    %v10 = cmp_eq %v8, 0 : Bool
    je %v10, b3, b4

  b2:
    jmp b6

  b3:
    %v13 = cast 0 : %U8
    ret %v13

  b4:
    jmp b5

  b5:
    jmp b6

  b6:
    %v20 = add %size, 8 : I64
    %sizeClass = call heapClassOf, %v20 : I64
    %v23 = cmp_ge %sizeClass, 32 : Bool
    je %v23, b7, b8

  b7:
    %v26 = cast 0 : %U8
    ret %v26

  b8:
    jmp b9

  b9:
    %reused = call freeListHead, %sizeClass : %U8
    %v30 = cast %reused : Long
    %v32 = cmp_eq %v30, 0 : Bool
    %v34 = xor %v32, True : Bool
    je %v34, b10, b11

  b10:
    %v36 = cast %reused : %%U8
    %v37 = load [%v36] : %U8
    call setFreeListHead, %sizeClass, %v37
    ret %reused

  b11:
    jmp b12

  b12:
    %block = load heapNext : %U8
    %blockSize = call heapBlockSize, %sizeClass : I64
    %v43 = add %block, %blockSize : %U8
    %v44 = load heapLimit : %U8
    %v45 = cmp_gt %v43, %v44 : Bool
    je %v45, b13, b14

  b13:
    %v48 = cast 0 : %U8
    ret %v48

  b14:
    jmp b15

  b15:
    %v51 = add %block, %blockSize : %U8
    assign heapNext, %v51
    %v53 = cast %block : %I64
    assign [%v53], %sizeClass
    %v57 = add %block, 8 : %U8
    ret %v57
