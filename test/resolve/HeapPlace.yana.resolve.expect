fn freeHeap(%allocation: %U8) -> () {
  b0:
    %v1 = cast %allocation : Long
    %v3 = cmp_eq %v1, 0 : Bool
    je %v3, b1, b2

  b1:
    ret

  b2:
    jmp b3

  b3:
    %v9 = sub %allocation, 8 : %U8
    %v10 = cast %v9 : %I64
    %sizeClass = load [%v10] : I64
    %v12 = cast %allocation : %%U8
    %v13 = call freeListHead, %sizeClass : %U8
    assign [%v12], %v13
    call setFreeListHead, %sizeClass, %allocation
    ret
}

fn mapMemory(%size: I64) -> %U8 {
  b0:
    %v7 = neg 1 : I64
    %result = syscall 9, 0, %size, 3, 34, %v7, 0 : I64
    %v12 = cmp_lt %result, 0 : Bool
    je %v12, b1, b2

  b1:
    %v15 = cast 0 : %U8
    ret %v15

  b2:
    jmp b3

  b3:
    %v18 = cast %result : %U8
    ret %v18
}

fn main() -> Int {
  b0:
    %v0 = alloc : Pair
    init %local0@Pair.left, 10
    init %local0@Pair.right, 20
    %p = alloc heap : Pair
    init %p, %v0
    %v7 = load %p : Pair
    %v8 = load %p@Pair.left : I64
    %v11 = add %v8, 2 : I64
    assign %p@Pair.left, %v11
    %v13 = load %p : Pair
    %v14 = load %p@Pair.left : I64
    %v15 = load %p : Pair
    %v16 = load %p@Pair.right : I64
