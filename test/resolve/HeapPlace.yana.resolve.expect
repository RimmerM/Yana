let &heapNext: %U8 = 0

let &heapLimit: %U8 = 0

let &heapFree: %%U8 = 0

fn initHeap() -> () {
  b0:
    %region = call mapMemory, 4194304 : %U8
    %v2 = cast %region : Long
    %v4 = cmp_eq %v2, 0 : Bool
    je %v4, b1, b2

  b1:
    ret

  b2:
    jmp b3

  b3:
    %table = mul 32, 8 : I64
    setmemory %region, 0, %table
    %v14 = cast %region : %%U8
    assign heapFree, %v14
    %v16 = add %region, %table : %U8
    assign heapNext, %v16
    %v19 = add %region, 4194304 : %U8
    assign heapLimit, %v19
    ret
}

fn heapClassOf(%total: I64) -> I64 {
  b0:
    %size = alloc : I64
    init %size, 16
    %sizeClass = alloc : I64
    init %sizeClass, 0
    jmp b1

  b1:
    %v8 = load %size : I64
    %v9 = cmp_lt %v8, %total : Bool
    je %v9, b3, b2

  b2:
    %v21 = load %sizeClass : I64
    ret %v21

  b3:
    %v11 = load %size : I64
    %v12 = load %size : I64
    %v13 = add %v11, %v12 : I64
    assign %size, %v13
    %v15 = load %sizeClass : I64
    %v18 = add %v15, 1 : I64
    assign %sizeClass, %v18
    jmp b1
}

fn heapBlockSize(%sizeClass: I64) -> I64 {
  b0:
    %v2 = shl 16, %sizeClass : I64
    ret %v2
}

fn freeListHead(%sizeClass: I64) -> %U8 {
  b0:
    %v1 = load heapFree : %%U8
    %v3 = mul %sizeClass, 8 : I64
    %v4 = add %v1, %v3 : %%U8
    %v5 = load [%v4] : %U8
