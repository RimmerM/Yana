let image$base: () = <none>

let &heapNext: %U8 = 0

let &heapLimit: %U8 = 0

let &heapFree: %%U8 = 0

let &heapRegionNext: Size = 0

fn mapMemory(%size: Size) -> %U8 {
  b0:
    %v7 = neg 1 : Size
    %result = syscall 9, 0, %size, 3, 34, %v7, 0 : Size
    %v12 = cmp_lt %result, 0 : Bool
    je %v12, b1, b2

  b1:
    %v15 = bitcast 0 : %U8
    ret %v15

  b2:
    jmp b3

  b3:
    %v18 = bitcast %result : %U8
    ret %v18
}

fn initHeap() -> () {
  b0:
    %v2 = add 4194304, 4096 : Size
    %region = call mapMemory, %v2 : %U8
    %v4 = bitcast %region : Long
    %v6 = cmp_eq %v4, 0 : Bool
    je %v6, b1, b2

  b1:
    ret

  b2:
    jmp b3

  b3:
    %table = mul 32, 8 : Size
    setmemory %region, 0, %table
    %v16 = bitcast %region : %%U8
    assign heapFree, %v16
    %v18 = strideof U8 : Size
    %v19 = mul %table, %v18 : Size
    %v20 = add %region, %v19 : %U8
    assign heapNext, %v20
    %v23 = strideof U8 : Size
    %v24 = mul 4194304, %v23 : Size
    %v25 = add %region, %v24 : %U8
    assign heapLimit, %v25
    %v29 = add 4194304, 4194304 : Size
    assign heapRegionNext, %v29
    ret
}

fn growHeap(%needed: Size) -> Bool {
  b0:
    %v1 = load heapRegionNext : Size
    %size = alloc : Size
    init %size, %v1
    %v4 = load %size : Size
    %v5 = cmp_lt %v4, %needed : Bool
    je %v5, b1, b2

  b1:
    assign %size, %needed
    jmp b3

  b2:
    jmp b3

  b3:
    %v10 = load %size : Size
    %v12 = add %v10, 4096 : Size
    %v13 = call mapMemory, %v12 : %U8
    %region = alloc : %U8
    init %region, %v13
    %v16 = load %region : %U8
    %v17 = bitcast %v16 : Long
    %v19 = cmp_eq %v17, 0 : Bool
    je %v19, b4, b5

  b4:
    %v22 = cmp_gt %needed, 4194304 : Bool
    je %v22, b6, b7

  b5:
    jmp b15

  b6:
    jmp b8

  b7:
    jmp b8

  b8:
    %least = phi [b6, %needed], [b7, 4194304] : Size
    %v28 = load %size : Size
    %v29 = cmp_ge %least, %v28 : Bool
    je %v29, b9, b10

  b9:
    ret False

  b10:
    jmp b11

  b11:
    assign %size, %least
    %v35 = load %size : Size
    %v37 = add %v35, 4096 : Size
    %v38 = call mapMemory, %v37 : %U8
    assign %region, %v38
    %v40 = load %region : %U8
    %v41 = bitcast %v40 : Long
    %v43 = cmp_eq %v41, 0 : Bool
    je %v43, b12, b13

  b12:
    ret False

  b13:
    jmp b14

  b14:
    jmp b15

  b15:
    %v50 = load %region : %U8
    assign heapNext, %v50
    %v52 = load %region : %U8
    %v53 = load %size : Size
    %v54 = strideof U8 : Size
    %v55 = mul %v53, %v54 : Size
    %v56 = add %v52, %v55 : %U8
    assign heapLimit, %v56
    %v58 = load %size : Size
    %v59 = load %size : Size
    %v60 = add %v58, %v59 : Size
    assign heapRegionNext, %v60
    ret True
}

fn heapClassOf(%total: Size) -> Size {
  b0:
    %size = alloc : Size
    init %size, 16
    %sizeClass = alloc : Size
    init %sizeClass, 0
    jmp b1

  b1:
    %v8 = load %size : Size
    %v9 = cmp_lt %v8, %total : Bool
    je %v9, b3, b2

  b2:
    %v21 = load %sizeClass : Size
    ret %v21

  b3:
    %v11 = load %size : Size
    %v12 = load %size : Size
    %v13 = add %v11, %v12 : Size
    assign %size, %v13
    %v15 = load %sizeClass : Size
    %v18 = add %v15, 1 : Size
    assign %sizeClass, %v18
    jmp b1
}

fn heapBlockSize(%sizeClass: Size) -> Size {
  b0:
    %v2 = shl 16, %sizeClass : Size
    ret %v2
}

fn freeListHead(%sizeClass: Size) -> %U8 {
  b0:
    %v1 = load heapFree : %%U8
    %v2 = strideof %U8 : Size
    %v3 = mul %sizeClass, %v2 : Size
    %v4 = add %v1, %v3 : %%U8
    %v5 = load [%v4] : %U8
    ret %v5
