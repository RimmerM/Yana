fn setFreeListHead(%sizeClass: Size, %block: %U8) -> () {
  b0:
    %v2 = load heapFree : %%U8
    %v3 = strideof %U8 : Size
    %v4 = mul %sizeClass, %v3 : Size
    %v5 = add %v2, %v4 : %%U8
    assign [%v5], %block
