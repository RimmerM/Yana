  b3:
    %v9 = strideof U8 : Size
    %v10 = mul 8, %v9 : Size
    %v11 = sub %allocation, %v10 : %U8
    %v12 = bitcast %v11 : %Size
    %sizeClass = load [%v12] : Size
    %v14 = bitcast %allocation : %%U8
    %v15 = call freeListHead, %sizeClass : %U8
    assign [%v14], %v15
    call setFreeListHead, %sizeClass, %allocation
    ret
}

fn main() -> Int {
  b0:
    %v0 = alloc heap : Pair
    aggregate %p@Pair.left = 10, %p@Pair.right = 20
    %v4 = load %p : Pair
    %v5 = load %p@Pair.left : I64
    %v8 = add %v5, 2 : I64
