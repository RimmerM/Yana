{-
   Tests a test on the way in already answered - see `threadImpliedBranches` in
   compiler/lower/lower_thread.h.

   Each function is a shape the pass reads, and `.mir.lower.expect` is what says which edges moved.
   `main` runs every one of them over a range of inputs wide enough to cross each interval's ends,
   so that `.run.expect` and the driver's optimizer-equivalence check assert the answers as well: an
   interval off by one at a wrap is an edge moved to the wrong arm, and it still validates.
-}

{-
   The shape the pass exists for, which is `sequenceReach` in lib/Core/Char.native.yana: a guard over
   a pair whose second-position test falls into the next arm's test of the first. The lead is known
   on that edge, so every later test of it is decided and the edge goes to the arm that answers.
-}
@noinline fn reach(lead: Int, first: Int) -> Int
  | {0xC2..=0xDF, _} -> 1
  | {0xE0, _..0xA0}  -> 0
  | {0xED, 0xA0.._}  -> 0
  | {0xE0..=0xEF, _} -> 2
  | {0xF0, _..0x90}  -> 0
  | {0xF4, 0x90.._}  -> 0
  | {0xF0..=0xF4, _} -> 3
  | _                -> 0

{-
   Signed relations, and an edge whose fact is the complement of its arm: `x < 0` is known false on
   the way into the second test, which asks `x >= -5` and is therefore decided true. The third test
   is not decided by either and stays.
-}
@noinline fn signs(x: Int) -> Int:
    let &total = 0 :: Int
    if x < 0:
        total = 1
    else if x >= -5:
        total = if x > 3 then 2 else 3

    return total

@noinline fn noted(n: Int) -> Int = n * 5 + 1

{-
   An edge moved toward a join. The inner test's false edge knows `c == 7` and so answers `c == 9`,
   and moves to the block on the edge into the join that merges `total` - the join itself is never
   the target, because the front ends give every edge into one a block of its own.
-}
@noinline fn joinAfter(c: Int, b: Int) -> Int:
    let &total = 0 :: Int
    if c == 7:
        if b > 0 then return noted(b)

    if c == 9 then total = noted(c)
    return total + c

{-
   The refusal: a loop header is never skipped. The preheader's own test says `n > 0`, and the header
   asks the same question every iteration - but `n` changes in the loop, and the header is not a
   block an edge from outside may go around.
-}
@noinline fn countDown(start: Int) -> Int:
    let &n = start
    let &steps = 0 :: Int
    if n > 0:
        while n > 0:
            n = n - 2
            steps = steps + 1

    return steps

fn main() -> Int:
    let &total = 0 :: Int

    for lead in 0xBE .. 0x100:
        for first in 0x7E .. 0xC2:
            total = total + reach(lead, first) * (lead % 7 + first % 5 + 1)

    for i in 0 .. 16:
        let x = i - 8
        total = total + signs(x) * (i + 1)

    for c in 5 .. 11:
        for i in 0 .. 3:
            total = total + joinAfter(c, i - 1)

    for i in 0 .. 8:
        let start = i - 2
        total = total + countDown(start)

    return total % 1000000
