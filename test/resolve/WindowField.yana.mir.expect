module ResolveTest

data Held(a) {value: 0'a, extra: I32} shape2

data Held(Array(I32)) {value: 0'Array(I32), extra: I32} of Held shape1

class Sized(a): measure, twice

instance Sized(Array(I32)): Array(I32).measure, Sized.twice

fn measure(subject: Held(a) [shared call]) -> I32 = <no body>

fn twice(subject: Held(a) [shared call]) -> I32 {
  form specialized
  slot #0 type a
  slot #1 class Sized(a)
bb0:
  %0: Held(a) = read copy.trivial (subject)
  %1: I32 = call measure(a) borrow.shared %0
  %2: I32 = const 2
  %3: I32 = mul inspect %1 inspect %2
  return take %3
}

fn Array(I32).measure(subject: Held(Array(I32)) [shared call]) -> I32 {
bb0:
  %0: Array(I32) [shared slot 0 view] = read borrow.shared (subject.value) loan0
  %1: Size = call length(Array(I32)) borrow.shared %0
  %2: I32 = convert inspect %1
  %3: I32 = read copy.trivial (subject.extra)
  %4: I32 = add inspect %2 inspect %3
  return take %4
}

fn heldOf(xs: Array(I32) [shared slot 0 view], extra: I32 [shared call]) -> Held(Array(I32)) [owned here shape1 .0=shared slot 0 view] {
bb0:
  %0: Array(I32) [shared slot 0 view] = read borrow.shared (xs) loan0
  %1: I32 = read copy.trivial (extra)
  %2: Held(Array(I32)) [owned here shape1 .0=shared slot 0 view] = aggregate.Held borrow.shared %0 take %1 roots.0{0}
  return take %2
}

fn main() -> I32 {
  local & local0: Array(I32) object1
  local xs: Array(I32) object1
  local & local2: Array(I32) object5
  local ys: Array(I32) object5
  local owned: Held(Array(I32)) [owned here shape1 .0=shared slot 0 view]
  local viewed: Held(Array(I32)) [owned here shape1 .0=shared slot 0 view]

bb0:
  %0: I32 = const 1
  %1: I32 = const 2
  %2: I32 = const 3
  %3: %I32 = run.slots I32 *3
  %4: Size = bitcast inspect %3
  %5: Size = const 0
  %6: Bool = eq inspect %4 inspect %5
  %7: {} = call checkCondition borrow.shared %6
  %8: @bits(30) U32 = const 3
  %9: @bits(2) U32 = const 1
  %10: Run(I32) = aggregate.Run take %3 take %8 take %9
  %11: @bits(30) U32 = const 3
  %12: Array(I32) = aggregate.Array take %10 take %11
  write.init borrow.unique (local0) take %12
  %14: Size = const 0
  write.init borrow.unique ([%%3][0]) take %0
  %16: Size = const 1
  write.init borrow.unique ([%%3][1]) take %1
  %18: Size = const 2
  write.init borrow.unique ([%%3][2]) take %2
  %20: Array(I32) = read take (local0)
  write.init borrow.unique (xs) take %20
  %22: I32 = const 4
  %23: I32 = const 5
  %24: %I32 = run.slots I32 *2
  %25: Size = bitcast inspect %24
  %26: Size = const 0
  %27: Bool = eq inspect %25 inspect %26
  %28: {} = call checkCondition borrow.shared %27
  %29: @bits(30) U32 = const 2
  %30: @bits(2) U32 = const 1
  %31: Run(I32) = aggregate.Run take %24 take %29 take %30
  %32: @bits(30) U32 = const 2
  %33: Array(I32) = aggregate.Array take %31 take %32
  write.init borrow.unique (local2) take %33
  %35: Size = const 0
  write.init borrow.unique ([%%24][0]) take %22
  %37: Size = const 1
  write.init borrow.unique ([%%24][1]) take %23
  %39: Array(I32) = read take (local2)
  write.init borrow.unique (ys) take %39
  %41: Array(I32) [shared slot 0] = read borrow.shared (xs) loan0
  %42: Array(I32) [shared slot 0 view] = call.derivation elements(Array(I32), I32) borrow.shared %41 roots{0}
  %43: I32 = const 10
  %44: Held(Array(I32)) [owned here shape1 .0=shared slot 0 view] = call heldOf borrow.shared %42 borrow.shared %43 roots.0{0}
  write.init borrow.unique (owned) take %44
  %46: Array(I32) [shared slot 0] = read borrow.shared (ys) loan1
  %47: Array(I32) [shared slot 0 view] = call elements(Array(I32), I32) borrow.shared %46 roots{1}
  %48: I32 = const 20
  %49: Held(Array(I32)) [owned here shape1 .0=shared slot 0 view] = call heldOf borrow.shared %47 borrow.shared %48 roots.0{1}
  write.init borrow.unique (viewed) take %49
  %51: Held(Array(I32)) [owned here shape1 .0=shared slot 0 view] = read copy.trivial (owned) roots.0{0}
  %52: I32 = call measure(Array(I32)) borrow.shared %51
  drop (xs)
  %53: Held(Array(I32)) [owned here shape1 .0=shared slot 0 view] = read copy.trivial (viewed) roots.0{1}
  %54: I32 = call twice(Array(I32)) borrow.shared %53
  drop (ys)
  %55: I32 = add inspect %52 inspect %54
  return take %55
}

fn twice(Array(I32))(subject: Held(Array(I32)) [shared call]) -> I32 = <twice at Array(I32)>

entry main
