lens fn scope(I32)($body: (->{}) -> I32 [shared call]) -> I32 = <scope at I32>

lens fn plusOne(I32)(x: I32 [shared call], $body: (I32) -> I32 [shared call]) -> I32 = <plusOne at I32>

lens fn split(I32)(x: I32 [shared call], $body: ({low: I32, high: I32}) -> I32 [shared call]) -> I32 = <split at I32>

lens fn bumped(I32)(c: Counter [unique call], $body: (I32) -> I32 [shared call]) -> I32 = <bumped at I32>

lens fn twiceOver(I32, I32)(value: I32 [shared call], $body: (I32) -> I32 [shared call]) -> I32 = <twiceOver at I32, I32>

lens fn twiceOver(Bool, I32)(value: Bool [shared call], $body: (Bool) -> I32 [shared call]) -> I32 = <twiceOver at Bool, I32>

lens fn logged(I32)($body: (I32) -> I32 [shared call]) -> I32 = <logged at I32>

