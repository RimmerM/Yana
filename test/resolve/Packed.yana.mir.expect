module ResolveTest

data Header {version: @bits(4) U32, flags: @bits(3) U32, length: @bits(13) U32}

data Flags {optionA: Bool, optionB: Bool}

data Mixed {only: @bits(5) U32, wide: I32}

data Nine {a: Bool, b: Bool, c: Bool, d: Bool, e: Bool, f: Bool, g: Bool, h: Bool, i: Bool}

data Entry {live: Bool, kind: @bits(3) U32, count: I32}

fn tick(x: @bits(3) U32 [unique call]) -> {} {
bb0:
  %0: @bits(3) U32 = read copy.trivial (x)
  %1: U32 = convert inspect %0
  %2: U32 = const 1
  %3: U32 = add inspect %1 inspect %2
  %4: @bits(3) U32 = convert inspect %3
  write.assign borrow.unique (x) take %4
  return
}

fn bump(x: U32 [unique call]) -> {} {
bb0:
  %0: U32 = read copy.trivial (x)
  %1: U32 = const 1
  %2: U32 = add inspect %0 inspect %1
  write.assign borrow.unique (x) take %2
  return
}

fn flip(b: Bool [unique call]) -> {} {
bb0:
  %0: Bool = read copy.trivial (b)
  %1: Bool = not inspect %0
  write.assign borrow.unique (b) take %1
  return
}

fn scale(x: U32 [unique call], by: U32 [shared call]) -> {} {
bb0:
  %0: U32 = read copy.trivial (x)
  %1: U32 = read copy.trivial (by)
  %2: U32 = mul inspect %0 inspect %1
  write.assign borrow.unique (x) take %2
  return
}

