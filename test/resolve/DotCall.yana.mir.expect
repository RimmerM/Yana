lens fn upTo(limit: I32 [shared call], $body: (I32) -> I32 [shared call]) -> I32 {
  local & $yielded: I32
  local & i: I32

bb0:
  %0: I32 = const 0
  write.init borrow.unique ($yielded) take %0
  %2: I32 = const 0
  write.init borrow.unique (i) take %2
  jump -> bb1

bb1:
  %5: I32 = read copy.trivial (i)
  %6: I32 = read copy.trivial (limit)
  %7: Bool = lt inspect %5 inspect %6
  branch inspect %7 -> bb3 -> bb2

bb2:
  %22: I32 = read copy.trivial ($yielded)
  return take %22

bb3:
  %9: I32 = read copy.trivial (i)
  %10: (I32) -> I32 [shared call] = read borrow.shared ($body) loan0
  %11: I32 = call inspect %10 borrow.shared %9
  %12: I32 = const 0
  %13: Bool = eq inspect %11 inspect %12
  write.assign borrow.unique ($yielded) take %11
  branch inspect %13 -> bb4 -> bb5

bb4:
  %17: I32 = read copy.trivial (i)
  %18: I32 = const 1
  %19: I32 = add inspect %17 inspect %18
  write.assign borrow.unique (i) take %19
  jump -> bb1

bb5:
  jump -> bb2
}

lens fn evens(limit: I32 [shared call], $body: (I32) -> I32 [shared call]) -> I32 {
  local & $yielded: I32
  local x: I32 [shared call]

bb0:
  %0: I32 = const 0
  write.init borrow.unique ($yielded) take %0
  %2: I32 = read copy.trivial (limit)
  lens.call upTo borrow.shared %2 -> bb2

bb1:
  %23: I32 = read copy.trivial ($yielded)
  return take %23

bb2(%3: I32 [shared call]) handover(I32 [shared call]) many -> bb1:
  write.init borrow.unique (x) borrow.shared %3
  %6: I32 = read copy.trivial (x)
  %7: I32 = const 2
  %8: I32 = rem inspect %6 inspect %7
  %9: I32 = const 0
  %10: Bool = eq inspect %8 inspect %9
  branch inspect %10 -> bb5 -> bb3

bb3 handover(I32 [shared call]) many:
  jump -> bb4

bb4 handover(I32 [shared call]) many:
  jump -> bb1

bb5 handover(I32 [shared call]) many:
  %12: I32 = read copy.trivial (x)
  %13: (I32) -> I32 [shared call] = read borrow.shared ($body) loan0
  %14: I32 = call inspect %13 borrow.shared %12
  %15: I32 = const 0
  %16: Bool = eq inspect %14 inspect %15
  write.assign borrow.unique ($yielded) take %14
  branch inspect %16 -> bb6 -> bb7

bb6 handover(I32 [shared call]) many:
  jump -> bb4

bb7 handover(I32 [shared call]) many:
  break -> bb1
}

