fn applyTwice(v: a [shared call], f: (a) -> a [shared call]) -> a {
  form specialized
  slot #0 type a
  local local2: a

bb0:
  %0: (a) -> a [shared call] = read borrow.shared (f) loan0
  %1: (a) -> a [shared call] = read borrow.shared (f) loan1
  %2: a [shared call] = read borrow.shared (v) loan2
  %3: a = call inspect %1 borrow.shared %2
  write.init borrow.unique (local2) take %3
  %5: a [shared call] = read borrow.shared (local2) loan3
  %6: a = call inspect %0 borrow.shared %5
  drop (local2)
  return take %6
}

