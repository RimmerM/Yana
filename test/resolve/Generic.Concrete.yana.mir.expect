module ResolveTest

fn genericWidth(value: a [shared call], width: U64 [shared call]) -> U64 {
  form erased
  slot #0 type a
bb0:
  %0: U64 = read copy.trivial (width)
  return take %0
}

fn plainWidth(value: I32 [shared call], width: U64 [shared call]) -> U64 {
bb0:
  %0: U64 = read copy.trivial (width)
  return take %0
}

fn genericBump(value: a [shared call], counter: I32 [unique call]) -> {} {
  form erased
  slot #0 type a
bb0:
  %0: I32 = read copy.trivial (counter)
  %1: I32 = const 1
  %2: I32 = add inspect %0 inspect %1
  write.assign borrow.unique (counter) take %2
  return
}

fn plainBump(value: I32 [shared call], counter: I32 [unique call]) -> {} {
bb0:
  %0: I32 = read copy.trivial (counter)
  %1: I32 = const 1
  %2: I32 = add inspect %0 inspect %1
  write.assign borrow.unique (counter) take %2
  return
}

fn genericWiden(value: a [shared call], total: I64 [shared call]) -> I64 {
  form erased
  slot #0 type a
bb0:
  %0: I64 = read copy.trivial (total)
  return take %0
}

fn main() -> I32 {
  local narrow: @bits(53) U64
  local & counter: I32
  local small: I32
  local widths: I32

bb0:
  %0: @bits(53) U64 = const 21
  write.init borrow.unique (narrow) take %0
  %2: I32 = const 0
  write.init borrow.unique (counter) take %2
  %4: I32 = const 7
  write.init borrow.unique (small) take %4
  %6: I32 = const 1
  %7: I32 [unique call] = read borrow.unique (counter) loan0
  %8: {} = call genericBump(I32) borrow.shared %6 borrow.unique %7
  %9: I32 = const 1
  %10: I32 [unique call] = read borrow.unique (counter) loan1
  %11: {} = call plainBump borrow.shared %9 borrow.unique %10
  %12: I32 = const 1
  %13: @bits(53) U64 = read copy.trivial (narrow)
  %14: U64 = convert inspect %13
  %15: U64 = call genericWidth(I32) borrow.shared %12 borrow.shared %14
  %16: I32 = convert inspect %15
  %17: I32 = const 1
  %18: @bits(53) U64 = read copy.trivial (narrow)
  %19: U64 = convert inspect %18
  %20: U64 = call plainWidth borrow.shared %17 borrow.shared %19
  %21: I32 = convert inspect %20
  %22: I32 = add inspect %16 inspect %21
  write.init borrow.unique (widths) take %22
  %24: I32 = read copy.trivial (widths)
  %25: I32 = read copy.trivial (counter)
  %26: I32 = add inspect %24 inspect %25
  %27: I32 = const 1
  %28: I32 = read copy.trivial (small)
  %29: I64 = convert inspect %28
  %30: I64 = call genericWiden(I32) borrow.shared %27 borrow.shared %29
  %31: I32 = convert inspect %30
  %32: I32 = add inspect %26 inspect %31
  return take %32
}

entry main
