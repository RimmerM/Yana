mut @live = [0, 0, 0, 0]
mut @calls = [0, 0, 0, 0]

Held.drop<complex>(%v_0: I32) {
  b_1 {
    %v_2 = loads @live, 4: I32
    %v_3 = sub %v_2, 1: I32
    store @live, %v_3, 4
    ret 
  }
}

doubled<complex>(%value: I32): I32 {
  b_0 {
    %v_1 = shl %value, 1: I32
    ret %v_1
  }
}

zero'2<complex>(): I32 {
  b_0 {
    ret 0
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = call_complex doubled, 6: I32
    %v_2 = imul %v_1, 41: I32
    %v_3 = loads @calls, 4: I32
    %v_4 = add %v_3, 1: I32
    store @calls, %v_4, 4
    %v_5 = add %v_2, 4369: I32
    %v_6 = call_complex zero'2: I32
    %v_7 = cmp_neq %v_6, 0: I32
    je %v_7, b_8, b_9
  }

  b_9 {
    jmp b_10
  }

  b_8 {
    %v_11 = cmp_eq %v_6, 4294967295: I32
    %v_12 = select %v_11, 1, %v_6: I32
    %v_13 = idiv 30, %v_12: I32
    %v_14 = select %v_11, 4294967266, %v_13: I32
    jmp b_10
  }

  b_10 {
    %v_15 = phi [b_9, 0], [b_8, %v_14]: I32
    %v_16 = imul %v_15, 59: I32
    %v_17 = add %v_5, %v_16: I32
    %v_18 = add %v_17, 3364: I32
    %v_19 = call_complex doubled, 6: I32
    %v_20 = imul %v_19, 103: I32
    %v_21 = add %v_18, %v_20: I32
    %v_22 = loads @live, 4: I32
    %v_23 = add %v_22, 1: I32
    store @live, %v_23, 4
    call_complex Held.drop, 3
    %v_24 = loads @live, 4: I32
    %v_25 = add %v_24, 1: I32
    store @live, %v_25, 4
    call_complex Held.drop, 4
    %v_26 = loads @live, 4: I32
    %v_27 = add %v_26, 1: I32
    store @live, %v_27, 4
    call_complex Held.drop, 7
    %v_28 = add %v_21, 1178: I32
    %v_29 = loads @live, 4: I32
    %v_30 = add %v_29, 1: I32
    store @live, %v_30, 4
    call_complex Held.drop, 7
    %v_31 = imul %v_28, 1000: I32
    %v_32 = loads @calls, 4: I32
    %v_33 = imul %v_32, 10: I32
    %v_34 = add %v_31, %v_33: I32
    %v_35 = loads @live, 4: I32
    %v_36 = add %v_34, %v_35: I32
    ret %v_36
  }
}

