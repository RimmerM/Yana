    call_complex Held.drop, %v_33
    %v_34 = add %v_30, 584: I32
    %v_35 = loads @live, 4: I32
    %v_36 = add %v_35, 1: I32
    store @live, %v_36, 4
    %v_37 = alloca 4, 4: Ptr
