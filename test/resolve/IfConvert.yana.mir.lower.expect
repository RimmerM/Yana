    call_complex Held.drop, %v_25
    %v_26 = add %v_22, 201: I32
    %v_27 = loads @live, 4: I32
    %v_28 = add %v_27, 1: I32
    store @live, %v_28, 4
    %v_29 = alloca 4, 4: Ptr
