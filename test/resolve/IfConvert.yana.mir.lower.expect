mut @live = [0, 0, 0, 0]
mut @calls = [0, 0, 0, 0]

Held.drop<complex>(%self: Ptr) {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    copy %v_1, %self, 4
    %v_2 = loads @live, 4: I32
    %v_3 = sub %v_2, 1: I32
    store @live, %v_3, 4
    ret 
  }
}

doubled<complex>(%value: I32): I32 {
  b_0 {
    %v_1 = shl %value, 1: I32
    ret %v_1
  }
}

zero'2<complex>(): I32 {
  b_0 {
    ret 0
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = call_complex doubled, 6: I32
    %v_2 = imul %v_1, 41: I32
    %v_3 = loads @calls, 4: I32
    %v_4 = add %v_3, 1: I32
    store @calls, %v_4, 4
    %v_5 = add %v_2, 4369: I32
    %v_6 = call_complex zero'2: I32
    %v_7 = cmp_neq %v_6, 0: I32
    je %v_7, b_8, b_9
  }

  b_9 {
    jmp b_10
  }

  b_8 {
    %v_11 = cmp_eq %v_6, 4294967295: I32
    %v_12 = select %v_11, 1, %v_6: I32
    %v_13 = idiv 30, %v_12: I32
    %v_14 = select %v_11, 4294967266, %v_13: I32
    jmp b_10
  }

  b_10 {
    %v_15 = phi [b_9, 0], [b_8, %v_14]: I32
    %v_16 = imul %v_15, 59: I32
    %v_17 = add %v_5, %v_16: I32
    %v_18 = add %v_17, 3364: I32
    %v_19 = call_complex doubled, 6: I32
    %v_20 = imul %v_19, 103: I32
    %v_21 = add %v_18, %v_20: I32
    %v_22 = alloca 4, 4: Ptr
    %v_23 = loads @live, 4: I32
    %v_24 = add %v_23, 1: I32
    store @live, %v_24, 4
    store %v_22, 3, 4
    call_complex Held.drop, %v_22
    %v_25 = alloca 4, 4: Ptr
    %v_26 = loads @live, 4: I32
    %v_27 = add %v_26, 1: I32
    store @live, %v_27, 4
    store %v_25, 4, 4
    call_complex Held.drop, %v_25
    %v_28 = loads @live, 4: I32
    %v_29 = add %v_28, 1: I32
    store @live, %v_29, 4
    %v_30 = alloca 4, 4: Ptr
    store %v_30, 7, 4
    call_complex Held.drop, %v_30
    %v_31 = add %v_21, 1178: I32
    %v_32 = loads @live, 4: I32
    %v_33 = add %v_32, 1: I32
    store @live, %v_33, 4
    %v_34 = alloca 4, 4: Ptr
    store %v_34, 7, 4
    call_complex Held.drop, %v_34
    %v_35 = imul %v_31, 1000: I32
    %v_36 = loads @calls, 4: I32
    %v_37 = imul %v_36, 10: I32
    %v_38 = add %v_35, %v_37: I32
    %v_39 = loads @live, 4: I32
    %v_40 = add %v_38, %v_39: I32
    ret %v_40
  }
}

