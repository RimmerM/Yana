mut @live = [0, 0, 0, 0]
mut @calls = [0, 0, 0, 0]

Held.drop<complex>(%self: Ptr) {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    copy %v_1, %self, 4
    %v_2 = loads @live, 4: I32
    %v_3 = sub %v_2, 1: I32
    store @live, %v_3, 4
    ret 
  }
}

doubled<complex>(%value: I32): I32 {
  b_0 {
    %v_1 = shl %value, 1: I32
    ret %v_1
  }
}

zero'2<complex>(): I32 {
  b_0 {
    ret 0
  }
}

