import Native

{-
   The shape rule an authored `Reclaim` has to satisfy - Implementation-Containers.md §13.

   A region discharges every `Reclaim` inside it in bulk, at a point the author did not choose, so a
   `Reclaim` that ran an effect would run it somewhere the program never asked for. What is permitted
   is control flow, arithmetic over its own metadata, reads of storage it owns, the compiler's
   per-member teardown, and storage release - and no other call.

   The author is trusted about "I call nothing else", which is a walk over the call graph and is what
   these two are rejected by. The author is never trusted about "my members are effect-free", which
   is computed from the element types instead.

   The default stage since J142 (`checkReclaimShape`): storage release is the `releaseRun` and
   `freeHeap` roles, so the set is one of callees and names no function by its spelling.
-}

-- # resolver: ownership

let &closes = 0 :: I64

fn recordClose():
    closes += 1

data Pool {slots: Run(I64), live: Int}

-- Calling a function that is neither a teardown nor storage release. The message names what to write
-- instead, because an effect at last use is exactly what a `Drop` is for.
instance Reclaim(Pool):
    fn reclaim(->value: Pool):
        recordClose()
        releaseRun(value.slots)

data Ledger {entries: Run(I64)}

-- And a helper of the container's own, which does not help: the permitted set is a set of *callees*
-- - the teardowns and the storage releases - so a name in front of the effect is one more call
-- outside it rather than a way through.
fn closeLedger(it: Ledger):
    recordClose()
    releaseRun(it.entries)

instance Reclaim(Ledger):
    fn reclaim(->value: Ledger): closeLedger(value)

-- J146: the walk looked at direct calls only. A lens call, a call through a function value - a
-- closure field or a local one - a write to a global and an intrinsic that reaches outside the
-- program's memory are effects too, and each is refused where it is written.
lens fn bracketed():
    recordClose()
    yield {}
    recordClose()

data Hooked {slots: Run(I64), hook: () -> {}}
data Bracketed {slots: Run(I64)}
data Counted {slots: Run(I64)}
data Signalled {slots: Run(I64)}

instance Reclaim(Hooked):
    fn reclaim(->value: Hooked):
        value.hook()
        releaseRun(value.slots)

instance Reclaim(Bracketed):
    fn reclaim(->value: Bracketed):
        bracketed():
            releaseRun(value.slots)

instance Reclaim(Counted):
    fn reclaim(->value: Counted):
        let local = () -> recordClose()
        local()
        closes = 7
        releaseRun(value.slots)

instance Reclaim(Signalled):
    fn reclaim(->value: Signalled):
        syscall1(39, 0)
        releaseRun(value.slots)

-- A global written by a compound assignment - a call to `+=`, which is lent the global exclusively -
-- and one written through its address. Both are the write they are since J162: the first was
-- "cannot call +=" and the second was accepted.
data Tallied {slots: Run(I64)}
data Poked {slots: Run(I64)}

instance Reclaim(Tallied):
    fn reclaim(->value: Tallied):
        closes += 1
        releaseRun(value.slots)

instance Reclaim(Poked):
    fn reclaim(->value: Poked):
        let p = bitcast(addressOf(closes)) :: %I64
        store(p, 3)
        releaseRun(value.slots)

fn main() -> I64:
    let pool = Pool {slots: emptyRun(), live: 0}
    let ledger = Ledger {entries: emptyRun()}

    return closes + 0
