fn borrowed() -> Int {
  b0:
    %v = alloc : Int
    init %v, 10
    %v4 = load %v : Int
    %v5 = borrow_mut %v : &mut Int
    call bump, %v5
    %v7 = load %v : Int
    %v8 = borrow_mut %v : &mut Int
    call bump, %v8
    %v10 = load %v : Int
