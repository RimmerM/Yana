fn main() -> Int {
  b0:
    %v1 = call counted, 5 : Int
    %v3 = call flagged, True : Int
    %v6 = mul %v3, 10 : Int
    %v7 = add %v1, %v6 : Int
    %v8 = call narrowed : Int
    %v9 = add %v7, %v8 : Int
    %v10 = call borrowed : Int
