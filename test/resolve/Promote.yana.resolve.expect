fn flagged(%x: Bool) -> Int {
  b0:
    %v1 = alloc : Flags
    init %local0@Flags.a, %x
    init %local0@Flags.b, False
    %f = alloc : Flags
    init %f, %v1
    je %x, b1, b2

  b1:
    assign %f@Flags.b, True
    jmp b3

  b2:
    jmp b3

  b3:
    %v12 = load %f : Flags
    %v13 = load %f@Flags.a : Bool
    je %v13, b4, b5

  b4:
    jmp b6

  b5:
    jmp b6

  b6:
    %v21 = phi [b4, 1], [b5, 0] : Int
    %v22 = load %f : Flags
    %v23 = load %f@Flags.b : Bool
    je %v23, b7, b8

  b7:
    jmp b9

  b8:
    jmp b9

  b9:
    %v31 = phi [b7, 2], [b8, 0] : Int
    %v32 = add %v21, %v31 : Int
    ret %v32
}

fn narrowed() -> Int {
  b0:
    %u = alloc : U8
    init %u, 250
    %v = alloc : I8
    init %v, 120
    %v6 = load %u : U8
    %v9 = add %v6, 10 : U8
    assign %u, %v9
    %v11 = load %v : I8
    %v14 = add %v11, 10 : I8
    assign %v, %v14
    %v16 = load %u : U8
    %v17 = cast %v16 : Int
    %v20 = mul %v17, 1000 : Int
    %v21 = load %v : I8
    %v22 = cast %v21 : Int
    %v23 = add %v20, %v22 : Int
