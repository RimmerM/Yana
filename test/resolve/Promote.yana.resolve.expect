fn counted(%n: Int) -> Int {
  b0:
    %total = alloc : Int
    init %total, 0
    %i = alloc : Int
    init %i, 0
    jmp b1

  b1:
    %v10 = load %i : Int
    %v11 = cmp_lt %v10, %n : Bool
    je %v11, b3, b2

  b2:
    %v23 = load %total : Int
