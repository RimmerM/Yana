  b3:
    %v13 = load %total : Int
    %v14 = load %i : Int
    %v15 = add %v13, %v14 : Int
    assign %total, %v15
    %v17 = load %i : Int
    %v20 = add %v17, 1 : Int
    assign %i, %v20
