  %21: I32 = const 7
  write.init borrow.unique (wide) take %21
  %23: Array(I32) [shared call] = read borrow.shared (xs) loan0
  %24: U8 = const 7
  %25: Array(I32) [shared slot 0 view] = call.derivation elements(Array(I32), I32) borrow.shared %23 roots{0}
  %26: Size = call probe'2(Array(I32)) borrow.shared %25 borrow.shared %24
  %27: Size = const 10
