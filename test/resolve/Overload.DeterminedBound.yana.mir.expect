module ResolveTest

class Pick(c -> k, v): probe

class Probe(c): probe

instance Pick(Array(I32), Size, I32): Array(I32).probe

instance Probe(Array(I32)): Array(I32).probe

fn probe(xs: c [shared call], value: v [shared call]) -> k = <no body>

fn probe'2(xs: c [shared call], value: U8 [shared call]) -> Size = <no body>

fn Array(I32).probe(xs: Array(I32) [shared call view], value: I32 [shared call]) -> Size {
bb0:
  %0: Size = const 1
  return take %0
}

fn Array(I32).probe'2(xs: Array(I32) [shared call view], value: U8 [shared call]) -> Size {
bb0:
  %0: Size = const 3
  return take %0
}

fn main() -> I32 {
