let image$base: () = <none>

fn +=(I32)(%target: I32, %amount: I32) -> () {
  b0:
    %v2 = load %target : I32
    %v3 = add %v2, %amount : I32
    assign %target, %v3
    ret
}

fn hoist(%p: %I64, %n: I32) -> I64 {
  b0:
    %v3 = strideof I64 : Size
    %v4 = mul -2, %v3 : Size
    %v5 = add %p, %v4 : %I64
    %h = load [%v5] : I64
    %i = alloc : I32
    init %i, 0
    %t = alloc : I64
    init %t, 0
    jmp b1

  b1:
    %v15 = load %i : I32
    %v16 = cmp_lt %v15, %n : Bool
    je %v16, b3, b2

  b2:
    %v28 = load %t : I64
    %v29 = add %h, %v28 : I64
    ret %v29

  b3:
    %v18 = load %t : I64
    %v19 = load [%p] : I64
    %v20 = add %v18, %v19 : I64
    assign %t, %v20
    %v22 = load %i : I32
    %v25 = borrow_mut %i : &I32
    call +=(I32), %v25, 1
    jmp b1
}

fn cell(%p: %I64, %n: I32) -> I64 {
  b0:
    %v3 = strideof I64 : Size
    %v4 = mul -2, %v3 : Size
    %v5 = add %p, %v4 : %I64
    %h = load [%v5] : I64
    %i = alloc : I32
    init %i, 0
    jmp b1

  b1:
    %v12 = load %i : I32
    %v13 = cmp_lt %v12, %n : Bool
    je %v13, b3, b2

  b2:
    ret %h

  b3:
    %v15 = load [%p] : I64
    %v16 = add %v15, %h : I64
    assign [%p], %v16
    %v18 = load %i : I32
    %v21 = borrow_mut %i : &I32
    call +=(I32), %v21, 1
    jmp b1
}

fn main() -> I32 {
  b0:
    %v6 = bitcast -1 : USize
    %base = syscall 9, 0, 8192, 3, 34, %v6, 0 : Size
    %v12 = add %base, 4096 : Size
    %v13 = bitcast %v12 : USize
    %protect = syscall 10, %v13, 4096, 0 : Size
    %v19 = cmp_ne %protect, 0 : Bool
    je %v19, b1, b2

  b1:
    ret 1

  b2:
    jmp b3

  b3:
    %v26 = add %base, 4096 : Size
    %p = bitcast %v26 : %I64
    %v29 = strideof I64 : Size
    %v30 = mul -2, %v29 : Size
    %v31 = add %p, %v30 : %I64
    assign [%v31], 5
    %v35 = call hoist, %p, 0 : I64
    %v37 = call cell, %p, 0 : I64
    %v38 = add %v35, %v37 : I64
    %v39 = cast %v38 : I32
    ret %v39
}
