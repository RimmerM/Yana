    je %v_3, b_4, b_5
  }

  b_6 {
    ret 
  }

  b_4 {
    %v_7 = add %v_0, 8: Ptr
    call_complex Buffer.drop, %v_7
    jmp b_6
  }

  b_5 {
    jmp b_6
  }
}

