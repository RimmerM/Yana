  b_1 {
    %v_2 = load %v_0, 1: I32
    %v_3 = cmp_eq %v_2, 1: I32
    je %v_3, b_4, b_5
  }

  b_6 {
    ret 
  }

  b_4 {
    %v_7 = add %v_0, 8: Ptr
    %v_8 = load %v_7, 8: I64
    call_complex Buffer.drop, %v_8
    jmp b_6
  }

  b_5 {
    jmp b_6
  }
}

