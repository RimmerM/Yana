module ResolveTest

data List = Nil | Cons {head: I32, tail: @box List} reclaim derived

data Tree = Leaf {Leaf: I32} | Branch {left: Maybe(Tree), right: Maybe(Tree), label: I32} reclaim derived

data Tracked {id: I32} drop authored

data Chain = End | Link {payload: Tracked, rest: @box Chain} drop derived reclaim derived

instance Drop(Tracked): Tracked.drop

let & liveNodes: I32 = 0

fn sum'2(xs: List [shared call]) -> I32 {
  local head: I32
  local tail: List [shared call]

bb0:
  %0: U8 = read copy.trivial (xs.#)
  %1: U8 = const 0
  %2: Bool = eq inspect %0 inspect %1
  branch inspect %2 -> bb3 -> bb1

bb1:
  %5: I32 = read copy.trivial (xs.head)
  write.init borrow.unique (head) take %5
  %7: List [shared call] = read borrow.shared (xs.tail) loan0
  write.init borrow.unique (tail) borrow.shared %7
  %9: I32 = read copy.trivial (head)
  %10: List [shared call] = read borrow.shared (tail) loan1 roots{0}
  %11: I32 = call sum'2 borrow.shared %10
  %12: I32 = add inspect %9 inspect %11
  jump -> bb2(take %12)

bb2(%13: I32):
  return take %13

bb3:
  %4: I32 = const 0
  jump -> bb2(take %4)
}

fn total(t: Tree [shared call]) -> I32 {
  local v: I32
  local left: Maybe(Tree) [shared call]
  local right: Maybe(Tree) [shared call]
  local label: I32

bb0:
  %0: U8 = read copy.trivial (t.#)
  %1: U8 = const 0
  %2: Bool = eq inspect %0 inspect %1
  branch inspect %2 -> bb3 -> bb1

bb1:
  %7: Maybe(Tree) [shared call] = read borrow.shared (t.left) loan0
  write.init borrow.unique (left) borrow.shared %7
  %9: Maybe(Tree) [shared call] = read borrow.shared (t.right) loan1
  write.init borrow.unique (right) borrow.shared %9
  %11: I32 = read copy.trivial (t.label)
  write.init borrow.unique (label) take %11
  %13: I32 = read copy.trivial (label)
  %14: Maybe(Tree) [shared call] = read borrow.shared (left) loan2 roots{0}
  %15: I32 = call totalOf borrow.shared %14
  %16: I32 = add inspect %13 inspect %15
  %17: Maybe(Tree) [shared call] = read borrow.shared (right) loan3 roots{1}
  %18: I32 = call totalOf borrow.shared %17
  %19: I32 = add inspect %16 inspect %18
  jump -> bb2(take %19)

bb2(%20: I32):
  return take %20

bb3:
  %4: I32 = read copy.trivial (t.Leaf)
  write.init borrow.unique (v) take %4
  %6: I32 = read copy.trivial (v)
  jump -> bb2(take %6)
}

fn totalOf(m: Maybe(Tree) [shared call]) -> I32 {
  local t: Tree [shared call]

bb0:
  %0: U8 = read copy.trivial (m.#)
  %1: U8 = const 0
  %2: Bool = eq inspect %0 inspect %1
  branch inspect %2 -> bb3 -> bb1

bb1:
  %5: Tree [shared call] = read borrow.shared (m.Just) loan0
  write.init borrow.unique (t) borrow.shared %5
  %7: Tree [shared call] = read borrow.shared (t) loan1 roots{0}
  %8: I32 = call total borrow.shared %7
  jump -> bb2(take %8)

bb2(%9: I32):
  return take %9

bb3:
  %4: I32 = const 0
  jump -> bb2(take %4)
}

fn unwrapOr(m: Maybe(a) [shared slot 0], fallback: a [shared slot 0]) -> a [shared slot 0] {
  form specialized
  slot #0 type a
  local v: a [shared slot 0]

bb0:
  %0: U8 = read copy.trivial (m.#)
  %1: U8 = const 0
  %2: Bool = eq inspect %0 inspect %1
  branch inspect %2 -> bb3 -> bb1

bb1:
  %5: a [shared slot 0] = read borrow.shared (m.Just) loan1
  write.init borrow.unique (v) borrow.shared %5
  %7: a [shared slot 0] = read borrow.shared (v) loan2 roots{1}
  jump -> bb2(borrow.shared %7)

bb2(%8: a [shared slot 0]):
  return borrow.shared %8

bb3:
  %4: a [shared slot 0] = read borrow.shared (fallback) loan0
  jump -> bb2(borrow.shared %4)
}

fn leftOf(t: Tree [shared call]) -> I32 {
  local absent: Tree
  local v: I32
  local left: Maybe(Tree) [shared call]

bb0:
  %0: I32 = const 0
  %1: Tree = aggregate.Leaf take %0
  write.init borrow.unique (absent) take %1
  %3: U8 = read copy.trivial (t.#)
  %4: U8 = const 0
  %5: Bool = eq inspect %3 inspect %4
  branch inspect %5 -> bb3 -> bb1

bb1:
  %10: Maybe(Tree) [shared call] = read borrow.shared (t.left) loan0
  write.init borrow.unique (left) borrow.shared %10
  %12: Maybe(Tree) [shared slot 0] = read borrow.shared (left) loan1 roots{0}
  %13: Tree [shared slot 0] = read borrow.shared (absent) loan2
  %14: Tree [shared slot 0] = call unwrapOr(Tree) borrow.shared %12 borrow.shared %13 roots{0, 1, 2}
  %15: I32 = call total borrow.shared %14
  drop (absent)
  jump -> bb2(take %15)

bb2(%16: I32):
  return take %16

bb3:
  drop (absent)
  %7: I32 = read copy.trivial (t.Leaf)
  write.init borrow.unique (v) take %7
  %9: I32 = read copy.trivial (v)
  jump -> bb2(take %9)
}

fn buildList() -> I32 {
  local xs: List

bb0:
  %0: I32 = const 1
  %1: I32 = const 2
  %2: I32 = const 39
  %3: List = aggregate.Nil
  %4: List = aggregate.Cons take %2 take %3
  %5: List = aggregate.Cons take %1 take %4
  %6: List = aggregate.Cons take %0 take %5
  write.init borrow.unique (xs) take %6
  %8: List [shared call] = read borrow.shared (xs) loan0
  %9: I32 = call sum'2 borrow.shared %8
  drop (xs)
  return take %9
}

fn buildTree() -> I32 {
  local deep: Tree
  local t: Tree

bb0:
  %0: Maybe(Tree) = aggregate.Nothing
  %1: I32 = const 20
  %2: Tree = aggregate.Leaf take %1
  %3: Maybe(Tree) = aggregate.Just take %2
  %4: I32 = const 5
  %5: Tree = aggregate.Branch take %0 take %3 take %4
  write.init borrow.unique (deep) take %5
  %7: I32 = const 10
  %8: Tree = aggregate.Leaf take %7
  %9: Maybe(Tree) = aggregate.Just take %8
  %10: Tree = read take (deep)
  %11: Maybe(Tree) = aggregate.Just take %10
  %12: I32 = const 7
  %13: Tree = aggregate.Branch take %9 take %11 take %12
  write.init borrow.unique (t) take %13
  %15: Tree [shared call] = read borrow.shared (t) loan0
  %16: I32 = call total borrow.shared %15
  %17: Tree [shared call] = read borrow.shared (t) loan1
  %18: I32 = call leftOf borrow.shared %17
  drop (t)
  %19: I32 = add inspect %16 inspect %18
  return take %19
}

fn track(id: I32 [shared call]) -> Tracked {
bb0:
  %0: I32 [unique call] = read borrow.unique (global liveNodes) loan0
  %1: I32 = const 1
  %2: {} = call +=(I32) borrow.unique %0 borrow.shared %1
  %3: I32 = read copy.trivial (id)
  %4: Tracked = aggregate.Tracked take %3
  return take %4
}

fn Tracked.drop(value: Tracked) -> {} {
bb0:
  %0: I32 [unique call] = read borrow.unique (global liveNodes) loan0
  %1: I32 = const 1
  %2: {} = call -=(I32) borrow.unique %0 borrow.shared %1
  return
}

fn idsOf(c: Chain [shared call]) -> I32 {
  local payload: Tracked [shared call]
  local rest: Chain [shared call]

bb0:
  %0: U8 = read copy.trivial (c.#)
  %1: U8 = const 0
  %2: Bool = eq inspect %0 inspect %1
  branch inspect %2 -> bb3 -> bb1

bb1:
  %5: Tracked [shared call] = read borrow.shared (c.payload) loan0
  write.init borrow.unique (payload) borrow.shared %5
  %7: Chain [shared call] = read borrow.shared (c.rest) loan1
  write.init borrow.unique (rest) borrow.shared %7
  %9: I32 = read copy.trivial (payload.id)
  %10: Chain [shared call] = read borrow.shared (rest) loan2 roots{1}
  %11: I32 = call idsOf borrow.shared %10
  %12: I32 = add inspect %9 inspect %11
  jump -> bb2(take %12)

bb2(%13: I32):
  return take %13

bb3:
  %4: I32 = const 0
  jump -> bb2(take %4)
}

fn buildChain() -> I32 {
  local c: Chain

bb0:
  %0: I32 = const 4
  %1: Tracked = call track borrow.shared %0
  %2: I32 = const 5
  %3: Tracked = call track borrow.shared %2
  %4: Chain = aggregate.End
  %5: Chain = aggregate.Link take %3 take %4
  %6: Chain = aggregate.Link take %1 take %5
  write.init borrow.unique (c) take %6
  %8: Chain [shared call] = read borrow.shared (c) loan0
  %9: I32 = call idsOf borrow.shared %8
  drop (c)
  return take %9
}

fn main() -> I32 {
  local values: I32
  local chained: I32

bb0:
  %0: I32 = call buildList
  %1: I32 = call buildTree
  %2: I32 = add inspect %0 inspect %1
  write.init borrow.unique (values) take %2
  %4: I32 = call buildChain
  write.init borrow.unique (chained) take %4
  %6: I32 = read copy.trivial (global liveNodes)
  %7: I32 = const 0
  %8: Bool = ne inspect %6 inspect %7
  branch inspect %8 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %13: I32 = read copy.trivial (values)
  %14: I32 = read copy.trivial (chained)
  %15: I32 = add inspect %13 inspect %14
  return take %15

bb3:
  %10: I32 = const -1
  return take %10
}

fn unwrapOr(Tree)(m: Maybe(Tree) [shared slot 0], fallback: Tree [shared slot 0]) -> Tree [shared slot 0] = <unwrapOr at Tree>

entry main
