module ResolveTest

fn absolute(x: I32 [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (x)
  %1: I32 = const 0
  %2: Bool = lt inspect %0 inspect %1
  branch inspect %2 -> bb3 -> bb1

bb1:
  %7: I32 = read copy.trivial (x)
  jump -> bb2(take %7)

bb2(%8: I32):
  return take %8

bb3:
  %4: I32 = const 0
  %5: I32 = read copy.trivial (x)
  %6: I32 = sub inspect %4 inspect %5
  jump -> bb2(take %6)
}

fn decrement(x: I32 [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (x)
  %1: I32 = const 1
  %2: I32 = sub inspect %0 inspect %1
  return take %2
}

fn stepped(x: I32 [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (x)
  %1: I32 = call decrement borrow.shared %0
  %2: I32 = const 1
  %3: I32 = add inspect %1 inspect %2
  return take %3
}

fn clamped(x: I32 [shared call], limit: I32 [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (x)
  %1: I32 = read copy.trivial (limit)
  %2: Bool = gt inspect %0 inspect %1
  branch inspect %2 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %7: I32 = read copy.trivial (x)
  %8: I32 = const 0
  %9: I32 = read copy.trivial (limit)
  %10: I32 = sub inspect %8 inspect %9
  %11: Bool = lt inspect %7 inspect %10
  branch inspect %11 -> bb6 -> bb4

bb3:
  %4: I32 = read copy.trivial (limit)
  return take %4

bb4:
  jump -> bb5

bb5:
  %18: I32 = read copy.trivial (x)
  return take %18

bb6:
  %13: I32 = const 0
  %14: I32 = read copy.trivial (limit)
  %15: I32 = sub inspect %13 inspect %14
  return take %15
}

fn below(x: a [shared call], y: a [shared call]) -> Bool {
  form specialized
  slot #0 type a
  slot #1 class Ord(a)
bb0:
  %0: a [shared call] = read borrow.shared (x) loan0
  %1: a [shared call] = read borrow.shared (y) loan1
  %2: Bool = call <(a) borrow.shared %0 borrow.shared %1
  branch inspect %2 -> bb3 -> bb1

bb1:
  %5: Bool = const False
  jump -> bb2(take %5)

bb2(%6: Bool):
  return take %6

bb3:
  %4: Bool = const True
  jump -> bb2(take %4)
}

fn source() -> I32 {
bb0:
  %0: I32 = const 0
  %1: I32 = const 4
  %2: I32 = sub inspect %0 inspect %1
  return take %2
}

fn main() -> I32 {
  local a: I32
  local b: I32
  local c: I32

bb0:
  %0: I32 = call source
  %1: I32 = call absolute borrow.shared %0
  write.init borrow.unique (a) take %1
  %3: I32 = const 3
  %4: I32 = call stepped borrow.shared %3
  write.init borrow.unique (b) take %4
  %6: I32 = const 99
  %7: I32 = const 5
  %8: I32 = call clamped borrow.shared %6 borrow.shared %7
  write.init borrow.unique (c) take %8
  %10: I32 = read copy.trivial (a)
  %11: I32 = read copy.trivial (c)
  %12: Bool = call below(I32) borrow.shared %10 borrow.shared %11
  branch inspect %12 -> bb3 -> bb1

bb1:
  %19: I32 = const 0
  jump -> bb2(take %19)

bb2(%20: I32):
  return take %20

bb3:
  %14: I32 = read copy.trivial (a)
  %15: I32 = read copy.trivial (b)
  %16: I32 = add inspect %14 inspect %15
  %17: I32 = read copy.trivial (c)
  %18: I32 = add inspect %16 inspect %17
  jump -> bb2(take %18)
}

fn below(I32)(x: I32 [shared call], y: I32 [shared call]) -> Bool = <below at I32>

entry main
