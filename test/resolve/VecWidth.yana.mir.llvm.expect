target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

@sink = global [8 x i8] zeroinitializer, align 8

define fastcc <4 x i16> @arithmetic(<4 x i16> %a) #0 {
  br label %1

1:                                                ; preds = %0
  %2 = add <4 x i16> %a, splat (i16 4)
  %3 = shl <4 x i16> %a, splat (i16 2)
  %4 = and <4 x i16> %2, %3
  %5 = shl <4 x i16> %4, splat (i16 4)
  %6 = sub <4 x i16> %5, %a
  ret <4 x i16> %6
}

define fastcc <4 x i8> @widths(<4 x i8> %narrow) #0 {
  br label %1

1:                                                ; preds = %0
  %2 = shl <4 x i8> %narrow, %narrow
  %3 = or <4 x i8> %narrow, %2
  ret <4 x i8> %3
}

define fastcc <4 x i32> @widening(<4 x i16> %v) #0 {
  br label %1

1:                                                ; preds = %0
  %2 = sext <4 x i16> %v to <4 x i32>
  ret <4 x i32> %2
}

define fastcc <4 x i16> @narrowing(<4 x i32> %v) #0 {
  br label %1

1:                                                ; preds = %0
  %2 = trunc <4 x i32> %v to <4 x i16>
  ret <4 x i16> %2
}

define fastcc <4 x float> @reinterpreting(<4 x i32> %v) #0 {
  br label %1

1:                                                ; preds = %0
  %2 = bitcast <4 x i32> %v to <4 x float>
  ret <4 x float> %2
}

define fastcc <4 x float> @aliases(<4 x float> %v) #0 {
  br label %1

1:                                                ; preds = %0
  ret <4 x float> %v
}

define fastcc i32 @main() #0 {
  br label %1

1:                                                ; preds = %0
  %2 = load <4 x i16>, ptr @sink, align 1
  %3 = call fastcc <4 x i16> @arithmetic(<4 x i16> %2)
  %4 = call fastcc <4 x i32> @widening(<4 x i16> %3)
  %5 = call fastcc <4 x i16> @narrowing(<4 x i32> %4)
  %6 = call fastcc <4 x float> @reinterpreting(<4 x i32> %4)
  %7 = call fastcc <4 x float> @aliases(<4 x float> %6)
  %8 = call fastcc <4 x i8> @widths(<4 x i8> splat (i8 1))
  %9 = bitcast <4 x float> %7 to <4 x i32>
  %10 = trunc <4 x i32> %9 to <4 x i16>
  %11 = xor <4 x i16> %5, %10
  %12 = zext <4 x i8> %8 to <4 x i16>
  %13 = xor <4 x i16> %11, %12
  store <4 x i16> %13, ptr @sink, align 1
  ret i32 1
}

attributes #0 = { "probe-stack"="inline-asm" }
