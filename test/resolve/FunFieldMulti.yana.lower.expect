@image$base = []

retarget<complex>(%slot: Ptr) {
  b_0 {
    store %slot, funvalue$triple, 8
    %v_1 = bitcast 0: Ptr
    %v_2 = add %slot, 8: Ptr
    store %v_2, %v_1, 8
    ret 
  }
}

retargetBoth<complex>(%a: Ptr, %b: Ptr) {
  b_0 {
    store %a, funvalue$negate, 8
    %v_1 = bitcast 0: Ptr
    %v_2 = add %a, 8: Ptr
    store %v_2, %v_1, 8
    store %b, funvalue$square, 8
    %v_3 = add %b, 8: Ptr
    store %v_3, %v_1, 8
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 32, 8: Ptr
    %v_2 = fun funvalue$double: Ptr
    store %v_1, %v_2, 8
    %v_3 = bitcast 0: Ptr
    %v_4 = add %v_1, 8: Ptr
    store %v_4, %v_3, 8
    %v_5 = add %v_1, 16: Ptr
    store %v_5, funvalue$triple, 8
    %v_6 = add %v_1, 24: Ptr
    store %v_6, %v_3, 8
    %v_7 = call_complex %v_2, %v_3, 10: I32
    %v_8 = add %v_1, 16: Ptr
    %v_9 = add %v_1, 24: Ptr
    %v_10 = load %v_8, 8: Ptr
    %v_11 = load %v_9, 8: Ptr
    %v_12 = call_complex %v_10, %v_11, 10: I32
    %before = add %v_7, %v_12: I32
    call_complex retarget, %v_1
    %v_13 = add %v_1, 8: Ptr
    %v_14 = load %v_1, 8: Ptr
    %v_15 = load %v_13, 8: Ptr
    %v_16 = call_complex %v_14, %v_15, 10: I32
    %v_17 = add %v_1, 16: Ptr
    %v_18 = add %v_1, 24: Ptr
    %v_19 = load %v_17, 8: Ptr
    %v_20 = load %v_18, 8: Ptr
    %v_21 = call_complex %v_19, %v_20, 10: I32
    %one = add %v_16, %v_21: I32
    %v_22 = add %v_1, 16: Ptr
    call_complex retargetBoth, %v_1, %v_22
    %v_23 = add %v_1, 8: Ptr
    %v_24 = load %v_1, 8: Ptr
    %v_25 = load %v_23, 8: Ptr
    %v_26 = call_complex %v_24, %v_25, 10: I32
    %v_27 = add %v_1, 16: Ptr
    %v_28 = add %v_1, 24: Ptr
    %v_29 = load %v_27, 8: Ptr
    %v_30 = load %v_28, 8: Ptr
    %v_31 = call_complex %v_29, %v_30, 10: I32
    %both = add %v_26, %v_31: I32
    %v_32 = add %before, %one: I32
    %v_33 = add %v_32, %both: I32
    ret %v_33
  }
}

funvalue$triple<complex>(%env: Ptr, %x: I32): I32 {
  b_0 {
    %v_1 = imul %x, 3: I32
    ret %v_1
  }
}

funvalue$negate<complex>(%env: Ptr, %x: I32): I32 {
  b_0 {
    %v_1 = sub 0, %x: I32
    ret %v_1
  }
}

funvalue$square<complex>(%env: Ptr, %x: I32): I32 {
  b_0 {
    %v_1 = imul %x, %x: I32
    ret %v_1
  }
}

funvalue$double<complex>(%env: Ptr, %x: I32): I32 {
  b_0 {
    %v_1 = shl %x, 1: I32
    ret %v_1
  }
}

