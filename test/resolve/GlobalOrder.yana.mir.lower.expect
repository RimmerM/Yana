mut @seen = [0, 0, 0, 0]

bump<complex>(): I32 {
  b_0 {
    %v_1 = loads @seen, 4: I32
    %v_2 = add %v_1, 5: I32
    store @seen, %v_2, 4
    ret 1
  }
}

readAfterCall<complex>(): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    store @seen, 0, 4
    %v_2 = call_complex bump: I32
    store %v_1, %v_2, 4
    %v_3 = loads @seen, 4: I32
    %v_4 = loads %v_1, 4: I32
    %v_5 = add %v_3, %v_4: I32
    ret %v_5
  }
}

readBeforeCall<complex>(): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    %v_2 = alloca 4, 4: Ptr
    store @seen, 3, 4
    %v_3 = loads @seen, 4: I32
    store %v_1, %v_3, 4
    %v_4 = call_complex bump: I32
    store %v_2, %v_4, 4
    %v_5 = loads %v_1, 4: I32
    %v_6 = imul %v_5, 100: I32
    %v_7 = loads %v_1, 4: I32
    %v_8 = imul %v_7, 10: I32
    %v_9 = add %v_6, %v_8: I32
    %v_10 = loads @seen, 4: I32
    %v_11 = add %v_9, %v_10: I32
    %v_12 = loads %v_2, 4: I32
    %v_13 = add %v_11, %v_12: I32
    ret %v_13
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = call_complex readAfterCall: I32
    %v_2 = imul %v_1, 1000: I32
    %v_3 = call_complex readBeforeCall: I32
    %v_4 = add %v_2, %v_3: I32
    ret %v_4
  }
}

