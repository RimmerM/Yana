main<complex>(): I32 {
  b_0 {
    %f = alloca 1, 1: Ptr
    store %f, 1, 1
    %handed = call_complex score, %f: I32
    %again = call_complex score, %f: I32
    %v_1 = add %handed, 1: I32
    %v_2 = add %v_1, %again: I32
    %v_3 = add %v_2, 8: I32
