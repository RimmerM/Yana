@image$base = []

score<complex>(%f: Ptr): I32 {
  b_0 {
    %v_1 = load %f, 1: I32
    %v_2 = and %v_1, 1: I32
    %v_3 = select %v_2, 10, 20: I32
    ret %v_3
  }
}

mutate<complex>(%f: Ptr): I32 {
  b_0 {
    %v_1 = bitcast %f: I64
    %v_2 = and %v_1, 281474976710655: I64
    %v_3 = bitcast %v_2: Ptr
