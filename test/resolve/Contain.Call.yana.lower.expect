    %v_5 = load %v_3, 1: I64
    %v_6 = shl 1, %v_4: I64
    %v_7 = not %v_6: I64
    %v_8 = and %v_5, %v_7: I64
    %v_9 = or %v_8, %v_6: I64
    store %v_3, %v_9, 1
