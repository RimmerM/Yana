fn read(%it: Point) -> Int {
  b0:
    %v1 = load %it@Point.x : Int
    %v2 = load %it@Point.y : Int
    %v3 = add %v1, %v2 : Int
    ret %v3
}

fn bump(%it: Point) -> () {
  b0:
    %v1 = load %it : Point
    %v2 = load %it@Point.x : Int
    %v5 = add %v2, 1 : Int
    assign %it@Point.x, %v5
    ret
}

fn onlyRead() -> Int {
  b0:
    %p = alloc : Point
    init %local0@Point.x, 1
    init %local0@Point.y, 2
    %v5 = call read, %p : Int
    %v6 = call read, %p : Int
    %v7 = add %v5, %v6 : Int
    ret %v7
