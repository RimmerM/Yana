module ResolveTest

data Held {n: I32} drop authored

data Trio {held: Held, x: I32, y: I32} drop derived

instance Drop(Held): Held.drop

let & live: I32 = 0

fn Held.drop(value: Held) -> {} {
bb0:
  %0: I32 = read copy.trivial (global live)
  %1: I32 = const 1
  %2: I32 = sub inspect %0 inspect %1
  write.assign borrow.unique (global live) take %2
  return
}

fn hold(n: I32 [shared call]) -> Held {
bb0:
  %0: I32 = read copy.trivial (global live)
  %1: I32 = const 1
  %2: I32 = add inspect %0 inspect %1
  write.assign borrow.unique (global live) take %2
  %4: I32 = read copy.trivial (n)
  %5: Held = aggregate.Held take %4
  return take %5
}

fn total(t: Trio [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (t.held.n)
  %1: I32 = read copy.trivial (t.x)
  %2: I32 = add inspect %0 inspect %1
  %3: I32 = read copy.trivial (t.y)
  %4: I32 = add inspect %2 inspect %3
  return take %4
}

fn build(n: I32 [shared call]) -> Trio {
bb0:
  %0: I32 = read copy.trivial (n)
  %1: Held = call hold borrow.shared %0
  %2: I32 = read copy.trivial (n)
  %3: I32 = const 2
  %4: I32 = mul inspect %2 inspect %3
  %5: I32 = read copy.trivial (n)
  %6: I32 = const 3
  %7: I32 = mul inspect %5 inspect %6
  %8: Trio = aggregate.Trio take %1 take %4 take %7
  return take %8
}

fn main() -> I32 {
  local & sum: I32
  local & local1: I32
  local i: I32
  local t: Trio

bb0:
  %0: I32 = const 0
  write.init borrow.unique (sum) take %0
  %2: I32 = const 1
  %3: I32 = const 4
  %4: I32 = const 1
  write.init borrow.unique (local1) take %2
  jump -> bb1(take %3, take %4)

bb1(%5: I32, %6: I32):
  %13: I32 = read copy.trivial (local1)
  %14: Bool = lt inspect %13 inspect %5
  branch inspect %14 -> bb4(take %5, take %6) -> bb3(take %5, take %6)

bb2(%7: I32, %8: I32):
  %28: I32 = read copy.trivial (local1)
  %29: I32 = add inspect %28 inspect %8
  write.assign borrow.unique (local1) take %29
  jump -> bb1(take %7, take %8)

bb3(%9: I32, %10: I32):
  %32: I32 = read copy.trivial (sum)
  %33: I32 = const 1000
  %34: I32 = mul inspect %32 inspect %33
  %35: I32 = read copy.trivial (global live)
  %36: I32 = add inspect %34 inspect %35
  return take %36

bb4(%15: I32, %16: I32):
  %18: I32 = read copy.trivial (local1)
  write.init borrow.unique (i) take %18
  %20: I32 = read copy.trivial (i)
  %21: Trio = call build borrow.shared %20
  write.init borrow.unique (t) take %21
  %23: I32 [unique call] = read borrow.unique (sum) loan0
  %24: Trio [shared call] = read borrow.shared (t) loan1
  %25: I32 = call total borrow.shared %24
  drop (t)
  %26: {} = call +=(I32) borrow.unique %23 borrow.shared %25
  jump -> bb2(take %15, take %16)
}

entry main
