-- `@platform(js)` and `@platform(native)` - Analysis-JS.md §2.4, and the mechanism two
-- implementation documents already cited as though it existed.
--
-- The point of the attribute is not conditional compilation for its own sake: it is that `String`,
-- `Array`, `Map` and `Storage` need per-target *implementations* rather than per-target Repr, since
-- a three-word capacity record wrapping a host `Array` is exactly the overhead the JS performance
-- contract forbids. An excluded declaration is not resolved at all, so it contributes no name, no
-- type, no instance and no body - which is what keeps a JS build from ever resolving a call to the
-- native implementation of something.
--
-- This fixture is compiled twice by the driver, once per target, and the two expect files are what
-- the two builds see. Everything not marked is shared, which is the ordinary case.
--
-- It is also the one fixture whose two targets answer differently when run, which is why it has a
-- `.js.run.expect` beside its `.run.expect`. Everywhere else the driver holds the JS build to the
-- number the amd64 build produced - agreeing is the property worth asserting - and a second file is
-- how a fixture says the difference is a property of the program rather than of the backends.

-- One name, two declarations, and only one of them exists in any given build.
@platform(native)
fn backend() -> Int = 1

@platform(js)
fn backend() -> Int = 2

-- The same for a type. A record excluded on one target takes its constructors and its field names
-- with it, so nothing in the other build can name them by accident.
@platform(native)
data Storage {capacity: Int, count: Int}

@platform(js)
data Storage {count: Int}

@platform(native)
fn emptyStorage() -> Storage = Storage {capacity: 0, count: 0}

@platform(js)
fn emptyStorage() -> Storage = Storage {count: 0}

@platform(native)
fn capacityOf(s: Storage) -> Int = s.capacity

-- On JS there is no capacity to report: a host array grows on its own, so `reserve` returning true
-- and doing nothing is the honest answer rather than a number to keep in step.
@platform(js)
fn capacityOf(s: Storage) -> Int = 0

-- An attribute list may also name both, which is every target and therefore says nothing. It is
-- accepted so that a declaration can be marked while its second implementation is still being
-- written.
@platform(js, native)
fn shared(x: Int) -> Int = x * 10

-- The other two axes, which are the file selector's vocabulary asked of one declaration -
-- Analysis-Modules.md §2.5. An operating system and an architecture both exclude a JS build, since a
-- target with no syscalls and no registers has neither, so these two are the native pair over again
-- said in the terms a second machine would need.
@platform(linux)
fn placement() -> Int = 10

@platform(js)
fn placement() -> Int = 20

@platform(x64)
fn word() -> Int = 8

@platform(js)
fn word() -> Int = 4

-- Two attributes read as "and" where a list reads as "or", so this is the one declaration in the
-- file that names a single machine rather than a family.
@platform(native)
@platform(x64)
fn onlyAmd64() -> Int = 3

@platform(js)
fn onlyAmd64() -> Int = 0

fn main() -> Int:
    let s = emptyStorage()
    return backend() + capacityOf(s) + shared(4) + placement() + word() + onlyAmd64()
