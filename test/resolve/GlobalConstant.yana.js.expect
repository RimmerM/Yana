"use strict";
var table = [{ a: 3000000000000n, b: 4 }, { a: null, b: 5 }];
var tree = null;

// Core
function checkCondition(failed) {
  if (failed) {
    throw "yana: a runtime check failed";
  }
}

// ResolveTest
function niched() {
  var n = 0;
  var v9 = 0;
  while (v9 < 2) {
    var i = v9;
    var v29 = i >>> 0;
    checkCondition(v29 >= 2 ? 1 : 0);
    if (!(table[i].a === null)) {
      if (BigInt.asIntN(64, table[i].a & 255n) === 0n) {
        n = n + 1 | 0;
      }
    }
    checkCondition(v29 >= 2 ? 1 : 0);
    n = n + table[i].b | 0;
    v9 = v9 + 1 | 0;
  }
  return n;
}

function main() {
  var v16;
  var v0 = niched();
  if (!(tree === null)) {
    v16 = tree.mark;
  } else {
    v16 = 7;
  }
  return v0 + Math.imul(v16, 100) | 0;
}
main();
