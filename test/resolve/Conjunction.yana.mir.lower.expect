  }

  b_11 {
    %v_14 = phi [b_9, %v_10], [b_8, %v_12]: Ptr
    %v_15 = load %v_14, 1: I32
    %v_16 = add %v_14, 4: Ptr
    %v_17 = load %v_16, 4: I32
    %v_18 = cmp_eq %v_15, 0: I32
    je %v_18, b_19, b_20
  }

  b_19 {
    %v_21 = cmp_igt %v_17, 2: I32
    je %v_21, b_3, b_20
  }

  b_20 {
    %v_22 = cmp_eq %v_5, 7: I32
    %v_23 = select %v_22, 4095, 2047: I32
    %v_24 = loads @trace, 4: I32
    %v_25 = add %v_24, 1: I32
    store @trace, %v_25, 4
    %v_26 = loads @trace, 4: I32
    %v_27 = add %v_26, 2: I32
    store @trace, %v_27, 4
    %v_28 = loads @trace, 4: I32
    %v_29 = add %v_28, 4: I32
    store @trace, %v_29, 4
    %v_30 = add %v_23, 126976: I32
    %v_31 = loads @trace, 4: I32
    %v_32 = cmp_eq %v_31, 7: I32
    %v_33 = add %v_23, 258048: I32
    %v_34 = select %v_32, %v_33, %v_30: I32
    ret %v_34
  }

