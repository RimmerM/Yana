mut @trace = [0, 0, 0, 0]

main<complex>(): I32 {
  b_0 {
    jmp b_1
  }

  b_1 {
    %v_2 = phi [b_0, 4], [b_3, %v_4]: I32
    %v_5 = phi [b_0, 0], [b_3, %v_6]: I32
    %v_7 = cmp_igt %v_2, 0: I32
    je %v_7, b_8, b_9
  }

  b_9 {
    jmp b_10
  }

  b_8 {
    jmp b_10
  }

  b_10 {
    %v_11 = phi [b_9, 1], [b_8, 0]: I32
    %v_12 = phi [b_9, 0], [b_8, %v_2]: I32
    je %v_11, b_13, b_14
  }

  b_14 {
    %v_15 = cmp_igt %v_12, 2: I32
    je %v_15, b_3, b_13
  }

  b_13 {
    %v_16 = cmp_eq %v_5, 7: I32
    %v_17 = select %v_16, 4095, 2047: I32
    %v_18 = loads @trace, 4: I32
    %v_19 = add %v_18, 7: I32
    store @trace, %v_19, 4
    %v_20 = add %v_17, 126976: I32
    %v_21 = cmp_eq %v_19, 7: I32
    %v_22 = add %v_17, 258048: I32
    %v_23 = select %v_21, %v_22, %v_20: I32
    ret %v_23
  }

  b_3 {
    %v_6 = add %v_5, %v_12: I32
    %v_4 = sub %v_2, 1: I32
    jmp b_1
  }
}

