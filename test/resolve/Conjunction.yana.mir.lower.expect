mut @trace = [0, 0, 0, 0]

main<complex>(): I32 {
  b_0 {
    jmp b_1
  }

  b_1 {
    %v_2 = phi [b_0, 4], [b_3, %v_4]: I32
    %v_5 = phi [b_0, 0], [b_3, %v_6]: I32
    %v_7 = cmp_igt %v_2, 0: I32
    je %v_7, b_8, b_9
  }

  b_9 {
    %v_10 = alloca 8, 4: Ptr
    store %v_10, 1, 1
    jmp b_11
  }

