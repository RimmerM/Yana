mut @trace = [0, 0, 0, 0]

main<complex>(): I32 {
  b_0 {
    jmp b_1
  }

  b_1 {
    %v_2 = phi [b_0, 4], [b_3, %v_4]: I32
    %v_5 = phi [b_0, 0], [b_3, %v_6]: I32
    %v_7 = cmp_igt %v_2, 0: I32
    je %v_7, b_8, b_9
  }

  b_8 {
    %v_10 = cmp_igt %v_2, 2: I32
    je %v_10, b_3, b_9
  }

  b_9 {
    %v_11 = cmp_eq %v_5, 7: I32
    %v_12 = select %v_11, 4095, 2047: I32
    %v_13 = loads @trace, 4: I32
    %v_14 = add %v_13, 7: I32
    store @trace, %v_14, 4
    %v_15 = add %v_12, 126976: I32
    %v_16 = cmp_eq %v_14, 7: I32
    %v_17 = add %v_12, 258048: I32
    %v_18 = select %v_16, %v_17, %v_15: I32
    ret %v_18
  }

  b_3 {
    %v_6 = add %v_5, %v_2: I32
    %v_4 = sub %v_2, 1: I32
    jmp b_1
  }
}

