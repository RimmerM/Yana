fn touchInt(m: Map(I32, I32) [shared call]) -> I32 {
  local & n: I32
  local local2: Maybe(I32) [owned here shape2 .0=shared slot 0]
  local v: I32

bb0:
  %0: I32 = const 0
  write.init borrow.unique (n) take %0
  %2: Map(I32, I32) [shared slot 0] = read borrow.shared (m) loan0
  %3: I32 = const 1
  %4: Maybe(I32) [owned here shape2 .0=shared slot 0] = call find(I32, I32) borrow.shared %2 borrow.shared %3 roots.0{0}
  write.init borrow.unique (local2) take %4
  %6: U8 = read copy.trivial (local2.#)
  %7: U8 = const 1
  %8: Bool = eq inspect %6 inspect %7
  branch inspect %8 -> bb3 -> bb1

bb1:
