@image$base = []
mut @sink = [0, 0, 0, 0, 0, 0, 0, 0]

quadWidth<complex>(%v: i16x4): I32 {
  b_0 {
    %v_1 = call_complex widthOf(4), %v: I32
    ret %v_1
  }
}

main$<complex>(): I32 {
  b_0 {
    %v_1 = vsplat 0: i16x4
    store @sink, %v_1, 8
    %v = vwithlane %v_1, 9, 1: i16x4
    %wide = call_complex doubled(4), %v: i16x4
    %v_2 = call_complex twice(4), %v: i16x4
    %v_3 = call_complex sameCount(4), %v, %wide: i16x4
    %summed = call_complex sameCount(4), %v_2, %v_3: i16x4
    store @sink, %wide, 8
    %v_4 = call_complex widthOf(4), %v: I32
    %v_5 = call_complex quadWidth, %v: I32
    %v_6 = add %v_4, %v_5: I32
    %v_7 = call_complex secondLane(4), %wide: I32
    %v_8 = add %v_6, %v_7: I32
    %v_9 = call_complex secondLane(4), %summed: I32
    %v_10 = add %v_8, %v_9: I32
    %v_11 = vlane %summed, 2: I32
    %v_12 = imm 16: I32
    %v_13 = shl %v_11, %v_12: I32
    %v_14 = sar %v_13, %v_12: I32
    %v_15 = add %v_10, %v_14: I32
    ret %v_15
  }
}

widthOf(4)<complex>(%v: i16x4): I32 {
  b_0 {
    ret 4
  }
}

doubled(4)<complex>(%v: i16x4): i16x4 {
  b_0 {
    %v_1 = vshuffle %v, %v, 3, 2, 1, 0: i16x4
    %v_2 = cmp_igt %v_1, %v: m16x4
    %v_3 = select %v_2, %v_1, %v: i16x4
    ret %v_3
  }
}

twice(4)<complex>(%v: i16x4): i16x4 {
  b_0 {
    %v_1 = add %v, %v: i16x4
    ret %v_1
  }
}

sameCount(4)<complex>(%v: i16x4, %w: i16x4): i16x4 {
  b_0 {
    %v_1 = add %v, %w: i16x4
    ret %v_1
  }
}

secondLane(4)<complex>(%v: i16x4): I32 {
  b_0 {
    %v_1 = vlane %v, 1: I32
    %v_2 = imm 16: I32
    %v_3 = shl %v_1, %v_2: I32
    %v_4 = sar %v_3, %v_2: I32
    ret %v_4
  }
}

