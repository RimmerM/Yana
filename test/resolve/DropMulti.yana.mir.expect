module ResolveTest

data Buffer {bytes: %U8} drop authored

data Slot = Empty | One {only: Buffer} | Two {first: Buffer, second: Buffer} drop derived

instance Drop(Buffer): Buffer.drop

let & liveBuffers: I64 = 0

fn makeBuffer(size: Size [shared call]) -> Buffer {
bb0:
  %0: I64 [unique call] = read borrow.unique (global liveBuffers) loan0
  %1: I64 = const 1
  %2: {} = call +=(I64) borrow.unique %0 borrow.shared %1
  %3: Size = read copy.trivial (size)
  %4: %U8 = call allocateHeap borrow.shared %3
  %5: Buffer = aggregate.Buffer take %4
  return take %5
}

fn Buffer.drop(value: Buffer) -> {} {
bb0:
  %0: %U8 = read copy.trivial (value.bytes)
  %1: {} = call freeHeap borrow.shared %0
  %2: I64 [unique call] = read borrow.unique (global liveBuffers) loan0
  %3: I64 = const 1
  %4: {} = call -=(I64) borrow.unique %2 borrow.shared %3
  return
}

fn touch(it: Slot [shared call]) -> I64 {
bb0:
  %0: I64 = const 0
  return take %0
}

fn holdsTwo() -> I64 {
  local s: Slot
  local counted: I64

bb0:
  %0: Size = const 16
  %1: Buffer = call makeBuffer borrow.shared %0
  %2: Size = const 16
  %3: Buffer = call makeBuffer borrow.shared %2
  %4: Slot = aggregate.Two take %1 take %3
  write.init borrow.unique (s) take %4
  %6: I64 = read copy.trivial (global liveBuffers)
  write.init borrow.unique (counted) take %6
  %8: I64 = read copy.trivial (counted)
  %9: Slot [shared call] = read borrow.shared (s) loan0
  %10: I64 = call touch borrow.shared %9
  drop (s)
  %11: I64 = add inspect %8 inspect %10
  return take %11
}

fn holdsOne() -> I64 {
  local s: Slot
  local counted: I64

bb0:
  %0: Size = const 16
  %1: Buffer = call makeBuffer borrow.shared %0
  %2: Slot = aggregate.One take %1
  write.init borrow.unique (s) take %2
  %4: I64 = read copy.trivial (global liveBuffers)
  write.init borrow.unique (counted) take %4
  %6: I64 = read copy.trivial (counted)
  %7: Slot [shared call] = read borrow.shared (s) loan0
  %8: I64 = call touch borrow.shared %7
  drop (s)
  %9: I64 = add inspect %6 inspect %8
  return take %9
}

fn holdsNothing() -> I64 {
  local s: Slot
  local counted: I64

bb0:
  %0: Slot = aggregate.Empty
  write.init borrow.unique (s) take %0
  %2: I64 = read copy.trivial (global liveBuffers)
  write.init borrow.unique (counted) take %2
  %4: I64 = read copy.trivial (counted)
  %5: Slot [shared call] = read borrow.shared (s) loan0
  %6: I64 = call touch borrow.shared %5
  drop (s)
  %7: I64 = add inspect %4 inspect %6
  return take %7
}

fn main() -> I32 {
  local two: I64
  local one: I64
  local none: I64

bb0:
  %0: I64 = call holdsTwo
  write.init borrow.unique (two) take %0
  %2: I64 = call holdsOne
  write.init borrow.unique (one) take %2
  %4: I64 = call holdsNothing
  write.init borrow.unique (none) take %4
  %6: I64 = read copy.trivial (two)
  %7: I64 = const 100
  %8: I64 = mul inspect %6 inspect %7
  %9: I64 = read copy.trivial (one)
  %10: I64 = const 10
  %11: I64 = mul inspect %9 inspect %10
  %12: I64 = add inspect %8 inspect %11
  %13: I64 = read copy.trivial (none)
  %14: I64 = add inspect %12 inspect %13
  %15: I64 = read copy.trivial (global liveBuffers)
  %16: I64 = add inspect %14 inspect %15
  %17: I32 = convert inspect %16
  return take %17
}

entry main
