  %37: I32 = add inspect %32 inspect %36
  write.init borrow.unique (controls) take %37
  %39: I8 = read copy.trivial (m8)
  %40: Vec(I8) = vec.splat inspect %39
  write.init borrow.unique (s) take %40
  %42: I16 = read copy.trivial (m16)
  %43: Vec(I16) = vec.splat inspect %42
  write.init borrow.unique (t) take %43
  %45: I8 = const 1
  %46: Vec(I8) = vec.splat inspect %45
