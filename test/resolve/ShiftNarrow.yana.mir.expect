module ResolveTest

fn shr8(x: I8 [shared call], n: I8 [shared call]) -> I8 {
bb0:
  %0: I8 = read copy.trivial (x)
  %1: I8 = read copy.trivial (n)
  %2: I8 = shr inspect %0 inspect %1
  return take %2
}

fn shr16(x: I16 [shared call], n: I16 [shared call]) -> I16 {
bb0:
  %0: I16 = read copy.trivial (x)
  %1: I16 = read copy.trivial (n)
  %2: I16 = shr inspect %0 inspect %1
