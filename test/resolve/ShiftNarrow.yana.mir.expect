  %49: Vec(I16) = vec.splat inspect %48
  write.init borrow.unique (three) take %49
  %51: Vec(I8) = read copy.trivial (s)
  %52: Vec(I8) = read copy.trivial (one)
  %53: Vec(I8) = shr inspect %51 inspect %52
  %54: I32 = const 0
  %55: I8 = vec.lane #0 inspect %53
  %56: I32 = convert inspect %55
  %57: Vec(I8) = read copy.trivial (s)
  %58: Vec(I8) = read copy.trivial (one)
  %59: Vec(I8) = sar inspect %57 inspect %58
