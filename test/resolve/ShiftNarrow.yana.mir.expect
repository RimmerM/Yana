bb0:
  %0: I32 = read copy.trivial (x)
  %1: I32 = read copy.trivial (n)
  %2: I32 = shr inspect %0 inspect %1
  return take %2
}

fn sar8(x: I8 [shared call], n: I8 [shared call]) -> I8 {
bb0:
  %0: I8 = read copy.trivial (x)
  %1: I8 = read copy.trivial (n)
  %2: I8 = sar inspect %0 inspect %1
  return take %2
}

