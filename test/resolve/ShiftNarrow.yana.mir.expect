  %72: I32 = read copy.trivial (scalars)
  %73: I32 = read copy.trivial (controls)
  %74: I32 = add inspect %72 inspect %73
  %75: I32 = read copy.trivial (lanes)
  %76: I32 = add inspect %74 inspect %75
