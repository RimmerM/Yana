target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

@"image$base" = constant [0 x i8] zeroinitializer, align 8
@seed = global [4 x i8] c"\03\00\00\00", align 8

define fastcc i32 @main() {
  br label %1

1:                                                ; preds = %0
  %2 = load i32, ptr @seed, align 1
  %.splatinsert = insertelement <4 x i32> poison, i32 %2, i32 0
  %base = shufflevector <4 x i32> %.splatinsert, <4 x i32> poison, <4 x i32> zeroinitializer
  %3 = add <4 x i32> %base, %base
  %4 = mul <4 x i32> %base, <i32 2, i32 2, i32 2, i32 2>
  %5 = extractelement <4 x i32> %3, i32 0
  %6 = icmp ne i32 %5, 6
  %7 = zext i1 %6 to i32
  br i1 %6, label %8, label %9

8:                                                ; preds = %1
  ret i32 -1

9:                                                ; preds = %1
  br label %10

10:                                               ; preds = %9
  %11 = extractelement <4 x i32> %4, i32 1
  %12 = icmp ne i32 %11, 6
  %13 = zext i1 %12 to i32
  br i1 %12, label %14, label %15

14:                                               ; preds = %10
  ret i32 -2

15:                                               ; preds = %10
  br label %16

16:                                               ; preds = %15
  %mixed = insertelement <4 x i32> %base, i32 10, i32 0
  %17 = call i32 @llvm.vector.reduce.smax.v4i32(<4 x i32> %mixed)
  %18 = icmp ne i32 %17, 10
  %19 = zext i1 %18 to i32
  br i1 %18, label %20, label %21

20:                                               ; preds = %16
  ret i32 -3

21:                                               ; preds = %16
  br label %22

22:                                               ; preds = %21
  %23 = call i32 @llvm.vector.reduce.smin.v4i32(<4 x i32> %mixed)
  %24 = icmp ne i32 %23, 3
  %25 = zext i1 %24 to i32
  br i1 %24, label %26, label %27

26:                                               ; preds = %22
  ret i32 -4

27:                                               ; preds = %22
  br label %28

28:                                               ; preds = %27
  br label %36

29:                                               ; preds = %36
  %30 = icmp slt i32 %40, 4
  %31 = zext i1 %30 to i32
  br i1 %30, label %36, label %32

32:                                               ; preds = %29
  %33 = extractelement <4 x i32> %39, i32 0
  %34 = icmp ne i32 %33, 15
  %35 = zext i1 %34 to i32
  br i1 %34, label %41, label %42

36:                                               ; preds = %29, %28
  %37 = phi <4 x i32> [ %39, %29 ], [ %base, %28 ]
  %38 = phi i32 [ %40, %29 ], [ 0, %28 ]
  %39 = add <4 x i32> %37, %base
  %40 = add i32 %38, 1
  br label %29

41:                                               ; preds = %32
  ret i32 -5

42:                                               ; preds = %32
  br label %43

43:                                               ; preds = %42
  %44 = extractelement <4 x i32> %39, i32 1
  %45 = icmp ne i32 %44, 15
  %46 = zext i1 %45 to i32
  br i1 %45, label %47, label %48

47:                                               ; preds = %43
  ret i32 -6

48:                                               ; preds = %43
  br label %49

49:                                               ; preds = %48
  %lanes = call i32 @llvm.vector.reduce.add.v4i32(<4 x i32> <i32 1, i32 1, i32 1, i32 1>)
  %50 = call i32 @llvm.vector.reduce.add.v4i32(<4 x i32> %39)
  %51 = mul i32 %lanes, 15
  %52 = icmp ne i32 %50, %51
  %53 = zext i1 %52 to i32
  br i1 %52, label %54, label %55

54:                                               ; preds = %49
  ret i32 -7

55:                                               ; preds = %49
  br label %56

56:                                               ; preds = %55
  %57 = extractelement <4 x i32> %3, i32 1
  %58 = mul i32 %57, 100
  %59 = extractelement <4 x i32> %4, i32 0
  %60 = add i32 %58, %59
  %61 = extractelement <4 x i32> %mixed, i32 0
  %62 = add i32 %60, %61
  ret i32 %62
}

; Function Attrs: nocallback nofree nosync nounwind readnone willreturn
declare i32 @llvm.vector.reduce.smax.v4i32(<4 x i32>) #0

; Function Attrs: nocallback nofree nosync nounwind readnone willreturn
declare i32 @llvm.vector.reduce.smin.v4i32(<4 x i32>) #0

; Function Attrs: nocallback nofree nosync nounwind readnone willreturn
declare i32 @llvm.vector.reduce.add.v4i32(<4 x i32>) #0

attributes #0 = { nocallback nofree nosync nounwind readnone willreturn }
