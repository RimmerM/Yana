target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

module asm "\09.set \22image$base\22, 0"

@"image$base" = external constant [0 x i8], align 8
@seed = global [4 x i8] c"\03\00\00\00", align 8

define fastcc i32 @main() #0 {
  br label %1

1:                                                ; preds = %0
  %2 = load i32, ptr @seed, align 1
  %.splatinsert = insertelement <4 x i32> poison, i32 %2, i64 0
  %base = shufflevector <4 x i32> %.splatinsert, <4 x i32> poison, <4 x i32> zeroinitializer
  %3 = add <4 x i32> %base, %base
  %4 = shl <4 x i32> %base, splat (i32 1)
  %5 = extractelement <4 x i32> %3, i32 0
  %6 = icmp ne i32 %5, 6
  %7 = zext i1 %6 to i32
  br i1 %6, label %8, label %9

8:                                                ; preds = %1
  ret i32 -1

9:                                                ; preds = %1
  %10 = extractelement <4 x i32> %4, i32 1
  %11 = icmp ne i32 %10, 6
  %12 = zext i1 %11 to i32
  br i1 %11, label %13, label %14

13:                                               ; preds = %9
  ret i32 -2

14:                                               ; preds = %9
  %mixed = insertelement <4 x i32> %base, i32 10, i32 0
  %15 = call i32 @llvm.vector.reduce.smax.v4i32(<4 x i32> %mixed)
  %16 = icmp ne i32 %15, 10
  %17 = zext i1 %16 to i32
  br i1 %16, label %18, label %19

18:                                               ; preds = %14
  ret i32 -3

19:                                               ; preds = %14
  %20 = call i32 @llvm.vector.reduce.smin.v4i32(<4 x i32> %mixed)
  %21 = icmp ne i32 %20, 3
  %22 = zext i1 %21 to i32
  br i1 %21, label %23, label %24

23:                                               ; preds = %19
  ret i32 -4

24:                                               ; preds = %19
  br label %32

25:                                               ; preds = %32
  %26 = icmp slt i32 %36, 4
  %27 = zext i1 %26 to i32
  br i1 %26, label %32, label %28

28:                                               ; preds = %25
  %29 = extractelement <4 x i32> %35, i32 0
  %30 = icmp ne i32 %29, 15
  %31 = zext i1 %30 to i32
  br i1 %30, label %37, label %38

32:                                               ; preds = %25, %24
  %33 = phi <4 x i32> [ %35, %25 ], [ %base, %24 ]
  %34 = phi i32 [ %36, %25 ], [ 0, %24 ]
  %35 = add <4 x i32> %33, %base
  %36 = add i32 %34, 1
  br label %25

37:                                               ; preds = %28
  ret i32 -5

38:                                               ; preds = %28
  %39 = extractelement <4 x i32> %35, i32 1
  %40 = icmp ne i32 %39, 15
  %41 = zext i1 %40 to i32
  br i1 %40, label %42, label %43

42:                                               ; preds = %38
  ret i32 -6

43:                                               ; preds = %38
  %lanes = call i32 @llvm.vector.reduce.add.v4i32(<4 x i32> splat (i32 1))
  %44 = call i32 @llvm.vector.reduce.add.v4i32(<4 x i32> %35)
  %45 = mul i32 %lanes, 15
  %46 = icmp ne i32 %44, %45
  %47 = zext i1 %46 to i32
  br i1 %46, label %48, label %49

48:                                               ; preds = %43
  ret i32 -7

49:                                               ; preds = %43
  %50 = extractelement <4 x i32> %3, i32 1
  %51 = mul i32 %50, 100
  %52 = extractelement <4 x i32> %4, i32 0
  %53 = add i32 %51, %52
  %54 = extractelement <4 x i32> %mixed, i32 0
  %55 = add i32 %53, %54
  ret i32 %55
}

; Function Attrs: nocallback nofree nosync nounwind speculatable willreturn memory(none)
declare i32 @llvm.vector.reduce.smax.v4i32(<4 x i32>) #1

; Function Attrs: nocallback nofree nosync nounwind speculatable willreturn memory(none)
declare i32 @llvm.vector.reduce.smin.v4i32(<4 x i32>) #1

; Function Attrs: nocallback nofree nosync nounwind speculatable willreturn memory(none)
declare i32 @llvm.vector.reduce.add.v4i32(<4 x i32>) #1

attributes #0 = { "probe-stack"="inline-asm" }
attributes #1 = { nocallback nofree nosync nounwind speculatable willreturn memory(none) }
