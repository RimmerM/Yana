"use strict";
// ResolveTest
function firstOver(limit, count) {
  var i = 0;
  while (i < count) {
    if (Math.imul(i, i) > limit) {
      return i;
    } else {
      i = i + 1 | 0;
    }
  }
  return -1;
}

function firstPair(target, rows) {
  var row = 0;
  while (row < rows) {
    var column = 0;
    while (column < rows) {
      if ((Math.imul(row, rows) + column | 0) === target) {
        return Math.imul(row, 100) + column | 0;
      } else {
        column = column + 1 | 0;
      }
    }
    row = row + 1 | 0;
  }
  return -1;
}

function neverRuns() {
  var total = 7;
  var i = 0;
  while (i > 0) {
    total = total + 1 | 0;
    i = i - 1 | 0;
  }
  return total;
}

function joined(flag, a, b) {
  var chosen;
  if (flag) {
    chosen = { x: a, y: 1 };
  } else {
    chosen = { x: b, y: 0 };
  }
  var v13 = chosen.y;
  if (v13 === 1) {
    return chosen.x + v13 | 0;
  } else {
    return chosen.x - v13 | 0;
  }
}

function main() {
  var v6 = firstOver(30, 20) + firstPair(14, 5) | 0;
  var total = 0;
  var i = 0;
  while (i < 10) {
    total = total + i | 0;
    i = i + 1 | 0;
  }
  return (((v6 + total | 0) + neverRuns() | 0) + joined(1, 3, 9) | 0) + joined(0, 3, 9) | 0;
}
main();
