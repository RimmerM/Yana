"use strict";
// ResolveTest
function firstOver(limit, count) {
  var i = 0;
  L0: for (;;) {
    if (i < count) {
      if (Math.imul(i, i) > limit) {
        return i;
      } else {
        i = i + 1 | 0;
        continue L0;
      }
    } else {
      return -1;
    }
    break L0;
  }
}

function firstPair(target, rows) {
  var row = 0;
  L0: for (;;) {
    if (row < rows) {
      var column = 0;
      L1: for (;;) {
        if (column < rows) {
          if ((Math.imul(row, rows) + column | 0) === target) {
            return Math.imul(row, 100) + column | 0;
          } else {
