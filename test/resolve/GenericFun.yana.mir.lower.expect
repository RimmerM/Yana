
main<complex>(): I32 {
  b_0 {
    jmp b_1
  }

  b_1 {
    jmp b_2
  }

  b_2 {
    jmp b_3
  }

  b_3 {
    jmp b_4
  }

  b_4 {
    %v_5 = alloca 8, 4: Ptr
    store %v_5, 1, 1
    %v_6 = add %v_5, 4: Ptr
    store %v_6, 6, 4
    %v_7 = call_complex orElseKept(I32), %v_5, 0: I32
    %v_8 = add 51, %v_7: I32
    %v_9 = alloca 1, 1: Ptr
    store %v_9, 2, 1
    %v_10 = call_complex orElseKept(Bool), %v_9, 1: I32
    %v_11 = select %v_10, 9, 0: I32
    %v_12 = add %v_8, %v_11: I32
    ret %v_12
  }
}

orElseKept(I32)<complex>(%value: Ptr, %fallback: I32): I32 {
  b_0 {
    %v_1 = load %value, 1: I32
    %v_2 = add %value, 4: Ptr
    %v_3 = load %v_2, 4: I32
    %v_4 = cmp_eq %v_1, 1: I32
    je %v_4, b_5, b_6
  }

  b_6 {
    jmp b_7
  }

  b_7 {
    %v_8 = phi [b_6, %fallback], [b_5, %v_3]: I32
    ret %v_8
  }

  b_5 {
    jmp b_7
  }
}

orElseKept(Bool)<complex>(%value: Ptr, %fallback: I32): I32 {
  b_0 {
    %v_1 = load %value, 1: I64
    %v_2 = cmp_le %v_1, 1: I32
    je %v_2, b_3, b_4
  }

  b_4 {
    jmp b_5
  }

  b_5 {
    %v_6 = phi [b_4, %fallback], [b_3, %v_7]: I32
    ret %v_6
  }

  b_3 {
    %v_7 = cast %v_1: I32
    jmp b_5
  }
}

