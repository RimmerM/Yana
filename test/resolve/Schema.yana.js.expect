function identity_Int(value) {
  return value;
}

function scale_Int(x, y) {
  return (Math.imul(x, y) | 0) + x | 0;
}

function smallest_Int(x, y, z) {
  var v3;
  var v4;
  var v5;
  if (x < y) {
    if (x < z) {
      v3 = x;
    } else {
      v3 = z;
    }
    v5 = v3;
  } else {
    if (y < z) {
      v4 = y;
    } else {
      v4 = z;
    }
    v5 = v4;
  }
  return v5;
}

function bothEqual_Int_Bool(p, q, r, s) {
  return p === q & r === s;
}

function pairUp_Int_Bool(x, y) {
  return { first: x, second: y };
}

