
main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    %v_2 = alloca 4, 4: Ptr
    %v_3 = alloca 8, 8: Ptr
    store %v_1, 3, 4
    store %v_2, 4, 4
    store %v_3, %v_1, 8
    %v_4 = load %v_3, 8: I64
    %v_5 = cmp_neq %v_4, 0: I32
    je %v_5, b_6, b_7
  }

  b_7 {
    jmp b_8
  }

  b_8 {
    %v_9 = phi [b_7, 0], [b_6, %v_10]: I32
    %v_11 = loads %v_1, 4: I32
    %v_12 = loads %v_2, 4: I32
    %v_13 = add %v_11, %v_12: I32
    %v_14 = add %v_13, %v_11: I32
    %v_15 = add %v_14, %v_9: I32
    ret %v_15
  }

  b_6 {
    %v_16 = bitcast %v_4: Ptr
    %v_10 = loads %v_16, 4: I32
    jmp b_8
  }
}

