
main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    %v_2 = alloca 4, 4: Ptr
    store %v_1, 3, 4
    store %v_2, 4, 4
    %v_3 = bitcast %v_1: I64
    %v_4 = cmp_neq %v_3, 0: I32
    je %v_4, b_5, b_6
  }

  b_6 {
    jmp b_7
  }

  b_7 {
    %v_8 = phi [b_6, 0], [b_5, %v_9]: I32
    %v_10 = loads %v_1, 4: I32
    %v_11 = loads %v_2, 4: I32
    %v_12 = add %v_10, %v_11: I32
    %v_13 = add %v_12, %v_10: I32
    %v_14 = add %v_13, %v_8: I32
    ret %v_14
  }

  b_5 {
    %v_9 = loads %v_1, 4: I32
    jmp b_7
  }
}

