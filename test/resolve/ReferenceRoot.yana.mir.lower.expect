
main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    store %v_1, 3, 4
    %v_2 = bitcast %v_1: I64
    %v_3 = cmp_neq %v_2, 0: I32
    je %v_3, b_4, b_5
  }

  b_5 {
    jmp b_6
  }

  b_6 {
    %v_7 = phi [b_5, 0], [b_4, 3]: I32
    %v_8 = loads %v_1, 4: I32
    %v_9 = add %v_8, 4: I32
    %v_10 = add %v_9, %v_8: I32
    %v_11 = add %v_10, %v_7: I32
    ret %v_11
  }

  b_4 {
    jmp b_6
  }
}

