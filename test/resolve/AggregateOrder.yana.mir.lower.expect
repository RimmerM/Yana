mut @log = [0, 0, 0, 0]

note<complex>(%n: I32): I32 {
  b_0 {
    %v_1 = phi [b_2, %n], [b_3, 0]: I32
    %v_4 = loads @log, 4: I32
    %v_5 = imul %v_4, 10: I32
    %v_6 = add %v_5, %v_1: I32
    store @log, %v_6, 4
    %v_7 = cmp_igt %v_6, 1000000000: I32
    je %v_7, b_3, b_8
  }

  b_8 {
    ret %v_1
  }

  b_3 {
    jmp b_0
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = call_complex note, 1: I32
    %v_2 = call_complex note, 2: I32
    %v_3 = imul %v_2, 10: I32
    %v_4 = add %v_3, 9: I32
    %v_5 = add %v_4, %v_1: I32
    %v_6 = call_complex note, 3: I32
    %v_7 = add %v_6, 1: I32
    %v_8 = imul %v_7, 10: I32
    %v_9 = add %v_8, 8: I32
    %v_10 = add %v_5, %v_9: I32
    %v_11 = call_complex note, 4: I32
    %v_12 = call_complex note, 5: I32
    %v_13 = imul %v_12, 10: I32
    %v_14 = add %v_13, 7: I32
    %v_15 = add %v_14, %v_11: I32
    %v_16 = add %v_10, %v_15: I32
    %v_17 = add %v_16, 56: I32
    %v_18 = loads @log, 4: I32
    %v_19 = add %v_17, %v_18: I32
    ret %v_19
  }
}

