mut @log = [0, 0, 0, 0]
mut @heapFree = [0, 0, 0, 0, 0, 0, 0, 0]

note<complex>(%n: I32): I32 {
  b_0 {
    %v_1 = phi [b_2, %n], [b_3, 0]: I32
    %v_4 = loads @log, 4: I32
    %v_5 = imul %v_4, 10: I32
    %v_6 = add %v_5, %v_1: I32
    store @log, %v_6, 4
    %v_7 = loads @log, 4: I32
    %v_8 = cmp_igt %v_7, 1000000000: I32
    je %v_8, b_3, b_9
  }

  b_9 {
    ret %v_1
  }

  b_3 {
    jmp b_0
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = call_complex note, 1: I32
    %v_2 = call_complex note, 2: I32
    %v_3 = imul %v_2, 10: I32
    %v_4 = add %v_3, 9: I32
    %v_5 = add %v_4, %v_1: I32
    %v_6 = call_complex note, 3: I32
    %v_7 = add %v_6, 1: I32
    %v_8 = imul %v_7, 10: I32
    %v_9 = add %v_8, 8: I32
    %v_10 = add %v_5, %v_9: I32
    %v_11 = alloca 16, 8: Ptr
    %v_12 = alloca 8, 4: Ptr
    store %v_11, %v_12, 8
    %v_13 = add %v_11, 8: Ptr
    store %v_13, 2, 4
    %v_14 = add %v_11, 12: Ptr
    store %v_14, 2, 4
    store %v_12, 0, 4
    %v_15 = add %v_12, 4: Ptr
    store %v_15, 7, 4
    %v_16 = call_complex note, 4: I32
    %v_17 = call_complex note, 5: I32
    jmp b_18
  }

  b_18 {
    store %v_12, %v_17, 4
    jmp b_19
  }

  b_19 {
    %v_20 = loads %v_12, 4: I32
    %v_21 = imul %v_20, 10: I32
    jmp b_22
  }

  b_22 {
    %v_23 = add %v_12, 4: Ptr
    %v_24 = loads %v_23, 4: I32
    call_complex Array(a).reclaim(I32), %v_11
    %v_25 = add %v_21, %v_24: I32
    %v_26 = add %v_25, %v_16: I32
    %v_27 = add %v_10, %v_26: I32
    %v_28 = add %v_27, 56: I32
    %v_29 = loads @log, 4: I32
    %v_30 = add %v_28, %v_29: I32
    ret %v_30
  }
}

Array(a).reclaim(I32)<complex>(%value: Ptr) {
  b_0 {
    %v_1 = load %value, 8: Ptr
    %v_2 = add %value, 8: Ptr
    %v_3 = load %v_2, 4: I64
    %v_4 = shr %v_3, 30: I64
    %v_5 = cast %v_4: I32
    %v_6 = cmp_eq %v_5, 1: I32
    je %v_6, b_7, b_8
  }

  b_7 {
    call_complex freeHeap, %v_1
    jmp b_8
  }

  b_8 {
    ret 
  }
}

freeHeap<complex>(%allocation: Ptr) {
  b_0 {
    %v_1 = bitcast %allocation: I64
    %v_2 = cmp_eq %v_1, 0: I32
    je %v_2, b_3, b_4
  }

  b_4 {
    %v_5 = sub %allocation, 8: Ptr
    %v_6 = loads %v_5, 8: I64
    %v_7 = load @heapFree, 8: Ptr
    %v_8 = shl %v_6, 3: I64
    %v_9 = add %v_7, %v_8: Ptr
    %v_10 = load %v_9, 8: Ptr
    store %allocation, %v_10, 8
    %v_11 = load @heapFree, 8: Ptr
    %v_12 = add %v_11, %v_8: Ptr
    store %v_12, %allocation, 8
    ret 
  }

  b_3 {
    ret 
  }
}

Run(a).reclaim(I32)<complex>(%value: Ptr) {
  b_0 {
    %v_1 = load %value, 8: Ptr
    %v_2 = add %value, 8: Ptr
    %v_3 = load %v_2, 4: I64
    %v_4 = shr %v_3, 30: I64
    %v_5 = cast %v_4: I32
    %v_6 = cmp_eq %v_5, 1: I32
    je %v_6, b_7, b_8
  }

  b_7 {
    call_complex freeHeap, %v_1
    jmp b_8
  }

  b_8 {
    ret 
