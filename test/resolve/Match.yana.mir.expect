fn firstOrRest(m: Maybe(Color) [shared call]) -> I32 {
  local rest: Color

bb0:
  %0: U8 = read copy.trivial (m.#)
  %1: U8 = const 1
  %2: Bool = eq inspect %0 inspect %1
