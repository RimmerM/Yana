module ResolveTest

data Color = Red | Green | Blue

data Shape = Circle {Circle: I32} | Square {width: I32, height: I32}

let & least: I64 = -9223372036854775808

let & minusOne: I64 = -1

fn colorValue(c: Color [shared call]) -> I32 {
bb0:
  %0: U8 = read copy.trivial (c.#)
  %1: U8 = const 0
  %2: Bool = eq inspect %0 inspect %1
  branch inspect %2 -> bb4 -> bb1

bb1:
  %5: U8 = read copy.trivial (c.#)
  %6: U8 = const 1
  %7: Bool = eq inspect %5 inspect %6
  branch inspect %7 -> bb5 -> bb2

bb2:
  %10: I32 = const 3
  jump -> bb3(take %10)

bb3(%11: I32):
  return take %11

bb4:
  %4: I32 = const 1
  jump -> bb3(take %4)

bb5:
  %9: I32 = const 2
  jump -> bb3(take %9)
}

fn shapeValue(s: Shape [shared call]) -> I32 {
  local width: I32
  local height: I32
