bb0:
  %0: U8 = read copy.trivial (s.#)
  %1: U8 = const 1
  %2: Bool = eq inspect %0 inspect %1
  branch inspect %2 -> bb3 -> bb1

bb1:
  %11: I32 = read copy.trivial (s.Circle)
  write.init borrow.unique (r) take %11
  %13: I32 = read copy.trivial (r)
  %14: I32 = const 1
  %15: I32 = add inspect %13 inspect %14
  jump -> bb2(take %15)

bb2(%16: I32):
  return take %16

bb3:
  %4: I32 = read copy.trivial (s.width)
  write.init borrow.unique (width) take %4
  %6: I32 = read copy.trivial (s.height)
  write.init borrow.unique (height) take %6
  %8: I32 = read copy.trivial (width)
  %9: I32 = read copy.trivial (height)
  %10: I32 = mul inspect %8 inspect %9
  jump -> bb2(take %10)
}

