  %16: I32 = const 12
  %17: Bool = eq inspect %15 inspect %16
  %18: I32 = const 4
  %19: I32 = call check borrow.shared %17 borrow.shared %18
  write.init borrow.unique (c) take %19
  %21: I32 = const 7
  %22: I32 = call borrowed borrow.shared %21
  %23: I32 = const 107
  %24: Bool = eq inspect %22 inspect %23
  %25: I32 = const 8
  %26: I32 = call check borrow.shared %24 borrow.shared %25
  write.init borrow.unique (d) take %26
  %28: I32 = const 4
  %29: I32 = call owning borrow.shared %28
  %30: I32 = const 8
  %31: Bool = eq inspect %29 inspect %30
  %32: I32 = const 16
  %33: I32 = call check borrow.shared %31 borrow.shared %32
  write.init borrow.unique (e) take %33
  %35: I32 = const 2
  %36: I32 = call record borrow.shared %35
  %37: I32 = const 7
  %38: Bool = eq inspect %36 inspect %37
  %39: I32 = const 32
  %40: I32 = call check borrow.shared %38 borrow.shared %39
  write.init borrow.unique (f) take %40
  %42: Bool = const True
  %43: Bool = const False
  %44: I32 = call boolean borrow.shared %42 borrow.shared %43
  %45: I32 = const 1
  %46: Bool = eq inspect %44 inspect %45
  %47: I32 = const 64
  %48: I32 = call check borrow.shared %46 borrow.shared %47
  write.init borrow.unique (g) take %48
  %50: Bool = const True
  %51: Bool = const True
  %52: I32 = call boolean borrow.shared %50 borrow.shared %51
  %53: I32 = const 0
  %54: Bool = eq inspect %52 inspect %53
  %55: I32 = const 128
  %56: I32 = call check borrow.shared %54 borrow.shared %55
  write.init borrow.unique (h) take %56
  %58: I32 = const 5
  %59: I32 = call narrow borrow.shared %58
  %60: I32 = const 1
  %61: Bool = eq inspect %59 inspect %60
  %62: I32 = const 256
  %63: I32 = call check borrow.shared %61 borrow.shared %62
  write.init borrow.unique (j) take %63
  %65: I32 = const 6
  %66: I32 = call twice take %65
  %67: I32 = const 66
  %68: Bool = eq inspect %66 inspect %67
  %69: I32 = const 512
  %70: I32 = call check borrow.shared %68 borrow.shared %69
  write.init borrow.unique (k) take %70
  %72: I32 = read copy.trivial (a)
  %73: I32 = read copy.trivial (b)
  %74: I32 = add inspect %72 inspect %73
  %75: I32 = read copy.trivial (c)
  %76: I32 = add inspect %74 inspect %75
  %77: I32 = read copy.trivial (d)
  %78: I32 = add inspect %76 inspect %77
  %79: I32 = read copy.trivial (e)
  %80: I32 = add inspect %78 inspect %79
  %81: I32 = read copy.trivial (f)
  %82: I32 = add inspect %80 inspect %81
  %83: I32 = read copy.trivial (g)
  %84: I32 = add inspect %82 inspect %83
  %85: I32 = read copy.trivial (h)
  %86: I32 = add inspect %84 inspect %85
  %87: I32 = read copy.trivial (j)
  %88: I32 = add inspect %86 inspect %87
  %89: I32 = read copy.trivial (k)
  %90: I32 = add inspect %88 inspect %89
  %91: I32 = read copy.trivial (global live)
  %92: I32 = const 10000
  %93: I32 = mul inspect %91 inspect %92
  %94: I32 = add inspect %90 inspect %93
  %95: I32 = read copy.trivial (global trace)
