  local a: I32
  local b: I32
  local c: I32
  local d: I32
  local e: I32
  local f: I32
  local g: I32
  local h: I32
  local j: I32
  local k: I32

bb0:
  %0: I32 = const 5
  %1: I32 = call branched borrow.shared %0
  %2: I32 = const 10
  %3: Bool = eq inspect %1 inspect %2
  %4: I32 = const 1
  %5: I32 = call check borrow.shared %3 borrow.shared %4
  write.init borrow.unique (a) take %5
  %7: I32 = const 1
  %8: I32 = call branched borrow.shared %7
  %9: I32 = const 3
  %10: Bool = eq inspect %8 inspect %9
  %11: I32 = const 2
  %12: I32 = call check borrow.shared %10 borrow.shared %11
  write.init borrow.unique (b) take %12
  %14: I32 = const 3
