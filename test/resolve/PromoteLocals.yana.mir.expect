module ResolveTest

data Held {id: I32} drop authored

data Pair {a: I32, b: I32}

data Packed {small: @bits(4) U32}

instance Drop(Held): Held.drop

let & live: I32 = 0

let & trace: I32 = 0

fn check(ok: Bool [shared call], weight: I32 [shared call]) -> I32 {
bb0:
  %0: Bool = read copy.trivial (ok)
  branch inspect %0 -> bb3 -> bb1

bb1:
  %3: I32 = const 0
  jump -> bb2(take %3)

bb2(%4: I32):
  return take %4

bb3:
  %2: I32 = read copy.trivial (weight)
  jump -> bb2(take %2)
}

fn branched(n: I32 [shared call]) -> I32 {
  local & v: I32

bb0:
  %0: I32 = const 0
  write.init borrow.unique (v) take %0
  %2: I32 = read copy.trivial (n)
  %3: I32 = const 2
  %4: Bool = gt inspect %2 inspect %3
  branch inspect %4 -> bb3 -> bb1

bb1:
  %10: I32 = read copy.trivial (n)
  %11: I32 = const 3
  %12: I32 = mul inspect %10 inspect %11
  write.assign borrow.unique (v) take %12
  jump -> bb2

bb2:
  %16: I32 = read copy.trivial (v)
  return take %16

bb3:
  %6: I32 = read copy.trivial (n)
  %7: I32 = const 2
  %8: I32 = mul inspect %6 inspect %7
  write.assign borrow.unique (v) take %8
  jump -> bb2
}

fn counted(n: I32 [shared call]) -> I32 {
  local & total: I32
  local & i: I32

bb0:
  %0: I32 = const 0
  write.init borrow.unique (total) take %0
  %2: I32 = const 0
  write.init borrow.unique (i) take %2
  jump -> bb1

bb1:
  %5: I32 = read copy.trivial (i)
  %6: I32 = read copy.trivial (n)
  %7: Bool = lt inspect %5 inspect %6
  branch inspect %7 -> bb3 -> bb2

bb2:
  %20: I32 = read copy.trivial (total)
  return take %20

bb3:
  %9: I32 = read copy.trivial (total)
  %10: I32 = const 10
  %11: I32 = mul inspect %9 inspect %10
  %12: I32 = read copy.trivial (i)
  %13: I32 = add inspect %11 inspect %12
  write.assign borrow.unique (total) take %13
  %15: I32 = read copy.trivial (i)
  %16: I32 = const 1
  %17: I32 = add inspect %15 inspect %16
  write.assign borrow.unique (i) take %17
  jump -> bb1
}

fn bump(v: I32 [unique call]) -> {} {
bb0:
  %0: I32 = read copy.trivial (v)
  %1: I32 = const 100
  %2: I32 = add inspect %0 inspect %1
  write.assign borrow.unique (v) take %2
  return
}

fn borrowed(n: I32 [shared call]) -> I32 {
  local & v: I32

bb0:
  %0: I32 = read copy.trivial (n)
  write.init borrow.unique (v) take %0
  %2: I32 [unique call] = read borrow.unique (v) loan0
  %3: {} = call bump borrow.unique %2
  %4: I32 = read copy.trivial (v)
  return take %4
}

fn Held.drop(self: Held) -> {} {
bb0:
  %0: I32 = read copy.trivial (global live)
  %1: I32 = const 1
  %2: I32 = sub inspect %0 inspect %1
  write.assign borrow.unique (global live) take %2
  %4: I32 = read copy.trivial (global trace)
  %5: I32 = const 10
  %6: I32 = mul inspect %4 inspect %5
  %7: I32 = read copy.trivial (self.id)
  %8: I32 = add inspect %6 inspect %7
  write.assign borrow.unique (global trace) take %8
  return
}

fn held(id: I32 [shared call]) -> Held {
bb0:
  %0: I32 = read copy.trivial (global live)
  %1: I32 = const 1
  %2: I32 = add inspect %0 inspect %1
  write.assign borrow.unique (global live) take %2
  %4: I32 = read copy.trivial (id)
  %5: Held = aggregate.Held take %4
  return take %5
}

fn owning(n: I32 [shared call]) -> I32 {
  local kept: Held

bb0:
  %0: I32 = read copy.trivial (n)
  %1: Held = call held borrow.shared %0
  write.init borrow.unique (kept) take %1
  drop (kept)
  %3: I32 = read copy.trivial (n)
  %4: I32 = const 2
  %5: I32 = mul inspect %3 inspect %4
  return take %5
}

fn record(n: I32 [shared call]) -> I32 {
  local & p: Pair

bb0:
  %0: I32 = read copy.trivial (n)
  %1: I32 = read copy.trivial (n)
  %2: I32 = const 1
  %3: I32 = add inspect %1 inspect %2
  %4: Pair = aggregate.Pair take %0 take %3
  write.init borrow.unique (p) take %4
  %6: I32 = read copy.trivial (p.a)
  %7: I32 = const 2
  %8: I32 = mul inspect %6 inspect %7
  write.assign borrow.unique (p.a) take %8
  %10: I32 = read copy.trivial (p.a)
  %11: I32 = read copy.trivial (p.b)
  %12: I32 = add inspect %10 inspect %11
  return take %12
}

fn boolean(a: Bool [shared call], b: Bool [shared call]) -> I32 {
  local & ok: Bool

bb0:
  %0: Bool = read copy.trivial (a)
  write.init borrow.unique (ok) take %0
  %2: Bool = read copy.trivial (b)
  branch inspect %2 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %9: Bool = read copy.trivial (ok)
  branch inspect %9 -> bb6 -> bb4

bb3:
  %4: Bool = read copy.trivial (a)
  %5: Bool = not inspect %4
  write.assign borrow.unique (ok) take %5
  jump -> bb2

bb4:
  %12: I32 = const 0
  jump -> bb5(take %12)

bb5(%13: I32):
  return take %13

bb6:
  %11: I32 = const 1
  jump -> bb5(take %11)
}

fn packed(value: U32 [shared call]) -> Packed {
bb0:
  %0: U32 = read copy.trivial (value)
  %1: @bits(4) U32 = convert inspect %0
  %2: Packed = aggregate.Packed take %1
  return take %2
}

fn narrow(n: I32 [shared call]) -> I32 {
  local local1: Packed
  local & small: @bits(4) U32
  local local3: Packed

bb0:
  %0: U32 = const 3
  %1: Packed = call packed borrow.shared %0
  write.init borrow.unique (local1) take %1
  %3: @bits(4) U32 = read copy.trivial (local1.small)
  write.init borrow.unique (small) take %3
  %5: I32 = read copy.trivial (n)
  %6: I32 = const 2
  %7: Bool = gt inspect %5 inspect %6
  branch inspect %7 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %16: @bits(4) U32 = read copy.trivial (small)
  %17: U32 = convert inspect %16
  %18: U32 = const 10
  %19: Bool = eq inspect %17 inspect %18
  branch inspect %19 -> bb6 -> bb4

bb3:
  %9: U32 = const 10
  %10: Packed = call packed borrow.shared %9
  write.init borrow.unique (local3) take %10
  %12: @bits(4) U32 = read copy.trivial (local3.small)
  write.assign borrow.unique (small) take %12
  jump -> bb2

bb4:
  %22: I32 = const 0
  jump -> bb5(take %22)

bb5(%23: I32):
  return take %23

bb6:
  %21: I32 = const 1
  jump -> bb5(take %21)
}

fn twice(x: I32) -> I32 {
bb0:
  %0: I32 = read copy.trivial (x)
  %1: I32 = const 10
  %2: I32 = mul inspect %0 inspect %1
  %3: I32 = read copy.trivial (x)
  %4: I32 = add inspect %2 inspect %3
  return take %4
}

