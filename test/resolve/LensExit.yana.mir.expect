module ResolveTest

let & log: I32 = 0

lens fn scope($body: (->{}) -> $r [shared call]) -> $r {
  form specialized
  slot #0 type $r
  local $yielded: $r

bb0:
  %0: I32 = read copy.trivial (global log)
  %1: I32 = const 1
  %2: I32 = add inspect %0 inspect %1
  write.assign borrow.unique (global log) take %2
  %4: {} = const {}
  %5: (->{}) -> $r [shared call] = read borrow.shared ($body) loan0
  %6: $r = call inspect %5 take {}
  write.init borrow.unique ($yielded) take %6
  %8: I32 = read copy.trivial (global log)
  %9: I32 = const 100
  %10: I32 = add inspect %8 inspect %9
  write.assign borrow.unique (global log) take %10
  %12: $r = read take ($yielded)
  return take %12
}

lens fn handing(x: I32 [shared call], $body: (I32) -> $r [shared call]) -> $r {
  form specialized
  slot #0 type $r
  local $yielded: $r

bb0:
  %0: I32 = read copy.trivial (global log)
  %1: I32 = const 1
  %2: I32 = add inspect %0 inspect %1
  write.assign borrow.unique (global log) take %2
  %4: I32 = read copy.trivial (x)
  %5: I32 = const 2
  %6: I32 = mul inspect %4 inspect %5
  %7: (I32) -> $r [shared call] = read borrow.shared ($body) loan0
  %8: $r = call inspect %7 borrow.shared %6
  write.init borrow.unique ($yielded) take %8
  %10: I32 = read copy.trivial (global log)
  %11: I32 = const 100
  %12: I32 = add inspect %10 inspect %11
  write.assign borrow.unique (global log) take %12
  %14: $r = read take ($yielded)
  return take %14
}

fn alwaysLeaves(x: I32 [shared call]) -> I32 {
  local local1: {}

bb0:
  lens.call scope(I32) -> bb1

bb1(%0: {}) handover({}):
  write.init borrow.unique (local1) take {}
  %3: I32 = read copy.trivial (x)
  %4: I32 = const 1
  %5: I32 = add inspect %3 inspect %4
  return take %5
}

fn sometimesLeaves(x: I32 [shared call]) -> I32 {
  local local1: {}

bb0:
  lens.call scope(I32) -> bb1

bb1(%0: {}) handover({}):
  write.init borrow.unique (local1) take {}
  %3: I32 = read copy.trivial (x)
  %4: I32 = const 100
  %5: Bool = gt inspect %3 inspect %4
  branch inspect %5 -> bb4 -> bb2

bb2 handover({}):
  jump -> bb3

bb3 handover({}):
  %10: I32 = read copy.trivial (x)
  %11: I32 = const 2
  %12: I32 = add inspect %10 inspect %11
  return take %12

bb4 handover({}):
  %7: I32 = const 0
  return take %7
}

fn insideArm(x: I32 [shared call]) -> I32 {
  local local1: {}

bb0:
  %0: I32 = read copy.trivial (x)
  %1: I32 = const 0
  %2: Bool = gt inspect %0 inspect %1
  branch inspect %2 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %21: I32 = const 7
  return take %21

bb3:
  lens.call scope(I32) -> bb5

bb4:
  jump -> bb2

bb5(%4: {}) handover({}) -> bb4:
  write.init borrow.unique (local1) take {}
  %7: I32 = read copy.trivial (x)
  %8: I32 = const 100
  %9: Bool = gt inspect %7 inspect %8
  branch inspect %9 -> bb8 -> bb6

bb6 handover({}):
  jump -> bb7

bb7 handover({}):
  %14: I32 = read copy.trivial (global log)
  %15: I32 = const 1000
  %16: I32 = add inspect %14 inspect %15
  write.assign borrow.unique (global log) take %16
  jump -> bb4

bb8 handover({}):
  %11: I32 = const 0
  return take %11
}

fn leavesWithValue(x: I32 [shared call]) -> I32 {
  local doubled: I32 [shared call]

bb0:
  %0: I32 = read copy.trivial (x)
  lens.call handing(I32) borrow.shared %0 -> bb2

bb1:
  %12: I32 = const 0
  return take %12

bb2(%1: I32 [shared call]) handover(I32 [shared call]) -> bb1:
  write.init borrow.unique (doubled) borrow.shared %1
  %4: I32 = read copy.trivial (doubled)
  %5: I32 = const 10
  %6: Bool = gt inspect %4 inspect %5
  branch inspect %6 -> bb5 -> bb3

bb3 handover(I32 [shared call]):
  jump -> bb4

bb4 handover(I32 [shared call]):
  jump -> bb1

bb5 handover(I32 [shared call]):
  %8: I32 = read copy.trivial (doubled)
  return take %8
}

fn twoDeep(x: I32 [shared call]) -> I32 {
  local local1: {}
  local local2: {}

bb0:
  lens.call scope(I32) -> bb1

bb1(%0: {}) handover({}):
  write.init borrow.unique (local1) take {}
  lens.call scope(I32) -> bb2

bb2(%3: {}) handover({}):
  write.init borrow.unique (local2) take {}
  %6: I32 = read copy.trivial (x)
  %7: I32 = const 3
  %8: I32 = add inspect %6 inspect %7
  return take %8
}

fn main() -> I32 {
  local a: I32
  local b: I32
  local c: I32
  local d: I32
  local e: I32
  local f: I32
  local g: I32
  local h: I32

bb0:
  %0: I32 = const 0
  write.assign borrow.unique (global log) take %0
  %2: I32 = const 1
  %3: I32 = call alwaysLeaves borrow.shared %2
  write.init borrow.unique (a) take %3
  %5: I32 = const 5
  %6: I32 = call sometimesLeaves borrow.shared %5
  write.init borrow.unique (b) take %6
  %8: I32 = const 200
  %9: I32 = call sometimesLeaves borrow.shared %8
  write.init borrow.unique (c) take %9
  %11: I32 = const 3
  %12: I32 = call insideArm borrow.shared %11
  write.init borrow.unique (d) take %12
  %14: I32 = const -1
  %15: I32 = call insideArm borrow.shared %14
  write.init borrow.unique (e) take %15
  %17: I32 = const 9
  %18: I32 = call leavesWithValue borrow.shared %17
  write.init borrow.unique (f) take %18
  %20: I32 = const 2
  %21: I32 = call leavesWithValue borrow.shared %20
  write.init borrow.unique (g) take %21
  %23: I32 = const 4
  %24: I32 = call twoDeep borrow.shared %23
  write.init borrow.unique (h) take %24
  %26: I32 = read copy.trivial (a)
  %27: I32 = read copy.trivial (b)
  %28: I32 = add inspect %26 inspect %27
  %29: I32 = read copy.trivial (c)
  %30: I32 = add inspect %28 inspect %29
  %31: I32 = read copy.trivial (d)
  %32: I32 = add inspect %30 inspect %31
  %33: I32 = read copy.trivial (e)
  %34: I32 = add inspect %32 inspect %33
  %35: I32 = read copy.trivial (f)
  %36: I32 = add inspect %34 inspect %35
  %37: I32 = read copy.trivial (g)
  %38: I32 = add inspect %36 inspect %37
  %39: I32 = read copy.trivial (h)
  %40: I32 = add inspect %38 inspect %39
  %41: I32 = read copy.trivial (global log)
  %42: I32 = add inspect %40 inspect %41
  return take %42
}

lens fn scope(I32)($body: (->{}) -> I32 [shared call]) -> I32 = <scope at I32>

lens fn handing(I32)(x: I32 [shared call], $body: (I32) -> I32 [shared call]) -> I32 = <handing at I32>

entry main
