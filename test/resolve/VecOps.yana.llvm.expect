target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

module asm "\09.set \22image$base\22, 0"

@"image$base" = external constant [0 x i8], align 8

define fastcc i32 @reductions() #0 {
  br label %1

1:                                                ; preds = %0
  %count = call i32 @llvm.vector.reduce.add.v4i32(<4 x i32> splat (i32 1))
  %2 = icmp slt i32 %count, 2
  %3 = zext i1 %2 to i32
  br i1 %2, label %4, label %5

4:                                                ; preds = %1
  ret i32 -1

5:                                                ; preds = %1
  %6 = call i32 @llvm.vector.reduce.mul.v4i32(<4 x i32> splat (i32 1))
  %7 = icmp ne i32 %6, 1
  %8 = zext i1 %7 to i32
  br i1 %7, label %9, label %10

9:                                                ; preds = %5
  ret i32 -2

10:                                               ; preds = %5
  %11 = call i32 @llvm.vector.reduce.add.v4i32(<4 x i32> splat (i32 7))
  %12 = mul i32 %count, 7
  %13 = icmp ne i32 %11, %12
  %14 = zext i1 %13 to i32
  br i1 %13, label %15, label %16

15:                                               ; preds = %10
  ret i32 -3

16:                                               ; preds = %10
  %17 = call i32 @llvm.vector.reduce.smin.v4i32(<4 x i32> splat (i32 7))
  %18 = icmp ne i32 %17, 7
  %19 = zext i1 %18 to i32
  br i1 %18, label %20, label %21

20:                                               ; preds = %16
  ret i32 -4

21:                                               ; preds = %16
  %22 = call i32 @llvm.vector.reduce.smax.v4i32(<4 x i32> <i32 9, i32 7, i32 7, i32 7>)
  %23 = icmp ne i32 %22, 9
  %24 = zext i1 %23 to i32
  br i1 %23, label %25, label %26

25:                                               ; preds = %21
  ret i32 -5

26:                                               ; preds = %21
  %27 = call i32 @llvm.vector.reduce.smin.v4i32(<4 x i32> <i32 7, i32 2, i32 7, i32 7>)
  %28 = icmp ne i32 %27, 2
  %29 = zext i1 %28 to i32
  br i1 %28, label %30, label %31

30:                                               ; preds = %26
  ret i32 -6

31:                                               ; preds = %26
  ret i32 0
}

define fastcc i32 @floats() #0 {
  br label %1

1:                                                ; preds = %0
  br i1 false, label %2, label %3

2:                                                ; preds = %1
  ret i32 -1

3:                                                ; preds = %1
  br i1 false, label %4, label %5

4:                                                ; preds = %3
  ret i32 -2

5:                                                ; preds = %3
  br i1 false, label %6, label %7

6:                                                ; preds = %5
  ret i32 -3

7:                                                ; preds = %5
  ret i32 0
}

define fastcc i32 @main() #0 {
  br label %1

1:                                                ; preds = %0
  %2 = call fastcc i32 @reductions()
  %3 = icmp ne i32 %2, 0
  %4 = zext i1 %3 to i32
  br i1 %3, label %5, label %7

5:                                                ; preds = %1
  %6 = call fastcc i32 @reductions()
  ret i32 %6

7:                                                ; preds = %1
  %8 = call fastcc i32 @floats()
  %9 = icmp ne i32 %8, 0
  %10 = zext i1 %9 to i32
  br i1 %9, label %11, label %14

11:                                               ; preds = %7
  %12 = call fastcc i32 @floats()
  %13 = mul i32 %12, 10
  ret i32 %13

14:                                               ; preds = %7
  ret i32 2042
}

; Function Attrs: nocallback nofree nosync nounwind speculatable willreturn memory(none)
declare i32 @llvm.vector.reduce.add.v4i32(<4 x i32>) #1

; Function Attrs: nocallback nofree nosync nounwind speculatable willreturn memory(none)
declare i32 @llvm.vector.reduce.mul.v4i32(<4 x i32>) #1

; Function Attrs: nocallback nofree nosync nounwind speculatable willreturn memory(none)
declare i32 @llvm.vector.reduce.smin.v4i32(<4 x i32>) #1

; Function Attrs: nocallback nofree nosync nounwind speculatable willreturn memory(none)
declare i32 @llvm.vector.reduce.smax.v4i32(<4 x i32>) #1

attributes #0 = { "probe-stack"="inline-asm" }
attributes #1 = { nocallback nofree nosync nounwind speculatable willreturn memory(none) }
