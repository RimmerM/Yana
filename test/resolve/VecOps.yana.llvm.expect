target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

module asm "\09.set \22image$base\22, 0"

@"image$base" = external constant [0 x i8], align 8

define fastcc i32 @reductions() {
  br label %1

1:                                                ; preds = %0
  %count = call i32 @llvm.vector.reduce.add.v4i32(<4 x i32> <i32 1, i32 1, i32 1, i32 1>)
  %2 = icmp slt i32 %count, 2
  %3 = zext i1 %2 to i32
  br i1 %2, label %4, label %5

4:                                                ; preds = %1
  ret i32 -1

5:                                                ; preds = %1
  br label %6

6:                                                ; preds = %5
  %7 = call i32 @llvm.vector.reduce.mul.v4i32(<4 x i32> <i32 1, i32 1, i32 1, i32 1>)
  %8 = icmp ne i32 %7, 1
  %9 = zext i1 %8 to i32
  br i1 %8, label %10, label %11

10:                                               ; preds = %6
  ret i32 -2

11:                                               ; preds = %6
  br label %12

12:                                               ; preds = %11
  %13 = call i32 @llvm.vector.reduce.add.v4i32(<4 x i32> <i32 7, i32 7, i32 7, i32 7>)
  %14 = mul i32 %count, 7
  %15 = icmp ne i32 %13, %14
  %16 = zext i1 %15 to i32
  br i1 %15, label %17, label %18

17:                                               ; preds = %12
  ret i32 -3

18:                                               ; preds = %12
  br label %19

19:                                               ; preds = %18
  %20 = call i32 @llvm.vector.reduce.smin.v4i32(<4 x i32> <i32 7, i32 7, i32 7, i32 7>)
  %21 = icmp ne i32 %20, 7
  %22 = zext i1 %21 to i32
  br i1 %21, label %23, label %24

23:                                               ; preds = %19
  ret i32 -4

24:                                               ; preds = %19
  br label %25

25:                                               ; preds = %24
  %26 = call i32 @llvm.vector.reduce.smax.v4i32(<4 x i32> <i32 9, i32 7, i32 7, i32 7>)
  %27 = icmp ne i32 %26, 9
  %28 = zext i1 %27 to i32
  br i1 %27, label %29, label %30

29:                                               ; preds = %25
  ret i32 -5

30:                                               ; preds = %25
  br label %31

31:                                               ; preds = %30
  %32 = call i32 @llvm.vector.reduce.smin.v4i32(<4 x i32> <i32 7, i32 2, i32 7, i32 7>)
  %33 = icmp ne i32 %32, 2
  %34 = zext i1 %33 to i32
  br i1 %33, label %35, label %36

35:                                               ; preds = %31
  ret i32 -6

36:                                               ; preds = %31
  br label %37

37:                                               ; preds = %36
  ret i32 0
}

define fastcc i32 @floats() {
  br label %1

1:                                                ; preds = %0
  br i1 false, label %2, label %3

2:                                                ; preds = %1
  ret i32 -1

3:                                                ; preds = %1
  br label %4

4:                                                ; preds = %3
  br i1 false, label %5, label %6

5:                                                ; preds = %4
  ret i32 -2

6:                                                ; preds = %4
  br label %7

7:                                                ; preds = %6
  br i1 false, label %8, label %9

8:                                                ; preds = %7
  ret i32 -3

9:                                                ; preds = %7
  br label %10

10:                                               ; preds = %9
  ret i32 0
}

define fastcc i32 @main() {
  br label %1

1:                                                ; preds = %0
  %2 = call fastcc i32 @reductions()
  %3 = icmp ne i32 %2, 0
  %4 = zext i1 %3 to i32
  br i1 %3, label %5, label %7

5:                                                ; preds = %1
  %6 = call fastcc i32 @reductions()
  ret i32 %6

7:                                                ; preds = %1
  br label %8

8:                                                ; preds = %7
  %9 = call fastcc i32 @floats()
  %10 = icmp ne i32 %9, 0
  %11 = zext i1 %10 to i32
  br i1 %10, label %12, label %15

12:                                               ; preds = %8
  %13 = call fastcc i32 @floats()
  %14 = mul i32 %13, 10
  ret i32 %14

15:                                               ; preds = %8
  br label %16

16:                                               ; preds = %15
  ret i32 2042
}

; Function Attrs: nocallback nofree nosync nounwind readnone willreturn
declare i32 @llvm.vector.reduce.add.v4i32(<4 x i32>) #0

; Function Attrs: nocallback nofree nosync nounwind readnone willreturn
declare i32 @llvm.vector.reduce.mul.v4i32(<4 x i32>) #0

; Function Attrs: nocallback nofree nosync nounwind readnone willreturn
declare i32 @llvm.vector.reduce.smin.v4i32(<4 x i32>) #0

; Function Attrs: nocallback nofree nosync nounwind readnone willreturn
declare i32 @llvm.vector.reduce.smax.v4i32(<4 x i32>) #0

attributes #0 = { nocallback nofree nosync nounwind readnone willreturn }
