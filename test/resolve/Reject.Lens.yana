-- What a lens will not accept, and why each one is a rule rather than an omission.
--
-- The first group is permanent: the transparent/skipping split is what makes "the ability to skip
-- is exactly the presence of a wrapper" checkable, and the exactly-once rule is what a call site
-- relies on when it hands over the whole rest of its block. The rest are this version's boundary -
-- Analysis-Lens.md's V1 - and each one names what it is waiting for.

data Lock {held: Int}
data Bag(a) {item: a}

-- Reading the declaration.

-- A skipping lens - one whose result is not its continuation's - is checked against the `Try`
-- instance that says which of its cases means the continuation ran. A result with no such instance
-- is a wrapper nothing can read.
lens fn opaqueWrapper(x: Int, body: (Int) -> a) -> Bag(a) = Bag {item: body(x)}

-- An instance exists, and it proceeds with something other than what the continuation produced.
-- The wrapper has to carry the continuation's own result or there is nothing for the call site's
-- proceeding path to bind.
lens fn wrongPayload(x: Int, body: (Int) -> a) -> Maybe(Int) = Just(x)

-- A result that is itself a type variable is `?`'s shape: the instance cannot be selected from the
-- signature and would have to travel with the call as a witness. (A lens whose result is the
-- continuation's *own* variable is not this - that is the transparent case, and it is what `named`
-- below is.)
lens fn (Try(m, a, e)) fullyGeneric(x: Int, ->spare: m, body: (Int) -> a) -> m = spare

-- A continuation that returns a concrete type is not a continuation: what it produces is whatever
-- the rest of the caller's block produces, which no signature can name.
lens fn fixedResult(x: Int, body: (Int) -> Int) -> Int = body(x)

-- The continuation is called, not stored, so it carries no binding convention of its own.
lens fn consumed(x: Int, ->body: (Int) -> a) -> a = body(x)

-- `iter` is the resumable generalization, and it is built - what it will not accept is in
-- Reject.Iter.yana.

-- The exactly-once rule.

-- A `yield`-form lens that never yields would leave the call site's block unrun.
lens fn silent(x: Int) -> Int:
    let unused = x + 1

-- One path yields and the other does not, so the call site's block runs on one of them only.
lens fn oneBranch(x: Int) -> Int:
    if x > 0:
        yield x

    return 0

-- Twice on one path, which the single-`yield` restriction of this version reports first.
lens fn twice(x: Int) -> Int:
    yield x
    yield x + 1

-- A `yield` in a loop body hands over once per iteration, which is the same repeat said with one
-- `yield` written.
lens fn perStep(n: Int) -> Int:
    let &i = 0 :: Int

    while i < n:
        yield i
        i = i + 1

-- `yield` outside a lens, and inside a lens that named its continuation itself.
fn notALens(x: Int) -> Int:
    yield x

lens fn named(x: Int, body: (Int) -> a) -> a:
    yield x

-- Reading the call site.

lens fn scope() -> {}:
    yield {}

lens fn handing(x: Int) -> Int:
    yield x * 2

lens fn maybeHanding(x: Int, body: (Int) -> a) -> Maybe(a):
    if x > 0: return Just(body(x))
    return Nothing

lens fn maybeChecked(x: Int, body: (Int) -> a) -> Result(Int, a):
    if x > 0: return Ok(body(x))
    return Err(1)

-- A skipping lens without alternatives is a call that may silently not continue into the block
-- below it, which is the one thing the wrapper exists to make impossible.
fn noAlternative(x: Int) -> Int:
    let seen = maybeHanding(x)
    return seen

-- ... and a bare statement has nowhere to write them at all.
fn noPlaceToPutThem(x: Int) -> Int:
    maybeHanding(x)
    return 0

-- The alternatives of a skipping call say where the *skip* goes, so the pattern has nothing left to
-- fail into and has to cover everything the lens hands over.
fn refutablePattern(x: Int) -> Int:
    let 3 = maybeHanding(x) | else -> return 0
    return 1

-- A `Maybe` skip carries nothing, so there is no pivot for a pattern to test.
fn nothingToMatch(x: Int) -> Int:
    let seen = maybeHanding(x) | match 0 -> return 0
    return seen

-- A skip that does carry something still has to be covered.
fn uncovered(x: Int) -> Int:
    let seen = maybeChecked(x) | match 1 -> return 0
    return seen

-- A lens call that is not a statement of a block has no rest-of-block to hand its values to.
fn asSubexpression(x: Int) -> Int = handing(x) + 1

-- A lens hands over nothing here, so there is nothing for `let` to bind.
fn bindingNothing() -> Int:
    let nothing = scope()
    return 0

-- Leaving a lens continuation by `break` is the loop-shaped instance of the exit signal, which
-- arrives with `for` and `iter`.
fn breakingOut(n: Int) -> Int:
    while n > 0:
        scope()
        break

    return n

-- A lens value has no call site to split a block at, so it cannot be one of the two words a
-- function value is.
fn asValue() -> Int:
    let f = scope
    return 0

-- A lens call in a generic body is legal now - see Adaptor.yana. A *lambda* there still is not, and
-- for the reason a continuation escapes: a lambda may outlive the frame it captured from.
fn lambdaInGeneric(value: a) -> Int:
    let f = () -> 1
    return f()

{-
   A `lens fn` declared by a class, called wrongly.

   Both of these were once one message saying a class `lens fn` had no call site at all. It has one
   now - the statement form, which is the same one a named lens has and the same one a `for` loop is
   for an `iter fn` - so what is left are the two ordinary ways to get a class call wrong: writing it
   in expression position, where there is no rest-of-block for it to hand over to, and reaching a
   type the class has no instance for.
-}
data Unguarded {n: Int}

class Scoped(a):
  lens fn around(self: a) -> Int

instance Scoped(Lock):
    lens fn around(self: Lock) -> Int:
        yield self.held

fn classLensInExpression(l: Lock) -> Int = around(l) + 1

fn classLensWithoutInstance(u: Unguarded) -> Int:
    let seen = u.around()
    return seen

-- A `@lazy` parameter of a lens or an iterator. Accepting it was silently wrong rather than
-- unsupported: both call sites resolve their written arguments before lifting the continuation, so
-- the thunk was built out of a value that had already been computed - the argument ran whether or
-- not the callee forced it, which is the one thing `@lazy` promises. Everything else about these
-- two is well formed, so the only diagnostic each draws is the one about the parameter.
lens fn lazyLens(@lazy x: Int, body: (Int) -> a) -> a = body(x)

iter fn lazyIter(@lazy x: Int) -> Int:
    yield x
