@image$base = []

area<complex>(%s: Ptr): Int {
  b_0 {
    %v_1 = loads %s, 4: Int
    %v_2 = cmp_eq %v_1, 0: Int
    je %v_2, b_3, b_4
  }

  b_4 {
    %v_5 = loads %s, 4: Int
    %v_6 = cmp_eq %v_5, 0: Int
    je %v_6, b_7, b_8
  }

  b_3 {
    %v_9 = add %s, 4: Ptr
    %v_10 = loads %v_9, 4: Int
    %v_11 = cmp_igt %v_10, 10: Int
    je %v_11, b_12, b_4
  }

  b_12 {
    jmp b_13
  }

  b_8 {
    %v_14 = loads %s, 4: Int
    %v_15 = cmp_eq %v_14, 1: Int
    je %v_15, b_16, b_17
  }

  b_7 {
    %v_18 = add %s, 4: Ptr
    %r = loads %v_18, 4: Int
    jmp b_13
  }

  b_17 {
    %v_19 = add %s, 4: Ptr
    %w = loads %v_19, 4: Int
    jmp b_13
  }

  b_16 {
    %v_20 = add %s, 4: Ptr
    %v_21 = loads %v_20, 4: Int
    %v_22 = cmp_igt %v_21, 10: Int
    je %v_22, b_23, b_17
  }

  b_23 {
    %v_24 = add %s, 8: Ptr
    %h = loads %v_24, 4: Int
    %v_25 = add %h, 10: Int
    jmp b_13
  }

  b_13 {
    %v_26 = phi [b_12, 100], [b_7, %r], [b_23, %v_25], [b_17, %w]: Int
    ret %v_26
  }
}

main<complex>(): Int {
  b_0 {
    %v_1 = alloca 12, 4: Ptr
    store %v_1, 0, 4
    %v_2 = add %v_1, 4: Ptr
    store %v_2, 20, 4
    %v_3 = call_complex area, %v_1: Int
    %v_4 = add %v_3, 25: Int
    %v_5 = alloca 12, 4: Ptr
    store %v_5, 0, 4
    %v_6 = add %v_5, 4: Ptr
    store %v_6, 3, 4
    %v_7 = call_complex area, %v_5: Int
    %v_8 = add %v_4, %v_7: Int
    %v_9 = alloca 12, 4: Ptr
    store %v_9, 1, 4
    %v_10 = add %v_9, 4: Ptr
    store %v_10, 20, 4
    %v_11 = add %v_9, 8: Ptr
    store %v_11, 2, 4
    %v_12 = call_complex area, %v_9: Int
    %v_13 = add %v_8, %v_12: Int
    %v_14 = alloca 12, 4: Ptr
    store %v_14, 1, 4
    %v_15 = add %v_14, 4: Ptr
    store %v_15, 3, 4
    %v_16 = add %v_14, 8: Ptr
    store %v_16, 9, 4
    %v_17 = call_complex area, %v_14: Int
    %v_18 = add %v_13, %v_17: Int
    %v_19 = add %v_18, 18: Int
    ret %v_19
  }
}

