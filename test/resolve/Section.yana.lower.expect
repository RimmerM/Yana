@image$base = []

area<complex>(%s: Ptr): I32 {
  b_0 {
    %v_1 = loads %s, 4: I32
    %v_2 = cmp_eq %v_1, 0: I32
    je %v_2, b_3, b_4
  }

  b_3 {
    %v_5 = add %s, 4: Ptr
    %v_6 = loads %v_5, 4: I32
    %v_7 = cmp_igt %v_6, 10: I32
    je %v_7, b_8, b_9
  }

  b_8 {
    jmp b_10
  }

  b_4 {
    %v_11 = cmp_eq %v_1, 1: I32
    je %v_11, b_12, b_13
  }

  b_9 {
    jmp b_10
  }

  b_13 {
    %v_14 = add %s, 4: Ptr
    %w = loads %v_14, 4: I32
    jmp b_10
  }

  b_12 {
    %v_15 = add %s, 4: Ptr
    %v_16 = loads %v_15, 4: I32
    %v_17 = cmp_igt %v_16, 10: I32
    je %v_17, b_18, b_13
  }

  b_18 {
    %v_19 = add %s, 8: Ptr
    %h = loads %v_19, 4: I32
    %v_20 = add %h, 10: I32
    jmp b_10
  }

  b_10 {
    %v_21 = phi [b_8, 100], [b_9, %v_6], [b_18, %v_20], [b_13, %w]: I32
    ret %v_21
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 12, 4: Ptr
    store %v_1, 0, 4
    %v_2 = add %v_1, 4: Ptr
    store %v_2, 20, 4
    %v_3 = call_complex area, %v_1: I32
    %v_4 = add %v_3, 25: I32
    %v_5 = alloca 12, 4: Ptr
    store %v_5, 0, 4
    %v_6 = add %v_5, 4: Ptr
    store %v_6, 3, 4
    %v_7 = call_complex area, %v_5: I32
    %v_8 = add %v_4, %v_7: I32
    %v_9 = alloca 12, 4: Ptr
    store %v_9, 1, 4
    %v_10 = add %v_9, 4: Ptr
    store %v_10, 20, 4
    %v_11 = add %v_9, 8: Ptr
    store %v_11, 2, 4
    %v_12 = call_complex area, %v_9: I32
    %v_13 = add %v_8, %v_12: I32
    %v_14 = alloca 12, 4: Ptr
    store %v_14, 1, 4
    %v_15 = add %v_14, 4: Ptr
    store %v_15, 3, 4
    %v_16 = add %v_14, 8: Ptr
    store %v_16, 9, 4
    %v_17 = call_complex area, %v_14: I32
    %v_18 = add %v_13, %v_17: I32
    %v_19 = add %v_18, 18: I32
    ret %v_19
  }
}

