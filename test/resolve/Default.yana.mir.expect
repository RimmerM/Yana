data Box(a) {item: a} drop derived reclaim derived

data Box(I32) {item: I32} of Box

class Describe(a): size, doubled

instance Eq(Metres): Metres.==, Eq.!=

instance Ord(Metres): Ord.<, Ord.<=, Ord.>, Ord.>=, Metres.compare, Ord.min, Ord.max

instance Eq(Feet): Feet.==, Feet.!=

instance FromInt(Cents): Cents.fromInt

instance Eq(Cents): Cents.==, Eq.!=

instance Num(Cents): Cents.+, Cents.-, Cents.*, Cents./, Num.-

instance Eq(Flags): Flags.==, Eq.!=

instance Bitwise(Flags): Flags.and, Flags.or, Flags.xor, Flags.not

instance Describe(Metres): Metres.size, Describe.doubled

instance (Eq(a)) Eq(Box(a)): Box(a).==, Eq.!=

fn size(value: a [shared call]) -> I32 = <no body>

fn doubled(value: a [shared call]) -> I32 {
  form specialized
  slot #0 type a
  slot #1 class Describe(a)
bb0:
  %0: a [shared call] = read borrow.shared (value) loan0
  %1: I32 = call size(a) borrow.shared %0
  %2: a [shared call] = read borrow.shared (value) loan1
  %3: I32 = call size(a) borrow.shared %2
  %4: I32 = add inspect %1 inspect %3
  return take %4
}

