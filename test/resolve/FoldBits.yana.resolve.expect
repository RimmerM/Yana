let image$base: () = <none>

fn check(%ok: Bool, %weight: I32) -> I32 {
  b0:
    je %ok, b1, b2

  b1:
    jmp b3

  b2:
    jmp b3

  b3:
    %v6 = phi [b1, %weight], [b2, 0] : I32
    ret %v6
}

fn unsignedWrap() -> I32 {
  b0:
    %v3 = add 200, 100 : U8
    %v6 = cmp_eq %v3, 44 : Bool
    %v8 = call check, %v6, 1 : I32
    ret %v8
}

fn signedWrap() -> I32 {
  b0:
    %v3 = add 100, 100 : I8
    %v7 = sub 0, 56 : I8
    %v8 = cmp_eq %v3, %v7 : Bool
    %v10 = call check, %v8, 2 : I32
    ret %v10
}

fn narrowShift() -> I32 {
  b0:
    %v3 = shl 200, 1 : U8
    %v6 = cmp_eq %v3, 144 : Bool
    %v8 = call check, %v6, 4 : I32
    ret %v8
}

fn packed() -> Packed {
  b0:
    %v0 = alloc : Packed
    %v4 = add 250, 50 : U32
    %v6 = and %v4, 15 : U32
    %v7 = cast %v6 : @bits(4) U32
    %v11 = add 10, 10 : I32
    %v13 = shl %v11, 27 : I32
    %v15 = sar %v13, 27 : I32
    %v16 = cast %v15 : @bits(5) I32
    init %local0@Packed.small, %v7
    init %local0@Packed.signed, %v16
    ret %v0
}

fn refinedUnsigned() -> I32 {
  b0:
    %v0 = call packed : Packed
    %v1 = load %local0@Packed.small : @bits(4) U32
    %v3 = cast %v1 : U32
    %v5 = cmp_eq %v3, 12 : Bool
    %v7 = call check, %v5, 8 : I32
    ret %v7
}

fn refinedSigned() -> I32 {
  b0:
    %v0 = call packed : Packed
    %v1 = load %local0@Packed.signed : @bits(5) I32
    %v5 = sub 0, 12 : I32
    %v6 = cast %v1 : I32
    %v7 = cmp_eq %v6, %v5 : Bool
    %v9 = call check, %v7, 16 : I32
    ret %v9
}

fn signedCompare() -> I32 {
  b0:
    %v3 = sub 0, 1 : I8
    %v5 = cmp_lt %v3, 0 : Bool
    %v7 = call check, %v5, 32 : I32
    ret %v7
}

fn unsignedCompare() -> I32 {
  b0:
    %v2 = cmp_gt 255, 1 : Bool
    %v4 = call check, %v2, 64 : I32
    ret %v4
}

fn narrowComplement() -> I32 {
  b0:
    %v1 = not 0 : U8
    %v4 = cmp_eq %v1, 255 : Bool
    %v6 = call check, %v4, 128 : I32
    ret %v6
}

fn main() -> I32 {
  b0:
    %v0 = call unsignedWrap : I32
    %v1 = call signedWrap : I32
    %v2 = add %v0, %v1 : I32
    %v3 = call narrowShift : I32
    %v4 = add %v2, %v3 : I32
    %v5 = call refinedUnsigned : I32
    %v6 = add %v4, %v5 : I32
    %v7 = call refinedSigned : I32
    %v8 = add %v6, %v7 : I32
    %v9 = call signedCompare : I32
    %v10 = add %v8, %v9 : I32
    %v11 = call unsignedCompare : I32
    %v12 = add %v10, %v11 : I32
    %v13 = call narrowComplement : I32
    %v14 = add %v12, %v13 : I32
    ret %v14
}
