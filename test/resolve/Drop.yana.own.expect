fn +=(I64) {
  %target: I64 borrowed live [0, 1) [2, 3)
  %amount: I64 borrowed live [0, 2)
  %local2: I64 live [1, 3)
}

fn -=(I64) {
  %target: I64 borrowed live [0, 1) [2, 3)
  %amount: I64 borrowed live [0, 2)
  %local2: I64 live [1, 3)
}

