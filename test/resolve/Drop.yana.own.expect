fn loop {
  %total: I64 live [0, 10) [11, 21)
  %i: I64 live [2, 9) [11, 21)
  %local2: Buffer droppable live [4, 9) [11, 21)
}

fn main {
  %result: I64 live [0, 9) [11, 19) [21, 29) [31, 39) [41, 49) [51, 61) [63, 65)
  %local1: Buffer droppable live [52, 55)
}

fn Drop(Buffer).drop {
