fn loop {
  %total: I64 writable live [0, 10) [11, 21)
  %i: I64 writable live [2, 9) [11, 21)
  %local2: Buffer droppable readonly live [4, 9) [11, 21)
}

fn main {
  %result: I64 writable live [0, 9) [11, 19) [21, 29) [31, 39) [41, 49) [51, 59) [61, 71) [73, 75)
  %local1: Buffer droppable readonly live [62, 65)
