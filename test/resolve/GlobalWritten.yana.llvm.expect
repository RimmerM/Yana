target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

module asm "\09.set \22image$base\22, 0"

@"image$base" = external constant [0 x i8], align 8
@dynamic = global [4 x i8] zeroinitializer, align 8
@counter = global [4 x i8] zeroinitializer, align 8
@"ResolveTest.string$0" = constant [2 x i8] c"ab", align 8
@greeting = constant <{ ptr, [8 x i8] }> <{ ptr @"ResolveTest.string$0", [8 x i8] c"\02\00\00\00\02\00\00\00" }>, align 8

define fastcc i32 @countdown(i32 %k) {
  br label %1

1:                                                ; preds = %8, %0
  %2 = phi i32 [ %k, %0 ], [ %9, %8 ]
  %3 = icmp sle i32 %2, 0
  %4 = zext i1 %3 to i32
  br i1 %3, label %5, label %7

5:                                                ; preds = %1
  %6 = load i32, ptr @dynamic, align 1
  ret i32 %6

7:                                                ; preds = %1
  br label %8

8:                                                ; preds = %7
  %9 = sub i32 %2, 1
  br label %1
}

define fastcc i32 @"main$"() {
  br label %1

1:                                                ; preds = %0
  store i32 7, ptr @dynamic, align 1
  %2 = load i32, ptr @counter, align 1
  %3 = add i32 %2, 20
  store i32 %3, ptr @counter, align 1
  %4 = call fastcc i32 @countdown(i32 3)
  %5 = icmp eq i32 %4, 7
  %6 = zext i1 %5 to i32
  br i1 %5, label %7, label %8

7:                                                ; preds = %1
  br label %8

8:                                                ; preds = %7, %1
  %9 = phi i32 [ 0, %1 ], [ 1, %7 ]
  %10 = load i32, ptr @counter, align 1
  %11 = icmp eq i32 %10, 20
  %12 = zext i1 %11 to i32
  br i1 %11, label %13, label %15

13:                                               ; preds = %8
  %14 = add i32 %9, 2
  br label %15

15:                                               ; preds = %13, %8
  %16 = phi i32 [ %9, %8 ], [ %14, %13 ]
  %17 = add i32 %16, 4
  %18 = load i32, ptr getelementptr (i8, ptr @greeting, i64 12), align 1
  %19 = icmp eq i32 %18, 2
  %20 = zext i1 %19 to i32
  br i1 %19, label %21, label %23

21:                                               ; preds = %15
  %22 = add i32 %17, 8
  br label %23

23:                                               ; preds = %21, %15
  %24 = phi i32 [ %17, %15 ], [ %22, %21 ]
  ret i32 %24
}
