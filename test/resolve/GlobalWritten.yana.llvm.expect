target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

@"image$base" = constant [0 x i8] zeroinitializer, align 8
@dynamic = global [4 x i8] zeroinitializer, align 8
@counter = global [4 x i8] zeroinitializer, align 8
@origin = constant [8 x i8] c"\01\00\00\00\02\00\00\00", align 8
@"ResolveTest.string$0" = constant [2 x i8] c"ab", align 8
@greeting = constant <{ ptr, [8 x i8] }> <{ ptr @"ResolveTest.string$0", [8 x i8] c"\02\00\00\00\02\00\00\00" }>, align 8

define fastcc i32 @countdown(i32 %k) {
  br label %1

1:                                                ; preds = %8, %0
  %2 = phi i32 [ %k, %0 ], [ %9, %8 ]
  %3 = icmp sle i32 %2, 0
  %4 = zext i1 %3 to i32
  br i1 %3, label %5, label %7

5:                                                ; preds = %1
  %6 = load i32, ptr @dynamic, align 1
  ret i32 %6

7:                                                ; preds = %1
  br label %8

8:                                                ; preds = %7
  %9 = sub i32 %2, 1
  br label %1
}

define fastcc i32 @main() {
  br label %1

1:                                                ; preds = %0
  %2 = call fastcc i32 @countdown(i32 3)
  %3 = icmp eq i32 %2, 7
  %4 = zext i1 %3 to i32
  br i1 %3, label %5, label %6

5:                                                ; preds = %1
  br label %7

6:                                                ; preds = %1
  br label %7

7:                                                ; preds = %5, %6
  %8 = phi i32 [ 1, %5 ], [ 0, %6 ]
  %9 = load i32, ptr @counter, align 1
  %10 = icmp eq i32 %9, 20
  %11 = zext i1 %10 to i32
  br i1 %10, label %12, label %14

12:                                               ; preds = %7
  %13 = add i32 %8, 2
  br label %15

14:                                               ; preds = %7
  br label %15

15:                                               ; preds = %12, %14
  %16 = phi i32 [ %13, %12 ], [ %8, %14 ]
  %17 = load i32, ptr @origin, align 1
  %18 = load i32, ptr getelementptr (i8, ptr @origin, i64 4), align 1
  %19 = add i32 %17, %18
  %20 = icmp eq i32 %19, 3
  %21 = zext i1 %20 to i32
  br i1 %20, label %22, label %24

22:                                               ; preds = %15
  %23 = add i32 %16, 4
  br label %25

24:                                               ; preds = %15
  br label %25

25:                                               ; preds = %22, %24
  %26 = phi i32 [ %23, %22 ], [ %16, %24 ]
  %27 = load i32, ptr getelementptr (i8, ptr @greeting, i64 12), align 1
  %28 = icmp eq i32 %27, 2
  %29 = zext i1 %28 to i32
  br i1 %28, label %30, label %32

30:                                               ; preds = %25
  %31 = add i32 %26, 8
  br label %33

32:                                               ; preds = %25
  br label %33

33:                                               ; preds = %30, %32
  %34 = phi i32 [ %31, %30 ], [ %26, %32 ]
  ret i32 %34
}

define fastcc i32 @"main$"() {
  br label %1

1:                                                ; preds = %0
  store i32 7, ptr @dynamic, align 1
  %2 = load i32, ptr @counter, align 1
  %3 = add i32 %2, 20
  store i32 %3, ptr @counter, align 1
  %4 = call fastcc i32 @main()
  ret i32 %4
}
