let image$base: () = <none>

fn main() -> I32 {
  b0:
    %byte = alloc : U8
    init %byte, 0
    %short = alloc : U16
    init %short, 0
    %one = alloc : U8
    init %one, 1
    %signed = alloc : I8
    init %signed, 1
    %v12 = load %byte : U8
    %v13 = not %v12 : U8
    %v14 = cast %v13 : I32
    %v15 = load %short : U16
    %v16 = not %v15 : U16
    %v17 = cast %v16 : I32
    %v18 = add %v14, %v17 : I32
    %v19 = load %one : U8
    %v20 = neg %v19 : U8
    %v21 = cast %v20 : I32
    %v22 = add %v18, %v21 : I32
    %v23 = load %signed : I8
    %v24 = not %v23 : I8
    %v25 = cast %v24 : I32
    %v26 = add %v22, %v25 : I32
    ret %v26
}
