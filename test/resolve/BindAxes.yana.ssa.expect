  store inspect %2 borrow %1
  %3: Size trivial = load inspect %2
  %4: Run(U8) owned = call newRun(U8) borrow %3
  %5: %Run(U8) address = field.addr .value inspect %0
  drop Run(U8) [unique call] boxes borrowed inspect %5
  %6: %Run(U8) address = field.addr .value inspect %0
  store inspect %6 consume %4
  return
}

fn slotCount(self: Held [shared call]) -> Size {
bb0(%0: Held [shared call] guaranteed):
  %1: %Run(U8) address = field.addr .value inspect %0
  %2: %@bits(30) U32 address = field.addr .capacity inspect %1
  %3: @bits(30) U32 trivial = load inspect %2
  %4: Size trivial = convert inspect %3
  return consume %4
}

