module ResolveTest

fn make(ok: Bool [shared call], n: Size [shared call]) -> Result(I64, Held) {
bb0(%0: Bool [shared call] guaranteed, %1: Size [shared call] guaranteed):
  %2: %Bool address = alloc frame Bool [shared call]
  %3: %Size address = alloc frame Size [shared call]
  store inspect %2 borrow %0
  store inspect %3 borrow %1
  %4: Bool trivial = load inspect %2
  %5: Bool trivial = not inspect %4
  branch inspect %5 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %6: Size trivial = load inspect %3
  %7: Run(U8) owned = call newRun(U8) borrow %6
  %8: Held owned = aggregate.Held consume %7
  %9: Result(I64, Held) owned = aggregate.Ok consume %8
  return consume %9

bb3:
  %10: I64 trivial = const 7
  %11: Result(I64, Held) owned = aggregate.Err consume %10
  return consume %11
}

