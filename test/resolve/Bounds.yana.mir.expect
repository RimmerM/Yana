  %14: Size = const 0
  write.init borrow.unique ([%%3][0]) take %0
  %16: Size = const 1
  write.init borrow.unique ([%%3][1]) take %1
  %18: Size = const 2
  write.init borrow.unique ([%%3][2]) take %2
  %20: Array(I32) = read take (local0)
  write.init borrow.unique (xs) take %20
  %22: Array(I32) [unique call] = read borrow.unique (xs) loan0
  %23: I32 = const 40
  %24: {} = call push(I32) borrow.unique %22 take %23
  %25: Array(I32) [unique call] = read borrow.unique (xs) loan1
  %26: I32 = const 3
  %27: Maybe(I32) = call remove(I32) borrow.unique %25 borrow.shared %26
  %28: Size = const 0
  %29: Array(I32) [shared call] = read borrow.shared (xs) loan2
  %30: Array(I32) [shared slot 0 view] = call.derivation elements(Array(I32), I32) borrow.shared %29 roots{2}
  %31: I32 [shared slot 0] = call.subscript get(Array(I32), Size, I32) borrow.shared %30 borrow.shared %28 roots{2}
  write.init borrow.unique (local2) borrow.shared %31
  %33: I32 = read copy.trivial (local2)
  %34: Size = const 2
  %35: Array(I32) [shared call] = read borrow.shared (xs) loan3
  %36: Array(I32) [shared slot 0 view] = call.derivation elements(Array(I32), I32) borrow.shared %35 roots{3}
  %37: I32 [shared slot 0] = call.subscript get(Array(I32), Size, I32) borrow.shared %36 borrow.shared %34 roots{3}
  write.init borrow.unique (local3) borrow.shared %37
  %39: I32 = read copy.trivial (local3)
  drop (xs)
  %40: I32 = add inspect %33 inspect %39
  return take %40
}

