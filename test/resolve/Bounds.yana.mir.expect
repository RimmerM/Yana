fn atBoth(xs: c [shared call], a: k [shared call], b: k [shared call]) -> v {
  form specialized
  slot #0 type c
  slot #1 type k
  slot #2 type v
  slot #3 class Index(c, k, v)
  slot #4 class Num(v)
  local local3: v [shared slot 0]
  local local4: v [shared slot 0]

bb0:
  %0: k [shared call] = read borrow.shared (a) loan0
  %1: c [shared call] = read borrow.shared (xs) loan1
  %2: v [shared slot 0] = call.subscript get(c, k, v) borrow.shared %1 borrow.shared %0 roots{1}
  write.init borrow.unique (local3) borrow.shared %2
  %4: v [shared slot 0] = read borrow.shared (local3) loan2 roots{1}
  %5: k [shared call] = read borrow.shared (b) loan3
  %6: c [shared call] = read borrow.shared (xs) loan4
  %7: v [shared slot 0] = call.subscript get(c, k, v) borrow.shared %6 borrow.shared %5 roots{4}
  write.init borrow.unique (local4) borrow.shared %7
  %9: v [shared slot 0] = read borrow.shared (local4) loan5 roots{4}
  %10: v = call +(v) borrow.shared %4 borrow.shared %9
  return take %10
}

