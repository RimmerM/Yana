    %v_6 = add %r, 4: Ptr
    %n = loads %v_6, 4: I32
    %v_7 = shl %n, 1: I32
    %v_8 = select %v_5, %v_7, 18446744073709551615: I32
    jmp b_9
  }

  b_3 {
    %v_10 = add %r, 4: Ptr
    %n = loads %v_10, 4: I32
    jmp b_9
  }

  b_9 {
    %v_11 = phi [b_3, %n], [b_4, %v_8]: I32
