{-
   `Reject.FromText.yana` was this fixture under the shipping stage - same literals, same words.

   The acceptance table is `compiler/intrinsic/text.h`'s; both stages once read through it, which
   this fixture held the shipping stage to. That stage is gone, so this file now duplicates
   `Reject.FromText.yana` and stays as its historical record.
-}

fn main() -> Int:
    let two = "ab" :: Char
    let none = "" :: CodeUnit
    let latin = "é" :: U8
    let unit = "é" :: CodeUnit
    let signed = "é" :: I8
    let astral = "😀" :: U16
    let high = "가" :: I16
    let surrogate = "\xD800" :: Char
    let wide = "\xDFFF" :: U32
    return 0
