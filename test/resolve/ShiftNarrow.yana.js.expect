"use strict";
// ResolveTest
function shr8(x, n) {
  return (x & 255) >>> n << 24 >> 24;
}

function shr16(x, n) {
  return (x & 65535) >>> n << 16 >> 16;
}

function shr32(x, n) {
  return x >>> n | 0;
}

function sar8(x, n) {
  return x >> n << 24 >> 24;
}

function main() {
  return (((((shr8(-100, 1) | 0) + (shr8(-100, 7) | 0) | 0) + (shr16(-100, 1) | 0) | 0) + (shr16(-100, 15) | 0) | 0) + (shr32(-100, 20) + (sar8(-100, 1) | 0) | 0) | 0) + 8207 | 0;
}
main();
