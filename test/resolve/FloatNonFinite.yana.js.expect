"use strict";
// ResolveTest
function above(x, limit) {
  return x > limit ? 1 : 0;
}

function below(x, limit) {
  return x < limit ? 1 : 0;
}

function unequal(x) {
  return x !== x ? 1 : 0;
}

function main() {
  var low = Math.fround(0 - Infinity);
  var wide = 1E308 * 10;
  var bits = 0;
  if (above(Infinity, 3.0000000054977558E38)) {
    bits = bits + 1 | 0;
  }
  if (above(low, -3.0000000054977558E38) ^ 1) {
    bits = bits + 2 | 0;
  }
  if (unequal(Math.fround(Infinity + low))) {
    bits = bits + 4 | 0;
  }
  if (below(wide, 1E308) ^ 1) {
    bits = bits + 8 | 0;
  }
  if (below(0 - wide, -1E308)) {
    bits = bits + 16 | 0;
  }
  if (below(1 / -0, -1E308)) {
    bits = bits + 32 | 0;
  }
  if (unequal(Infinity) ^ 1) {
    bits = bits + 64 | 0;
  }
  return bits;
}
main();
