ResolveTest.continuation$23<complex>(%env: Ptr, %value$: I32): I32 {
  b_0 {
    %seen = xor %value$, 1: I32
    %v = select %seen, 1, 2: I32
    %v_1 = loads @log, 4: I32
    %v_2 = add %v, %v_1: I32
