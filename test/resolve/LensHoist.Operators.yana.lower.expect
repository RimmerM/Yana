@image$base = []
mut @log = [0, 0, 0, 0]

main<complex>(): I32 {
  b_0 {
    %v_1 = imm 1: I32
    store @log, %v_1, 4
    %v_2 = call_complex ResolveTest.continuation$23, %v_1: I32
    %v_3 = imm 1: I32
    store @log, %v_3, 4
    %v_4 = call_complex ResolveTest.continuation$24, %v_3: I32
    store @log, 1, 4
    %v_5 = call_complex ResolveTest.continuation$25, 1: I32
    store @log, 101, 4
    %v_6 = imul %v_2, 10000: I32
    %v_7 = imul %v_4, 1000: I32
    %v_8 = add %v_6, %v_7: I32
    %v_9 = imul %v_5, 100: I32
    %v_10 = add %v_8, %v_9: I32
    %v_11 = add %v_10, 23: I32
    ret %v_11
  }
}

ResolveTest.continuation$23<complex>(%value$: I32): I32 {
  b_0 {
    %seen = add %value$, 3: I32
    %v_1 = loads @log, 4: I32
    %v_2 = add %seen, %v_1: I32
    ret %v_2
  }
}

ResolveTest.continuation$24<complex>(%value$: I32): I32 {
  b_0 {
    %v_1 = shl %value$, 1: I32
    %seen = add %v_1, 3: I32
    %v_2 = loads @log, 4: I32
    %v_3 = add %seen, %v_2: I32
    ret %v_3
  }
}

ResolveTest.continuation$25<complex>(%value$: I32): I32 {
  b_0 {
    %seen = xor %value$, 1: I32
    %v = select %seen, 1, 2: I32
    %v_1 = loads @log, 4: I32
    %v_2 = add %v, %v_1: I32
    ret %v_2
  }
}

