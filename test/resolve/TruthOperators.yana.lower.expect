@image$base = []
@empty = [0, 0, 0, 0, 0, 0, 0, 0]
@read = [1, 0, 0, 0, 0, 0, 0, 0]
@write = [2, 0, 0, 0, 0, 0, 0, 0]
mut @effects = [0, 0, 0, 0]

main<complex>(): Int {
  b_0 {
    %value$ = loads @empty, 8: Long
    %v_1 = cmp_neq %value$, 0: Int
    je %v_1, b_2, b_3
  }

  b_3 {
    jmp b_4
  }

  b_4 {
    %value$ = loads @read, 8: Long
    %v_5 = cmp_neq %value$, 0: Int
    je %v_5, b_6, b_7
  }

  b_6 {
    %v_8 = not %value$: Long
    %v_9 = cmp_neq %v_8, 0: Int
    je %v_9, b_10, b_11
  }

  b_10 {
    %v_12 = not %value$: Long
    %v_13 = cmp_eq %v_12, %value$: Int
    je %v_13, b_14, b_15
  }

  b_15 {
    %v_16 = cmp_neq %value$, 0: Int
    je %v_16, b_17, b_18
  }

  b_17 {
    %v_19 = loads @effects, 4: Int
    %v_20 = add %v_19, 1: Int
    store @effects, %v_20, 4
    %v_21 = cmp_neq %value$, 0: Int
    je %v_21, b_22, b_18
  }

  b_18 {
    %v_23 = cmp_neq %value$, 0: Int
    je %v_23, b_24, b_25
  }

  b_25 {
    jmp b_26
  }

  b_24 {
    %v_27 = loads @effects, 4: Int
    %v_28 = add %v_27, 1: Int
    store @effects, %v_28, 4
    jmp b_26
  }

  b_26 {
    %v_29 = phi [b_24, 1], [b_25, 0]: Int
    %v_30 = xor %v_29, 1: Int
    je %v_30, b_31, b_32
  }

  b_32 {
    %v_33 = cmp_neq %value$, 0: Int
    je %v_33, b_34, b_35
  }

  b_35 {
    %v_36 = loads @effects, 4: Int
    %v_37 = add %v_36, 1: Int
    store @effects, %v_37, 4
    %v_38 = cmp_neq %value$, 0: Int
    jmp b_39
  }

  b_34 {
    jmp b_39
  }

  b_39 {
    %v_40 = phi [b_35, %v_38], [b_34, 1]: Int
    %v_41 = xor %v_40, 1: Int
    je %v_41, b_42, b_43
  }

  b_43 {
    %v_44 = loads @effects, 4: Int
    %v_45 = cmp_neq %v_44, 1: Int
    je %v_45, b_46, b_47
  }

  b_47 {
    jmp b_48
  }

  b_48 {
    jmp b_49
  }

  b_49 {
    jmp b_50
  }

  b_50 {
    jmp b_51
  }

  b_51 {
    %rhs$ = loads @write, 8: Long
    %v_52 = or %value$, %rhs$: Long
    %v_53 = and %v_52, %value$: Long
    %v_54 = cmp_eq %v_53, %value$: Int
    je %v_54, b_55, b_56
  }

  b_55 {
    %v_57 = cast %v_52: Int
    ret %v_57
  }

  b_56 {
    ret 13
  }

  b_46 {
    ret 12
  }

  b_42 {
    ret 11
  }

  b_31 {
    ret 10
  }

  b_22 {
    ret 9
  }

  b_14 {
    ret 5
  }

  b_11 {
    ret 4
  }

  b_7 {
    ret 3
  }

  b_2 {
    ret 1
  }
}

