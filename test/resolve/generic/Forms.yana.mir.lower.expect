
unbox<complex>(%b: Ptr): I32 {
  b_0 {
    %v_1 = loads %b, 4: I32
    ret %v_1
  }
}

spread<complex>(%t: Ptr): I32 {
  b_0 {
    %v_1 = loads %t, 4: I32
    %v_2 = add %t, 4: Ptr
    %v_3 = loads %v_2, 4: I32
    %v_4 = add %v_1, %v_3: I32
    ret %v_4
  }
}

Count.shift<complex>(%v_0: Ptr, %x: Ptr) {
  b_1 {
    %v_2 = loads %x, 4: I32
    %v_3 = add %v_2, 1: I32
    %v_4 = alloca 4, 4: Ptr
    store %v_4, %v_3, 4
    copy %v_0, %v_4, 4
    ret 
  }
}

Count.shift'2<complex>(%v_0: Ptr, %x: Ptr, %step: Ptr) {
  b_1 {
    %v_2 = loads %x, 4: I32
    %v_3 = loads %step, 4: I32
    %v_4 = add %v_2, %v_3: I32
    %v_5 = alloca 4, 4: Ptr
    store %v_5, %v_4, 4
    copy %v_0, %v_5, 4
    ret 
  }
}

size<complex>(%t: Ptr): I32 {
  b_0 {
    %v_1 = loads %t, 4: I32
    ret %v_1
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    %v_2 = alloca 4, 4: Ptr
    %v_3 = alloca 4, 4: Ptr
    %v_4 = alloca 4, 4: Ptr
    store %v_4, 10, 4
    copy %v_1, %v_4, 4
    %v_5 = alloca 4, 4: Ptr
    copy %v_5, %v_1, 4
    %v_6 = alloca 4, 4: Ptr
    call_complex Count.shift, %v_6, %v_5
    copy %v_2, %v_6, 4
    %v_7 = alloca 4, 4: Ptr
    copy %v_7, %v_1, 4
    %v_8 = alloca 4, 4: Ptr
    copy %v_8, %v_2, 4
    %v_9 = alloca 4, 4: Ptr
    call_complex Count.shift'2, %v_9, %v_7, %v_8
    copy %v_3, %v_9, 4
    %v_10 = alloca 4, 4: Ptr
    store %v_10, 100, 4
    %v_11 = call_complex unbox, %v_10: I32
    %v_12 = alloca 8, 4: Ptr
    store %v_12, 2, 4
    %v_13 = add %v_12, 4: Ptr
    store %v_13, 3, 4
    %v_14 = call_complex spread, %v_12: I32
    %v_15 = add %v_11, %v_14: I32
    %v_16 = loads %v_3, 4: I32
    %v_17 = add %v_15, %v_16: I32
    %v_18 = alloca 4, 4: Ptr
    call_complex blank(Count), %v_18
    %v_19 = call_complex size, %v_18: I32
    %v_20 = add %v_17, %v_19: I32
    ret %v_20
  }
}

blank(Count)<complex>(%v_0: Ptr) {
  b_1 {
    %v_2 = alloca 4, 4: Ptr
    store %v_2, 5, 4
    copy %v_0, %v_2, 4
    ret 
  }
}

