module ResolveTest

data Step(f) {run: f, weight: I32} drop derived reclaim derived

data held.lambda.env {n: I32}

data counted.lambda.env {n: I32}

data Step(counted.lambda.env) {run: counted.lambda.env, weight: I32} of Step

data main.lambda.env {}

data main.lambda'2.env {n: I32}

data main.lambda'3.env {n: I32}

fn go(s: Step(f) [shared call], x: I32 [shared call]) -> I32 {
  form specialized
  slot #0 type f
  slot #1 class Call(f, (I32) -> I32)
bb0:
  %0: f [shared call] = read borrow.shared (s.run) loan0
  %1: I32 = read copy.trivial (x)
  %2: I32 = call borrow.shared %0 borrow.shared %1
  %3: I32 = read copy.trivial (s.weight)
  %4: I32 = mul inspect %2 inspect %3
  return take %4
}

fn apply(g: f [shared call], x: I32 [shared call]) -> I32 {
  form specialized
  slot #0 type f
  slot #1 class Call(f, (I32) -> I32)
bb0:
  %0: f [shared call] = read borrow.shared (g) loan0
  %1: I32 = read copy.trivial (x)
  %2: I32 = call borrow.shared %0 borrow.shared %1
  return take %2
}

fn twice(g: f [shared call], x: I32 [shared call]) -> I32 {
  form specialized
  slot #0 type f
  slot #1 class Call(f, (I32) -> I32)
bb0:
  %0: f [shared call] = read borrow.shared (g) loan0
  %1: f [shared call] = read borrow.shared (g) loan1
  %2: I32 = read copy.trivial (x)
  %3: I32 = call borrow.shared %1 borrow.shared %2
  %4: I32 = call borrow.shared %0 borrow.shared %3
  return take %4
}

fn lends(g: f [shared call], target: I32 [unique call]) -> {} {
  form specialized
  slot #0 type f
  slot #1 class Call(f, (&I32) -> {})
bb0:
  %0: f [shared call] = read borrow.shared (g) loan0
  %1: I32 [unique call] = read borrow.unique (target) loan1
  %2: {} = call borrow.shared %0 borrow.unique %1
  return
}

fn double(x: I32 [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (x)
  %1: I32 = const 2
  %2: I32 = mul inspect %0 inspect %1
  return take %2
}

fn triple(x: I32 [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (x)
  %1: I32 = const 3
  %2: I32 = mul inspect %0 inspect %1
  return take %2
}

fn opaque(x: I32 [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (x)
  return take %0
}

fn held(n: I32 [shared call]) -> I32 {
  local f: held.lambda.env

bb0:
  %0: I32 = read copy.trivial (n)
  %1: held.lambda.env = aggregate.held.lambda.env take %0
  write.init borrow.unique (f) take %1
  %3: held.lambda.env = read copy.trivial (f)
  %4: I32 = const 5
  %5: I32 = call borrow.shared %3 borrow.shared %4
  %6: held.lambda.env = read copy.trivial (f)
  %7: I32 = const 6
  %8: I32 = call borrow.shared %6 borrow.shared %7
  %9: I32 = add inspect %5 inspect %8
  return take %9
}

fn counted(n: I32 [shared call]) -> I32 {
  local s: Step(counted.lambda.env)

bb0:
  %0: I32 = read copy.trivial (n)
  %1: counted.lambda.env = aggregate.counted.lambda.env take %0
  %2: I32 = const 2
  %3: Step(counted.lambda.env) = aggregate.Step take %1 take %2
  write.init borrow.unique (s) take %3
  %5: Step(counted.lambda.env) = read copy.trivial (s)
  %6: I32 = const 5
  %7: I32 = call go(counted.lambda.env) borrow.shared %5 borrow.shared %6
  return take %7
}

fn main() -> I32 {
  local n: I32
  local a: I32
  local b: I32
  local c: I32
  local local4: (I32) -> I32 [owned here shape8 .0=unique call]
  local d: I32
  local e: I32
  local local7: (I32) -> I32 [owned here shape8 .0=unique call]
  local f: I32
  local & target: I32

bb0:
  %0: I32 = const 3
  %1: I32 = call opaque borrow.shared %0
  write.init borrow.unique (n) take %1
  %3: I32 = read copy.trivial (n)
  %4: I32 = call held borrow.shared %3
  write.init borrow.unique (a) take %4
  %6: I32 = read copy.trivial (n)
  %7: I32 = call counted borrow.shared %6
  write.init borrow.unique (b) take %7
  %9: I32 = const 4
  %10: I32 = call opaque borrow.shared %9
  %11: main.lambda.env = aggregate.main.lambda.env
  %12: I32 = call apply(main.lambda.env) borrow.shared %11 borrow.shared %10
  write.init borrow.unique (c) take %12
  %14: (I32) -> I32 [owned here shape8 .0=unique call] = fun.value double
  write.init borrow.unique (local4) take %14
  %16: (I32) -> I32 [shared call shape8 .0=unique call] = read borrow.shared (local4) loan0
  %17: I32 = const 7
  %18: I32 = call opaque borrow.shared %17
  %19: I32 = call apply((I32) -> I32) borrow.shared %16 borrow.shared %18
  write.init borrow.unique (d) take %19
  %21: I32 = const 1
  %22: I32 = call opaque borrow.shared %21
  %23: I32 = read copy.trivial (n)
  %24: main.lambda'2.env = aggregate.main.lambda'2.env take %23
  %25: I32 = call twice(main.lambda'2.env) borrow.shared %24 borrow.shared %22
  write.init borrow.unique (e) take %25
  %27: (I32) -> I32 [owned here shape8 .0=unique call] = fun.value triple
  write.init borrow.unique (local7) take %27
  %29: (I32) -> I32 [shared call shape8 .0=unique call] = read borrow.shared (local7) loan1
  %30: I32 = const 2
  %31: I32 = call opaque borrow.shared %30
  %32: I32 = call twice((I32) -> I32) borrow.shared %29 borrow.shared %31
  write.init borrow.unique (f) take %32
  %34: I32 = const 100
  %35: I32 = call opaque borrow.shared %34
  write.init borrow.unique (target) take %35
  %37: I32 [unique call] = read borrow.unique (target) loan2
  %38: I32 = read copy.trivial (n)
  %39: main.lambda'3.env = aggregate.main.lambda'3.env take %38
  %40: {} = call lends(main.lambda'3.env) borrow.shared %39 borrow.unique %37
  %41: I32 = read copy.trivial (a)
  %42: I32 = read copy.trivial (b)
  %43: I32 = add inspect %41 inspect %42
  %44: I32 = read copy.trivial (c)
  %45: I32 = add inspect %43 inspect %44
  %46: I32 = read copy.trivial (d)
  %47: I32 = add inspect %45 inspect %46
  %48: I32 = read copy.trivial (e)
  %49: I32 = add inspect %47 inspect %48
  %50: I32 = read copy.trivial (f)
  %51: I32 = add inspect %49 inspect %50
  %52: I32 = read copy.trivial (target)
  %53: I32 = add inspect %51 inspect %52
  return take %53
}

fn held.lambda(held.lambda.env: held.lambda.env [shared call], x: I32 [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (x)
  %1: I32 = read copy.trivial (held.lambda.env.n)
  %2: I32 = add inspect %0 inspect %1
  return take %2
}

fn counted.lambda(counted.lambda.env: counted.lambda.env [shared call], x: I32 [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (x)
  %1: I32 = read copy.trivial (counted.lambda.env.n)
  %2: I32 = add inspect %0 inspect %1
  return take %2
}

fn main.lambda(main.lambda.env: main.lambda.env [shared call], x: I32 [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (x)
  %1: I32 = const 3
  %2: I32 = mul inspect %0 inspect %1
  return take %2
}

fn main.lambda'2(main.lambda'2.env: main.lambda'2.env [shared call], x: I32 [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (x)
  %1: I32 = read copy.trivial (main.lambda'2.env.n)
  %2: I32 = add inspect %0 inspect %1
  return take %2
}

fn main.lambda'3(main.lambda'3.env: main.lambda'3.env [shared call], t: I32 [unique call]) -> {} {
bb0:
  %0: I32 = read copy.trivial (t)
  %1: I32 = read copy.trivial (main.lambda'3.env.n)
  %2: I32 = add inspect %0 inspect %1
  write.assign borrow.unique (t) take %2
  return
}

fn apply(main.lambda)(g: main.lambda.env [shared call], x: I32 [shared call]) -> I32 = <apply at main.lambda.env>

fn apply((I32) -> I32)(g: (I32) -> I32 [shared call], x: I32 [shared call]) -> I32 = <apply at (I32) -> I32>

fn twice(main.lambda'2)(g: main.lambda'2.env [shared call], x: I32 [shared call]) -> I32 = <twice at main.lambda'2.env>

fn twice((I32) -> I32)(g: (I32) -> I32 [shared call], x: I32 [shared call]) -> I32 = <twice at (I32) -> I32>

fn lends(main.lambda'3)(g: main.lambda'3.env [shared call], target: I32 [unique call]) -> {} = <lends at main.lambda'3.env>

fn go(counted.lambda)(s: Step(counted.lambda.env) [shared call], x: I32 [shared call]) -> I32 = <go at counted.lambda.env>

entry main
