{-
   The specialization budget - one generic asked for more bodies than the program may have.

   Implementation-Generics.md §10 asks for budgets "to prevent unbounded code growth", and its cost
   model's fifth input is the one this asserts: "the same function specialized at N distinct contexts
   costs N bodies; past a threshold the marginal one should be declined even if it individually
   looked profitable". Every call below is individually profitable - the density rule specializes
   `counted` every time, for the reason written above the declaration - and the thirty-third is
   declined anyway, because what a budget bounds is the sum rather than the merit of the last one.

   **A declined specialization is the erased form**, which is what makes this a refusal today rather
   than a fallback: the budget is the point where the compiler decides not to make another body, and
   the body it would emit instead is `Analysis-IR.md`'s G5. So the diagnostic is the same one
   `Reject.Erasure.yana` gets from the density rule, arrived at from the other direction - and the
   generic's `form` is revised to `erased` where it is reported, so the dump and the diagnostic agree
   about what was decided.

   A hundred and twenty-nine instantiations because the ceiling is a hundred and twenty-eight - K1,
   four times the 32 that `test/base`, the whole library's suite compiled as one program, reached
   when the ceiling was 32. A budget with no erased form under it can only refuse, so it is set where
   it cannot fire on a program that did nothing unusual - which is also why this fixture has to be
   the size it is. Ten scalar types, the hundred ordered pairs of them, and ten and nine more inside
   one and two `B`s, is a cheap way to write a hundred and twenty-nine distinct argument lists down.
-}

data B(a) {v: a}

-- Consuming rather than borrowing, which is what makes it dense: the teardown of a value whose type
-- is a variable is a descriptor load and an indirect call, so a third of this body is environment
-- work and the density rule specializes it every time. Nothing here is a reason to erase, which is
-- the point - the budget is not a judgement about this declaration.
fn (a) counted(->x: a) -> I32 = 1

fn main() -> I32:
    let &s = 0
    s += counted(0 :: I8)
    s += counted(0 :: I16)
    s += counted(0 :: I32)
    s += counted(0 :: I64)
    s += counted(0 :: U8)
    s += counted(0 :: U16)
    s += counted(0 :: U32)
    s += counted(0 :: U64)
    s += counted(0.0 :: F32)
    s += counted(0.0 :: F64)
    s += counted({0 :: I8, 0 :: I8})
    s += counted({0 :: I8, 0 :: I16})
    s += counted({0 :: I8, 0 :: I32})
    s += counted({0 :: I8, 0 :: I64})
    s += counted({0 :: I8, 0 :: U8})
    s += counted({0 :: I8, 0 :: U16})
    s += counted({0 :: I8, 0 :: U32})
    s += counted({0 :: I8, 0 :: U64})
    s += counted({0 :: I8, 0.0 :: F32})
    s += counted({0 :: I8, 0.0 :: F64})
    s += counted({0 :: I16, 0 :: I8})
    s += counted({0 :: I16, 0 :: I16})
    s += counted({0 :: I16, 0 :: I32})
    s += counted({0 :: I16, 0 :: I64})
    s += counted({0 :: I16, 0 :: U8})
    s += counted({0 :: I16, 0 :: U16})
    s += counted({0 :: I16, 0 :: U32})
    s += counted({0 :: I16, 0 :: U64})
    s += counted({0 :: I16, 0.0 :: F32})
    s += counted({0 :: I16, 0.0 :: F64})
    s += counted({0 :: I32, 0 :: I8})
    s += counted({0 :: I32, 0 :: I16})
    s += counted({0 :: I32, 0 :: I32})
    s += counted({0 :: I32, 0 :: I64})
    s += counted({0 :: I32, 0 :: U8})
    s += counted({0 :: I32, 0 :: U16})
    s += counted({0 :: I32, 0 :: U32})
    s += counted({0 :: I32, 0 :: U64})
    s += counted({0 :: I32, 0.0 :: F32})
    s += counted({0 :: I32, 0.0 :: F64})
    s += counted({0 :: I64, 0 :: I8})
    s += counted({0 :: I64, 0 :: I16})
    s += counted({0 :: I64, 0 :: I32})
    s += counted({0 :: I64, 0 :: I64})
    s += counted({0 :: I64, 0 :: U8})
    s += counted({0 :: I64, 0 :: U16})
    s += counted({0 :: I64, 0 :: U32})
    s += counted({0 :: I64, 0 :: U64})
    s += counted({0 :: I64, 0.0 :: F32})
    s += counted({0 :: I64, 0.0 :: F64})
    s += counted({0 :: U8, 0 :: I8})
    s += counted({0 :: U8, 0 :: I16})
    s += counted({0 :: U8, 0 :: I32})
    s += counted({0 :: U8, 0 :: I64})
    s += counted({0 :: U8, 0 :: U8})
    s += counted({0 :: U8, 0 :: U16})
    s += counted({0 :: U8, 0 :: U32})
    s += counted({0 :: U8, 0 :: U64})
    s += counted({0 :: U8, 0.0 :: F32})
    s += counted({0 :: U8, 0.0 :: F64})
    s += counted({0 :: U16, 0 :: I8})
    s += counted({0 :: U16, 0 :: I16})
    s += counted({0 :: U16, 0 :: I32})
    s += counted({0 :: U16, 0 :: I64})
    s += counted({0 :: U16, 0 :: U8})
    s += counted({0 :: U16, 0 :: U16})
    s += counted({0 :: U16, 0 :: U32})
    s += counted({0 :: U16, 0 :: U64})
    s += counted({0 :: U16, 0.0 :: F32})
    s += counted({0 :: U16, 0.0 :: F64})
    s += counted({0 :: U32, 0 :: I8})
    s += counted({0 :: U32, 0 :: I16})
    s += counted({0 :: U32, 0 :: I32})
    s += counted({0 :: U32, 0 :: I64})
    s += counted({0 :: U32, 0 :: U8})
    s += counted({0 :: U32, 0 :: U16})
    s += counted({0 :: U32, 0 :: U32})
    s += counted({0 :: U32, 0 :: U64})
    s += counted({0 :: U32, 0.0 :: F32})
    s += counted({0 :: U32, 0.0 :: F64})
    s += counted({0 :: U64, 0 :: I8})
    s += counted({0 :: U64, 0 :: I16})
    s += counted({0 :: U64, 0 :: I32})
    s += counted({0 :: U64, 0 :: I64})
    s += counted({0 :: U64, 0 :: U8})
    s += counted({0 :: U64, 0 :: U16})
    s += counted({0 :: U64, 0 :: U32})
    s += counted({0 :: U64, 0 :: U64})
    s += counted({0 :: U64, 0.0 :: F32})
    s += counted({0 :: U64, 0.0 :: F64})
    s += counted({0.0 :: F32, 0 :: I8})
    s += counted({0.0 :: F32, 0 :: I16})
    s += counted({0.0 :: F32, 0 :: I32})
    s += counted({0.0 :: F32, 0 :: I64})
    s += counted({0.0 :: F32, 0 :: U8})
    s += counted({0.0 :: F32, 0 :: U16})
    s += counted({0.0 :: F32, 0 :: U32})
    s += counted({0.0 :: F32, 0 :: U64})
    s += counted({0.0 :: F32, 0.0 :: F32})
    s += counted({0.0 :: F32, 0.0 :: F64})
    s += counted({0.0 :: F64, 0 :: I8})
    s += counted({0.0 :: F64, 0 :: I16})
    s += counted({0.0 :: F64, 0 :: I32})
    s += counted({0.0 :: F64, 0 :: I64})
    s += counted({0.0 :: F64, 0 :: U8})
    s += counted({0.0 :: F64, 0 :: U16})
    s += counted({0.0 :: F64, 0 :: U32})
    s += counted({0.0 :: F64, 0 :: U64})
    s += counted({0.0 :: F64, 0.0 :: F32})
    s += counted({0.0 :: F64, 0.0 :: F64})
    s += counted(B {v: 0 :: I8})
    s += counted(B {v: 0 :: I16})
    s += counted(B {v: 0 :: I32})
    s += counted(B {v: 0 :: I64})
    s += counted(B {v: 0 :: U8})
    s += counted(B {v: 0 :: U16})
    s += counted(B {v: 0 :: U32})
    s += counted(B {v: 0 :: U64})
    s += counted(B {v: 0.0 :: F32})
    s += counted(B {v: 0.0 :: F64})
    s += counted(B {v: B {v: 0 :: I8}})
    s += counted(B {v: B {v: 0 :: I16}})
    s += counted(B {v: B {v: 0 :: I32}})
    s += counted(B {v: B {v: 0 :: I64}})
    s += counted(B {v: B {v: 0 :: U8}})
    s += counted(B {v: B {v: 0 :: U16}})
    s += counted(B {v: B {v: 0 :: U32}})
    s += counted(B {v: B {v: 0 :: U64}})
    s += counted(B {v: B {v: 0.0 :: F32}})
    return s
