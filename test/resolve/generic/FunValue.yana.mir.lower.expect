@environment(twiceOver(Label)) = [0, 0, 0, 0, 0, 0, 0, 0]
@descriptor(Label) = [4, 0, 0, 13, 0, 0, 0, 0]
@image$base = []

twice<complex>(%x: I32): I32 {
  b_0 {
    %v_1 = add %x, %x: I32
    ret %v_1
  }
}

thrice<complex>(%x: I32): I32 {
  b_0 {
    %v_1 = add %x, %x: I32
    %v_2 = add %v_1, %x: I32
    ret %v_2
  }
}

twiceOver<complex>(%v_0: Ptr, %x: Ptr, %f: Ptr): I32 {
  b_1 {
    %v_2 = add %v_0, 4: Ptr
    %v_3 = load %v_2, 4: I64
    %v_4 = add %x, %v_3: Ptr
    %v_5 = loads %v_4, 4: I32
    %v_6 = load %f, 8: Ptr
    %v_7 = add %f, 8: Ptr
    %v_8 = load %v_7, 8: Ptr
    %v_9 = call_complex %v_6, %v_8, %v_5: I32
    ret %v_9
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 16, 8: Ptr
    %v_2 = alloca 20, 8: Ptr
    store %v_1, funvalue(twice), 8
    %v_3 = add %v_1, 8: Ptr
    store %v_3, 0, 8
    store %v_2, funvalue(thrice), 8
    %v_4 = add %v_2, 8: Ptr
    store %v_4, 0, 8
    %v_5 = add %v_2, 16: Ptr
    store %v_5, 5, 4
    %v_6 = load %v_2, 8: Ptr
    %v_7 = load %v_4, 8: Ptr
    %v_8 = call_complex %v_6, %v_7, 100: I32
    %v_9 = add %v_2, 16: Ptr
    %v_10 = loads %v_9, 4: I32
    %v_11 = add %v_8, %v_10: I32
    call_complex teardown(fun), %v_2
    %v_12 = add 20, %v_11: I32
    %v_13 = alloca 4, 4: Ptr
    store %v_13, 7, 4
    %v_14 = call_complex twiceOver, @environment(twiceOver(Label)), %v_13, %v_1: I32
    %v_15 = add %v_12, %v_14: I32
    %v_16 = add %v_15, 2: I32
    ret %v_16
  }
}

funvalue(twice)<complex>(%v_0: Ptr, %v_1: I32): I32 {
  b_2 {
    %v_3 = call_complex twice, %v_1: I32
    ret %v_3
  }
}

funvalue(thrice)<complex>(%v_0: Ptr, %v_1: I32): I32 {
  b_2 {
    %v_3 = call_complex thrice, %v_1: I32
    ret %v_3
  }
}

teardown(fun)<complex>(%v_0: Ptr) {
  b_1 {
    %v_2 = add %v_0, 8: Ptr
    %v_3 = load %v_2, 8: I64
    %v_4 = and %v_3, 1: I64
    %v_5 = cmp_eq %v_4, 0: I32
    je %v_5, b_6, b_7
  }

  b_7 {
    %v_8 = bitcast %v_3: Ptr
    %v_9 = sub %v_8, 1: Ptr
    %v_10 = load %v_9, 8: Ptr
    call_complex %v_10, %v_9
    jmp b_6
  }

  b_6 {
    ret 
  }
}

teardown()<complex>(%v_0: Ptr) {
  b_1 {
    ret 
  }
}

