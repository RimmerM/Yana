@environment(twiceOver(Label)) = [0, 0, 0, 0, 0, 0, 0, 0]
@descriptor(Label) = [4, 0, 0, 13, 0, 0, 0, 0]
@image$base = []

twice<complex>(%x: I32): I32 {
  b_0 {
    %v_1 = add %x, %x: I32
    ret %v_1
  }
}

thrice<complex>(%x: I32): I32 {
  b_0 {
    %v_1 = add %x, %x: I32
    %v_2 = add %v_1, %x: I32
    ret %v_2
  }
}

twiceOver<complex>(%v_0: Ptr, %x: Ptr, %f: Ptr): I32 {
  b_1 {
    %v_2 = add %v_0, 4: Ptr
    %v_3 = load %v_2, 4: I64
    %v_4 = add %x, %v_3: Ptr
    %v_5 = loads %v_4, 4: I32
    %v_6 = load %f, 8: Ptr
    %v_7 = add %f, 8: Ptr
    %v_8 = load %v_7, 8: Ptr
    %v_9 = call_complex %v_6, %v_8, %v_5: I32
    ret %v_9
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 16, 8: Ptr
    %v_2 = alloca 8, 8: Ptr
    store %v_1, funvalue(twice), 8
    %v_3 = add %v_1, 8: Ptr
    store %v_3, 0, 8
    store %v_2, 0, 8
    %v_4 = load %v_1, 8: Ptr
    %v_5 = load %v_3, 8: Ptr
    %v_6 = call_complex %v_4, %v_5, 10: I32
    %v_7 = load %v_2, 8: Ptr
    %v_8 = call_complex funvalue(thrice), %v_7, 100: I32
    %v_9 = add %v_8, 5: I32
    %v_10 = add %v_6, %v_9: I32
    %v_11 = alloca 4, 4: Ptr
    store %v_11, 7, 4
    %v_12 = call_complex twiceOver, @environment(twiceOver(Label)), %v_11, %v_1: I32
    %v_13 = add %v_10, %v_12: I32
    %v_14 = alloca 8, 8: Ptr
    store %v_14, 0, 8
    %v_15 = load %v_14, 8: Ptr
    %v_16 = call_complex funvalue(twice), %v_15, 1: I32
    %v_17 = add %v_13, %v_16: I32
    ret %v_17
  }
}

funvalue(twice)<complex>(%v_0: Ptr, %v_1: I32): I32 {
  b_2 {
    %v_3 = call_complex twice, %v_1: I32
    ret %v_3
  }
}

funvalue(thrice)<complex>(%v_0: Ptr, %v_1: I32): I32 {
  b_2 {
    %v_3 = call_complex thrice, %v_1: I32
    ret %v_3
  }
}

teardown()<complex>(%v_0: Ptr) {
  b_1 {
    ret 
  }
}

