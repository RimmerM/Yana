module ResolveTest

data Vessel {size: I32, mark: I32}

fn twice(x: a [shared call]) -> I32 {
  form specialized
  slot #0 type a
  slot #1 property a.size
bb0:
  %0: I32 = read copy.trivial (x.size)
  %1: I32 = read copy.trivial (x.size)
  %2: I32 = add inspect %0 inspect %1
  return take %2
}

fn scaled(x: a [shared call], n: I32 [shared call]) -> I32 {
  form specialized
  slot #0 type a
  slot #1 property a.size
  local base: I32
  local step: I32
  local a1: I32
  local a2: I32
  local a3: I32
  local a4: I32

bb0:
  %0: I32 = read copy.trivial (x.size)
  write.init borrow.unique (base) take %0
  %2: I32 = read copy.trivial (n)
  %3: I32 = read copy.trivial (n)
  %4: I32 = add inspect %2 inspect %3
  write.init borrow.unique (step) take %4
  %6: I32 = read copy.trivial (step)
  %7: I32 = const 1
  %8: I32 = add inspect %6 inspect %7
  write.init borrow.unique (a1) take %8
  %10: I32 = read copy.trivial (a1)
  %11: I32 = read copy.trivial (a1)
  %12: I32 = add inspect %10 inspect %11
  write.init borrow.unique (a2) take %12
  %14: I32 = read copy.trivial (a2)
  %15: I32 = read copy.trivial (a2)
  %16: I32 = add inspect %14 inspect %15
  write.init borrow.unique (a3) take %16
  %18: I32 = read copy.trivial (a3)
  %19: I32 = read copy.trivial (a3)
  %20: I32 = add inspect %18 inspect %19
  write.init borrow.unique (a4) take %20
  %22: I32 = read copy.trivial (base)
  %23: I32 = read copy.trivial (a4)
  %24: I32 = add inspect %22 inspect %23
  return take %24
}

fn plain(x: a [shared call]) -> I32 {
  form erased
  slot #0 type a
bb0:
  %0: I32 = const 7
  return take %0
}

fn carried(x: a [shared call]) -> I32 {
  form specialized
  slot #0 type a
  slot #1 property a.size
  local base: I32
  local a1: I32
  local a2: I32
  local a3: I32
  local a4: I32
  local a5: I32
  local a6: I32

bb0:
  %0: I32 = read copy.trivial (x.size)
  write.init borrow.unique (base) take %0
  %2: I32 = read copy.trivial (base)
  %3: I32 = const 1
  %4: I32 = add inspect %2 inspect %3
  write.init borrow.unique (a1) take %4
  %6: I32 = read copy.trivial (a1)
  %7: I32 = read copy.trivial (a1)
  %8: I32 = add inspect %6 inspect %7
  write.init borrow.unique (a2) take %8
  %10: I32 = read copy.trivial (a2)
  %11: I32 = read copy.trivial (a2)
  %12: I32 = add inspect %10 inspect %11
  write.init borrow.unique (a3) take %12
  %14: I32 = read copy.trivial (a3)
  %15: I32 = read copy.trivial (a3)
  %16: I32 = add inspect %14 inspect %15
  write.init borrow.unique (a4) take %16
  %18: I32 = read copy.trivial (a4)
  %19: I32 = read copy.trivial (a4)
  %20: I32 = add inspect %18 inspect %19
  write.init borrow.unique (a5) take %20
  %22: I32 = read copy.trivial (a5)
  %23: I32 = read copy.trivial (a5)
  %24: I32 = add inspect %22 inspect %23
  write.init borrow.unique (a6) take %24
  %26: I32 = read copy.trivial (a6)
  %27: a [shared call] = read borrow.shared (x) loan0
  %28: I32 = call plain(a) borrow.shared %27
  %29: I32 = add inspect %26 inspect %28
  return take %29
}

fn main() -> I32 {
  local v: Vessel

bb0:
  %0: I32 = const 3
  %1: I32 = const 1
  %2: Vessel = aggregate.Vessel take %0 take %1
  write.init borrow.unique (v) take %2
  %4: Vessel = read copy.trivial (v)
  %5: I32 = call twice(Vessel) borrow.shared %4
  %6: Vessel = read copy.trivial (v)
  %7: I32 = const 2
  %8: I32 = call scaled(Vessel) borrow.shared %6 borrow.shared %7
  %9: I32 = add inspect %5 inspect %8
  %10: Vessel = read copy.trivial (v)
  %11: I32 = call carried(Vessel) borrow.shared %10
  %12: I32 = add inspect %9 inspect %11
  return take %12
}

fn twice(Vessel)(x: Vessel [shared call]) -> I32 = <twice at Vessel>

fn scaled(Vessel)(x: Vessel [shared call], n: I32 [shared call]) -> I32 = <scaled at Vessel>

fn carried(Vessel)(x: Vessel [shared call]) -> I32 = <carried at Vessel>

entry main
