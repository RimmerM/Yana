  %33: Size = add inspect %29 inspect %32
  %34: I32 = read copy.trivial (trivial)
  %35: Size = convert inspect %34
  %36: Size = add inspect %33 inspect %35
  %37: I32 = read copy.trivial (teardown)
  %38: Size = convert inspect %37
  %39: Size = add inspect %36 inspect %38
  return take %39

bb6:
  %17: I32 = const 2
  jump -> bb5(take %17)
}

fn main() -> I32 {
  local p: Pad
  local g: Guard

bb0:
  %0: I64 = const 1
  %1: I8 = const 2
  %2: Pad = aggregate.Pad take %0 take %1
  write.init borrow.unique (p) take %2
  %4: I32 = const 3
