  %23: Size = read copy.trivial (t.size)
  %24: Size = const 1000
  %25: Size = mul inspect %23 inspect %24
  %26: Size = read copy.trivial (t.align)
  %27: Size = const 100
  %28: Size = mul inspect %26 inspect %27
