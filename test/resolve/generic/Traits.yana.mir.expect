fn describe(it: a [shared call]) -> Size {
  form erased
  slot #0 type a
  local t: TypeTraits(a)
  local trivial: I32
  local teardown: I32

bb0:
  %0: Size = metric size a
  %1: Size = metric align a
  %2: Size = metric stride a
  %3: Bool = metric trivial.copy a
  %4: Bool = metric has.teardown a
  %5: TypeTraits(a) = aggregate.TypeTraits take %0 take %1 take %2 take %3 take %4
  write.init borrow.unique (t) take %5
  %7: Bool = read copy.trivial (t.trivialCopy)
  branch inspect %7 -> bb3 -> bb1

bb1:
  %10: I32 = const 0
  jump -> bb2(take %10)

bb2(%11: I32):
  write.init borrow.unique (trivial) take %11
  %15: Bool = read copy.trivial (t.hasTeardown)
