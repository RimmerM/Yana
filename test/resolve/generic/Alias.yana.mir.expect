module ResolveTest

data Two(a, b) {left: a, right: b} drop derived reclaim derived

data Two(I32, I32) {left: I32, right: I32} of Two

fn sum(p: Two(I32, I32) [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (p.left)
  %1: I32 = read copy.trivial (p.right)
  %2: I32 = add inspect %0 inspect %1
  return take %2
}

fn first(t: Two(I32, I32) [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (t.left)
  return take %0
}

fn main() -> I32 {
  local p: Two(I32, I32)
  local q: Two(I32, I32)

bb0:
  %0: I32 = const 20
  %1: I32 = const 22
  %2: Two(I32, I32) = aggregate.Two take %0 take %1
  write.init borrow.unique (p) take %2
  %4: I32 = const 100
  %5: I32 = const 0
  %6: Two(I32, I32) = aggregate.Two take %4 take %5
  write.init borrow.unique (q) take %6
  %8: Two(I32, I32) = read copy.trivial (p)
  %9: I32 = call sum borrow.shared %8
  %10: Two(I32, I32) = read copy.trivial (q)
  %11: I32 = call first borrow.shared %10
  %12: I32 = add inspect %9 inspect %11
  return take %12
}

entry main
