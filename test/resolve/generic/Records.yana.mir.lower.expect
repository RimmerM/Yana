keepFirst(Guard, Guard)<complex>(%v_0: Ptr, %p: Ptr) {
  b_1 {
    %v_2 = alloca 8, 4: Ptr
    copy %v_2, %p, 8
    %v_3 = add %v_2, 4: Ptr
    call_complex Guard.drop, %v_3
    copy %v_0, %v_2, 4
    ret 
  }
}

