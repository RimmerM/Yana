  b_1 {
    %v_2 = loads @trace, 4: I32
    %v_3 = imul %v_2, 10: I32
    %v_4 = add %v_3, %v_0: I32
    store @trace, %v_4, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    call_complex Guard.drop, 1
    %v_1 = loads @trace, 4: I32
    %v_2 = cmp_neq %v_1, 1: I32
    je %v_2, b_3, b_4
  }

  b_4 {
    store @trace, 0, 4
    call_complex Guard.drop, 2
    %v_5 = loads @trace, 4: I32
    %v_6 = cmp_neq %v_5, 2: I32
    je %v_6, b_7, b_8
