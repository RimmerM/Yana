@environment(folded(Outcome(I32, I32))) = [0, 0, 0, 0]
@descriptor(Outcome(I32, I32)) = [8, 0, 0, 13, 0, 0, 0, 0]
@image$base = []

folded<complex>(%v_0: Ptr, %x: Ptr, %first: Ptr, %n: I32): I32 {
  b_1 {
    %v_2 = load %first, 8: Ptr
    %v_3 = add %first, 8: Ptr
    %v_4 = load %v_3, 8: Ptr
    %v_5 = alloca 8, 4: Ptr
    call_complex %v_2, %v_4, %v_5, %n
    %v_6 = load %v_5, 1: I32
    %v_7 = cmp_eq %v_6, 0: I32
    je %v_7, b_8, b_9
  }

  b_9 {
    %v_10 = add %v_5, 4: Ptr
    %v_11 = loads %v_10, 4: I32
    %v_12 = sub 0, %v_11: I32
    jmp b_13
  }

  b_8 {
    %v_14 = add %v_5, 4: Ptr
    %v_15 = loads %v_14, 4: I32
    jmp b_13
  }

  b_13 {
    %v_16 = phi [b_9, %v_12], [b_8, %v_15]: I32
    ret %v_16
  }
}

tried<complex>(%v_0: Ptr, %x: I32) {
  b_1 {
    %v_2 = cmp_igt %x, 0: I32
    je %v_2, b_3, b_4
  }

  b_4 {
    %v_5 = sub 0, %x: I32
    %v_6 = alloca 8, 4: Ptr
    store %v_6, 1, 1
    %v_7 = add %v_6, 4: Ptr
    store %v_7, %v_5, 4
    jmp b_8
  }

  b_3 {
    %v_9 = add %x, %x: I32
    %v_10 = alloca 8, 4: Ptr
    store %v_10, 0, 1
    %v_11 = add %v_10, 4: Ptr
    store %v_11, %v_9, 4
    jmp b_8
  }

  b_8 {
    %v_12 = phi [b_4, %v_6], [b_3, %v_10]: Ptr
    copy %v_0, %v_12, 8
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 8, 8: Ptr
    %v_2 = alloca 16, 8: Ptr
    store %v_1, 0, 8
    %v_3 = load %v_1, 8: Ptr
    %v_4 = alloca 8, 4: Ptr
    call_complex funvalue(tried), %v_3, %v_4, 5
    %v_5 = load %v_4, 1: I32
    %v_6 = cmp_eq %v_5, 0: I32
    je %v_6, b_7, b_8
  }

  b_8 {
    %v_9 = add %v_4, 4: Ptr
    %v_10 = loads %v_9, 4: I32
    %v_11 = sub 0, %v_10: I32
    jmp b_12
  }

  b_7 {
    %v_13 = add %v_4, 4: Ptr
    %v_14 = loads %v_13, 4: I32
    jmp b_12
  }

  b_12 {
    %v_15 = phi [b_8, %v_11], [b_7, %v_14]: I32
    %v_16 = bitcast 0: Ptr
    %v_17 = alloca 8, 4: Ptr
    call_complex funvalue(tried), %v_16, %v_17, 18446744073709551612
    %v_18 = load %v_17, 1: I32
    %v_19 = cmp_eq %v_18, 0: I32
    je %v_19, b_20, b_21
  }

  b_21 {
    %v_22 = add %v_17, 4: Ptr
    %v_23 = loads %v_22, 4: I32
    %v_24 = sub 0, %v_23: I32
    jmp b_25
  }

  b_20 {
    %v_26 = add %v_17, 4: Ptr
    %v_27 = loads %v_26, 4: I32
    jmp b_25
  }

  b_25 {
    %v_28 = phi [b_21, %v_24], [b_20, %v_27]: I32
    %v_29 = bitcast 0: Ptr
    %v_30 = call_complex main.lambda, %v_29, 6: I32
    %v_31 = alloca 8, 4: Ptr
    store %v_31, 0, 1
    %v_32 = add %v_31, 4: Ptr
    store %v_32, 0, 4
    store %v_2, funvalue(tried), 8
    %v_33 = add %v_2, 8: Ptr
    store %v_33, 0, 8
    %v_34 = call_complex folded, @environment(folded(Outcome(I32, I32))), %v_31, %v_2, 3: I32
    %v_35 = imul %v_15, 1000: I32
    %v_36 = sub 0, %v_28: I32
    %v_37 = imul %v_36, 100: I32
    %v_38 = add %v_35, %v_37: I32
    %v_39 = add %v_38, %v_30: I32
    %v_40 = add %v_39, %v_34: I32
    ret %v_40
  }
}

main.lambda<complex>(%main.lambda.env: Ptr, %n: I32): I32 {
  b_0 {
    %v_1 = imul %n, 3: I32
    ret %v_1
  }
}

funvalue(tried)<complex>(%v_0: Ptr, %v_1: Ptr, %v_2: I32) {
  b_3 {
    call_complex tried, %v_1, %v_2
    ret 
  }
}

teardown()<complex>(%v_0: Ptr) {
  b_1 {
    ret 
  }
}

