@environment(folded(Outcome(I32, I32))) = [0, 0, 0, 0]
@descriptor(Outcome(I32, I32)) = [8, 0, 0, 13, 0, 0, 0, 0]
@image$base = []

folded<complex>(%v_0: Ptr, %x: Ptr, %first: Ptr, %n: I32): I32 {
  b_1 {
    %v_2 = load %first, 8: Ptr
    %v_3 = add %first, 8: Ptr
    %v_4 = load %v_3, 8: Ptr
    %v_5 = alloca 8, 4: Ptr
    call_complex %v_2, %v_4, %v_5, %n
    %v_6 = load %v_5, 1: I32
    %v_7 = cmp_eq %v_6, 0: I32
    je %v_7, b_8, b_9
  }

  b_9 {
    %v_10 = add %v_5, 4: Ptr
    %v_11 = loads %v_10, 4: I32
    %v_12 = sub 0, %v_11: I32
    jmp b_13
  }

  b_8 {
    %v_14 = add %v_5, 4: Ptr
    %v_15 = loads %v_14, 4: I32
    jmp b_13
  }

  b_13 {
    %v_16 = phi [b_9, %v_12], [b_8, %v_15]: I32
    ret %v_16
  }
}

tried<complex>(%v_0: Ptr, %x: I32) {
  b_1 {
    %v_2 = cmp_igt %x, 0: I32
    je %v_2, b_3, b_4
  }

  b_4 {
    %v_5 = sub 0, %x: I32
    %v_6 = alloca 8, 4: Ptr
    store %v_6, 1, 1
    %v_7 = add %v_6, 4: Ptr
    store %v_7, %v_5, 4
    jmp b_8
  }

  b_3 {
    %v_9 = add %x, %x: I32
    %v_10 = alloca 8, 4: Ptr
    store %v_10, 0, 1
    %v_11 = add %v_10, 4: Ptr
    store %v_11, %v_9, 4
    jmp b_8
  }

  b_8 {
    %v_12 = phi [b_4, %v_6], [b_3, %v_10]: Ptr
    copy %v_0, %v_12, 8
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 8, 8: Ptr
    %v_2 = alloca 16, 8: Ptr
    store %v_1, 0, 8
    %v_3 = load %v_1, 8: Ptr
    %v_4 = call_complex main.lambda, %v_3, 6: I32
    %v_5 = alloca 8, 4: Ptr
    store %v_5, 0, 1
    %v_6 = add %v_5, 4: Ptr
    store %v_6, 0, 4
    store %v_2, funvalue(tried), 8
    %v_7 = add %v_2, 8: Ptr
    store %v_7, 0, 8
    %v_8 = call_complex folded, @environment(folded(Outcome(I32, I32))), %v_5, %v_2, 3: I32
    %v_9 = add 10400, %v_4: I32
    %v_10 = add %v_9, %v_8: I32
    ret %v_10
  }
}

main.lambda<complex>(%main.lambda.env: Ptr, %n: I32): I32 {
  b_0 {
    %v_1 = imul %n, 3: I32
    ret %v_1
  }
}

funvalue(tried)<complex>(%v_0: Ptr, %v_1: Ptr, %v_2: I32) {
  b_3 {
    call_complex tried, %v_1, %v_2
    ret 
  }
}

teardown()<complex>(%v_0: Ptr) {
  b_1 {
    ret 
  }
}

