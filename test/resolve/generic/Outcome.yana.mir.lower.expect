@environment(folded(Outcome(I32, I32))) = [0, 0, 0, 0] {slot 0: @descriptor(Outcome(I32, I32))}
@descriptor(Outcome(I32, I32)) = [8, 0, 0, 13, 0, 0, 0, 0] {slot 4: teardown()}
@image$base = []

folded<complex>(%v_0: Ptr, %x: Ptr, %first: Ptr, %n: I32): I32 {
  b_1 {
    %v_2 = load %first, 8: Ptr
    %v_3 = add %first, 8: Ptr
    %v_4 = load %v_3, 8: Ptr
    %v_5 = alloca 8, 4: Ptr
    call_complex %v_2, %v_4, %v_5, %n
    %v_6 = load %v_5, 1: I32
    %v_7 = cmp_eq %v_6, 0: I32
    je %v_7, b_8, b_9
  }

  b_9 {
    %v_10 = add %v_5, 4: Ptr
    %v_11 = loads %v_10, 4: I32
    %v_12 = sub 0, %v_11: I32
    jmp b_13
  }

  b_8 {
    %v_14 = add %v_5, 4: Ptr
    %v_15 = loads %v_14, 4: I32
    jmp b_13
  }

  b_13 {
    %v_16 = phi [b_9, %v_12], [b_8, %v_15]: I32
    ret %v_16
  }
}

tried<complex>(%x: I32): I32, I32 {
  b_0 {
    %v_1 = cmp_igt %x, 0: I32
    je %v_1, b_2, b_3
  }

  b_3 {
    %v_4 = sub 0, %x: I32
    %v_5 = alloca 8, 4: Ptr
    store %v_5, 1, 1
    %v_6 = add %v_5, 4: Ptr
    store %v_6, %v_4, 4
    jmp b_7
  }

  b_2 {
    %v_8 = add %x, %x: I32
    %v_9 = alloca 8, 4: Ptr
    store %v_9, 0, 1
    %v_10 = add %v_9, 4: Ptr
    store %v_10, %v_8, 4
    jmp b_7
  }

  b_7 {
    %v_11 = phi [b_3, %v_5], [b_2, %v_9]: Ptr
    %v_12 = load %v_11, 1: I32
    %v_13 = add %v_11, 4: Ptr
    %v_14 = load %v_13, 4: I32
    ret %v_12, %v_14
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 16, 8: Ptr
    %v_2 = bitcast 0: Ptr
    %v_3 = call_complex main.lambda, %v_2, 6: I32
    %v_4 = alloca 8, 4: Ptr
    store %v_4, 0, 1
    %v_5 = add %v_4, 4: Ptr
    store %v_5, 0, 4
    store %v_1, funvalue(tried), 8
    %v_6 = add %v_1, 8: Ptr
    store %v_6, 0, 8
    %v_7 = call_complex folded, @environment(folded(Outcome(I32, I32))), %v_4, %v_1, 3: I32
    %v_8 = add 10400, %v_3: I32
    %v_9 = add %v_8, %v_7: I32
    ret %v_9
  }
}

@header(main.lambda) = [0, 0, 0, 0]
main.lambda<complex>(%main.lambda.env: Ptr, %n: I32): I32 {
  b_0 {
    %v_1 = imul %n, 3: I32
    ret %v_1
  }
}

funvalue(tried)<complex>(%v_0: Ptr, %v_1: Ptr, %v_2: I32) {
  b_3 {
    %v_4, %v_5 = call_complex tried, %v_2: I32, I32
    store %v_1, %v_4, 1
    %v_6 = add %v_1, 4: Ptr
    store %v_6, %v_5, 4
    ret 
  }
}

teardown()<complex>(%v_0: Ptr) {
  b_1 {
    ret 
  }
}

