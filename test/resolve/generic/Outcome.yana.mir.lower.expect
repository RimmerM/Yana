@environment(folded(Outcome(I32, I32))) = [0, 0, 0, 0] {slot 0: @descriptor(Outcome(I32, I32))}
@descriptor(Outcome(I32, I32)) = [8, 0, 0, 13, 0, 0, 0, 0] {slot 4: teardown()}
@image$base = []

folded<complex>(%first: Ptr, %n: I32): I32 {
  b_0 {
    %v_1 = load %first, 8: Ptr
    %v_2 = add %first, 8: Ptr
    %v_3 = load %v_2, 8: Ptr
    %v_4 = alloca 8, 4: Ptr
    call_complex %v_1, %v_3, %v_4, %n
    %v_5 = load %v_4, 1: I32
    %v_6 = cmp_eq %v_5, 0: I32
    je %v_6, b_7, b_8
  }

  b_8 {
    %v_9 = add %v_4, 4: Ptr
    %v_10 = loads %v_9, 4: I32
    %v_11 = sub 0, %v_10: I32
    jmp b_12
  }

  b_7 {
    %v_13 = add %v_4, 4: Ptr
    %v_14 = loads %v_13, 4: I32
    jmp b_12
  }

  b_12 {
    %v_15 = phi [b_8, %v_11], [b_7, %v_14]: I32
    ret %v_15
  }
}

tried<complex>(%x: I32): I32, I32 {
  b_0 {
    %v_1 = cmp_igt %x, 0: I32
    je %v_1, b_2, b_3
  }

  b_3 {
    %v_4 = sub 0, %x: I32
    jmp b_5
  }

  b_2 {
    %v_6 = add %x, %x: I32
    jmp b_5
  }

  b_5 {
    %v_7 = phi [b_3, 1], [b_2, 0]: I32
    %v_8 = phi [b_3, %v_4], [b_2, %v_6]: I32
    ret %v_7, %v_8
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 16, 8: Ptr
    %v_2 = call_complex main.lambda, 6: I32
    store %v_1, funvalue(tried), 8
    %v_3 = add %v_1, 8: Ptr
    store %v_3, 0, 8
    %v_4 = call_complex folded, %v_1, 3: I32
    %v_5 = add 10400, %v_2: I32
    %v_6 = add %v_5, %v_4: I32
    ret %v_6
  }
}

@header(main.lambda) = [0, 0, 0, 0]
main.lambda<complex>(%n: I32): I32 {
  b_0 {
    %v_1 = imul %n, 3: I32
    ret %v_1
  }
}

funvalue(tried)<complex>(%v_0: Ptr, %v_1: Ptr, %v_2: I32) {
  b_3 {
    %v_4, %v_5 = call_complex tried, %v_2: I32, I32
    store %v_1, %v_4, 1
    %v_6 = add %v_1, 4: Ptr
    store %v_6, %v_5, 4
    ret 
  }
}

teardown()<complex>(%v_0: Ptr) {
  b_1 {
    ret 
  }
}

