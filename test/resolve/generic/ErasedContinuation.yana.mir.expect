module ResolveTest

data A {k: I32}

data B {k: I32, spare: I64}

class Codec(c): least

instance Codec(A): A.least

instance Codec(B): B.least

let & total: I32 = 0

fn least(codec: c [shared call]) -> I32 = <no body>

fn A.least(codec: A [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (codec.k)
  return take %0
}

fn B.least(codec: B [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (codec.k)
  %1: I32 = const 1
  %2: I32 = add inspect %0 inspect %1
  return take %2
}

fn agree(codec: c [shared call]) -> {} {
  form specialized
  slot #0 type c
  slot #1 class Codec(c)
  local & local1: Array(I32) object1
  local scratches: Array(I32) object1
  local scratch: I32 [shared slot 0]

bb0:
  %0: I32 = const 1
  %1: I32 = const 2
  %2: I32 = const 3
  %3: %I32 = run.slots I32 *3
  %4: Size = bitcast inspect %3
  %5: Size = const 0
  %6: Bool = eq inspect %4 inspect %5
  %7: {} = call checkCondition borrow.shared %6
  %8: @bits(30) U32 = const 3
  %9: @bits(2) U32 = const 1
  %10: Run(I32) = aggregate.Run take %3 take %8 take %9
  %11: @bits(30) U32 = const 3
  %12: Array(I32) = aggregate.Array take %10 take %11
  write.init borrow.unique (local1) take %12
  %14: Size = const 0
  write.init borrow.unique ([%%3][0]) take %0
  %16: Size = const 1
  write.init borrow.unique ([%%3][1]) take %1
  %18: Size = const 2
  write.init borrow.unique ([%%3][2]) take %2
  %20: Array(I32) = read take (local1)
  write.init borrow.unique (scratches) take %20
  %22: Array(I32) [shared slot 0] = read borrow.shared (scratches) loan0
  %23: Array(I32) [shared slot 0 view] = call.derivation elements(Array(I32), I32) borrow.shared %22 roots{0}
  lens.call items(Array(I32), I32) borrow.shared %23 -> bb2

bb1:
  drop (scratches)
  return

bb2(%24: I32 [shared slot 0]) handover(I32 [shared slot 0]) many -> bb1:
  write.init borrow.unique (scratch) borrow.shared %24
  %27: I32 [unique call] = read borrow.unique (global total) loan1
  %28: c [shared call] = read borrow.shared (codec) loan2
  %29: I32 = call least(c) borrow.shared %28
  %30: I32 = read copy.trivial (scratch)
  %31: I32 = mul inspect %29 inspect %30
  %32: {} = call +=(I32) borrow.unique %27 borrow.shared %31
  jump -> bb1
}

fn sized(codecs: Array(c) [shared call view]) -> {} {
  form specialized
  slot #0 type c
  slot #1 class Codec(c)
  local codec: c [shared slot 0]

bb0:
  %0: Array(c) [shared slot 0 view] = read borrow.shared (codecs) loan0
  lens.call items(Array(c), c) borrow.shared %0 -> bb2

bb1:
  return

bb2(%1: c [shared slot 0]) handover(c [shared slot 0]) many -> bb1:
  write.init borrow.unique (codec) borrow.shared %1
  %4: I32 [unique call] = read borrow.unique (global total) loan1
  %5: c [shared slot 0] = read borrow.shared (codec) loan2 roots{0}
  %6: I32 = call least(c) borrow.shared %5
  %7: {} = call +=(I32) borrow.unique %4 borrow.shared %6
  jump -> bb1
}

fn main() -> I32 {
  local & local0: Array(A) object1
  local local1: Array(A) object1
  local & local2: Array(B) object5
  local local3: Array(B) object5

bb0:
  %0: I32 = const 3
  %1: A = aggregate.A take %0
  %2: {} = call agree(A) borrow.shared %1
  %3: I32 = const 2
  %4: I64 = const 0
  %5: B = aggregate.B take %3 take %4
  %6: {} = call agree(B) borrow.shared %5
  %7: I32 = const 10
  %8: A = aggregate.A take %7
  %9: I32 = const 20
  %10: A = aggregate.A take %9
  %11: %A = run.slots A *2
  %12: Size = bitcast inspect %11
  %13: Size = const 0
  %14: Bool = eq inspect %12 inspect %13
  %15: {} = call checkCondition borrow.shared %14
  %16: @bits(30) U32 = const 2
  %17: @bits(2) U32 = const 1
  %18: Run(A) = aggregate.Run take %11 take %16 take %17
  %19: @bits(30) U32 = const 2
  %20: Array(A) = aggregate.Array take %18 take %19
  write.init borrow.unique (local0) take %20
  %22: Size = const 0
  write.init borrow.unique ([%%11][0]) take %8
  %24: Size = const 1
  write.init borrow.unique ([%%11][1]) take %10
  %26: Array(A) = read take (local0)
  write.init borrow.unique (local1) take %26
  %28: Array(A) [shared slot 0] = read borrow.shared (local1) loan0
  %29: Array(A) [shared slot 0 view] = call.derivation elements(Array(A), A) borrow.shared %28 roots{0}
  %30: {} = call sized(A) borrow.shared %29
  drop (local1)
  %31: I32 = const 100
  %32: I64 = const 1
  %33: B = aggregate.B take %31 take %32
  %34: %B = run.slots B *1
  %35: Size = bitcast inspect %34
  %36: Size = const 0
  %37: Bool = eq inspect %35 inspect %36
  %38: {} = call checkCondition borrow.shared %37
  %39: @bits(30) U32 = const 1
  %40: @bits(2) U32 = const 1
  %41: Run(B) = aggregate.Run take %34 take %39 take %40
  %42: @bits(30) U32 = const 1
  %43: Array(B) = aggregate.Array take %41 take %42
  write.init borrow.unique (local2) take %43
  %45: Size = const 0
  write.init borrow.unique ([%%34][0]) take %33
  %47: Array(B) = read take (local2)
  write.init borrow.unique (local3) take %47
  %49: Array(B) [shared slot 0] = read borrow.shared (local3) loan1
  %50: Array(B) [shared slot 0 view] = call.derivation elements(Array(B), B) borrow.shared %49 roots{1}
  %51: {} = call sized(B) borrow.shared %50
  drop (local3)
  %52: I32 = read copy.trivial (global total)
  return take %52
}

fn agree(A)(codec: A [shared call]) -> {} = <agree at A>

fn agree(B)(codec: B [shared call]) -> {} = <agree at B>

fn sized(A)(codecs: Array(A) [shared call view]) -> {} = <sized at A>

fn sized(B)(codecs: Array(B) [shared call view]) -> {} = <sized at B>

entry main
