module ResolveTest

data Handler {run: (I32) -> I32, times: I32}

data Label {tag: I32}

fn twice(x: I32 [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (x)
  %1: I32 = read copy.trivial (x)
  %2: I32 = add inspect %0 inspect %1
  return take %2
}

fn thrice(x: I32 [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (x)
  %1: I32 = read copy.trivial (x)
  %2: I32 = add inspect %0 inspect %1
  %3: I32 = read copy.trivial (x)
  %4: I32 = add inspect %2 inspect %3
  return take %4
}

fn apply(f: (I32) -> I32 [shared call], v: I32 [shared call]) -> I32 {
bb0:
  %0: (I32) -> I32 [shared call] = read borrow.shared (f) loan0
  %1: I32 = read copy.trivial (v)
  %2: I32 = call inspect %0 borrow.shared %1
  return take %2
}

fn dispatch(h: Handler [shared call], v: I32 [shared call]) -> I32 {
bb0:
  %0: (I32) -> I32 [shared call] = read borrow.shared (h.run) loan0
  %1: I32 = read copy.trivial (v)
  %2: I32 = call inspect %0 borrow.shared %1
  %3: I32 = read copy.trivial (h.times)
  %4: I32 = add inspect %2 inspect %3
  return take %4
}

fn twiceOver(x: a [shared call], f: (I32) -> I32 [shared call]) -> I32 {
  form erased
  slot #0 type a
  slot #1 property a.tag
bb0:
  %0: (I32) -> I32 [shared call] = read borrow.shared (f) loan0
  %1: I32 = read copy.trivial (x.tag)
  %2: I32 = call inspect %0 borrow.shared %1
  return take %2
}

fn twiceApplied(v: I32 [shared call]) -> I32 {
bb0:
  %0: (I32) -> I32 = fun.value twice
  %1: I32 = read copy.trivial (v)
  %2: I32 = call apply borrow.shared %0 borrow.shared %1
  return take %2
}

fn main() -> I32 {
  local f: (I32) -> I32
  local g: (I32) -> I32
  local h: Handler
  local l: Label

bb0:
  %0: (I32) -> I32 = fun.value twice
  write.init borrow.unique (f) take %0
  %2: (I32) -> I32 = fun.value thrice
  write.init borrow.unique (g) take %2
  %4: (I32) -> I32 = read take (g)
  %5: I32 = const 5
  %6: Handler = aggregate.Handler take %4 take %5
  write.init borrow.unique (h) take %6
  %8: I32 = const 7
  %9: Label = aggregate.Label take %8
  write.init borrow.unique (l) take %9
  %11: (I32) -> I32 [shared call] = read borrow.shared (f) loan0
  %12: I32 = const 10
  %13: I32 = call apply borrow.shared %11 borrow.shared %12
  %14: Handler [shared call] = read borrow.shared (h) loan1
  %15: I32 = const 100
  %16: I32 = call dispatch borrow.shared %14 borrow.shared %15
  %17: I32 = add inspect %13 inspect %16
  %18: Label = read copy.trivial (l)
  %19: (I32) -> I32 [shared call] = read borrow.shared (f) loan2
  %20: I32 = call twiceOver(Label) borrow.shared %18 borrow.shared %19
  %21: I32 = add inspect %17 inspect %20
  %22: I32 = const 1
  %23: I32 = call twiceApplied borrow.shared %22
  %24: I32 = add inspect %21 inspect %23
  return take %24
}

entry main
