mut @trace = [0, 0, 0, 0]

Conn.drop<complex>(%v_0: I32) {
  b_1 {
    %v_2 = loads @trace, 4: I32
    %v_3 = imul %v_2, 10: I32
    %v_4 = add %v_3, %v_0: I32
    store @trace, %v_4, 4
    ret 
  }
}

Guard.drop<complex>(%v_0: I32) {
  b_1 {
    %v_2 = loads @trace, 4: I32
    %v_3 = imul %v_2, 10: I32
    %v_4 = add %v_3, %v_0: I32
    store @trace, %v_4, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    call_complex Conn.drop, 1
    %v_1 = loads @trace, 4: I32
    %v_2 = cmp_neq %v_1, 1: I32
    je %v_2, b_3, b_4
  }

  b_4 {
    call_complex Conn.drop, 2
    %v_5 = loads @trace, 4: I32
    %v_6 = cmp_neq %v_5, 12: I32
    je %v_6, b_7, b_8
  }

  b_3 {
    ret 18446744073709551615
  }

  b_8 {
    call_complex Guard.drop, 3
    %v_9 = loads @trace, 4: I32
    %v_10 = cmp_neq %v_9, 123: I32
    je %v_10, b_11, b_12
  }

  b_7 {
    ret 18446744073709551614
  }

  b_12 {
    call_complex Conn.drop, 4
    %v_13 = loads @trace, 4: I32
    %v_14 = cmp_neq %v_13, 1234: I32
    je %v_14, b_15, b_16
  }

  b_11 {
    ret 18446744073709551613
  }

  b_16 {
    %v_17 = loads @trace, 4: I32
    %v_18 = cmp_neq %v_17, 1234: I32
    %v_19 = select %v_18, 18446744073709551610, 4244: I32
    ret %v_19
  }

  b_15 {
    ret 18446744073709551611
  }
}

