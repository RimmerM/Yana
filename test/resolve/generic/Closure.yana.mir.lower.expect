  b_7 {
    %v_8 = bitcast %v_3: Ptr
    %v_9 = sub %v_8, 1: Ptr
    %v_10 = load %v_9, 8: Ptr
    call_complex %v_10, %v_9
    jmp b_6
  }

  b_6 {
    ret 
  }
}

