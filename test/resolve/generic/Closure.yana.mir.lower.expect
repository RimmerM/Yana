  b_0 {
    %v_1 = shl %x, 1: I32
    ret %v_1
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 16, 8: Ptr
    store %v_1, plain.lambda, 8
    %v_2 = add %v_1, 8: Ptr
    store %v_2, 0, 8
    %v_3 = load %v_1, 8: Ptr
    %v_4 = load %v_2, 8: Ptr
    %v_5 = call_complex %v_3, %v_4, 50: I32
