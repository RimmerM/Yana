mut @trace = [0, 0, 0, 0]

Held.drop<complex>() {
  b_0 {
    %v_1 = loads @trace, 4: I32
    %v_2 = add %v_1, 1: I32
    store @trace, %v_2, 4
    ret 
  }
}

double<complex>(%x: I32): I32 {
  b_0 {
    %v_1 = shl %x, 1: I32
    ret %v_1
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = call_complex plain.lambda, 50: I32
    %v_2 = add %v_1, 16: I32
    call_complex Held.drop
    %v_3 = add %v_2, 10: I32
    %v_4 = add %v_3, 15: I32
    %v_5 = alloca 16, 8: Ptr
    %funvalue(double) = fun funvalue(double): Ptr
    store %v_5, %funvalue(double), 8
    %v_6 = add %v_5, 8: Ptr
    store %v_6, 0, 8
    %v_7 = add %v_5, 8: Ptr
    %v_8 = load %v_7, 8: Ptr
    %v_9 = call_complex %funvalue(double), %v_8, 4: I32
    %v_10 = add %v_9, 1: I32
    %v_11 = add %v_4, %v_10: I32
    %v_12 = loads @trace, 4: I32
    %v_13 = add %v_11, %v_12: I32
    ret %v_13
  }
}

@header(plain.lambda) = [0, 0, 0, 0]
plain.lambda<complex>(%x: I32): I32 {
  b_0 {
    %v_1 = shl %x, 1: I32
    ret %v_1
  }
}

funvalue(double)<complex>(%v_0: Ptr, %v_1: I32): I32 {
  b_2 {
    %v_3 = call_complex double, %v_1: I32
    ret %v_3
  }
}

