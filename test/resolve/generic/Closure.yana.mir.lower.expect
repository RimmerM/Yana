teardown(fun)<complex>(%v_0: Ptr) {
  b_1 {
    %v_2 = add %v_0, 8: Ptr
    %v_3 = load %v_2, 8: I64
    %v_4 = and %v_3, 1: I64
    %v_5 = cmp_eq %v_4, 0: I32
    je %v_5, b_6, b_7
