mut @trace = [0, 0, 0, 0]
@image$base = []

Held.drop<complex>(%v_0: I32) {
  b_1 {
    %v_2 = loads @trace, 4: I32
    %v_3 = add %v_2, 1: I32
    store @trace, %v_3, 4
    ret 
  }
}

double<complex>(%x: I32): I32 {
  b_0 {
    %v_1 = shl %x, 1: I32
    ret %v_1
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 16, 8: Ptr
    %plain.lambda = fun plain.lambda: Ptr
    store %v_1, %plain.lambda, 8
    %v_2 = add %v_1, 8: Ptr
    store %v_2, 0, 8
    %v_3 = load %v_2, 8: Ptr
    %v_4 = call_complex %plain.lambda, %v_3, 50: I32
    call_complex teardown(fun), %v_1
    %v_5 = add %v_4, 16: I32
    call_complex Held.drop, 9
    %v_6 = add %v_5, 10: I32
    %v_7 = add %v_6, 15: I32
    %v_8 = alloca 16, 8: Ptr
    %funvalue(double) = fun funvalue(double): Ptr
    store %v_8, %funvalue(double), 8
    %v_9 = add %v_8, 8: Ptr
    store %v_9, 0, 8
    %v_10 = add %v_8, 8: Ptr
    %v_11 = load %v_10, 8: Ptr
    %v_12 = call_complex %funvalue(double), %v_11, 4: I32
    %v_13 = add %v_12, 1: I32
    %v_14 = add %v_7, %v_13: I32
    %v_15 = loads @trace, 4: I32
    %v_16 = add %v_14, %v_15: I32
    ret %v_16
  }
}

@header(plain.lambda) = [0, 0, 0, 0]
plain.lambda<complex>(%plain.lambda.env: Ptr, %x: I32): I32 {
  b_0 {
    %v_1 = shl %x, 1: I32
    ret %v_1
  }
}

@header(copied.lambda) = [0, 0, 0, 0]
copied.lambda<complex>(%copied.lambda.env: Ptr, %x: I32): I32 {
  b_0 {
    %v_1 = loads %copied.lambda.env, 4: I32
    %v_2 = add %x, %v_1: I32
    ret %v_2
  }
}

@header(borrowed.lambda) = [0, 0, 0, 0]
borrowed.lambda<complex>(%borrowed.lambda.env: Ptr, %x: I32): I32 {
  b_0 {
    %v_1 = load %borrowed.lambda.env, 8: Ptr
    %v_2 = loads %v_1, 4: I32
    %v_3 = add %x, %v_2: I32
    ret %v_3
  }
}

@header(mutated.lambda) = [0, 0, 0, 0]
mutated.lambda<complex>(%mutated.lambda.env: Ptr, %x: I32): I32 {
  b_0 {
    %v_1 = load %mutated.lambda.env, 8: Ptr
    %v_2 = loads %v_1, 4: I32
    %v_3 = add %v_2, %x: I32
    store %v_1, %v_3, 4
    %v_4 = load %mutated.lambda.env, 8: Ptr
    %v_5 = loads %v_4, 4: I32
    ret %v_5
  }
}

@header(indirect.lambda) = [0, 0, 0, 0]
indirect.lambda<complex>(%indirect.lambda.env: Ptr, %x: I32): I32 {
  b_0 {
    %v_1 = load %indirect.lambda.env, 8: Ptr
    %v_2 = load %v_1, 8: Ptr
    %v_3 = add %v_1, 8: Ptr
    %v_4 = load %v_3, 8: Ptr
    %v_5 = call_complex %v_2, %v_4, %x: I32
    %v_6 = add %v_5, 1: I32
    ret %v_6
  }
}

teardown(fun)<complex>(%v_0: Ptr) {
  b_1 {
    %v_2 = add %v_0, 8: Ptr
    %v_3 = load %v_2, 8: I64
    %v_4 = cmp_eq %v_3, 0: I32
    je %v_4, b_5, b_6
  }

  b_6 {
    %v_7 = load %v_0, 8: Ptr
    %v_8 = sub %v_7, 4: Ptr
    %v_9 = loads %v_8, 4: I32
    %v_10 = sext %v_9: I64
    %v_11 = cmp_eq %v_10, 0: I32
    je %v_11, b_5, b_12
  }

  b_12 {
    %v_13 = add %v_10, @image$base: Ptr
    %v_14 = bitcast %v_3: Ptr
    call_complex %v_13, %v_14
    jmp b_5
  }

  b_5 {
    ret 
  }
}

funvalue(double)<complex>(%v_0: Ptr, %v_1: I32): I32 {
  b_2 {
    %v_3 = call_complex double, %v_1: I32
    ret %v_3
  }
}

