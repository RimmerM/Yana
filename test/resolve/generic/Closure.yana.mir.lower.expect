    %v_6 = add %v_5, 16: I32
    %v_7 = alloca 4, 4: Ptr
    store %v_7, 9, 4
    call_complex Held.drop, %v_7
    %v_8 = add %v_6, 10: I32
    %v_9 = add %v_8, 15: I32
    %v_10 = alloca 16, 8: Ptr
    store %v_10, funvalue(double), 8
    %v_11 = add %v_10, 8: Ptr
    store %v_11, 0, 8
    %v_12 = load %v_10, 8: Ptr
    %v_13 = add %v_10, 8: Ptr
    %v_14 = load %v_13, 8: Ptr
    %v_15 = call_complex %v_12, %v_14, 4: I32
    %v_16 = add %v_15, 1: I32
    %v_17 = add %v_9, %v_16: I32
    %v_18 = loads @trace, 4: I32
    %v_19 = add %v_17, %v_18: I32
    ret %v_19
  }
}

