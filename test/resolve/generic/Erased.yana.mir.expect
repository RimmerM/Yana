module ResolveTest

data Vessel {tag: I32, size: I32}

data Buf(n) {used: I32}

data Guard {id: I32, tag: I32} drop authored

data Buf(4) {used: I32} of Buf

class Describe(a): size

instance Drop(Guard): Guard.drop

instance Describe(Vessel): Vessel.size

instance Describe(Guard): Guard.size

let & trace: I32 = 0

fn size(x: a [shared call]) -> I32 = <no body>

fn Guard.drop(value: Guard) -> {} {
bb0:
  %0: I32 = read copy.trivial (global trace)
  %1: I32 = read copy.trivial (value.id)
  %2: I32 = add inspect %0 inspect %1
  write.assign borrow.unique (global trace) take %2
  return
}

fn Vessel.size(x: Vessel [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (x.size)
  return take %0
}

fn Guard.size(x: Guard [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (x.id)
  return take %0
}

fn grow(v: Guard [shared call]) -> Guard {
bb0:
  %0: I32 = read copy.trivial (v.id)
  %1: I32 = const 1
  %2: I32 = add inspect %0 inspect %1
  %3: I32 = read copy.trivial (v.tag)
  %4: Guard = aggregate.Guard take %2 take %3
  return take %4
}

fn present(x: a [shared call]) -> I32 {
  form erased
  slot #0 type a
  slot #1 class Describe(a)
bb0:
  %0: a [shared call] = read borrow.shared (x) loan0
  %1: I32 = call size(a) borrow.shared %0
  %2: I32 = const 1
  %3: I32 = add inspect %1 inspect %2
  return take %3
}

fn capacity'2(b: Buf(n) [shared call]) -> I32 {
  form erased
  slot #0 const n
bb0:
  %0: I32 = gen.value n
  return take %0
}

fn twice(x: a [shared call]) -> I32 {
  form erased
  slot #0 type a
  slot #1 property a.id
  slot #2 function grow: (a) -> a
  local local1: a
  local local2: a

bb0:
  %0: a [shared call] = read borrow.shared (x) loan0
  %1: a = call grow borrow.shared %0
  write.init borrow.unique (local1) take %1
  %3: a [shared call] = read borrow.shared (local1) loan1
  %4: a = call grow borrow.shared %3
  drop (local1)
  write.init borrow.unique (local2) take %4
  %6: I32 = read copy.trivial (local2.id)
  drop (local2)
  return take %6
}

fn main() -> I32 {
  local v: Vessel
  local g: Guard
  local n: I32

bb0:
  %0: I32 = const 9
  %1: I32 = const 3
  %2: Vessel = aggregate.Vessel take %0 take %1
  write.init borrow.unique (v) take %2
  %4: I32 = const 5
  %5: I32 = const 7
  %6: Guard = aggregate.Guard take %4 take %5
  write.init borrow.unique (g) take %6
  %8: Vessel = read copy.trivial (v)
  %9: I32 = call present(Vessel) borrow.shared %8
  %10: Guard [shared call] = read borrow.shared (g) loan0
  %11: I32 = call present(Guard) borrow.shared %10
  %12: I32 = add inspect %9 inspect %11
  %13: I32 = const 1
  %14: Buf(4) = aggregate.Buf take %13
  %15: I32 = call capacity'2(4) borrow.shared %14
  %16: I32 = add inspect %12 inspect %15
  %17: Guard [shared call] = read borrow.shared (g) loan1
  %18: I32 = call twice(Guard) borrow.shared %17
  drop (g)
  %19: I32 = add inspect %16 inspect %18
  write.init borrow.unique (n) take %19
  %21: I32 = read copy.trivial (n)
  %22: I32 = read copy.trivial (global trace)
  %23: I32 = add inspect %21 inspect %22
  return take %23
}

entry main
