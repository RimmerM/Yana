module ResolveTest

data Box(a) {value: a} drop derived reclaim derived

data Pair(a) {left: a, right: a} drop derived reclaim derived

data Box(I32) {value: I32} of Box

data Pair(I32) {left: I32, right: I32} of Pair

class Tag(a): tag

class Peek(c -> v): size

class Sized(c -> e): measure

instance Tag(I32): I32.tag

instance Peek(Box(a), a): Box(a).size

instance (Tag(a)) Sized(Pair(a), a): Pair(a).measure

fn tag(x: a [shared call]) -> I32 = <no body>

fn size(self: c [shared call]) -> I32 = <no body>

fn measure(self: c [shared call]) -> I32 = <no body>

fn I32.tag(x: I32 [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (x)
  return take %0
}

fn Box(a).size(self: Box(a) [shared call]) -> I32 {
  form specialized
  slot #0 type a
bb0:
  %0: I32 = const 1
  return take %0
}

fn boxSize(b: Box(a) [shared call]) -> I32 {
  form specialized
  slot #0 type a
  slot #1 class Tag(a)
bb0:
  %0: Box(a) [shared call] = read borrow.shared (b) loan0
  %1: I32 = call size(Box(a), a) borrow.shared %0
  return take %1
}

fn Pair(a).measure(self: Pair(a) [shared call]) -> I32 {
  form specialized
  slot #0 type a
  slot #1 class Tag(a)
bb0:
  %0: a [shared call] = read borrow.shared (self.left) loan0
  %1: I32 = call tag(a) borrow.shared %0
  %2: a [shared call] = read borrow.shared (self.right) loan1
  %3: I32 = call tag(a) borrow.shared %2
  %4: I32 = add inspect %1 inspect %3
  return take %4
}

fn measured(p: Pair(a) [shared call]) -> I32 {
  form specialized
  slot #0 type a
  slot #1 class Tag(a)
bb0:
  %0: Pair(a) [shared call] = read borrow.shared (p) loan0
  %1: I32 = call measure(Pair(a), a) borrow.shared %0
  return take %1
}

fn main() -> I32 {
  local b: Box(I32)
  local p: Pair(I32)

bb0:
  %0: I32 = const 7
  %1: Box(I32) = aggregate.Box take %0
  write.init borrow.unique (b) take %1
  %3: I32 = const 3
  %4: I32 = const 4
  %5: Pair(I32) = aggregate.Pair take %3 take %4
  write.init borrow.unique (p) take %5
  %7: Box(I32) = read copy.trivial (b)
  %8: I32 = call boxSize(I32) borrow.shared %7
  %9: Pair(I32) = read copy.trivial (p)
  %10: I32 = call measured(I32) borrow.shared %9
  %11: I32 = add inspect %8 inspect %10
  return take %11
}

fn boxSize(I32)(b: Box(I32) [shared call]) -> I32 = <boxSize at I32>

fn measured(I32)(p: Pair(I32) [shared call]) -> I32 = <measured at I32>

fn Box(a).size(I32)(self: Box(I32) [shared call]) -> I32 = <Box(a).size at I32>

fn Pair(a).measure(I32)(self: Pair(I32) [shared call]) -> I32 = <Pair(a).measure at I32>

entry main
