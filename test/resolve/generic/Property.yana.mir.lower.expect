twice(Crate)<complex>(%x: Ptr): I32 {
  b_0 {
    %v_1 = call_complex measure(Crate), %x: I32
    %v_2 = call_complex measure(Crate), %x: I32
    %v_3 = add %v_1, %v_2: I32
