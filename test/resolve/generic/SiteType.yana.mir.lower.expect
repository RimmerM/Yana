lends(main.lambda'3)<complex>(%g: Ptr, %target: Ptr) {
  b_0 {
    %v_1 = loads %target, 4: I32
    %v_2 = loads %g, 4: I32
    %v_3 = add %v_1, %v_2: I32
    store %target, %v_3, 4
