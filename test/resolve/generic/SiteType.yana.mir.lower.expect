    %v_11 = call_complex opaque, 7: I32
    %v_12 = call_complex apply((I32) -> I32), %v_1, %v_11: I32
    %v_13 = call_complex opaque, 1: I32
    %v_14 = alloca 4, 4: Ptr
    store %v_14, %v_4, 4
    %v_15 = call_complex twice(main.lambda'2), %v_14, %v_13: I32
    store %v_2, funvalue(triple), 8
    %v_16 = add %v_2, 8: Ptr
    store %v_16, 0, 8
    %v_17 = call_complex opaque, 2: I32
    %v_18 = call_complex twice((I32) -> I32), %v_2, %v_17: I32
    %v_19 = call_complex opaque, 100: I32
    store %v_3, %v_19, 4
    %v_20 = alloca 4, 4: Ptr
    store %v_20, %v_4, 4
    call_complex lends(main.lambda'3), %v_20, %v_3
    %v_21 = add %v_5, %v_6: I32
    %v_22 = add %v_21, %v_9: I32
    %v_23 = add %v_22, %v_12: I32
    %v_24 = add %v_23, %v_15: I32
    %v_25 = add %v_24, %v_18: I32
    %v_26 = loads %v_3, 4: I32
    %v_27 = add %v_25, %v_26: I32
    ret %v_27
  }
}

apply(main.lambda)<complex>(%g: Ptr, %x: I32): I32 {
