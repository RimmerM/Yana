main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 16, 8: Ptr
    %v_2 = alloca 16, 8: Ptr
    %v_3 = alloca 4, 4: Ptr
    %v_4 = call_complex opaque, 3: I32
    %v_5 = call_complex held, %v_4: I32
