counted<complex>(%n: I32): I32 {
  b_0 {
    %v_1 = alloca 8, 4: Ptr
    store %v_1, %n, 4
    %v_2 = add %v_1, 4: Ptr
    store %v_2, 2, 4
    %v_3 = call_complex go(counted.lambda), %v_1, 5: I32
    ret %v_3
  }
