
small<complex>(%b: Ptr): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    copy %v_1, %b, 4
    %v_2 = call_complex free(4), %v_1: I32
    ret %v_2
  }
}

large<complex>(%b: Ptr): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    copy %v_1, %b, 4
    %v_2 = call_complex free(64), %v_1: I32
    ret %v_2
  }
}

slotWidth<complex>(%s: Ptr): I32 {
  b_0 {
    %v_1 = loads %s, 4: I32
    ret %v_1
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    %v_2 = alloca 4, 4: Ptr
    %v_3 = alloca 4, 4: Ptr
    %v_4 = alloca 4, 4: Ptr
    store %v_4, 1, 4
    %v_5 = call_complex small, %v_4: I32
    store %v_1, %v_5, 4
    %v_6 = alloca 4, 4: Ptr
    store %v_6, 2, 4
    %v_7 = call_complex large, %v_6: I32
    store %v_2, %v_7, 4
    %v_8 = alloca 4, 4: Ptr
    store %v_8, 0, 4
    %v_9 = call_complex Buf(n).units(16), %v_8: I32
    store %v_3, %v_9, 4
    %v_10 = loads %v_1, 4: I32
    %v_11 = loads %v_2, 4: I32
    %v_12 = add %v_10, %v_11: I32
    %v_13 = loads %v_3, 4: I32
    %v_14 = add %v_12, %v_13: I32
    %v_15 = alloca 4, 4: Ptr
    store %v_15, 7, 4
    %v_16 = call_complex slotWidth, %v_15: I32
    %v_17 = add %v_14, %v_16: I32
    ret %v_17
  }
}

Buf(n).units(16)<complex>(%x: Ptr): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    copy %v_1, %x, 4
    %v_2 = call_complex capacity(16), %v_1: I32
    ret %v_2
  }
}

free(4)<complex>(%b: Ptr): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    copy %v_1, %b, 4
    %v_2 = call_complex capacity(4), %v_1: I32
    %v_3 = loads %b, 4: I32
    %v_4 = sub %v_2, %v_3: I32
    ret %v_4
  }
}

free(64)<complex>(%b: Ptr): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    copy %v_1, %b, 4
    %v_2 = call_complex capacity(64), %v_1: I32
    %v_3 = loads %b, 4: I32
    %v_4 = sub %v_2, %v_3: I32
    ret %v_4
  }
