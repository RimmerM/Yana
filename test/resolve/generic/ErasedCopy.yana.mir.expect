module ResolveTest

data Tally {id: I32} drop authored

class Sink(a): take

instance Drop(Tally): Tally.drop

instance Copy(Tally): Tally.copy

instance Sink(Tally): Tally.take

instance Sink(I32): I32.take

let & trace: I32 = 0

fn take(x: a) -> I32 = <no body>

fn Tally.drop(value: Tally) -> {} {
bb0:
  %0: I32 = read copy.trivial (global trace)
  %1: I32 = read copy.trivial (value.id)
  %2: I32 = add inspect %0 inspect %1
  write.assign borrow.unique (global trace) take %2
  return
}

fn Tally.copy(from: Tally [shared call]) -> Tally {
bb0:
  %0: I32 = read copy.trivial (from.id)
  %1: I32 = const 100
  %2: I32 = add inspect %0 inspect %1
  %3: Tally = aggregate take %2
  return take %3
}

fn Tally.take(x: Tally) -> I32 {
bb0:
  %0: I32 = read copy.trivial (x.id)
  drop (x)
  return take %0
}

fn I32.take(x: I32) -> I32 {
bb0:
  %0: I32 = read copy.trivial (x)
  return take %0
}

fn twiceSunk(x: a [shared call]) -> I32 {
  form erased
  slot #0 type a
  slot #1 class Copy(a)
  slot #2 class Sink(a)
bb0:
  %0: a [shared call] = read borrow.shared (x) loan0
  %1: a = call copy(a) borrow.shared %0
  %2: I32 = call take(a) take %1
  %3: a [shared call] = read borrow.shared (x) loan1
  %4: a = call copy(a) borrow.shared %3
  %5: I32 = call take(a) take %4
  %6: I32 = add inspect %2 inspect %5
  return take %6
}

fn doubled(x: a [shared call]) -> I32 {
  form erased
  slot #0 type a
  slot #1 property a.id
  local one: a [shared call]
  local two: a [shared call]

bb0:
  %0: a [shared call] = read borrow.shared (x) loan0
  write.init borrow.unique (one) borrow.shared %0
  %2: a [shared call] = read borrow.shared (x) loan1
  write.init borrow.unique (two) borrow.shared %2
  %4: I32 = read copy.trivial (one.id)
  %5: I32 = read copy.trivial (two.id)
  %6: I32 = add inspect %4 inspect %5
  return take %6
}

fn main() -> I32 {
  local t: Tally
  local n: I32
  local local2: Tally
  local d: I32

bb0:
  %0: I32 = const 1
  %1: Tally = aggregate take %0
  write.init borrow.unique (t) take %1
  %3: Tally [shared call] = read borrow.shared (t) loan0
  %4: I32 = call twiceSunk(Tally) borrow.shared %3
  drop (t)
  write.init borrow.unique (n) take %4
  %6: I32 = const 7
  %7: Tally = aggregate take %6
  write.init borrow.unique (local2) take %7
  %9: Tally [shared call] = read borrow.shared (local2) loan1
  %10: I32 = call doubled(Tally) borrow.shared %9
  drop (local2)
  write.init borrow.unique (d) take %10
  %12: I32 = read copy.trivial (n)
  %13: I32 = read copy.trivial (d)
  %14: I32 = add inspect %12 inspect %13
  %15: I32 = read copy.trivial (global trace)
  %16: I32 = add inspect %14 inspect %15
  return take %16
}

entry main
