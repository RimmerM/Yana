module ResolveTest

data Vessel {size: I32, mark: I32}

data Crate {size: I32}

data Flagged {size: I32, flag: Bool, mark: I32}

class Peek(b): peek

instance Peek(I32): I32.peek

fn peek(x: b [shared call]) -> I32 = <no body>

fn measure(x: a [shared call]) -> I32 {
  form specialized
  slot #0 type a
  slot #1 property a.size
bb0:
  %0: I32 = read copy.trivial (x.size)
  return take %0
}

fn label(x: a [shared call]) -> I32 {
  form specialized
  slot #0 type a
  slot #1 property a.size
  slot #2 property a.mark
bb0:
  %0: I32 = read copy.trivial (x.size)
  %1: I32 = read copy.trivial (x.mark)
  %2: I32 = add inspect %0 inspect %1
  return take %2
}

fn twice(x: a [shared call]) -> I32 {
  form specialized
  slot #0 type a
  slot #1 property a.size
bb0:
  %0: a [shared call] = read borrow.shared (x) loan0
  %1: I32 = call measure(a) borrow.shared %0
  %2: a [shared call] = read borrow.shared (x) loan1
  %3: I32 = call measure(a) borrow.shared %2
  %4: I32 = add inspect %1 inspect %3
  return take %4
}

fn bump(x: a [unique call]) -> I32 {
  form erased
  slot #0 type a
  slot #1 property a.size
bb0:
  %0: I32 = read copy.trivial (x.size)
  %1: I32 = const 1
  %2: I32 = add inspect %0 inspect %1
  write.assign borrow.unique (x.size) take %2
  %4: I32 = read copy.trivial (x.size)
  return take %4
}

fn I32.peek(x: I32 [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (x)
  %1: I32 = const 1
  %2: I32 = add inspect %0 inspect %1
  return take %2
}

fn readFlag(x: a [shared call]) -> Bool {
  form erased
  slot #0 type a
  slot #1 property a.flag
bb0:
  %0: Bool = read copy.trivial (x.flag)
  return take %0
}

fn setFlag(x: a [unique call]) -> Bool {
  form erased
  slot #0 type a
  slot #1 property a.flag
bb0:
  %0: Bool = const True
  write.assign borrow.unique (x.flag) take %0
  %2: Bool = read copy.trivial (x.flag)
  return take %2
}

fn opaqueMark(x: a [shared call]) -> I32 {
  form erased
  slot #0 type a
  slot #1 type b
  slot #2 class Peek(b)
  slot #3 property a.mark
bb0:
  %0: b [shared call] = read borrow.shared (x.mark) loan0
  %1: I32 = call peek(b) borrow.shared %0
  return take %1
}

fn forwarded(x: a [shared call]) -> I32 {
  form specialized
  slot #0 type a
  slot #1 type b
  slot #2 class Peek(b)
  slot #3 property a.mark
bb0:
  %0: a [shared call] = read borrow.shared (x) loan0
  %1: I32 = call opaqueMark(a, b) borrow.shared %0
  return take %1
}

fn guarded() -> I32 {
  local & f: Flagged

bb0:
  %0: I32 = const 1
  %1: Bool = const False
  %2: I32 = const 7
  %3: Flagged = aggregate take %0 take %1 take %2
  write.init borrow.unique (f) take %3
  %5: Flagged = read copy.trivial (f)
  %6: Bool = call readFlag(Flagged) borrow.shared %5
  branch inspect %6 -> bb1 -> bb2

bb1:
  %8: I32 = const -1
  return take %8

bb2:
  jump -> bb3

bb3:
  %11: Flagged [unique call] = read borrow.unique (f) loan0
  %12: Bool = call setFlag(Flagged) borrow.unique %11
  %13: Bool = const False
  %14: Bool = eq inspect %12 inspect %13
  branch inspect %14 -> bb4 -> bb5

bb4:
  %16: I32 = const -2
  return take %16

bb5:
  jump -> bb6

bb6:
  %19: Bool = read copy.trivial (f.flag)
  %20: Bool = const False
  %21: Bool = eq inspect %19 inspect %20
  branch inspect %21 -> bb7 -> bb8

bb7:
  %23: I32 = const -3
  return take %23

bb8:
  jump -> bb9

bb9:
  %26: Flagged = read copy.trivial (f)
  %27: I32 = call opaqueMark(Flagged, I32) borrow.shared %26
  %28: I32 = const 8
  %29: Bool = ne inspect %27 inspect %28
  branch inspect %29 -> bb10 -> bb11

bb10:
  %31: I32 = const -4
  return take %31

bb11:
  jump -> bb12

bb12:
  %34: Flagged = read copy.trivial (f)
  %35: I32 = call forwarded(Flagged, I32) borrow.shared %34
  %36: I32 = const 8
  %37: Bool = ne inspect %35 inspect %36
  branch inspect %37 -> bb13 -> bb14

bb13:
  %39: I32 = const -5
  return take %39

bb14:
  jump -> bb15

bb15:
  %42: I32 = const 6
  return take %42
}

fn main() -> I32 {
  local g: I32
  local & w: Vessel
  local bumped: I32
  local v: Vessel
  local c: Crate

bb0:
  %0: I32 = call guarded
  write.init borrow.unique (g) take %0
  %2: I32 = read copy.trivial (g)
  %3: I32 = const 6
  %4: Bool = ne inspect %2 inspect %3
  branch inspect %4 -> bb1 -> bb2

bb1:
  %6: I32 = read copy.trivial (g)
  return take %6

bb2:
  jump -> bb3

bb3:
  %9: I32 = const 10
  %10: I32 = const 3
  %11: Vessel = aggregate take %9 take %10
  write.init borrow.unique (w) take %11
  %13: Vessel [unique call] = read borrow.unique (w) loan0
  %14: I32 = call bump(Vessel) borrow.unique %13
  write.init borrow.unique (bumped) take %14
  %16: I32 = read copy.trivial (w.size)
  %17: I32 = const 11
  %18: Bool = ne inspect %16 inspect %17
  branch inspect %18 -> bb4 -> bb5

bb4:
  %20: I32 = const -1
  return take %20

bb5:
  jump -> bb6

bb6:
  %23: I32 = read copy.trivial (bumped)
  %24: I32 = const 11
  %25: Bool = ne inspect %23 inspect %24
  branch inspect %25 -> bb7 -> bb8

bb7:
  %27: I32 = const -2
  return take %27

bb8:
  jump -> bb9

bb9:
  %30: I32 = const 10
  %31: I32 = const 3
  %32: Vessel = aggregate take %30 take %31
  write.init borrow.unique (v) take %32
  %34: I32 = const 100
  %35: Crate = aggregate take %34
  write.init borrow.unique (c) take %35
  %37: Vessel = read copy.trivial (v)
  %38: I32 = call measure(Vessel) borrow.shared %37
  %39: Vessel = read copy.trivial (v)
  %40: I32 = call label(Vessel) borrow.shared %39
  %41: I32 = add inspect %38 inspect %40
  %42: Crate = read copy.trivial (c)
  %43: I32 = call twice(Crate) borrow.shared %42
  %44: I32 = add inspect %41 inspect %43
  return take %44
}

fn measure(Vessel)(x: Vessel [shared call]) -> I32 = <measure at Vessel>

fn label(Vessel)(x: Vessel [shared call]) -> I32 = <label at Vessel>

fn twice(Crate)(x: Crate [shared call]) -> I32 = <twice at Crate>

fn forwarded(Flagged, I32)(x: Flagged [shared call]) -> I32 = <forwarded at Flagged, I32>

fn measure(Crate)(x: Crate [shared call]) -> I32 = <measure at Crate>

entry main
