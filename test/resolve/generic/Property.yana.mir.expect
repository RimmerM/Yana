module ResolveTest

data Vessel {size: I32, mark: I32}

data Crate {size: I32}

fn measure(x: a [shared call]) -> I32 {
  form specialized
  slot #0 type a
  slot #1 property a.size
bb0:
  %0: I32 = read copy.trivial (x.size)
  return take %0
}

fn label(x: a [shared call]) -> I32 {
  form specialized
  slot #0 type a
  slot #1 property a.size
  slot #2 property a.mark
bb0:
  %0: I32 = read copy.trivial (x.size)
  %1: I32 = read copy.trivial (x.mark)
  %2: I32 = add inspect %0 inspect %1
  return take %2
}

fn twice(x: a [shared call]) -> I32 {
  form specialized
  slot #0 type a
  slot #1 property a.size
bb0:
  %0: a [shared call] = read borrow.shared (x) loan0
  %1: I32 = call measure(a) borrow.shared %0
  %2: a [shared call] = read borrow.shared (x) loan1
  %3: I32 = call measure(a) borrow.shared %2
  %4: I32 = add inspect %1 inspect %3
  return take %4
}

fn main() -> I32 {
  local v: Vessel
  local c: Crate

bb0:
  %0: I32 = const 10
  %1: I32 = const 3
  %2: Vessel = aggregate take %0 take %1
  write.init borrow.unique (v) take %2
  %4: I32 = const 100
  %5: Crate = aggregate take %4
  write.init borrow.unique (c) take %5
  %7: Vessel = read copy.trivial (v)
  %8: I32 = call measure(Vessel) borrow.shared %7
  %9: Vessel = read copy.trivial (v)
  %10: I32 = call label(Vessel) borrow.shared %9
  %11: I32 = add inspect %8 inspect %10
  %12: Crate = read copy.trivial (c)
  %13: I32 = call twice(Crate) borrow.shared %12
  %14: I32 = add inspect %11 inspect %13
  return take %14
}

fn measure(Vessel)(x: Vessel [shared call]) -> I32 = <measure at Vessel>

fn label(Vessel)(x: Vessel [shared call]) -> I32 = <label at Vessel>

fn twice(Crate)(x: Crate [shared call]) -> I32 = <twice at Crate>

fn measure(Crate)(x: Crate [shared call]) -> I32 = <measure at Crate>

entry main
