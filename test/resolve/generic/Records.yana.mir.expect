fn boxed(Guard)(x: Guard) -> Boxed(Guard) = <boxed at Guard>

fn unbox(Guard)(b: Boxed(Guard)) -> Guard = <unbox at Guard>

fn discard(I32)(x: I32) -> {} = <discard at I32>

fn discard(Guard)(x: Guard) -> {} = <discard at Guard>

fn keepFirst(Guard, Guard)(p: Pair(Guard, Guard)) -> Guard = <keepFirst at Guard, Guard>

