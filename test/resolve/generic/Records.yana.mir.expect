bb9:
  %39: I32 = const 0
  write.assign borrow.unique (global trace) take %39
  %41: I32 = read copy.trivial (result)
  %42: I32 = call halfPair
  %43: I32 = add inspect %41 inspect %42
  write.assign borrow.unique (result) take %43
  %45: I32 = read copy.trivial (global trace)
  %46: I32 = const 65
  %47: Bool = ne inspect %45 inspect %46
  branch inspect %47 -> bb10 -> bb11

bb10:
  %49: I32 = const -4
  return take %49

bb11:
