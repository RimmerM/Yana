module ResolveTest

data Guard {id: I32} drop authored

data Boxed(a) {value: a} drop derived reclaim derived

data Pair(a, b) {left: a, right: b} drop derived reclaim derived

data Boxed(Guard) {value: Guard} of Boxed drop derived

data Pair(Guard, Guard) {left: Guard, right: Guard} of Pair drop derived

instance Drop(Guard): Guard.drop

let & trace: I32 = 0

fn Guard.drop(value: Guard) -> {} {
bb0:
  %0: I32 = read copy.trivial (global trace)
  %1: I32 = const 10
  %2: I32 = mul inspect %0 inspect %1
  %3: I32 = read copy.trivial (value.id)
  %4: I32 = add inspect %2 inspect %3
  write.assign borrow.unique (global trace) take %4
  return
}

fn guard(id: I32 [shared call]) -> Guard {
bb0:
  %0: I32 = read copy.trivial (id)
  %1: Guard = aggregate take %0
  return take %1
}

fn idOf(g: Guard [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (g.id)
  return take %0
}

fn boxed(x: a) -> Boxed(a) {
  form specialized
  slot #0 type a
bb0:
  %0: a = read take (x)
  %1: Boxed(a) = aggregate take %0
  return take %1
}

fn unbox(b: Boxed(a)) -> a {
  form specialized
  slot #0 type a
bb0:
  %0: a = read take (b.value)
  return take %0
}

fn boxedGuard() -> I32 {
  local b: Boxed(Guard)

bb0:
  %0: I32 = const 1
  %1: Guard = call guard borrow.shared %0
  %2: Boxed(Guard) = call boxed(Guard) take %1
  write.init borrow.unique (b) take %2
  drop (b)
  %4: I32 = const 1
  return take %4
}

fn unboxedGuard() -> I32 {
  local g: Guard

bb0:
  %0: I32 = const 2
  %1: Guard = call guard borrow.shared %0
  %2: Boxed(Guard) = call boxed(Guard) take %1
  %3: Guard = call unbox(Guard) take %2
  write.init borrow.unique (g) take %3
  %5: Guard [shared call] = read borrow.shared (g) loan0
  %6: I32 = call idOf borrow.shared %5
  drop (g)
  return take %6
}

fn discard(x: a) -> {} {
  form specialized
  slot #0 type a
bb0:
  drop (x)
  return
}

fn discarded() -> I32 {
bb0:
  %0: I32 = const 3
  %1: {} = call discard(I32) take %0
  %2: I32 = const 4
  %3: Guard = call guard borrow.shared %2
  %4: {} = call discard(Guard) take %3
  %5: I32 = const 4
  return take %5
}

fn keepFirst(p: Pair(a, b)) -> a {
  form specialized
  slot #0 type a
  slot #1 type b
bb0:
  %0: a = read take (p.left)
  drop (p.right)
  return take %0
}

fn halfPair() -> I32 {
  local g: Guard

bb0:
  %0: I32 = const 5
  %1: Guard = call guard borrow.shared %0
  %2: I32 = const 6
  %3: Guard = call guard borrow.shared %2
  %4: Pair(Guard, Guard) = aggregate take %1 take %3
  %5: Guard = call keepFirst(Guard, Guard) take %4
  write.init borrow.unique (g) take %5
  %7: Guard [shared call] = read borrow.shared (g) loan0
  %8: I32 = call idOf borrow.shared %7
  drop (g)
  return take %8
}

fn main() -> I32 {
  local & result: I32

bb0:
  %0: I32 = const 0
  write.init borrow.unique (result) take %0
  %2: I32 = read copy.trivial (result)
  %3: I32 = call boxedGuard
  %4: I32 = add inspect %2 inspect %3
  write.assign borrow.unique (result) take %4
  %6: I32 = read copy.trivial (global trace)
  %7: I32 = const 1
  %8: Bool = ne inspect %6 inspect %7
  branch inspect %8 -> bb1 -> bb2

bb1:
  %10: I32 = const -1
  return take %10

bb2:
  jump -> bb3

bb3:
  %13: I32 = const 0
  write.assign borrow.unique (global trace) take %13
  %15: I32 = read copy.trivial (result)
  %16: I32 = call unboxedGuard
  %17: I32 = add inspect %15 inspect %16
  write.assign borrow.unique (result) take %17
