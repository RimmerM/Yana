
main<complex>(): I32 {
  b_0 {
    jmp b_1
  }

  b_1 {
    jmp b_2
  }

  b_2 {
    jmp b_3
  }

  b_3 {
    jmp b_4
  }

  b_4 {
    jmp b_5
  }

  b_5 {
    %v_6 = alloca 8, 4: Ptr
    store %v_6, 3, 4
    %v_7 = add %v_6, 4: Ptr
    store %v_7, 4, 4
    jmp b_8
  }

  b_8 {
