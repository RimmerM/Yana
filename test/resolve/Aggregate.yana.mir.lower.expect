choiceValue<complex>(%choice: Ptr): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    %v_2 = alloca 4, 4: Ptr
    %v_3 = alloca 4, 4: Ptr
    %v_4 = load %choice, 1: I32
    %v_5 = cmp_eq %v_4, 0: I32
    je %v_5, b_6, b_7
  }

  b_7 {
    %v_8 = add %choice, 4: Ptr
    %v_9 = loads %v_8, 4: I32
    store %v_2, %v_9, 4
    %v_10 = add %choice, 8: Ptr
    %v_11 = loads %v_10, 4: I32
    store %v_3, %v_11, 4
    %v_12 = loads %v_2, 4: I32
    %v_13 = loads %v_3, 4: I32
    %v_14 = add %v_12, %v_13: I32
    jmp b_15
  }

  b_15 {
    %v_16 = phi [b_7, %v_14], [b_6, %v_17]: I32
    ret %v_16
  }

  b_6 {
    %v_18 = add %choice, 4: Ptr
    %v_19 = loads %v_18, 4: I32
    store %v_1, %v_19, 4
    %v_17 = loads %v_1, 4: I32
