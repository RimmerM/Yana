    %v_33 = phi [b_7, %v_9], [b_5, 0]: I32
    %v_34 = add %v_33, 10: I32
    %v_35 = add %v_31, %v_33: I32
    %v_27 = add %v_35, %v_34: I32
    %v_9 = add %v_33, 1: I32
