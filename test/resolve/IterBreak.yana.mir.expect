module ResolveTest

let string'188: [CodeUnit *3] = "abc"

lens fn ticks(n: I32 [shared call], $body: (I32) -> I32 [shared call]) -> I32 {
  local & $yielded: I32
  local & held: String
  flag (held) = gone

bb0:
  %0: I32 = const 0
  write.init borrow.unique ($yielded) take %0
  %2: String = const String {units: Array {run: Run {items: &string'188, capacity: 3, ownsHeap: 0}, length: 3}}
  write.init borrow.unique (held) take %2
  flag (held) = held
  jump -> bb1

bb1:
  %5: Bool = const True
  branch inspect %5 -> bb3 -> bb2

bb2:
  drop.maybe (held)
  %43: I32 = read copy.trivial ($yielded)
  flag (held) = gone
  return take %43

bb3:
  %7: I32 = read copy.trivial (n)
  %8: I32 = const 0
  %9: Bool = lt inspect %7 inspect %8
  branch inspect %9 -> bb6 -> bb4

bb4:
  jump -> bb5

bb5:
  %26: I32 = read copy.trivial ($yielded)
  %27: I32 = const 0
  %28: Bool = eq inspect %26 inspect %27
  branch inspect %28 -> bb11 -> bb12

bb6:
  drop (held)
  %11: I32 = read copy.trivial ($yielded)
  flag (held) = gone
  %12: I32 = const 0
  %13: Bool = eq inspect %11 inspect %12
  branch inspect %13 -> bb7 -> bb8

bb7:
  %15: I32 = const -1
  %16: (I32) -> I32 [shared call] = read borrow.shared ($body) loan0
  %17: I32 = call inspect %16 borrow.shared %15
  %18: I32 = const 0
  %19: Bool = eq inspect %17 inspect %18
  write.assign borrow.unique ($yielded) take %17
  branch inspect %19 -> bb9 -> bb10

bb8:
  jump -> bb10

bb9:
  jump -> bb2

bb10:
  jump -> bb2

bb11:
  %30: String [shared call] = read borrow.shared (held) loan1
  %31: String [shared slot 0 view] = call.derivation view(String) borrow.shared %30 roots{1}
  %32: Size = call length(String) borrow.shared %31
  drop (held)
  %33: I32 = convert inspect %32
  flag (held) = gone
  %34: (I32) -> I32 [shared call] = read borrow.shared ($body) loan2
  %35: I32 = call inspect %34 borrow.shared %33
  %36: I32 = const 0
  %37: Bool = eq inspect %35 inspect %36
  write.assign borrow.unique ($yielded) take %35
  branch inspect %37 -> bb13 -> bb14

bb12:
  drop (held)
  jump -> bb14
  flag (held) = gone

bb13:
  jump -> bb2

bb14:
  jump -> bb2
}

fn main() -> I32 {
  local & total: I32
  local t: I32 [shared call]
  local t: I32 [shared call]

bb0:
  %0: I32 = const 0
  write.init borrow.unique (total) take %0
  %2: I32 = const 3
  lens.call ticks borrow.shared %2 -> bb2

bb1:
  %11: I32 = const -3
  lens.call ticks borrow.shared %11 -> bb4

bb2(%3: I32 [shared call]) handover(I32 [shared call]) many -> bb1:
  write.init borrow.unique (t) borrow.shared %3
  %6: I32 = read copy.trivial (total)
  %7: I32 = read copy.trivial (t)
  %8: I32 = add inspect %6 inspect %7
  write.assign borrow.unique (total) take %8
  jump -> bb1

bb3:
  %20: I32 = read copy.trivial (total)
  return take %20

bb4(%12: I32 [shared call]) handover(I32 [shared call]) many -> bb3:
  write.init borrow.unique (t) borrow.shared %12
  %15: I32 = read copy.trivial (total)
  %16: I32 = read copy.trivial (t)
  %17: I32 = add inspect %15 inspect %16
  write.assign borrow.unique (total) take %17
  jump -> bb3
}

entry main
