module ResolveTest

let string'142: [CodeUnit *3] = [97, 98, 99]

lens fn ticks(n: I32 [shared call], $body: (I32) -> I32 [shared call]) -> I32 {
  local & $yielded: I32
  local & held: String
  flag (held) = gone

bb0:
  %0: I32 = const 0
  write.init borrow.unique ($yielded) take %0
  %2: [CodeUnit *3] [shared slot 0] = read borrow.shared (global string'142) loan0
  %3: %[CodeUnit *3] [owned here shape6 .*=shared slot 0] = address inspect %2 roots.0{0}
  %4: %CodeUnit [owned here shape6 .*=shared slot 0] = bitcast inspect %3 roots.0{0}
  %5: I32 = const 3
  %6: String = call stringLiteral borrow.shared %4 borrow.shared %5
  write.init borrow.unique (held) take %6
  flag (held) = held
  jump -> bb1

bb1:
  %9: Bool = const True
  branch inspect %9 -> bb3 -> bb2

bb2:
  drop.maybe (held)
  %47: I32 = read copy.trivial ($yielded)
  flag (held) = gone
  return take %47

bb3:
  %11: I32 = read copy.trivial (n)
  %12: I32 = const 0
  %13: Bool = lt inspect %11 inspect %12
  branch inspect %13 -> bb6 -> bb4

bb4:
  jump -> bb5

bb5:
  %30: I32 = read copy.trivial ($yielded)
  %31: I32 = const 0
  %32: Bool = eq inspect %30 inspect %31
  branch inspect %32 -> bb11 -> bb12

bb6:
  drop (held)
  %15: I32 = read copy.trivial ($yielded)
  flag (held) = gone
  %16: I32 = const 0
  %17: Bool = eq inspect %15 inspect %16
  branch inspect %17 -> bb7 -> bb8

bb7:
  %19: I32 = const -1
  %20: (I32) -> I32 [shared call] = read borrow.shared ($body) loan1
  %21: I32 = call inspect %20 borrow.shared %19
  %22: I32 = const 0
  %23: Bool = eq inspect %21 inspect %22
  write.assign borrow.unique ($yielded) take %21
  branch inspect %23 -> bb9 -> bb10

bb8:
  jump -> bb10

bb9:
  jump -> bb2

bb10:
  jump -> bb2

bb11:
  %34: String [shared call] = read borrow.shared (held) loan2
  %35: String [shared slot 0 view] = call.derivation view(String) borrow.shared %34 roots{2}
  %36: Size = call length(String) borrow.shared %35
  drop (held)
  %37: I32 = convert inspect %36
  flag (held) = gone
  %38: (I32) -> I32 [shared call] = read borrow.shared ($body) loan3
  %39: I32 = call inspect %38 borrow.shared %37
  %40: I32 = const 0
  %41: Bool = eq inspect %39 inspect %40
  write.assign borrow.unique ($yielded) take %39
  branch inspect %41 -> bb13 -> bb14

bb12:
  drop (held)
  jump -> bb14
  flag (held) = gone

bb13:
  jump -> bb2

bb14:
  jump -> bb2
}

fn main() -> I32 {
  local & total: I32
  local t: I32 [shared call]
  local t: I32 [shared call]

bb0:
  %0: I32 = const 0
  write.init borrow.unique (total) take %0
  %2: I32 = const 3
  lens.call ticks borrow.shared %2 -> bb2

bb1:
  %11: I32 = const -3
  lens.call ticks borrow.shared %11 -> bb4

bb2(%3: I32 [shared call]) handover(I32 [shared call]) many -> bb1:
  write.init borrow.unique (t) borrow.shared %3
  %6: I32 = read copy.trivial (total)
  %7: I32 = read copy.trivial (t)
  %8: I32 = add inspect %6 inspect %7
  write.assign borrow.unique (total) take %8
  jump -> bb1

bb3:
  %20: I32 = read copy.trivial (total)
  return take %20

bb4(%12: I32 [shared call]) handover(I32 [shared call]) many -> bb3:
  write.init borrow.unique (t) borrow.shared %12
  %15: I32 = read copy.trivial (total)
  %16: I32 = read copy.trivial (t)
  %17: I32 = add inspect %15 inspect %16
  write.assign borrow.unique (total) take %17
  jump -> bb3
}

entry main
