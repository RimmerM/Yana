  } else {
    return n;
  }
}

function main() {
  var n = opaque(2);
  var m = BigInt.asIntN(64, BigInt(opaque(3)));
  return (((5 << n) + (100 >>> n | 0) | 0) + (-32 >> n) | 0) + (Number(BigInt.asIntN(32, BigInt.asIntN(64, BigInt.asIntN(64, BigInt.asUintN(64, BigInt.asIntN(64, 3n << m)) >> BigInt.asIntN(64, m - 1n)) + BigInt.asIntN(64, BigInt.asIntN(64, 0n - 3n) >> m)))) | 0) | 0;
}
main();
