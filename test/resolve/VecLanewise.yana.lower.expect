  b_29 {
    %v_30 = call_complex floats: I32
    %v_31 = cmp_neq %v_30, 0: I32
    je %v_31, b_32, b_33
  }

  b_32 {
    %v_34 = call_complex floats: I32
    %v_35 = imul %v_34, 10000: I32
