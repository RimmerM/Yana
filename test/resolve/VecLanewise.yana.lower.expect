@image$base = []
mut @seed = [3, 0, 0, 0]

comparisons<complex>(%a: i32x4, %b: i32x4): I32 {
  b_0 {
    %v_1 = cmp_ilt %a, %b: m32x4
    %v_2 = vreduce_and %v_1: I32
    je %v_2, b_3, b_4
