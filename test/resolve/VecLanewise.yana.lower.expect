}

main<complex>(): I32 {
  b_0 {
    %v_1 = loads @seed, 4: I32
    %a = vsplat %v_1: i32x4
    %v_2 = add %v_1, 1: I32
    %b = vsplat %v_2: i32x4
    %v_3 = call_complex comparisons, %a, %b: I32
    %v_4 = cmp_neq %v_3, 0: I32
    je %v_4, b_5, b_6
  }

