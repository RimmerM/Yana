  b_4 {
    ret 18446744073709551615
  }

  b_3 {
    jmp b_5
  }

  b_5 {
    %v_6 = cmp_ile %a, %b: m32x4
    %v_7 = vreduce_and %v_6: I32
    je %v_7, b_8, b_9
