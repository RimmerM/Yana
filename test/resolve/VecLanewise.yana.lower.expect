  b_18 {
    jmp b_20
  }

  b_20 {
    %v_21 = cmp_neq %a, %b: m32x4
    %v_22 = vreduce_and %v_21: I32
    je %v_22, b_23, b_24
  }

  b_24 {
    ret 18446744073709551611
  }

  b_23 {
    jmp b_25
  }

  b_25 {
    %v_26 = cmp_eq %a, %b: m32x4
    %v_27 = vreduce_or %v_26: I32
    je %v_27, b_28, b_29
  }

  b_28 {
    ret 18446744073709551610
  }

  b_29 {
    jmp b_30
  }

  b_30 {
    %v_31 = cmp_igt %a, %b: m32x4
    %v_32 = vreduce_or %v_31: I32
    je %v_32, b_33, b_34
  }

  b_33 {
    ret 18446744073709551609
  }

  b_34 {
    jmp b_35
  }

  b_35 {
    ret 0
  }
}

selection<complex>(%a: i32x4, %b: i32x4): I32 {
  b_0 {
    %v_1 = cmp_ilt %a, %b: m32x4
    %smaller = select %v_1, %a, %b: i32x4
    %larger = select %v_1, %b, %a: i32x4
    %v_2 = vlane %smaller, 0: I32
    %v_3 = cmp_neq %v_2, 3: I32
    je %v_3, b_4, b_5
  }

  b_4 {
    ret 18446744073709551615
  }

  b_5 {
    jmp b_6
  }

  b_6 {
    %v_7 = vlane %larger, 1: I32
    %v_8 = cmp_neq %v_7, 4: I32
    je %v_8, b_9, b_10
  }

  b_9 {
    ret 18446744073709551614
  }

  b_10 {
    jmp b_11
  }

  b_11 {
    ret 0
  }
}

combining<complex>(%a: i32x4, %b: i32x4): I32 {
  b_0 {
    %below = cmp_ilt %a, %b: m32x4
    %equal = cmp_eq %a, %b: m32x4
    %v_1 = or %below, %equal: m32x4
    %v_2 = vreduce_and %v_1: I32
    je %v_2, b_3, b_4
  }

  b_4 {
    ret 18446744073709551615
  }

  b_3 {
    jmp b_5
  }

  b_5 {
    %v_6 = and %below, %equal: m32x4
    %v_7 = vreduce_or %v_6: I32
    je %v_7, b_8, b_9
  }

  b_8 {
    ret 18446744073709551614
  }

  b_9 {
    jmp b_10
  }

  b_10 {
    %v_11 = xor %below, %equal: m32x4
    %v_12 = vreduce_and %v_11: I32
    je %v_12, b_13, b_14
  }

  b_14 {
    ret 18446744073709551613
  }

  b_13 {
    jmp b_15
  }

  b_15 {
    %v_16 = not %equal: m32x4
    %v_17 = vreduce_and %v_16: I32
    je %v_17, b_18, b_19
  }

  b_19 {
    ret 18446744073709551612
  }

  b_18 {
    jmp b_20
  }

  b_20 {
    ret 0
  }
}

counting<complex>(): I32 {
  b_0 {
    %v_1 = vsplat 0: i32x4
    %v_2 = vwithlane %v_1, 1, 1: i32x4
    %v_3 = vwithlane %v_2, 2, 2: i32x4
    %indices = vwithlane %v_3, 3, 3: i32x4
    %v_4 = vsplat 1: i32x4
    %past = cmp_ige %indices, %v_4: m32x4
    %v_5 = vreduce_add %past: I32
    %v_6 = cmp_neq %v_5, 3: I32
    je %v_6, b_7, b_8
  }

  b_7 {
    ret 18446744073709551615
  }

  b_8 {
    jmp b_9
  }

  b_9 {
    %v_10 = vreduce_first %past: I32
    %v_11 = cmp_neq %v_10, 1: I32
    je %v_11, b_12, b_13
  }

  b_12 {
    ret 18446744073709551614
  }

  b_13 {
    jmp b_14
  }

  b_14 {
    %never = cmp_ilt %indices, %v_1: m32x4
    %v_15 = vreduce_first %never: I32
    %v_16 = cmp_neq %v_15, 4: I32
    je %v_16, b_17, b_18
  }

  b_17 {
    ret 18446744073709551613
  }

  b_18 {
    jmp b_19
  }

  b_19 {
    %v_20 = vreduce_add %never: I32
    %v_21 = cmp_neq %v_20, 0: I32
    je %v_21, b_22, b_23
  }

  b_22 {
    ret 18446744073709551612
  }

  b_23 {
    jmp b_24
  }

  b_24 {
    %always = cmp_ige %indices, %v_1: m32x4
    %v_25 = vreduce_first %always: I32
    %v_26 = cmp_neq %v_25, 0: I32
    je %v_26, b_27, b_28
  }

  b_27 {
    ret 18446744073709551611
  }

  b_28 {
    jmp b_29
  }

  b_29 {
    %v_30 = vreduce_add %always: I32
    %v_31 = cmp_neq %v_30, 4: I32
    je %v_31, b_32, b_33
  }

  b_32 {
    ret 18446744073709551610
  }

  b_33 {
    jmp b_34
  }

  b_34 {
    ret 0
  }
}

floats<complex>(): I32 {
  b_0 {
    %a = vsplat 1.5: f32x4
    %b = vsplat 2.5: f32x4
    %v_1 = cmp_lt %a, %b: m32x4
    %v_2 = vreduce_and %v_1: I32
    je %v_2, b_3, b_4
  }

  b_4 {
    ret 18446744073709551615
  }

  b_3 {
    jmp b_5
  }

  b_5 {
    %v_6 = cmp_lt %a, %b: m32x4
    %v_7 = select %v_6, %a, %b: f32x4
    %v_8 = vlane %v_7, 0: F32
    %v_9 = cmp_neq %v_8, 1.5: I32
    je %v_9, b_10, b_11
  }

  b_10 {
    ret 18446744073709551614
  }

  b_11 {
    jmp b_12
  }

  b_12 {
    ret 0
