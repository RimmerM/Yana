-- What the return-root rules reject. Each function is one rule.

data Point {x: Int, y: Int}

-- A result that is a borrow, with nothing declared to root it in.
fn unrooted(p: Point) -> 'Int = p.x

-- `return` on a value that arrives in a register: what the body sees is a copy of its own, so
-- there is no caller-side storage for the result to be rooted in.
fn copied(return n: Int) -> 'Int = n

-- `return` on a sunk argument: the callee owns it, so nothing survives the call to be rooted in.
fn sunk(return ->p: Point) -> 'Int = p.x

-- A borrow of storage this frame owns. It stops existing when the frame does, whatever the
-- signature declared.
fn ofLocal(return p: Point) -> 'Int:
    let here = Point {x: 1, y: 2}
    return here.x

-- A borrow rooted in an argument the signature did not mark.
fn wrongRoot(return a: Point, b: Point) -> 'Int = b.y

-- The loan a `return` argument creates outlives the call, so writing through the original while
-- the result is still live is two writers of one place.
fn larger(return &a: Int, return &b: Int) -> &Int = if a > b then a else b

fn loanSurvivesCall() -> Int:
    let &first = 1 :: Int
    let &second = 2 :: Int
    let &picked = larger(first, second)

    first = 5
    return picked

-- `let &` on a borrow that was never exclusive.
fn immutableBinding(return p: Point) -> Int:
    let &field = xOfPoint(p)
    return field

fn xOfPoint(return p: Point) -> 'Int = p.x

{-
   The two-call chain, rooted where the signature cannot hand it back.

   A window that reaches its root through `elements` and then `slice` is accepted where the root is
   a marked argument - `test/resolve/SliceRoot.yana` is that half - so what is left to reject is the
   root itself. Both are named rather than reported as "storage the caller does not own", which is
   the chain being resolved: the frame slot the descriptor landed in is a step along it and not the
   answer.
-}
fn undeclaredWindow(xs: Array(Int)) -> '[Int] = slice(elements(xs), 0, 2)

fn localWindow(return xs: Array(Int)) -> '[Int]:
    let here = newArray(4, (i: Size) -> 1 :: Int)
    return slice(elements(here), 0, 2)
