
backend<complex>(): I32 {
  b_0 {
    ret 1
  }
}

emptyStorage<complex>(%v_0: Ptr) {
  b_1 {
    %v_2 = alloca 8, 4: Ptr
    store %v_2, 0, 4
    %v_3 = add %v_2, 4: Ptr
    store %v_3, 0, 4
    copy %v_0, %v_2, 8
    ret 
  }
}

capacityOf<complex>(%s: Ptr): I32 {
  b_0 {
    %v_1 = loads %s, 4: I32
    ret %v_1
  }
}

shared<complex>(%x: I32): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    store %v_1, %x, 4
    %v_2 = loads %v_1, 4: I32
    %v_3 = imul %v_2, 10: I32
    ret %v_3
  }
}

placement<complex>(): I32 {
  b_0 {
    ret 10
  }
}

word<complex>(): I32 {
  b_0 {
    ret 8
  }
}

onlyAmd64<complex>(): I32 {
  b_0 {
    ret 3
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 8, 4: Ptr
    %v_2 = alloca 8, 4: Ptr
    call_complex emptyStorage, %v_2
    copy %v_1, %v_2, 8
    %v_3 = call_complex backend: I32
    %v_4 = alloca 8, 4: Ptr
    copy %v_4, %v_1, 8
    %v_5 = call_complex capacityOf, %v_4: I32
    %v_6 = add %v_3, %v_5: I32
    %v_7 = call_complex shared, 4: I32
    %v_8 = add %v_6, %v_7: I32
    %v_9 = call_complex placement: I32
    %v_10 = add %v_8, %v_9: I32
    %v_11 = call_complex word: I32
    %v_12 = add %v_10, %v_11: I32
    %v_13 = call_complex onlyAmd64: I32
    %v_14 = add %v_12, %v_13: I32
    ret %v_14
  }
}

