import Native

-- Discriminant folding: Design.md's "Niches and automatic packing", now that something consumes the
-- niches Repr.yana asserts the search finds.
--
-- The point of asserting it behaviourally as well as in the layout dump is that a folded tag is not
-- stored anywhere. A wrong encoding and a wrong decoding are both invisible in the size, and both
-- turn one constructor into another - so what has to be checked is that every constructor still
-- round-trips through storage as itself. `.repr.expect` says how big these are; the numbers below
-- say they still mean what they meant.

-- Named Rank rather than Ordering because Core already has one, and two types of one name in the
-- layout dump would read as a duplicate entry rather than as two types.
data Rank = Less | Same | More

-- Nothing here is written against `Maybe`, which is the whole argument for a search rather than a
-- list of special cases: `Maybe` is Core's, it knows nothing about niches, and all of these fold.

-- `Rank` reaches 0..2, so 3 upwards is free and `Nothing` is 3. Four bytes, not eight.
fn tagOf(m: Maybe(Rank)) -> Int = match m:
    Nothing -> 0
    Just(Less) -> 1
    Just(Same) -> 2
    Just(More) -> 3

-- Nesting: the inner fold takes pattern 3, so the outer one takes 4 out of what is left. This is the
-- case that catches a search which republishes a niche it has already spent - and it would still
-- pass the size assertion while getting every answer wrong.
fn depthOf(m: Maybe(Maybe(Rank))) -> Int = match m:
    Nothing -> 100
    Just(Nothing) -> 200
    Just(Just(o)) -> 300 + tagOf(Just(o))

-- A borrow is never null, so its free patterns are *below* the valid range and `Nothing` folds to
-- zero - the representation a C programmer would have written by hand. Asserted in the layout dump
-- rather than run, since a borrow is formed by passing one rather than by an operator.
fn heldOr(m: Maybe(&Int), fallback: Int) -> Int = match m:
    Nothing -> fallback
    Just(at) -> at

-- A record over a folded value. The fold has to leave whatever it did not spend behind, or a
-- containing type would take a pattern that is already in use.
data Pair {first: Maybe(Rank), second: Maybe(Rank)}

fn pairValue(p: Pair) -> Int = tagOf(p.first) * 10 + tagOf(p.second)

fn roundTrip() -> Int:
    let a = tagOf(Nothing)
    let b = tagOf(Just(Less))
    let c = tagOf(Just(More))
    return a + b * 10 + c * 100

fn nested() -> Int:
    let outer = depthOf(Nothing)
    let middle = depthOf(Just(Nothing))
    let inner = depthOf(Just(Just(Same)))
    return outer + middle + inner

fn paired() -> Int = pairValue(Pair {first: Just(More), second: Nothing})

{-
   A bit-width refinement's niche, which is a donation no `data` declaration in this file makes:
   `@bits(4) U32` reaches 0..15 in storage that holds 256, so `[16, 256)` is free, `Nothing` is
   written as 16 and `Maybe(Nibble)` is one byte rather than five.

   `Core/Text.yana`'s `hexValue` is what the donation is for. Its answer used to be an `Int` with
   `-1` standing for "not a hexadecimal digit", which is a sentinel every caller has to remember to
   test; it is a `Maybe(HexDigit)` now, and this is the layout that makes the two the same code.

   Zero is one of the cases on purpose: it is the value a folded `Nothing` decoded as a `Just` would
   most easily be mistaken for, and it contributes nothing to the sum, so a wrong decode shows up as
   the fallback appearing twice.
-}
alias Nibble = @bits(4) U32

fn nibbleOr(m: Maybe(Nibble), fallback: Int) -> Int = match m:
    Nothing -> fallback
    Just(value) -> value :: Int

fn nibbles() -> Int:
    let empty = nibbleOr(Nothing, 1000)
    let zero = nibbleOr(Just(truncate(0) :: Nibble), 1000)
    let low = nibbleOr(Just(truncate(3) :: Nibble), 1000)
    let high = nibbleOr(Just(truncate(15) :: Nibble), 1000)

    return empty + zero + low * 100 + high

fn main() -> Int = roundTrip() + nested() + paired() + nibbles()
