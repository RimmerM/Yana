  b_10 {
    %signedStillSigned = phi [b_8, 10], [b_9, 0]: Int
    %v_11 = add %quotientIsPositive, %signedStillSigned: Int
    %v_12 = cast %rest: Int
    %v_13 = add %v_11, %v_12: Int
    ret %v_13
