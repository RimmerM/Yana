
divide<complex>(%a: Long, %b: Long): Long {
  b_0 {
    %v_1 = div %a, %b: Long
    ret %v_1
  }
}

remainder<complex>(%a: Long, %b: Long): Long {
  b_0 {
    %v_1 = rem %a, %b: Long
    ret %v_1
  }
}

main<complex>(): Int {
  b_0 {
    %v_1 = sub 0, 2: Int
    %big = cast %v_1: Long
    %half = call_complex divide, %big, 2: Long
    %rest = call_complex remainder, %big, 3: Long
    %v_2 = cmp_gt %half, 0: Int
    je %v_2, b_3, b_4
  }

  b_3 {
    jmp b_5
  }

  b_4 {
    jmp b_5
  }

  b_5 {
    %quotientIsPositive = phi [b_3, 1], [b_4, 0]: Int
    %v_6 = sub 0, 7: Long
    %v_7 = call_complex signedDivide, %v_6, 2: Long
    %v_8 = sub 0, 3: Int
    %v_9 = sext %v_8: Long
    %v_10 = cmp_eq %v_7, %v_9: Int
    je %v_10, b_11, b_12
  }

  b_11 {
    jmp b_13
  }

  b_12 {
    jmp b_13
  }

  b_13 {
    %signedStillSigned = phi [b_11, 10], [b_12, 0]: Int
    %v_14 = add %quotientIsPositive, %signedStillSigned: Int
    %v_15 = cast %rest: Int
    %v_16 = add %v_14, %v_15: Int
    ret %v_16
  }
}

signedDivide<complex>(%a: Long, %b: Long): Long {
  b_0 {
    %v_1 = idiv %a, %b: Long
    ret %v_1
  }
}

