
divide<complex>(%a: Long, %b: Long): Long {
  b_0 {
    %v_1 = div %a, %b: Long
    ret %v_1
  }
}

remainder<complex>(%a: Long, %b: Long): Long {
  b_0 {
    %v_1 = rem %a, %b: Long
    ret %v_1
  }
}

main<complex>(): Int {
  b_0 {
    jmp b_1
  }

  b_1 {
    jmp b_2
  }

  b_2 {
    jmp b_3
  }

  b_3 {
    jmp b_4
  }

  b_4 {
    ret 13
  }
}

signedDivide<complex>(%a: Long, %b: Long): Long {
  b_0 {
    %v_1 = idiv %a, %b: Long
    ret %v_1
  }
}

