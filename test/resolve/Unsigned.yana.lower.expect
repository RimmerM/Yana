main<complex>(): Int {
  b_0 {
    %v_1 = imm 18446744073709551614: Long
    %half = call_complex divide, %v_1, 2: Long
    %rest = call_complex remainder, %v_1, 3: Long
    %v_2 = cmp_gt %half, 0: Int
    je %v_2, b_3, b_4
  }

  b_3 {
    jmp b_5
  }

