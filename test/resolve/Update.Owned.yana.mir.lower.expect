mut @closed = [0, 0, 0, 0]

Handle.drop<complex>(%v_0: I32) {
  b_1 {
    %v_2 = loads @closed, 4: I32
    %v_3 = add %v_2, %v_0: I32
    store @closed, %v_3, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    call_complex Handle.drop, 1
    call_complex Handle.drop, 100
    %v_1 = loads @closed, 4: I32
    call_complex Handle.drop, 2
    call_complex Handle.drop, 8
    call_complex Handle.drop, 1000
    %v_2 = add 180000, %v_1: I32
    ret %v_2
  }
}

