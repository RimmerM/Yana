mut @closed = [0, 0, 0, 0]

Handle.drop<complex>(%value: Ptr) {
  b_0 {
    %v_1 = load %value, 4: I32
    %v_2 = loads @closed, 4: I32
    %v_3 = add %v_2, %v_1: I32
    store @closed, %v_3, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 8, 4: Ptr
    %v_2 = alloca 12, 4: Ptr
    %v_3 = alloca 8, 4: Ptr
    store %v_1, 1, 4
    %v_4 = add %v_1, 4: Ptr
    store %v_4, 0, 4
    call_complex Handle.drop, %v_1
    store %v_1, 2, 4
    store %v_2, 100, 4
    %v_5 = add %v_2, 4: Ptr
    store %v_5, 0, 4
    %v_6 = add %v_2, 8: Ptr
    store %v_6, 3, 4
    call_complex Handle.drop, %v_2
    store %v_2, 8, 4
    store %v_3, 1000, 4
    %v_7 = add %v_3, 4: Ptr
    store %v_7, 5, 4
    %v_8 = loads @closed, 4: I32
    %v_9 = loads %v_1, 4: I32
    call_complex Handle.drop, %v_1
    %v_10 = loads %v_2, 4: I32
    %v_11 = add %v_9, %v_10: I32
    %v_12 = add %v_2, 8: Ptr
    %v_13 = loads %v_12, 4: I32
    call_complex Handle.drop, %v_2
    %v_14 = add %v_11, %v_13: I32
    %v_15 = add %v_3, 4: Ptr
    %v_16 = loads %v_15, 4: I32
    call_complex Handle.drop, %v_3
    %v_17 = add %v_14, %v_16: I32
    %v_18 = imul %v_17, 10000: I32
    %v_19 = add %v_18, %v_8: I32
    ret %v_19
  }
}

