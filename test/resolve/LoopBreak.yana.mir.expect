module ResolveTest

fn firstOverBoth(n: I32 [shared call], m: I32 [shared call], stop: I32 [shared call]) -> I32 {
  local & i: I32

bb0:
  %0: I32 = const 0
  write.init borrow.unique (i) take %0
  jump -> bb1

bb1:
  %3: I32 = read copy.trivial (i)
  %4: I32 = read copy.trivial (n)
  %5: Bool = lt inspect %3 inspect %4
  branch inspect %5 -> bb3 -> bb2

bb2:
  %22: I32 = read copy.trivial (i)
  return take %22

bb3:
  %7: I32 = read copy.trivial (i)
  %8: I32 = read copy.trivial (m)
  %9: Bool = lt inspect %7 inspect %8
  branch inspect %9 -> bb4 -> bb2

bb4:
  %11: I32 = read copy.trivial (i)
  %12: I32 = read copy.trivial (stop)
  %13: Bool = eq inspect %11 inspect %12
  branch inspect %13 -> bb7 -> bb5

bb5:
  jump -> bb6

bb6:
  %17: I32 = read copy.trivial (i)
  %18: I32 = const 1
  %19: I32 = add inspect %17 inspect %18
  write.assign borrow.unique (i) take %19
  jump -> bb1

bb7:
  jump -> bb2
}

