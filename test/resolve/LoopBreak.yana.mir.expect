  %27: I32 = read copy.trivial (j)
  %28: I32 = add inspect %26 inspect %27
  %29: I32 = const 5
  %30: I32 = rem inspect %28 inspect %29
  %31: I32 = const 4
  %32: Bool = eq inspect %30 inspect %31
  branch inspect %32 -> bb12 -> bb10

bb10:
  jump -> bb11

bb11:
  %36: I32 = read copy.trivial (word)
  %37: I32 = read copy.trivial (i)
  %38: I32 = read copy.trivial (j)
  %39: I32 = add inspect %37 inspect %38
  %40: I32 = add inspect %36 inspect %39
  write.assign borrow.unique (word) take %40
  %42: I32 = read copy.trivial (j)
  %43: I32 = const 1
  %44: I32 = add inspect %42 inspect %43
  write.assign borrow.unique (j) take %44
