module ResolveTest

fn firstOverBoth(n: I32 [shared call], m: I32 [shared call], stop: I32 [shared call]) -> I32 {
  local & i: I32

bb0:
  %0: I32 = const 0
  write.init borrow.unique (i) take %0
  jump -> bb1

bb1:
  %3: I32 = read copy.trivial (i)
  %4: I32 = read copy.trivial (n)
  %5: Bool = lt inspect %3 inspect %4
  branch inspect %5 -> bb5 -> bb3

bb2:
  %26: I32 = read copy.trivial (i)
  return take %26

bb3:
  %10: Bool = const False
  jump -> bb4(take %10)

bb4(%11: Bool):
  branch inspect %11 -> bb6 -> bb2

bb5:
  %7: I32 = read copy.trivial (i)
  %8: I32 = read copy.trivial (m)
  %9: Bool = lt inspect %7 inspect %8
  jump -> bb4(take %9)

bb6:
  %15: I32 = read copy.trivial (i)
  %16: I32 = read copy.trivial (stop)
  %17: Bool = eq inspect %15 inspect %16
  branch inspect %17 -> bb9 -> bb7

bb7:
  jump -> bb8

bb8:
  %21: I32 = read copy.trivial (i)
  %22: I32 = const 1
  %23: I32 = add inspect %21 inspect %22
  write.assign borrow.unique (i) take %23
  jump -> bb1

bb9:
  jump -> bb2
}

