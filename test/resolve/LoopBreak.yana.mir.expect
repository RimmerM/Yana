bb14:
  %53: I32 = read copy.trivial (total)
  %54: I32 = read copy.trivial (word)
  %55: I32 = add inspect %53 inspect %54
  write.assign borrow.unique (total) take %55
  %57: I32 = read copy.trivial (i)
  %58: I32 = read copy.trivial (j)
  %59: I32 = add inspect %57 inspect %58
  write.assign borrow.unique (i) take %59
  jump -> bb1

bb15:
