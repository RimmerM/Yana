fn nestedBreaks(n: I32 [shared call], m: I32 [shared call]) -> I32 {
  local & total: I32
  local & i: I32
  local & j: I32
  local & word: I32

bb0:
  %0: I32 = const 0
  write.init borrow.unique (total) take %0
  %2: I32 = const 0
  write.init borrow.unique (i) take %2
  jump -> bb1

bb1:
  %5: I32 = read copy.trivial (i)
  %6: I32 = read copy.trivial (n)
  %7: Bool = lt inspect %5 inspect %6
  branch inspect %7 -> bb3 -> bb2

bb2:
  %58: I32 = read copy.trivial (total)
  return take %58

bb3:
  %9: I32 = const 0
  write.init borrow.unique (j) take %9
  %11: I32 = const 0
  write.init borrow.unique (word) take %11
  jump -> bb4

bb4:
  %14: I32 = read copy.trivial (j)
  %15: I32 = const 4
  %16: Bool = lt inspect %14 inspect %15
  branch inspect %16 -> bb6 -> bb5

bb5:
  %43: I32 = read copy.trivial (j)
  %44: I32 = const 2
  %45: Bool = lt inspect %43 inspect %44
  branch inspect %45 -> bb13 -> bb11

bb6:
  %18: I32 = read copy.trivial (j)
  %19: I32 = read copy.trivial (m)
  %20: Bool = lt inspect %18 inspect %19
  branch inspect %20 -> bb7 -> bb5

bb7:
  %22: I32 = read copy.trivial (i)
  %23: I32 = read copy.trivial (j)
  %24: I32 = add inspect %22 inspect %23
  %25: I32 = const 5
  %26: I32 = rem inspect %24 inspect %25
  %27: I32 = const 4
  %28: Bool = eq inspect %26 inspect %27
  branch inspect %28 -> bb10 -> bb8

bb8:
  jump -> bb9

bb9:
  %32: I32 = read copy.trivial (word)
  %33: I32 = read copy.trivial (i)
  %34: I32 = read copy.trivial (j)
  %35: I32 = add inspect %33 inspect %34
  %36: I32 = add inspect %32 inspect %35
  write.assign borrow.unique (word) take %36
  %38: I32 = read copy.trivial (j)
  %39: I32 = const 1
  %40: I32 = add inspect %38 inspect %39
  write.assign borrow.unique (j) take %40
  jump -> bb4

bb10:
  jump -> bb5

bb11:
  jump -> bb12

bb12:
  %49: I32 = read copy.trivial (total)
  %50: I32 = read copy.trivial (word)
  %51: I32 = add inspect %49 inspect %50
  write.assign borrow.unique (total) take %51
  %53: I32 = read copy.trivial (i)
  %54: I32 = read copy.trivial (j)
  %55: I32 = add inspect %53 inspect %54
  write.assign borrow.unique (i) take %55
  jump -> bb1

bb13:
  jump -> bb2
}

fn main() -> I32 {
bb0:
  %0: I32 = const 9
  %1: I32 = const 3
  %2: I32 = call nestedBreaks borrow.shared %0 borrow.shared %1
  %3: I32 = const 4
  %4: I32 = const 2
  %5: I32 = call nestedBreaks borrow.shared %3 borrow.shared %4
  %6: I32 = const 10
  %7: I32 = mul inspect %5 inspect %6
  %8: I32 = add inspect %2 inspect %7
  %9: I32 = const 10
  %10: I32 = const 7
  %11: I32 = const 3
  %12: I32 = call firstOverBoth borrow.shared %9 borrow.shared %10 borrow.shared %11
  %13: I32 = const 100
  %14: I32 = mul inspect %12 inspect %13
  %15: I32 = add inspect %8 inspect %14
  %16: I32 = const 10
  %17: I32 = const 4
  %18: I32 = call firstOver borrow.shared %16 borrow.shared %17
  %19: I32 = const 1000
  %20: I32 = mul inspect %18 inspect %19
  %21: I32 = add inspect %15 inspect %20
  %22: I32 = const 5
  %23: I32 = const 8
  %24: I32 = call bothBounds borrow.shared %22 borrow.shared %23
  %25: I32 = const 10000
  %26: I32 = mul inspect %24 inspect %25
  %27: I32 = add inspect %21 inspect %26
  return take %27
}

entry main
