let image$base: () = <none>

let &seed: I32 = 3

fn doubled(%v: Vec(I32)) -> Vec(I32) {
  b0:
    %v1 = add %v, %v : Vec(I32)
    ret %v1
}

fn scaled(%v: Vec(I32), %by: I32) -> Vec(I32) {
  b0:
    %v2 = vsplat %by : Vec(I32)
    %v3 = mul %v, %v2 : Vec(I32)
    ret %v3
}

fn combined(%a: Vec(I32), %b: Vec(I32), %c: Vec(I32), %d: Vec(I32)) -> I32 {
  b0:
    %v4 = add %a, %b : Vec(I32)
    %v7 = vlane %v4, 0 : I32
    %v8 = add %c, %d : Vec(I32)
    %v11 = vlane %v8, 0 : I32
    %v12 = add %v7, %v11 : I32
    ret %v12
}

fn main() -> I32 {
  b0:
    %v0 = load seed : I32
    %base = vsplat %v0 : Vec(I32)
    %twice = call doubled, %base : Vec(I32)
    %six = call scaled, %base, 2 : Vec(I32)
    %v7 = vlane %twice, 0 : I32
    %v10 = cmp_ne %v7, 6 : Bool
    je %v10, b1, b2

  b1:
    ret -1

  b2:
    jmp b3

  b3:
    %v17 = vlane %six, 1 : I32
    %v20 = cmp_ne %v17, 6 : Bool
    je %v20, b4, b5

  b4:
    ret -2

  b5:
    jmp b6

  b6:
    %v27 = vsplat 1 : Vec(I32)
    %lanes = vreduce_add %v27 : I32
    %mixed = vwithlane %base, 10, 0 : Vec(I32)
    %v34 = vreduce_max %mixed : I32
    %v37 = cmp_ne %v34, 10 : Bool
    je %v37, b7, b8

  b7:
    ret -3

  b8:
    jmp b9

  b9:
    %v42 = vreduce_min %mixed : I32
    %v45 = cmp_ne %v42, 3 : Bool
    je %v45, b10, b11

  b10:
    ret -4

  b11:
    jmp b12

  b12:
    %total = alloc : Vec(I32)
    init %total, %base
    %i = alloc : I32
    init %i, 0
    jmp b13

  b13:
    %v56 = load %i : I32
    %v59 = cmp_lt %v56, 4 : Bool
    je %v59, b15, b14

  b14:
    %v70 = load %total : Vec(I32)
    %v73 = vlane %v70, 0 : I32
    %v76 = cmp_ne %v73, 15 : Bool
    je %v76, b16, b17

  b15:
    %v61 = load %total : Vec(I32)
    %v62 = add %v61, %base : Vec(I32)
    assign %total, %v62
    %v64 = load %i : I32
    %v67 = add %v64, 1 : I32
    assign %i, %v67
    jmp b13

  b16:
    ret -5

  b17:
    jmp b18

  b18:
    %v81 = load %total : Vec(I32)
    %v84 = vlane %v81, 1 : I32
    %v87 = cmp_ne %v84, 15 : Bool
    je %v87, b19, b20

  b19:
    ret -6

  b20:
    jmp b21

  b21:
    %v92 = load %total : Vec(I32)
    %v93 = vreduce_add %v92 : I32
    %v96 = mul %lanes, 15 : I32
    %v97 = cmp_ne %v93, %v96 : Bool
    je %v97, b22, b23

  b22:
    ret -7

  b23:
    jmp b24

  b24:
    %v102 = load %total : Vec(I32)
    %v103 = call combined, %base, %twice, %six, %v102 : I32
    %v108 = add 3, 6 : I32
    %v111 = add %v108, 6 : I32
    %v114 = add %v111, 15 : I32
    %v115 = cmp_ne %v103, %v114 : Bool
    je %v115, b25, b26

  b25:
    ret -8

  b26:
    jmp b27

  b27:
    %above = cmp_gt %mixed, %base : Mask(I32)
    %v121 = vreduce_add %above : I32
    %v124 = cmp_ne %v121, 1 : Bool
    je %v124, b28, b29

  b28:
    ret -9

  b29:
    jmp b30

  b30:
    %v129 = vreduce_or %above : Bool
    %v131 = xor %v129, True : Bool
    je %v131, b31, b32

  b31:
    ret -10

  b32:
    jmp b33

  b33:
    %v136 = vreduce_and %above : Bool
    je %v136, b34, b35

  b34:
    ret -11

  b35:
    jmp b36

  b36:
    %v143 = vsplat 7 : Vec(I32)
    %v146 = vsplat 2 : Vec(I32)
    %picked = select %above ? %v143 : %v146 : Vec(I32)
    %v150 = vlane %picked, 0 : I32
    %v153 = cmp_ne %v150, 7 : Bool
    je %v153, b37, b38

  b37:
    ret -12

  b38:
    jmp b39

  b39:
    %v160 = vlane %picked, 1 : I32
    %v163 = cmp_ne %v160, 2 : Bool
    je %v163, b40, b41

  b40:
    ret -13

  b41:
    jmp b42

  b42:
    %v172 = vwithlane %base, 10, 1 : Vec(I32)
    %v173 = cmp_gt %v172, %base : Mask(I32)
    %v174 = vreduce_first %v173 : I32
    %v177 = cmp_ne %v174, 1 : Bool
    je %v177, b43, b44

  b43:
    ret -14

  b44:
    jmp b45

  b45:
    %v182 = cmp_lt %mixed, %base : Mask(I32)
    %v183 = vreduce_first %v182 : I32
    %v184 = cmp_ne %v183, %lanes : Bool
    je %v184, b46, b47

  b46:
    ret -15

  b47:
    jmp b48

  b48:
    %v189 = cmp_ge %mixed, %base : Mask(I32)
    %v190 = vreduce_first %v189 : I32
    %v193 = cmp_ne %v190, 0 : Bool
    je %v193, b49, b50

  b49:
    ret -16

  b50:
    jmp b51

  b51:
    %v200 = vlane %twice, 1 : I32
    %v203 = mul %v200, 100 : I32
    %v206 = vlane %six, 0 : I32
    %v207 = add %v203, %v206 : I32
    %v210 = vlane %mixed, 0 : I32
    %v211 = add %v207, %v210 : I32
    ret %v211
}
