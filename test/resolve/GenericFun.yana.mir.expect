module ResolveTest

data Pair(a, b) {first: a, second: b} drop derived reclaim derived

data Pair(Bool, I32) {first: Bool, second: I32} of Pair

data Pair(I32, Bool) {first: I32, second: Bool} of Pair

fn identity(value: a) -> a {
  form specialized
  slot #0 type a
bb0:
  %0: a = read take (value)
  return take %0
}

fn swap'2(value: Pair(a, b) [shared call]) -> Pair(b, a) {
  form specialized
  slot #0 type a
  slot #1 type b
  slot #2 class TrivialCopy(a)
  slot #3 class TrivialCopy(b)
bb0:
  %0: b = read copy.trivial (value.second)
  %1: a = read copy.trivial (value.first)
  %2: Pair(b, a) = aggregate.Pair take %0 take %1
  return take %2
}

fn leftOf(value: Pair(a, b) [shared call]) -> a {
  form specialized
  slot #0 type a
  slot #1 type b
  slot #2 class TrivialCopy(a)
bb0:
  %0: a = read copy.trivial (value.first)
  return take %0
}

fn smaller(x: a, y: a) -> a {
  form specialized
  slot #0 type a
  slot #1 class Ord(a)
bb0:
  %0: a [shared call] = read borrow.shared (x) loan0
  %1: a [shared call] = read borrow.shared (y) loan1
  %2: Bool = call <(a) borrow.shared %0 borrow.shared %1
  branch inspect %2 -> bb3 -> bb1

bb1:
  drop (x)
  %5: a = read take (y)
  jump -> bb2(take %5)

bb2(%6: a):
  return take %6

bb3:
  drop (y)
  %4: a = read take (x)
  jump -> bb2(take %4)
}

fn twice(x: a [shared call]) -> a {
  form specialized
  slot #0 type a
  slot #1 class Num(a)
bb0:
  %0: a [shared call] = read borrow.shared (x) loan0
  %1: a [shared call] = read borrow.shared (x) loan1
  %2: a = call +(a) borrow.shared %0 borrow.shared %1
  return take %2
}

fn middle(x: a, y: a, z: a) -> a {
  form specialized
  slot #0 type a
  slot #1 class Ord(a)
bb0:
  %0: a = read take (x)
  %1: a = read take (y)
  %2: a = call smaller(a) take %0 take %1
  %3: a = read take (z)
  %4: a = call smaller(a) take %2 take %3
  return take %4
}

fn orElse(value: Maybe(a), fallback: a) -> a {
  form specialized
  slot #0 type a
  local inner: a object0

bb0:
  %0: U8 = read copy.trivial (value.#)
  %1: U8 = const 1
  %2: Bool = eq inspect %0 inspect %1
  branch inspect %2 -> bb3 -> bb1

bb1:
  drop (value)
  %7: a = read take (fallback)
  jump -> bb2(take %7)

bb2(%8: a):
  return take %8

bb3:
  drop (fallback)
  %4: a = read take (value.Just)
  write.init borrow.unique (inner) take %4
  %6: a = read take (inner)
  jump -> bb2(take %6)
}

fn wrap(value: a) -> Maybe(a) {
  form specialized
  slot #0 type a
bb0:
  %0: a = read take (value)
  %1: Maybe(a) = aggregate.Just take %0
  return take %1
}

fn empty'2() -> Maybe(a) {
  form specialized
  slot #0 type a
bb0:
  %0: Maybe(a) = aggregate.Nothing
  return take %0
}

fn orElseKept(value: Maybe(a), fallback: a) -> a {
  form specialized
  slot #0 type a
  local inner: a object0

bb0:
  %0: U8 = read copy.trivial (value.#)
  %1: U8 = const 1
  %2: Bool = eq inspect %0 inspect %1
  branch inspect %2 -> bb3 -> bb1

bb1:
  drop (value)
  %7: a = read take (fallback)
  jump -> bb2(take %7)

bb2(%8: a):
  return take %8

bb3:
  drop (fallback)
  %4: a = read take (value.Just)
  write.init borrow.unique (inner) take %4
  %6: a = read take (inner)
  jump -> bb2(take %6)
}

fn main() -> I32 {
bb0:
  %0: I32 = const 1
  %1: I32 = call identity(I32) take %0
  %2: Bool = const True
  %3: I32 = const 20
  %4: Pair(Bool, I32) = aggregate.Pair take %2 take %3
  %5: Pair(I32, Bool) = call swap'2(Bool, I32) borrow.shared %4
  %6: I32 = call leftOf(I32, Bool) borrow.shared %5
  %7: I32 = add inspect %1 inspect %6
  %8: I32 = const 3
  %9: I32 = call twice(I32) borrow.shared %8
  %10: I32 = add inspect %7 inspect %9
  %11: I32 = const 9
  %12: I32 = const 4
  %13: I32 = call smaller(I32) take %11 take %12
  %14: I32 = add inspect %10 inspect %13
  %15: I32 = const 30
  %16: I32 = const 8
  %17: I32 = const 12
  %18: I32 = call middle(I32) take %15 take %16 take %17
  %19: I32 = add inspect %14 inspect %18
  %20: I32 = const 5
  %21: Maybe(I32) = call wrap(I32) take %20
  %22: I32 = const 0
  %23: I32 = call orElse(I32) take %21 take %22
  %24: I32 = add inspect %19 inspect %23
  %25: Maybe(I32) = call empty'2(I32)
  %26: I32 = const 7
  %27: I32 = call orElse(I32) take %25 take %26
  %28: I32 = add inspect %24 inspect %27
  %29: I32 = const 6
  %30: Maybe(I32) = call wrap(I32) take %29
  %31: I32 = const 0
  %32: I32 = call orElseKept(I32) take %30 take %31
  %33: I32 = add inspect %28 inspect %32
  %34: Maybe(Bool) = call empty'2(Bool)
  %35: Bool = const True
  %36: Bool = call orElseKept(Bool) take %34 take %35
  branch inspect %36 -> bb3(take %33) -> bb1(take %33)

bb1(%37: I32):
  %41: I32 = const 0
  jump -> bb2(take %41, take %37)

bb2(%42: I32, %43: I32):
  %46: I32 = add inspect %43 inspect %42
  return take %46

bb3(%38: I32):
  %40: I32 = const 9
  jump -> bb2(take %40, take %38)
}

fn identity(I32)(value: I32) -> I32 = <identity at I32>

fn swap'2(Bool, I32)(value: Pair(Bool, I32) [shared call]) -> Pair(I32, Bool) = <swap at Bool, I32>

fn leftOf(I32, Bool)(value: Pair(I32, Bool) [shared call]) -> I32 = <leftOf at I32, Bool>

fn twice(I32)(x: I32 [shared call]) -> I32 = <twice at I32>

fn smaller(I32)(x: I32, y: I32) -> I32 = <smaller at I32>

fn middle(I32)(x: I32, y: I32, z: I32) -> I32 = <middle at I32>

fn wrap(I32)(value: I32) -> Maybe(I32) = <wrap at I32>

fn orElse(I32)(value: Maybe(I32), fallback: I32) -> I32 = <orElse at I32>

fn empty'2(I32)() -> Maybe(I32) = <empty at I32>

fn orElseKept(I32)(value: Maybe(I32), fallback: I32) -> I32 = <orElseKept at I32>

fn empty'2(Bool)() -> Maybe(Bool) = <empty at Bool>

fn orElseKept(Bool)(value: Maybe(Bool), fallback: Bool) -> Bool = <orElseKept at Bool>

entry main
