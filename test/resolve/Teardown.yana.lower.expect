@effects = [0, 0, 0, 0]
@heapFree = [0, 0, 0, 0, 0, 0, 0, 0]
@heapNext = [0, 0, 0, 0, 0, 0, 0, 0]
@heapLimit = [0, 0, 0, 0, 0, 0, 0, 0]
@released = [0, 0, 0, 0]

allocateHeap<complex>(%size: Long): Ptr {
  b_0 {
    %v_1 = load @heapFree, 8: Ptr
    %v_2 = bitcast %v_1: Long
    %v_3 = cmp_eq %v_2, 0: Int
    je %v_3, b_4, b_5
  }

  b_5 {
    jmp b_6
  }

  b_4 {
    %result = syscall 9, 0, 4194304, 3, 34, 18446744073709551615, 0: Long
    %v_7 = cmp_ilt %result, 0: Int
    je %v_7, b_8, b_9
  }

  b_9 {
    %v_10 = bitcast %result: Ptr
    jmp b_11
  }

  b_8 {
    %v_12 = bitcast 0: Ptr
    jmp b_11
  }

  b_11 {
    %region = phi [b_9, %v_10], [b_8, %v_12]: Ptr
    %v_13 = bitcast %region: Long
    %v_14 = cmp_eq %v_13, 0: Int
    je %v_14, b_15, b_16
  }

  b_16 {
    setpattern %region, 256, 0
    %v_17 = bitcast %region: Ptr
    store @heapFree, %v_17, 8
    %v_18 = add %region, 256: Ptr
    store @heapNext, %v_18, 8
    %v_19 = add %region, 4194304: Ptr
    store @heapLimit, %v_19, 8
    jmp b_20
  }

  b_15 {
    jmp b_20
  }

  b_20 {
    %v_21 = load @heapFree, 8: Ptr
    %v_22 = bitcast %v_21: Long
    %v_23 = cmp_eq %v_22, 0: Int
    je %v_23, b_24, b_25
  }

  b_25 {
    jmp b_6
  }

  b_6 {
    %v_26 = add %size, 8: Long
    jmp b_27
  }

  b_27 {
    %v_28 = phi [b_6, 16], [b_29, %v_30]: Long
    %v_31 = phi [b_6, 0], [b_29, %v_32]: Long
    %v_33 = cmp_ilt %v_28, %v_26: Int
    je %v_33, b_29, b_34
  }

  b_34 {
    %v_35 = cmp_ige %v_31, 32: Int
    je %v_35, b_36, b_37
  }

  b_37 {
    %v_38 = load @heapFree, 8: Ptr
    %v_39 = imul %v_31, 8: Long
    %v_40 = add %v_38, %v_39: Ptr
    %v_41 = load %v_40, 8: Ptr
    %v_42 = bitcast %v_41: Long
    %v_43 = cmp_eq %v_42, 0: Int
    %v_44 = xor %v_43, 1: Int
    je %v_44, b_45, b_46
  }

  b_46 {
    %block = load @heapNext, 8: Ptr
    %v_47 = shl 16, %v_31: Long
    %v_48 = add %block, %v_47: Ptr
    %v_49 = load @heapLimit, 8: Ptr
    %v_50 = cmp_gt %v_48, %v_49: Int
    je %v_50, b_51, b_52
  }

  b_52 {
    store @heapNext, %v_48, 8
    %v_53 = bitcast %block: Ptr
    store %v_53, %v_31, 8
    %v_54 = add %block, 8: Ptr
    ret %v_54
  }

  b_51 {
    %v_55 = bitcast 0: Ptr
    ret %v_55
  }

  b_45 {
    %v_56 = bitcast %v_41: Ptr
    %v_57 = load %v_56, 8: Ptr
    %v_58 = load @heapFree, 8: Ptr
    %v_59 = imul %v_31, 8: Long
    %v_60 = add %v_58, %v_59: Ptr
    store %v_60, %v_57, 8
    ret %v_41
  }

  b_36 {
    %v_61 = bitcast 0: Ptr
    ret %v_61
  }

  b_29 {
    %v_30 = add %v_28, %v_28: Long
    %v_32 = add %v_31, 1: Long
    jmp b_27
  }

  b_24 {
    %v_62 = bitcast 0: Ptr
    ret %v_62
  }
}

makeBuffer<complex>(%v_0: Ptr, %count: Int) {
  b_1 {
    %v_2 = imul %count, 8: Int
    %v_3 = sext %v_2: Long
    %v_4 = call_complex allocateHeap, %v_3: Ptr
    %cells = bitcast %v_4: Ptr
    %v_5 = alloca 12, 8: Ptr
    store %v_5, %cells, 8
    %v_6 = add %v_5, 8: Ptr
    store %v_6, %count, 4
    copy %v_0, %v_5, 12
    ret 
  }
}

useSession<complex>(%s: Ptr): Int {
  b_0 {
    %v_1 = add %s, 12: Ptr
    %v_2 = loads %v_1, 4: Int
    %v_3 = loads @effects, 4: Int
    %v_4 = add %v_3, %v_2: Int
    store @effects, %v_4, 4
    %v_5 = loads @released, 4: Int
    %v_6 = add %v_5, 1: Int
    store @released, %v_6, 4
    %v_7 = load %s, 8: Ptr
    %v_8 = bitcast %v_7: Ptr
    call_complex freeHeap, %v_8
    ret %v_2
  }
}

main<complex>(): Int {
  b_0 {
    %v_1 = alloca 16, 8: Ptr
    %v_2 = call_complex allocateHeap, 32: Ptr
    %cells = bitcast %v_2: Ptr
    %v_3 = alloca 12, 8: Ptr
    store %v_3, %cells, 8
    %v_4 = add %v_3, 8: Ptr
    store %v_4, 4, 4
    copy %v_1, %v_3, 12
    %v_5 = add %v_1, 12: Ptr
    store %v_5, 7, 4
    %session = alloca 16, 8: Ptr
    copy %session, %v_1, 16
    %used = call_complex useSession, %session: Int
    %v_6 = add %used, 35: Int
    %v_7 = loads @effects, 4: Int
    %v_8 = add %v_6, %v_7: Int
    %v_9 = loads @released, 4: Int
    %v_10 = sub %v_8, %v_9: Int
    ret %v_10
  }
}

freeHeap<complex>(%allocation: Ptr) {
  b_0 {
    %v_1 = bitcast %allocation: Long
    %v_2 = cmp_eq %v_1, 0: Int
    je %v_2, b_3, b_4
  }

  b_3 {
    ret 
  }

  b_4 {
    jmp b_5
  }

  b_5 {
    %v_6 = sub %allocation, 8: Ptr
    %v_7 = bitcast %v_6: Ptr
    %sizeClass = loads %v_7, 8: Long
    %v_8 = bitcast %allocation: Ptr
    %v_9 = load @heapFree, 8: Ptr
    %v_10 = imul %sizeClass, 8: Long
    %v_11 = add %v_9, %v_10: Ptr
    %v_12 = load %v_11, 8: Ptr
    store %v_8, %v_12, 8
    %v_13 = load @heapFree, 8: Ptr
    %v_14 = imul %sizeClass, 8: Long
    %v_15 = add %v_13, %v_14: Ptr
    store %v_15, %allocation, 8
    ret 
