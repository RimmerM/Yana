    %v_1 = loads %it, 4: I32
    %v_2 = add %it, 4: Ptr
    %v_3 = loads %v_2, 4: I32
    %v_4 = add %v_1, %v_3: I32
    ret %v_4
  }
}

bump<complex>(%it: Ptr) {
  b_0 {
    %v_1 = loads %it, 4: I32
    %v_2 = add %v_1, 1: I32
    store %it, %v_2, 4
