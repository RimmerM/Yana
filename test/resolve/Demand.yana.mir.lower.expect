mutableOnOneArm<complex>(%flag: I32): I32 {
  b_0 {
    %v_1 = alloca 1, 1: Ptr
    %v_2 = alloca 8, 4: Ptr
    store %v_1, %flag, 1
    %v_3 = alloca 8, 4: Ptr
    store %v_3, 1, 4
    %v_4 = add %v_3, 4: Ptr
    store %v_4, 2, 4
    copy %v_2, %v_3, 8
    %v_5 = load %v_1, 1: I32
    je %v_5, b_6, b_7
  }

  b_7 {
    jmp b_8
  }

  b_8 {
    %v_9 = alloca 8, 4: Ptr
    copy %v_9, %v_2, 8
    %v_10 = call_complex read, %v_9: I32
    ret %v_10
  }

  b_6 {
    call_complex bump, %v_2
