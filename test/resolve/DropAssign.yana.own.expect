fn +=(I64) {
  arg target writable
  arg amount readonly
  %target: I64 borrowed writable live [0, 3)
  %amount: I64 borrowed readonly live [0, 2)
  %local2: I64 readonly live [1, 3)
}

fn -=(I64) {
  arg target writable
  arg amount readonly
  %target: I64 borrowed writable live [0, 3)
  %amount: I64 borrowed readonly live [0, 2)
  %local2: I64 readonly live [1, 3)
}

fn initHeap {
}

fn heapClassOf {
  arg total readonly
  %size: I64 writable live [0, 8) [10, 18)
  %sizeClass: I64 writable live [2, 9) [10, 18)
}

fn heapBlockSize {
  arg sizeClass readonly
}

fn freeListHead {
  arg sizeClass readonly
  result escapes
}

fn setFreeListHead {
  arg sizeClass readonly
  arg block readonly
}

fn allocateHeap {
  arg size readonly
  result escapes
}

fn freeHeap {
  arg allocation readonly
}

fn mapMemory {
  arg size readonly
}

fn makeBuffer {
  arg size readonly
  result escapes
  %local0: Buffer droppable readonly live [3, 9)
}

fn firstByte {
  arg it readonly
  %it: Buffer borrowed droppable readonly live [0, 2)
}

fn whole {
  %local0: Buffer droppable readonly live [0, 3)
  %b: Buffer droppable writable live [1, 11)
  %local2: Buffer droppable readonly live [5, 7)
}

fn immediate {
  %local0: Buffer droppable readonly live [0, 3)
  %b: Buffer droppable writable live [1, 8)
  %local2: Buffer droppable readonly live [3, 5)
}

fn field {
  %h: Holder droppable writable live [0, 16)
  %local1: Buffer droppable readonly live [1, 3)
  %local2: Buffer droppable readonly live [6, 8)
}

fn replace {
  arg slot writable
  arg with readonly retained
  %slot: Buffer borrowed droppable writable live [0, 1)
  %with: Buffer droppable readonly escapes live [0, 1)
}

fn throughBorrow {
  %local0: Buffer droppable readonly live [0, 3)
  %b: Buffer droppable writable live [1, 11)
  %local2: Buffer droppable readonly live [4, 7)
}

fn afterMove {
  %local0: Buffer droppable readonly live [0, 3)
  %b: Buffer droppable writable live [1, 14)
  %local2: Buffer droppable readonly live [5, 11)
  %local3: Buffer droppable readonly live [7, 9)
}

fn main {
  %result: I64 writable live [0, 9) [11, 19) [21, 29) [31, 39) [41, 49) [51, 53)
}

fn Drop(Buffer).drop {
  arg value readonly
  %value: Buffer borrowed droppable readonly live [0, 2)
}

fn drop$Holder {
  arg value readonly
  %value: Holder borrowed droppable readonly live [0, 1)
}
