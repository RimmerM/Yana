data Box {value: I32, other: I32}

fn opaque(box: Box [unique call], to: I32 [shared call]) -> {} {
bb0:
  %0: I32 = read copy.trivial (to)
  write.assign borrow.unique (box.value) take %0
  return
}

fn recovered(box: Box [unique call], grow: Bool [shared call]) -> I32 {
