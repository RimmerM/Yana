fn weigh(%v: Vec(I32)) -> I32 {
  b0:
    %v3 = vlane %v, 0 : I32
    %v7 = vlane %v, 1 : I32
    %v9 = mul 2, %v7 : I32
    %v10 = add %v3, %v9 : I32
    %v14 = vlane %v, 2 : I32
    %v16 = mul 3, %v14 : I32
    %v17 = add %v10, %v16 : I32
    %v21 = vlane %v, 3 : I32
    %v23 = mul 4, %v21 : I32
    %v24 = add %v17, %v23 : I32
    ret %v24
