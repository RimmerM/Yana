    %v4 = load sink : Vec(I32)
    %v7 = vwithlane %v4, %a, 0 : Vec(I32)
    %v10 = vwithlane %v7, %b, 1 : Vec(I32)
    %v13 = vwithlane %v10, %c, 2 : Vec(I32)
    %v16 = vwithlane %v13, %d, 3 : Vec(I32)
