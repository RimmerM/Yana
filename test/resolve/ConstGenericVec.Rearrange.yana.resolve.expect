fn main() -> I32 {
  b0:
    %v = call four, 0, 1, 2, 3 : Vec(I32)
    %w = call four, 10, 11, 12, 13 : Vec(I32)
    %v10 = call rotated(4), %v : Vec(I32)
    %v11 = call weigh, %v10 : I32
    %v12 = call windowed(4), %v, %w : Vec(I32)
    %v13 = call weigh, %v12 : I32
    %v14 = add %v11, %v13 : I32
    %v15 = call mixedLow(4), %v, %w : Vec(I32)
    %v16 = call weigh, %v15 : I32
    %v17 = add %v14, %v16 : I32
    %v18 = call mixedHigh(4), %v, %w : Vec(I32)
    %v19 = call weigh, %v18 : I32
    %v20 = add %v17, %v19 : I32
    ret %v20
}

fn main$() -> I32 {
  b0:
    %v3 = vsplat 0 : Vec(I32)
    init sink, %v3
    %v5 = call main : I32
    ret %v5
}

