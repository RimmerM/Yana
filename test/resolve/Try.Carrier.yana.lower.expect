@image$base = []
mut @log = [0, 0, 0, 0]
mut @dropped = [0, 0, 0, 0]

Try(Maybe(a), a, ()).toOutcome(I32)<complex>(%v_0: Ptr, %value: Ptr) {
  b_1 {
    %v_2 = loads %value, 4: I32
    %v_3 = cmp_eq %v_2, 1: I32
    je %v_3, b_4, b_5
  }

  b_5 {
    %v_6 = alloca 8, 4: Ptr
    store %v_6, 1, 4
    jmp b_7
  }

  b_4 {
    %v_8 = add %value, 4: Ptr
    %v_9 = loads %v_8, 4: I32
    %v_10 = alloca 8, 4: Ptr
    store %v_10, 0, 4
    %v_11 = add %v_10, 4: Ptr
    store %v_11, %v_9, 4
    jmp b_7
  }

  b_7 {
    %v_12 = phi [b_4, %v_10], [b_5, %v_6]: Ptr
    copy %v_0, %v_12, 8
    ret 
  }
}

Try(Maybe(a), a, ()).toOutcome(Token)<complex>(%v_0: Ptr, %value: Ptr) {
  b_1 {
    %v_2 = loads %value, 4: I32
    %v_3 = cmp_eq %v_2, 1: I32
    je %v_3, b_4, b_5
  }

  b_5 {
    %v_6 = cmp_eq %v_2, 1: I32
    je %v_6, b_7, b_8
  }

  b_8 {
    jmp b_9
  }

  b_7 {
    %v_10 = loads @dropped, 4: I32
    %v_11 = add %v_10, 1: I32
    store @dropped, %v_11, 4
    jmp b_9
  }

  b_9 {
    %v_12 = alloca 8, 4: Ptr
    store %v_12, 1, 4
    jmp b_13
  }

  b_4 {
    %v_14 = add %value, 4: Ptr
    %inner = alloca 4, 4: Ptr
    copy %inner, %v_14, 4
    %v_15 = alloca 8, 4: Ptr
    store %v_15, 0, 4
    %v_16 = add %v_15, 4: Ptr
    copy %v_16, %inner, 4
    jmp b_13
  }

  b_13 {
    %v_17 = phi [b_4, %v_15], [b_9, %v_12]: Ptr
    copy %v_0, %v_17, 8
    ret 
  }
}

parse<complex>(%v_0: Ptr, %n: I32) {
  b_1 {
    %v_2 = loads @log, 4: I32
    %v_3 = add %v_2, 1: I32
    store @log, %v_3, 4
    %v_4 = cmp_igt %n, 0: I32
    je %v_4, b_5, b_6
  }

  b_5 {
    %v_7 = shl %n, 1: I32
    store %v_0, 1, 4
    %v_8 = add %v_0, 4: Ptr
    store %v_8, %v_7, 4
    ret 
  }

  b_6 {
    jmp b_9
  }

  b_9 {
    store %v_0, 0, 4
    ret 
  }
}

oneStep<complex>(%v_0: Ptr, %n: I32) {
  b_1 {
    %v_2 = alloca 8, 4: Ptr
    call_complex parse, %v_2, %n
    %v_3 = alloca 8, 4: Ptr
    call_complex Try(Maybe(a), a, ()).toOutcome(I32), %v_3, %v_2
    %v_4 = loads %v_3, 4: I32
    %v_5 = cmp_eq %v_4, 1: I32
    je %v_5, b_6, b_7
  }

  b_6 {
    %v_8 = alloca 1, 1: Ptr
    store %v_0, 0, 4
    ret 
  }

  b_7 {
    %v_9 = add %v_3, 4: Ptr
    %v = loads %v_9, 4: I32
    %v_10 = add %v, 1: I32
    store %v_0, 1, 4
    %v_11 = add %v_0, 4: Ptr
    store %v_11, %v_10, 4
    ret 
  }
}

twoSteps<complex>(%v_0: Ptr, %n: I32) {
  b_1 {
    %v_2 = alloca 8, 4: Ptr
    call_complex parse, %v_2, %n
    %v_3 = alloca 8, 4: Ptr
    call_complex Try(Maybe(a), a, ()).toOutcome(I32), %v_3, %v_2
    %v_4 = loads %v_3, 4: I32
    %v_5 = cmp_eq %v_4, 1: I32
    je %v_5, b_6, b_7
  }

  b_6 {
    %v_8 = alloca 1, 1: Ptr
    store %v_0, 0, 4
    ret 
  }

  b_7 {
    %v_9 = add %v_3, 4: Ptr
    %a = loads %v_9, 4: I32
    %v_10 = sub %a, 10: I32
    %v_11 = alloca 8, 4: Ptr
    call_complex parse, %v_11, %v_10
    %v_12 = alloca 8, 4: Ptr
    call_complex Try(Maybe(a), a, ()).toOutcome(I32), %v_12, %v_11
    %v_13 = loads %v_12, 4: I32
    %v_14 = cmp_eq %v_13, 1: I32
    je %v_14, b_15, b_16
  }

  b_15 {
    %v_17 = alloca 1, 1: Ptr
    store %v_0, 0, 4
    ret 
  }

  b_16 {
    %v_18 = add %v_12, 4: Ptr
    %b = loads %v_18, 4: I32
    %v_19 = add %a, %b: I32
    store %v_0, 1, 4
    %v_20 = add %v_0, 4: Ptr
    store %v_20, %v_19, 4
    ret 
  }
}

viaResult<complex>(%v_0: Ptr, %n: I32) {
  b_1 {
    %v_2 = loads @log, 4: I32
    %v_3 = add %v_2, 10: I32
    store @log, %v_3, 4
    %v_4 = cmp_igt %n, 9: I32
    je %v_4, b_5, b_6
  }

  b_6 {
    jmp b_7
  }

  b_5 {
    jmp b_8
  }

  b_8 {
    %v_9 = alloca 8, 4: Ptr
    store %v_9, 1, 4
    %v_10 = add %v_9, 4: Ptr
    store %v_10, 1, 4
    jmp b_11
  }

  b_7 {
    %v_12 = alloca 8, 4: Ptr
    store %v_12, 0, 4
    %v_13 = add %v_12, 4: Ptr
    store %v_13, %n, 4
    jmp b_11
  }

  b_11 {
    %v_14 = phi [b_7, %v_12], [b_8, %v_9]: Ptr
    %v_15 = load %v_14, 4: I32
    %v_16 = add %v_14, 4: Ptr
    %v_17 = load %v_16, 4: I32
    %v_18 = cmp_eq %v_15, 1: I32
    je %v_18, b_19, b_20
  }

  b_20 {
    %v_21 = add %v_17, 100: I32
    store %v_0, 1, 4
    %v_22 = add %v_0, 4: Ptr
    store %v_22, %v_21, 4
    ret 
  }

  b_19 {
    store %v_0, 0, 4
    %v_23 = add %v_0, 4: Ptr
    store %v_23, %v_17, 4
    ret 
  }
}

token<complex>(%v_0: Ptr, %n: I32) {
  b_1 {
    %v_2 = cmp_igt %n, 0: I32
    je %v_2, b_3, b_4
  }

  b_3 {
    %v_5 = alloca 8, 4: Ptr
    store %v_5, 1, 4
    %v_6 = add %v_5, 4: Ptr
    store %v_6, %n, 4
    jmp b_7
  }

  b_4 {
    %v_8 = alloca 8, 4: Ptr
    store %v_8, 0, 4
    jmp b_7
  }

  b_7 {
    %v_9 = phi [b_3, %v_5], [b_4, %v_8]: Ptr
    copy %v_0, %v_9, 8
    ret 
  }
}

bothTokens<complex>(%v_0: Ptr, %a: I32, %b: I32) {
  b_1 {
    %v_2 = alloca 8, 4: Ptr
    call_complex token, %v_2, %a
    %v_3 = alloca 8, 4: Ptr
    call_complex Try(Maybe(a), a, ()).toOutcome(Token), %v_3, %v_2
    %v_4 = loads %v_3, 4: I32
    %v_5 = cmp_eq %v_4, 1: I32
    je %v_5, b_6, b_7
  }

  b_8 {
    %v_9 = alloca 1, 1: Ptr
    store %v_0, 0, 4
    ret 
  }

  b_7 {
    %v_10 = add %v_3, 4: Ptr
    %v_11 = loads %v_10, 4: I32
    call_complex drop$Outcome(Token, ()), %v_3
    %v_12 = alloca 8, 4: Ptr
    call_complex token, %v_12, %b
    %v_13 = alloca 8, 4: Ptr
    call_complex Try(Maybe(a), a, ()).toOutcome(Token), %v_13, %v_12
    %v_14 = loads %v_13, 4: I32
    %v_15 = cmp_eq %v_14, 1: I32
    je %v_15, b_16, b_17
  }

  b_18 {
    %v_19 = alloca 1, 1: Ptr
    store %v_0, 0, 4
    ret 
  }

  b_17 {
    %v_20 = add %v_13, 4: Ptr
    %v_21 = loads %v_20, 4: I32
    call_complex drop$Outcome(Token, ()), %v_13
    %v_22 = add %v_11, %v_21: I32
    store %v_0, 1, 4
    %v_23 = add %v_0, 4: Ptr
    store %v_23, %v_22, 4
    ret 
  }

  b_6 {
    call_complex drop$Outcome(Token, ()), %v_3
    jmp b_8
  }

  b_16 {
    call_complex drop$Outcome(Token, ()), %v_13
    jmp b_18
  }
}

operands<complex>(%v_0: Ptr, %a: I32, %b: I32) {
  b_1 {
    %v_2 = alloca 8, 4: Ptr
    call_complex parse, %v_2, %a
    %v_3 = alloca 8, 4: Ptr
    call_complex Try(Maybe(a), a, ()).toOutcome(I32), %v_3, %v_2
    %v_4 = loads %v_3, 4: I32
    %v_5 = cmp_eq %v_4, 1: I32
    je %v_5, b_6, b_7
  }

  b_6 {
    %v_8 = alloca 1, 1: Ptr
    store %v_0, 0, 4
    ret 
  }

  b_7 {
    %v_9 = add %v_3, 4: Ptr
    %v_10 = loads %v_9, 4: I32
    %v_11 = alloca 8, 4: Ptr
    call_complex parse, %v_11, %b
    %v_12 = alloca 8, 4: Ptr
    call_complex Try(Maybe(a), a, ()).toOutcome(I32), %v_12, %v_11
    %v_13 = loads %v_12, 4: I32
    %v_14 = cmp_eq %v_13, 1: I32
    je %v_14, b_15, b_16
  }

  b_15 {
    %v_17 = alloca 1, 1: Ptr
    store %v_0, 0, 4
    ret 
  }

  b_16 {
    %v_18 = add %v_12, 4: Ptr
    %v_19 = loads %v_18, 4: I32
    %v_20 = add %v_10, %v_19: I32
    store %v_0, 1, 4
    %v_21 = add %v_0, 4: Ptr
    store %v_21, %v_20, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    store @log, 0, 4
    store @dropped, 0, 4
    %v_1 = alloca 8, 4: Ptr
    call_complex oneStep, %v_1, 3
    %v_2 = loads %v_1, 4: I32
    %v_3 = cmp_eq %v_2, 1: I32
    %v_4 = add %v_1, 4: Ptr
    %v = loads %v_4, 4: I32
    %v_5 = select %v_3, %v, 0: I32
    %v_6 = alloca 8, 4: Ptr
    call_complex oneStep, %v_6, 18446744073709551615
    %v_7 = loads %v_6, 4: I32
    %v_8 = cmp_eq %v_7, 1: I32
    %v_9 = add %v_6, 4: Ptr
    %v = loads %v_9, 4: I32
    %v_10 = select %v_8, %v, 0: I32
    %v_11 = alloca 8, 4: Ptr
    call_complex twoSteps, %v_11, 11
    %v_12 = loads %v_11, 4: I32
    %v_13 = cmp_eq %v_12, 1: I32
    %v_14 = add %v_11, 4: Ptr
    %v = loads %v_14, 4: I32
    %v_15 = select %v_13, %v, 0: I32
    %v_16 = alloca 8, 4: Ptr
    call_complex twoSteps, %v_16, 3
    %v_17 = loads %v_16, 4: I32
    %v_18 = cmp_eq %v_17, 1: I32
    %v_19 = add %v_16, 4: Ptr
    %v = loads %v_19, 4: I32
    %v_20 = select %v_18, %v, 0: I32
    %v_21 = alloca 8, 4: Ptr
    call_complex viaResult, %v_21, 4
    %v_22 = loads %v_21, 4: I32
    %v_23 = cmp_eq %v_22, 1: I32
    %v_24 = add %v_21, 4: Ptr
    %v = loads %v_24, 4: I32
    %v_25 = sub 0, %v: I32
    %v_26 = select %v_23, %v, %v_25: I32
    %v_27 = alloca 8, 4: Ptr
    call_complex viaResult, %v_27, 20
    %v_28 = loads %v_27, 4: I32
    %v_29 = cmp_eq %v_28, 1: I32
    %v_30 = add %v_27, 4: Ptr
    %v = loads %v_30, 4: I32
    %v_31 = sub 0, %v: I32
    %v_32 = select %v_29, %v, %v_31: I32
    %v_33 = alloca 8, 4: Ptr
    call_complex bothTokens, %v_33, 1, 2
    %v_34 = loads %v_33, 4: I32
    %v_35 = cmp_eq %v_34, 1: I32
    %v_36 = add %v_33, 4: Ptr
    %v = loads %v_36, 4: I32
    %v_37 = select %v_35, %v, 0: I32
    %v_38 = alloca 8, 4: Ptr
    call_complex bothTokens, %v_38, 1, 18446744073709551615
    %v_39 = loads %v_38, 4: I32
    %v_40 = cmp_eq %v_39, 1: I32
    %v_41 = add %v_38, 4: Ptr
    %v = loads %v_41, 4: I32
    %v_42 = select %v_40, %v, 0: I32
    %v_43 = alloca 8, 4: Ptr
    call_complex operands, %v_43, 1, 2
    %v_44 = loads %v_43, 4: I32
    %v_45 = cmp_eq %v_44, 1: I32
    %v_46 = add %v_43, 4: Ptr
    %v = loads %v_46, 4: I32
    %v_47 = select %v_45, %v, 0: I32
    %v_48 = alloca 8, 4: Ptr
    call_complex operands, %v_48, 1, 18446744073709551614
    %v_49 = loads %v_48, 4: I32
    %v_50 = cmp_eq %v_49, 1: I32
    %v_51 = add %v_48, 4: Ptr
    %v = loads %v_51, 4: I32
    %v_52 = select %v_50, %v, 0: I32
    %v_53 = add %v_5, %v_10: I32
    %v_54 = add %v_53, %v_15: I32
    %v_55 = add %v_54, %v_20: I32
    %v_56 = add %v_55, %v_26: I32
    %v_57 = add %v_56, %v_32: I32
    %v_58 = add %v_57, %v_37: I32
    %v_59 = add %v_58, %v_42: I32
    %v_60 = add %v_59, %v_47: I32
    %v_61 = add %v_60, %v_52: I32
    %v_62 = loads @dropped, 4: I32
    %v_63 = imul %v_62, 1000: I32
    %v_64 = add %v_61, %v_63: I32
    %v_65 = loads @log, 4: I32
    %v_66 = imul %v_65, 100000: I32
    %v_67 = add %v_64, %v_66: I32
    ret %v_67
  }
}

drop$Outcome(Token, ())<complex>(%value: Ptr) {
  b_0 {
    %v_1 = loads %value, 4: I32
    %v_2 = cmp_eq %v_1, 0: I32
    je %v_2, b_3, b_4
  }

  b_5 {
    ret 
  }

  b_3 {
    %v_6 = loads @dropped, 4: I32
    %v_7 = add %v_6, 1: I32
    store @dropped, %v_7, 4
    jmp b_5
  }

  b_4 {
    jmp b_5
  }
}

