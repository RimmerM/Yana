    %v_9 = cmp_ilt %v_2, 20: I32
    %v_10 = xor %v_7, 1: I32
    %v_11 = and %v_9, %v_10: I32
    je %v_11, b_12, b_13
  }

  b_13 {
    %v_14 = add %v_5, 1000: I32
    %v_15 = select %v_7, %v_5, %v_14: I32
    ret %v_15
  }

  b_12 {
    %v_16 = imulhi %v_2, 1431655766: I32
    %v_17 = shr %v_16, 31: I32
    %v_18 = add %v_16, %v_17: I32
    %v_19 = imul %v_18, 3: I32
    %v_20 = sub %v_2, %v_19: I32
    %v_21 = cmp_eq %v_20, 0: I32
    je %v_21, b_22, b_23
  }

  b_23 {
    %v_24 = imulhi %v_2, 1717986919: I32
    %v_25 = sar %v_24, 1: I32
    %v_26 = shr %v_25, 31: I32
    %v_27 = add %v_25, %v_26: I32
    %v_28 = imul %v_27, 5: I32
    %v_29 = sub %v_2, %v_28: I32
    %v_30 = cmp_eq %v_29, 0: I32
    je %v_30, b_22, b_31
  }

  b_22 {
    %v_32 = add %v_5, %v_2: I32
