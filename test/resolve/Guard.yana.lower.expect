@image$base = []

onlyRed<complex>(%m: Ptr): I32 {
  b_0 {
    %v_1 = load %m, 1: I64
    %v_2 = cmp_le %v_1, 2: I32
    je %v_2, b_3, b_4
  }

  b_4 {
    %v_5 = cmp_le %v_1, 2: I32
    je %v_5, b_6, b_7
  }

  b_3 {
    %v_8 = load %m, 1: I32
    %v_9 = cmp_eq %v_8, 0: I32
    je %v_9, b_10, b_4
  }

  b_10 {
    ret 10
  }

  b_7 {
    %v_11 = cmp_le %v_1, 2: I32
    je %v_11, b_12, b_13
  }

  b_6 {
