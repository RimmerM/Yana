firstJust<complex>(%a: Ptr, %b: Ptr): I32 {
  b_0 {
    %v_1 = loads %a, 4: I32
    %v_2 = cmp_eq %v_1, 1: I32
    je %v_2, b_3, b_4
  }

  b_4 {
    %v_5 = loads %b, 4: I32
    %v_6 = cmp_eq %v_5, 1: I32
    %v_7 = add %b, 4: Ptr
    %second = loads %v_7, 4: I32
    %v_8 = select %v_6, %second, 0: I32
    ret %v_8
  }

  b_3 {
    %v_9 = add %a, 4: Ptr
    %first = loads %v_9, 4: I32
    ret %first
  }
}

retry<complex>(%m: Ptr, %c: I32): I32 {
  b_0 {
    %v_1 = loads %m, 4: I32
    %v_2 = cmp_eq %v_1, 1: I32
    %v_3 = cmp_eq %c, 0: I32
    %v_4 = cmp_eq %c, 1: I32
    jmp b_5
  }

  b_6 {
    ret 50
  }

  b_5 {
    je %v_2, b_7, b_8
  }

  b_8 {
    je %v_3, b_6, b_9
  }

  b_7 {
    %v_10 = add %m, 4: Ptr
    %v = loads %v_10, 4: I32
    %v_11 = add %v, 1: I32
    ret %v_11
  }

  b_9 {
    je %v_4, b_12, b_5
  }

  b_12 {
    ret 100
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 1, 1: Ptr
    store %v_1, 0, 1
    %v_2 = call_complex onlyRed, %v_1: I32
    %v_3 = add %v_2, 11: I32
