module ResolveTest

data Metres {value: I32}

data Feet {value: I32}

class Describe(a): size, doubled

instance Describe(Metres): Metres.size, Metres.doubled

instance Describe(Feet): Feet.size, Feet.doubled

instance Eq(Metres): Metres.==, Metres.!=

fn size(value: a [shared call]) -> I32 = <no body>

fn doubled(value: a [shared call]) -> a = <no body>

fn Metres.size(value: Metres [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (value.value)
  return take %0
}

fn Metres.doubled(value: Metres [shared call]) -> Metres {
bb0:
  %0: I32 = read copy.trivial (value.value)
  %1: I32 = const 2
  %2: I32 = mul inspect %0 inspect %1
  %3: Metres = aggregate.Metres take %2
  return take %3
}

fn Feet.size(value: Feet [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (value.value)
  return take %0
}

fn Feet.doubled(value: Feet [shared call]) -> Feet {
bb0:
  %0: I32 = read copy.trivial (value.value)
  %1: I32 = read copy.trivial (value.value)
  %2: I32 = add inspect %0 inspect %1
  %3: Feet = aggregate.Feet take %2
  return take %3
}

fn metreSize() -> I32 {
bb0:
  %0: I32 = const 7
  %1: Metres = aggregate.Metres take %0
  %2: I32 = call size(Metres) borrow.shared %1
  return take %2
}

fn feetSize() -> I32 {
bb0:
  %0: I32 = const 5
  %1: Feet = aggregate.Feet take %0
  %2: I32 = call size(Feet) borrow.shared %1
  return take %2
}

fn doubledMetres() -> I32 {
bb0:
  %0: I32 = const 3
  %1: Metres = aggregate.Metres take %0
  %2: Metres = call doubled(Metres) borrow.shared %1
  %3: I32 = call size(Metres) borrow.shared %2
  return take %3
}

fn Metres.==(lhs: Metres [shared call], rhs: Metres [shared call]) -> Bool {
bb0:
  %0: I32 = read copy.trivial (lhs.value)
  %1: I32 = read copy.trivial (rhs.value)
  %2: Bool = eq inspect %0 inspect %1
  return take %2
}

fn Metres.!=(lhs: Metres [shared call], rhs: Metres [shared call]) -> Bool {
bb0:
  %0: I32 = read copy.trivial (lhs.value)
  %1: I32 = read copy.trivial (rhs.value)
  %2: Bool = ne inspect %0 inspect %1
  return take %2
}

fn sameMetres(a: I32 [shared call], b: I32 [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (a)
  %1: Metres = aggregate.Metres take %0
  %2: I32 = read copy.trivial (b)
  %3: Metres = aggregate.Metres take %2
  %4: Bool = call ==(Metres) borrow.shared %1 borrow.shared %3
  branch inspect %4 -> bb3 -> bb1

bb1:
  %7: I32 = const 0
  jump -> bb2(take %7)

bb2(%8: I32):
  return take %8

bb3:
  %6: I32 = const 1
  jump -> bb2(take %6)
}

fn main() -> I32 {
bb0:
  %0: I32 = call metreSize
  %1: I32 = call feetSize
  %2: I32 = add inspect %0 inspect %1
  %3: I32 = call doubledMetres
  %4: I32 = add inspect %2 inspect %3
  %5: I32 = const 4
  %6: I32 = const 4
  %7: I32 = call sameMetres borrow.shared %5 borrow.shared %6
  %8: I32 = add inspect %4 inspect %7
  %9: I32 = const 4
  %10: I32 = const 5
  %11: I32 = call sameMetres borrow.shared %9 borrow.shared %10
  %12: I32 = add inspect %8 inspect %11
  return take %12
}

entry main
