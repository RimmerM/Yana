module ResolveTest

data Box {n: I32}

lens fn chunks'2(b: Box [shared call], $body: (I32) -> I32 [shared call]) -> I32 {
  local & $yielded: I32

bb0:
  %0: I32 = const 0
  write.init borrow.unique ($yielded) take %0
  %2: I32 = read copy.trivial ($yielded)
  %3: I32 = const 0
  %4: Bool = eq inspect %2 inspect %3
  branch inspect %4 -> bb1 -> bb2

bb1:
  %6: I32 = read copy.trivial (b.n)
  %7: (I32) -> I32 [shared call] = read borrow.shared ($body) loan0
  %8: I32 = call inspect %7 borrow.shared %6
  write.assign borrow.unique ($yielded) take %8
  jump -> bb3

bb2:
  jump -> bb3

bb3:
  %12: I32 = read copy.trivial ($yielded)
  %13: I32 = const 0
  %14: Bool = eq inspect %12 inspect %13
  branch inspect %14 -> bb4 -> bb5

bb4:
  %16: I32 = read copy.trivial (b.n)
  %17: I32 = const 1
  %18: I32 = add inspect %16 inspect %17
  %19: (I32) -> I32 [shared call] = read borrow.shared ($body) loan1
  %20: I32 = call inspect %19 borrow.shared %18
  write.assign borrow.unique ($yielded) take %20
  jump -> bb6

bb5:
  jump -> bb6

bb6:
  %24: I32 = read copy.trivial ($yielded)
  return take %24
}

fn main() -> I32 {
  local & total: I32
  local v: I32 [shared call]
  local & local2: Array(I32) object2
  local xs: Array(I32) object2
  local part: Array(I32) [shared call view]

bb0:
  %0: I32 = const 0
  write.init borrow.unique (total) take %0
  %2: I32 = const 7
  %3: Box = aggregate.Box take %2
  lens.call chunks'2 borrow.shared %3 -> bb2

bb1:
  %12: I32 = const 10
  %13: I32 = const 20
  %14: I32 = const 30
  %15: %I32 = run.slots I32 *3
  %16: Size = bitcast inspect %15
  %17: Size = const 0
  %18: Bool = eq inspect %16 inspect %17
  %19: {} = call checkCondition borrow.shared %18
  %20: @bits(30) U32 = const 3
  %21: @bits(2) U32 = const 1
  %22: Run(I32) = aggregate.Run take %15 take %20 take %21
  %23: @bits(30) U32 = const 3
  %24: Array(I32) = aggregate.Array take %22 take %23
  write.init borrow.unique (local2) take %24
  %26: Size = const 0
  write.init borrow.unique ([%%15][0]) take %12
  %28: Size = const 1
  write.init borrow.unique ([%%15][1]) take %13
  %30: Size = const 2
  write.init borrow.unique ([%%15][2]) take %14
  %32: Array(I32) = read take (local2)
  write.init borrow.unique (xs) take %32
  %34: Array(I32) [shared call] = read borrow.shared (xs) loan0
  %35: Array(I32) [shared slot 0 view] = call.derivation elements(Array(I32), I32) borrow.shared %34 roots{0}
  lens.call chunks(Array(I32), I32) borrow.shared %35 -> bb4

bb2(%4: I32 [shared call]) handover(I32 [shared call]) many -> bb1:
  write.init borrow.unique (v) borrow.shared %4
  %7: I32 = read copy.trivial (total)
  %8: I32 = read copy.trivial (v)
  %9: I32 = add inspect %7 inspect %8
  write.assign borrow.unique (total) take %9
  jump -> bb1

bb3:
  drop (xs)
  %46: I32 = read copy.trivial (total)
  return take %46

bb4(%36: Array(I32) [shared call view]) handover(Array(I32) [shared call view]) many -> bb3:
  write.init borrow.unique (part) borrow.shared %36
  %39: I32 = read copy.trivial (total)
  %40: Array(I32) [shared call view] = read borrow.shared (part) loan1 roots{0}
  %41: Size = call length(Array(I32)) borrow.shared %40
  %42: I32 = convert inspect %41
  %43: I32 = add inspect %39 inspect %42
  write.assign borrow.unique (total) take %43
  jump -> bb3
}

entry main
