    %v2 = add %a, %b : Int
    %v5 = mul %v2, 2 : Int
    %v6 = sub %a, %b : Int
    %v9 = mul %v6, 3 : Int
    %v10 = add %v5, %v9 : Int
    %v13 = mul %a, 5 : Int
