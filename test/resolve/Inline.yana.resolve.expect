fn onlyCaller(%a: I32, %b: I32, %c: I32) -> I32 {
  b0:
    %p = call makePoint, %a, %b : Point
    %q = call makePoint, %b, %c : Point
    %v5 = load %local0@Point.x : I32
    %v6 = load %local1@Point.y : I32
    %v7 = mul %v5, %v6 : I32
    %v8 = load %local0@Point.y : I32
