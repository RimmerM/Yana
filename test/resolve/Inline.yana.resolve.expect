    %v5 = mul %v2, 2 : I32
    %v6 = sub %a, %b : I32
    %v9 = mul %v6, 3 : I32
    %v10 = add %v5, %v9 : I32
    %v13 = mul %a, 5 : I32
    %v14 = add %v10, %v13 : I32
    %v17 = mul %b, 7 : I32
    %v18 = add %v14, %v17 : I32
    %v21 = mul %v18, 2 : I32
    %v22 = add %v21, %a : I32
    %v23 = sub %v22, %b : I32
