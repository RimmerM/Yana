fn stepsTo(%limit: I32) -> I32 {
  b0:
    %value = alloc : I32
    init %value, 1
    %steps = alloc : I32
    init %steps, 0
    jmp b1

  b1:
    %v8 = load %value : I32
    %v9 = cmp_lt %v8, %limit : Bool
    je %v9, b3, b2

  b2:
    %v21 = load %steps : I32
    ret %v21

  b3:
    %v11 = load %value : I32
    %v12 = load %value : I32
    %v13 = add %v11, %v12 : I32
    assign %value, %v13
    %v15 = load %steps : I32
    %v18 = add %v15, 1 : I32
