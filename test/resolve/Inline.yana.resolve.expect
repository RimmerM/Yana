fn constructed(%a: Int) -> Int {
  b0:
    %v3 = add %a, 1 : Int
    %p = call makePoint, %a, %v3 : Point
    %v5 = load %local0@Point.x : Int
    %v6 = load %local0@Point.y : Int
    %v7 = add %v5, %v6 : Int
