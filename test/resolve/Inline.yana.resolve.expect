fn graded(%score: I32) -> I32 {
  b0:
    %v3 = cmp_lt %score, 10 : Bool
    je %v3, b1, b2

  b1:
    jmp b5

  b2:
    %v8 = cmp_lt %score, 100 : Bool
    je %v8, b3, b4

  b3:
    jmp b5

  b4:
    jmp b5

  b5:
    %v15 = phi [b1, 1], [b3, 2], [b4, 3] : I32
