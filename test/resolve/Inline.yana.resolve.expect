fn main() -> Int {
  b0:
    %v0 = call constants : Int
    %v3 = call unknowns, 2, 3 : Int
    %v4 = add %v0, %v3 : Int
    %v6 = call constructed, 5 : Int
    %v7 = add %v4, %v6 : Int
    %v9 = call mutated, 7 : Int
    %v10 = add %v7, %v9 : Int
    %v12 = call branching, 50 : Int
    %v13 = add %v10, %v12 : Int
    %v14 = call recursive : Int
