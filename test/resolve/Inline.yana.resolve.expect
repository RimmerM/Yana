  b0:
    %p = call makePoint, %a, %b : Point
    %q = call makePoint, %b, %c : Point
    %v5 = load %local0@Point.x : Int
    %v6 = load %local1@Point.y : Int
    %v7 = mul %v5, %v6 : Int
