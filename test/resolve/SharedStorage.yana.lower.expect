@image$base = []
@released = [0, 0, 0, 0]

+=(Int)<complex>(%target: Ptr, %amount: Int) {
  b_0 {
    %v_1 = loads %target, 4: Int
    %v_2 = add %v_1, %amount: Int
    store %target, %v_2, 4
    ret 
  }
}

main<complex>(): Int {
  b_0 {
    %o = alloca 8, 4: Ptr
    store %o, 1, 4
    %v_1 = add %o, 4: Ptr
    store %v_1, 36, 4
    call_complex +=(Int), @released, 1
    %v_2 = loads @released, 4: Int
