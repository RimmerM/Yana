@image$base = []
mut @heapNext = [0, 0, 0, 0, 0, 0, 0, 0]
mut @heapLimit = [0, 0, 0, 0, 0, 0, 0, 0]
mut @heapFree = [0, 0, 0, 0, 0, 0, 0, 0]
mut @heapRegionNext = [0, 0, 0, 0, 0, 0, 0, 0]
mut @live = [0, 0, 0, 0, 0, 0, 0, 0]

+=(I64)<complex>(%target: Ptr, %amount: I64) {
  b_0 {
    %v_1 = loads %target, 8: I64
    %v_2 = add %v_1, %amount: I64
    store %target, %v_2, 8
    ret 
  }
}

-=(I64)<complex>(%target: Ptr, %amount: I64) {
  b_0 {
    %v_1 = loads %target, 8: I64
    %v_2 = sub %v_1, %amount: I64
    store %target, %v_2, 8
    ret 
  }
}

mapMemory<complex>(%size: I64): Ptr {
  b_0 {
    %result = syscall 9, 0, %size, 3, 34, 18446744073709551615, 0: I64
    %v_1 = cmp_ilt %result, 0: I32
    je %v_1, b_2, b_3
  }

  b_2 {
    %v_4 = bitcast 0: Ptr
    ret %v_4
  }

  b_3 {
    %v_5 = bitcast %result: Ptr
    ret %v_5
  }
}

initHeap<complex>() {
  b_0 {
    %result = syscall 9, 0, 4198400, 3, 34, 18446744073709551615, 0: I64
    %v_1 = cmp_ilt %result, 0: I32
    %v_2 = bitcast 0: Ptr
    %v_3 = bitcast %result: Ptr
    %region = select %v_1, %v_2, %v_3: Ptr
    %v_4 = bitcast %region: I64
    %v_5 = cmp_eq %v_4, 0: I32
    je %v_5, b_6, b_7
  }

  b_7 {
    setpattern %region, 256, 0
    store @heapFree, %region, 8
    %v_8 = add %region, 256: Ptr
    store @heapNext, %v_8, 8
    %v_9 = add %region, 4194304: Ptr
    store @heapLimit, %v_9, 8
    store @heapRegionNext, 8388608, 8
    ret 
  }

  b_6 {
    ret 
  }
}

growHeap<complex>(%needed: I64): I32 {
  b_0 {
    %v_1 = loads @heapRegionNext, 8: I64
    %v_2 = cmp_ilt %v_1, %needed: I32
    je %v_2, b_3, b_4
  }

  b_3 {
    jmp b_5
  }

  b_4 {
    jmp b_5
  }

  b_5 {
    %v_6 = phi [b_3, %needed], [b_4, %v_1]: I64
    %v_7 = add %v_6, 4096: I64
    %v_8 = call_complex mapMemory, %v_7: Ptr
    %v_9 = bitcast %v_8: I64
    %v_10 = cmp_eq %v_9, 0: I32
    je %v_10, b_11, b_12
  }

  b_11 {
    %v_13 = cmp_igt %needed, 4194304: I32
    %least = select %v_13, %needed, 4194304: I64
    %v_14 = cmp_ige %least, %v_6: I32
    je %v_14, b_15, b_16
  }

  b_12 {
    jmp b_17
  }

  b_15 {
    ret 0
  }

  b_16 {
    %v_18 = add %least, 4096: I64
    %v_19 = call_complex mapMemory, %v_18: Ptr
    %v_20 = bitcast %v_19: I64
    %v_21 = cmp_eq %v_20, 0: I32
    je %v_21, b_15, b_22
  }

  b_22 {
    jmp b_17
  }

  b_17 {
    %v_23 = phi [b_12, %v_6], [b_22, %least]: I64
    %v_24 = phi [b_12, %v_8], [b_22, %v_19]: Ptr
    store @heapNext, %v_24, 8
    %v_25 = add %v_24, %v_23: Ptr
    store @heapLimit, %v_25, 8
    %v_26 = add %v_23, %v_23: I64
    store @heapRegionNext, %v_26, 8
    ret 1
  }
}

allocateHeap<complex>(%size: I64): Ptr {
  b_0 {
    %v_1 = load @heapFree, 8: Ptr
    %v_2 = bitcast %v_1: I64
    %v_3 = cmp_eq %v_2, 0: I32
    je %v_3, b_4, b_5
  }

  b_5 {
    jmp b_6
  }

  b_4 {
    call_complex initHeap
    %v_7 = load @heapFree, 8: Ptr
    %v_8 = bitcast %v_7: I64
    %v_9 = cmp_eq %v_8, 0: I32
    je %v_9, b_10, b_11
  }

  b_11 {
    jmp b_6
  }

  b_6 {
    %v_12 = add %size, 8: I64
    jmp b_13
  }

  b_13 {
    %v_14 = phi [b_6, 16], [b_15, %v_16]: I64
    %v_17 = phi [b_6, 0], [b_15, %v_18]: I64
    %v_19 = cmp_ilt %v_14, %v_12: I32
    je %v_19, b_15, b_20
  }

  b_20 {
    %v_21 = cmp_ige %v_17, 32: I32
    je %v_21, b_10, b_22
  }

  b_22 {
    %v_23 = load @heapFree, 8: Ptr
    %v_24 = shl %v_17, 3: I64
    %v_25 = add %v_23, %v_24: Ptr
    %v_26 = load %v_25, 8: Ptr
    %v_27 = bitcast %v_26: I64
    %v_28 = cmp_eq %v_27, 0: I32
    je %v_28, b_29, b_30
  }

  b_29 {
    %v_31 = shl 16, %v_17: I64
    %v_32 = load @heapNext, 8: Ptr
    %v_33 = add %v_32, %v_31: Ptr
    %v_34 = load @heapLimit, 8: Ptr
    %v_35 = cmp_gt %v_33, %v_34: I32
    je %v_35, b_36, b_37
  }

  b_37 {
    jmp b_38
  }

  b_36 {
    %v_39 = call_complex growHeap, %v_31: I32
    je %v_39, b_40, b_10
  }

  b_40 {
    jmp b_38
  }

  b_38 {
    %block = load @heapNext, 8: Ptr
    %v_41 = add %block, %v_31: Ptr
    store @heapNext, %v_41, 8
    store %block, %v_17, 8
    %v_42 = add %block, 8: Ptr
    ret %v_42
  }

  b_10 {
    %v_43 = bitcast 0: Ptr
    ret %v_43
  }

  b_30 {
    %v_44 = load %v_26, 8: Ptr
    store %v_25, %v_44, 8
    ret %v_26
  }

  b_15 {
    %v_16 = add %v_14, %v_14: I64
    %v_18 = add %v_17, 1: I64
    jmp b_13
  }
}

freeHeap<complex>(%allocation: Ptr) {
  b_0 {
    %v_1 = bitcast %allocation: I64
    %v_2 = cmp_eq %v_1, 0: I32
    je %v_2, b_3, b_4
  }

  b_3 {
    ret 
  }

  b_4 {
    %v_5 = sub %allocation, 8: Ptr
    %sizeClass = loads %v_5, 8: I64
    %v_6 = load @heapFree, 8: Ptr
    %v_7 = shl %sizeClass, 3: I64
    %v_8 = add %v_6, %v_7: Ptr
    %v_9 = load %v_8, 8: Ptr
    store %allocation, %v_9, 8
    %v_10 = load @heapFree, 8: Ptr
    %v_11 = add %v_10, %v_7: Ptr
    store %v_11, %allocation, 8
    ret 
  }
}

main<complex>(): I64 {
  b_0 {
    %b = alloca 24, 8: Ptr
    call_complex +=(I64), @live, 1
    %v_1 = call_complex allocateHeap, 16: Ptr
    store %b, 1, 4
    %v_2 = add %b, 8: Ptr
    store %v_2, %v_1, 8
    %inside = loads @live, 8: I64
    call_complex drop$Box, %b
    %b = alloca 24, 8: Ptr
    call_complex +=(I64), @live, 1
    %v_3 = call_complex allocateHeap, 16: Ptr
    call_complex +=(I64), @live, 1
    %v_4 = call_complex allocateHeap, 16: Ptr
    store %b, 2, 4
    %v_5 = add %b, 8: Ptr
    store %v_5, %v_3, 8
    %v_6 = add %b, 16: Ptr
    store %v_6, %v_4, 8
    %inside = loads @live, 8: I64
    call_complex drop$Box, %b
    %b = alloca 24, 8: Ptr
    call_complex +=(I64), @live, 1
    %v_7 = call_complex allocateHeap, 16: Ptr
    store %b, 1, 4
    %v_8 = add %b, 8: Ptr
    store %v_8, %v_7, 8
    %v_9 = loads @live, 8: I64
    call_complex drop$Box, %b
    call_complex +=(I64), @live, 1
    %v_10 = call_complex allocateHeap, 16: Ptr
    %before = loads @live, 8: I64
    call_complex freeHeap, %v_10
    call_complex -=(I64), @live, 1
    %v_11 = imul %before, 10: I64
    %v_12 = loads @live, 8: I64
    %v_13 = add %v_11, %v_12: I64
    call_complex +=(I64), @live, 1
    %v_14 = call_complex allocateHeap, 16: Ptr
    %v_15 = loads @live, 8: I64
    call_complex freeHeap, %v_14
    call_complex -=(I64), @live, 1
    %v_16 = imul %inside, 100000: I64
    %v_17 = imul %inside, 10000: I64
    %v_18 = add %v_16, %v_17: I64
    %v_19 = imul %v_9, 1000: I64
    %v_20 = add %v_18, %v_19: I64
    %v_21 = imul %v_13, 10: I64
    %v_22 = add %v_20, %v_21: I64
    %v_23 = add %v_22, %v_15: I64
    %v_24 = loads @live, 8: I64
    %v_25 = add %v_23, %v_24: I64
    ret %v_25
  }
}

drop$Box<complex>(%value: Ptr) {
  b_0 {
    %v_1 = loads %value, 4: I32
    %v_2 = cmp_eq %v_1, 1: I32
    je %v_2, b_3, b_4
  }

  b_5 {
    ret 
  }

  b_3 {
    %v_6 = add %value, 8: Ptr
    %v_7 = load %v_6, 8: Ptr
    call_complex freeHeap, %v_7
    call_complex -=(I64), @live, 1
    jmp b_5
  }

  b_4 {
    %v_8 = cmp_eq %v_1, 2: I32
    je %v_8, b_9, b_10
  }

  b_9 {
    %v_11 = add %value, 8: Ptr
    %v_12 = load %v_11, 8: Ptr
    call_complex freeHeap, %v_12
    call_complex -=(I64), @live, 1
    %v_13 = add %value, 16: Ptr
    %v_14 = load %v_13, 8: Ptr
    call_complex freeHeap, %v_14
    call_complex -=(I64), @live, 1
    jmp b_5
  }

  b_10 {
    jmp b_5
  }
}

