@image$base = []
mut @heapNext = [0, 0, 0, 0, 0, 0, 0, 0]
mut @heapLimit = [0, 0, 0, 0, 0, 0, 0, 0]
mut @heapFree = [0, 0, 0, 0, 0, 0, 0, 0]
mut @heapRegionNext = [0, 0, 0, 0, 0, 0, 0, 0]
mut @live = [0, 0, 0, 0, 0, 0, 0, 0]

+=(I64)<complex>(%target: Ptr, %amount: Long) {
  b_0 {
    %v_1 = loads %target, 8: Long
    %v_2 = add %v_1, %amount: Long
    store %target, %v_2, 8
    ret 
  }
}

-=(I64)<complex>(%target: Ptr, %amount: Long) {
  b_0 {
    %v_1 = loads %target, 8: Long
    %v_2 = sub %v_1, %amount: Long
    store %target, %v_2, 8
    ret 
  }
}

growHeap<complex>(%needed: Long): Int {
  b_0 {
    %v_1 = loads @heapRegionNext, 8: Long
    %v_2 = cmp_ilt %v_1, %needed: Int
    je %v_2, b_3, b_4
  }

  b_3 {
    jmp b_5
  }

  b_4 {
    jmp b_5
  }

  b_5 {
    %v_6 = phi [b_3, %needed], [b_4, %v_1]: Long
    %v_7 = add %v_6, 4096: Long
    %v_8 = call_complex mapMemory, %v_7: Ptr
    %v_9 = bitcast %v_8: Long
    %v_10 = cmp_eq %v_9, 0: Int
    je %v_10, b_11, b_12
  }

  b_11 {
    %v_13 = cmp_igt %needed, 4194304: Int
    %least = select %v_13, %needed, 4194304: Long
    %v_14 = cmp_ige %least, %v_6: Int
    je %v_14, b_15, b_16
  }

  b_12 {
    jmp b_17
  }

  b_15 {
    ret 0
  }

  b_16 {
    %v_18 = add %least, 4096: Long
    %v_19 = call_complex mapMemory, %v_18: Ptr
    %v_20 = bitcast %v_19: Long
    %v_21 = cmp_eq %v_20, 0: Int
    je %v_21, b_15, b_22
  }

  b_22 {
    jmp b_17
  }

  b_17 {
    %v_23 = phi [b_12, %v_6], [b_22, %least]: Long
    %v_24 = phi [b_12, %v_8], [b_22, %v_19]: Ptr
    store @heapNext, %v_24, 8
    %v_25 = add %v_24, %v_23: Ptr
    store @heapLimit, %v_25, 8
    %v_26 = add %v_23, %v_23: Long
    store @heapRegionNext, %v_26, 8
    ret 1
  }
}

allocateHeap<complex>(%size: Long): Ptr {
  b_0 {
    %v_1 = load @heapFree, 8: Ptr
    %v_2 = bitcast %v_1: Long
    %v_3 = cmp_eq %v_2, 0: Int
    je %v_3, b_4, b_5
  }

  b_5 {
    jmp b_6
  }

  b_4 {
    %result = syscall 9, 0, 4198400, 3, 34, 18446744073709551615, 0: Long
    %v_7 = cmp_ilt %result, 0: Int
    %v_8 = bitcast 0: Ptr
    %v_9 = bitcast %result: Ptr
    %region = select %v_7, %v_8, %v_9: Ptr
    %v_10 = bitcast %region: Long
    %v_11 = cmp_eq %v_10, 0: Int
    je %v_11, b_12, b_13
  }

  b_13 {
    setpattern %region, 256, 0
    %v_14 = bitcast %region: Ptr
    store @heapFree, %v_14, 8
    %v_15 = add %region, 256: Ptr
    store @heapNext, %v_15, 8
    %v_16 = add %region, 4194304: Ptr
    store @heapLimit, %v_16, 8
    store @heapRegionNext, 8388608, 8
    jmp b_17
  }

  b_12 {
    jmp b_17
  }

  b_17 {
    %v_18 = load @heapFree, 8: Ptr
    %v_19 = bitcast %v_18: Long
    %v_20 = cmp_eq %v_19, 0: Int
    je %v_20, b_21, b_22
  }

  b_22 {
    jmp b_6
  }

  b_6 {
    %v_23 = add %size, 8: Long
    jmp b_24
  }

  b_24 {
    %v_25 = phi [b_6, 16], [b_26, %v_27]: Long
    %v_28 = phi [b_6, 0], [b_26, %v_29]: Long
    %v_30 = cmp_ilt %v_25, %v_23: Int
    je %v_30, b_26, b_31
  }

  b_31 {
    %v_32 = cmp_ige %v_28, 32: Int
    je %v_32, b_33, b_34
  }

  b_34 {
    %v_35 = load @heapFree, 8: Ptr
    %v_36 = shl %v_28, 3: Long
    %v_37 = add %v_35, %v_36: Ptr
    %v_38 = load %v_37, 8: Ptr
    %v_39 = bitcast %v_38: Long
    %v_40 = cmp_eq %v_39, 0: Int
    je %v_40, b_41, b_42
  }

  b_41 {
    %v_43 = shl 16, %v_28: Long
    %v_44 = load @heapNext, 8: Ptr
    %v_45 = add %v_44, %v_43: Ptr
    %v_46 = load @heapLimit, 8: Ptr
    %v_47 = cmp_gt %v_45, %v_46: Int
    je %v_47, b_48, b_49
  }

  b_49 {
    jmp b_50
  }

  b_48 {
    %v_51 = call_complex growHeap, %v_43: Int
    %v_52 = xor %v_51, 1: Int
    je %v_52, b_33, b_53
  }

  b_53 {
    jmp b_50
  }

  b_50 {
    %block = load @heapNext, 8: Ptr
    %v_54 = add %block, %v_43: Ptr
    store @heapNext, %v_54, 8
    %v_55 = bitcast %block: Ptr
    store %v_55, %v_28, 8
    %v_56 = add %block, 8: Ptr
    ret %v_56
  }

  b_33 {
    %v_57 = bitcast 0: Ptr
    ret %v_57
  }

  b_42 {
    %v_58 = bitcast %v_38: Ptr
    %v_59 = load %v_58, 8: Ptr
    store %v_37, %v_59, 8
    ret %v_38
  }

  b_26 {
    %v_27 = add %v_25, %v_25: Long
    %v_29 = add %v_28, 1: Long
    jmp b_24
  }

  b_21 {
    ret %v_8
  }
}

freeHeap<complex>(%allocation: Ptr) {
  b_0 {
    %v_1 = bitcast %allocation: Long
    %v_2 = cmp_eq %v_1, 0: Int
    je %v_2, b_3, b_4
  }

  b_3 {
    ret 
  }

  b_4 {
    jmp b_5
  }

  b_5 {
    %v_6 = sub %allocation, 8: Ptr
    %v_7 = bitcast %v_6: Ptr
    %sizeClass = loads %v_7, 8: Long
    %v_8 = bitcast %allocation: Ptr
    %v_9 = load @heapFree, 8: Ptr
    %v_10 = shl %sizeClass, 3: Long
    %v_11 = add %v_9, %v_10: Ptr
    %v_12 = load %v_11, 8: Ptr
    store %v_8, %v_12, 8
    %v_13 = load @heapFree, 8: Ptr
    %v_14 = add %v_13, %v_10: Ptr
    store %v_14, %allocation, 8
    ret 
  }
}

mapMemory<complex>(%size: Long): Ptr {
  b_0 {
    %result = syscall 9, 0, %size, 3, 34, 18446744073709551615, 0: Long
    %v_1 = cmp_ilt %result, 0: Int
    je %v_1, b_2, b_3
  }

  b_2 {
    %v_4 = bitcast 0: Ptr
    ret %v_4
  }

  b_3 {
    jmp b_5
  }

  b_5 {
    %v_6 = bitcast %result: Ptr
    ret %v_6
  }
}

main<complex>(): Long {
  b_0 {
    %b = alloca 24, 8: Ptr
    call_complex +=(I64), @live, 1
    %v_1 = call_complex allocateHeap, 16: Ptr
    store %b, 1, 4
    %v_2 = add %b, 8: Ptr
    store %v_2, %v_1, 8
    %inside = loads @live, 8: Long
    call_complex drop$Box, %b
    %b = alloca 24, 8: Ptr
    call_complex +=(I64), @live, 1
    %v_3 = call_complex allocateHeap, 16: Ptr
    call_complex +=(I64), @live, 1
    %v_4 = call_complex allocateHeap, 16: Ptr
    store %b, 2, 4
    %v_5 = add %b, 8: Ptr
    store %v_5, %v_3, 8
    %v_6 = add %b, 16: Ptr
    store %v_6, %v_4, 8
    %inside = loads @live, 8: Long
    call_complex drop$Box, %b
    %b = alloca 24, 8: Ptr
    call_complex +=(I64), @live, 1
    %v_7 = call_complex allocateHeap, 16: Ptr
    store %b, 1, 4
    %v_8 = add %b, 8: Ptr
    store %v_8, %v_7, 8
    %v_9 = loads @live, 8: Long
    call_complex drop$Box, %b
    %b = alloca 24, 8: Ptr
    call_complex +=(I64), @live, 1
    %v_10 = call_complex allocateHeap, 16: Ptr
    store %b, 1, 4
    %v_11 = add %b, 8: Ptr
    store %v_11, %v_10, 8
    %before = loads @live, 8: Long
    call_complex freeHeap, %v_10
    call_complex -=(I64), @live, 1
    %v_12 = imul %before, 10: Long
    %v_13 = loads @live, 8: Long
    %v_14 = add %v_12, %v_13: Long
    %b = alloca 24, 8: Ptr
    call_complex +=(I64), @live, 1
    %v_15 = call_complex allocateHeap, 16: Ptr
    store %b, 1, 4
    %v_16 = add %b, 8: Ptr
    store %v_16, %v_15, 8
    %v_17 = loads @live, 8: Long
    call_complex freeHeap, %v_15
    call_complex -=(I64), @live, 1
    %v_18 = imul %inside, 100000: Long
    %v_19 = imul %inside, 10000: Long
    %v_20 = add %v_18, %v_19: Long
    %v_21 = imul %v_9, 1000: Long
    %v_22 = add %v_20, %v_21: Long
    %v_23 = imul %v_14, 10: Long
    %v_24 = add %v_22, %v_23: Long
    %v_25 = add %v_24, %v_17: Long
    %v_26 = loads @live, 8: Long
    %v_27 = add %v_25, %v_26: Long
    ret %v_27
  }
}

drop$Box<complex>(%value: Ptr) {
  b_0 {
    %v_1 = loads %value, 4: Int
    %v_2 = cmp_eq %v_1, 1: Int
    je %v_2, b_3, b_4
  }

  b_5 {
    ret 
  }

  b_3 {
    %v_6 = add %value, 8: Ptr
    %v_7 = load %v_6, 8: Ptr
    call_complex freeHeap, %v_7
    call_complex -=(I64), @live, 1
    jmp b_5
  }

  b_4 {
    %v_8 = cmp_eq %v_1, 2: Int
    je %v_8, b_9, b_10
  }

  b_9 {
    %v_11 = add %value, 8: Ptr
    %v_12 = load %v_11, 8: Ptr
    call_complex freeHeap, %v_12
    call_complex -=(I64), @live, 1
    %v_13 = add %value, 16: Ptr
    %v_14 = load %v_13, 8: Ptr
    call_complex freeHeap, %v_14
    call_complex -=(I64), @live, 1
    jmp b_5
  }

  b_10 {
    jmp b_5
  }
}

