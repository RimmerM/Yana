  }
}

unwrap<complex>(%w: Ptr): f32x4 {
  b_0 {
    %v_1 = load %w, 16: f32x4
    ret %v_1
  }
}

tagOf'2<complex>(%w: Ptr): I32 {
  b_0 {
    %v_1 = add %w, 16: Ptr
    %v_2 = loads %v_1, 4: I32
    ret %v_2
  }
}

