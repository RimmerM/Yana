
natural<complex>(%v: f32x4): f32x4 {
  b_0 {
    ret %v
  }
}

explicit<complex>(%v: f32x4): f32x4 {
  b_0 {
    ret %v
  }
}

half<complex>(%v: f32x2): f32x2 {
  b_0 {
    %v_1 = alloca 8, 8: Ptr
    store %v_1, %v, 8
    ret %v
  }
}

bytes'2<complex>(%v: i8x16): i8x16 {
  b_0 {
    ret %v
  }
}

maskFloat<complex>(%m: m32x4): m32x4 {
  b_0 {
