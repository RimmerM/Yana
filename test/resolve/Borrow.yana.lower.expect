
*=(Int)<complex>(%target: Ptr, %amount: Int) {
  b_0 {
    %v_1 = loads %target, 4: Int
    %v_2 = imul %v_1, %amount: Int
    store %target, %v_2, 4
    ret 
  }
}

swap<complex>(%a: Ptr, %b: Ptr) {
  b_0 {
    %old = loads %a, 4: Int
    %v_1 = loads %b, 4: Int
    store %a, %v_1, 4
    store %b, %old, 4
    ret 
  }
}

copyThroughBorrow<complex>(%target: Ptr, %amount: Int) {
  b_0 {
    %v_1 = loads %target, 4: Int
    %v_2 = add %v_1, %amount: Int
    store %target, %v_2, 4
    ret 
  }
}

moveBy<complex>(%p: Ptr, %dx: Int, %dy: Int) {
  b_0 {
    call_complex +=(Int), %p, %dx
    %v_1 = add %p, 4: Ptr
    call_complex +=(Int), %v_1, %dy
    ret 
  }
}

+=(Int)<complex>(%target: Ptr, %amount: Int) {
  b_0 {
    %v_1 = loads %target, 4: Int
    %v_2 = add %v_1, %amount: Int
    store %target, %v_2, 4
    ret 
  }
}

main<complex>(): Int {
  b_0 {
    %total = alloca 4, 4: Ptr
    store %total, 0, 4
    call_complex bump, %total, 5
    call_complex +=(Int), %total, 3
    call_complex *=(Int), %total, 2
    %left = alloca 4, 4: Ptr
    store %left, 1, 4
    %right = alloca 4, 4: Ptr
    store %right, 2, 4
    call_complex swap, %left, %right
    %here = alloca 8, 4: Ptr
    store %here, 10, 4
    %v_1 = add %here, 4: Ptr
    store %v_1, 20, 4
    call_complex moveBy, %here, 1, 2
    %v_2 = loads %total, 4: Int
    call_complex copyThroughBorrow, %total, %v_2
    %v_3 = loads %total, 4: Int
    %v_4 = loads %left, 4: Int
    %v_5 = loads %right, 4: Int
    %v_6 = sub %v_4, %v_5: Int
    %v_7 = add %v_3, %v_6: Int
    %v_8 = loads %here, 4: Int
    %v_9 = add %v_7, %v_8: Int
    %v_10 = add %here, 4: Ptr
    %v_11 = loads %v_10, 4: Int
    %v_12 = add %v_9, %v_11: Int
    ret %v_12
  }
}

bump<complex>(%counter: Ptr, %by: Int) {
  b_0 {
    %v_1 = loads %counter, 4: Int
    %v_2 = add %v_1, %by: Int
    store %counter, %v_2, 4
    ret 
  }
}

