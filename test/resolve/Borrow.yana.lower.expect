@image$base = []

+=(I32)<complex>(%target: Ptr, %amount: I32) {
  b_0 {
    %v_1 = loads %target, 4: I32
    %v_2 = add %v_1, %amount: I32
    store %target, %v_2, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 8, 4: Ptr
    store %v_1, 10, 4
    %v_2 = add %v_1, 4: Ptr
    store %v_2, 20, 4
    call_complex +=(I32), %v_1, 1
    %v_3 = add %v_1, 4: Ptr
    call_complex +=(I32), %v_3, 2
    %v_4 = loads %v_1, 4: I32
