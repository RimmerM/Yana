fn Money.compare(lhs: Money [shared call], rhs: Money [shared call]) -> Ordering {
bb0:
  %0: I64 = read copy.trivial (lhs.cents)
  %1: I64 = read copy.trivial (rhs.cents)
  %2: Ordering = call compare(I64) borrow.shared %0 borrow.shared %1
