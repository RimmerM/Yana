fn main() -> I32 {
  local total: Money

bb0:
  %0: I64 = const 2
  %1: Money = call fromInt(Money) borrow.shared %0
  %2: I64 = const 3
  %3: Money = call fromInt(Money) borrow.shared %2
  %4: Money = call +(Money) borrow.shared %1 borrow.shared %3
  write.init borrow.unique (total) take %4
  %6: Money = read copy.trivial (total)
  %7: I64 = const 4
  %8: Money = call fromInt(Money) borrow.shared %7
  %9: Bool = call >(Money) borrow.shared %6 borrow.shared %8
  branch inspect %9 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %15: I32 = const 0
  return take %15

bb3:
  %11: I64 = read copy.trivial (total.cents)
  %12: I32 = convert inspect %11
  return take %12
