@bonus = [3, 0, 0, 0]
mut @counter = [0, 0, 0, 0]
mut @shape = [0, 0, 0, 0, 7, 0, 0, 0]
mut @seed = [0, 0, 0, 0]
mut @recorded = [0, 0, 0, 0]
mut @first = [0, 0, 0, 0]
mut @second = [0, 0, 0, 0]

main$<complex>(): I32 {
  b_0 {
    store @seed, 20, 4
    %v_1 = loads @counter, 4: I32
    %v_2 = loads @seed, 4: I32
    %v_3 = add %v_1, %v_2: I32
    store @counter, %v_3, 4
    %v_4 = loads @counter, 4: I32
    %shape = global @shape: Ptr
    %v_5 = alloca 3, 4: Ptr
    %v_6 = load %shape, 1: I32
    %v_7 = add %shape, 1: Ptr
    copy %v_5, %v_7, 3
    %v_8 = add %shape, 4: Ptr
    %v_9 = load %v_8, 4: I32
    %v_10 = cmp_eq %v_6, 0: I32
    je %v_10, b_11, b_12
  }

  b_13 {
    %v_14 = phi [b_12, %v_15], [b_11, %v_16]: I32
    %v_17 = add %v_4, %v_14: I32
    store @counter, %v_17, 4
    %v_18 = loads @counter, 4: I32
    store @recorded, %v_18, 4
    %v_19 = loads @counter, 4: I32
    %v_20 = add %v_19, 1: I32
    store @first, %v_20, 4
    %v_21 = loads @first, 4: I32
    %v_22 = add %v_21, 1: I32
    store @second, %v_22, 4
    %v_23 = loads @bonus, 4: I32
    %v_24 = loads @counter, 4: I32
    %v_25 = add %v_23, %v_24: I32
    %v_26 = loads @recorded, 4: I32
    %v_27 = imul %v_26, 100: I32
    %v_28 = add %v_25, %v_27: I32
    %v_29 = loads @first, 4: I32
    %v_30 = imul %v_29, 10000: I32
    %v_31 = add %v_28, %v_30: I32
    %v_32 = loads @second, 4: I32
    %v_33 = imul %v_32, 1000000: I32
    %v_34 = add %v_31, %v_33: I32
    ret %v_34
  }

  b_12 {
    %v_15 = imul %v_9, %v_9: I32
    jmp b_13
  }

  b_11 {
    %v_16 = imul %v_9, %v_9: I32
    jmp b_13
  }
}

