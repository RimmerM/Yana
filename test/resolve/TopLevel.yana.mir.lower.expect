mut @counter = [0, 0, 0, 0]
mut @shape = [0, 0, 0, 0, 7, 0, 0, 0]
mut @seed = [0, 0, 0, 0]
mut @recorded = [0, 0, 0, 0]
mut @first = [0, 0, 0, 0]
mut @second = [0, 0, 0, 0]

main$<complex>(): I32 {
  b_0 {
    %v_1 = imm 20: I32
    store @seed, %v_1, 4
    %v_2 = loads @counter, 4: I32
    %v_3 = add %v_2, %v_1: I32
    store @counter, %v_3, 4
    %shape = global @shape: Ptr
    %v_4 = load %shape, 1: I32
    %v_5 = add %shape, 4: Ptr
    %v_6 = load %v_5, 4: I32
    %v_7 = cmp_eq %v_4, 0: I32
    je %v_7, b_8, b_9
  }

  b_10 {
    %v_11 = phi [b_9, %v_12], [b_8, %v_13]: I32
    %v_14 = add %v_3, %v_11: I32
    store @counter, %v_14, 4
    store @recorded, %v_14, 4
    %v_15 = add %v_14, 1: I32
    store @first, %v_15, 4
    %v_16 = add %v_14, 2: I32
    store @second, %v_16, 4
    %v_17 = add 3, %v_14: I32
    %v_18 = imul %v_14, 100: I32
    %v_19 = add %v_17, %v_18: I32
    %v_20 = imul %v_15, 10000: I32
    %v_21 = add %v_19, %v_20: I32
    %v_22 = imul %v_16, 1000000: I32
    %v_23 = add %v_21, %v_22: I32
    ret %v_23
  }

  b_9 {
    %v_12 = imul %v_6, %v_6: I32
    jmp b_10
  }

  b_8 {
    %v_13 = imul %v_6, %v_6: I32
    jmp b_10
  }
}

