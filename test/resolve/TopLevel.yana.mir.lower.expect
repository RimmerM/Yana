mut @counter = [0, 0, 0, 0]
mut @shape = [0, 0, 0, 0, 7, 0, 0, 0]
mut @seed = [0, 0, 0, 0]
mut @recorded = [0, 0, 0, 0]
mut @first = [0, 0, 0, 0]
mut @second = [0, 0, 0, 0]

main$<complex>(): I32 {
  b_0 {
    store @seed, 20, 4
    %v_1 = loads @counter, 4: I32
    %v_2 = loads @seed, 4: I32
    %v_3 = add %v_1, %v_2: I32
    store @counter, %v_3, 4
    %v_4 = loads @counter, 4: I32
    %shape = global @shape: Ptr
    %v_5 = load %shape, 1: I32
    %v_6 = add %shape, 4: Ptr
    %v_7 = load %v_6, 4: I32
    %v_8 = cmp_eq %v_5, 0: I32
    je %v_8, b_9, b_10
  }

  b_11 {
    %v_12 = phi [b_10, %v_13], [b_9, %v_14]: I32
    %v_15 = add %v_4, %v_12: I32
    store @counter, %v_15, 4
    %v_16 = loads @counter, 4: I32
    store @recorded, %v_16, 4
    %v_17 = loads @counter, 4: I32
    %v_18 = add %v_17, 1: I32
    store @first, %v_18, 4
    %v_19 = loads @first, 4: I32
    %v_20 = add %v_19, 1: I32
    store @second, %v_20, 4
    %v_21 = loads @counter, 4: I32
    %v_22 = add 3, %v_21: I32
    %v_23 = loads @recorded, 4: I32
    %v_24 = imul %v_23, 100: I32
    %v_25 = add %v_22, %v_24: I32
    %v_26 = loads @first, 4: I32
    %v_27 = imul %v_26, 10000: I32
    %v_28 = add %v_25, %v_27: I32
    %v_29 = loads @second, 4: I32
    %v_30 = imul %v_29, 1000000: I32
    %v_31 = add %v_28, %v_30: I32
    ret %v_31
  }

  b_10 {
    %v_13 = imul %v_7, %v_7: I32
    jmp b_11
  }

  b_9 {
    %v_14 = imul %v_7, %v_7: I32
    jmp b_11
  }
}

