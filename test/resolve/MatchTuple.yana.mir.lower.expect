  b_3 {
    %v_14 = load %rhs, 1: I32
    %v_15 = cmp_eq %v_14, 1: I32
    je %v_15, b_11, b_4
  }

  b_11 {
    %v_16 = add %lhs, 4: Ptr
    %v_17 = add %rhs, 4: Ptr
    %v_12 = call_complex Held.==, %v_16, %v_17: I32
    jmp b_9
  }

  b_7 {
    %v_18 = load %rhs, 1: I32
    %v_19 = cmp_eq %v_18, 0: I32
    je %v_19, b_13, b_8
  }

