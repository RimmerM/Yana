mut @drops = [0, 0, 0, 0]

Held.drop<complex>(%self: Ptr) {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    copy %v_1, %self, 4
    %v_2 = loads @drops, 4: I32
    %v_3 = add %v_2, 1: I32
    store @drops, %v_3, 4
    ret 
  }
}

