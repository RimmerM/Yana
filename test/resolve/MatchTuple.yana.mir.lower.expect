    %v_1 = alloca 4, 4: Ptr
    %v_2 = alloca 4, 4: Ptr
    store %v_1, %c, 4
    %v_3 = load %a, 1: I32
    %v_4 = cmp_eq %v_3, 1: I32
    je %v_4, b_5, b_6
  }

  b_6 {
    %v_7 = load %a, 1: I32
    %v_8 = cmp_eq %v_7, 1: I32
    je %v_8, b_9, b_10
  }

  b_10 {
    jmp b_11
  }

  b_11 {
