mut @drops = [0, 0, 0, 0]

Held.drop<complex>(%v_0: I32) {
  b_1 {
    %v_2 = loads @drops, 4: I32
    %v_3 = add %v_2, 1: I32
    store @drops, %v_3, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 8, 4: Ptr
    %v_2 = alloca 8, 4: Ptr
    %v_3 = add %v_1, 4: Ptr
    store %v_3, 3, 4
    store %v_1, 1, 1
    %v_4 = add %v_2, 4: Ptr
    store %v_4, 4, 4
    store %v_2, 1, 1
    %v_5 = load %v_2, 1: I32
    %v_6 = cmp_eq %v_5, 1: I32
    je %v_6, b_7, b_8
  }

  b_8 {
    jmp b_9
  }

  b_7 {
    %v_10 = loads %v_3, 4: I32
    %v_11 = loads %v_4, 4: I32
    %v_12 = cmp_eq %v_10, %v_11: I32
    jmp b_9
  }

  b_9 {
    %v_13 = phi [b_8, 0], [b_7, %v_12]: I32
    %v_14 = select %v_13, 1000, 0: I32
    %v_15 = load %v_2, 1: I32
    %v_16 = cmp_eq %v_15, 1: I32
    je %v_16, b_17, b_18
  }

  b_17 {
    %v_19 = loads %v_3, 4: I32
    %v_20 = loads %v_4, 4: I32
    %v_21 = add %v_19, %v_20: I32
    jmp b_22
  }

  b_18 {
    %v_23 = cmp_eq %v_15, 0: I32
    je %v_23, b_24, b_25
  }

  b_25 {
    jmp b_22
  }

  b_24 {
    %v_26 = loads %v_3, 4: I32
    jmp b_22
  }

  b_22 {
    %v_27 = phi [b_25, 0], [b_24, %v_26], [b_17, %v_21]: I32
    call_complex teardown(Maybe(Held)), %v_1
    call_complex teardown(Maybe(Held)), %v_2
    %v_28 = add %v_14, %v_27: I32
    %v_29 = loads @drops, 4: I32
    %v_30 = imul %v_29, 10: I32
    %v_31 = add %v_28, %v_30: I32
    %v_32 = add %v_31, 7: I32
    ret %v_32
  }
}

teardown(Maybe(Held))<complex>(%v_0: Ptr) {
  b_1 {
    %v_2 = load %v_0, 1: I32
    %v_3 = cmp_eq %v_2, 1: I32
    je %v_3, b_4, b_5
  }

  b_6 {
    ret 
  }

  b_4 {
    %v_7 = add %v_0, 4: Ptr
    %v_8 = load %v_7, 4: I32
    call_complex Held.drop, %v_8
    jmp b_6
  }

  b_5 {
    jmp b_6
  }
}

