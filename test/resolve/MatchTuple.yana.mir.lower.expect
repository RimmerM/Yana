mut @drops = [0, 0, 0, 0]

Held.drop<complex>() {
  b_0 {
    %v_1 = loads @drops, 4: I32
    %v_2 = add %v_1, 1: I32
    store @drops, %v_2, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 8, 4: Ptr
    %v_2 = alloca 8, 4: Ptr
    %v_3 = add %v_1, 4: Ptr
    store %v_3, 3, 4
    store %v_1, 1, 1
    %v_4 = add %v_2, 4: Ptr
    store %v_4, 4, 4
    store %v_2, 1, 1
    %v_5 = select 0, 1000, 0: I32
    %v_6 = load %v_2, 1: I32
    %v_7 = cmp_eq %v_6, 1: I32
    je %v_7, b_8, b_9
  }

  b_8 {
    %v_10 = loads %v_3, 4: I32
    %v_11 = loads %v_4, 4: I32
    %v_12 = add %v_10, %v_11: I32
    jmp b_13
  }

  b_9 {
    %v_14 = cmp_eq %v_6, 0: I32
    je %v_14, b_15, b_16
  }

  b_16 {
    jmp b_13
  }

  b_15 {
    %v_17 = loads %v_3, 4: I32
    jmp b_13
  }

  b_13 {
    %v_18 = phi [b_16, 0], [b_15, %v_17], [b_8, %v_12]: I32
    call_complex teardown(Maybe(Held)), %v_1
    call_complex teardown(Maybe(Held)), %v_2
    %v_19 = add %v_5, %v_18: I32
    %v_20 = loads @drops, 4: I32
    %v_21 = imul %v_20, 10: I32
    %v_22 = add %v_19, %v_21: I32
    %v_23 = add %v_22, 7: I32
    ret %v_23
  }
}

teardown(Maybe(Held))<complex>(%v_0: Ptr) {
  b_1 {
    %v_2 = load %v_0, 1: I32
    %v_3 = cmp_eq %v_2, 1: I32
    je %v_3, b_4, b_5
  }

  b_6 {
    ret 
  }

  b_4 {
    call_complex Held.drop
    jmp b_6
  }

  b_5 {
    jmp b_6
  }
}

