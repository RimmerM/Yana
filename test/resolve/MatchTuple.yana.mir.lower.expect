mut @drops = [0, 0, 0, 0]

Held.drop<complex>(%self: Ptr) {
  b_0 {
    %v_1 = loads @drops, 4: I32
    %v_2 = add %v_1, 1: I32
    store @drops, %v_2, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 8, 4: Ptr
    %v_2 = alloca 8, 4: Ptr
    %v_3 = add %v_1, 4: Ptr
    store %v_3, 3, 4
    store %v_1, 1, 1
    %v_4 = add %v_2, 4: Ptr
    store %v_4, 4, 4
    store %v_2, 1, 1
    jmp b_5
  }

  b_5 {
    %v_6 = load %v_2, 1: I32
    %v_7 = cmp_eq %v_6, 1: I32
    je %v_7, b_8, b_9
  }

  b_9 {
    jmp b_10
  }

  b_10 {
    jmp b_11
  }

  b_8 {
    %v_12 = loads %v_3, 4: I32
    %v_13 = loads %v_4, 4: I32
    %v_14 = cmp_eq %v_12, %v_13: I32
    jmp b_11
  }

  b_11 {
    %v_15 = phi [b_10, 0], [b_8, %v_14]: I32
    %v_16 = select %v_15, 1000, 0: I32
    jmp b_17
  }

  b_17 {
    %v_18 = load %v_2, 1: I32
    %v_19 = cmp_eq %v_18, 1: I32
    je %v_19, b_20, b_21
  }

  b_20 {
    %v_22 = loads %v_3, 4: I32
    %v_23 = loads %v_4, 4: I32
    %v_24 = add %v_22, %v_23: I32
    jmp b_25
  }

  b_21 {
    jmp b_26
  }

  b_26 {
    %v_27 = load %v_2, 1: I32
    %v_28 = cmp_eq %v_27, 0: I32
    je %v_28, b_29, b_30
  }

  b_30 {
    jmp b_25
  }

  b_29 {
    %v_31 = loads %v_3, 4: I32
    jmp b_25
  }

  b_25 {
    %v_32 = phi [b_30, 0], [b_29, %v_31], [b_20, %v_24]: I32
    call_complex teardown(Maybe(Held)), %v_1
    call_complex teardown(Maybe(Held)), %v_2
    %v_33 = add %v_16, %v_32: I32
    %v_34 = loads @drops, 4: I32
    %v_35 = imul %v_34, 10: I32
    %v_36 = add %v_33, %v_35: I32
    %v_37 = add %v_36, 7: I32
    ret %v_37
  }
}

teardown(Maybe(Held))<complex>(%v_0: Ptr) {
  b_1 {
    %v_2 = load %v_0, 1: I32
    %v_3 = cmp_eq %v_2, 1: I32
    je %v_3, b_4, b_5
  }

  b_6 {
    ret 
  }

  b_4 {
    %v_7 = add %v_0, 4: Ptr
    call_complex Held.drop, %v_7
    jmp b_6
  }

  b_5 {
    jmp b_6
  }
}

