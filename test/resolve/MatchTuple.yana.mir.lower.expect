mut @drops = [0, 0, 0, 0]

Held.drop<complex>(%self: Ptr) {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    copy %v_1, %self, 4
    %v_2 = loads @drops, 4: I32
    %v_3 = add %v_2, 1: I32
    store @drops, %v_3, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 8, 4: Ptr
    %v_2 = alloca 8, 4: Ptr
    %v_3 = add %v_1, 4: Ptr
    store %v_3, 3, 4
    store %v_1, 1, 1
    %v_4 = add %v_2, 4: Ptr
    store %v_4, 4, 4
    store %v_2, 1, 1
    jmp b_5
  }

  b_6 {
    jmp b_7
  }

  b_7 {
    %v_8 = add %v_9, 7: I32
    ret %v_8
  }

  b_5 {
    %v_10 = load %v_2, 1: I32
    %v_11 = cmp_eq %v_10, 1: I32
    je %v_11, b_12, b_13
  }

  b_13 {
    jmp b_14
  }

  b_14 {
    jmp b_15
  }

  b_12 {
    %v_16 = loads %v_3, 4: I32
    %v_17 = loads %v_4, 4: I32
    %v_18 = cmp_eq %v_16, %v_17: I32
    jmp b_15
  }

  b_15 {
    %v_19 = phi [b_14, 0], [b_12, %v_18]: I32
    %v_20 = select %v_19, 1000, 0: I32
    jmp b_21
  }

  b_21 {
    %v_22 = load %v_2, 1: I32
    %v_23 = cmp_eq %v_22, 1: I32
    je %v_23, b_24, b_25
  }

  b_24 {
    %v_26 = loads %v_3, 4: I32
    %v_27 = loads %v_4, 4: I32
    %v_28 = add %v_26, %v_27: I32
    jmp b_29
  }

  b_25 {
    jmp b_30
  }

  b_30 {
    %v_31 = load %v_2, 1: I32
    %v_32 = cmp_eq %v_31, 0: I32
    je %v_32, b_33, b_34
  }

  b_34 {
    jmp b_29
  }

  b_33 {
    %v_35 = loads %v_3, 4: I32
    jmp b_29
  }

  b_29 {
    %v_36 = phi [b_34, 0], [b_33, %v_35], [b_24, %v_28]: I32
    call_complex teardown(Maybe(Held)), %v_1
    call_complex teardown(Maybe(Held)), %v_2
    %v_37 = add %v_20, %v_36: I32
    %v_38 = loads @drops, 4: I32
    %v_39 = imul %v_38, 10: I32
    %v_9 = add %v_37, %v_39: I32
    jmp b_6
  }
}

teardown(Maybe(Held))<complex>(%v_0: Ptr) {
  b_1 {
    %v_2 = load %v_0, 1: I32
    %v_3 = cmp_eq %v_2, 1: I32
    je %v_3, b_4, b_5
  }

  b_6 {
    ret 
  }

  b_4 {
    %v_7 = add %v_0, 4: Ptr
    call_complex Held.drop, %v_7
    jmp b_6
  }

  b_5 {
    jmp b_6
  }
}

