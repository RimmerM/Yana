mut @drops = [0, 0, 0, 0]

Held.drop<complex>() {
  b_0 {
    %v_1 = loads @drops, 4: I32
    %v_2 = add %v_1, 1: I32
    store @drops, %v_2, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 8, 4: Ptr
    %v_2 = alloca 8, 4: Ptr
    %v_3 = add %v_1, 4: Ptr
    store %v_3, 3, 4
    store %v_1, 1, 1
    %v_4 = add %v_2, 4: Ptr
    store %v_4, 4, 4
    store %v_2, 1, 1
    call_complex teardown(Maybe(Held)), %v_1
    call_complex teardown(Maybe(Held)), %v_2
    %v_5 = loads @drops, 4: I32
    %v_6 = imul %v_5, 10: I32
    %v_7 = add %v_6, 14: I32
    ret %v_7
  }
}

teardown(Maybe(Held))<complex>(%v_0: Ptr) {
  b_1 {
    %v_2 = load %v_0, 1: I32
    %v_3 = cmp_eq %v_2, 1: I32
    je %v_3, b_4, b_5
  }

  b_6 {
    ret 
  }

  b_4 {
    call_complex Held.drop
    jmp b_6
  }

  b_5 {
    jmp b_6
  }
}

