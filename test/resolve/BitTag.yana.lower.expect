@image$base = []

pickValue<complex>(%p: Ptr): I32 {
  b_0 {
    %v_1 = load %p, 2: I64
    %v_2 = shr %v_1, 8: I64
    %v_3 = and %v_2, 1: I64
    %v_4 = cast %v_3: I32
    je %v_4, b_5, b_6
  }

  b_5 {
    %rank = load %p, 1: I32
    %v_7 = add %rank, 3: I32
    jmp b_8
  }

  b_6 {
    %flag = load %p, 1: I32
    %v_9 = select %flag, 1, 2: I32
    jmp b_8
  }

  b_8 {
    %v_10 = phi [b_6, %v_9], [b_5, %v_7]: I32
    ret %v_10
  }
}

levelValue<complex>(%l: Ptr): I32 {
  b_0 {
    %v_1 = load %l, 2: I64
    %v_2 = shr %v_1, 8: I64
    %v_3 = and %v_2, 3: I64
    %v_4 = cast %v_3: I32
    %v_5 = cmp_eq %v_4, 0: I32
    je %v_5, b_6, b_7
  }

  b_7 {
    %v_8 = cmp_eq %v_4, 1: I32
    je %v_8, b_9, b_10
  }

  b_6 {
    jmp b_11
  }

  b_10 {
    %step = load %l, 1: I32
    %v_12 = add %step, 100: I32
    jmp b_11
  }

  b_9 {
    %step = load %l, 1: I32
    %v_13 = add %step, 10: I32
    jmp b_11
  }

  b_11 {
    %v_14 = phi [b_6, 0], [b_9, %v_13], [b_10, %v_12]: I32
    ret %v_14
  }
}

spanValue<complex>(%s: Ptr): I32 {
  b_0 {
    %v_1 = load %s, 4: I64
    %v_2 = shr %v_1, 16: I64
    %v_3 = and %v_2, 1: I64
    %v_4 = cast %v_3: I32
    je %v_4, b_5, b_6
  }

  b_5 {
    %n = load %s, 2: I32
    %v_7 = add %n, 1000: I32
    jmp b_8
  }

  b_6 {
    %n = load %s, 1: I32
    jmp b_8
  }

  b_8 {
    %v_9 = phi [b_6, %n], [b_5, %v_7]: I32
    ret %v_9
  }
}

maybeValue<complex>(%m: Ptr): I32 {
  b_0 {
    %v_1 = load %m, 2: I64
    %v_2 = cmp_le %v_1, 1023: I32
    je %v_2, b_3, b_4
  }

  b_3 {
    %v_5 = call_complex levelValue, %m: I32
    jmp b_6
  }

  b_4 {
    jmp b_6
  }

  b_6 {
    %v_7 = phi [b_4, 7], [b_3, %v_5]: I32
    ret %v_7
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 2, 2: Ptr
    store %v_1, 0, 2
    store %v_1, 1, 1
    %v_2 = call_complex pickValue, %v_1: I32
    %v_3 = alloca 2, 2: Ptr
    store %v_3, 256, 2
    store %v_3, 2, 1
    %v_4 = call_complex pickValue, %v_3: I32
    %v_5 = imul %v_4, 10: I32
    %picks = add %v_2, %v_5: I32
    %v_6 = alloca 2, 2: Ptr
    store %v_6, 0, 2
    %v_7 = call_complex levelValue, %v_6: I32
    %v_8 = alloca 2, 2: Ptr
    store %v_8, 256, 2
    store %v_8, 5, 1
    %v_9 = call_complex levelValue, %v_8: I32
    %v_10 = add %v_7, %v_9: I32
    %v_11 = alloca 2, 2: Ptr
    store %v_11, 512, 2
    store %v_11, 7, 1
    %v_12 = call_complex levelValue, %v_11: I32
    %levels = add %v_10, %v_12: I32
    %v_13 = alloca 4, 4: Ptr
    store %v_13, 0, 4
    store %v_13, 31, 1
    %v_14 = call_complex spanValue, %v_13: I32
    %v_15 = alloca 4, 4: Ptr
    store %v_15, 65536, 4
    store %v_15, 4095, 2
    %v_16 = call_complex spanValue, %v_15: I32
    %spans = add %v_14, %v_16: I32
    %v_17 = alloca 2, 2: Ptr
    store %v_17, 1024, 2
    %v_18 = call_complex maybeValue, %v_17: I32
    %v_19 = alloca 2, 2: Ptr
    store %v_19, 256, 2
    store %v_19, 2, 1
    %v_20 = call_complex maybeValue, %v_19: I32
    %maybes = add %v_18, %v_20: I32
    %v_21 = imul %levels, 10: I32
    %v_22 = add %picks, %v_21: I32
    %v_23 = imul %spans, 100: I32
    %v_24 = add %v_22, %v_23: I32
    %v_25 = imul %maybes, 1000: I32
    %v_26 = add %v_24, %v_25: I32
    %v_27 = alloca 2, 2: Ptr
    store %v_27, 256, 2
    store %v_27, 2, 1
    %v_28 = alloca 2, 2: Ptr
    store %v_28, 0, 2
    store %v_28, 0, 1
    %v_29 = call_complex pickValue, %v_27: I32
    %v_30 = imul %v_29, 10: I32
    %v_31 = call_complex pickValue, %v_28: I32
    %v_32 = add %v_30, %v_31: I32
    %v_33 = imul %v_32, 10000: I32
    %v_34 = add %v_26, %v_33: I32
    %v_35 = add %v_34, 12000000: I32
    ret %v_35
  }
}

