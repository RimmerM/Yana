  write.assign borrow.unique (state) take %25
  jump -> bb1

bb6:
  %20: I32 = read copy.trivial (k)
  %21: I32 = const 1
  %22: I32 = sub inspect %20 inspect %21
  %23: Step = aggregate.Go take %22
  jump -> bb5(take %23)
}

