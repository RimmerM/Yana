module ResolveTest

fn main() -> I32 {
  local limit: I32
  local & i: I32
  local & sum: I32
  local & done: Bool

bb0:
  %0: I32 = const 20
  write.init borrow.unique (limit) take %0
  %2: I32 = const 0
  write.init borrow.unique (i) take %2
  %4: I32 = const 0
  write.init borrow.unique (sum) take %4
  %6: Bool = const False
  write.init borrow.unique (done) take %6
  jump -> bb1

bb1:
  %9: I32 = read copy.trivial (i)
  %10: I32 = read copy.trivial (limit)
  %11: Bool = lt inspect %9 inspect %10
  branch inspect %11 -> bb3 -> bb2

bb2:
  %51: Bool = read copy.trivial (done)
  branch inspect %51 -> bb16 -> bb14

bb3:
  %13: Bool = read copy.trivial (done)
  %14: Bool = not inspect %13
  branch inspect %14 -> bb4 -> bb2

bb4:
  %16: I32 = read copy.trivial (i)
  %17: I32 = const 3
  %18: I32 = rem inspect %16 inspect %17
  %19: I32 = const 0
  %20: Bool = eq inspect %18 inspect %19
  branch inspect %20 -> bb7 -> bb5

bb5:
  %23: I32 = read copy.trivial (i)
  %24: I32 = const 5
  %25: I32 = rem inspect %23 inspect %24
  %26: I32 = const 0
  %27: Bool = eq inspect %25 inspect %26
  jump -> bb6(take %27)

bb6(%28: Bool):
  branch inspect %28 -> bb10 -> bb8

bb7:
  %22: Bool = const True
  jump -> bb6(take %22)

bb8:
  jump -> bb9

bb9:
  %38: I32 = read copy.trivial (sum)
  %39: I32 = const 60
  %40: Bool = gt inspect %38 inspect %39
  branch inspect %40 -> bb13 -> bb11

bb10:
  %32: I32 = read copy.trivial (sum)
  %33: I32 = read copy.trivial (i)
  %34: I32 = add inspect %32 inspect %33
  write.assign borrow.unique (sum) take %34
  jump -> bb9

bb11:
  jump -> bb12

bb12:
  %46: I32 = read copy.trivial (i)
  %47: I32 = const 1
  %48: I32 = add inspect %46 inspect %47
  write.assign borrow.unique (i) take %48
  jump -> bb1

bb13:
  %42: Bool = const True
  write.assign borrow.unique (done) take %42
  jump -> bb12

bb14:
  jump -> bb15

bb15:
  %56: I32 = read copy.trivial (sum)
  %57: I32 = const 1000
  %58: I32 = add inspect %56 inspect %57
  return take %58

bb16:
  %53: I32 = read copy.trivial (sum)
  return take %53
}

entry main
