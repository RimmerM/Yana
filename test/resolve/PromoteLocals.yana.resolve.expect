fn counted(%n: I32) -> I32 {
  b0:
    %total = alloc : I32
    init %total, 0
    %i = alloc : I32
    init %i, 0
    jmp b1

  b1:
    %v8 = load %i : I32
    %v9 = cmp_lt %v8, %n : Bool
    je %v9, b3, b2

  b2:
    %v24 = load %total : I32
    ret %v24

  b3:
    %v11 = load %total : I32
    %v14 = mul %v11, 10 : I32
    %v15 = load %i : I32
    %v16 = add %v14, %v15 : I32
    assign %total, %v16
    %v18 = load %i : I32
    %v21 = add %v18, 1 : I32
    assign %i, %v21
    jmp b1
