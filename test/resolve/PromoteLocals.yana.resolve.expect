fn Drop(Held).drop(%self: Held) -> () {
  b0:
    %v1 = load live : I32
    %v4 = sub %v1, 1 : I32
    assign live, %v4
    %v6 = load trace : I32
    %v9 = mul %v6, 10 : I32
    %v10 = load %self@Held.id : I32
    %v11 = add %v9, %v10 : I32
