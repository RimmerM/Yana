fn held(%id: I32) -> Held {
  b0:
    %v1 = load live : I32
    %v4 = add %v1, 1 : I32
    assign live, %v4
    %v6 = alloc : Held
    aggregate %local0@Held.id = %id
    ret %v6
}

fn owning(%n: I32) -> I32 {
  b0:
    %kept = call held, %n : Held
    drop %local0 via Drop(Held).drop
    %v4 = mul %n, 2 : I32
    ret %v4
}

fn record(%n: I32) -> I32 {
  b0:
    %v1 = alloc : Pair
    %v4 = add %n, 1 : I32
    aggregate %p@Pair.a = %n, %p@Pair.b = %v4
    %v6 = load %p : Pair
    %v7 = load %p@Pair.a : I32
    %v10 = mul %v7, 2 : I32
    assign %p@Pair.a, %v10
    %v12 = load %p : Pair
    %v13 = load %p@Pair.a : I32
    %v14 = load %p : Pair
    %v15 = load %p@Pair.b : I32
    %v16 = add %v13, %v15 : I32
    ret %v16
}

fn boolean(%a: Bool, %b: Bool) -> I32 {
  b0:
    %ok = alloc : Bool
    init %ok, %a
    je %b, b1, b2

  b1:
    %v6 = xor %a, True : Bool
    assign %ok, %v6
    jmp b3

  b2:
    jmp b3

  b3:
    %v10 = load %ok : Bool
    je %v10, b4, b5

  b4:
    jmp b6

  b5:
    jmp b6

  b6:
    %v16 = phi [b4, 1], [b5, 0] : I32
