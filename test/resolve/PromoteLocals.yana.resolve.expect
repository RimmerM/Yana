    %v78 = add %v77, %h : I32
    %v79 = add %v78, %j : I32
    %v80 = add %v79, %k : I32
    %v81 = load live : I32
    %v84 = mul %v81, 10000 : I32
    %v85 = add %v80, %v84 : I32
    %v86 = load trace : I32
    %v87 = add %v85, %v86 : I32
