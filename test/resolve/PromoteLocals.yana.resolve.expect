    %v36 = call record, 2 : I32
    %v39 = cmp_eq %v36, 7 : Bool
    %f = call check, %v39, 32 : I32
    %v44 = call boolean, True, False : I32
    %v47 = cmp_eq %v44, 1 : Bool
    %g = call check, %v47, 64 : I32
    %v52 = call boolean, True, True : I32
    %v55 = cmp_eq %v52, 0 : Bool
    %h = call check, %v55, 128 : I32
    %v59 = call narrow, 5 : I32
    %v62 = cmp_eq %v59, 1 : Bool
    %j = call check, %v62, 256 : I32
    %v66 = call twice, 6 : I32
    %v69 = cmp_eq %v66, 66 : Bool
    %k = call check, %v69, 512 : I32
    %v72 = add %a, %b : I32
    %v73 = add %v72, %c : I32
    %v74 = add %v73, %d : I32
    %v75 = add %v74, %e : I32
