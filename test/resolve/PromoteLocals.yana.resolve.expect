  b0:
    %v3 = mul %x, 10 : I32
    %v4 = add %v3, %x : I32
    ret %v4
}

fn main() -> I32 {
  b0:
    %v1 = call branched, 5 : I32
    %v4 = cmp_eq %v1, 10 : Bool
    %a = call check, %v4, 1 : I32
    %v8 = call branched, 1 : I32
    %v11 = cmp_eq %v8, 3 : Bool
    %b = call check, %v11, 2 : I32
    %v15 = call counted, 3 : I32
    %v18 = cmp_eq %v15, 12 : Bool
