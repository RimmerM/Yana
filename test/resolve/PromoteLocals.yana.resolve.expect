fn branched(%n: I32) -> I32 {
  b0:
    %v = alloc : I32
    init %v, 0
    %v6 = cmp_gt %n, 2 : Bool
    je %v6, b1, b2

  b1:
    %v10 = mul %n, 2 : I32
    assign %v, %v10
    jmp b3

  b2:
    %v14 = mul %n, 3 : I32
    assign %v, %v14
