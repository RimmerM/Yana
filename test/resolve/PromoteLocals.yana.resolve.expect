fn packed(%value: U32) -> Packed {
  b0:
    %v1 = alloc : Packed
    %v3 = and %value, 15 : U32
    %value = cast %v3 : @bits(4) U32
    aggregate %local0@Packed.small = %value
    ret %v1
}

fn narrow(%n: I32) -> I32 {
  b0:
    %v2 = call packed, 3 : Packed
    %v3 = load %local0@Packed.small : @bits(4) U32
    %small = alloc : @bits(4) U32
    init %small, %v3
    %v8 = cmp_gt %n, 2 : Bool
    je %v8, b1, b2

  b1:
    %v11 = call packed, 10 : Packed
    %v12 = load %local2@Packed.small : @bits(4) U32
    assign %small, %v12
    jmp b3

  b2:
    jmp b3

  b3:
    %v16 = load %small : @bits(4) U32
    %v18 = cast %v16 : U32
    %v20 = cmp_eq %v18, 10 : Bool
    je %v20, b4, b5

  b4:
    jmp b6

  b5:
    jmp b6

  b6:
    %v26 = phi [b4, 1], [b5, 0] : I32
