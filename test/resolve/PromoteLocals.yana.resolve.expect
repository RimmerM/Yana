let image$base: () = <none>

let &live: I32 = 0

let &trace: I32 = 0

fn check(%ok: Bool, %weight: I32) -> I32 {
  b0:
    je %ok, b1, b2

  b1:
    jmp b3

  b2:
    jmp b3

  b3:
    %v6 = phi [b1, %weight], [b2, 0] : I32
