}

fn borrowed(%n: I32) -> I32 {
  b0:
    %v = alloc : I32
    init %v, %n
    %v3 = load %v : I32
    %v4 = borrow_mut %v : &I32
    call bump, %v4
    %v6 = load %v : I32
    ret %v6
