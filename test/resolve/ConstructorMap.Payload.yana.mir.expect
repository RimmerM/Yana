  %61: Shape = aggregate.Square take %59 take %60
  %62: Shape = call opaque borrow.shared %61
  %63: Bool = call closed borrow.shared %62
  jump -> bb8(take %63, take %57)

bb10(%76: I32):
  %83: Bool = const False
  jump -> bb11(take %83, take %76)

bb11(%84: Bool, %85: I32):
  %88: I32 = const 16
