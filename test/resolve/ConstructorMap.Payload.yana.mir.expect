  %101: I32 = const 1
  %102: Shape = aggregate.Segment take %100 take %101
  %103: Shape = call opaque borrow.shared %102
  %104: Bool = call isSegment borrow.shared %103
  branch inspect %104 -> bb15(take %99) -> bb13(take %99)

bb12(%77: I32):
  %79: Shape = aggregate.Point
  %80: Shape = call opaque borrow.shared %79
  %81: Bool = call closed borrow.shared %80
  %82: Bool = not inspect %81
  jump -> bb11(take %82, take %77)

bb13(%105: I32):
  %113: Bool = const False
  jump -> bb14(take %113, take %105)

bb14(%114: Bool, %115: I32):
  %118: I32 = const 64
  %119: I32 = call check borrow.shared %114 borrow.shared %118
  %120: I32 = add inspect %115 inspect %119
  %121: I32 = const 1
  %122: Shape = aggregate.Circle take %121
  %123: Shape = call opaque borrow.shared %122
  %124: Family = call familyOf borrow.shared %123
  %125: Family = const Round
  %126: Bool = eq inspect %124 inspect %125
  branch inspect %126 -> bb18(take %120) -> bb16(take %120)

bb15(%106: I32):
  %108: I32 = const 1
  %109: Shape = aggregate.Circle take %108
  %110: Shape = call opaque borrow.shared %109
  %111: Bool = call isSegment borrow.shared %110
  %112: Bool = not inspect %111
  jump -> bb14(take %112, take %106)

bb16(%127: I32):
  %135: Bool = const False
  jump -> bb17(take %135, take %127)

bb17(%136: Bool, %137: I32):
  %140: I32 = const 128
  %141: I32 = call check borrow.shared %136 borrow.shared %140
  %142: I32 = add inspect %137 inspect %141
  %143: I32 = const 1
  %144: I32 = const 1
