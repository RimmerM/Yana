module ResolveTest

data Shape = Circle {Circle: I32} | Square {width: I32, height: I32} | Point | Segment {from: I32, to: I32} | Poly {Poly: I32}

data Family = Round | Straight | Degenerate

fn sides(s: Shape [shared call]) -> I32 {
bb0:
  %0: U8 = read copy.trivial (s.#)
  %1: I32 = map [0 -> 1, 1 -> 4, 2 -> 0, 3 -> 2, 4 -> 5] inspect %0
  return take %1
}

fn closed(s: Shape [shared call]) -> Bool {
bb0:
  %0: U8 = read copy.trivial (s.#)
  %1: Bool = map [0 -> True, 1 -> True, 2 -> False, 3 -> False, 4 -> True] inspect %0
  return take %1
}

fn isSegment(s: Shape [shared call]) -> Bool {
bb0:
  %0: U8 = read copy.trivial (s.#)
  %1: Bool = map [0 -> False, 1 -> False, 2 -> False, 3 -> True, 4 -> False] inspect %0
  return take %1
}

fn familyOf(s: Shape [shared call]) -> Family {
bb0:
  %0: U8 = read copy.trivial (s.#)
  %1: Family = map [0 -> Round, 1 -> Straight, 2 -> Degenerate, 3 -> Straight, 4 -> Straight] inspect %0
  return take %1
}

fn radius(s: Shape [shared call]) -> I32 {
  local r: I32

bb0:
  %0: U8 = read copy.trivial (s.#)
  %1: U8 = const 0
  %2: Bool = eq inspect %0 inspect %1
  branch inspect %2 -> bb3 -> bb1

bb1:
  %7: I32 = const 0
  jump -> bb2(take %7)

bb2(%8: I32):
  return take %8

bb3:
  %4: I32 = read copy.trivial (s.Circle)
  write.init borrow.unique (r) take %4
  %6: I32 = read copy.trivial (r)
  jump -> bb2(take %6)
}

fn bigCircle(s: Shape [shared call]) -> I32 {
bb0:
  %0: U8 = read copy.trivial (s.#)
  %1: U8 = const 0
  %2: Bool = eq inspect %0 inspect %1
  branch inspect %2 -> bb4 -> bb1

bb1:
  %9: U8 = read copy.trivial (s.#)
  %10: U8 = const 0
  %11: Bool = eq inspect %9 inspect %10
  branch inspect %11 -> bb6 -> bb2

bb2:
  %14: I32 = const 0
  jump -> bb3(take %14)

bb3(%15: I32):
  return take %15

bb4:
  %4: I32 = read copy.trivial (s.Circle)
  %5: I32 = const 100
  %6: Bool = ge inspect %4 inspect %5
  branch inspect %6 -> bb5 -> bb1

bb5:
  %8: I32 = const 2
  jump -> bb3(take %8)

bb6:
  %13: I32 = const 1
  jump -> bb3(take %13)
}

fn computed(s: Shape [shared call]) -> I32 {
bb0:
  %0: Shape = read copy.trivial (s)
  %1: I32 = call sides borrow.shared %0
  return take %1
}

fn mixed(s: Shape [shared call]) -> I32 {
  local other: Shape

bb0:
  %0: U8 = read copy.trivial (s.#)
  %1: U8 = const 2
  %2: Bool = eq inspect %0 inspect %1
  branch inspect %2 -> bb3 -> bb1

bb1:
  %5: Shape = read copy.trivial (s)
  write.init borrow.unique (other) take %5
  %7: Shape = read copy.trivial (other)
  %8: I32 = call computed borrow.shared %7
  jump -> bb2(take %8)

bb2(%9: I32):
  return take %9

bb3:
  %4: I32 = const 0
  jump -> bb2(take %4)
}

fn opaque(s: Shape [shared call]) -> Shape {
bb0:
  %0: Shape = read copy.trivial (s)
  return take %0
}

fn check(condition: Bool [shared call], weight: I32 [shared call]) -> I32 {
bb0:
  %0: Bool = read copy.trivial (condition)
  branch inspect %0 -> bb3 -> bb1

bb1:
  %3: I32 = const 0
  jump -> bb2(take %3)

bb2(%4: I32):
  return take %4

bb3:
  %2: I32 = read copy.trivial (weight)
  jump -> bb2(take %2)
}

fn main() -> I32 {
bb0:
  %0: I32 = const 1
  %1: Shape = aggregate.Circle take %0
  %2: Shape = call opaque borrow.shared %1
  %3: I32 = call sides borrow.shared %2
  %4: I32 = const 1
  %5: Bool = eq inspect %3 inspect %4
  branch inspect %5 -> bb3 -> bb1

bb1:
  %12: Bool = const False
  jump -> bb2(take %12)

bb2(%13: Bool):
  %16: I32 = const 1
