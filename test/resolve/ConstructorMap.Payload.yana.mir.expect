  %52: I32 = const 1
  %53: Shape = aggregate.Circle take %52
  %54: Shape = call opaque borrow.shared %53
  %55: Bool = call closed borrow.shared %54
  branch inspect %55 -> bb9(take %51) -> bb7(take %51)

