fn sumInts(xs: Array(I32) [shared call view]) -> I32 {
  local & acc: Vec(I32)
  local v: Vec(I32) [shared call]

bb0:
  %0: I32 = const 0
  %1: Vec(I32) = vec.splat inspect %0
  write.init borrow.unique (acc) take %1
  %3: Array(I32) [shared call view] = read borrow.shared (xs) loan0
  lens.call vectors(Array(I32), I32) borrow.shared %3 -> bb2

bb1:
  %12: Vec(I32) = read copy.trivial (acc)
  %13: I32 = vec.reduce add inspect %12
  return take %13

bb2(%4: Vec(I32) [shared call]) handover(Vec(I32) [shared call]) many -> bb1:
  write.init borrow.unique (v) borrow.shared %4
  %7: Vec(I32) = read copy.trivial (acc)
  %8: Vec(I32) = read copy.trivial (v)
  %9: Vec(I32) = add inspect %7 inspect %8
  write.assign borrow.unique (acc) take %9
  jump -> bb1
}

