fn total(xs: c [shared call]) -> a {
  form specialized
  slot #0 type c
  slot #1 type a
  slot #2 class Chunked(c, a)
  slot #3 class Num(Vec(a))
  local & acc: Vec(a)
  local v: Vec(a) [shared call]

bb0:
  %0: a = const 0
  %1: Vec(a) = vec.splat inspect %0
  write.init borrow.unique (acc) take %1
  %3: c [shared call] = read borrow.shared (xs) loan0
  lens.call vectors(c, a) borrow.shared %3 -> bb2

bb1:
  %12: Vec(a) = read copy.trivial (acc)
  %13: a = vec.reduce add inspect %12
  return take %13

bb2(%4: Vec(a) [shared call]) handover(Vec(a) [shared call]) many -> bb1:
  write.init borrow.unique (v) borrow.shared %4
  %7: Vec(a) = read copy.trivial (acc)
  %8: Vec(a) = read copy.trivial (v)
  %9: Vec(a) = call +(Vec(a)) borrow.shared %7 borrow.shared %8
  write.assign borrow.unique (acc) take %9
  jump -> bb1
}

