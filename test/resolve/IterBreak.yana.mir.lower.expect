ticks<complex>(%n: I32, %$body: Ptr): I32 {
  b_0 {
    %v_1 = alloca 16, 8: Ptr
    %v_2 = load @runBorrowed, 4: I32
    %v_3 = and %v_2, 3: I32
    store %v_1, @string, 8
    %v_4 = add %v_1, 8: Ptr
    %v_5 = load %v_4, 4: I64
    %v_6 = cast %v_3: I64
    %v_7 = shl %v_6, 30: I64
    %v_8 = or 3, %v_7: I64
    store %v_4, %v_8, 4
    %v_9 = add %v_1, 12: Ptr
    store %v_9, 3, 4
    %v_10 = cmp_ilt %n, 0: I32
    je %v_10, b_11, b_12
  }

  b_13 {
    %v_14 = phi [b_12, %v_15], [b_11, %v_16]: I32
    jmp b_17
  }

  b_12 {
    %v_18 = load %v_1, 8: Ptr
    %v_19 = load %v_9, 4: I32
    %v_20 = cast %v_19: I64
    call_complex String.reclaim, %v_1
    %v_21 = sext %v_20: I32
    %v_22 = load %$body, 8: Ptr
    %v_23 = add %$body, 8: Ptr
    %v_24 = load %v_23, 8: Ptr
    %v_15 = call_complex %v_22, %v_24, %v_21: I32
    jmp b_13
  }

  b_11 {
    call_complex String.reclaim, %v_1
    %v_25 = load %$body, 8: Ptr
    %v_26 = add %$body, 8: Ptr
    %v_27 = load %v_26, 8: Ptr
    %v_16 = call_complex %v_25, %v_27, 18446744073709551615: I32
    jmp b_13
  }

  b_17 {
    ret %v_14
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    store %v_1, 0, 4
    %v_2 = alloca 8, 8: Ptr
    store %v_2, %v_1, 8
    %v_3 = alloca 16, 8: Ptr
    store %v_3, main.cont'2, 8
    %v_4 = add %v_3, 8: Ptr
    store %v_4, %v_2, 8
    %v_5 = call_complex ticks, 3, %v_3: I32
    %v_6 = alloca 8, 8: Ptr
    store %v_6, %v_1, 8
    %v_7 = alloca 16, 8: Ptr
    store %v_7, main.cont, 8
    %v_8 = add %v_7, 8: Ptr
    store %v_8, %v_6, 8
    %v_9 = call_complex ticks, 18446744073709551613, %v_7: I32
    %v_10 = loads %v_1, 4: I32
    ret %v_10
  }
}

main.cont<complex>(%main.cont.env: Ptr, %$handed: I32): I32 {
  b_0 {
    %v_1 = load %main.cont.env, 8: Ptr
    %v_2 = loads %v_1, 4: I32
    %v_3 = add %v_2, %$handed: I32
