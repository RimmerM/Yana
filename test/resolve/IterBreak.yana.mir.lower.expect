    %v_6 = loads %v_5, 8: I64
    %v_7 = load @heapFree, 8: Ptr
    %v_8 = shl %v_6, 3: I64
    %v_9 = add %v_7, %v_8: Ptr
    %v_10 = load %v_9, 8: Ptr
