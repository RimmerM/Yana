  write.init borrow.unique (d) take %15
  %17: %U8 = read copy.trivial (p)
  %18: Bool = call isNull(U8) borrow.shared %17
  branch inspect %18 -> bb3 -> bb1

bb1:
  %23: I32 = const 0
  jump -> bb2(take %23)

bb2(%24: I32):
