fn add1(x: I32 [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (x)
  %1: I32 = const 1
  %2: I32 = add inspect %0 inspect %1
  return take %2
}

fn scaled(x: I32 [shared call], by: I32 [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (x)
  %1: I32 = read copy.trivial (by)
  %2: I32 = mul inspect %0 inspect %1
  %3: I32 = const 1
  %4: I32 = add inspect %2 inspect %3
  return take %4
}

fn widened(x: U8 [shared call]) -> I32 {
bb0:
  %0: U8 = read copy.trivial (x)
