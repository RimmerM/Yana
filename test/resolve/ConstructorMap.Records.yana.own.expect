fn cornerOf {
  arg c readonly
  result escapes
}

fn axesOf {
  arg c readonly
  result escapes
}

fn boxOf {
  arg c readonly
  result escapes
}

fn hintOf {
  arg c readonly
  result escapes
}

fn always {
  arg c readonly
  %local0: Point readonly live [0, 4)
}

fn tokenOf {
  arg c readonly
  %local0: Token droppable readonly live [6, 9)
  %local1: Token droppable readonly live [12, 15)
  %local2: Token droppable readonly live [18, 21)
  %local3: Token droppable readonly live [15, 18)
  %local4: Token droppable readonly live [21, 23)
}

fn opaque {
  arg c readonly
}

fn check {
  arg condition readonly
  arg weight readonly
}

fn independent {
  arg c readonly
  %local0: Point readonly live [0, 3)
  %first: Point writable live [1, 7)
  %local2: Point readonly live [3, 10)
}

fn main {
  %local0: Point readonly live [1, 3)
  %local1: Point readonly live [6, 8)
  %local2: Point readonly live [14, 16)
  %local3: Point readonly live [19, 21)
  %local4: Point readonly live [28, 30)
  %local5: Point readonly live [33, 35)
  %local6: {Int, Bool, Float} readonly live [42, 44)
  %local7: {Int, Bool, Float} readonly live [47, 49)
  %local8: {Int, Bool, Float} readonly live [55, 57)
  %local9: {Int, Bool, Float} readonly live [60, 62)
  %local10: {Int, Bool, Float} readonly live [69, 71)
  %local11: {Int, Bool, Float} readonly live [74, 76)
  %local12: Box readonly live [83, 86)
  %local13: Box readonly live [89, 92)
  %local14: Box readonly live [99, 102)
  %local15: Box readonly live [105, 108)
  %local16: Box readonly live [115, 118)
  %local17: Maybe(Int) readonly live [122, 124)
  %local18: Maybe(Int) readonly live [132, 136) [137, 138)
  %local19: Point readonly live [145, 147)
  %local20: Point readonly live [150, 152)
  %local21: Token droppable readonly live [159, 161)
  %local22: Token droppable readonly live [164, 166)
