    %v_8 = bitcast %allocation: Ptr
    %v_9 = load @heapFree, 8: Ptr
    %v_10 = shl %sizeClass, 3: Long
    %v_11 = add %v_9, %v_10: Ptr
    %v_12 = load %v_11, 8: Ptr
