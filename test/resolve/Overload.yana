-- Overload sets, per Design.md's Overloading section: a set is keyed by (name, arity), a plain
-- function is one of its members rather than a shadow over it, and ambiguity is settled by
-- naming a class rather than by a tiebreak.

data Permissions {bits: Int}

-- R5: this used to disable `Integral.and` for every Int in the module. It is now one candidate of
-- the `(and, 2)` set, so it serves the calls it fits and leaves the rest to the class half.
fn and(a: Permissions, b: Permissions) -> Permissions = Permissions {bits: a.bits `and` b.bits}

fn mask(a: Int, b: Int) -> Int = a `and` b                    -- Integral.and, still reachable

fn combined(a: Int, b: Int) -> Int =
    and(Permissions {bits: a}, Permissions {bits: b}).bits    -- the plain function

fn bothTrue(a: Bool, b: Bool) -> Bool = a `and` b             -- Bitwise.and, and so is `mask` above

-- Qualifying a class function names the class, whether or not anything was ambiguous.
fn maskQualified(a: Int, b: Int) -> Int = Bitwise.and(a, b)

fn bothQualified(a: Bool, b: Bool) -> Bool = Bitwise.and(a, b)

-- A constraint reaching a *superclass*'s function. `and` is `Bitwise`'s and this body only promises
-- `Integral`, which declares `Bitwise` as a superclass - so the call is available for the same
-- reason `x + 1` is available under `Num`, which promises `FromInt`.
fn (Integral(a)) maskGeneric(x: a, y: a) -> a = x `and` y

fn (Bitwise(a)) bothGeneric(x: a, y: a) -> a = x `and` y

{-
   R3 and R4, over two classes that genuinely share a name.

   Declared here rather than reached for in Core, and the reason is worth writing down: these rules
   used to be demonstrated with `and`, which was declared by both `Integral` and `Logic`. That was an
   accident of Core's layout rather than a design - the two declarations were identical and no type
   was ever in both - and splitting `Bitwise` out left exactly one `and` in the language. Core's real
   two-class name is `+`, in `Num` and `Append`, and an operator cannot be written `Num.+`, so a
   fixture for the qualified form has to bring its own pair.
-}
class Area(a):
    fn size(value: a) -> Int

class Volume(a):
    fn size(value: a) -> Int

data Square {side: Int}
data Cube {side: Int}

instance Area(Square):
    fn size(value: Square) -> Int = value.side * value.side

instance Volume(Cube):
    fn size(value: Cube) -> Int = value.side * value.side * value.side

-- R4: the same name in two classes is disambiguated by writing the class. Both of these are
-- unambiguous by argument type as well - the point is that the qualified form names one class and
-- gets that one.
fn areaQualified(s: Square) -> Int = Area.size(s)

fn volumeQualified(c: Cube) -> Int = Volume.size(c)

-- R3: in generic code no instance exists yet to break the tie, so the constraint in scope decides
-- which class `size` belongs to. Each of these is the same call text resolving to a different class.
fn (Area(a)) areaGeneric(x: a) -> Int = size(x)

fn (Volume(a)) volumeGeneric(x: a) -> Int = size(x)

-- R1: one class declares `-` at two arities, and which is meant is the arity of the call.
fn negated(a: Int) -> Int = -a

fn difference(a: Int, b: Int) -> Int = a - b

fn main() -> Int =
    mask(6, 3) + combined(6, 3) + maskQualified(12, 10) + maskGeneric(5, 4) +
    difference(negated(1) + 10, 2) +
    (if bothTrue(True, False) then 100 else 0) +
    (if bothQualified(True, True) then 1000 else 0) +
    (if bothGeneric(True, False) then 10000 else 0) +
    areaQualified(Square {side: 3}) + volumeQualified(Cube {side: 2}) +
    areaGeneric(Square {side: 4}) + volumeGeneric(Cube {side: 3})
