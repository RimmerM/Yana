@image$base = []

reductions<complex>(): Int {
  b_0 {
    %ones = vsplat 1: i32x8
    %count = vreduce_add %ones: Int
    %v_1 = cmp_ilt %count, 2: Int
    je %v_1, b_2, b_3
  }

  b_2 {
    ret 18446744073709551615
  }

  b_3 {
    jmp b_4
  }

  b_4 {
    %v_5 = vreduce_mul %ones: Int
    %v_6 = cmp_neq %v_5, 1: Int
    je %v_6, b_7, b_8
  }

  b_7 {
    ret 18446744073709551614
  }

  b_8 {
    jmp b_9
  }

  b_9 {
    %sevens = vsplat 7: i32x8
    %v_10 = vreduce_add %sevens: Int
    %v_11 = imul %count, 7: Int
    %v_12 = cmp_neq %v_10, %v_11: Int
    je %v_12, b_13, b_14
  }

  b_13 {
    ret 18446744073709551613
  }

  b_14 {
    jmp b_15
  }

  b_15 {
    %v_16 = vreduce_imin %sevens: Int
    %v_17 = cmp_neq %v_16, 7: Int
    je %v_17, b_18, b_19
  }

  b_18 {
    ret 18446744073709551612
  }

  b_19 {
    jmp b_20
  }

  b_20 {
    %v_21 = vwithlane %sevens, 9, 0: i32x8
    %v_22 = vreduce_imax %v_21: Int
    %v_23 = cmp_neq %v_22, 9: Int
    je %v_23, b_24, b_25
  }

  b_24 {
    ret 18446744073709551611
  }

  b_25 {
    jmp b_26
  }

  b_26 {
    %v_27 = vwithlane %sevens, 2, 1: i32x8
    %v_28 = vreduce_imin %v_27: Int
    %v_29 = cmp_neq %v_28, 2: Int
    je %v_29, b_30, b_31
  }

  b_30 {
    ret 18446744073709551610
  }

  b_31 {
    jmp b_32
  }

  b_32 {
    ret 0
  }
}

floats<complex>(): Int {
  b_0 {
    %a = vsplat 1.5: f32x8
    %b = vsplat 2: f32x8
    %scaled = mul %a, %b: f32x8
    %v_1 = vlane %scaled, 0: Float
    %v_2 = cmp_neq %v_1, 3: Int
    je %v_2, b_3, b_4
  }

  b_3 {
    ret 18446744073709551615
  }

  b_4 {
    jmp b_5
  }

  b_5 {
    %v_6 = add %a, %b: f32x8
    %v_7 = vlane %v_6, 1: Float
    %v_8 = cmp_neq %v_7, 3.5: Int
    je %v_8, b_9, b_10
  }

  b_9 {
    ret 18446744073709551614
  }

  b_10 {
    jmp b_11
  }

  b_11 {
    %v_12 = neg %a: f32x8
    %v_13 = vlane %v_12, 0: Float
    %v_14 = cmp_neq %v_13, -1.5: Int
    je %v_14, b_15, b_16
  }

  b_15 {
    ret 18446744073709551613
  }

  b_16 {
    jmp b_17
  }

  b_17 {
    ret 0
  }
}

main<complex>(): Int {
  b_0 {
    %v_1 = call_complex reductions: Int
    %v_2 = cmp_neq %v_1, 0: Int
    je %v_2, b_3, b_4
  }

  b_3 {
    %v_5 = call_complex reductions: Int
    ret %v_5
  }

  b_4 {
    jmp b_6
  }

  b_6 {
    %v_7 = call_complex floats: Int
    %v_8 = cmp_neq %v_7, 0: Int
    je %v_8, b_9, b_10
  }

  b_9 {
    %v_11 = call_complex floats: Int
    %v_12 = imul %v_11, 10: Int
    ret %v_12
  }

  b_10 {
    jmp b_13
  }

  b_13 {
    %a = vsplat 3: i32x8
    %b = vsplat 4: i32x8
    %sum = add %a, %b: i32x8
    %v_14 = vsplat 2: i32x8
    %product = shl %a, %v_14: i32x8
    %difference = sub %b, %a: i32x8
    %v_15 = vlane %sum, 0: Int
    %v_16 = imul %v_15, 100: Int
    %v_17 = vlane %product, 0: Int
    %v_18 = add %v_16, %v_17: Int
    %v_19 = vlane %difference, 1: Int
    %v_20 = add %v_18, %v_19: Int
    %a = vsplat 12: i32x8
    %b = vsplat 10: i32x8
    %v_21 = and %a, %b: i32x8
    %v_22 = vlane %v_21, 0: Int
    %v_23 = imul %v_22, 100: Int
    %v_24 = or %a, %b: i32x8
    %v_25 = vlane %v_24, 0: Int
    %v_26 = add %v_23, %v_25: Int
    %v_27 = xor %a, %b: i32x8
    %v_28 = vlane %v_27, 1: Int
    %v_29 = add %v_26, %v_28: Int
    %v_30 = add %v_20, %v_29: Int
    %v = vsplat 5: i32x8
    %changed = vwithlane %v, 9, 1: i32x8
    %v_31 = vlane %changed, 0: Int
    %v_32 = imul %v_31, 100: Int
    %v_33 = vlane %changed, 1: Int
    %v_34 = add %v_32, %v_33: Int
    %v_35 = add %v_30, %v_34: Int
    ret %v_35
  }
