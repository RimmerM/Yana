@image$base = []
mut @heapNext = [0, 0, 0, 0, 0, 0, 0, 0]
mut @heapLimit = [0, 0, 0, 0, 0, 0, 0, 0]
mut @heapFree = [0, 0, 0, 0, 0, 0, 0, 0]
mut @heapRegionNext = [0, 0, 0, 0, 0, 0, 0, 0]
mut @liveBuffers = [0, 0, 0, 0, 0, 0, 0, 0]

+=(I64)<complex>(%target: Ptr, %amount: Long) {
  b_0 {
    %v_1 = loads %target, 8: Long
    %v_2 = add %v_1, %amount: Long
    store %target, %v_2, 8
    ret 
  }
}

-=(I64)<complex>(%target: Ptr, %amount: Long) {
  b_0 {
    %v_1 = loads %target, 8: Long
    %v_2 = sub %v_1, %amount: Long
    store %target, %v_2, 8
    ret 
  }
}

growHeap<complex>(%needed: Long): Int {
  b_0 {
    %v_1 = loads @heapRegionNext, 8: Long
    %v_2 = cmp_ilt %v_1, %needed: Int
    je %v_2, b_3, b_4
  }

  b_3 {
    jmp b_5
  }

  b_4 {
    jmp b_5
  }

  b_5 {
    %v_6 = phi [b_3, %needed], [b_4, %v_1]: Long
    %v_7 = add %v_6, 4096: Long
    %v_8 = call_complex mapMemory, %v_7: Ptr
    %v_9 = bitcast %v_8: Long
    %v_10 = cmp_eq %v_9, 0: Int
    je %v_10, b_11, b_12
  }

  b_11 {
    %v_13 = cmp_igt %needed, 4194304: Int
    %least = select %v_13, %needed, 4194304: Long
    %v_14 = cmp_ige %least, %v_6: Int
    je %v_14, b_15, b_16
  }

  b_12 {
    jmp b_17
  }

  b_15 {
    ret 0
  }

  b_16 {
    %v_18 = add %least, 4096: Long
    %v_19 = call_complex mapMemory, %v_18: Ptr
    %v_20 = bitcast %v_19: Long
    %v_21 = cmp_eq %v_20, 0: Int
    je %v_21, b_15, b_22
  }

  b_22 {
    jmp b_17
  }

  b_17 {
    %v_23 = phi [b_12, %v_6], [b_22, %least]: Long
    %v_24 = phi [b_12, %v_8], [b_22, %v_19]: Ptr
    store @heapNext, %v_24, 8
    %v_25 = add %v_24, %v_23: Ptr
    store @heapLimit, %v_25, 8
    %v_26 = add %v_23, %v_23: Long
    store @heapRegionNext, %v_26, 8
    ret 1
  }
}

allocateHeap<complex>(%size: Long): Ptr {
  b_0 {
    %v_1 = load @heapFree, 8: Ptr
    %v_2 = bitcast %v_1: Long
    %v_3 = cmp_eq %v_2, 0: Int
    je %v_3, b_4, b_5
  }

  b_5 {
    jmp b_6
  }

  b_4 {
    %result = syscall 9, 0, 4198400, 3, 34, 18446744073709551615, 0: Long
    %v_7 = cmp_ilt %result, 0: Int
    %v_8 = bitcast 0: Ptr
    %v_9 = bitcast %result: Ptr
    %region = select %v_7, %v_8, %v_9: Ptr
    %v_10 = bitcast %region: Long
    %v_11 = cmp_eq %v_10, 0: Int
    je %v_11, b_12, b_13
  }

  b_13 {
    setpattern %region, 256, 0
    store @heapFree, %region, 8
    %v_14 = add %region, 256: Ptr
    store @heapNext, %v_14, 8
    %v_15 = add %region, 4194304: Ptr
    store @heapLimit, %v_15, 8
    store @heapRegionNext, 8388608, 8
    jmp b_16
  }

  b_12 {
    jmp b_16
  }

  b_16 {
    %v_17 = load @heapFree, 8: Ptr
    %v_18 = bitcast %v_17: Long
    %v_19 = cmp_eq %v_18, 0: Int
    je %v_19, b_20, b_21
  }

  b_21 {
    jmp b_6
  }

  b_6 {
    %v_22 = add %size, 8: Long
    jmp b_23
  }

  b_23 {
    %v_24 = phi [b_6, 16], [b_25, %v_26]: Long
    %v_27 = phi [b_6, 0], [b_25, %v_28]: Long
    %v_29 = cmp_ilt %v_24, %v_22: Int
    je %v_29, b_25, b_30
  }

  b_30 {
    %v_31 = cmp_ige %v_27, 32: Int
    je %v_31, b_32, b_33
  }

  b_33 {
    %v_34 = load @heapFree, 8: Ptr
    %v_35 = shl %v_27, 3: Long
    %v_36 = add %v_34, %v_35: Ptr
    %v_37 = load %v_36, 8: Ptr
    %v_38 = bitcast %v_37: Long
    %v_39 = cmp_eq %v_38, 0: Int
    je %v_39, b_40, b_41
  }

  b_40 {
    %v_42 = shl 16, %v_27: Long
    %v_43 = load @heapNext, 8: Ptr
    %v_44 = add %v_43, %v_42: Ptr
    %v_45 = load @heapLimit, 8: Ptr
    %v_46 = cmp_gt %v_44, %v_45: Int
    je %v_46, b_47, b_48
  }

  b_48 {
    jmp b_49
  }

  b_47 {
    %v_50 = call_complex growHeap, %v_42: Int
    %v_51 = xor %v_50, 1: Int
    je %v_51, b_32, b_52
  }

  b_52 {
    jmp b_49
  }

  b_49 {
    %block = load @heapNext, 8: Ptr
    %v_53 = add %block, %v_42: Ptr
    store @heapNext, %v_53, 8
    store %block, %v_27, 8
    %v_54 = add %block, 8: Ptr
    ret %v_54
  }

  b_32 {
    %v_55 = bitcast 0: Ptr
    ret %v_55
  }

  b_41 {
    %v_56 = load %v_37, 8: Ptr
    store %v_36, %v_56, 8
    ret %v_37
  }

  b_25 {
    %v_26 = add %v_24, %v_24: Long
    %v_28 = add %v_27, 1: Long
    jmp b_23
  }

  b_20 {
    ret %v_8
  }
}

freeHeap<complex>(%allocation: Ptr) {
  b_0 {
    %v_1 = bitcast %allocation: Long
    %v_2 = cmp_eq %v_1, 0: Int
    je %v_2, b_3, b_4
  }

  b_3 {
    ret 
  }

  b_4 {
    jmp b_5
  }

  b_5 {
    %v_6 = sub %allocation, 8: Ptr
    %sizeClass = loads %v_6, 8: Long
    %v_7 = load @heapFree, 8: Ptr
    %v_8 = shl %sizeClass, 3: Long
    %v_9 = add %v_7, %v_8: Ptr
    %v_10 = load %v_9, 8: Ptr
    store %allocation, %v_10, 8
    %v_11 = load @heapFree, 8: Ptr
    %v_12 = add %v_11, %v_8: Ptr
    store %v_12, %allocation, 8
    ret 
  }
}

mapMemory<complex>(%size: Long): Ptr {
  b_0 {
    %result = syscall 9, 0, %size, 3, 34, 18446744073709551615, 0: Long
    %v_1 = cmp_ilt %result, 0: Int
    je %v_1, b_2, b_3
  }

  b_2 {
    %v_4 = bitcast 0: Ptr
    ret %v_4
  }

  b_3 {
    jmp b_5
  }

  b_5 {
    %v_6 = bitcast %result: Ptr
    ret %v_6
  }
}

main<complex>(): Int {
  b_0 {
    %s = alloca 24, 8: Ptr
    call_complex +=(I64), @liveBuffers, 1
    %v_1 = call_complex allocateHeap, 16: Ptr
    call_complex +=(I64), @liveBuffers, 1
    %v_2 = call_complex allocateHeap, 16: Ptr
    store %s, 2, 4
    %v_3 = add %s, 8: Ptr
    store %v_3, %v_1, 8
    %v_4 = add %s, 16: Ptr
    store %v_4, %v_2, 8
    %counted = loads @liveBuffers, 8: Long
    call_complex drop$Slot, %s
    %s = alloca 24, 8: Ptr
    call_complex +=(I64), @liveBuffers, 1
    %v_5 = call_complex allocateHeap, 16: Ptr
    store %s, 1, 4
    %v_6 = add %s, 8: Ptr
    store %v_6, %v_5, 8
    %counted = loads @liveBuffers, 8: Long
    call_complex drop$Slot, %s
    %s = alloca 24, 8: Ptr
    store %s, 0, 4
    %counted = loads @liveBuffers, 8: Long
    call_complex drop$Slot, %s
    %v_7 = imul %counted, 100: Long
    %v_8 = imul %counted, 10: Long
    %v_9 = add %v_7, %v_8: Long
    %v_10 = add %v_9, %counted: Long
    %v_11 = loads @liveBuffers, 8: Long
    %v_12 = add %v_10, %v_11: Long
    %v_13 = cast %v_12: Int
    ret %v_13
  }
}

drop$Slot<complex>(%value: Ptr) {
  b_0 {
    %v_1 = loads %value, 4: Int
    %v_2 = cmp_eq %v_1, 1: Int
    je %v_2, b_3, b_4
  }

  b_5 {
    ret 
  }

  b_3 {
    %v_6 = add %value, 8: Ptr
    %v_7 = load %v_6, 8: Ptr
    call_complex freeHeap, %v_7
    call_complex -=(I64), @liveBuffers, 1
    jmp b_5
  }

  b_4 {
    %v_8 = cmp_eq %v_1, 2: Int
    je %v_8, b_9, b_10
  }

  b_9 {
    %v_11 = add %value, 8: Ptr
    %v_12 = load %v_11, 8: Ptr
    call_complex freeHeap, %v_12
    call_complex -=(I64), @liveBuffers, 1
    %v_13 = add %value, 16: Ptr
    %v_14 = load %v_13, 8: Ptr
    call_complex freeHeap, %v_14
    call_complex -=(I64), @liveBuffers, 1
    jmp b_5
  }

  b_10 {
    jmp b_5
  }
}

