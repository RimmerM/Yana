import Native

-- What `swap` and `exchange` are refused for. Each function is one rule; the expectation beside
-- this file is the whole of what it reports.

data Handle {value: I64}

-- Both places are written, so both are exclusive for as long as the operation runs. `swap(x, x)` is
-- the smallest program that asks for one storage to be two of them, and it is rejected by the
-- exclusivity rule that was there before swap existed rather than by anything written for it. That
-- is the whole reason these take their places from `&` arguments.
fn selfSwap() -> I64:
    let &value = 1 :: I64
    swap(value, value)
    return value

-- An immutable binding names storage nothing may write, which is as true of an exchange as of an
-- assignment: what these do to a place is write it.
fn immutableSwap() -> I64:
    let x = 1 :: I64
    let &y = 2 :: I64
    swap(x, y)
    return x

fn immutableExchange() -> I64:
    let slot = Handle {value: 1}
    let old = exchange(slot, Handle {value: 2})
    return old.value

-- A subscript in `&` position used to be here, and is not a rejection any more: `swap(xs[i], xs[j])`
-- and `exchange(xs[i], v)` both compile. See test/lib/Exchange.yana, which runs them.
