  %72: Size = const 3
  %73: Array(I32) [shared call] = read borrow.shared (xs) loan6
  %74: Array(I32) [shared slot 0 view] = call.derivation elements(Array(I32), I32) borrow.shared %73 roots{6}
  %75: I32 [shared slot 0] = call.subscript get(Array(I32), Size, I32) borrow.shared %74 borrow.shared %72 roots{6}
  write.init borrow.unique (local7) borrow.shared %75
  %77: I32 = read copy.trivial (local7)
