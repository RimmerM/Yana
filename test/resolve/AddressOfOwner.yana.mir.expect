  %14: %String [owned here shape6 .*=shared slot 0] = read copy.trivial (q) roots.0{1}
  %15: USize = bitcast inspect %14
  %16: Bool = eq inspect %13 inspect %15
  branch inspect %16 -> bb3 -> bb1

bb1:
  %19: I32 = const 0
  jump -> bb2(take %19)

bb2(%20: I32):
  write.init borrow.unique (same) take %20
  %24: I32 = const 1
  %25: I32 = const 2
  %26: I32 = const 3
  %27: %I32 = run.slots I32 *3
  %28: Size = bitcast inspect %27
  %29: Size = const 0
  %30: Bool = eq inspect %28 inspect %29
  %31: {} = call checkCondition borrow.shared %30
  %32: @bits(30) U32 = const 3
  %33: @bits(2) U32 = const 1
  %34: Run(I32) = aggregate.Run take %27 take %32 take %33
  %35: @bits(30) U32 = const 3
  %36: Array(I32) = aggregate.Array take %34 take %35
  write.init borrow.unique (local4) take %36
  %38: Size = const 0
  write.init borrow.unique ([%%27][0]) take %24
  %40: Size = const 1
  write.init borrow.unique ([%%27][1]) take %25
  %42: Size = const 2
  write.init borrow.unique ([%%27][2]) take %26
  %44: Array(I32) = read take (local4)
  write.init borrow.unique (xs) take %44
  %46: Array(I32) [shared slot 0] = read borrow.shared (xs) loan2
  %47: %Array(I32) [owned here shape6 .*=shared slot 0] = address inspect %46 roots.0{2}
  %48: %Array(I32) [owned here shape6 .*=shared slot 0] = bitcast inspect %47 roots.0{2}
  write.init borrow.unique (r) take %48
  %50: %Array(I32) [owned here shape6 .*=shared slot 0] = read copy.trivial (r) roots.0{2}
  %51: Array(I32) [unique call] = read borrow.unique ([%%50]) loan3
  %52: I32 = const 4
  %53: {} = call push(I32) borrow.unique %51 take %52
  %54: %String [owned here shape6 .*=shared slot 0] = read copy.trivial (p) roots.0{0}
  %55: String [shared call] = read borrow.shared ([%%54]) loan4
  %56: String [shared slot 0 view] = call.derivation view(String) borrow.shared %55 roots{4}
  %57: Size = call length(String) borrow.shared %56
  drop (s)
  %58: I32 = convert inspect %57
  %59: I32 = const 1000
  %60: I32 = mul inspect %58 inspect %59
  %61: I32 = read copy.trivial (same)
  %62: I32 = const 100
  %63: I32 = mul inspect %61 inspect %62
  %64: I32 = add inspect %60 inspect %63
  %65: Array(I32) [shared call] = read borrow.shared (xs) loan5
  %66: Array(I32) [shared slot 0 view] = call.derivation elements(Array(I32), I32) borrow.shared %65 roots{5}
  %67: Size = call length(Array(I32)) borrow.shared %66
