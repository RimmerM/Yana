instance Drop(Guard): Guard.drop

let & live: I32 = 0

fn Guard.drop(value: Guard) -> {} {
bb0:
  %0: I32 = read copy.trivial (global live)
  %1: I32 = const 1
  %2: I32 = sub inspect %0 inspect %1
  write.assign borrow.unique (global live) take %2
  return
}

fn open(id: I32 [shared call]) -> Guard {
bb0:
  %0: I32 = read copy.trivial (global live)
  %1: I32 = const 1
  %2: I32 = add inspect %0 inspect %1
  write.assign borrow.unique (global live) take %2
  %4: I32 = read copy.trivial (id)
  %5: Guard = aggregate take %4
  return take %5
}

fn close(g: Guard) -> I32 {
  local counted: I32

bb0:
  %0: I32 = read copy.trivial (global live)
  write.init borrow.unique (counted) take %0
  %2: I32 = read copy.trivial (counted)
  %3: I32 = read copy.trivial (g.id)
  drop (g)
  %4: I32 = add inspect %2 inspect %3
  return take %4
}

fn label(g: Guard [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (g.id)
  return take %0
}

