fn pointer(%p: %U32) -> U32 {
  b0:
    %first = load.volatile [%p] : U32
    %v4 = add %first, 1 : U32
    assign.volatile [%p], %v4
    %v6 = load.volatile [%p] : U32
    ret %v6
}

fn discarded(%p: %U32, %flag: Bool) -> U32 {
  b0:
    je %flag, b1, b2

  b1:
    %ignored = load.volatile [%p] : U32
    jmp b3

  b2:
    jmp b3

  b3:
    assign.volatile [%p], 1
    ret 0
}

fn looped(%p: %U32, %count: U32) -> U32 {
  b0:
    %i = alloc : U32
    init %i, 0
    jmp b1

  b1:
    %v6 = load %i : U32
    %v7 = cmp_lt %v6, %count : Bool
    je %v7, b3, b2

  b2:
    %v16 = load %i : U32
    ret %v16

  b3:
    %ignored = load.volatile [%p] : U32
    %v10 = load %i : U32
    %v13 = add %v10, 1 : U32
    assign %i, %v13
    jmp b1
}

fn atomic(%p: %U8) -> U32 {
  b0:
    %v1 = bitcast %p : %Atomic(U32)
    %v2 = borrow [%v1] : 1'Atomic(U32)
    %v5 = addressof [%v2] : %Atomic(U32)
    %first = atomicload.volatile %v5, acquire : U32
    %v10 = add %first, 1 : U32
    %v12 = addressof [%v2] : %Atomic(U32)
    atomicstore.volatile %v12, %v10, release
    %v16 = addressof [%v2] : %Atomic(U32)
    %v17 = atomicload.volatile %v16, relaxed : U32
    ret %v17
}

fn atomicSequential(%p: %U8) -> U32 {
  b0:
    %v1 = bitcast %p : %Atomic(U32)
    %v2 = borrow [%v1] : 1'Atomic(U32)
    %v7 = addressof [%v2] : %Atomic(U32)
    atomicstore.volatile %v7, 1, seq_cst
    %v11 = addressof [%v2] : %Atomic(U32)
    %v12 = atomicload.volatile %v11, seq_cst : U32
    ret %v12
}
