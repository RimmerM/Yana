@image$base = []
@heapNext = [0, 0, 0, 0, 0, 0, 0, 0]
@heapLimit = [0, 0, 0, 0, 0, 0, 0, 0]
@heapFree = [0, 0, 0, 0, 0, 0, 0, 0]
@heapRegionNext = [0, 0, 0, 0, 0, 0, 0, 0]
@live = [0, 0, 0, 0]

growHeap<complex>(%needed: Long): Int {
  b_0 {
    %v_1 = loads @heapRegionNext, 8: Long
    %v_2 = cmp_ilt %v_1, %needed: Int
    je %v_2, b_3, b_4
  }

  b_3 {
    jmp b_5
  }

  b_4 {
    jmp b_5
  }

  b_5 {
    %v_6 = phi [b_3, %needed], [b_4, %v_1]: Long
    %v_7 = call_complex mapMemory, %v_6: Ptr
    %v_8 = bitcast %v_7: Long
    %v_9 = cmp_eq %v_8, 0: Int
    je %v_9, b_10, b_11
  }

  b_10 {
    %v_12 = cmp_igt %needed, 4194304: Int
    %least = select %needed, 4194304, %v_12: Long
    %v_13 = cmp_ige %least, %v_6: Int
    je %v_13, b_14, b_15
  }

  b_11 {
    jmp b_16
  }

  b_14 {
    ret 0
  }

  b_15 {
    %v_17 = call_complex mapMemory, %least: Ptr
    %v_18 = bitcast %v_17: Long
    %v_19 = cmp_eq %v_18, 0: Int
    je %v_19, b_20, b_21
  }

  b_20 {
    ret 0
  }

  b_21 {
    jmp b_16
  }

  b_16 {
    %v_22 = phi [b_11, %v_6], [b_21, %least]: Long
    %v_23 = phi [b_11, %v_7], [b_21, %v_17]: Ptr
    store @heapNext, %v_23, 8
    %v_24 = add %v_23, %v_22: Ptr
    store @heapLimit, %v_24, 8
    %v_25 = add %v_22, %v_22: Long
    store @heapRegionNext, %v_25, 8
    ret 1
  }
}

allocateHeap<complex>(%size: Long): Ptr {
  b_0 {
    %v_1 = load @heapFree, 8: Ptr
    %v_2 = bitcast %v_1: Long
    %v_3 = cmp_eq %v_2, 0: Int
    je %v_3, b_4, b_5
  }

  b_5 {
    jmp b_6
  }

  b_4 {
    %result = syscall 9, 0, 4194304, 3, 34, 18446744073709551615, 0: Long
    %v_7 = cmp_ilt %result, 0: Int
    %v_8 = bitcast 0: Ptr
    %v_9 = bitcast %result: Ptr
    %region = select %v_8, %v_9, %v_7: Ptr
    %v_10 = bitcast %region: Long
    %v_11 = cmp_eq %v_10, 0: Int
    je %v_11, b_12, b_13
  }

  b_13 {
    setpattern %region, 256, 0
    %v_14 = bitcast %region: Ptr
    store @heapFree, %v_14, 8
    %v_15 = add %region, 256: Ptr
    store @heapNext, %v_15, 8
    %v_16 = add %region, 4194304: Ptr
    store @heapLimit, %v_16, 8
    store @heapRegionNext, 8388608, 8
    jmp b_17
  }

  b_12 {
    jmp b_17
  }

  b_17 {
    %v_18 = load @heapFree, 8: Ptr
    %v_19 = bitcast %v_18: Long
    %v_20 = cmp_eq %v_19, 0: Int
    je %v_20, b_21, b_22
  }

  b_22 {
    jmp b_6
  }

  b_6 {
    %v_23 = add %size, 8: Long
    jmp b_24
  }

  b_24 {
    %v_25 = phi [b_6, 16], [b_26, %v_27]: Long
    %v_28 = phi [b_6, 0], [b_26, %v_29]: Long
    %v_30 = cmp_ilt %v_25, %v_23: Int
    je %v_30, b_26, b_31
  }

  b_31 {
    %v_32 = cmp_ige %v_28, 32: Int
    je %v_32, b_33, b_34
  }

  b_34 {
    %v_35 = load @heapFree, 8: Ptr
    %v_36 = shl %v_28, 3: Long
    %v_37 = add %v_35, %v_36: Ptr
    %v_38 = load %v_37, 8: Ptr
    %v_39 = bitcast %v_38: Long
    %v_40 = cmp_eq %v_39, 0: Int
    je %v_40, b_41, b_42
  }

  b_41 {
    %v_43 = shl 16, %v_28: Long
    %v_44 = load @heapNext, 8: Ptr
    %v_45 = add %v_44, %v_43: Ptr
    %v_46 = load @heapLimit, 8: Ptr
    %v_47 = cmp_gt %v_45, %v_46: Int
    je %v_47, b_48, b_49
  }

  b_49 {
    jmp b_50
  }

  b_48 {
    %v_51 = call_complex growHeap, %v_43: Int
    %v_52 = xor %v_51, 1: Int
    je %v_52, b_53, b_54
  }

  b_54 {
    jmp b_50
  }

  b_50 {
    %block = load @heapNext, 8: Ptr
    %v_55 = add %block, %v_43: Ptr
    store @heapNext, %v_55, 8
    %v_56 = bitcast %block: Ptr
    store %v_56, %v_28, 8
    %v_57 = add %block, 8: Ptr
    ret %v_57
  }

  b_53 {
    %v_58 = bitcast 0: Ptr
    ret %v_58
  }

  b_42 {
    %v_59 = bitcast %v_38: Ptr
    %v_60 = load %v_59, 8: Ptr
    store %v_37, %v_60, 8
    ret %v_38
  }

  b_33 {
    %v_61 = bitcast 0: Ptr
    ret %v_61
  }

  b_26 {
    %v_27 = add %v_25, %v_25: Long
    %v_29 = add %v_28, 1: Long
    jmp b_24
  }

  b_21 {
    ret %v_8
  }
}

freeHeap<complex>(%allocation: Ptr) {
  b_0 {
    %v_1 = bitcast %allocation: Long
    %v_2 = cmp_eq %v_1, 0: Int
    je %v_2, b_3, b_4
  }

  b_3 {
    ret 
  }

  b_4 {
    jmp b_5
  }

  b_5 {
    %v_6 = sub %allocation, 8: Ptr
    %v_7 = bitcast %v_6: Ptr
    %sizeClass = loads %v_7, 8: Long
    %v_8 = bitcast %allocation: Ptr
    %v_9 = load @heapFree, 8: Ptr
    %v_10 = shl %sizeClass, 3: Long
    %v_11 = add %v_9, %v_10: Ptr
    %v_12 = load %v_11, 8: Ptr
    store %v_8, %v_12, 8
    %v_13 = load @heapFree, 8: Ptr
    %v_14 = add %v_13, %v_10: Ptr
    store %v_14, %allocation, 8
    ret 
  }
}

mapMemory<complex>(%size: Long): Ptr {
  b_0 {
    %result = syscall 9, 0, %size, 3, 34, 18446744073709551615, 0: Long
    %v_1 = cmp_ilt %result, 0: Int
    je %v_1, b_2, b_3
  }

  b_2 {
    %v_4 = bitcast 0: Ptr
    ret %v_4
  }

  b_3 {
    jmp b_5
  }

  b_5 {
    %v_6 = bitcast %result: Ptr
    ret %v_6
  }
}

consume<complex>(%g: Ptr): Int {
  b_0 {
    %v_1 = loads %g, 4: Int
    %v_2 = loads @live, 4: Int
    %v_3 = sub %v_2, 1: Int
    store @live, %v_3, 4
    ret %v_1
  }
}

heaped<complex>(%c: Int, %d: Int): Int {
  b_0 {
    %v_1 = loads @live, 4: Int
    %v_2 = add %v_1, 1: Int
    store @live, %v_2, 4
    %g = call_complex allocateHeap, 4: Ptr
    store %g, 1, 4
    je %c, b_3, b_4
  }

  b_3 {
    %n = call_complex consume, %g: Int
    jmp b_5
  }

  b_4 {
    jmp b_5
  }

  b_5 {
    %v_6 = phi [b_3, 0], [b_4, 1]: Int
    je %d, b_7, b_8
  }

  b_7 {
    %v_9 = loads @live, 4: Int
    %v_10 = add %v_9, 1: Int
    store @live, %v_10, 4
    %v_11 = and %v_6, 255: Int
    je %v_11, b_12, b_13
  }

  b_12 {
    %v_14 = loads @live, 4: Int
    %v_15 = sub %v_14, 1: Int
    store @live, %v_15, 4
    jmp b_13
  }

  b_13 {
    store %g, 2, 4
    %v_16 = loads @live, 4: Int
    %v_17 = sub %v_16, 1: Int
    store @live, %v_17, 4
    %v_18 = bitcast %g: Ptr
    call_complex freeHeap, %v_18
    jmp b_19
  }

  b_20 {
    jmp b_19
  }

  b_19 {
    %v_21 = phi [b_13, 1], [b_20, %v_6]: Int
    %v_22 = loads @live, 4: Int
    ret %v_22
  }

  b_8 {
    %v_23 = and %v_6, 255: Int
    je %v_23, b_24, b_25
  }

  b_24 {
    %v_26 = loads @live, 4: Int
    %v_27 = sub %v_26, 1: Int
    store @live, %v_27, 4
    jmp b_25
  }

  b_25 {
    %v_28 = bitcast %g: Ptr
    call_complex freeHeap, %v_28
    jmp b_20
  }
}

main<complex>(): Int {
  b_0 {
    %first = call_complex heaped, 1, 0: Int
    %v_1 = loads @live, 4: Int
    %v_2 = cmp_neq %v_1, 0: Int
    je %v_2, b_3, b_4
  }

  b_3 {
    ret 18446744073709551615
  }

  b_4 {
    jmp b_5
  }

  b_5 {
    %v_6 = load @heapNext, 8: Ptr
    %mark = bitcast %v_6: Long
    jmp b_7
  }

  b_7 {
    %v_8 = phi [b_5, 0], [b_9, %v_10]: Int
    %v_11 = cmp_ilt %v_8, 100: Int
    je %v_11, b_9, b_12
  }

  b_12 {
    %v_13 = loads @live, 4: Int
    %v_14 = cmp_neq %v_13, 0: Int
    je %v_14, b_15, b_16
  }

  b_9 {
    %each = call_complex heaped, 1, 0: Int
    %v_10 = add %v_8, 1: Int
    jmp b_7
  }

  b_15 {
    ret 18446744073709551614
  }

  b_16 {
    jmp b_17
  }

  b_17 {
    %v_18 = load @heapNext, 8: Ptr
    %v_19 = bitcast %v_18: Long
    %v_20 = cmp_neq %v_19, %mark: Int
    je %v_20, b_21, b_22
  }

  b_21 {
    ret 18446744073709551613
  }

  b_22 {
    jmp b_23
  }

  b_23 {
    %a = call_complex heaped, 0, 0: Int
    %b = call_complex heaped, 0, 1: Int
    %c = call_complex heaped, 1, 1: Int
    %v_24 = loads @live, 4: Int
    %v_25 = cmp_neq %v_24, 0: Int
    je %v_25, b_26, b_27
  }

  b_26 {
    ret 18446744073709551612
  }

  b_27 {
    jmp b_28
  }

  b_28 {
    %v_29 = load @heapNext, 8: Ptr
    %v_30 = bitcast %v_29: Long
    %v_31 = cmp_neq %v_30, %mark: Int
    je %v_31, b_32, b_33
  }

  b_32 {
    ret 18446744073709551611
  }

  b_33 {
    jmp b_34
  }

  b_34 {
