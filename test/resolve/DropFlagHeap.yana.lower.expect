@image$base = []
mut @heapNext = [0, 0, 0, 0, 0, 0, 0, 0]
mut @heapLimit = [0, 0, 0, 0, 0, 0, 0, 0]
mut @heapFree = [0, 0, 0, 0, 0, 0, 0, 0]
mut @heapRegionNext = [0, 0, 0, 0, 0, 0, 0, 0]
mut @live = [0, 0, 0, 0]

growHeap<complex>(%needed: Long): Int {
  b_0 {
    %v_1 = loads @heapRegionNext, 8: Long
    %v_2 = cmp_ilt %v_1, %needed: Int
    je %v_2, b_3, b_4
  }

  b_3 {
    jmp b_5
  }

  b_4 {
    jmp b_5
  }

  b_5 {
    %v_6 = phi [b_3, %needed], [b_4, %v_1]: Long
    %v_7 = add %v_6, 4096: Long
    %v_8 = call_complex mapMemory, %v_7: Ptr
    %v_9 = bitcast %v_8: Long
    %v_10 = cmp_eq %v_9, 0: Int
    je %v_10, b_11, b_12
  }

  b_11 {
    %v_13 = cmp_igt %needed, 4194304: Int
    %least = select %v_13, %needed, 4194304: Long
    %v_14 = cmp_ige %least, %v_6: Int
    je %v_14, b_15, b_16
  }

  b_12 {
    jmp b_17
  }

  b_15 {
    ret 0
  }

  b_16 {
    %v_18 = add %least, 4096: Long
    %v_19 = call_complex mapMemory, %v_18: Ptr
    %v_20 = bitcast %v_19: Long
    %v_21 = cmp_eq %v_20, 0: Int
    je %v_21, b_15, b_22
  }

  b_22 {
    jmp b_17
  }

  b_17 {
    %v_23 = phi [b_12, %v_6], [b_22, %least]: Long
    %v_24 = phi [b_12, %v_8], [b_22, %v_19]: Ptr
    store @heapNext, %v_24, 8
    %v_25 = add %v_24, %v_23: Ptr
    store @heapLimit, %v_25, 8
    %v_26 = add %v_23, %v_23: Long
    store @heapRegionNext, %v_26, 8
    ret 1
  }
}

allocateHeap<complex>(%size: Long): Ptr {
  b_0 {
    %v_1 = load @heapFree, 8: Ptr
    %v_2 = bitcast %v_1: Long
    %v_3 = cmp_eq %v_2, 0: Int
    je %v_3, b_4, b_5
  }

  b_5 {
    jmp b_6
  }

  b_4 {
    %result = syscall 9, 0, 4198400, 3, 34, 18446744073709551615, 0: Long
    %v_7 = cmp_ilt %result, 0: Int
    %v_8 = bitcast 0: Ptr
    %v_9 = bitcast %result: Ptr
    %region = select %v_7, %v_8, %v_9: Ptr
    %v_10 = bitcast %region: Long
    %v_11 = cmp_eq %v_10, 0: Int
    je %v_11, b_12, b_13
  }

  b_13 {
    setpattern %region, 256, 0
    store @heapFree, %region, 8
    %v_14 = add %region, 256: Ptr
    store @heapNext, %v_14, 8
    %v_15 = add %region, 4194304: Ptr
    store @heapLimit, %v_15, 8
    store @heapRegionNext, 8388608, 8
    jmp b_16
  }

  b_12 {
    jmp b_16
  }

  b_16 {
    %v_17 = load @heapFree, 8: Ptr
    %v_18 = bitcast %v_17: Long
    %v_19 = cmp_eq %v_18, 0: Int
    je %v_19, b_20, b_21
  }

  b_21 {
    jmp b_6
  }

  b_6 {
    %v_22 = add %size, 8: Long
    jmp b_23
  }

  b_23 {
    %v_24 = phi [b_6, 16], [b_25, %v_26]: Long
    %v_27 = phi [b_6, 0], [b_25, %v_28]: Long
    %v_29 = cmp_ilt %v_24, %v_22: Int
    je %v_29, b_25, b_30
  }

  b_30 {
    %v_31 = cmp_ige %v_27, 32: Int
    je %v_31, b_32, b_33
  }

  b_33 {
    %v_34 = load @heapFree, 8: Ptr
    %v_35 = shl %v_27, 3: Long
    %v_36 = add %v_34, %v_35: Ptr
    %v_37 = load %v_36, 8: Ptr
    %v_38 = bitcast %v_37: Long
    %v_39 = cmp_eq %v_38, 0: Int
    je %v_39, b_40, b_41
  }

  b_40 {
    %v_42 = shl 16, %v_27: Long
    %v_43 = load @heapNext, 8: Ptr
    %v_44 = add %v_43, %v_42: Ptr
    %v_45 = load @heapLimit, 8: Ptr
    %v_46 = cmp_gt %v_44, %v_45: Int
    je %v_46, b_47, b_48
  }

  b_48 {
    jmp b_49
  }

  b_47 {
    %v_50 = call_complex growHeap, %v_42: Int
    %v_51 = xor %v_50, 1: Int
    je %v_51, b_32, b_52
  }

  b_52 {
    jmp b_49
  }

  b_49 {
    %block = load @heapNext, 8: Ptr
    %v_53 = add %block, %v_42: Ptr
    store @heapNext, %v_53, 8
    store %block, %v_27, 8
    %v_54 = add %block, 8: Ptr
    ret %v_54
  }

  b_32 {
    %v_55 = bitcast 0: Ptr
    ret %v_55
  }

  b_41 {
    %v_56 = load %v_37, 8: Ptr
    store %v_36, %v_56, 8
    ret %v_37
  }

  b_25 {
    %v_26 = add %v_24, %v_24: Long
    %v_28 = add %v_27, 1: Long
    jmp b_23
  }

  b_20 {
    ret %v_8
  }
}

freeHeap<complex>(%allocation: Ptr) {
  b_0 {
    %v_1 = bitcast %allocation: Long
    %v_2 = cmp_eq %v_1, 0: Int
    je %v_2, b_3, b_4
  }

  b_3 {
    ret 
  }

  b_4 {
    jmp b_5
  }

  b_5 {
    %v_6 = sub %allocation, 8: Ptr
    %sizeClass = loads %v_6, 8: Long
    %v_7 = load @heapFree, 8: Ptr
    %v_8 = shl %sizeClass, 3: Long
    %v_9 = add %v_7, %v_8: Ptr
    %v_10 = load %v_9, 8: Ptr
    store %allocation, %v_10, 8
    %v_11 = load @heapFree, 8: Ptr
    %v_12 = add %v_11, %v_8: Ptr
    store %v_12, %allocation, 8
    ret 
  }
}

mapMemory<complex>(%size: Long): Ptr {
  b_0 {
    %result = syscall 9, 0, %size, 3, 34, 18446744073709551615, 0: Long
    %v_1 = cmp_ilt %result, 0: Int
    je %v_1, b_2, b_3
  }

  b_2 {
    %v_4 = bitcast 0: Ptr
    ret %v_4
  }

  b_3 {
    jmp b_5
  }

  b_5 {
    %v_6 = bitcast %result: Ptr
    ret %v_6
  }
}

consume<complex>(%g: Ptr): Int {
  b_0 {
    %v_1 = loads %g, 4: Int
    %v_2 = loads @live, 4: Int
    %v_3 = sub %v_2, 1: Int
    store @live, %v_3, 4
    ret %v_1
  }
}

heaped<complex>(%c: Int, %d: Int): Int {
  b_0 {
    %v_1 = loads @live, 4: Int
    %v_2 = add %v_1, 1: Int
    store @live, %v_2, 4
    %g = call_complex allocateHeap, 4: Ptr
    store %g, 1, 4
    je %c, b_3, b_4
  }

  b_3 {
    %n = call_complex consume, %g: Int
    jmp b_5
  }

  b_4 {
    jmp b_5
  }

  b_5 {
    %v_6 = phi [b_3, 0], [b_4, 1]: Int
    je %d, b_7, b_8
  }

  b_7 {
    %v_9 = loads @live, 4: Int
    %v_10 = add %v_9, 1: Int
    store @live, %v_10, 4
    %v_11 = and %v_6, 255: Int
    je %v_11, b_12, b_13
  }

  b_12 {
    %v_14 = loads @live, 4: Int
    %v_15 = sub %v_14, 1: Int
    store @live, %v_15, 4
    jmp b_13
  }

  b_13 {
    store %g, 2, 4
    %v_16 = loads @live, 4: Int
    %v_17 = sub %v_16, 1: Int
    store @live, %v_17, 4
    call_complex freeHeap, %g
    jmp b_18
  }

  b_19 {
    jmp b_18
  }

  b_18 {
    %v_20 = phi [b_13, 1], [b_19, %v_6]: Int
    %v_21 = loads @live, 4: Int
    ret %v_21
  }

  b_8 {
    %v_22 = and %v_6, 255: Int
    je %v_22, b_23, b_24
  }

  b_23 {
    %v_25 = loads @live, 4: Int
    %v_26 = sub %v_25, 1: Int
    store @live, %v_26, 4
    jmp b_24
  }

  b_24 {
    call_complex freeHeap, %g
    jmp b_19
  }
}

main<complex>(): Int {
  b_0 {
    %first = call_complex heaped, 1, 0: Int
    %v_1 = loads @live, 4: Int
    %v_2 = cmp_neq %v_1, 0: Int
    je %v_2, b_3, b_4
  }

  b_3 {
    ret 18446744073709551615
  }

  b_4 {
    jmp b_5
  }

  b_5 {
    %v_6 = load @heapNext, 8: Ptr
    %mark = bitcast %v_6: Long
    jmp b_7
  }

  b_8 {
    %v_9 = cmp_ilt %v_10, 100: Int
    je %v_9, b_7, b_11
  }

  b_11 {
    %v_12 = loads @live, 4: Int
    %v_13 = cmp_neq %v_12, 0: Int
    je %v_13, b_14, b_15
  }

  b_7 {
    %v_16 = phi [b_8, %v_10], [b_5, 0]: Int
    %each = call_complex heaped, 1, 0: Int
    %v_10 = add %v_16, 1: Int
    jmp b_8
  }

  b_14 {
    ret 18446744073709551614
  }

  b_15 {
    jmp b_17
  }

  b_17 {
    %v_18 = load @heapNext, 8: Ptr
    %v_19 = bitcast %v_18: Long
    %v_20 = cmp_neq %v_19, %mark: Int
    je %v_20, b_21, b_22
  }

  b_21 {
    ret 18446744073709551613
  }

  b_22 {
    jmp b_23
  }

  b_23 {
    %a = call_complex heaped, 0, 0: Int
    %b = call_complex heaped, 0, 1: Int
    %c = call_complex heaped, 1, 1: Int
    %v_24 = loads @live, 4: Int
    %v_25 = cmp_neq %v_24, 0: Int
    je %v_25, b_26, b_27
  }

  b_26 {
    ret 18446744073709551612
  }

  b_27 {
    jmp b_28
  }

  b_28 {
    %v_29 = load @heapNext, 8: Ptr
    %v_30 = bitcast %v_29: Long
    %v_31 = cmp_neq %v_30, %mark: Int
    je %v_31, b_32, b_33
  }

  b_32 {
    ret 18446744073709551611
  }

  b_33 {
    jmp b_34
  }

  b_34 {
