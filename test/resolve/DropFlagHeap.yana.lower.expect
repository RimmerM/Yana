@image$base = []
@heapNext = [0, 0, 0, 0, 0, 0, 0, 0]
@heapLimit = [0, 0, 0, 0, 0, 0, 0, 0]
@heapFree = [0, 0, 0, 0, 0, 0, 0, 0]
@live = [0, 0, 0, 0]

allocateHeap<complex>(%size: Long): Ptr {
  b_0 {
    %v_1 = load @heapFree, 8: Ptr
    %v_2 = bitcast %v_1: Long
    %v_3 = cmp_eq %v_2, 0: Int
    je %v_3, b_4, b_5
  }

  b_5 {
    jmp b_6
  }

  b_4 {
    %result = syscall 9, 0, 4194304, 3, 34, 18446744073709551615, 0: Long
    %v_7 = cmp_ilt %result, 0: Int
    je %v_7, b_8, b_9
  }

  b_9 {
    %v_10 = bitcast %result: Ptr
    jmp b_11
  }

  b_8 {
    %v_12 = bitcast 0: Ptr
    jmp b_11
  }

  b_11 {
    %region = phi [b_9, %v_10], [b_8, %v_12]: Ptr
    %v_13 = bitcast %region: Long
    %v_14 = cmp_eq %v_13, 0: Int
    je %v_14, b_15, b_16
  }

  b_16 {
    setpattern %region, 256, 0
    %v_17 = bitcast %region: Ptr
    store @heapFree, %v_17, 8
    %v_18 = add %region, 256: Ptr
    store @heapNext, %v_18, 8
    %v_19 = add %region, 4194304: Ptr
    store @heapLimit, %v_19, 8
    jmp b_20
  }

  b_15 {
    jmp b_20
  }

  b_20 {
    %v_21 = load @heapFree, 8: Ptr
    %v_22 = bitcast %v_21: Long
    %v_23 = cmp_eq %v_22, 0: Int
    je %v_23, b_24, b_25
  }

  b_25 {
    jmp b_6
  }

  b_6 {
    %v_26 = add %size, 8: Long
    jmp b_27
  }

  b_27 {
    %v_28 = phi [b_6, 16], [b_29, %v_30]: Long
    %v_31 = phi [b_6, 0], [b_29, %v_32]: Long
    %v_33 = cmp_ilt %v_28, %v_26: Int
    je %v_33, b_29, b_34
  }

  b_34 {
    %v_35 = cmp_ige %v_31, 32: Int
    je %v_35, b_36, b_37
  }

  b_37 {
    %v_38 = load @heapFree, 8: Ptr
    %v_39 = shl %v_31, 3: Long
    %v_40 = add %v_38, %v_39: Ptr
    %v_41 = load %v_40, 8: Ptr
    %v_42 = bitcast %v_41: Long
    %v_43 = cmp_eq %v_42, 0: Int
    %v_44 = xor %v_43, 1: Int
    je %v_44, b_45, b_46
  }

  b_46 {
    %block = load @heapNext, 8: Ptr
    %v_47 = shl 16, %v_31: Long
    %v_48 = add %block, %v_47: Ptr
    %v_49 = load @heapLimit, 8: Ptr
    %v_50 = cmp_gt %v_48, %v_49: Int
    je %v_50, b_51, b_52
  }

  b_52 {
    store @heapNext, %v_48, 8
    %v_53 = bitcast %block: Ptr
    store %v_53, %v_31, 8
    %v_54 = add %block, 8: Ptr
    ret %v_54
  }

  b_51 {
    %v_55 = bitcast 0: Ptr
    ret %v_55
  }

  b_45 {
    %v_56 = bitcast %v_41: Ptr
    %v_57 = load %v_56, 8: Ptr
    %v_58 = load @heapFree, 8: Ptr
    %v_59 = shl %v_31, 3: Long
    %v_60 = add %v_58, %v_59: Ptr
    store %v_60, %v_57, 8
    ret %v_41
  }

  b_36 {
    %v_61 = bitcast 0: Ptr
    ret %v_61
  }

  b_29 {
    %v_30 = add %v_28, %v_28: Long
    %v_32 = add %v_31, 1: Long
    jmp b_27
  }

  b_24 {
    %v_62 = bitcast 0: Ptr
    ret %v_62
  }
}

freeHeap<complex>(%allocation: Ptr) {
  b_0 {
    %v_1 = bitcast %allocation: Long
    %v_2 = cmp_eq %v_1, 0: Int
    je %v_2, b_3, b_4
  }

  b_3 {
    ret 
  }

  b_4 {
    jmp b_5
  }

  b_5 {
    %v_6 = sub %allocation, 8: Ptr
    %v_7 = bitcast %v_6: Ptr
    %sizeClass = loads %v_7, 8: Long
    %v_8 = bitcast %allocation: Ptr
    %v_9 = load @heapFree, 8: Ptr
    %v_10 = shl %sizeClass, 3: Long
    %v_11 = add %v_9, %v_10: Ptr
    %v_12 = load %v_11, 8: Ptr
    store %v_8, %v_12, 8
    %v_13 = load @heapFree, 8: Ptr
    %v_14 = shl %sizeClass, 3: Long
    %v_15 = add %v_13, %v_14: Ptr
    store %v_15, %allocation, 8
    ret 
  }
}

consume<complex>(%g: Ptr): Int {
  b_0 {
    %v_1 = loads %g, 4: Int
    %v_2 = loads @live, 4: Int
    %v_3 = sub %v_2, 1: Int
    store @live, %v_3, 4
    ret %v_1
  }
}

heaped<complex>(%c: Int, %d: Int): Int {
  b_0 {
    %v_1 = loads @live, 4: Int
    %v_2 = add %v_1, 1: Int
    store @live, %v_2, 4
    %g = call_complex allocateHeap, 4: Ptr
    store %g, 1, 4
    je %c, b_3, b_4
  }

  b_3 {
    %n = call_complex consume, %g: Int
    jmp b_5
  }

  b_4 {
    jmp b_5
  }

  b_5 {
    %v_6 = phi [b_3, 0], [b_4, 1]: Int
    je %d, b_7, b_8
  }

  b_7 {
    %v_9 = loads @live, 4: Int
    %v_10 = add %v_9, 1: Int
    store @live, %v_10, 4
    %v_11 = and %v_6, 255: Int
    je %v_11, b_12, b_13
  }

  b_12 {
    %v_14 = loads @live, 4: Int
    %v_15 = sub %v_14, 1: Int
    store @live, %v_15, 4
    jmp b_13
  }

  b_13 {
    store %g, 2, 4
    %v_16 = loads @live, 4: Int
    %v_17 = sub %v_16, 1: Int
    store @live, %v_17, 4
    %v_18 = bitcast %g: Ptr
    call_complex freeHeap, %v_18
    jmp b_19
  }

  b_20 {
    jmp b_19
  }

  b_19 {
    %v_21 = phi [b_13, 1], [b_20, %v_6]: Int
    %v_22 = loads @live, 4: Int
    ret %v_22
  }

  b_8 {
    %v_23 = and %v_6, 255: Int
    je %v_23, b_24, b_25
  }

  b_24 {
    %v_26 = loads @live, 4: Int
    %v_27 = sub %v_26, 1: Int
    store @live, %v_27, 4
    jmp b_25
  }

  b_25 {
    %v_28 = bitcast %g: Ptr
    call_complex freeHeap, %v_28
    jmp b_20
  }
}

main<complex>(): Int {
  b_0 {
    %first = call_complex heaped, 1, 0: Int
    %v_1 = loads @live, 4: Int
    %v_2 = cmp_neq %v_1, 0: Int
    je %v_2, b_3, b_4
  }

  b_3 {
    ret 18446744073709551615
  }

  b_4 {
    jmp b_5
  }

  b_5 {
    %v_6 = load @heapNext, 8: Ptr
    %mark = bitcast %v_6: Long
    jmp b_7
  }

  b_7 {
    %v_8 = phi [b_5, 0], [b_9, %v_10]: Int
    %v_11 = cmp_ilt %v_8, 100: Int
    je %v_11, b_9, b_12
  }

  b_12 {
    %v_13 = loads @live, 4: Int
    %v_14 = cmp_neq %v_13, 0: Int
    je %v_14, b_15, b_16
  }

  b_9 {
    %each = call_complex heaped, 1, 0: Int
    %v_10 = add %v_8, 1: Int
    jmp b_7
  }

  b_15 {
    ret 18446744073709551614
  }

  b_16 {
    jmp b_17
  }

  b_17 {
    %v_18 = load @heapNext, 8: Ptr
    %v_19 = bitcast %v_18: Long
    %v_20 = cmp_neq %v_19, %mark: Int
    je %v_20, b_21, b_22
  }

  b_21 {
    ret 18446744073709551613
  }

  b_22 {
    jmp b_23
  }

  b_23 {
    %a = call_complex heaped, 0, 0: Int
    %b = call_complex heaped, 0, 1: Int
    %c = call_complex heaped, 1, 1: Int
    %v_24 = loads @live, 4: Int
    %v_25 = cmp_neq %v_24, 0: Int
    je %v_25, b_26, b_27
  }

  b_26 {
    ret 18446744073709551612
  }

  b_27 {
    jmp b_28
  }

  b_28 {
    %v_29 = load @heapNext, 8: Ptr
    %v_30 = bitcast %v_29: Long
    %v_31 = cmp_neq %v_30, %mark: Int
    je %v_31, b_32, b_33
  }

  b_32 {
    ret 18446744073709551611
  }

  b_33 {
    jmp b_34
  }

  b_34 {
    ret 1
  }
}

