"use strict";
// Core
function growJsArray_I32(self, wanted) {
  var v3 = self.items;
  var room = v3.length;
  var v5 = room + room | 0;
  var wide = v5;
  if (v5 < wanted) {
    wide = wanted;
  }
  if (wide < 4) {
    wide = 4;
  }
  var v25 = $grow(v3, wide);
  self.items = v25;
}

function push_I32(self, item) {
  var count = self.length;
  var v7 = count + 1;
  if (v7 > self.items.length) {
