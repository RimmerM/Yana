@image$base = []
mut @heapFree = [0, 0, 0, 0, 0, 0, 0, 0]

Reclaim(Array(a)).reclaim(I32)<complex>(%value: Ptr) {
  b_0 {
    %v_1 = add %value, 8: Ptr
    %v_2 = load %v_1, 4: I32
    %v_3 = shr %v_2, 30: I32
    %v_4 = cmp_eq %v_3, 1: I32
    je %v_4, b_5, b_6
  }

  b_5 {
    %v_7 = load %value, 8: Ptr
    call_complex freeHeap, %v_7
    jmp b_6
  }

  b_6 {
    ret 
  }
}

freeHeap<complex>(%allocation: Ptr) {
  b_0 {
    %v_1 = bitcast %allocation: I64
    %v_2 = cmp_eq %v_1, 0: I32
    je %v_2, b_3, b_4
  }

  b_3 {
    ret 
  }

  b_4 {
    %v_5 = sub %allocation, 8: Ptr
    %sizeClass = loads %v_5, 8: I64
    %v_6 = load @heapFree, 8: Ptr
    %v_7 = shl %sizeClass, 3: I64
    %v_8 = add %v_6, %v_7: Ptr
    %v_9 = load %v_8, 8: Ptr
    store %allocation, %v_9, 8
    %v_10 = load @heapFree, 8: Ptr
    %v_11 = add %v_10, %v_7: Ptr
    store %v_11, %allocation, 8
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    %xs = alloca 16, 8: Ptr
    %v_1 = alloca 12, 4: Ptr
    store %xs, %v_1, 8
    %v_2 = add %xs, 8: Ptr
    store %v_2, 3, 4
    store %v_1, 1, 4
    %v_3 = add %v_1, 4: Ptr
    store %v_3, 2, 4
    %v_4 = add %v_1, 8: Ptr
    store %v_4, 3, 4
    %v_5 = add %xs, 12: Ptr
    store %v_5, 3, 4
    %ys = alloca 16, 8: Ptr
    %v_6 = alloca 8, 4: Ptr
    store %ys, %v_6, 8
    %v_7 = add %ys, 8: Ptr
    store %v_7, 2, 4
    store %v_6, 4, 4
    %v_8 = add %v_6, 4: Ptr
    store %v_8, 5, 4
    %v_9 = add %ys, 12: Ptr
    store %v_9, 2, 4
    call_complex Reclaim(Array(a)).reclaim(I32), %xs
    call_complex Reclaim(Array(a)).reclaim(I32), %ys
    ret 57
  }
}

