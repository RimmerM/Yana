"use strict";
// Core
function add_eq_Int(target, amount) {
  target.$v = target.$v + amount | 0;
  return;
}

// ResolveTest
function bump(counter, by) {
  counter.$v = counter.$v + by | 0;
  return;
}

function swap(a, b) {
  var old = a.$v;
  a.$v = b.$v;
  b.$v = old;
  return;
}

function moveBy(p, dx, dy) {
  var v5 = { $v: p.x };
  add_eq_Int(v5, dx);
  p.x = v5.$v;
  var v9 = { $v: p.y };
  add_eq_Int(v9, dy);
  p.y = v9.$v;
  return;
}

function copyThroughBorrow(target, amount) {
  target.$v = target.$v + amount | 0;
  return;
}

function main() {
  var v28 = { x: 10, y: 20 };
  var v69 = { $v: v28.x };
  add_eq_Int(v69, 1);
  v28.x = v69.$v;
  var v73 = { $v: v28.y };
  add_eq_Int(v73, 2);
  v28.y = v73.$v;
  return (v28.x + 33 | 0) + v28.y | 0;
}
