"use strict";
// Core
function add_eq_Int(target, amount) {
  target.$v = target.$v + amount | 0;
  return;
}

function mul_eq_Int(target, amount) {
  target.$v = Math.imul(target.$v, amount) | 0;
  return;
}

// ResolveTest
function bump(counter, by) {
  counter.$v = counter.$v + by | 0;
  return;
}

function swap(a, b) {
  var old = a.$v;
  a.$v = b.$v;
  b.$v = old;
  return;
}

function moveBy(p, dx, dy) {
  var v5 = { $v: p.x };
  add_eq_Int(v5, dx);
  p.x = v5.$v;
  var v9 = { $v: p.y };
  add_eq_Int(v9, dy);
  p.y = v9.$v;
  return;
}

function copyThroughBorrow(target, amount) {
  target.$v = target.$v + amount | 0;
  return;
}

function main() {
  var total = { $v: 0 };
  var v5 = total;
  v5.$v = v5.$v + 5 | 0;
  add_eq_Int(total, 3);
  mul_eq_Int(total, 2);
  var left = { $v: 1 };
  var right = { $v: 2 };
  var v25 = left;
  var v26 = right;
  var old = v25.$v;
  v25.$v = v26.$v;
  v26.$v = old;
  var here = { x: 10, y: 20 };
  var v38 = here;
  var v65 = { $v: v38.x };
  add_eq_Int(v65, 1);
  v38.x = v65.$v;
  var v69 = { $v: v38.y };
  add_eq_Int(v69, 2);
  v38.y = v69.$v;
  var v40 = total.$v;
  var v42 = total;
  v42.$v = v42.$v + v40 | 0;
  return ((total.$v + (left.$v - right.$v | 0) | 0) + here.x | 0) + here.y | 0;
}
