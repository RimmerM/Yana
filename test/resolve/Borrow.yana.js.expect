"use strict";
// Core
function add_eq_Int(target, amount) {
  target.$v = target.$v + amount | 0;
  return;
}

// ResolveTest
function bump(counter, by) {
  counter.$v = counter.$v + by | 0;
  return;
}

function swap(a, b) {
  var old = a.$v;
  a.$v = b.$v;
  b.$v = old;
  return;
}

function moveBy(p, dx, dy) {
  var v5 = { $v: p.x };
  add_eq_Int(v5, dx);
  p.x = v5.$v;
  var v9 = { $v: p.y };
  add_eq_Int(v9, dy);
  p.y = v9.$v;
  return;
}

function copyThroughBorrow(target, amount) {
  target.$v = target.$v + amount | 0;
  return;
}

function main() {
  var here = { x: 10, y: 20 };
  var v71 = { $v: here.x };
  add_eq_Int(v71, 1);
  here.x = v71.$v;
  var v75 = { $v: here.y };
  add_eq_Int(v75, 2);
  here.y = v75.$v;
  return (here.x + 33 | 0) + here.y | 0;
}
