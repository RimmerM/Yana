fn convert() -> a {
  form specialized
  slot #0 type a
  slot #1 class FromText(a)
  local local0: String

bb0:
  %0: String = const String {units: Array {run: Run {items: &string'142, capacity: 1, ownsHeap: 0}, length: 1}}
