}

fn refUpTo(value: U64 [shared call], bits: U64 [shared call], upTo: U64 [shared call]) -> U64 {
bb0:
  %0: U64 = read copy.trivial (upTo)
  %1: U64 = read copy.trivial (bits)
  %2: Bool = ge inspect %0 inspect %1
  branch inspect %2 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %7: U64 = read copy.trivial (value)
  %8: U64 = const 1
  %9: U64 = read copy.trivial (upTo)
  %10: U64 = shl inspect %8 inspect %9
  %11: U64 = const 1
  %12: U64 = sub inspect %10 inspect %11
  %13: U64 = and inspect %7 inspect %12
  return take %13

bb3:
  %4: U64 = read copy.trivial (value)
  return take %4
}

