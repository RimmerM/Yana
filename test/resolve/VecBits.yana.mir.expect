module ResolveTest

fn refCount(value: U64 [shared call], bits: U64 [shared call]) -> U64 {
  local & n: U64
  local & i: U64

bb0:
  %0: U64 = const 0
  write.init borrow.unique (n) take %0
  %2: U64 = const 0
  write.init borrow.unique (i) take %2
  jump -> bb1

bb1:
  %5: U64 = read copy.trivial (i)
  %6: U64 = read copy.trivial (bits)
  %7: Bool = lt inspect %5 inspect %6
  branch inspect %7 -> bb3 -> bb2

bb2:
  %26: U64 = read copy.trivial (n)
  return take %26

bb3:
  %9: U64 = read copy.trivial (value)
  %10: U64 = read copy.trivial (i)
  %11: U64 = shr inspect %9 inspect %10
  %12: U64 = const 1
  %13: U64 = and inspect %11 inspect %12
  %14: U64 = const 1
  %15: Bool = eq inspect %13 inspect %14
  branch inspect %15 -> bb6 -> bb4

bb4:
  jump -> bb5

bb5:
  %22: U64 [unique call] = read borrow.unique (i) loan1
  %23: U64 = const 1
  %24: {} = call +=(U64) borrow.unique %22 borrow.shared %23
  jump -> bb1

bb6:
  %17: U64 [unique call] = read borrow.unique (n) loan0
  %18: U64 = const 1
  %19: {} = call +=(U64) borrow.unique %17 borrow.shared %18
  jump -> bb5
}

fn refLeading(value: U64 [shared call], bits: U64 [shared call]) -> U64 {
  local & i: U64

bb0:
  %0: U64 = read copy.trivial (bits)
  write.init borrow.unique (i) take %0
  jump -> bb1

bb1:
  %3: U64 = read copy.trivial (i)
  %4: U64 = const 0
  %5: Bool = gt inspect %3 inspect %4
  branch inspect %5 -> bb3 -> bb2

bb2:
  %26: U64 = read copy.trivial (bits)
  return take %26

bb3:
  %7: U64 [unique call] = read borrow.unique (i) loan0
  %8: U64 = const 1
  %9: {} = call -=(U64) borrow.unique %7 borrow.shared %8
  %10: U64 = read copy.trivial (value)
  %11: U64 = read copy.trivial (i)
  %12: U64 = shr inspect %10 inspect %11
  %13: U64 = const 1
  %14: U64 = and inspect %12 inspect %13
  %15: U64 = const 1
  %16: Bool = eq inspect %14 inspect %15
  branch inspect %16 -> bb6 -> bb4

bb4:
  jump -> bb5

bb5:
  jump -> bb1

bb6:
  %18: U64 = read copy.trivial (bits)
  %19: U64 = const 1
  %20: U64 = sub inspect %18 inspect %19
  %21: U64 = read copy.trivial (i)
  %22: U64 = sub inspect %20 inspect %21
  return take %22
}

