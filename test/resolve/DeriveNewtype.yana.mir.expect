module ResolveTest

data OpenFlags {OpenFlags: I64}

data Handle {Handle: I32}

data Priority {Priority: I32}

instance Bitwise(OpenFlags): OpenFlags.and, OpenFlags.or, OpenFlags.xor, OpenFlags.not

instance Truth(OpenFlags): OpenFlags.truthy

instance Eq(Handle): Handle.==, Eq.!=

instance Eq(Priority): Priority.==, Eq.!=

instance Ord(Priority): Ord.<, Ord.<=, Ord.>, Ord.>=, Priority.compare, Ord.min, Ord.max

fn OpenFlags.and(lhs: OpenFlags [shared call], rhs: OpenFlags [shared call]) -> OpenFlags {
bb0:
  %0: I64 = read copy.trivial (lhs.OpenFlags)
  %1: I64 = read copy.trivial (rhs.OpenFlags)
  %2: I64 = and inspect %0 inspect %1
  %3: OpenFlags = aggregate.OpenFlags take %2
  return take %3
}

fn OpenFlags.or(lhs: OpenFlags [shared call], rhs: OpenFlags [shared call]) -> OpenFlags {
bb0:
  %0: I64 = read copy.trivial (lhs.OpenFlags)
  %1: I64 = read copy.trivial (rhs.OpenFlags)
  %2: I64 = or inspect %0 inspect %1
  %3: OpenFlags = aggregate.OpenFlags take %2
  return take %3
}

fn OpenFlags.xor(lhs: OpenFlags [shared call], rhs: OpenFlags [shared call]) -> OpenFlags {
bb0:
  %0: I64 = read copy.trivial (lhs.OpenFlags)
  %1: I64 = read copy.trivial (rhs.OpenFlags)
  %2: I64 = xor inspect %0 inspect %1
  %3: OpenFlags = aggregate.OpenFlags take %2
  return take %3
}

fn OpenFlags.not(value: OpenFlags [shared call]) -> OpenFlags {
bb0:
  %0: I64 = read copy.trivial (value.OpenFlags)
  %1: I64 = not inspect %0
  %2: OpenFlags = aggregate.OpenFlags take %1
  return take %2
}

fn OpenFlags.truthy(value: OpenFlags [shared call]) -> Bool {
bb0:
  %0: I64 = read copy.trivial (value.OpenFlags)
  %1: I64 = const 0
  %2: Bool = ne inspect %0 inspect %1
  return take %2
}

fn Handle.==(lhs: Handle [shared call], rhs: Handle [shared call]) -> Bool {
bb0:
  %0: I32 = read copy.trivial (lhs.Handle)
  %1: I32 = read copy.trivial (rhs.Handle)
  %2: Bool = eq inspect %0 inspect %1
  return take %2
}

fn Priority.==(lhs: Priority [shared call], rhs: Priority [shared call]) -> Bool {
bb0:
  %0: I32 = read copy.trivial (lhs.Priority)
  %1: I32 = read copy.trivial (rhs.Priority)
  %2: Bool = eq inspect %0 inspect %1
  return take %2
}

fn Priority.compare(lhs: Priority [shared call], rhs: Priority [shared call]) -> Ordering {
bb0:
  %0: I32 = read copy.trivial (lhs.Priority)
  %1: I32 = read copy.trivial (rhs.Priority)
  %2: Ordering = call compare(I32) borrow.shared %0 borrow.shared %1
  return take %2
}

fn combined() -> OpenFlags {
bb0:
  %0: I64 = const 64
  %1: OpenFlags = aggregate.OpenFlags take %0
  %2: I64 = const 512
  %3: OpenFlags = aggregate.OpenFlags take %2
  %4: OpenFlags = call or(OpenFlags) borrow.shared %1 borrow.shared %3
  return take %4
}

fn anySet(flags: OpenFlags [shared call]) -> Bool {
bb0:
  %0: OpenFlags = read copy.trivial (flags)
  %1: Bool = call truthy(OpenFlags) borrow.shared %0
  branch inspect %1 -> bb3 -> bb1

bb1:
  %4: Bool = const False
  jump -> bb2(take %4)

bb2(%5: Bool):
  return take %5

bb3:
  %3: Bool = const True
  jump -> bb2(take %3)
}

fn sameHandle(a: Handle [shared call], b: Handle [shared call]) -> Bool {
bb0:
  %0: Handle = read copy.trivial (a)
  %1: Handle = read copy.trivial (b)
  %2: Bool = call ==(Handle) borrow.shared %0 borrow.shared %1
  return take %2
}

fn differentHandle(a: Handle [shared call], b: Handle [shared call]) -> Bool {
bb0:
  %0: Handle = read copy.trivial (a)
  %1: Handle = read copy.trivial (b)
  %2: Bool = call !=(Handle) borrow.shared %0 borrow.shared %1
  return take %2
}

fn higher(a: Priority [shared call], b: Priority [shared call]) -> Bool {
bb0:
  %0: Priority = read copy.trivial (a)
  %1: Priority = read copy.trivial (b)
  %2: Bool = call >(Priority) borrow.shared %0 borrow.shared %1
  return take %2
}

fn main() -> I32 {
  local flags: OpenFlags
  local bits: I64

bb0:
  %0: OpenFlags = call combined
  write.init borrow.unique (flags) take %0
  %2: OpenFlags = read copy.trivial (flags)
  %3: Bool = call anySet borrow.shared %2
  %4: Bool = not inspect %3
  branch inspect %4 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %9: I32 = const 3
  %10: Handle = aggregate.Handle take %9
  %11: I32 = const 3
  %12: Handle = aggregate.Handle take %11
  %13: Bool = call sameHandle borrow.shared %10 borrow.shared %12
  %14: Bool = not inspect %13
  branch inspect %14 -> bb6 -> bb4

bb3:
  %6: I32 = const 1
  return take %6

bb4:
  jump -> bb5

bb5:
  %19: I32 = const 3
  %20: Handle = aggregate.Handle take %19
  %21: I32 = const 4
  %22: Handle = aggregate.Handle take %21
  %23: Bool = call differentHandle borrow.shared %20 borrow.shared %22
  %24: Bool = not inspect %23
  branch inspect %24 -> bb9 -> bb7

bb6:
  %16: I32 = const 2
  return take %16

bb7:
  jump -> bb8

bb8:
  %29: I32 = const 9
  %30: Priority = aggregate.Priority take %29
  %31: I32 = const 2
  %32: Priority = aggregate.Priority take %31
  %33: Bool = call higher borrow.shared %30 borrow.shared %32
  %34: Bool = not inspect %33
  branch inspect %34 -> bb12 -> bb10

bb9:
  %26: I32 = const 3
  return take %26

bb10:
  jump -> bb11

bb11:
  %39: I64 = read copy.trivial (flags.OpenFlags)
  write.init borrow.unique (bits) take %39
  %41: I64 = read copy.trivial (bits)
  %42: I32 = convert inspect %41
  jump -> bb13(take %42)

bb12:
  %36: I32 = const 4
  return take %36

bb13(%43: I32):
  return take %43
}

entry main
