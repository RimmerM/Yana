@image$base = []

triple<complex>(%x: I32): I32 {
  b_0 {
    %v_1 = imul %x, 3: I32
    ret %v_1
  }
}

negate<complex>(%x: I32): I32 {
  b_0 {
    %v_1 = sub 0, %x: I32
    ret %v_1
  }
}

square<complex>(%x: I32): I32 {
  b_0 {
    %v_1 = imul %x, %x: I32
    ret %v_1
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 32, 8: Ptr
    %v_2 = add %v_1, 8: Ptr
    store %v_2, 0, 8
    %funvalue(triple) = fun funvalue(triple): Ptr
    %v_3 = imm 0: I64
    %v_4 = add %v_1, 16: Ptr
    store %v_4, %funvalue(triple), 8
    %v_5 = add %v_1, 24: Ptr
    store %v_5, %v_3, 8
    store %v_1, funvalue(triple), 8
    %v_6 = bitcast %v_3: Ptr
    %v_7 = call_complex %funvalue(triple), %v_6, 10: I32
    store %v_1, funvalue(negate), 8
    %v_8 = add %v_1, 8: Ptr
    store %v_8, 0, 8
    call_complex teardown(fun), %v_4
    store %v_4, funvalue(square), 8
    %v_9 = add %v_1, 24: Ptr
    store %v_9, 0, 8
    %v_10 = load %v_1, 8: Ptr
    %v_11 = add %v_1, 8: Ptr
    %v_12 = load %v_11, 8: Ptr
    %v_13 = call_complex %v_10, %v_12, 10: I32
    call_complex teardown(fun), %v_1
    %v_14 = add %v_1, 16: Ptr
    call_complex teardown(fun), %v_14
    %v_15 = add %v_13, 100: I32
    %v_16 = add %v_7, 80: I32
    %v_17 = add %v_16, %v_15: I32
    ret %v_17
  }
}

funvalue(triple)<complex>(%v_0: Ptr, %v_1: I32): I32 {
  b_2 {
    %v_3 = call_complex triple, %v_1: I32
    ret %v_3
  }
}

funvalue(negate)<complex>(%v_0: Ptr, %v_1: I32): I32 {
  b_2 {
    %v_3 = call_complex negate, %v_1: I32
    ret %v_3
  }
}

funvalue(square)<complex>(%v_0: Ptr, %v_1: I32): I32 {
  b_2 {
    %v_3 = call_complex square, %v_1: I32
    ret %v_3
  }
}

teardown(fun)<complex>(%v_0: Ptr) {
  b_1 {
    %v_2 = add %v_0, 8: Ptr
    %v_3 = load %v_2, 8: I64
    %v_4 = cmp_eq %v_3, 0: I32
    je %v_4, b_5, b_6
  }

  b_6 {
    %v_7 = load %v_0, 8: Ptr
    %v_8 = sub %v_7, 4: Ptr
    %v_9 = loads %v_8, 4: I32
    %v_10 = sext %v_9: I64
    %v_11 = cmp_eq %v_10, 0: I32
    je %v_11, b_5, b_12
  }

  b_12 {
    %v_13 = add %v_10, @image$base: Ptr
    %v_14 = bitcast %v_3: Ptr
    call_complex %v_13, %v_14
    jmp b_5
  }

  b_5 {
    ret 
  }
}

