    %v_13 = load %v_1, 8: Ptr
    %v_14 = call_complex funvalue(negate), %v_13, 10: I32
    %v_15 = load %v_2, 8: Ptr
    %v_16 = call_complex funvalue(square), %v_15, 10: I32
    %v_17 = add %v_14, %v_16: I32
    %v_18 = add %v_7, %v_12: I32
    %v_19 = add %v_18, %v_17: I32
    ret %v_19
