    %v_7 = add %v_4, %v_6: I32
    store %v_1, 0, 8
    %v_8 = load %v_1, 8: Ptr
    %v_9 = call_complex funvalue(triple), %v_8, 10: I32
    %v_10 = load %v_2, 8: Ptr
