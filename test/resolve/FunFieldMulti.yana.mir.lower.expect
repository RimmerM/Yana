main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 8, 8: Ptr
    %v_2 = alloca 8, 8: Ptr
    store %v_1, 0, 8
    %funvalue(triple) = fun funvalue(triple): Ptr
