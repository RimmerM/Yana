let & log: I32 = 0

lens fn findFirst(n: I32 [shared call], $body: (I32) -> I32 [shared call]) -> Outcome(I32, {}) {
  local $yielded: I32

bb0:
  %0: I32 = read copy.trivial (global log)
  %1: I32 = const 1
  %2: I32 = add inspect %0 inspect %1
  write.assign borrow.unique (global log) take %2
  %4: I32 = read copy.trivial (n)
  %5: I32 = const 0
  %6: Bool = le inspect %4 inspect %5
  branch inspect %6 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %12: I32 = read copy.trivial (n)
  %13: I32 = const 2
  %14: I32 = mul inspect %12 inspect %13
  %15: (I32) -> I32 [shared call] = read borrow.shared ($body) loan0
  %16: I32 = call inspect %15 borrow.shared %14
  write.init borrow.unique ($yielded) take %16
  %18: I32 = read copy.trivial (global log)
  %19: I32 = const 100
  %20: I32 = add inspect %18 inspect %19
  write.assign borrow.unique (global log) take %20
  %22: I32 = read copy.trivial ($yielded)
  %23: Outcome(I32, {}) = aggregate.Proceed take %22
  return take %23

bb3:
  %8: {} = const {}
  %9: Outcome(I32, {}) = aggregate.Exit take {}
  return take %9
}

