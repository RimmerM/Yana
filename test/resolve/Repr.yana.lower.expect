
useRaw<complex>(%it: Ptr): Int {
  b_0 {
    %v_1 = load %it, 8: Ptr
    %v_2 = bitcast %v_1: Long
    %v_3 = cmp_eq %v_2, 0: Int
    ret %v_3
  }
}

