main<complex>(): Int {
  b_0 {
    %flags = alloca 8, 4: Ptr
    store %flags, 1, 4
    %v_1 = add %flags, 4: Ptr
    store %v_1, 0, 4
    %wrapped = alloca 8, 8: Ptr
