
bump<complex>(%x: Ptr) {
  b_0 {
    %v_1 = loads %x, 4: I32
    %v_2 = add %v_1, 1: I32
    store %x, %v_2, 4
    ret 
  }
}

sum<complex>(%a: I32, %b: I32): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    %v_2 = alloca 4, 4: Ptr
    store %v_1, %a, 4
    store %v_2, %b, 4
    %v_3 = loads %v_1, 4: I32
    %v_4 = loads %v_2, 4: I32
    %v_5 = add %v_3, %v_4: I32
