counted<complex>(%n: I32): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    %v_2 = alloca 4, 4: Ptr
    %v_3 = alloca 4, 4: Ptr
    store %v_1, %n, 4
    store %v_2, 0, 4
    store %v_3, 0, 4
    jmp b_4
  }

  b_4 {
    %v_5 = loads %v_3, 4: I32
    %v_6 = loads %v_1, 4: I32
    %v_7 = cmp_ilt %v_5, %v_6: I32
    je %v_7, b_8, b_9
  }

  b_9 {
    %v_10 = loads %v_2, 4: I32
    ret %v_10
  }

  b_8 {
    %v_11 = loads %v_2, 4: I32
    %v_12 = loads %v_3, 4: I32
    %v_13 = add %v_11, %v_12: I32
    store %v_2, %v_13, 4
    %v_14 = loads %v_3, 4: I32
    %v_15 = add %v_14, 1: I32
    store %v_3, %v_15, 4
    jmp b_4
  }
}

flagged<complex>(%x: I32): I32 {
  b_0 {
    %v_1 = alloca 1, 1: Ptr
    %v_2 = alloca 2, 1: Ptr
    store %v_1, %x, 1
    %v_3 = load %v_1, 1: I32
    %v_4 = alloca 2, 1: Ptr
    store %v_4, %v_3, 1
    %v_5 = add %v_4, 1: Ptr
    store %v_5, 0, 1
    copy %v_2, %v_4, 2
    %v_6 = load %v_1, 1: I32
    je %v_6, b_7, b_8
  }

  b_8 {
    jmp b_9
  }

  b_9 {
    %v_10 = load %v_2, 1: I32
    je %v_10, b_11, b_12
  }

  b_7 {
    %v_13 = add %v_2, 1: Ptr
    store %v_13, 1, 1
    jmp b_9
  }

  b_12 {
    jmp b_14
  }

  b_14 {
    %v_15 = phi [b_12, 0], [b_11, 1]: I32
    %v_16 = add %v_2, 1: Ptr
    %v_17 = load %v_16, 1: I32
    je %v_17, b_18, b_19
  }

  b_11 {
    jmp b_14
  }

  b_19 {
    %v_20 = phi [b_14, %v_15]: I32
    jmp b_21
  }

  b_21 {
    %v_22 = phi [b_19, 0], [b_18, 2]: I32
    %v_23 = phi [b_19, %v_20], [b_18, %v_24]: I32
    %v_25 = add %v_23, %v_22: I32
    ret %v_25
  }

  b_18 {
    %v_24 = phi [b_14, %v_15]: I32
    jmp b_21
  }
}

