
main<complex>(): I32 {
  b_0 {
    jmp b_1
  }

  b_2 {
    %v_3 = cmp_ilt %v_4, 5: I32
    je %v_3, b_1, b_5
  }

  b_5 {
    %v_6 = add %v_7, 30: I32
    %v_8 = add %v_6, 3874: I32
    %v_9 = add %v_8, 1200: I32
    %v_10 = add %v_9, 11000: I32
    ret %v_10
  }

  b_1 {
    %v_11 = phi [b_2, %v_7], [b_0, 0]: I32
    %v_12 = phi [b_2, %v_4], [b_0, 0]: I32
    %v_7 = add %v_11, %v_12: I32
    %v_4 = add %v_12, 1: I32
    jmp b_2
  }
}

