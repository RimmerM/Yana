{-
   # extensions: avx512

   `VecRotate.Lanes.yana` at the third level - Analysis-Avx512.md's order of work, which gives every
   runtime fixture a rewritten expansion reaches an `avx512` twin beside its `sse4` and `avx2` ones.
   Two tiers are two expansions of one source, and only running both says they agree.

   A rotation of a dword or quadword lane is `vprold` or `vprolvd` here, and of a word lane by a
   constant `vpshldw`, where every level below writes two shifts and an `or`. What the program
   asserts is written in `VecRotate.Lanes.yana`, and the numbers are the same ones.
-}

let &counter = 0 :: Int

@noinline
fn opaque(n: Int) -> Int:
    counter = counter + 1
    if counter > 1000:
        return 1
    return n

fn check(v: Vec(Int), expected: Int) -> Int = if lane(v, 0) == expected then 1 else 0
fn checkLong(v: Vec(Long), expected: Long) -> Int = if lane(v, 0) == expected then 1 else 0

fn main() -> Int:
    let words = splat(305419896) :: Vec(Int)
    let longs = splat(81985529216486895 :: Long) :: Vec(Long)
    let &n = 0 :: Int

    n = n + check(words `rol` splat(4), 591751041)
    n = n + check(words `ror` splat(4), 0 - 2128394905)
    n = n + check(words `rol` splat(0), 305419896)
    n = n + check(words `rol` splat(32), 305419896)
    n = n + check(words `rol` splat(36), 591751041)

    -- A 64-bit lane, which on JS is a `bigint` per lane and on the machine is the quadword shift.
    n = n + checkLong(longs `rol` splat(8 :: Long), 2541551405711093505)
    n = n + checkLong(longs `rol` splat(64 :: Long), 81985529216486895)

    -- And a count only known at run time, where neither the mask nor the subtraction folds.
    n = n + check(words `rol` splat(opaque(2)), 1221679584)

    return n
