    %v_2 = add %v_1, %amount: Long
    store %target, %v_2, 8
    ret 
  }
}

Drop(Buffer).drop<complex>(%value: Ptr) {
  b_0 {
    %v_1 = load %value, 8: Ptr
    call_complex freeHeap, %v_1
    call_complex -=(I64), @liveBuffers, 1
    ret 
  }
}

