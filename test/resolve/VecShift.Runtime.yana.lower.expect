@image$base = []
mut @counter = [0, 0, 0, 0]

main<complex>(): I32 {
  b_0 {
    %v_1 = vsplat 64: i32x4
    %v_2 = vwithlane %v_1, 5, 0: i32x4
    %v_3 = vwithlane %v_2, 100, 1: i32x4
    %a = vwithlane %v_3, 18446744073709551584, 2: i32x4
    %b = vsplat 3: i64x2
    %v_4 = loads @counter, 4: I32
    %v_5 = imm 2: I32
    %v_6 = add %v_4, %v_5: I32
    %v_7 = cmp_igt %v_6, 1000: I32
    %n = select %v_7, 1, %v_5: I32
    %v_8 = add %v_4, 5: I32
    store @counter, %v_8, 4
    %v_9 = cmp_igt %v_8, 1000: I32
    %v_10 = select %v_9, 1, 3: I32
    %m = sext %v_10: I64
    %count = vsplat %n: i32x4
    %left = shl %a, %count: i32x4
    %right = shr %a, %count: i32x4
    %arith = sar %a, %count: i32x4
    %v_11 = vlane %left, 0: I32
    %v_12 = vlane %right, 1: I32
    %v_13 = add %v_11, %v_12: I32
    %v_14 = vlane %arith, 2: I32
    %v_15 = add %v_13, %v_14: I32
    %v_16 = vsplat %m: i64x2
    %up = shl %b, %v_16: i64x2
    %v_17 = sub %m, 1: I64
    %v_18 = vsplat %v_17: i64x2
    %down = shr %up, %v_18: i64x2
    %v_19 = vsplat 0: i64x2
    %v_20 = sub %v_19, %b: i64x2
    %signed = sar %v_20, %v_16: i64x2
    %v_21 = vlane %down, 0: I64
    %v_22 = vlane %signed, 0: I64
    %v_23 = add %v_21, %v_22: I64
    %v_24 = cast %v_23: I32
    %v_25 = add %v_15, %v_24: I32
    ret %v_25
  }
}

