@image$base = []
mut @live = [0, 0, 0, 0]
mut @trace = [0, 0, 0, 0]

bump<complex>(%v: Ptr) {
  b_0 {
    %v_1 = loads %v, 4: I32
    %v_2 = add %v_1, 100: I32
    store %v, %v_2, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    jmp b_1
  }

  b_2 {
    %v_3 = cmp_ilt %v_4, 3: I32
    je %v_3, b_1, b_5
  }

  b_5 {
    %v_6 = cmp_eq %v_7, 12: I32
    %v_8 = select %v_6, 4, 0: I32
    %v = alloca 4, 4: Ptr
    store %v, 7, 4
    call_complex bump, %v
    %v_9 = loads %v, 4: I32
    %v_10 = cmp_eq %v_9, 107: I32
    %v_11 = select %v_10, 8, 0: I32
    %v_12 = loads @live, 4: I32
    %v_13 = add %v_12, 1: I32
    %v_14 = sub %v_13, 1: I32
    store @live, %v_14, 4
    %v_15 = loads @trace, 4: I32
    %v_16 = imul %v_15, 10: I32
    %v_17 = add %v_16, 4: I32
    store @trace, %v_17, 4
    %v_18 = add %v_8, 3: I32
    %v_19 = add %v_18, %v_11: I32
    %v_20 = add %v_19, 1008: I32
    %v_21 = imul %v_14, 10000: I32
    %v_22 = add %v_20, %v_21: I32
    %v_23 = add %v_22, %v_17: I32
    ret %v_23
  }

  b_1 {
    %v_24 = phi [b_2, %v_7], [b_0, 0]: I32
    %v_25 = phi [b_2, %v_4], [b_0, 0]: I32
    %v_26 = imul %v_24, 10: I32
    %v_7 = add %v_26, %v_25: I32
    %v_4 = add %v_25, 1: I32
    jmp b_2
  }
}

