@image$base = []

fact<complex>(%n: Int): Int {
  b_0 {
    %v_1 = cmp_ile %n, 1: Int
    je %v_1, b_2, b_3
  }

  b_2 {
    jmp b_4
  }

  b_3 {
    %v_5 = sub %n, 1: Int
    %v_6 = call_complex fact, %v_5: Int
    %v_7 = imul %n, %v_6: Int
    jmp b_4
  }

  b_4 {
    %v_8 = phi [b_2, 1], [b_3, %v_7]: Int
    ret %v_8
  }
}

main<complex>(): Int {
  b_0 {
    %v_1 = call_complex fact, 4: Int
    %v_2 = add %v_1, 94: Int
    ret %v_2
  }
}

