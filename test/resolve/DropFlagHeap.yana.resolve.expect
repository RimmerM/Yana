    %v19 = load %i : Int
    %v22 = cmp_lt %v19, 100 : Bool
    je %v22, b6, b5

  b5:
    %v33 = load live : Int
    %v36 = cmp_ne %v33, 0 : Bool
    je %v36, b7, b8

  b6:
    %each = call heaped, True, False : Int
    %v27 = load %i : Int
    %v30 = add %v27, 1 : Int
