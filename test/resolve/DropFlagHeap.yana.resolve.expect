}

fn heapClassOf(%total: I64) -> I64 {
  b0:
    %size = alloc : I64
    init %size, 16
    %sizeClass = alloc : I64
    init %sizeClass, 0
    jmp b1

  b1:
    %v8 = load %size : I64
    %v9 = cmp_lt %v8, %total : Bool
    je %v9, b3, b2

  b2:
    %v21 = load %sizeClass : I64
    ret %v21

  b3:
    %v11 = load %size : I64
    %v12 = load %size : I64
    %v13 = add %v11, %v12 : I64
    assign %size, %v13
    %v15 = load %sizeClass : I64
    %v18 = add %v15, 1 : I64
    assign %sizeClass, %v18
    jmp b1
}

fn heapBlockSize(%sizeClass: I64) -> I64 {
  b0:
    %v2 = shl 16, %sizeClass : I64
    ret %v2
