fn allocateHeap(%size: I64) -> %U8 {
  b0:
    %v1 = load heapFree : %%U8
    %v2 = cast %v1 : Long
    %v4 = cmp_eq %v2, 0 : Bool
    je %v4, b1, b2

  b1:
    call initHeap
    %v7 = load heapFree : %%U8
    %v8 = cast %v7 : Long
    %v10 = cmp_eq %v8, 0 : Bool
    je %v10, b3, b4

  b2:
    jmp b6

  b3:
    %v13 = cast 0 : %U8
    ret %v13

  b4:
    jmp b5

  b5:
    jmp b6

  b6:
    %v20 = add %size, 8 : I64
    %sizeClass = call heapClassOf, %v20 : I64
    %v23 = cmp_ge %sizeClass, 32 : Bool
    je %v23, b7, b8

  b7:
    %v26 = cast 0 : %U8
    ret %v26

  b8:
    jmp b9

  b9:
    %reused = call freeListHead, %sizeClass : %U8
    %v30 = cast %reused : Long
    %v32 = cmp_eq %v30, 0 : Bool
    %v34 = xor %v32, True : Bool
    je %v34, b10, b11

  b10:
    %v36 = cast %reused : %%U8
    %v37 = load [%v36] : %U8
    call setFreeListHead, %sizeClass, %v37
    ret %reused

  b11:
    jmp b12

  b12:
    %block = load heapNext : %U8
    %blockSize = call heapBlockSize, %sizeClass : I64
    %v43 = strideof U8 : I64
    %v44 = mul %blockSize, %v43 : I64
    %v45 = add %block, %v44 : %U8
    %v46 = load heapLimit : %U8
    %v47 = cmp_gt %v45, %v46 : Bool
    je %v47, b13, b14

  b13:
    %v50 = cast 0 : %U8
    ret %v50

  b14:
    jmp b15

  b15:
    %v53 = strideof U8 : I64
    %v54 = mul %blockSize, %v53 : I64
    %v55 = add %block, %v54 : %U8
    assign heapNext, %v55
    %v57 = cast %block : %I64
    assign [%v57], %sizeClass
    %v61 = strideof U8 : I64
    %v62 = mul 8, %v61 : I64
    %v63 = add %block, %v62 : %U8
    ret %v63
