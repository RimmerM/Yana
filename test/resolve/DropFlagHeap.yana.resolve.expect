fn initHeap() -> () {
  b0:
    %region = call mapMemory, 4194304 : %U8
    %v2 = cast %region : Long
    %v4 = cmp_eq %v2, 0 : Bool
    je %v4, b1, b2

  b1:
    ret

  b2:
    jmp b3

  b3:
    %table = mul 32, 8 : I64
    setmemory %region, 0, %table
    %v14 = cast %region : %%U8
    assign heapFree, %v14
    %v16 = strideof U8 : I64
    %v17 = mul %table, %v16 : I64
    %v18 = add %region, %v17 : %U8
    assign heapNext, %v18
    %v21 = strideof U8 : I64
    %v22 = mul 4194304, %v21 : I64
    %v23 = add %region, %v22 : %U8
    assign heapLimit, %v23
