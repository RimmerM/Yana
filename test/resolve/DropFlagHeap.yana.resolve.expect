fn freeListHead(%sizeClass: I64) -> %U8 {
  b0:
    %v1 = load heapFree : %%U8
    %v2 = strideof %U8 : I64
    %v3 = mul %sizeClass, %v2 : I64
    %v4 = add %v1, %v3 : %%U8
    %v5 = load [%v4] : %U8
