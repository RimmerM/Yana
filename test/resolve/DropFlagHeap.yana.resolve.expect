fn freeHeap(%allocation: %U8) -> () {
  b0:
    %v1 = cast %allocation : Long
    %v3 = cmp_eq %v1, 0 : Bool
    je %v3, b1, b2

  b1:
    ret

  b2:
    jmp b3

  b3:
    %v9 = strideof U8 : I64
    %v10 = mul 8, %v9 : I64
    %v11 = sub %allocation, %v10 : %U8
    %v12 = cast %v11 : %I64
    %sizeClass = load [%v12] : I64
    %v14 = cast %allocation : %%U8
    %v15 = call freeListHead, %sizeClass : %U8
    assign [%v14], %v15
    call setFreeListHead, %sizeClass, %allocation
    ret
