fn setFreeListHead(%sizeClass: I64, %block: %U8) -> () {
  b0:
    %v2 = load heapFree : %%U8
    %v3 = strideof %U8 : I64
    %v4 = mul %sizeClass, %v3 : I64
    %v5 = add %v2, %v4 : %%U8
    assign [%v5], %block
