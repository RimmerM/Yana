fn guard(%id: Int) -> Guard {
  b0:
    %v1 = load live : Int
    %v4 = add %v1, 1 : Int
    assign live, %v4
    %v6 = alloc : Guard
    aggregate %local0@Guard.id = %id
    ret %v6
}

fn consume(%g: Guard) -> Int {
  b0:
    %v1 = load %g@Guard.id : Int
    drop %g via Drop(Guard).drop
    ret %v1
}

fn heaped(%c: Bool, %d: Bool) -> Int {
  b0:
    %v20 = alloc : Bool
    init %local3, False
    %v3 = call guard, 1 : Guard
    %g = alloc heap : Guard
    assign %local3, False
    init %g, %v3
    assign %local3, True
    je %c, b1, b2

  b1:
    %v7 = load %g : Guard
    %v8 = move %g : Guard
    assign %local3, False
    %n = call consume, %v8 : Int
    jmp b3

  b2:
    jmp b3

  b3:
    je %d, b4, b9

  b4:
    %v14 = call guard, 2 : Guard
    %v36 = load %local3 : Bool
    je %v36, b5, b6

  b5:
    drop %g via Drop(Guard).drop
    jmp b6

  b6:
    assign %g, %v14
    assign %local3, True
    drop %g via Drop(Guard).drop release
    jmp b8

  b7:
    jmp b8

  b8:
    %v18 = load live : Int
    ret %v18

  b9:
    %v39 = load %local3 : Bool
    je %v39, b10, b11

  b10:
    drop %g via Drop(Guard).drop
    jmp b11

  b11:
    drop %g release
    jmp b7
}

fn main() -> Int {
  b0:
    %first = call heaped, True, False : Int
    %v3 = load live : Int
    %v6 = cmp_ne %v3, 0 : Bool
    je %v6, b1, b2

  b1:
    %v10 = neg 1 : Int
    ret %v10

  b2:
    jmp b3

  b3:
    %v13 = load heapNext : %U8
    %mark = cast %v13 : I64
    %i = alloc : Int
