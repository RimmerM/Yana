module ResolveTest

data Pinned {value: @bits(53) U64}

data Loose {value: @bits(53) U64}

data Ordered {first: I8, second: I64, third: I8}

data Written {only: I32}

fn usePinned(it: Pinned [shared call]) -> U64 {
bb0:
  %0: @bits(53) U64 = read copy.trivial (it.value)
  %1: U64 = convert inspect %0
  return take %1
}

fn useLoose(it: Loose [shared call]) -> U64 {
bb0:
  %0: @bits(53) U64 = read copy.trivial (it.value)
  %1: U64 = convert inspect %0
  return take %1
}

fn useOrdered(it: Ordered [shared call]) -> I64 {
bb0:
  %0: I64 = read copy.trivial (it.second)
  return take %0
}

fn useWritten(it: Written [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (it.only)
  return take %0
}

fn main() -> I32 {
  local p: Pinned
  local o: Ordered

bb0:
  %0: @bits(53) U64 = const 7
  %1: Pinned = aggregate.Pinned take %0
  write.init borrow.unique (p) take %1
  %3: I8 = const 1
  %4: I64 = const 2
  %5: I8 = const 3
  %6: Ordered = aggregate.Ordered take %3 take %4 take %5
  write.init borrow.unique (o) take %6
  %8: Pinned = read copy.trivial (p)
  %9: U64 = call usePinned borrow.shared %8
  %10: I32 = convert inspect %9
  %11: Ordered = read copy.trivial (o)
  %12: I64 = call useOrdered borrow.shared %11
  %13: I32 = convert inspect %12
  %14: I32 = add inspect %10 inspect %13
  return take %14
}

entry main
