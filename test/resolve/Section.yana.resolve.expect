fn sign(%x: Int) -> Int {
  b0:
    %v2 = cmp_gt %x, 0 : Bool
    je %v2, b2, b1

  b1:
    %v6 = cmp_lt %x, 0 : Bool
    je %v6, b4, b3

  b2:
    jmp b5

  b3:
    jmp b5

  b4:
    %v9 = neg 1 : Int
    jmp b5

  b5:
    %v14 = phi [b2, 1], [b4, %v9], [b3, 0] : Int
    ret %v14
}

fn clampedTo(%x: Int, %limit: Int) -> Int {
  b0:
    %v2 = cmp_gt %x, %limit : Bool
    je %v2, b2, b1

  b1:
    %v4 = cmp_eq %x, %limit : Bool
    je %v4, b4, b3

  b2:
    jmp b5

  b3:
    jmp b5

  b4:
    jmp b5

  b5:
    %v10 = phi [b2, %limit], [b4, 0], [b3, %x] : Int
    ret %v10
}

fn shadowing(%x: Int, %limit: Int) -> Int {
  b0:
    %v4 = add %x, 1 : Int
    jmp b1

  b1:
    ret %v4
}

fn doubleIfPositive(%x: Int) -> Int {
  b0:
    %v2 = cmp_gt %x, 0 : Bool
    je %v2, b2, b1

  b1:
    jmp b3

  b2:
    %v6 = mul %x, 2 : Int
    jmp b3

  b3:
    %v9 = phi [b2, %v6], [b1, %x] : Int
    ret %v9
}

fn area(%s: Shape) -> Int {
  b0:
    %v1 = load %s.discriminant : Int
    %v3 = cmp_eq %v1, 0 : Bool
    je %v3, b2, b1

  b1:
    %v10 = load %s.discriminant : Int
    %v12 = cmp_eq %v10, 0 : Bool
    je %v12, b5, b4

  b2:
    %v5 = load %s@Circle : Int
    %v7 = cmp_gt %v5, 10 : Bool
    je %v7, b3, b1

  b3:
    jmp b9

  b4:
    %v15 = load %s.discriminant : Int
    %v17 = cmp_eq %v15, 1 : Bool
    je %v17, b7, b6

  b5:
    %r = load %s@Circle : Int
    jmp b9

  b6:
    %v28 = load %s@Square : {width: Int, height: Int}
    %w = load %s@Square.width : Int
    %v30 = load %s@Square.height : Int
    jmp b9

  b7:
    %v19 = load %s@Square : {width: Int, height: Int}
    %v20 = load %s@Square.width : Int
    %v22 = cmp_gt %v20, 10 : Bool
    je %v22, b8, b6

  b8:
    %h = load %s@Square.height : Int
    %v27 = add %h, 10 : Int
    jmp b9

  b9:
    %v35 = phi [b3, 100], [b5, %r], [b8, %v27], [b6, %w] : Int
    ret %v35
}

fn firstIfEqual(%p: {Int, Int}) -> Int {
  b0:
    %a = load %p.0 : Int
    %v2 = load %p.1 : Int
    %v3 = cmp_eq %v2, %a : Bool
    je %v3, b2, b1

  b1:
    %a = load %p.0 : Int
    %b = load %p.1 : Int
    %v7 = add %a, %b : Int
    jmp b3

  b2:
    jmp b3

  b3:
    %v10 = phi [b2, %a], [b1, %v7] : Int
    ret %v10
}

fn near(%a: Int, %b: Int) -> Bool {
  b0:
    %v2 = sub %a, %b : Int
    %v5 = cmp_lt %v2, 2 : Bool
    %v6 = sub %b, %a : Int
    %v9 = cmp_lt %v6, 2 : Bool
    %v10 = and %v5, %v9 : Bool
    ret %v10
}

fn isNearTen(%x: Int) -> Int {
  b0:
    %v2 = call near, %x, 10 : Bool
    je %v2, b2, b1

  b1:
    jmp b3

  b2:
    jmp b3

  b3:
    %v8 = phi [b2, 1], [b1, 0] : Int
    ret %v8
}

fn positiveOr(%x: Int, %fallback: Int) -> Int {
  b0:
    %v3 = cmp_gt %x, 0 : Bool
    je %v3, b2, b1

  b1:
    ret %fallback

  b2:
    ret %x
}

fn main() -> Int {
  b0:
    %v1 = call sign, 5 : Int
    %v3 = neg 5 : Int
    %v4 = call sign, %v3 : Int
    %v5 = add %v1, %v4 : Int
    %v7 = call sign, 0 : Int
    %v8 = add %v5, %v7 : Int
    %v11 = call clampedTo, 20, 10 : Int
    %v12 = add %v8, %v11 : Int
