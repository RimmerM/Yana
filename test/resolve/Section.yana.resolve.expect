    %v76 = call firstIfEqual, %v71 : Int
    %v77 = add %v70, %v76 : Int
    %v79 = call isNearTen, 11 : Int
    %v80 = add %v77, %v79 : Int
    %v82 = call isNearTen, 50 : Int
    %v83 = add %v80, %v82 : Int
    %v86 = neg 1 : Int
    %v87 = call positiveOr, 9, %v86 : Int
    %v88 = add %v83, %v87 : Int
    %v90 = neg 9 : Int
    %v92 = neg 1 : Int
    %v93 = call positiveOr, %v90, %v92 : Int
    %v94 = add %v88, %v93 : Int
    ret %v94
}
