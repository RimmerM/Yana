    %v53 = call area, %v46 : Int
    %v54 = add %v45, %v53 : Int
    %v55 = alloc : Shape
    init %local3.discriminant, 1
    init %local3@Square.width, 3
    init %local3@Square.height, 9
    %v62 = call area, %v55 : Int
    %v63 = add %v54, %v62 : Int
    %v64 = alloc : {Int, Int}
