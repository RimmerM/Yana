    %v26 = call doubleIfPositive, 4 : Int
    %v27 = add %v24, %v26 : Int
    %v29 = neg 4 : Int
    %v30 = call doubleIfPositive, %v29 : Int
    %v31 = add %v27, %v30 : Int
    %v32 = alloc : Shape
    init %local0.discriminant, 0
    init %local0@Circle, 20
    %v37 = call area, %v32 : Int
    %v38 = add %v31, %v37 : Int
    %v39 = alloc : Shape
    init %local1.discriminant, 0
    init %local1@Circle, 3
    %v44 = call area, %v39 : Int
    %v45 = add %v38, %v44 : Int
    %v46 = alloc : Shape
    init %local2.discriminant, 1
    init %local2@Square.width, 20
