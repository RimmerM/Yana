module ResolveTest

fn identity(value: a) -> a {
  form specialized
  slot #0 type a
bb0:
  %0: a = read take (value)
  return take %0
}

fn firstOf(x: a, y: a [shared call]) -> a {
  form specialized
  slot #0 type a
bb0:
  %0: a = read take (x)
  return take %0
}

fn pick(flag: Bool [shared call], x: a [shared call], y: b) -> b {
  form specialized
  slot #0 type a
  slot #1 type b
bb0:
  %0: b = read take (y)
  return take %0
}

fn twice(x: a [shared call]) -> a {
  form specialized
  slot #0 type a
  slot #1 class Num(a)
bb0:
  %0: a [shared call] = read borrow.shared (x) loan0
  %1: a [shared call] = read borrow.shared (x) loan1
  %2: a = call +(a) borrow.shared %0 borrow.shared %1
  return take %2
}

fn smaller(x: a, y: a) -> a {
  form specialized
  slot #0 type a
  slot #1 class Ord(a)
bb0:
  %0: a [shared call] = read borrow.shared (x) loan0
  %1: a [shared call] = read borrow.shared (y) loan1
  %2: Bool = call <(a) borrow.shared %0 borrow.shared %1
  branch inspect %2 -> bb3 -> bb1

bb1:
  drop (x)
  %5: a = read take (y)
  jump -> bb2(take %5)

bb2(%6: a):
  return take %6

bb3:
  drop (y)
  %4: a = read take (x)
  jump -> bb2(take %4)
}

fn middle(x: a, y: a, z: a) -> a {
  form specialized
  slot #0 type a
  slot #1 class Ord(a)
bb0:
  %0: a = read take (x)
  %1: a = read take (y)
  %2: a = call smaller(a) take %0 take %1
  %3: a = read take (z)
  %4: a = call smaller(a) take %2 take %3
  return take %4
}

fn increment(x: a [shared call]) -> a {
  form specialized
  slot #0 type a
  slot #1 class Num(a)
  local local1: a

bb0:
  %0: a [shared call] = read borrow.shared (x) loan0
  %1: I64 = const 1
  %2: a = call fromInt(a) borrow.shared %1
  write.init borrow.unique (local1) take %2
  %4: a [shared call] = read borrow.shared (local1) loan1
  %5: a = call +(a) borrow.shared %0 borrow.shared %4
  drop (local1)
  return take %5
}

fn carriesNothing() -> I32 {
bb0:
  %0: Bool = const True
  %1: {} = const {}
  %2: I32 = const 3
  %3: I32 = call pick({}, I32) borrow.shared %0 borrow.shared {} take %2
  return take %3
}

fn nothingForwarded(z: b) -> b {
  form specialized
  slot #0 type b
bb0:
  %0: Bool = const False
  %1: {} = const {}
  %2: b = read take (z)
  %3: b = call pick({}, b) borrow.shared %0 borrow.shared {} take %2
  return take %3
}

fn main() -> I32 {
  local one: I32
  local two: I32
  local three: I32

bb0:
  %0: I32 = const 1
  %1: I32 = call identity(I32) take %0
  write.init borrow.unique (one) take %1
  %3: I32 = const 2
  %4: I32 = const 99
  %5: I32 = call firstOf(I32) take %3 borrow.shared %4
  write.init borrow.unique (two) take %5
  %7: Bool = const True
  %8: Bool = const False
  %9: I32 = const 3
  %10: I32 = call pick(Bool, I32) borrow.shared %7 borrow.shared %8 take %9
  write.init borrow.unique (three) take %10
  %12: I32 = read copy.trivial (one)
  %13: I32 = read copy.trivial (two)
  %14: I32 = add inspect %12 inspect %13
  %15: I32 = read copy.trivial (three)
  %16: I32 = add inspect %14 inspect %15
  %17: I32 = const 5
  %18: I32 = call twice(I32) borrow.shared %17
  %19: I32 = add inspect %16 inspect %18
  %20: I32 = const 30
  %21: I32 = const 8
  %22: I32 = call smaller(I32) take %20 take %21
  %23: I32 = add inspect %19 inspect %22
  %24: I32 = const 60
  %25: I32 = const 12
  %26: I32 = const 40
  %27: I32 = call middle(I32) take %24 take %25 take %26
  %28: I32 = add inspect %23 inspect %27
  %29: I32 = const 19
  %30: I32 = call increment(I32) borrow.shared %29
  %31: I32 = add inspect %28 inspect %30
  %32: I32 = call carriesNothing
  %33: I32 = add inspect %31 inspect %32
  %34: I32 = const 7
  %35: I32 = call nothingForwarded(I32) take %34
  %36: I32 = add inspect %33 inspect %35
  return take %36
}

fn identity(I32)(value: I32) -> I32 = <identity at I32>

fn firstOf(I32)(x: I32, y: I32 [shared call]) -> I32 = <firstOf at I32>

fn pick(Bool, I32)(flag: Bool [shared call], x: Bool [shared call], y: I32) -> I32 = <pick at Bool, I32>

fn twice(I32)(x: I32 [shared call]) -> I32 = <twice at I32>

fn smaller(I32)(x: I32, y: I32) -> I32 = <smaller at I32>

fn middle(I32)(x: I32, y: I32, z: I32) -> I32 = <middle at I32>

fn increment(I32)(x: I32 [shared call]) -> I32 = <increment at I32>

fn nothingForwarded(I32)(z: I32) -> I32 = <nothingForwarded at I32>

fn pick({}, I32)(flag: Bool [shared call], x: {} [shared call], y: I32) -> I32 = <pick at {}, I32>

entry main
