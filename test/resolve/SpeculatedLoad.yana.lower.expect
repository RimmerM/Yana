@image$base = []

hoist<complex>(%p: Ptr, %n: I32): I64 {
  b_0 {
    %v_1 = add %p, 18446744073709551600: Ptr
    %h = loads %v_1, 8: I64
    jmp b_2
  }

  b_2 {
    %v_3 = phi [b_0, 0], [b_4, %v_5]: I32
    %v_6 = phi [b_0, 0], [b_4, %v_7]: I64
    %v_8 = cmp_ilt %v_3, %n: I32
    je %v_8, b_4, b_9
  }

  b_9 {
    %v_10 = add %h, %v_6: I64
    ret %v_10
  }

  b_4 {
    %v_11 = loads %p, 8: I64
    %v_7 = add %v_6, %v_11: I64
    %v_5 = add %v_3, 1: I32
    jmp b_2
  }
}

cell<complex>(%p: Ptr, %n: I32): I64 {
  b_0 {
    %v_1 = add %p, 18446744073709551600: Ptr
    %h = loads %v_1, 8: I64
    jmp b_2
  }

  b_2 {
    %v_3 = phi [b_0, 0], [b_4, %v_5]: I32
    %v_6 = cmp_ilt %v_3, %n: I32
    je %v_6, b_4, b_7
  }

  b_7 {
    ret %h
  }

  b_4 {
    %v_8 = loads %p, 8: I64
    %v_9 = add %v_8, %h: I64
    store %p, %v_9, 8
    %v_5 = add %v_3, 1: I32
    jmp b_2
  }
}

main<complex>(): I32 {
  b_0 {
    %base = syscall 9, 0, 8192, 3, 34, 18446744073709551615, 0: I64
    %v_1 = add %base, 4096: I64
    %protect = syscall 10, %v_1, 4096, 0: I64
    %v_2 = cmp_neq %protect, 0: I32
    je %v_2, b_3, b_4
  }

  b_3 {
    ret 1
  }

  b_4 {
    %p = bitcast %v_1: Ptr
    %v_5 = add %p, 18446744073709551600: Ptr
    store %v_5, 5, 8
    %v_6 = call_complex hoist, %p, 0: I64
    %v_7 = call_complex cell, %p, 0: I64
    %v_8 = add %v_6, %v_7: I64
    %v_9 = cast %v_8: I32
    ret %v_9
  }
}

