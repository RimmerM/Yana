module ResolveTest

data Box {small: @bits(4) U32}

data SignedBox {value: @bits(4) I32}

fn checkU(actual: U32 [shared call], expected: U32 [shared call], weight: I32 [shared call]) -> I32 {
bb0:
  %0: U32 = read copy.trivial (actual)
  %1: U32 = read copy.trivial (expected)
  %2: Bool = eq inspect %0 inspect %1
  branch inspect %2 -> bb3 -> bb1

bb1:
  %5: I32 = const 0
  jump -> bb2(take %5)

bb2(%6: I32):
  return take %6

bb3:
  %4: I32 = read copy.trivial (weight)
  jump -> bb2(take %4)
}

