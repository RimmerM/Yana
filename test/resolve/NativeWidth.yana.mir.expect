fn foldedStore() -> U32 {
  local b: Box

bb0:
  %0: @bits(4) U32 = const 4
  %1: Box = aggregate.Box take %0
  write.init borrow.unique (b) take %1
  %3: @bits(4) U32 = read copy.trivial (b.small)
  %4: U32 = convert inspect %3
