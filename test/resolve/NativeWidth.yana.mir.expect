fn boxed(value: U32 [shared call]) -> U32 {
  local b: Box

bb0:
  %0: U32 = read copy.trivial (value)
  %1: @bits(4) U32 = convert inspect %0
  %2: Box = aggregate.Box take %1
  write.init borrow.unique (b) take %2
  %4: @bits(4) U32 = read copy.trivial (b.small)
  %5: U32 = convert inspect %4
  return take %5
}

