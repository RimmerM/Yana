    %v_3 = cmp_eq %v_2, 0: I32
    je %v_3, b_4, b_5
  }

  b_6 {
    ret 
  }

  b_4 {
    %v_7 = add %v_0, 8: Ptr
    call_complex teardown(fun), %v_7
    jmp b_6
  }

  b_5 {
