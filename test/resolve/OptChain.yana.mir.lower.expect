funvalue(twice)<complex>(%v_0: Ptr, %v_1: I32): I32 {
  b_2 {
    %v_3 = call_complex twice, %v_1: I32
    ret %v_3
  }
}

teardown(fun)<complex>(%v_0: Ptr) {
  b_1 {
    %v_2 = add %v_0, 8: Ptr
    %v_3 = load %v_2, 8: I64
    %v_4 = cmp_eq %v_3, 0: I32
    je %v_4, b_5, b_6
  }

  b_6 {
    %v_7 = load %v_0, 8: Ptr
    %v_8 = sub %v_7, 4: Ptr
    %v_9 = loads %v_8, 4: I32
    %v_10 = sext %v_9: I64
    %v_11 = cmp_eq %v_10, 0: I32
    je %v_11, b_5, b_12
  }

  b_12 {
    %v_13 = add %v_10, @image$base: Ptr
    %v_14 = bitcast %v_3: Ptr
    call_complex %v_13, %v_14
    jmp b_5
  }

  b_5 {
    ret 
  }
}

teardown(Maybe((I32) -> I32))<complex>(%v_0: Ptr) {
  b_1 {
    %v_2 = load %v_0, 1: I32
    %v_3 = cmp_eq %v_2, 1: I32
    je %v_3, b_4, b_5
  }

  b_6 {
    ret 
  }

  b_4 {
    %v_7 = add %v_0, 8: Ptr
    call_complex teardown(fun), %v_7
    jmp b_6
  }

  b_5 {
    jmp b_6
  }
}

teardown(Outcome((I32) -> I32, {}))<complex>(%v_0: Ptr) {
  b_1 {
    %v_2 = load %v_0, 1: I32
    %v_3 = cmp_eq %v_2, 0: I32
    je %v_3, b_4, b_5
  }

  b_6 {
    ret 
  }

  b_4 {
    %v_7 = add %v_0, 8: Ptr
    call_complex teardown(fun), %v_7
    jmp b_6
