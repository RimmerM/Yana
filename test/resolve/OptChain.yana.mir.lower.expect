mut @log = [0, 0, 0, 0]
mut @dropped = [0, 0, 0, 0]
@image$base = []

Node.drop<complex>() {
  b_0 {
    %v_1 = loads @dropped, 4: I32
    %v_2 = add %v_1, 1: I32
    store @dropped, %v_2, 4
    ret 
  }
}

twice<complex>(%x: I32): I32 {
  b_0 {
    %v_1 = shl %x, 1: I32
    ret %v_1
  }
}

main<complex>(): I32 {
  b_0 {
    store @log, 0, 4
    store @dropped, 0, 4
    store @log, 1, 4
    call_complex Node.drop
    %v_1 = alloca 20, 4: Ptr
    %v_2 = loads @log, 4: I32
    %v_3 = add %v_2, 1: I32
    store @log, %v_3, 4
    %v_4 = alloca 20, 4: Ptr
    store %v_4, 0, 1
    call_complex teardown(Maybe(Node)), %v_4
    store %v_1, 1, 1
    call_complex teardown(Outcome(Node, {})), %v_1
    %v_5 = loads @log, 4: I32
    %v_6 = add %v_5, 1: I32
    store @log, %v_6, 4
    call_complex Node.drop
    %v_7 = loads @log, 4: I32
    %v_8 = add %v_7, 1: I32
    store @log, %v_8, 4
    call_complex Node.drop
    %v_9 = alloca 20, 4: Ptr
    %v_10 = loads @log, 4: I32
    %v_11 = add %v_10, 1: I32
    store @log, %v_11, 4
    %v_12 = alloca 20, 4: Ptr
    store %v_12, 0, 1
    call_complex teardown(Maybe(Node)), %v_12
    store %v_9, 1, 1
    call_complex teardown(Outcome(Node, {})), %v_9
    %v_13 = loads @log, 4: I32
    %v_14 = add %v_13, 10: I32
    store @log, %v_14, 4
    call_complex Node.drop
    %v_15 = alloca 20, 4: Ptr
    %v_16 = loads @log, 4: I32
    %v_17 = add %v_16, 10: I32
    store @log, %v_17, 4
    store %v_15, 1, 1
    %v_18 = add %v_15, 4: Ptr
    store %v_18, 18446744073709551614, 4
    call_complex teardown(Outcome(Node, I32)), %v_15
    %v_19 = loads @log, 4: I32
    %v_20 = add %v_19, 1: I32
    store @log, %v_20, 4
    call_complex Node.drop
    %v_21 = loads @log, 4: I32
    %v_22 = add %v_21, 1: I32
    store @log, %v_22, 4
    call_complex Node.drop
    %v_23 = loads @log, 4: I32
    %v_24 = add %v_23, 1: I32
    store @log, %v_24, 4
    call_complex Node.drop
    %v_25 = loads @log, 4: I32
    %v_26 = add %v_25, 1: I32
    store @log, %v_26, 4
    call_complex Node.drop
    %v_27 = alloca 20, 4: Ptr
    %v_28 = loads @log, 4: I32
    %v_29 = add %v_28, 1: I32
    store @log, %v_29, 4
    %v_30 = alloca 20, 4: Ptr
    store %v_30, 0, 1
    call_complex teardown(Maybe(Node)), %v_30
    store %v_27, 1, 1
    call_complex teardown(Outcome(Node, {})), %v_27
    %v_31 = loads @log, 4: I32
    %v_32 = add %v_31, 1: I32
    store @log, %v_32, 4
    call_complex Node.drop
    %v_33 = alloca 20, 4: Ptr
    %v_34 = loads @log, 4: I32
    %v_35 = add %v_34, 1: I32
    store @log, %v_35, 4
    %v_36 = alloca 20, 4: Ptr
    store %v_36, 0, 1
    call_complex teardown(Maybe(Node)), %v_36
    store %v_33, 1, 1
    call_complex teardown(Outcome(Node, {})), %v_33
    %v_37 = alloca 16, 8: Ptr
    %funvalue(twice) = fun funvalue(twice): Ptr
    %v_38 = imm 0: I64
    store %v_37, %funvalue(twice), 8
    %v_39 = add %v_37, 8: Ptr
    store %v_39, %v_38, 8
    %v_40 = bitcast %v_38: Ptr
    %v_41 = call_complex %funvalue(twice), %v_40, 21: I32
    call_complex teardown(fun), %v_37
    %v_42 = alloca 24, 8: Ptr
    %v_43 = alloca 24, 8: Ptr
    store %v_43, 0, 1
    call_complex teardown(Maybe((I32) -> I32)), %v_43
    store %v_42, 1, 1
    call_complex teardown(Outcome((I32) -> I32, {})), %v_42
    %v_44 = add 765, %v_41: I32
    %v_45 = loads @dropped, 4: I32
    %v_46 = imul %v_45, 1000: I32
    %v_47 = add %v_44, %v_46: I32
    %v_48 = loads @log, 4: I32
    %v_49 = imul %v_48, 100000: I32
    %v_50 = add %v_47, %v_49: I32
    ret %v_50
  }
}

teardown(Maybe(Node))<complex>(%v_0: Ptr) {
  b_1 {
    %v_2 = load %v_0, 1: I32
    %v_3 = cmp_eq %v_2, 1: I32
    je %v_3, b_4, b_5
  }

  b_6 {
    ret 
  }

  b_4 {
    call_complex Node.drop
    jmp b_6
  }

  b_5 {
    jmp b_6
  }
}

teardown(Outcome(Node, {}))<complex>(%v_0: Ptr) {
  b_1 {
    %v_2 = load %v_0, 1: I32
    %v_3 = cmp_eq %v_2, 0: I32
    je %v_3, b_4, b_5
  }

  b_6 {
    ret 
  }

  b_4 {
    call_complex Node.drop
    jmp b_6
  }

  b_5 {
    jmp b_6
  }
}

teardown(Outcome(Node, I32))<complex>(%v_0: Ptr) {
  b_1 {
    %v_2 = load %v_0, 1: I32
    %v_3 = cmp_eq %v_2, 0: I32
    je %v_3, b_4, b_5
  }

  b_6 {
    ret 
