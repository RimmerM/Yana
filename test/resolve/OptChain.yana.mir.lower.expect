    %v_1 = loads @dropped, 4: I32
    %v_2 = add %v_1, 1: I32
    store @dropped, %v_2, 4
    ret 
  }
}

twice<complex>(%x: I32): I32 {
  b_0 {
    %v_1 = shl %x, 1: I32
    ret %v_1
  }
}

