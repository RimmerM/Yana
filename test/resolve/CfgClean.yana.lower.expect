@image$base = []
mut @live = [0, 0, 0, 0]
mut @trace = [0, 0, 0, 0]

take<complex>(%h: Ptr): I32 {
  b_0 {
    %v_1 = loads %h, 4: I32
    %v_2 = loads @live, 4: I32
    %v_3 = sub %v_2, 1: I32
    store @live, %v_3, 4
    %v_4 = loads @trace, 4: I32
    %v_5 = imul %v_4, 10: I32
    %v_6 = add %v_5, %v_1: I32
    store @trace, %v_6, 4
    ret %v_1
  }
}

nested<complex>(%n: I32): I32 {
  b_0 {
    %v_1 = loads @live, 4: I32
    %v_2 = add %v_1, 1: I32
    store @live, %v_2, 4
    %h = alloca 4, 4: Ptr
    store %h, %n, 4
    jmp b_3
  }

  b_3 {
    %v_4 = phi [b_0, 0], [b_5, %v_6]: I32
    %v_7 = phi [b_0, 0], [b_5, %v_8]: I32
    %v_9 = cmp_ilt %v_7, %n: I32
    je %v_9, b_10, b_11
  }

  b_11 {
    call_complex Drop(Held).drop, %h
    jmp b_12
  }

  b_10 {
    %v_13 = cmp_igt %v_7, 2: I32
    je %v_13, b_14, b_15
  }

  b_15 {
    %v_16 = imul %v_4, 10: I32
    %v_6 = add %v_16, %v_7: I32
    %v_17 = imm 24: I32
    %v_18 = shl 0, %v_17: I32
    %v_19 = sar %v_18, %v_17: I32
    %v_20 = cmp_eq %v_19, 1: I32
    je %v_20, b_21, b_5
  }

  b_5 {
    %v_8 = add %v_7, 1: I32
    jmp b_3
  }

  b_21 {
    call_complex Drop(Held).drop, %h
    jmp b_22
  }

  b_14 {
    %v_23 = call_complex take, %h: I32
    %v_24 = cmp_igt %v_23, 4: I32
    je %v_24, b_25, b_26
  }

  b_26 {
    %v_27 = imul %v_4, 10: I32
    %v_28 = add %v_27, %v_23: I32
    jmp b_29
  }

  b_25 {
    jmp b_29
  }

  b_29 {
    %v_30 = phi [b_26, %v_28], [b_25, %v_4]: I32
    %v_31 = phi [b_26, 0], [b_25, 1]: I32
    %v_32 = imm 24: I32
    %v_33 = shl %v_31, %v_32: I32
    %v_34 = sar %v_33, %v_32: I32
    %v_35 = cmp_eq %v_34, 1: I32
    je %v_35, b_36, b_37
  }

  b_37 {
    jmp b_12
  }

  b_12 {
    %v_38 = phi [b_11, %v_4], [b_37, %v_30]: I32
    jmp b_22
  }

  b_36 {
    jmp b_22
  }

  b_22 {
    %v_39 = phi [b_21, %v_6], [b_12, %v_38], [b_36, %v_30]: I32
    ret %v_39
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = call_complex nested, 0: I32
    %v_2 = imul %v_1, 3: I32
    %v_3 = add %v_2, 35: I32
    %v_4 = call_complex nested, 3: I32
    %v_5 = imul %v_4, 5: I32
    %v_6 = add %v_3, %v_5: I32
    %v_7 = call_complex nested, 6: I32
    %v_8 = imul %v_7, 7: I32
    %v_9 = add %v_6, %v_8: I32
    %v_10 = add %v_9, 769: I32
    %v_11 = imul %v_10, 1000: I32
    %v_12 = loads @trace, 4: I32
    %v_13 = imul %v_12, 10: I32
    %v_14 = add %v_11, %v_13: I32
    %v_15 = loads @live, 4: I32
    %v_16 = add %v_14, %v_15: I32
    ret %v_16
  }
}

Drop(Held).drop<complex>(%self: Ptr) {
  b_0 {
    %v_1 = loads @live, 4: I32
    %v_2 = sub %v_1, 1: I32
    store @live, %v_2, 4
    %v_3 = loads @trace, 4: I32
    %v_4 = imul %v_3, 10: I32
    %v_5 = loads %self, 4: I32
    %v_6 = add %v_4, %v_5: I32
    store @trace, %v_6, 4
    ret 
  }
}

