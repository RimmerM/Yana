data State = Idle | Locked | Contended

fn basics() -> I32 {
  local c: Atomic(I32)
  local seen: I32
  local previous: I32

bb0:
  %0: I32 = const 0
  %1: Atomic(I32) = atomic.new relaxed inspect %0
  write.init borrow.unique (c) take %1
  %3: Atomic(I32) [shared call] = read borrow.shared (c) loan0
  %4: I32 = const 7
  %5: StoreOrder = const StoreRelease
  %6: {} = atomic.store release inspect %3 inspect %4
  %7: Atomic(I32) [shared call] = read borrow.shared (c) loan1
  %8: LoadOrder = const LoadAcquire
  %9: I32 = atomic.load acquire inspect %7
  write.init borrow.unique (seen) take %9
  %11: Atomic(I32) [shared call] = read borrow.shared (c) loan2
  %12: I32 = const 9
  %13: UpdateOrder = const UpdateAcquireRelease
  %14: I32 = atomic.xchg acqrel inspect %11 inspect %12
  write.init borrow.unique (previous) take %14
  %16: I32 = read copy.trivial (seen)
  %17: I32 = read copy.trivial (previous)
  %18: I32 = add inspect %16 inspect %17
  %19: Atomic(I32) = read take (c)
  %20: I32 = atomic.into relaxed take %19
  %21: I32 = add inspect %18 inspect %20
  return take %21
}

