11:                                               ; preds = %7
  ret i32 -2

12:                                               ; preds = %7
  br label %13

13:                                               ; preds = %12
  %14 = xor <4 x i1> %below, %equal
  %15 = call i1 @llvm.vector.reduce.and.v4i1(<4 x i1> %14)
  %16 = zext i1 %15 to i32
  br i1 %15, label %18, label %17

17:                                               ; preds = %13
  ret i32 -3

18:                                               ; preds = %13
  br label %19

19:                                               ; preds = %18
  %20 = xor <4 x i1> %equal, <i1 true, i1 true, i1 true, i1 true>
  %21 = call i1 @llvm.vector.reduce.and.v4i1(<4 x i1> %20)
  %22 = zext i1 %21 to i32
  br i1 %21, label %24, label %23

23:                                               ; preds = %19
