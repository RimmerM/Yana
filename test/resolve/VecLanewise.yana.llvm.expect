14:                                               ; preds = %10
  %15 = call fastcc i32 @selection(<4 x i32> %a, <4 x i32> %b)
  %16 = mul i32 %15, 10
  ret i32 %16

17:                                               ; preds = %10
  br label %18

18:                                               ; preds = %17
  %19 = call fastcc i32 @combining(<4 x i32> %a, <4 x i32> %b)
  %20 = icmp ne i32 %19, 0
  %21 = zext i1 %20 to i32
  br i1 %20, label %22, label %25

22:                                               ; preds = %18
  %23 = call fastcc i32 @combining(<4 x i32> %a, <4 x i32> %b)
  %24 = mul i32 %23, 100
  ret i32 %24

25:                                               ; preds = %18
  br label %26

26:                                               ; preds = %25
  %27 = call fastcc i32 @counting()
  %28 = icmp ne i32 %27, 0
  %29 = zext i1 %28 to i32
  br i1 %28, label %30, label %33

30:                                               ; preds = %26
  %31 = call fastcc i32 @counting()
  %32 = mul i32 %31, 1000
  ret i32 %32

33:                                               ; preds = %26
  br label %34

34:                                               ; preds = %33
  %35 = call fastcc i32 @floats()
  %36 = icmp ne i32 %35, 0
