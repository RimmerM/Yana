target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

module asm "\09.set \22image$base\22, 0"

@"image$base" = external constant [0 x i8], align 8
@seed = global [4 x i8] c"\03\00\00\00", align 8

define fastcc i32 @comparisons(<4 x i32> %a, <4 x i32> %b) #0 {
  br label %1

1:                                                ; preds = %0
  %2 = icmp slt <4 x i32> %a, %b
  %3 = call i1 @llvm.vector.reduce.and.v4i1(<4 x i1> %2)
  %4 = zext i1 %3 to i32
  br i1 %3, label %6, label %5

5:                                                ; preds = %1
  ret i32 -1

6:                                                ; preds = %1
  %7 = icmp sle <4 x i32> %a, %b
  %8 = call i1 @llvm.vector.reduce.and.v4i1(<4 x i1> %7)
  %9 = zext i1 %8 to i32
  br i1 %8, label %11, label %10

10:                                               ; preds = %6
  ret i32 -2

11:                                               ; preds = %6
  %12 = icmp sgt <4 x i32> %b, %a
  %13 = call i1 @llvm.vector.reduce.and.v4i1(<4 x i1> %12)
  %14 = zext i1 %13 to i32
  br i1 %13, label %16, label %15

15:                                               ; preds = %11
  ret i32 -3

16:                                               ; preds = %11
  %17 = icmp sge <4 x i32> %b, %a
  %18 = call i1 @llvm.vector.reduce.and.v4i1(<4 x i1> %17)
  %19 = zext i1 %18 to i32
  br i1 %18, label %21, label %20

20:                                               ; preds = %16
  ret i32 -4

21:                                               ; preds = %16
  %22 = icmp ne <4 x i32> %a, %b
  %23 = call i1 @llvm.vector.reduce.and.v4i1(<4 x i1> %22)
  %24 = zext i1 %23 to i32
  br i1 %23, label %26, label %25

25:                                               ; preds = %21
  ret i32 -5

26:                                               ; preds = %21
  %27 = icmp eq <4 x i32> %a, %b
  %28 = call i1 @llvm.vector.reduce.or.v4i1(<4 x i1> %27)
  %29 = zext i1 %28 to i32
  br i1 %28, label %30, label %31

30:                                               ; preds = %26
  ret i32 -6

31:                                               ; preds = %26
  %32 = icmp sgt <4 x i32> %a, %b
  %33 = call i1 @llvm.vector.reduce.or.v4i1(<4 x i1> %32)
  %34 = zext i1 %33 to i32
  br i1 %33, label %35, label %36

35:                                               ; preds = %31
  ret i32 -7

36:                                               ; preds = %31
  ret i32 0
}

define fastcc i32 @selection(<4 x i32> %a, <4 x i32> %b) #0 {
  br label %1

1:                                                ; preds = %0
  %2 = icmp slt <4 x i32> %a, %b
  %smaller = select <4 x i1> %2, <4 x i32> %a, <4 x i32> %b
  %larger = select <4 x i1> %2, <4 x i32> %b, <4 x i32> %a
  %3 = extractelement <4 x i32> %smaller, i32 0
  %4 = icmp ne i32 %3, 3
  %5 = zext i1 %4 to i32
  br i1 %4, label %6, label %7

6:                                                ; preds = %1
  ret i32 -1

7:                                                ; preds = %1
  %8 = extractelement <4 x i32> %larger, i32 1
  %9 = icmp ne i32 %8, 4
  %10 = zext i1 %9 to i32
  br i1 %9, label %11, label %12

11:                                               ; preds = %7
  ret i32 -2

12:                                               ; preds = %7
  ret i32 0
}

define fastcc i32 @combining(<4 x i32> %a, <4 x i32> %b) #0 {
  br label %1

1:                                                ; preds = %0
  %below = icmp slt <4 x i32> %a, %b
  %equal = icmp eq <4 x i32> %a, %b
  %2 = or <4 x i1> %below, %equal
  %3 = call i1 @llvm.vector.reduce.and.v4i1(<4 x i1> %2)
  %4 = zext i1 %3 to i32
  br i1 %3, label %6, label %5

5:                                                ; preds = %1
  ret i32 -1

6:                                                ; preds = %1
  %7 = and <4 x i1> %below, %equal
  %8 = call i1 @llvm.vector.reduce.or.v4i1(<4 x i1> %7)
  %9 = zext i1 %8 to i32
  br i1 %8, label %10, label %11

10:                                               ; preds = %6
  ret i32 -2

11:                                               ; preds = %6
  %12 = xor <4 x i1> %below, %equal
  %13 = call i1 @llvm.vector.reduce.and.v4i1(<4 x i1> %12)
  %14 = zext i1 %13 to i32
  br i1 %13, label %16, label %15

15:                                               ; preds = %11
  ret i32 -3

16:                                               ; preds = %11
  %17 = xor <4 x i1> %equal, splat (i1 true)
  %18 = call i1 @llvm.vector.reduce.and.v4i1(<4 x i1> %17)
  %19 = zext i1 %18 to i32
  br i1 %18, label %21, label %20

20:                                               ; preds = %16
  ret i32 -4

21:                                               ; preds = %16
  ret i32 0
}

define fastcc i32 @counting() #0 {
  br label %1

1:                                                ; preds = %0
  %2 = call i32 @llvm.vector.reduce.add.v4i32(<4 x i32> <i32 0, i32 1, i32 1, i32 1>)
  %3 = icmp ne i32 %2, 3
  %4 = zext i1 %3 to i32
  br i1 %3, label %5, label %6

5:                                                ; preds = %1
  ret i32 -1

6:                                                ; preds = %1
  %7 = zext i4 bitcast (<4 x i1> <i1 false, i1 true, i1 true, i1 true> to i4) to i32
  %8 = or i32 %7, 16
  %9 = call i32 @llvm.cttz.i32(i32 %8, i1 true)
  %10 = icmp ne i32 %9, 1
  %11 = zext i1 %10 to i32
  br i1 %10, label %12, label %13

12:                                               ; preds = %6
  ret i32 -2

13:                                               ; preds = %6
  %14 = call i32 @llvm.cttz.i32(i32 16, i1 true)
  %15 = icmp ne i32 %14, 4
  %16 = zext i1 %15 to i32
  br i1 %15, label %17, label %18

17:                                               ; preds = %13
  ret i32 -3

18:                                               ; preds = %13
  %19 = call i32 @llvm.vector.reduce.add.v4i32(<4 x i32> zeroinitializer)
  %20 = icmp ne i32 %19, 0
  %21 = zext i1 %20 to i32
  br i1 %20, label %22, label %23

22:                                               ; preds = %18
  ret i32 -4

23:                                               ; preds = %18
  %24 = call i32 @llvm.cttz.i32(i32 31, i1 true)
  %25 = icmp ne i32 %24, 0
  %26 = zext i1 %25 to i32
  br i1 %25, label %27, label %28

27:                                               ; preds = %23
  ret i32 -5

28:                                               ; preds = %23
  %29 = call i32 @llvm.vector.reduce.add.v4i32(<4 x i32> splat (i32 1))
  %30 = icmp ne i32 %29, 4
  %31 = zext i1 %30 to i32
  br i1 %30, label %32, label %33

32:                                               ; preds = %28
  ret i32 -6

33:                                               ; preds = %28
  ret i32 0
}

define fastcc i32 @floats() #0 {
  br label %1

1:                                                ; preds = %0
  %2 = call i1 @llvm.vector.reduce.and.v4i1(<4 x i1> splat (i1 true))
  %3 = zext i1 %2 to i32
  br i1 %2, label %5, label %4

4:                                                ; preds = %1
  ret i32 -1

5:                                                ; preds = %1
  br i1 false, label %6, label %7

6:                                                ; preds = %5
  ret i32 -2

7:                                                ; preds = %5
  ret i32 0
}

define fastcc i32 @main() #0 {
  br label %1

1:                                                ; preds = %0
  %2 = load i32, ptr @seed, align 1
  %.splatinsert = insertelement <4 x i32> poison, i32 %2, i64 0
  %a = shufflevector <4 x i32> %.splatinsert, <4 x i32> poison, <4 x i32> zeroinitializer
  %3 = add i32 %2, 1
  %.splatinsert1 = insertelement <4 x i32> poison, i32 %3, i64 0
  %b = shufflevector <4 x i32> %.splatinsert1, <4 x i32> poison, <4 x i32> zeroinitializer
  %4 = call fastcc i32 @comparisons(<4 x i32> %a, <4 x i32> %b)
  %5 = icmp ne i32 %4, 0
  %6 = zext i1 %5 to i32
  br i1 %5, label %7, label %9

7:                                                ; preds = %1
  %8 = call fastcc i32 @comparisons(<4 x i32> %a, <4 x i32> %b)
  ret i32 %8

9:                                                ; preds = %1
  %10 = call fastcc i32 @selection(<4 x i32> %a, <4 x i32> %b)
  %11 = icmp ne i32 %10, 0
  %12 = zext i1 %11 to i32
  br i1 %11, label %13, label %16

13:                                               ; preds = %9
  %14 = call fastcc i32 @selection(<4 x i32> %a, <4 x i32> %b)
  %15 = mul i32 %14, 10
  ret i32 %15

16:                                               ; preds = %9
  %17 = call fastcc i32 @combining(<4 x i32> %a, <4 x i32> %b)
  %18 = icmp ne i32 %17, 0
  %19 = zext i1 %18 to i32
  br i1 %18, label %20, label %23

20:                                               ; preds = %16
  %21 = call fastcc i32 @combining(<4 x i32> %a, <4 x i32> %b)
  %22 = mul i32 %21, 100
  ret i32 %22

23:                                               ; preds = %16
  %24 = call fastcc i32 @counting()
  %25 = icmp ne i32 %24, 0
  %26 = zext i1 %25 to i32
  br i1 %25, label %27, label %30

27:                                               ; preds = %23
  %28 = call fastcc i32 @counting()
  %29 = mul i32 %28, 1000
  ret i32 %29

30:                                               ; preds = %23
  %31 = call fastcc i32 @floats()
  %32 = icmp ne i32 %31, 0
  %33 = zext i1 %32 to i32
  br i1 %32, label %34, label %37

34:                                               ; preds = %30
  %35 = call fastcc i32 @floats()
  %36 = mul i32 %35, 10000
  ret i32 %36

37:                                               ; preds = %30
  ret i32 4839
}

