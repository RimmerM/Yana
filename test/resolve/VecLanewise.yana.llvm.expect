define fastcc i32 @selection(<4 x i32> %a, <4 x i32> %b) {
  br label %1

1:                                                ; preds = %0
  %2 = icmp slt <4 x i32> %a, %b
  %smaller = select <4 x i1> %2, <4 x i32> %a, <4 x i32> %b
  %larger = select <4 x i1> %2, <4 x i32> %b, <4 x i32> %a
  %3 = extractelement <4 x i32> %smaller, i32 0
  %4 = icmp ne i32 %3, 3
  %5 = zext i1 %4 to i32
  br i1 %4, label %6, label %7

6:                                                ; preds = %1
  ret i32 -1

7:                                                ; preds = %1
  br label %8

8:                                                ; preds = %7
  %9 = extractelement <4 x i32> %larger, i32 1
  %10 = icmp ne i32 %9, 4
  %11 = zext i1 %10 to i32
  br i1 %10, label %12, label %13

12:                                               ; preds = %8
  ret i32 -2

13:                                               ; preds = %8
  br label %14

14:                                               ; preds = %13
  ret i32 0
}

define fastcc i32 @combining(<4 x i32> %a, <4 x i32> %b) {
  br label %1

1:                                                ; preds = %0
  %below = icmp slt <4 x i32> %a, %b
  %equal = icmp eq <4 x i32> %a, %b
  %2 = or <4 x i1> %below, %equal
