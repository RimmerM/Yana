module ResolveTest

fn sumOfSplat(x: a [shared call]) -> a {
  form specialized
  slot #0 type a
  slot #1 class Num(a)
  slot #2 class Num(Vec(a))
bb0:
  %0: a [shared call] = read borrow.shared (x) loan0
  %1: Vec(a) = vec.splat inspect %0
  %2: a = vec.reduce add inspect %1
  return take %2
}

fn laneCount(x: a [shared call]) -> I32 {
  form specialized
  slot #0 type a
  slot #1 class Num(a)
  slot #2 class Num(Vec(a))
bb0:
  %0: a [shared call] = read borrow.shared (x) loan0
  %1: Vec(a) = vec.splat inspect %0
  %2: I32 = gen.value lanes(a)
  return take %2
}

fn doubled(x: a [shared call]) -> Vec(a) {
  form specialized
  slot #0 type a
  slot #1 class Num(a)
  slot #2 class Num(Vec(a))
bb0:
  %0: a [shared call] = read borrow.shared (x) loan0
  %1: Vec(a) = vec.splat inspect %0
  %2: a [shared call] = read borrow.shared (x) loan1
  %3: Vec(a) = vec.splat inspect %2
  %4: Vec(a) = call +(Vec(a)) borrow.shared %1 borrow.shared %3
  return take %4
}

fn twiceSummed(x: a [shared call]) -> a {
  form specialized
  slot #0 type a
  slot #1 class Num(a)
  slot #2 class Num(Vec(a))
bb0:
  %0: a [shared call] = read borrow.shared (x) loan0
  %1: Vec(a) = call doubled(a) borrow.shared %0
  %2: a = vec.reduce add inspect %1
  return take %2
}

fn main() -> I32 {
  local wide: I32
  local narrow: I32

bb0:
  %0: I32 = const 1
  %1: I32 = call laneCount(I32) borrow.shared %0
  write.init borrow.unique (wide) take %1
  %3: I16 = const 1
  %4: I32 = call laneCount(I16) borrow.shared %3
  write.init borrow.unique (narrow) take %4
  %6: I32 = read copy.trivial (narrow)
  %7: I32 = read copy.trivial (wide)
  %8: I32 = const 2
  %9: I32 = mul inspect %7 inspect %8
  %10: Bool = ne inspect %6 inspect %9
  branch inspect %10 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %15: I32 = const 3
  %16: I32 = call sumOfSplat(I32) borrow.shared %15
  %17: I32 = read copy.trivial (wide)
  %18: I32 = const 3
  %19: I32 = mul inspect %17 inspect %18
  %20: Bool = ne inspect %16 inspect %19
  branch inspect %20 -> bb6 -> bb4

bb3:
  %12: I32 = const 1
  return take %12

bb4:
  jump -> bb5

bb5:
  %25: I32 = const 3
  %26: I32 = call twiceSummed(I32) borrow.shared %25
  %27: I32 = read copy.trivial (wide)
  %28: I32 = const 6
  %29: I32 = mul inspect %27 inspect %28
  %30: Bool = ne inspect %26 inspect %29
  branch inspect %30 -> bb9 -> bb7

bb6:
  %22: I32 = const 2
  return take %22

bb7:
  jump -> bb8

bb8:
  %35: I32 = const 1
  %36: Vec(I32) = vec.splat inspect %35
  %37: I32 = const 4
  %38: I32 = read copy.trivial (wide)
  %39: Bool = ne inspect %37 inspect %38
  branch inspect %39 -> bb12 -> bb10

bb9:
  %32: I32 = const 3
  return take %32

bb10:
  jump -> bb11

bb11:
  %44: I32 = const 100
  %45: I32 = read copy.trivial (narrow)
  %46: I32 = read copy.trivial (wide)
  %47: I32 = div inspect %45 inspect %46
  %48: I32 = add inspect %44 inspect %47
  return take %48

bb12:
  %41: I32 = const 4
  return take %41
}

fn laneCount(I32)(x: I32 [shared call]) -> I32 = <laneCount at I32>

fn laneCount(I16)(x: I16 [shared call]) -> I32 = <laneCount at I16>

fn sumOfSplat(I32)(x: I32 [shared call]) -> I32 = <sumOfSplat at I32>

fn twiceSummed(I32)(x: I32 [shared call]) -> I32 = <twiceSummed at I32>

fn doubled(I32)(x: I32 [shared call]) -> Vec(I32) = <doubled at I32>

entry main
