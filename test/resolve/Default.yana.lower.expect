@image$base = []

main<complex>(): Int {
  b_0 {
    %rw = alloca 1, 1: Ptr
    store %rw, 3, 1
    %r = alloca 1, 1: Ptr
    store %r, 1, 1
    %v_1 = alloca 1, 1: Ptr
    store %v_1, 2, 1
    %v_2 = alloca 1, 1: Ptr
    store %v_2, 1, 1
    %v_3 = call_complex Eq(Flags).==, %v_2, %r: Int
    je %v_3, b_4, b_5
  }

  b_4 {
    jmp b_5
  }

  b_5 {
    %v_6 = phi [b_0, 0], [b_4, 256]: Int
    %v_7 = alloca 1, 1: Ptr
    store %v_7, 3, 1
    %v_8 = call_complex Eq(Flags).==, %v_7, %rw: Int
    je %v_8, b_9, b_10
  }

  b_9 {
    %v_11 = add %v_6, 512: Int
    jmp b_10
  }

  b_10 {
    %v_12 = phi [b_5, %v_6], [b_9, %v_11]: Int
    %v_13 = alloca 1, 1: Ptr
    store %v_13, 2, 1
    %v_14 = call_complex Eq(Flags).==, %v_1, %v_13: Int
    je %v_14, b_15, b_16
  }

  b_15 {
    %v_17 = add %v_12, 1024: Int
    jmp b_16
  }

  b_16 {
    %v_18 = phi [b_10, %v_12], [b_15, %v_17]: Int
    %v_19 = add %v_18, 6399: Int
    ret %v_19
  }
}

Eq(Flags).==<complex>(%lhs: Ptr, %rhs: Ptr): Int {
  b_0 {
    %v_1 = load %lhs, 1: Int
    %v_2 = and %v_1, 1: Int
    %v_3 = load %rhs, 1: Int
    %v_4 = and %v_3, 1: Int
    %v_5 = cmp_eq %v_2, %v_4: Int
    je %v_5, b_6, b_7
  }

  b_6 {
    %v_8 = shr %v_1, 1: Int
    %v_9 = and %v_8, 1: Int
    %v_10 = shr %v_3, 1: Int
    %v_11 = and %v_10, 1: Int
    %v_12 = cmp_eq %v_9, %v_11: Int
    jmp b_13
  }

  b_7 {
    jmp b_13
  }

  b_13 {
    %v_14 = phi [b_6, %v_12], [b_7, 0]: Int
    ret %v_14
  }
}

