@image$base = []

main<complex>(): Int {
  b_0 {
    %rw = alloca 1, 1: Ptr
    store %rw, 3, 1
    %r = alloca 1, 1: Ptr
    store %r, 1, 1
    %v_1 = alloca 1, 1: Ptr
    store %v_1, 2, 1
    %v_2 = alloca 1, 1: Ptr
    store %v_2, 0, 1
    copy %v_2, %r, 1
    %v_3 = alloca 1, 1: Ptr
    store %v_3, 0, 1
    %v_4 = load %v_2, 1: Int
    %v_5 = and %v_4, 1: Int
    %v_6 = cast %v_5: Int
    %v_7 = shr %v_4, 1: Int
    %v_8 = and %v_7, 1: Int
    %v_9 = cast %v_8: Int
    %v_10 = cast %v_6: Int
    %v_11 = cast %v_9: Int
    %v_12 = shl %v_11, 1: Int
    %v_13 = or %v_10, %v_12: Int
    store %v_3, %v_13, 1
    %v_14 = call_complex Eq(Flags).==, %v_3, %r: Int
    je %v_14, b_15, b_16
  }

  b_15 {
    jmp b_16
  }

  b_16 {
    %v_17 = phi [b_0, 0], [b_15, 256]: Int
    %v_18 = alloca 1, 1: Ptr
    store %v_18, 0, 1
    copy %v_18, %rw, 1
    %v_19 = alloca 1, 1: Ptr
    store %v_19, 0, 1
    %v_20 = load %v_18, 1: Int
    %v_21 = shr %v_20, 1: Int
    %v_22 = and %v_21, 1: Int
    %v_23 = cast %v_22: Int
    %v_24 = cast %v_23: Int
    %v_25 = shl %v_24, 1: Int
    %v_26 = or %v_25, 1: Int
    store %v_19, %v_26, 1
    %v_27 = call_complex Eq(Flags).==, %v_19, %rw: Int
    je %v_27, b_28, b_29
  }

  b_28 {
    %v_30 = add %v_17, 512: Int
    jmp b_29
  }

  b_29 {
    %v_31 = phi [b_16, %v_17], [b_28, %v_30]: Int
    %v_32 = alloca 1, 1: Ptr
    store %v_32, 2, 1
    %v_33 = call_complex Eq(Flags).==, %v_1, %v_32: Int
    je %v_33, b_34, b_35
  }

  b_34 {
    %v_36 = add %v_31, 1024: Int
    jmp b_35
  }

  b_35 {
    %v_37 = phi [b_29, %v_31], [b_34, %v_36]: Int
    %v_38 = add %v_37, 6399: Int
    ret %v_38
  }
}

Eq(Flags).==<complex>(%lhs: Ptr, %rhs: Ptr): Int {
  b_0 {
    %v_1 = load %lhs, 1: Int
    %v_2 = and %v_1, 1: Int
    %v_3 = cast %v_2: Int
    %v_4 = load %rhs, 1: Int
    %v_5 = and %v_4, 1: Int
    %v_6 = cast %v_5: Int
    %v_7 = cmp_eq %v_3, %v_6: Int
    je %v_7, b_8, b_9
  }

  b_8 {
    %v_10 = shr %v_1, 1: Int
    %v_11 = and %v_10, 1: Int
    %v_12 = cast %v_11: Int
    %v_13 = shr %v_4, 1: Int
    %v_14 = and %v_13, 1: Int
    %v_15 = cast %v_14: Int
    %v_16 = cmp_eq %v_12, %v_15: Int
    jmp b_17
  }

  b_9 {
    jmp b_17
  }

  b_17 {
    %v_18 = phi [b_8, %v_16], [b_9, %v_7]: Int
    ret %v_18
  }
}

