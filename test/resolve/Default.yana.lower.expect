@image$base = []

main<complex>(): Int {
  b_0 {
    %rw = alloca 1, 1: Ptr
    store %rw, 3, 1
    %r = alloca 1, 1: Ptr
    store %r, 1, 1
    %v_1 = alloca 1, 1: Ptr
    store %v_1, 2, 1
    %v_2 = alloca 1, 1: Ptr
    store %v_2, 1, 1
    %v_3 = call_complex Eq(Flags).==, %v_2, %r: Int
    je %v_3, b_4, b_5
  }

  b_4 {
    jmp b_5
  }

  b_5 {
    %v_6 = phi [b_0, 0], [b_4, 256]: Int
    %v_7 = alloca 1, 1: Ptr
    store %v_7, 3, 1
    %v_8 = call_complex Eq(Flags).==, %v_7, %rw: Int
    je %v_8, b_9, b_10
  }

  b_9 {
    %v_11 = add %v_6, 512: Int
    jmp b_10
  }

  b_10 {
    %v_12 = phi [b_5, %v_6], [b_9, %v_11]: Int
    %v_13 = alloca 1, 1: Ptr
    store %v_13, 2, 1
    %v_14 = call_complex Eq(Flags).==, %v_1, %v_13: Int
    je %v_14, b_15, b_16
  }

  b_15 {
    %v_17 = add %v_12, 1024: Int
    jmp b_16
  }

  b_16 {
    %v_18 = phi [b_10, %v_12], [b_15, %v_17]: Int
    %v_19 = add %v_18, 6399: Int
    ret %v_19
  }
}

Eq(Flags).==<complex>(%lhs: Ptr, %rhs: Ptr): Int {
  b_0 {
    %v_1 = load %lhs, 1: Int
    %v_2 = and %v_1, 1: Int
    %v_3 = cast %v_2: Int
    %v_4 = load %rhs, 1: Int
    %v_5 = and %v_4, 1: Int
    %v_6 = cast %v_5: Int
    %v_7 = cmp_eq %v_3, %v_6: Int
    je %v_7, b_8, b_9
  }

  b_8 {
    %v_10 = shr %v_1, 1: Int
    %v_11 = and %v_10, 1: Int
    %v_12 = cast %v_11: Int
    %v_13 = shr %v_4, 1: Int
    %v_14 = and %v_13, 1: Int
    %v_15 = cast %v_14: Int
    %v_16 = cmp_eq %v_12, %v_15: Int
    jmp b_17
  }

  b_9 {
    jmp b_17
  }

  b_17 {
    %v_18 = phi [b_8, %v_16], [b_9, 0]: Int
    ret %v_18
  }
}

