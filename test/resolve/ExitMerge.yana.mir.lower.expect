mut @heapFree = [0, 0, 0, 0, 0, 0, 0, 0]

parity<complex>(%n: I32, %salt: I32): I32 {
  b_0 {
    %v_1 = and %n, 1: I32
    je %v_1, b_2, b_3
  }

  b_2 {
    %v_4 = cmp_igt %salt, 90: I32
    %v_5 = select %v_4, 5, 9: I32
    ret %v_5
  }

  b_3 {
    ret 7
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = imm 3: I32
    jmp b_2
  }

  b_3 {
    ret %v_4
  }

  b_2 {
    %v_5 = phi [b_6, %v_4], [b_0, 0]: I32
    %v_7 = phi [b_6, %v_8], [b_0, 0]: I32
    %v_9 = alloca 4, 8: Ptr
    %v_10 = alloca 12, 4: Ptr
    %v_11 = bitcast %v_10: I64
    store %v_9, 3, 4
    store %v_10, 10, 4
    %v_12 = add %v_10, 4: Ptr
    store %v_12, 20, 4
    %v_13 = add %v_10, 8: Ptr
    store %v_13, 30, 4
    %v_14 = cmp_eq %v_7, 0: I32
    je %v_14, b_15, b_16
  }

  b_6 {
    %v_17 = phi [b_18, %v_19], [b_20, 18446744073709551613], [b_21, 18446744073709551614], [b_15, 18446744073709551615]: I32
    %v_22 = add %v_5, %v_17: I32
    %v_23 = call_complex parity, %v_7, %v_7: I32
    %v_4 = add %v_22, %v_23: I32
    %v_8 = add %v_7, 1: I32
    %v_24 = cmp_ilt %v_8, 5: I32
    je %v_24, b_2, b_3
  }

  b_16 {
    %v_25 = cmp_eq %v_7, 1: I32
    je %v_25, b_21, b_26
  }

  b_26 {
    %v_27 = cmp_eq %v_7, 2: I32
    je %v_27, b_20, b_18
  }

  b_18 {
    %v_28 = loads %v_10, 4: I32
    %v_19 = add %v_28, %v_7: I32
    jmp b_6
  }

  b_20 {
    jmp b_6
  }

  b_21 {
    %v_29 = load %v_9, 4: I32
    call_complex Array(a).reclaim(I32), %v_11, %v_29, %v_1
    jmp b_6
  }

  b_15 {
    %v_30 = load %v_9, 4: I32
    call_complex Array(a).reclaim(I32), %v_11, %v_30, %v_1
    jmp b_6
  }
}

Array(a).reclaim(I32)<complex>(%v_0: I64, %v_1: I32, %v_2: I32) {
  b_3 {
    %v_4 = shr %v_1, 30: I32
    %v_5 = cmp_eq %v_4, 1: I32
    je %v_5, b_6, b_7
  }

  b_6 {
    %v_8 = bitcast %v_0: Ptr
    %v_9 = cmp_eq %v_0, 0: I32
    je %v_9, b_7, b_10
  }

  b_7 {
    ret 
  }

  b_10 {
    %v_11 = sub %v_8, 8: Ptr
    %v_12 = loads %v_11, 8: I64
    %v_13 = load @heapFree, 8: Ptr
    %v_14 = shl %v_12, 3: I64
    %v_15 = add %v_13, %v_14: Ptr
    %v_16 = load %v_15, 8: Ptr
    store %v_8, %v_16, 8
    store %v_15, %v_8, 8
