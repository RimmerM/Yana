
parity<complex>(%n: I32, %salt: I32): I32 {
  b_0 {
    %v_1 = and %n, 1: I32
    je %v_1, b_2, b_3
  }

  b_2 {
    %v_4 = cmp_igt %salt, 90: I32
    %v_5 = select %v_4, 5, 9: I32
    ret %v_5
  }

  b_3 {
    ret 7
  }
}

main<complex>(): I32 {
  b_0 {
    jmp b_1
  }

  b_2 {
    ret %v_3
  }

  b_1 {
    %v_4 = phi [b_5, %v_3], [b_0, 0]: I32
    %v_6 = phi [b_5, %v_7], [b_0, 0]: I32
    %v_8 = cmp_eq %v_6, 0: I32
    je %v_8, b_9, b_10
  }

  b_5 {
    %v_11 = phi [b_12, %v_13], [b_14, 18446744073709551613], [b_15, 18446744073709551614], [b_9, 18446744073709551615]: I32
    %v_16 = add %v_4, %v_11: I32
    %v_17 = call_complex parity, %v_6, %v_6: I32
    %v_3 = add %v_16, %v_17: I32
    %v_7 = add %v_6, 1: I32
    %v_18 = cmp_ilt %v_7, 5: I32
    je %v_18, b_1, b_2
  }

  b_10 {
    %v_19 = cmp_eq %v_6, 1: I32
    je %v_19, b_15, b_20
  }

  b_20 {
    %v_21 = cmp_eq %v_6, 2: I32
    je %v_21, b_14, b_12
  }

  b_12 {
    %v_13 = add 10, %v_6: I32
    jmp b_5
  }

  b_14 {
    jmp b_5
  }

  b_15 {
    jmp b_5
  }

  b_9 {
    jmp b_5
  }
}

