  b_14 {
    %v = vsplat 5: i32x4
    %a = vwithlane %v, 9, 1: i32x4
    %b = vwithlane %a, 7, 0: i32x4
    %v_15 = vlane %b, 0: I32
    %v_16 = imul %v_15, 1000: I32
    %v_17 = vlane %b, 1: I32
    %v_18 = imul %v_17, 100: I32
    %v_19 = add %v_16, %v_18: I32
    %v_20 = vlane %v, 0: I32
    %v_21 = imul %v_20, 10: I32
    %v_22 = add %v_19, %v_21: I32
    %v_23 = vlane %v, 1: I32
    %v_24 = add %v_22, %v_23: I32
