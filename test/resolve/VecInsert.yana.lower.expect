main<complex>(): I32 {
  b_0 {
    %v_1 = call_complex floats: I32
    %v_2 = cmp_neq %v_1, 0: I32
    je %v_2, b_3, b_4
  }

  b_3 {
    %v_5 = call_complex floats: I32
    %v_6 = imul %v_5, 10: I32
    ret %v_6
  }

  b_4 {
    %v_7 = call_complex indices: I32
    %v_8 = cmp_neq %v_7, 0: I32
    je %v_8, b_9, b_10
  }

  b_9 {
    %v_11 = call_complex indices: I32
    %v_12 = imul %v_11, 100: I32
    ret %v_12
  }

  b_10 {
    %v = vsplat 5: i32x4
    %a = vwithlane %v, 9, 1: i32x4
    %b = vwithlane %a, 7, 0: i32x4
    %v_13 = vlane %b, 0: I32
    %v_14 = imul %v_13, 1000: I32
    %v_15 = vlane %b, 1: I32
    %v_16 = imul %v_15, 100: I32
    %v_17 = add %v_14, %v_16: I32
    %v_18 = vlane %v, 0: I32
    %v_19 = imul %v_18, 10: I32
    %v_20 = add %v_17, %v_19: I32
    %v_21 = vlane %v, 1: I32
    %v_22 = add %v_20, %v_21: I32
