    %e = vwithlane %d, 4.25, 1: f64x2
    %v_10 = vlane %e, 0: F64
    %v_11 = cmp_neq %v_10, 1.5: I32
    je %v_11, b_12, b_13
  }

  b_12 {
    ret 18446744073709551613
  }

  b_13 {
    %v_14 = vlane %e, 1: F64
    %v_15 = cmp_neq %v_14, 4.25: I32
    je %v_15, b_16, b_17
  }

  b_16 {
    ret 18446744073709551612
  }

  b_17 {
    ret 0
  }
}

indices<complex>(): I32 {
  b_0 {
    %v_1 = vsplat 0: i32x4
    %v_2 = vwithlane %v_1, 1, 1: i32x4
    %v_3 = vwithlane %v_2, 2, 2: i32x4
    %v = vwithlane %v_3, 3, 3: i32x4
    %v_4 = vlane %v, 0: I32
    %v_5 = cmp_neq %v_4, 0: I32
    je %v_5, b_6, b_7
  }

  b_6 {
    ret 18446744073709551615
  }

  b_7 {
    %v_8 = vlane %v, 1: I32
    %v_9 = cmp_neq %v_8, 1: I32
    je %v_9, b_10, b_11
  }

  b_10 {
    ret 18446744073709551614
  }

  b_11 {
    %r = vshuffle %v, %v, 3, 2, 1, 0: i32x4
    %v_12 = vlane %r, 0: I32
    %v_13 = cmp_neq %v_12, 3: I32
    je %v_13, b_14, b_15
  }

  b_14 {
    ret 18446744073709551613
  }

  b_15 {
    ret 0
