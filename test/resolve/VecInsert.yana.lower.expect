@image$base = []

floats<complex>(): I32 {
  b_0 {
    %f = vsplat 1.5: f32x4
    %g = vwithlane %f, -0, 0: f32x4
    %v_1 = vlane %g, 1: F32
    %v_2 = cmp_neq %v_1, 1.5: I32
    je %v_2, b_3, b_4
  }

  b_3 {
    ret 18446744073709551615
  }

  b_4 {
    %v_5 = vlane %g, 0: F32
    %v_6 = div 1, %v_5: F32
    %v_7 = cmp_gt %v_6, 0: I32
    je %v_7, b_8, b_9
  }

  b_8 {
    ret 18446744073709551614
  }

  b_9 {
