main<complex>(): I32 {
  b_0 {
    %v_1 = call_complex floats: I32
    %v_2 = cmp_neq %v_1, 0: I32
    je %v_2, b_3, b_4
  }

  b_3 {
    %v_5 = call_complex floats: I32
    %v_6 = imul %v_5, 10: I32
    ret %v_6
  }

  b_4 {
    jmp b_7
  }

  b_7 {
    %v_8 = call_complex indices: I32
    %v_9 = cmp_neq %v_8, 0: I32
    je %v_9, b_10, b_11
  }

  b_10 {
    %v_12 = call_complex indices: I32
    %v_13 = imul %v_12, 100: I32
    ret %v_13
  }

  b_11 {
    jmp b_14
