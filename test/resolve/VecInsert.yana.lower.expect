@image$base = []

floats<complex>(): I32 {
  b_0 {
    %f = vsplat 1.5: f32x4
    %v_1 = neg 0: F32
    %g = vwithlane %f, %v_1, 0: f32x4
    %v_2 = vlane %g, 1: F32
    %v_3 = cmp_neq %v_2, 1.5: I32
    je %v_3, b_4, b_5
  }

  b_4 {
    ret 18446744073709551615
  }

  b_5 {
    jmp b_6
  }

  b_6 {
    %v_7 = vlane %g, 0: F32
    %v_8 = div 1, %v_7: F32
    %v_9 = cmp_gt %v_8, 0: I32
    je %v_9, b_10, b_11
  }

  b_10 {
    ret 18446744073709551614
  }

  b_11 {
    jmp b_12
  }

  b_12 {
    %d = vsplat 1.5: f64x2
    %e = vwithlane %d, 4.25, 1: f64x2
    %v_13 = vlane %e, 0: F64
    %v_14 = cmp_neq %v_13, 1.5: I32
    je %v_14, b_15, b_16
  }

  b_15 {
    ret 18446744073709551613
  }

  b_16 {
    jmp b_17
  }

  b_17 {
    %v_18 = vlane %e, 1: F64
    %v_19 = cmp_neq %v_18, 4.25: I32
    je %v_19, b_20, b_21
  }

  b_20 {
    ret 18446744073709551612
  }

  b_21 {
    jmp b_22
  }

  b_22 {
    ret 0
  }
}

indices<complex>(): I32 {
  b_0 {
    %v_1 = vsplat 0: i32x4
    %v_2 = vwithlane %v_1, 1, 1: i32x4
    %v_3 = vwithlane %v_2, 2, 2: i32x4
    %v = vwithlane %v_3, 3, 3: i32x4
    %v_4 = vlane %v, 0: I32
    %v_5 = cmp_neq %v_4, 0: I32
    je %v_5, b_6, b_7
  }

  b_6 {
    ret 18446744073709551615
  }

  b_7 {
    jmp b_8
  }

  b_8 {
    %v_9 = vlane %v, 1: I32
    %v_10 = cmp_neq %v_9, 1: I32
    je %v_10, b_11, b_12
  }

  b_11 {
    ret 18446744073709551614
  }

  b_12 {
    jmp b_13
  }

  b_13 {
    %r = vshuffle %v, %v, 3, 2, 1, 0: i32x4
    %v_14 = vlane %r, 0: I32
    %v_15 = cmp_neq %v_14, 3: I32
    je %v_15, b_16, b_17
  }

  b_16 {
    ret 18446744073709551613
  }

  b_17 {
    jmp b_18
  }

  b_18 {
    ret 0
