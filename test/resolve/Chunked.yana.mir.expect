  %42: Size = const 1
  write.init borrow.unique ([%%29][1]) take %27
  %44: Size = const 2
  write.init borrow.unique ([%%29][2]) take %28
  %46: Array(I32) = read take (local3)
  write.init borrow.unique (arr) take %46
  %48: Chunks [shared call] = read borrow.shared (cs) loan0
  %49: I32 = call sumChunked borrow.shared %48
  %50: Ring [shared call] = read borrow.shared (ring) loan1
  %51: I32 = call sumContiguous borrow.shared %50
  %52: I32 = add inspect %49 inspect %51
  %53: Array(I32) [shared call] = read borrow.shared (arr) loan2
  %54: I32 = call sumArray borrow.shared %53
