  %55: I32 = add inspect %52 inspect %54
  %56: Ring [shared slot 0] = read borrow.shared (ring) loan3
  %57: Array(I32) [shared slot 0 view] = call elements(Ring, I32) borrow.shared %56 roots{3}
  %58: I32 = call total borrow.shared %57
  %59: I32 = add inspect %55 inspect %58
  %60: Ring [shared slot 0] = read borrow.shared (ring) loan4
  %61: Array(I32) [shared slot 0 view] = call elements(Ring, I32) borrow.shared %60 roots{4}
  %62: I32 = call count'2(I32) borrow.shared %61
  drop (ring)
