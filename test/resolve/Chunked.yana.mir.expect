  %35: @bits(2) U32 = const 1
  %36: Run(I32) = aggregate.Run take %29 take %34 take %35
  %37: @bits(30) U32 = const 3
  %38: Array(I32) = aggregate.Array take %36 take %37
  write.init borrow.unique (local3) take %38
  %40: Size = const 0
