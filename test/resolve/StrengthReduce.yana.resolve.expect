    %v234 = load %i : Int
    %v237 = add %v234, 1 : Int
    assign %i, %v237
    jmp b7

  b10:
    %v243 = load %i : Int
    %v246 = cmp_lt %v243, 6 : Bool
    je %v246, b12, b11

  b11:
    %v279 = load %total : Int
    ret %v279

  b12:
    %v248 = load %total : Int
    %v249 = load %i : Int
    %v250 = borrow %local3 : &[U32 *6]
    %uints = alloc : Flat(U32)
    %v252 = addressof [%v250] : %U32
    init %uints@Flat.items, %v252
    %v255 = cast 6 : I64
    init %uints@Flat.length, %v255
    %v257 = cast %v249 : I64
    %v258 = borrow %uints : &Flat(U32)
    %v259 = load [%v258]@Flat.length : I64
    %v260 = cast %v257 : U64
    %v261 = cast %v259 : U64
    %v262 = cmp_ge %v260, %v261 : Bool
    call checkCondition, %v262
    %v264 = load [%v258]@Flat.items : %U32
    %v265 = strideof U32 : Long
    %v266 = mul %v257, %v265 : Long
    %v267 = add %v264, %v266 : %U32
    %v268 = borrow [%v267] : &U32
    %v269 = load [%v268] : U32
    %v270 = call unsignedInt, %v269 : Int
    %v271 = add %v248, %v270 : Int
    assign %total, %v271
    %v273 = load %i : Int
    %v276 = add %v273, 1 : Int
    assign %i, %v276
    jmp b10
}
