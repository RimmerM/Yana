module ResolveTest

fn distinctBlocks() -> I64 {
  local first: %U8
  local second: %U8

bb0:
  %0: Size = const 32
  %1: %U8 = call allocateHeap borrow.shared %0
  write.init borrow.unique (first) take %1
  %3: Size = const 32
  %4: %U8 = call allocateHeap borrow.shared %3
  write.init borrow.unique (second) take %4
  %6: %U8 = read copy.trivial (first)
  %7: Bool = call isNull(U8) borrow.shared %6
  branch inspect %7 -> bb3 -> bb1

bb1:
  %10: %U8 = read copy.trivial (second)
  %11: Bool = call isNull(U8) borrow.shared %10
  jump -> bb2(take %11)

bb2(%12: Bool):
  branch inspect %12 -> bb6 -> bb4

bb3:
  %9: Bool = const True
  jump -> bb2(take %9)

bb4:
  jump -> bb5

bb5:
  %19: %U8 = read copy.trivial (first)
  %20: %U8 = read copy.trivial (second)
  %21: Size = bitcast inspect %20
  %22: Size = bitcast inspect %19
  %23: Size = sub inspect %21 inspect %22
  %24: Size = metric stride U8
  %25: Size = div inspect %23 inspect %24
  %26: Size = const 32
  %27: Bool = lt inspect %25 inspect %26
  branch inspect %27 -> bb9 -> bb7

bb6:
  %16: I64 = const 0
  return take %16

bb7:
  jump -> bb8

bb8:
  %32: I64 = const 1
  return take %32

bb9:
  %29: I64 = const 0
  return take %29
}

fn writeAndRead() -> I64 {
  local a: %I64
  local b: %I64

bb0:
  %0: Size = const 8
  %1: %U8 = call allocateHeap borrow.shared %0
  %2: %I64 = bitcast inspect %1
  write.init borrow.unique (a) take %2
  %4: Size = const 8
  %5: %U8 = call allocateHeap borrow.shared %4
  %6: %I64 = bitcast inspect %5
  write.init borrow.unique (b) take %6
  %8: %I64 = read copy.trivial (a)
  %9: Bool = call isNull(I64) borrow.shared %8
  branch inspect %9 -> bb3 -> bb1

bb1:
  %12: %I64 = read copy.trivial (b)
  %13: Bool = call isNull(I64) borrow.shared %12
  jump -> bb2(take %13)

bb2(%14: Bool):
  branch inspect %14 -> bb6 -> bb4

bb3:
  %11: Bool = const True
  jump -> bb2(take %11)

bb4:
  jump -> bb5

bb5:
  %21: %I64 = read copy.trivial (a)
  %22: I64 = const 40
  write.assign borrow.unique ([%%21]) take %22
  %24: %I64 = read copy.trivial (b)
  %25: I64 = const 2
  write.assign borrow.unique ([%%24]) take %25
  %27: %I64 = read copy.trivial (a)
  %28: I64 = read copy.trivial ([%%27])
  %29: %I64 = read copy.trivial (b)
  %30: I64 = read copy.trivial ([%%29])
  %31: I64 = add inspect %28 inspect %30
  return take %31

bb6:
  %18: I64 = const 0
  return take %18
}

fn reuseAfterFree() -> I64 {
  local first: %U8
  local second: %U8

bb0:
  %0: Size = const 100
  %1: %U8 = call allocateHeap borrow.shared %0
  write.init borrow.unique (first) take %1
  %3: %U8 = read copy.trivial (first)
  %4: {} = call freeHeap borrow.shared %3
  %5: Size = const 100
  %6: %U8 = call allocateHeap borrow.shared %5
  write.init borrow.unique (second) take %6
  %8: %U8 = read copy.trivial (first)
  %9: %U8 = read copy.trivial (second)
  %10: Bool = eq inspect %8 inspect %9
  branch inspect %10 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %15: I64 = const 0
  return take %15

bb3:
  %12: I64 = const 1
  return take %12
}

fn classesAreSeparate() -> I64 {
  local small: %U8
  local large: %U8

bb0:
  %0: Size = const 8
  %1: %U8 = call allocateHeap borrow.shared %0
  write.init borrow.unique (small) take %1
  %3: %U8 = read copy.trivial (small)
  %4: {} = call freeHeap borrow.shared %3
  %5: Size = const 1000
  %6: %U8 = call allocateHeap borrow.shared %5
  write.init borrow.unique (large) take %6
  %8: %U8 = read copy.trivial (small)
  %9: %U8 = read copy.trivial (large)
  %10: Bool = eq inspect %8 inspect %9
  branch inspect %10 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %15: I64 = const 1
  return take %15

bb3:
  %12: I64 = const 0
  return take %12
}

fn main() -> I32 {
  local total: I64

bb0:
  %0: I64 = call distinctBlocks
  %1: I64 = const 1000
  %2: I64 = mul inspect %0 inspect %1
  %3: I64 = call writeAndRead
  %4: I64 = const 10
  %5: I64 = mul inspect %3 inspect %4
  %6: I64 = add inspect %2 inspect %5
  %7: I64 = call reuseAfterFree
  %8: I64 = const 5
  %9: I64 = mul inspect %7 inspect %8
  %10: I64 = add inspect %6 inspect %9
  %11: I64 = call classesAreSeparate
  %12: I64 = add inspect %10 inspect %11
  write.init borrow.unique (total) take %12
  %14: I64 = read copy.trivial (total)
  %15: I32 = convert inspect %14
  return take %15
}

entry main
