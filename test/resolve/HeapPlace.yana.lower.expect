@heapFree = [0, 0, 0, 0, 0, 0, 0, 0]
@heapNext = [0, 0, 0, 0, 0, 0, 0, 0]
@heapLimit = [0, 0, 0, 0, 0, 0, 0, 0]

heapBlockSize<complex>(%sizeClass: Long): Long {
  b_0 {
    %v_1 = shl 16, %sizeClass: Long
    ret %v_1
  }
}

heapClassOf<complex>(%total: Long): Long {
  b_0 {
    jmp b_1
  }

  b_1 {
    %v_2 = phi [b_0, 16], [b_3, %v_4]: Long
    %v_5 = phi [b_0, 0], [b_3, %v_6]: Long
    %v_7 = cmp_ilt %v_2, %total: Int
    je %v_7, b_3, b_8
  }

  b_8 {
    ret %v_5
  }

  b_3 {
    %v_4 = add %v_2, %v_2: Long
    %v_6 = add %v_5, 1: Long
    jmp b_1
  }
}

mapMemory<complex>(%size: Long): Ptr {
  b_0 {
    %result = syscall 9, 0, %size, 3, 34, 18446744073709551615, 0: Long
    %v_1 = cmp_ilt %result, 0: Int
    je %v_1, b_2, b_3
  }

  b_2 {
    %v_4 = bitcast 0: Ptr
    ret %v_4
  }

  b_3 {
    jmp b_5
  }

  b_5 {
    %v_6 = bitcast %result: Ptr
    ret %v_6
  }
}

setFreeListHead<complex>(%sizeClass: Long, %block: Ptr) {
  b_0 {
    %v_1 = load @heapFree, 8: Ptr
    %v_2 = imul %sizeClass, 8: Long
    %v_3 = add %v_1, %v_2: Ptr
    store %v_3, %block, 8
    ret 
  }
}

freeHeap<complex>(%allocation: Ptr) {
  b_0 {
    %v_1 = bitcast %allocation: Long
    %v_2 = cmp_eq %v_1, 0: Int
    je %v_2, b_3, b_4
  }

  b_3 {
    ret 
  }

  b_4 {
    jmp b_5
  }

  b_5 {
    %v_6 = sub %allocation, 8: Ptr
    %v_7 = bitcast %v_6: Ptr
    %sizeClass = loads %v_7, 8: Long
    %v_8 = bitcast %allocation: Ptr
    %v_9 = call_complex freeListHead, %sizeClass: Ptr
    store %v_8, %v_9, 8
    call_complex setFreeListHead, %sizeClass, %allocation
    ret 
  }
}

allocateHeap<complex>(%size: Long): Ptr {
  b_0 {
    %v_1 = load @heapFree, 8: Ptr
    %v_2 = bitcast %v_1: Long
    %v_3 = cmp_eq %v_2, 0: Int
    je %v_3, b_4, b_5
  }

  b_4 {
    call_complex initHeap
    %v_6 = load @heapFree, 8: Ptr
    %v_7 = bitcast %v_6: Long
    %v_8 = cmp_eq %v_7, 0: Int
    je %v_8, b_9, b_10
  }

  b_5 {
    jmp b_11
  }

  b_9 {
    %v_12 = bitcast 0: Ptr
    ret %v_12
  }

  b_10 {
    jmp b_13
  }

  b_13 {
    jmp b_11
  }

  b_11 {
    %v_14 = add %size, 8: Long
    %sizeClass = call_complex heapClassOf, %v_14: Long
    %v_15 = cmp_ige %sizeClass, 32: Int
    je %v_15, b_16, b_17
  }

  b_16 {
    %v_18 = bitcast 0: Ptr
    ret %v_18
  }

  b_17 {
    jmp b_19
  }

  b_19 {
    %reused = call_complex freeListHead, %sizeClass: Ptr
    %v_20 = bitcast %reused: Long
    %v_21 = cmp_eq %v_20, 0: Int
    %v_22 = xor %v_21, 1: Int
    je %v_22, b_23, b_24
  }

  b_23 {
    %v_25 = bitcast %reused: Ptr
    %v_26 = load %v_25, 8: Ptr
    call_complex setFreeListHead, %sizeClass, %v_26
    ret %reused
  }

  b_24 {
    jmp b_27
  }

  b_27 {
    %block = load @heapNext, 8: Ptr
    %blockSize = call_complex heapBlockSize, %sizeClass: Long
    %v_28 = add %block, %blockSize: Ptr
    %v_29 = load @heapLimit, 8: Ptr
    %v_30 = cmp_gt %v_28, %v_29: Int
    je %v_30, b_31, b_32
  }

  b_31 {
    %v_33 = bitcast 0: Ptr
    ret %v_33
  }

  b_32 {
    jmp b_34
  }

  b_34 {
    store @heapNext, %v_28, 8
    %v_35 = bitcast %block: Ptr
    store %v_35, %sizeClass, 8
    %v_36 = add %block, 8: Ptr
    ret %v_36
  }
}

freeListHead<complex>(%sizeClass: Long): Ptr {
  b_0 {
    %v_1 = load @heapFree, 8: Ptr
    %v_2 = imul %sizeClass, 8: Long
    %v_3 = add %v_1, %v_2: Ptr
    %v_4 = load %v_3, 8: Ptr
    ret %v_4
  }
}

main<complex>(): Int {
  b_0 {
    %p = call_complex allocateHeap, 16: Ptr
    %v_1 = add %p, 8: Ptr
    store %v_1, 20, 8
    store %p, 12, 8
    call_complex freeHeap, %p
    ret 32
  }
}

initHeap<complex>() {
  b_0 {
    %region = call_complex mapMemory, 4194304: Ptr
    %v_1 = bitcast %region: Long
    %v_2 = cmp_eq %v_1, 0: Int
    %v_3 = imm 256: Long
    je %v_2, b_4, b_5
  }

  b_4 {
    ret 
  }

  b_5 {
    jmp b_6
  }

  b_6 {
    setpattern %region, %v_3, 0
    %v_7 = bitcast %region: Ptr
    store @heapFree, %v_7, 8
    %v_8 = add %region, %v_3: Ptr
    store @heapNext, %v_8, 8
    %v_9 = add %region, 4194304: Ptr
    store @heapLimit, %v_9, 8
    ret 
  }
}

