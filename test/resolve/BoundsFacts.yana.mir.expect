  %13: Size = const 1
  %14: Array(U8) [shared call view] = read borrow.shared (bytes) loan2
  %15: U8 [shared slot 0] = call.subscript get(Array(U8), Size, U8) borrow.shared %14 borrow.shared %13 roots{2}
  write.init borrow.unique (local2) borrow.shared %15
  %17: U8 = read copy.trivial (local2)
  %18: Array(U8) [shared call view] = read borrow.shared (bytes) loan3
  %19: Size = const 2
  %20: U16 = call readBigU16 borrow.shared %18 borrow.shared %19
  %21: Size = const 4
  %22: Array(U8) [shared call view] = read borrow.shared (bytes) loan4
  %23: U8 [shared slot 0] = call.subscript get(Array(U8), Size, U8) borrow.shared %22 borrow.shared %21 roots{4}
  write.init borrow.unique (local3) borrow.shared %23
  %25: U8 = read copy.trivial (local3)
  %26: Array(U8) [shared call view] = read borrow.shared (bytes) loan5
  %27: Size = const 5
  %28: U32 = call readBigU32 borrow.shared %26 borrow.shared %27
  %29: Header = aggregate.Header take %12 take %17 take %20 take %25 take %28
  %30: Maybe(Header) = aggregate.Just take %29
  return take %30

bb3:
  %5: Maybe(Header) = aggregate.Nothing
  return take %5
}

