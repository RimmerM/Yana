module ResolveTest

data Guard {id: I32} drop authored

instance Drop(Guard): Guard.drop

let & live: I32 = 0

fn Guard.drop(self: Guard) -> {} {
bb0:
  %0: I32 = read copy.trivial (global live)
  %1: I32 = const 1
  %2: I32 = sub inspect %0 inspect %1
  write.assign borrow.unique (global live) take %2
  return
}

fn guard(id: I32 [shared call]) -> Guard {
bb0:
  %0: I32 = read copy.trivial (global live)
  %1: I32 = const 1
  %2: I32 = add inspect %0 inspect %1
  write.assign borrow.unique (global live) take %2
  %4: I32 = read copy.trivial (id)
  %5: Guard = aggregate.Guard take %4
  return take %5
}

fn consume(g: Guard) -> I32 {
bb0:
  %0: I32 = read copy.trivial (g.id)
  drop (g)
  return take %0
}

fn heaped(c: Bool [shared call], d: Bool [shared call]) -> I32 {
  local & g: Guard
  local n: I32

bb0:
  %0: I32 = const 1
  %1: Guard = call guard borrow.shared %0
  write.init borrow.unique (g) take %1
  %3: Bool = read copy.trivial (c)
  branch inspect %3 -> bb3 -> bb1

bb1:
  drop (g)
  jump -> bb2

bb2:
  %10: Bool = read copy.trivial (d)
  branch inspect %10 -> bb6 -> bb4

bb3:
  %5: Guard = read take (g)
  %6: I32 = call consume take %5
  write.init borrow.unique (n) take %6
  jump -> bb2

bb4:
  jump -> bb5

bb5:
  %17: I32 = read copy.trivial (global live)
  return take %17

bb6:
  %12: I32 = const 2
  %13: Guard = call guard borrow.shared %12
  write.reinit borrow.unique (g) take %13
  drop (g)
  jump -> bb5
}

