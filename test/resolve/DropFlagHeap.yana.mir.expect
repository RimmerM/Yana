bb3:
  %8: I32 = const -1
  return take %8

bb4:
  %17: I32 = read copy.trivial (i)
  %18: I32 = const 100
  %19: Bool = lt inspect %17 inspect %18
  branch inspect %19 -> bb6 -> bb5

bb5:
  %30: I32 = read copy.trivial (global live)
  %31: I32 = const 0
  %32: Bool = ne inspect %30 inspect %31
  branch inspect %32 -> bb9 -> bb7

bb6:
