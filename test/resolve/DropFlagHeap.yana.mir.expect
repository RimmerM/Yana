bb1:
  jump -> bb2

bb2:
  %11: %U8 = read copy.trivial (global heapNext)
  %12: Size = bitcast inspect %11
  write.init borrow.unique (mark) take %12
  %14: I32 = const 0
  write.init borrow.unique (i) take %14
