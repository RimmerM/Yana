module ResolveTest

let string: [CodeUnit *20] = [48, 48, 48, 49, 48, 50, 48, 51, 48, 52, 48, 53, 48, 54, 48, 55, 48, 56, 48, 57]

fn main() -> I32 {
  local & score: I32
  local local1: String

bb0:
  %0: I32 = const 0
  write.init borrow.unique (score) take %0
  %2: Size = call pairCount
  %3: Size = const 10
  %4: Bool = eq inspect %2 inspect %3
  branch inspect %4 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %12: Size = const 0
  %13: I64 = call power borrow.shared %12
  %14: I64 = const 1
  %15: Bool = eq inspect %13 inspect %14
  branch inspect %15 -> bb6 -> bb4

bb3:
  %6: I32 = read copy.trivial (score)
  %7: I32 = const 1
  %8: I32 = add inspect %6 inspect %7
  write.assign borrow.unique (score) take %8
  jump -> bb2

bb4:
  jump -> bb5

bb5:
  %23: Size = const 4
  %24: I64 = call power borrow.shared %23
  %25: I64 = const 10000
  %26: Bool = eq inspect %24 inspect %25
  branch inspect %26 -> bb9 -> bb7

bb6:
  %17: I32 = read copy.trivial (score)
  %18: I32 = const 2
  %19: I32 = add inspect %17 inspect %18
  write.assign borrow.unique (score) take %19
  jump -> bb5

bb7:
  jump -> bb8

bb8:
  %34: String [shared call] = read borrow.shared (global decimalPairs) loan0
  %35: String [shared slot 0 view] = call.derivation view(String) borrow.shared %34 roots{0}
  %36: [CodeUnit *20] [shared slot 0] = read borrow.shared (global string) loan1
  %37: %[CodeUnit *20] [owned here shape1 .*=shared slot 0] = address inspect %36 roots.0{1}
  %38: %CodeUnit = bitcast inspect %37
  %39: Size = const 20
  %40: String = call stringLiteral borrow.shared %38 borrow.shared %39
  write.init borrow.unique (local1) take %40
  %42: String [shared slot 0] = read borrow.shared (local1) loan2
  %43: String [shared slot 0 view] = call.derivation view(String) borrow.shared %42 roots{2}
  %44: Bool = call ==(String) borrow.shared %35 borrow.shared %43
  drop (local1)
  branch inspect %44 -> bb12 -> bb10

bb9:
  %28: I32 = read copy.trivial (score)
  %29: I32 = const 4
  %30: I32 = add inspect %28 inspect %29
  write.assign borrow.unique (score) take %30
  jump -> bb8

bb10:
  jump -> bb11

bb11:
  %52: I32 = read copy.trivial (score)
  return take %52

bb12:
  %46: I32 = read copy.trivial (score)
  %47: I32 = const 8
  %48: I32 = add inspect %46 inspect %47
  write.assign borrow.unique (score) take %48
  jump -> bb11
}
module Tables

let decimalPairs: String = String {units: Array {run: Run {items: &string, capacity: 20, ownsHeap: 0}, length: 20}}

let powers: [I64 *5] = [1, 10, 100, 1000, 10000]

let string: [CodeUnit *20] = [48, 48, 48, 49, 48, 50, 48, 51, 48, 52, 48, 53, 48, 54, 48, 55, 48, 56, 48, 57]

fn power(index: Size [shared call]) -> I64 {
bb0:
  %0: Size = read copy.trivial (index)
  %1: I64 = read copy.trivial (global powers[...])
  return take %1
}

fn pairCount() -> Size {
bb0:
  %0: String [shared call] = read borrow.shared (global decimalPairs) loan0
  %1: String [shared slot 0 view] = call.derivation view(String) borrow.shared %0 roots{0}
  %2: Size = call length(String) borrow.shared %1
  %3: Size = const 2
  %4: Size = div inspect %2 inspect %3
  return take %4
}

entry main
