}
module Tables

let decimalPairs: String = String {units: Array {run: Run {items: &string'145, capacity: 20, ownsHeap: 0}, length: 20}}

let powers: [I64 *5] = [1, 10, 100, 1000, 10000]

let string'145: [CodeUnit *20] = "00010203040506070809"

fn power(index: Size [shared call]) -> I64 {
bb0:
  %0: Size = read copy.trivial (index)
  %1: USize = const 5
  %2: USize = bitcast inspect %0
  %3: Bool = ge inspect %2 inspect %1
  %4: {} = call checkCondition borrow.shared %3
  %5: I64 = read copy.trivial (global powers[...])
  return take %5
}

fn pairCount() -> Size {
bb0:
  %0: String [shared call] = read borrow.shared (global decimalPairs) loan0
  %1: String [shared slot 0 view] = call.derivation view(String) borrow.shared %0 roots{0}
  %2: Size = call length(String) borrow.shared %1
  %3: Size = const 2
  %4: Size = div inspect %2 inspect %3
  return take %4
}

entry main
