module ResolveTest

let string'143: [CodeUnit *20] = "00010203040506070809"

fn main() -> I32 {
  local & score: I32
  local local1: String

bb0:
  %0: I32 = const 0
  write.init borrow.unique (score) take %0
  %2: Size = call pairCount
  %3: Size = const 10
  %4: Bool = eq inspect %2 inspect %3
  branch inspect %4 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %12: Size = const 0
  %13: I64 = call power borrow.shared %12
  %14: I64 = const 1
  %15: Bool = eq inspect %13 inspect %14
  branch inspect %15 -> bb6 -> bb4

bb3:
  %6: I32 = read copy.trivial (score)
  %7: I32 = const 1
  %8: I32 = add inspect %6 inspect %7
  write.assign borrow.unique (score) take %8
  jump -> bb2

bb4:
  jump -> bb5

bb5:
  %23: Size = const 4
  %24: I64 = call power borrow.shared %23
  %25: I64 = const 10000
  %26: Bool = eq inspect %24 inspect %25
  branch inspect %26 -> bb9 -> bb7

bb6:
  %17: I32 = read copy.trivial (score)
  %18: I32 = const 2
  %19: I32 = add inspect %17 inspect %18
  write.assign borrow.unique (score) take %19
  jump -> bb5

bb7:
  jump -> bb8

bb8:
  %34: String [shared call] = read borrow.shared (global decimalPairs) loan0
  %35: String [shared slot 0 view] = call.derivation view(String) borrow.shared %34 roots{0}
  %36: String = const String {units: Array {run: Run {items: &string'143, capacity: 20, ownsHeap: 0}, length: 20}}
  write.init borrow.unique (local1) take %36
  %38: String [shared slot 0] = read borrow.shared (local1) loan1
  %39: String [shared slot 0 view] = call.derivation view(String) borrow.shared %38 roots{1}
  %40: Bool = call ==(String) borrow.shared %35 borrow.shared %39
  drop (local1)
  branch inspect %40 -> bb12 -> bb10

bb9:
  %28: I32 = read copy.trivial (score)
  %29: I32 = const 4
  %30: I32 = add inspect %28 inspect %29
  write.assign borrow.unique (score) take %30
  jump -> bb8

bb10:
  jump -> bb11

bb11:
  %48: I32 = read copy.trivial (score)
  return take %48

bb12:
  %42: I32 = read copy.trivial (score)
  %43: I32 = const 8
  %44: I32 = add inspect %42 inspect %43
