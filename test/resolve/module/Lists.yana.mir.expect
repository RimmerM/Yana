module ResolveTest

fn areas() -> I32 {
bb0:
  %0: I32 = const 3
  %1: I32 = const 4
  %2: Point = aggregate.Point take %0 take %1
  %3: I32 = call area(Point) borrow.shared %2
  %4: I32 = const 1
  %5: I32 = const 2
  %6: Point = aggregate.Point take %4 take %5
  %7: I32 = const 3
  %8: Point = call scale borrow.shared %6 borrow.shared %7
  %9: I32 = call area(Point) borrow.shared %8
  %10: I32 = add inspect %3 inspect %9
  return take %10
}

fn origins() -> I32 {
bb0:
  %0: Point = call origin
  %1: I32 = call area(Point) borrow.shared %0
  return take %1
}

fn axis() -> I32 {
bb0:
  %0: Axis = aggregate.Vertical
  %1: I32 = const 5
  %2: I32 = const 9
  %3: Point = aggregate.Point take %1 take %2
  %4: I32 = call along borrow.shared %0 borrow.shared %3
  return take %4
}

fn main() -> I32 {
bb0:
  %0: I32 = call areas
  %1: I32 = call origins
  %2: I32 = add inspect %0 inspect %1
  %3: I32 = call axis
  %4: I32 = add inspect %2 inspect %3
  return take %4
}
module Geometry

data Point {x: I32, y: I32}

data Axis = Horizontal | Vertical

data Secret {code: I32}

class Area(a): area

class Hidden(a): conceal

instance Area(Point): Point.area

fn area(value: a [shared call]) -> I32 = <no body>

fn conceal(value: a [shared call]) -> I32 = <no body>

fn Point.area(value: Point [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (value.x)
  %1: I32 = read copy.trivial (value.y)
  %2: I32 = mul inspect %0 inspect %1
  return take %2
}

fn origin() -> Point {
bb0:
  %0: I32 = const 0
  %1: I32 = const 0
  %2: Point = aggregate.Point take %0 take %1
  return take %2
}

fn scale(value: Point [shared call], by: I32 [shared call]) -> Point {
bb0:
  %0: I32 = read copy.trivial (value.x)
  %1: I32 = read copy.trivial (by)
  %2: I32 = mul inspect %0 inspect %1
  %3: I32 = read copy.trivial (value.y)
  %4: I32 = read copy.trivial (by)
  %5: I32 = mul inspect %3 inspect %4
  %6: Point = aggregate.Point take %2 take %5
  return take %6
}

fn totalArea(one: a [shared call], other: a [shared call]) -> I32 {
  form specialized
  slot #0 type a
  slot #1 class Area(a)
bb0:
  %0: a [shared call] = read borrow.shared (one) loan0
  %1: I32 = call area(a) borrow.shared %0
  %2: a [shared call] = read borrow.shared (other) loan1
  %3: I32 = call area(a) borrow.shared %2
  %4: I32 = add inspect %1 inspect %3
  return take %4
}

fn tripleArea(value: a [shared call]) -> I32 {
  form specialized
  slot #0 type a
  slot #1 class Area(a)
bb0:
  %0: a [shared call] = read borrow.shared (value) loan0
  %1: a [shared call] = read borrow.shared (value) loan1
  %2: I32 = call totalArea(a) borrow.shared %0 borrow.shared %1
  %3: a [shared call] = read borrow.shared (value) loan2
  %4: I32 = call area(a) borrow.shared %3
  %5: I32 = add inspect %2 inspect %4
  return take %5
}

fn along(axis: Axis [shared call], of: Point [shared call]) -> I32 {
bb0:
  %0: U8 = read copy.trivial (axis.#)
  %1: U8 = const 0
  %2: Bool = eq inspect %0 inspect %1
  branch inspect %2 -> bb3 -> bb1

bb1:
  %5: I32 = read copy.trivial (of.y)
  jump -> bb2(take %5)

bb2(%6: I32):
  return take %6

bb3:
  %4: I32 = read copy.trivial (of.x)
  jump -> bb2(take %4)
}

fn secretArea(value: Point [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (value.x)
  %1: I32 = read copy.trivial (value.y)
  %2: I32 = add inspect %0 inspect %1
  return take %2
}

fn visibleArea(value: Point [shared call]) -> I32 {
bb0:
  %0: Point = read copy.trivial (value)
  %1: I32 = call secretArea borrow.shared %0
  %2: I32 = const 1
  %3: I32 = add inspect %1 inspect %2
  return take %3
}

fn shape(value: Point [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (value.x)
  return take %0
}

fn Geometry.shape(value: Point [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (value.y)
  return take %0
}

entry main
