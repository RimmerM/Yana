
areas<complex>(): I32 {
  b_0 {
    %v_1 = alloca 8, 4: Ptr
    store %v_1, 3, 4
    %v_2 = add %v_1, 4: Ptr
    store %v_2, 4, 4
    %v_3 = call_complex Point.area, %v_1: I32
    %v_4 = alloca 8, 4: Ptr
    store %v_4, 1, 4
    %v_5 = add %v_4, 4: Ptr
    store %v_5, 2, 4
    %v_6 = alloca 8, 4: Ptr
    call_complex scale, %v_6, %v_4, 3
    %v_7 = call_complex Point.area, %v_6: I32
    %v_8 = add %v_3, %v_7: I32
    ret %v_8
  }
}

origins<complex>(): I32 {
  b_0 {
    %v_1 = alloca 8, 4: Ptr
    call_complex origin, %v_1
    %v_2 = call_complex Point.area, %v_1: I32
    ret %v_2
  }
}

axis<complex>(): I32 {
  b_0 {
    %v_1 = alloca 8, 4: Ptr
    store %v_1, 5, 4
    %v_2 = add %v_1, 4: Ptr
    store %v_2, 9, 4
    %v_3 = call_complex along, 1, %v_1: I32
    ret %v_3
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = call_complex areas: I32
    %v_2 = call_complex origins: I32
    %v_3 = add %v_1, %v_2: I32
    %v_4 = call_complex axis: I32
    %v_5 = add %v_3, %v_4: I32
    ret %v_5
  }
}

Point.area<complex>(%value: Ptr): I32 {
  b_0 {
    %v_1 = loads %value, 4: I32
    %v_2 = add %value, 4: Ptr
    %v_3 = loads %v_2, 4: I32
    %v_4 = imul %v_1, %v_3: I32
    ret %v_4
  }
}

origin<complex>(%v_0: Ptr) {
  b_1 {
    %v_2 = alloca 8, 4: Ptr
    store %v_2, 0, 4
    %v_3 = add %v_2, 4: Ptr
    store %v_3, 0, 4
    copy %v_0, %v_2, 8
    ret 
  }
}

scale<complex>(%v_0: Ptr, %value: Ptr, %by: I32) {
  b_1 {
    %v_2 = alloca 4, 4: Ptr
    store %v_2, %by, 4
    %v_3 = loads %value, 4: I32
    %v_4 = loads %v_2, 4: I32
    %v_5 = imul %v_3, %v_4: I32
    %v_6 = add %value, 4: Ptr
    %v_7 = loads %v_6, 4: I32
    %v_8 = loads %v_2, 4: I32
    %v_9 = imul %v_7, %v_8: I32
    %v_10 = alloca 8, 4: Ptr
    store %v_10, %v_5, 4
    %v_11 = add %v_10, 4: Ptr
    store %v_11, %v_9, 4
    copy %v_0, %v_10, 8
    ret 
  }
}

along<complex>(%axis: I32, %of: Ptr): I32 {
  b_0 {
    %v_1 = alloca 1, 1: Ptr
    store %v_1, %axis, 1
    %v_2 = load %v_1, 1: I32
    %v_3 = cmp_eq %v_2, 0: I32
    je %v_3, b_4, b_5
  }

  b_5 {
    %v_6 = add %of, 4: Ptr
    %v_7 = loads %v_6, 4: I32
    jmp b_8
  }

  b_8 {
    %v_9 = phi [b_5, %v_7], [b_4, %v_10]: I32
    ret %v_9
  }

  b_4 {
    %v_10 = loads %of, 4: I32
    jmp b_8
  }
}

