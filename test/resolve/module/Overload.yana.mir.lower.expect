
Tag.weigh<complex>(%value: Ptr): I32 {
  b_0 {
    %v_1 = loads %value, 4: I32
    %v_2 = imul %v_1, 10: I32
    ret %v_2
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    %v_2 = alloca 4, 4: Ptr
    %v_3 = alloca 4, 4: Ptr
    %v_4 = alloca 4, 4: Ptr
    store %v_4, 5, 4
    %v_5 = call_complex Box.weigh, %v_4: I32
    store %v_1, %v_5, 4
    %v_6 = call_complex weigh'2, 6: I32
    store %v_2, %v_6, 4
    %v_7 = alloca 4, 4: Ptr
    store %v_7, 2, 4
    %v_8 = call_complex Tag.weigh, %v_7: I32
    store %v_3, %v_8, 4
    %v_9 = loads %v_1, 4: I32
    %v_10 = loads %v_2, 4: I32
    %v_11 = add %v_9, %v_10: I32
    %v_12 = loads %v_3, 4: I32
    %v_13 = add %v_11, %v_12: I32
    ret %v_13
  }
}

Box.weigh<complex>(%value: Ptr): I32 {
  b_0 {
    %v_1 = loads %value, 4: I32
    %v_2 = imul %v_1, 100: I32
    ret %v_2
  }
}

weigh'2<complex>(%value: I32): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    store %v_1, %value, 4
    %v_2 = loads %v_1, 4: I32
    %v_3 = add %v_2, 1: I32
    ret %v_3
  }
}

