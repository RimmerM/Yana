bb13:
  %23: %Array(CodeUnit) address = field.addr .units inspect %21
  %24: %Run(CodeUnit) address = field.addr .run inspect %23
  %25: %%CodeUnit address = field.addr .items inspect %24
  %26: %CodeUnit trivial = load inspect %25
  %27: %Array(CodeUnit) address = field.addr .units inspect %21
  %28: %@bits(30) U32 address = field.addr .length inspect %27
  %29: @bits(30) U32 trivial = load inspect %28
  %30: U32 trivial = convert inspect %29
  %31: Size trivial = convert inspect %30
  %32: StringView trivial = aggregate.StringView consume %26 consume %31
