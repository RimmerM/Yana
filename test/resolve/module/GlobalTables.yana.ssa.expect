module Tables

let decimalPairs: String = String {units: Array {run: Run {items: &string, capacity: 20, ownsHeap: 0}, length: 20}}

let powers: [I64 *5] = [1, 10, 100, 1000, 10000]

let string: [CodeUnit *20] = [48, 48, 48, 49, 48, 50, 48, 51, 48, 52, 48, 53, 48, 54, 48, 55, 48, 56, 48, 57]

fn power(index: Size [shared call]) -> I64 {
bb0(%0: Size [shared call] guaranteed):
  %1: %Size address = alloc frame Size [shared call]
  store inspect %1 borrow %0
  %2: Size trivial = load inspect %1
  %3: %[I64 *5] address = global.addr powers
  %4: %I64 address = element.addr inspect %3 inspect %2
  %5: I64 trivial = load inspect %4
  return consume %5
}

fn pairCount() -> Size {
bb0:
  %0: %String address = global.addr decimalPairs
  %1: String [shared call] guaranteed = load inspect %0
  jump -> bb1

bb1:
  %3: %Array(CodeUnit) address = field.addr .units inspect %1
  %4: %Run(CodeUnit) address = field.addr .run inspect %3
  %5: %%CodeUnit address = field.addr .items inspect %4
  %6: %CodeUnit trivial = load inspect %5
  %7: %Array(CodeUnit) address = field.addr .units inspect %1
  %8: %@bits(30) U32 address = field.addr .length inspect %7
  %9: @bits(30) U32 trivial = load inspect %8
  %10: U32 trivial = convert inspect %9
  %11: Size trivial = convert inspect %10
  %12: StringView trivial = aggregate.StringView consume %6 consume %11
  %13: String [shared slot 0 view] guaranteed = represent inspect %12
  jump -> bb2(borrow %13)

bb2(%2: String [shared slot 0 view] guaranteed):
  jump -> bb3

bb3:
  %15: %Size address = field.addr .length inspect %2
  %16: Size trivial = load inspect %15
  jump -> bb4(consume %16)

bb4(%14: Size trivial):
  %17: Size trivial = const 2
  %18: Size trivial = div inspect %14 inspect %17
  return consume %18
}

