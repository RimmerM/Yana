    %v1 = call origin : Point
    %v2 = call along, Horizontal, %v1 : I32
    %v4 = alloc : Point
    aggregate %local1@Point.x = 7, %local1@Point.y = 9
    %v8 = call along, Vertical, %v4 : I32
    %v9 = add %v2, %v8 : I32
