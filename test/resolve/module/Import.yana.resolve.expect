fn along(%axis: Axis, %of: Point) -> I32 {
  b0:
    %v2 = cast %axis : I32
    %v4 = cmp_eq %v2, 0 : Bool
    je %v4, b2, b1

  b1:
    %v7 = load %of@Point.y : I32
    jmp b3

  b2:
    %v6 = load %of@Point.x : I32
    jmp b3

  b3:
    %v10 = phi [b2, %v6], [b1, %v7] : I32
