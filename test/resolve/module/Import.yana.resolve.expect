    %v2 = alloc : Point
    %v3 = load %value@Point.x : I32
    %v4 = mul %v3, %by : I32
    %v5 = load %value@Point.y : I32
    %v6 = mul %v5, %by : I32
    aggregate %local1@Point.x = %v4, %local1@Point.y = %v6
