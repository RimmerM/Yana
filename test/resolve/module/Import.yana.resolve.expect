fn main() -> I32 {
  b0:
    %v0 = call area1 : I32
    %v1 = call area2 : I32
    %v2 = add %v0, %v1 : I32
    %v3 = call viaFunction : I32
    %v4 = add %v2, %v3 : I32
    %v5 = call qualifiedConstructor : Point
    %v6 = call Area(Point).area, %v5 : I32
    %v7 = add %v4, %v6 : I32
    %v8 = call twoAreas : I32
    %v9 = add %v7, %v8 : I32
    %v10 = call squareAreas : I32
    %v11 = add %v9, %v10 : I32
    %v12 = call throughPrivate : I32
    %v13 = add %v11, %v12 : I32
    %v14 = call axes : I32
    %v15 = add %v13, %v14 : I32
    %v16 = call namespacedThroughAlias : I32
    %v17 = add %v15, %v16 : I32
