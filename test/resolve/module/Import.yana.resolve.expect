let image$base: () = <none>

fn area1() -> I32 {
  b0:
    %v0 = alloc : Point
    aggregate %local0@Point.x = 3, %local0@Point.y = 4
    %v4 = call Area(Point).area, %v0 : I32
    ret %v4
