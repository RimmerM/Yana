module ResolveTest

fn plain() -> I32 {
  local local0: Amount

bb0:
  %0: I32 = const 21
  %1: Amount = call doubled borrow.shared %0
  write.init borrow.unique (local0) take %1
  %3: I32 = read copy.trivial (local0.cents)
  return take %3
}

fn structured() -> I32 {
  local e: Entry

bb0:
  %0: I32 = const 5
  %1: I32 = const 7
  %2: Entry = call entry borrow.shared %0 borrow.shared %1
  write.init borrow.unique (e) take %2
  %4: I32 = read copy.trivial (e.amount.cents)
  %5: I32 = read copy.trivial (e.label)
  %6: I32 = add inspect %4 inspect %5
  return take %6
}

fn main() -> I32 {
bb0:
  %0: I32 = call plain
  %1: I32 = call structured
  %2: I32 = add inspect %0 inspect %1
  return take %2
}
