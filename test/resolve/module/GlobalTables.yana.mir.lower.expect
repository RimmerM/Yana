@string = [48, 48, 48, 49, 48, 50, 48, 51, 48, 52, 48, 53, 48, 54, 48, 55, 48, 56, 48, 57]
@runBorrowed = [0, 0, 0, 0]
@runFromHeap = [1, 0, 0, 0]
mut @heapFree = [0, 0, 0, 0, 0, 0, 0, 0]

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 16, 8: Ptr
    %decimalPairs = global @decimalPairs: Ptr
    %v_2 = load %decimalPairs, 8: Ptr
    %v_3 = add %decimalPairs, 12: Ptr
    %v_4 = load %v_3, 4: I32
    %v_5 = cast %v_4: I64
    %v_6 = sar %v_5, 63: I64
    %v_7 = shr %v_6, 63: I64
    %v_8 = add %v_5, %v_7: I64
    %v_9 = sar %v_8, 1: I64
    %v_10 = cmp_eq %v_9, 10: I32
    %v_11 = loads @powers, 8: I64
    %v_12 = cmp_eq %v_11, 1: I32
    %v_13 = add %v_10, 2: I32
    %v_14 = select %v_12, %v_13, %v_10: I32
    %v_15 = add @powers, 32: Ptr
    %v_16 = loads %v_15, 8: I64
    %v_17 = cmp_eq %v_16, 10000: I32
    %v_18 = add %v_14, 4: I32
    %v_19 = select %v_17, %v_18, %v_14: I32
    %decimalPairs = global @decimalPairs: Ptr
    %v_20 = load %decimalPairs, 8: Ptr
    %v_21 = add %decimalPairs, 12: Ptr
    %v_22 = load %v_21, 4: I32
    %v_23 = cast %v_22: I64
    %v_24 = load @runBorrowed, 4: I32
    %v_25 = and %v_24, 3: I32
    store %v_1, @string, 8
    %v_26 = add %v_1, 8: Ptr
    %v_27 = load %v_26, 4: I64
    %v_28 = cast %v_25: I64
    %v_29 = shl %v_28, 30: I64
    %v_30 = or 20, %v_29: I64
    store %v_26, %v_30, 4
    %v_31 = add %v_1, 12: Ptr
    store %v_31, 20, 4
    %v_32 = load %v_1, 8: Ptr
    %v_33 = imm 20: I64
    %v_34 = cmp_neq %v_23, %v_33: I32
    je %v_34, b_35, b_36
  }

  join {
    %v_37 = phi [b_38, 1], [b_39, 0], [b_35, 0]: I32
    call_complex String.reclaim, %v_1
    %v_40 = add %v_19, 8: I32
    %v_41 = select %v_37, %v_40, %v_19: I32
    ret %v_41
  }

  b_36 {
    jmp b_42
  }

  b_42 {
    %v_43 = phi [b_36, 0], [b_44, %v_45]: I64
    %v_46 = cmp_ilt %v_43, %v_23: I32
    je %v_46, b_47, b_38
  }

  b_38 {
    jmp join
  }

  b_47 {
    %v_48 = cmp_ge %v_43, %v_23: I32
    je %v_48, b_49, b_50
  }

  b_49 {
