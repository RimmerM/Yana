compareMemory(CodeUnit)<complex>(%left: Ptr, %right: Ptr, %count: I64): I32 {
  b_0 {
    %v_1 = imm 64: I64
    %block = sub %count, %v_1: I64
    %v_2 = imm 16: I64
    %last = sub %count, %v_2: I64
    jmp b_3
  }

  b_3 {
    %v_4 = phi [b_0, 0], [b_5, %v_6]: I64
    %v_7 = cmp_ile %v_4, %block: I32
    je %v_7, b_8, b_9
  }

  b_9 {
    jmp b_10
  }

  b_8 {
    %v_11 = add %left, %v_4: Ptr
    %v_12 = load %v_11, 16: i8x16
    %v_13 = add %right, %v_4: Ptr
    %v_14 = load %v_13, 16: i8x16
    %first = cmp_eq %v_12, %v_14: m8x16
    %v_15 = add %v_11, 16: Ptr
    %v_16 = load %v_15, 16: i8x16
    %v_17 = add %v_13, 16: Ptr
    %v_18 = load %v_17, 16: i8x16
    %second = cmp_eq %v_16, %v_18: m8x16
    %v_19 = add %v_11, 32: Ptr
    %v_20 = load %v_19, 16: i8x16
    %v_21 = add %v_13, 32: Ptr
    %v_22 = load %v_21, 16: i8x16
    %third = cmp_eq %v_20, %v_22: m8x16
    %v_23 = add %v_11, 48: Ptr
    %v_24 = load %v_23, 16: i8x16
    %v_25 = add %v_13, 48: Ptr
    %v_26 = load %v_25, 16: i8x16
    %fourth = cmp_eq %v_24, %v_26: m8x16
    %v_27 = and %first, %second: m8x16
    %v_28 = and %third, %fourth: m8x16
    %v_29 = and %v_27, %v_28: m8x16
    %v_30 = vreduce_and %v_29: I32
    je %v_30, b_5, b_31
  }

  b_31 {
    jmp b_9
  }

  b_5 {
    %v_6 = add %v_4, %v_1: I64
    jmp b_3
  }

  b_10 {
    %v_32 = phi [b_9, %v_4], [b_33, %v_34]: I64
    %v_35 = cmp_ile %v_32, %last: I32
    je %v_35, b_36, b_37
  }

  b_37 {
    %v_38 = cmp_ilt %v_32, %count: I32
    je %v_38, b_39, b_40
  }

  b_36 {
    %v_41 = add %left, %v_32: Ptr
    %v_42 = load %v_41, 16: i8x16
    %v_43 = add %right, %v_32: Ptr
    %v_44 = load %v_43, 16: i8x16
    %same = cmp_eq %v_42, %v_44: m8x16
    %v_45 = vreduce_and %same: I32
    je %v_45, b_33, b_46
  }

  b_46 {
    %v_47 = not %same: m8x16
    %v_48 = vreduce_first %v_47: I32
    %v_49 = sext %v_48: I64
    %differs = add %v_32, %v_49: I64
    %v_50 = add %left, %differs: Ptr
    %v_51 = load %v_50, 1: I32
    %v_52 = add %right, %differs: Ptr
    %v_53 = load %v_52, 1: I32
    %v_54 = cmp_eq %v_51, %v_53: I32
    %v_55 = cmp_gt %v_51, %v_53: I32
    %v_56 = select %v_55, 2, 0: I32
    %v_57 = select %v_54, 1, %v_56: I32
    ret %v_57
  }

  b_33 {
    %v_34 = add %v_32, %v_2: I64
    jmp b_10
  }

  b_39 {
    %v_58 = add %left, %v_32: Ptr
    %v_59 = loadx %v_58, 16: i8x16
    %v_60 = add %right, %v_32: Ptr
    %v_61 = loadx %v_60, 16: i8x16
    %same = cmp_eq %v_59, %v_61: m8x16
    %v_62 = vreduce_and %same: I32
    je %v_62, b_63, b_64
  }

  b_40 {
    jmp b_65
  }

  b_64 {
    %v_66 = not %same: m8x16
    %v_67 = vreduce_first %v_66: I32
    %v_68 = sext %v_67: I64
    %differs = add %v_32, %v_68: I64
    %v_69 = cmp_ilt %differs, %count: I32
    je %v_69, b_70, b_71
  }

  b_63 {
    jmp b_72
  }

  b_70 {
    %v_73 = add %left, %differs: Ptr
    %v_74 = load %v_73, 1: I32
    %v_75 = add %right, %differs: Ptr
    %v_76 = load %v_75, 1: I32
    %v_77 = cmp_eq %v_74, %v_76: I32
    %v_78 = cmp_gt %v_74, %v_76: I32
    %v_79 = select %v_78, 2, 0: I32
    %v_80 = select %v_77, 1, %v_79: I32
    ret %v_80
  }

  b_71 {
    jmp b_72
  }

  b_72 {
    jmp b_65
  }

  b_65 {
    ret 1
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = add @decimalPairs, 12: Ptr
    %v_2 = load %v_1, 4: I32
    %v_3 = sext %v_2: I64
    %v_4 = sar %v_3, 63: I64
    %v_5 = shr %v_4, 63: I64
    %v_6 = add %v_3, %v_5: I64
    %v_7 = sar %v_6, 1: I64
    %v_8 = cmp_eq %v_7, 10: I32
    je %v_8, b_9, b_10
  }

  b_9 {
    jmp b_10
  }

  b_10 {
    %v_11 = phi [b_0, 0], [b_9, 1]: I32
    %v_12 = loads @powers, 8: I64
    %v_13 = cmp_eq %v_12, 1: I32
    je %v_13, b_14, b_15
  }

  b_14 {
    %v_16 = add %v_11, 2: I32
    jmp b_15
  }

  b_15 {
    %v_17 = phi [b_10, %v_11], [b_14, %v_16]: I32
    %v_18 = add @powers, 32: Ptr
    %v_19 = loads %v_18, 8: I64
    %v_20 = cmp_eq %v_19, 10000: I32
    je %v_20, b_21, b_22
  }

  b_21 {
    %v_23 = add %v_17, 4: I32
    jmp b_22
  }

  b_22 {
    %v_24 = phi [b_15, %v_17], [b_21, %v_23]: I32
    %v_25 = alloca 16, 8: Ptr
    copy %v_25, @ResolveTest.literal$1, 16
    %v_26 = add @decimalPairs, 12: Ptr
    %v_27 = load %v_26, 4: I32
    %v_28 = sext %v_27: I64
    %v_29 = cmp_neq %v_28, 20: I32
    je %v_29, b_30, b_31
  }

  b_31 {
    %v_32 = load @decimalPairs, 8: Ptr
    %v_33 = load %v_25, 8: Ptr
    %v_34 = call_complex compareMemory(CodeUnit), %v_32, %v_33, %v_28: I32
    %v_35 = cmp_eq %v_34, 1: I32
    je %v_35, b_36, b_30
  }

  b_36 {
    %v_37 = add %v_24, 8: I32
    jmp b_30
  }

  b_30 {
    %v_38 = phi [b_22, %v_24], [b_31, %v_24], [b_36, %v_37]: I32
