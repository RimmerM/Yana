main<complex>(): I32 {
  b_0 {
    %v_1 = add @decimalPairs, 12: Ptr
    %v_2 = load %v_1, 4: I32
    %v_3 = sext %v_2: I64
    %v_4 = sar %v_3, 63: I64
    %v_5 = shr %v_4, 63: I64
