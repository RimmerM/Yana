    %v_53 = load %v_52, 1: I32
    %v_54 = add %right, %differs: Ptr
    %v_55 = load %v_54, 1: I32
    %v_56 = cmp_eq %v_53, %v_55: I32
    %v_57 = cmp_gt %v_53, %v_55: I32
    %v_58 = select %v_57, 2, 0: I32
    %v_59 = select %v_56, 1, %v_58: I32
