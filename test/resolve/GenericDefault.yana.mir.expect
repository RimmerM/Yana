module ResolveTest

data Buffer(a, n) {items: [a *n]} drop derived reclaim derived

data Tagged(n) {value: I32}

data Buffer(I32, 4) {items: [I32 *4]} of Buffer

data Buffer(I32, 8) {items: [I32 *8]} of Buffer

data Tagged(4) {value: I32} of Tagged

data Tagged(8) {value: I32} of Tagged

class Counted(a): counted

instance Counted(I32): I32.counted

instance Counted(I64): I64.counted

fn counted(x: a [shared call]) -> I32 = <no body>

fn takesNatural(b: Buffer(I32, 4) [shared call]) -> I32 {
bb0:
  %0: Buffer(I32, 4) = read copy.trivial (b)
  %1: I32 = call countOf(4) borrow.shared %0
  return take %1
}

fn takesHalf(b: Buffer(I32, 4) [shared call]) -> I32 {
bb0:
  %0: Buffer(I32, 4) = read copy.trivial (b)
  %1: I32 = call countOf(4) borrow.shared %0
  return take %1
}

fn takesFull(b: Buffer(I32, 4) [shared call]) -> I32 {
bb0:
  %0: Buffer(I32, 4) = read copy.trivial (b)
  %1: I32 = call countOf(4) borrow.shared %0
  return take %1
}

fn takesEight(b: Buffer(I32, 8) [shared call]) -> I32 {
bb0:
  %0: Buffer(I32, 8) = read copy.trivial (b)
  %1: I32 = call countOf(8) borrow.shared %0
  return take %1
}

fn countOf(b: Buffer(I32, n) [shared call]) -> I32 {
  form specialized
  slot #0 const n
bb0:
  %0: I32 = gen.value n
  return take %0
}

fn tagged(value: I32 [shared call]) -> Tagged(n) {
  form specialized
  slot #0 const n
bb0:
  %0: I32 = read copy.trivial (value)
  %1: Tagged(n) = aggregate.Tagged take %0
  return take %1
}

fn defaulted() -> I32 {
bb0:
  %0: I32 = const 1
  %1: Tagged(4) = call tagged(4) borrow.shared %0
  %2: I32 = call tagOf'2(4) borrow.shared %1
  return take %2
}

fn ascribed() -> I32 {
bb0:
  %0: I32 = const 1
  %1: Tagged(8) = call tagged(8) borrow.shared %0
  %2: I32 = call tagOf'2(8) borrow.shared %1
  return take %2
}

fn tagOf'2(t: Tagged(n) [shared call]) -> I32 {
  form specialized
  slot #0 const n
bb0:
  %0: I32 = gen.value n
  return take %0
}

fn I32.counted(x: I32 [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (x)
  return take %0
}

fn I64.counted(x: I64 [shared call]) -> I32 {
bb0:
  %0: I64 = read copy.trivial (x)
  %1: I32 = convert inspect %0
  return take %1
}

fn main() -> I32 {
  local b: Buffer(I32, 4)
  local wide: Buffer(I32, 8)

bb0:
  %0: I32 = const 1
  %1: I32 = const 2
  %2: I32 = const 3
  %3: I32 = const 4
  %4: [I32 *4] = aggregate.0 take %0 take %1 take %2 take %3
  %5: Buffer(I32, 4) = aggregate.Buffer take %4
  write.init borrow.unique (b) take %5
  %7: I32 = const 1
  %8: I32 = const 2
  %9: I32 = const 3
  %10: I32 = const 4
  %11: I32 = const 5
  %12: I32 = const 6
  %13: I32 = const 7
  %14: I32 = const 8
  %15: [I32 *8] = aggregate.0 take %7 take %8 take %9 take %10 take %11 take %12 take %13 take %14
  %16: Buffer(I32, 8) = aggregate.Buffer take %15
  write.init borrow.unique (wide) take %16
  %18: Buffer(I32, 4) = read copy.trivial (b)
  %19: I32 = call takesNatural borrow.shared %18
  %20: Buffer(I32, 4) = read copy.trivial (b)
  %21: I32 = call takesHalf borrow.shared %20
  %22: I32 = add inspect %19 inspect %21
  %23: Buffer(I32, 4) = read copy.trivial (b)
  %24: I32 = call takesFull borrow.shared %23
  %25: I32 = add inspect %22 inspect %24
  %26: Buffer(I32, 8) = read copy.trivial (wide)
  %27: I32 = call takesEight borrow.shared %26
  %28: I32 = add inspect %25 inspect %27
  %29: I32 = call defaulted
  %30: I32 = add inspect %28 inspect %29
  %31: I32 = call ascribed
  %32: I32 = add inspect %30 inspect %31
  %33: I32 = const 1
  %34: I32 = call counted(I32) borrow.shared %33
  %35: I32 = add inspect %32 inspect %34
  return take %35
}

fn countOf(4)(b: Buffer(I32, 4) [shared call]) -> I32 = <countOf at 4>

fn countOf(8)(b: Buffer(I32, 8) [shared call]) -> I32 = <countOf at 8>

fn tagged(4)(value: I32 [shared call]) -> Tagged(4) = <tagged at 4>

fn tagOf'2(4)(t: Tagged(4) [shared call]) -> I32 = <tagOf at 4>

fn tagged(8)(value: I32 [shared call]) -> Tagged(8) = <tagged at 8>

fn tagOf'2(8)(t: Tagged(8) [shared call]) -> I32 = <tagOf at 8>

entry main
