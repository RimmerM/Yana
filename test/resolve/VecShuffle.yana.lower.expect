@image$base = []
mut @seed = [2, 0, 0, 0]

oneSource<complex>(): I32 {
  b_0 {
    %v_1 = vsplat 0: i32x4
    %v_2 = vwithlane %v_1, 1, 1: i32x4
    %v_3 = vwithlane %v_2, 2, 2: i32x4
    %v = vwithlane %v_3, 3, 3: i32x4
    %backwards = vshuffle %v, %v, 3, 2, 1, 0: i32x4
    %v_4 = vlane %backwards, 0: I32
    %v_5 = cmp_neq %v_4, 3: I32
    je %v_5, b_6, b_7
  }

  b_7 {
    %broadcast = vshuffle %v, %v, 2, 2, 2, 2: i32x4
    %v_8 = vlane %broadcast, 0: I32
    %v_9 = cmp_neq %v_8, 2: I32
    je %v_9, b_10, b_11
  }

  b_11 {
    %v_12 = vlane %broadcast, 3: I32
    %v_13 = cmp_neq %v_12, 2: I32
    je %v_13, b_14, b_15
  }

  b_15 {
    %doubled = vshuffle %v, %v, 2, 3, 2, 3: i32x4
    %v_16 = vlane %doubled, 0: I32
    %v_17 = cmp_neq %v_16, 2: I32
    je %v_17, b_18, b_19
  }

  b_19 {
    %v_20 = vlane %doubled, 2: I32
    %v_21 = cmp_neq %v_20, 2: I32
    %v_22 = vlane %doubled, 3: I32
    %v_23 = cmp_neq %v_22, 3: I32
    %v_24 = select %v_23, 18446744073709551608, 0: I32
    %v_25 = select %v_21, 18446744073709551609, %v_24: I32
    ret %v_25
  }

  b_18 {
    ret 18446744073709551610
  }

  b_14 {
    ret 18446744073709551611
  }

  b_10 {
    ret 18446744073709551612
  }

  b_6 {
    ret 18446744073709551613
  }
}

twoSources<complex>(): I32 {
  b_0 {
    %v_1 = vsplat 0: i32x4
    %v_2 = vwithlane %v_1, 1, 1: i32x4
    %v_3 = vwithlane %v_2, 2, 2: i32x4
    %low = vwithlane %v_3, 3, 3: i32x4
    %v_4 = vsplat 10: i32x4
    %high = add %v_4, %low: i32x4
    %mixed = vshuffle %low, %high, 1, 0, 7, 6: i32x4
    %v_5 = vlane %mixed, 0: I32
    %v_6 = cmp_neq %v_5, 1: I32
    je %v_6, b_7, b_8
  }

  b_8 {
    %v_9 = vlane %mixed, 1: I32
    %v_10 = cmp_neq %v_9, 0: I32
    je %v_10, b_11, b_12
  }

  b_12 {
    %v_13 = vlane %mixed, 2: I32
    %v_14 = cmp_neq %v_13, 13: I32
    je %v_14, b_15, b_16
  }

  b_16 {
    %v_17 = vlane %mixed, 3: I32
    %v_18 = cmp_neq %v_17, 12: I32
    %window = vshuffle %high, %low, 5, 6, 7, 0: i32x4
    %v_19 = vlane %window, 3: I32
    %v_20 = cmp_neq %v_19, 10: I32
    %v_21 = select %v_20, 18446744073709551609, 0: I32
    %v_22 = select %v_18, 18446744073709551612, %v_21: I32
    ret %v_22
  }

  b_15 {
    ret 18446744073709551613
  }

  b_11 {
    ret 18446744073709551614
  }

  b_7 {
    ret 18446744073709551615
  }
}

