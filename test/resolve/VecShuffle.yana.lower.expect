    %v_15 = vwithlane %v_14, 14, 14: i8x16
    %v = vwithlane %v_15, 15, 15: i8x16
    %swapped = vshuffle %v, %v, 3, 2, 1, 0, 7, 6, 5, 4, 11, 10, 9, 8, 15, 14, 13, 12: i8x16
    %v_16 = vlane %swapped, 0: I32
    %v_17 = cmp_neq %v_16, 3: I32
    je %v_17, b_18, b_19
  }

