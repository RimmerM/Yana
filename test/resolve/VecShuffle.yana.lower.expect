runtime<complex>(%v: i32x4): I32 {
  b_0 {
    %backwards = vshuffle %v, %v, 3, 2, 1, 0: i32x4
    %mixed = vshuffle %v, %backwards, 0, 1, 6, 7: i32x4
    %v_1 = vlane %backwards, 0: I32
    %v_2 = vlane %v, 3: I32
    %v_3 = cmp_neq %v_1, %v_2: I32
    je %v_3, b_4, b_5
  }

  b_4 {
    ret 18446744073709551615
  }

  b_5 {
    %v_6 = vlane %mixed, 0: I32
    %v_7 = vlane %v, 0: I32
    %v_8 = cmp_neq %v_6, %v_7: I32
    je %v_8, b_9, b_10
  }

  b_9 {
    ret 18446744073709551614
  }

  b_10 {
    %v_11 = vlane %mixed, 2: I32
    %v_12 = vlane %v, 1: I32
    %v_13 = cmp_neq %v_11, %v_12: I32
    je %v_13, b_14, b_15
  }

  b_14 {
    ret 18446744073709551613
  }

  b_15 {
    %v_16 = vlane %mixed, 3: I32
    %v_17 = cmp_neq %v_16, %v_7: I32
