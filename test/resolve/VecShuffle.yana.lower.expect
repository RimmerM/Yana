main<complex>(): I32 {
  b_0 {
    %v_1 = vsplat 0: i32x4
    %v_2 = vwithlane %v_1, 1, 1: i32x4
    %v_3 = vwithlane %v_2, 2, 2: i32x4
    %v_4 = vwithlane %v_3, 3, 3: i32x4
    %v_5 = loads @seed, 4: I32
    %v_6 = vsplat %v_5: i32x4
    %v = add %v_4, %v_6: i32x4
    %v_7 = call_complex oneSource: I32
    %v_8 = cmp_neq %v_7, 0: I32
    je %v_8, b_9, b_10
  }

  b_9 {
    %v_11 = call_complex oneSource: I32
