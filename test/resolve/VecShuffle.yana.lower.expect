    %v_2 = vwithlane %v_1, 1, 1: i8x16
    %v_3 = vwithlane %v_2, 2, 2: i8x16
    %v_4 = vwithlane %v_3, 3, 3: i8x16
    %v_5 = vwithlane %v_4, 4, 4: i8x16
    %v_6 = vwithlane %v_5, 5, 5: i8x16
    %v_7 = vwithlane %v_6, 6, 6: i8x16
    %v_8 = vwithlane %v_7, 7, 7: i8x16
    %v_9 = vwithlane %v_8, 8, 8: i8x16
    %v_10 = vwithlane %v_9, 9, 9: i8x16
