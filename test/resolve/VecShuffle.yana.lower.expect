}

main<complex>(): I32 {
  b_0 {
    %v_1 = vsplat 0: i32x4
    %v_2 = vwithlane %v_1, 1, 1: i32x4
    %v_3 = vwithlane %v_2, 2, 2: i32x4
    %v_4 = vwithlane %v_3, 3, 3: i32x4
    %v_5 = loads @seed, 4: I32
    %v_6 = vsplat %v_5: i32x4
    %v = add %v_4, %v_6: i32x4
    %v_7 = call_complex oneSource: I32
    %v_8 = cmp_neq %v_7, 0: I32
    je %v_8, b_9, b_10
  }

  b_9 {
    %v_11 = call_complex oneSource: I32
    ret %v_11
  }

  b_10 {
    %v_12 = call_complex twoSources: I32
    %v_13 = cmp_neq %v_12, 0: I32
    je %v_13, b_14, b_15
  }

  b_14 {
    %v_16 = call_complex twoSources: I32
    %v_17 = imul %v_16, 10: I32
    ret %v_17
  }

  b_15 {
    %v_18 = call_complex byteLane: I32
    %v_19 = cmp_neq %v_18, 0: I32
    je %v_19, b_20, b_21
  }

  b_20 {
    %v_22 = call_complex byteLane: I32
    %v_23 = imul %v_22, 100: I32
    ret %v_23
  }

  b_21 {
    %v_24 = call_complex floatLane: I32
    %v_25 = cmp_neq %v_24, 0: I32
    je %v_25, b_26, b_27
  }

  b_26 {
    %v_28 = call_complex floatLane: I32
    %v_29 = imul %v_28, 1000: I32
    ret %v_29
  }

  b_27 {
    %v_30 = call_complex runtime, %v: I32
    %v_31 = cmp_neq %v_30, 0: I32
    je %v_31, b_32, b_33
  }

  b_32 {
    %v_34 = call_complex runtime, %v: I32
    %v_35 = imul %v_34, 10000: I32
    ret %v_35
  }

  b_33 {
    ret 314
  }
}

