runtime<complex>(%v: i32x4): I32 {
  b_0 {
    %backwards = vshuffle %v, %v, 3, 2, 1, 0: i32x4
    %mixed = vshuffle %v, %backwards, 0, 1, 6, 7: i32x4
    %v_1 = vlane %backwards, 0: I32
