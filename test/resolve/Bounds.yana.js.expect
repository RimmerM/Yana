"use strict";
// Collections
function checkCondition(failed) {
  if (failed) {
    throw "yana: a runtime check failed";
  }
  return;
}

function remove_Int(self, index) {
  if (index >>> 0 >= self.length >>> 0) {
    return null;
  } else {
    var v16 = self[index];
    self.splice(index, 1);
    return v16;
  }
}

// ResolveTest
function ownerEdges() {
  var v4 = [10, 20, 30, 40];
  var v20 = remove_Int(v4, 3);
  checkCondition(0 >= v4.length >>> 0);
  var v32 = v4[0];
  checkCondition(2 >= v4.length >>> 0);
  return v32 + v4[2] | 0;
}

function sliceEdges() {
  var v7 = [1, 2, 3, 4, 5, 6];
  return v7[2] + v7[4] | 0;
}

function genericEdges() {
  return 16;
}

function oneElement() {
  return 42;
}

function main() {
  var v18 = [10, 20, 30, 40];
  var v32 = remove_Int(v18, 3);
  checkCondition(0 >= v18.length >>> 0);
  var v41 = v18[0];
  checkCondition(2 >= v18.length >>> 0);
  return (Math.imul(v41 + v18[2] | 0, 1000) + Math.imul(sliceEdges(), 100) | 0) + 202 | 0;
}
