"use strict";
// Collections
function checkCondition(failed) {
  if (failed) {
    throw "yana: a runtime check failed";
  }
  return;
}

function remove_Int(self, index) {
  if (index >>> 0 >= self.length >>> 0) {
    return null;
  } else {
    var v16 = self[index];
    self.splice(index, 1);
    return v16;
  }
}

// ResolveTest
function ownerEdges() {
  var v4 = [10, 20, 30];
  v4[v4.length] = 40;
  var v22 = remove_Int(v4, 3);
  checkCondition(0 >= v4.length >>> 0);
  var v34 = v4[0];
  checkCondition(2 >= v4.length >>> 0);
  return v34 + v4[2] | 0;
}

function sliceEdges() {
  var v7 = [1, 2, 3, 4, 5, 6];
  return v7[2] + v7[4] | 0;
}

function genericEdges() {
  return 16;
}

function oneElement() {
  return 42;
}

function main() {
  return (Math.imul(ownerEdges(), 1000) + Math.imul(sliceEdges(), 100) | 0) + 202 | 0;
}
