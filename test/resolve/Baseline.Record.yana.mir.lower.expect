
point<complex>(%v_0: Ptr, %x: I32, %y: I32) {
  b_1 {
    %v_2 = alloca 4, 4: Ptr
    %v_3 = alloca 4, 4: Ptr
    store %v_2, %x, 4
    store %v_3, %y, 4
    %v_4 = loads %v_2, 4: I32
    %v_5 = loads %v_3, 4: I32
    %v_6 = alloca 8, 4: Ptr
    store %v_6, %v_4, 4
    %v_7 = add %v_6, 4: Ptr
    store %v_7, %v_5, 4
    copy %v_0, %v_6, 8
    ret 
  }
}

manhattan<complex>(%p: Ptr): I32 {
  b_0 {
    %v_1 = loads %p, 4: I32
    %v_2 = add %p, 4: Ptr
    %v_3 = loads %v_2, 4: I32
    %v_4 = add %v_1, %v_3: I32
    ret %v_4
  }
}

width<complex>(%l: Ptr): I32 {
  b_0 {
    %v_1 = add %l, 8: Ptr
    %v_2 = loads %v_1, 4: I32
    %v_3 = loads %l, 4: I32
    %v_4 = sub %v_2, %v_3: I32
    ret %v_4
  }
}

shifted<complex>(%dy: I32): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    %v_2 = alloca 8, 4: Ptr
    store %v_1, %dy, 4
    %v_3 = alloca 8, 4: Ptr
    store %v_3, 3, 4
    %v_4 = add %v_3, 4: Ptr
    store %v_4, 4, 4
    copy %v_2, %v_3, 8
    %v_5 = add %v_2, 4: Ptr
    %v_6 = loads %v_5, 4: I32
    %v_7 = loads %v_1, 4: I32
    %v_8 = add %v_6, %v_7: I32
    %v_9 = add %v_2, 4: Ptr
    store %v_9, %v_8, 4
    %v_10 = alloca 8, 4: Ptr
    copy %v_10, %v_2, 8
    %v_11 = call_complex manhattan, %v_10: I32
    ret %v_11
  }
}

copied<complex>(): I32 {
  b_0 {
    %v_1 = alloca 8, 4: Ptr
    %v_2 = alloca 8, 4: Ptr
    %v_3 = alloca 8, 4: Ptr
    call_complex point, %v_3, 10, 20
    copy %v_1, %v_3, 8
    %v_4 = alloca 8, 4: Ptr
    copy %v_4, %v_1, 8
    copy %v_2, %v_4, 8
    %v_5 = alloca 8, 4: Ptr
    copy %v_5, %v_1, 8
    %v_6 = call_complex manhattan, %v_5: I32
    %v_7 = alloca 8, 4: Ptr
    copy %v_7, %v_2, 8
    %v_8 = call_complex manhattan, %v_7: I32
    %v_9 = add %v_6, %v_8: I32
    ret %v_9
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 16, 4: Ptr
    %v_2 = alloca 8, 4: Ptr
    call_complex point, %v_2, 1, 2
    %v_3 = alloca 8, 4: Ptr
    call_complex point, %v_3, 8, 5
    %v_4 = alloca 16, 4: Ptr
    copy %v_4, %v_2, 8
    %v_5 = add %v_4, 8: Ptr
    copy %v_5, %v_3, 8
    copy %v_1, %v_4, 16
    %v_6 = alloca 16, 4: Ptr
    copy %v_6, %v_1, 16
    %v_7 = call_complex width, %v_6: I32
    %v_8 = call_complex shifted, 5: I32
    %v_9 = add %v_7, %v_8: I32
    %v_10 = call_complex copied: I32
    %v_11 = add %v_9, %v_10: I32
    ret %v_11
  }
}

