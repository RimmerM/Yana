bb26:
  %116: Vec(I32) = read copy.trivial (mixed)
  %117: Vec(I32) = read copy.trivial (base)
  %118: Mask(I32) = gt inspect %116 inspect %117
  write.init borrow.unique (above) take %118
  %120: Mask(I32) = read copy.trivial (above)
  %121: I32 = vec.reduce add inspect %120
  %122: I32 = const 1
  %123: Bool = ne inspect %121 inspect %122
