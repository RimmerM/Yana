bb35:
  %141: Mask(I32) = read copy.trivial (above)
  %142: I32 = const 7
  %143: Vec(I32) = vec.splat inspect %142
  %144: I32 = const 2
  %145: Vec(I32) = vec.splat inspect %144
  %146: Vec(I32) = select inspect %141 inspect %143 inspect %145
  write.init borrow.unique (picked) take %146
  %148: Vec(I32) = read copy.trivial (picked)
  %149: I32 = const 0
  %150: I32 = vec.lane #0 inspect %148
  %151: I32 = const 7
  %152: Bool = ne inspect %150 inspect %151
  branch inspect %152 -> bb39 -> bb37

bb36:
  %138: I32 = const -11
