bb16:
  jump -> bb17

bb17:
  %80: Vec(I32) = read copy.trivial (total)
  %81: I32 = const 1
  %82: I32 = vec.lane #1 inspect %80
  %83: I32 = const 15
  %84: Bool = ne inspect %82 inspect %83
  branch inspect %84 -> bb21 -> bb19

bb18:
  %77: I32 = const -5
  return take %77

bb19:
  jump -> bb20

bb20:
  %89: Vec(I32) = read copy.trivial (total)
  %90: I32 = vec.reduce add inspect %89
  %91: I32 = read copy.trivial (lanes)
  %92: I32 = const 15
  %93: I32 = mul inspect %91 inspect %92
  %94: Bool = ne inspect %90 inspect %93
  branch inspect %94 -> bb24 -> bb22

bb21:
  %86: I32 = const -6
  return take %86

bb22:
  jump -> bb23

bb23:
  %99: Vec(I32) = read copy.trivial (base)
  %100: Vec(I32) = read copy.trivial (twice)
  %101: Vec(I32) = read copy.trivial (six)
  %102: Vec(I32) = read copy.trivial (total)
  %103: I32 = call combined borrow.shared %99 borrow.shared %100 borrow.shared %101 borrow.shared %102
  %104: I32 = const 3
  %105: I32 = const 6
  %106: I32 = add inspect %104 inspect %105
  %107: I32 = const 6
  %108: I32 = add inspect %106 inspect %107
  %109: I32 = const 15
  %110: I32 = add inspect %108 inspect %109
  %111: Bool = ne inspect %103 inspect %110
  branch inspect %111 -> bb27 -> bb25

bb24:
  %96: I32 = const -7
  return take %96

bb25:
