module ResolveTest

let & seed: I32 = 3

fn doubled(v: Vec(I32) [shared call]) -> Vec(I32) {
bb0:
  %0: Vec(I32) = read copy.trivial (v)
  %1: Vec(I32) = read copy.trivial (v)
  %2: Vec(I32) = add inspect %0 inspect %1
  return take %2
}

fn scaled(v: Vec(I32) [shared call], by: I32 [shared call]) -> Vec(I32) {
bb0:
  %0: Vec(I32) = read copy.trivial (v)
  %1: I32 = read copy.trivial (by)
  %2: Vec(I32) = vec.splat inspect %1
  %3: Vec(I32) = mul inspect %0 inspect %2
  return take %3
}

fn combined(a: Vec(I32) [shared call], b: Vec(I32) [shared call], c: Vec(I32) [shared call], d: Vec(I32) [shared call]) -> I32 {
bb0:
  %0: Vec(I32) = read copy.trivial (a)
  %1: Vec(I32) = read copy.trivial (b)
  %2: Vec(I32) = add inspect %0 inspect %1
  %3: I32 = const 0
  %4: I32 = vec.lane #0 inspect %2
  %5: Vec(I32) = read copy.trivial (c)
  %6: Vec(I32) = read copy.trivial (d)
  %7: Vec(I32) = add inspect %5 inspect %6
  %8: I32 = const 0
  %9: I32 = vec.lane #0 inspect %7
  %10: I32 = add inspect %4 inspect %9
  return take %10
}

fn main() -> I32 {
  local base: Vec(I32)
  local twice: Vec(I32)
  local six: Vec(I32)
  local lanes: I32
  local mixed: Vec(I32)
  local & total: Vec(I32)
  local & i: I32
