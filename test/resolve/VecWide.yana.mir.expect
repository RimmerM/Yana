bb37:
  jump -> bb38

bb38:
  %157: Vec(I32) = read copy.trivial (picked)
  %158: I32 = const 1
  %159: I32 = vec.lane #1 inspect %157
  %160: I32 = const 2
  %161: Bool = ne inspect %159 inspect %160
  branch inspect %161 -> bb42 -> bb40

bb39:
  %154: I32 = const -12
  return take %154

bb40:
  jump -> bb41

bb41:
  %166: Vec(I32) = read copy.trivial (base)
  %167: I32 = const 1
  %168: I32 = const 10
  %169: Vec(I32) = vec.withlane #1 inspect %166 inspect %168
  %170: Vec(I32) = read copy.trivial (base)
  %171: Mask(I32) = gt inspect %169 inspect %170
  %172: I32 = vec.reduce firstset inspect %171
  %173: I32 = const 1
  %174: Bool = ne inspect %172 inspect %173
  branch inspect %174 -> bb45 -> bb43

bb42:
  %163: I32 = const -13
  return take %163

bb43:
  jump -> bb44

bb44:
  %179: Vec(I32) = read copy.trivial (mixed)
  %180: Vec(I32) = read copy.trivial (base)
  %181: Mask(I32) = lt inspect %179 inspect %180
  %182: I32 = vec.reduce firstset inspect %181
  %183: I32 = read copy.trivial (lanes)
  %184: Bool = ne inspect %182 inspect %183
  branch inspect %184 -> bb48 -> bb46

bb45:
  %176: I32 = const -14
  return take %176

bb46:
  jump -> bb47

bb47:
  %189: Vec(I32) = read copy.trivial (mixed)
  %190: Vec(I32) = read copy.trivial (base)
  %191: Mask(I32) = ge inspect %189 inspect %190
  %192: I32 = vec.reduce firstset inspect %191
  %193: I32 = const 0
  %194: Bool = ne inspect %192 inspect %193
  branch inspect %194 -> bb51 -> bb49

bb48:
  %186: I32 = const -15
  return take %186

bb49:
  jump -> bb50

bb50:
  %199: Vec(I32) = read copy.trivial (twice)
  %200: I32 = const 1
  %201: I32 = vec.lane #1 inspect %199
  %202: I32 = const 100
  %203: I32 = mul inspect %201 inspect %202
  %204: Vec(I32) = read copy.trivial (six)
  %205: I32 = const 0
  %206: I32 = vec.lane #0 inspect %204
  %207: I32 = add inspect %203 inspect %206
  %208: Vec(I32) = read copy.trivial (mixed)
  %209: I32 = const 0
  %210: I32 = vec.lane #0 inspect %208
  %211: I32 = add inspect %207 inspect %210
  return take %211

bb51:
  %196: I32 = const -16
