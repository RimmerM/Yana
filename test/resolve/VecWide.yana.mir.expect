bb5:
  %28: I32 = const 1
  %29: Vec(I32) = vec.splat inspect %28
  %30: I32 = vec.reduce add inspect %29
  write.init borrow.unique (lanes) take %30
  %32: Vec(I32) = read copy.trivial (base)
  %33: I32 = const 0
  %34: I32 = const 10
  %35: Vec(I32) = vec.withlane #0 inspect %32 inspect %34
  write.init borrow.unique (mixed) take %35
  %37: Vec(I32) = read copy.trivial (mixed)
  %38: I32 = vec.reduce max inspect %37
  %39: I32 = const 10
  %40: Bool = ne inspect %38 inspect %39
  branch inspect %40 -> bb9 -> bb7

bb6:
  %25: I32 = const -2
  return take %25

bb7:
  jump -> bb8

bb8:
  %45: Vec(I32) = read copy.trivial (mixed)
  %46: I32 = vec.reduce min inspect %45
  %47: I32 = const 3
  %48: Bool = ne inspect %46 inspect %47
