target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

@dynamic = global [4 x i8] zeroinitializer, align 8
@counter = global [4 x i8] zeroinitializer, align 8
@"string'143" = constant [2 x i8] c"ab", align 8

define fastcc i32 @countdown(i32 %k) #0 {
  br label %1

1:                                                ; preds = %5, %0
  %2 = phi i32 [ %k, %0 ], [ %6, %5 ]
  %3 = icmp sle i32 %2, 0
  %4 = zext i1 %3 to i32
  br i1 %3, label %7, label %5

5:                                                ; preds = %1
  %6 = sub i32 %2, 1
  br label %1

7:                                                ; preds = %1
  %8 = load i32, ptr @dynamic, align 1
  ret i32 %8
}

define fastcc i32 @"main$"() #0 {
  br label %1

1:                                                ; preds = %0
  store i32 7, ptr @dynamic, align 1
  %2 = load i32, ptr @counter, align 1
  %3 = add i32 %2, 20
  store i32 %3, ptr @counter, align 1
  %4 = call fastcc i32 @countdown(i32 3)
  %5 = icmp eq i32 %4, 7
  %6 = zext i1 %5 to i32
  %7 = load i32, ptr @counter, align 1
  %8 = icmp eq i32 %7, 20
  %9 = zext i1 %8 to i32
  %10 = add i32 %6, 2
  %11 = select i1 %8, i32 %10, i32 %6
  %12 = add i32 %11, 12
  ret i32 %12
}

attributes #0 = { "probe-stack"="inline-asm" }
