module ResolveTest

data Pair {left: I64, right: I64}

fn sum'2(p: Pair) -> I64 {
bb0:
  %0: I64 = read copy.trivial (p.left)
  %1: I64 = read copy.trivial (p.right)
  %2: I64 = add inspect %0 inspect %1
  return take %2
}

fn plain() -> I64 {
  local & n: I64 heap

bb0:
  %0: I64 = const 0
  write.init borrow.unique (n) take %0
  %2: I64 = read copy.trivial (n)
  %3: I64 = const 5
  %4: I64 = add inspect %2 inspect %3
  write.assign borrow.unique (n) take %4
  %6: I64 = read copy.trivial (n)
  return take %6
}

fn handedOver() -> I64 {
  local p: Pair heap

bb0:
  %0: I64 = const 3
  %1: I64 = const 4
  %2: Pair = aggregate.Pair take %0 take %1
  write.init borrow.unique (p) take %2
  %4: Pair = read copy.trivial (p)
  %5: I64 = call sum'2 take %4
  return take %5
}

fn branching(away: Bool [shared call]) -> I64 {
  local p: Pair heap

bb0:
  %0: I64 = const 1
  %1: I64 = const 2
  %2: Pair = aggregate.Pair take %0 take %1
  write.init borrow.unique (p) take %2
  %4: Bool = read copy.trivial (away)
  branch inspect %4 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %10: I64 = read copy.trivial (p.left)
  %11: I64 = read copy.trivial (p.right)
  %12: I64 = add inspect %10 inspect %11
  return take %12

bb3:
  %6: Pair = read copy.trivial (p)
  %7: I64 = call sum'2 take %6
  return take %7
}

fn main() -> I32 {
  local mark: Size
  local & i: I32
  local a: I64
  local b: I64
  local c: I64

bb0:
  %0: I64 = call plain
  %1: I64 = const 5
  %2: Bool = ne inspect %0 inspect %1
  branch inspect %2 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %7: I64 = call handedOver
  %8: I64 = const 7
  %9: Bool = ne inspect %7 inspect %8
  branch inspect %9 -> bb6 -> bb4

bb3:
  %4: I32 = const -1
  return take %4

bb4:
  jump -> bb5

bb5:
  %14: Bool = const True
  %15: I64 = call branching borrow.shared %14
  %16: I64 = const 3
  %17: Bool = ne inspect %15 inspect %16
  branch inspect %17 -> bb9 -> bb7

bb6:
  %11: I32 = const -2
  return take %11

bb7:
  jump -> bb8

bb8:
  %22: Bool = const False
  %23: I64 = call branching borrow.shared %22
  %24: I64 = const 3
  %25: Bool = ne inspect %23 inspect %24
  branch inspect %25 -> bb12 -> bb10

bb9:
  %19: I32 = const -3
  return take %19

bb10:
  jump -> bb11

bb11:
  %30: %U8 = read copy.trivial (global heapNext)
  %31: Size = bitcast inspect %30
  write.init borrow.unique (mark) take %31
  %33: I32 = const 0
  write.init borrow.unique (i) take %33
  jump -> bb13

bb12:
  %27: I32 = const -4
  return take %27

bb13:
  %36: I32 = read copy.trivial (i)
  %37: I32 = const 100
  %38: Bool = lt inspect %36 inspect %37
  branch inspect %38 -> bb15 -> bb14

bb14:
  %56: %U8 = read copy.trivial (global heapNext)
  %57: Size = bitcast inspect %56
  %58: Size = read copy.trivial (mark)
  %59: Bool = ne inspect %57 inspect %58
  branch inspect %59 -> bb18 -> bb16

bb15:
  %40: I64 = call plain
  write.init borrow.unique (a) take %40
  %42: I64 = call handedOver
  write.init borrow.unique (b) take %42
  %44: I32 = read copy.trivial (i)
  %45: I32 = const 2
  %46: I32 = rem inspect %44 inspect %45
  %47: I32 = const 0
  %48: Bool = eq inspect %46 inspect %47
  %49: I64 = call branching borrow.shared %48
  write.init borrow.unique (c) take %49
  %51: I32 = read copy.trivial (i)
  %52: I32 = const 1
  %53: I32 = add inspect %51 inspect %52
  write.assign borrow.unique (i) take %53
  jump -> bb13

bb16:
  jump -> bb17

bb17:
  %64: I32 = const 1
  return take %64

bb18:
  %61: I32 = const -5
  return take %61
}

entry main
