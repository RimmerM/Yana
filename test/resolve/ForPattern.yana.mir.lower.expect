    %v_17 = phi [b_12, %v_18], [b_5, %v_8]: I32
    %v_19 = add %v_16, 10: I32
    %v_20 = add %v_17, %v_16: I32
    %v_18 = add %v_20, %v_19: I32
    %v_14 = add %v_16, 1: I32
