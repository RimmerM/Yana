    %v_47 = sub %v_26, %v_40: f64x2
    %signed = select %odd, %v_47, %v_40: f64x2
    %v_48 = cmp_lt %base, %v_26: m64x2
    %v_49 = call_complex zeroLike(Vec(Double), Mask(Double)), %base: f64x2
    %v_50 = vsplat 9218868437227405312: i64x2
    %v_51 = bitcast %v_50: f64x2
    %v_52 = mul %v_49, %v_51: f64x2
    %v_53 = select %whole, %signed, %v_52: f64x2
    %answer = select %v_48, %v_53, %v_40: f64x2
    %v_54 = vsplat 0: f64x2
    %v_55 = cmp_lt %exponent, %v_54: m64x2
    %v_56 = call_complex zeroLike(Vec(Double), Mask(Double)), %base: f64x2
    %atZero = select %v_55, %v_51, %v_56: f64x2
    %v_57 = vsplat 0: f64x2
    %v_58 = cmp_eq %exponent, %v_57: m64x2
    %v_59 = cmp_eq %base, %v_57: m64x2
    %v_60 = select %v_59, %atZero, %answer: f64x2
    %v_61 = vsplat 1: f64x2
    %v_62 = select %v_58, %v_61, %v_60: f64x2
    ret %v_62
  }
}

