    %v_2 = sub 0, %difference: Float
    %size = select %v_1, %v_2, %difference: Float
    %v_3 = cmp_lt %want, 0: Int
    %v_4 = sub 0, %want: Float
    %scale = select %v_3, %v_4, %want: Float
    %v_5 = cmp_gt %scale, 1: Int
    %v_6 = select %v_5, %scale, 1: Float
    %v_7 = mul 0.000003000000106112566, %v_6: Float
    %v_8 = cmp_le %size, %v_7: Int
    ret %v_8
  }
}

