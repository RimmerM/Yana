nearDouble<complex>(%got: Double, %want: Double): Int {
  b_0 {
    %difference = sub %got, %want: Double
    %v_1 = cmp_lt %difference, 0: Int
    %v_2 = sub 0, %difference: Double
    %size = select %v_1, %v_2, %difference: Double
    %v_3 = cmp_lt %want, 0: Int
    %v_4 = sub 0, %want: Double
    %scale = select %v_3, %v_4, %want: Double
    %v_5 = cmp_gt %scale, 1: Int
    %v_6 = select %v_5, %scale, 1: Double
    %v_7 = mul 1E-12, %v_6: Double
    %v_8 = cmp_le %size, %v_7: Int
    ret %v_8
  }
}

