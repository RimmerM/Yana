module ResolveTest

fn replace(slot: a [unique call], value: a) -> {} = <no body>

fn main() -> I32 {
bb0:
  %5: %Panel address = alloc frame Panel
  %6: Bool trivial = const False
  %7: Bool trivial = const False
  %8: Panel trivial = aggregate.Panel consume %6 consume %7
  store inspect %5 consume %8
  %9: %Bool address = field.addr .lead inspect %5
  %10: Bool [unique call] guaranteed from{%5} = load inspect %9
  %11: Bool trivial = const True
  call replace(Bool) borrow %10 consume %11
  %12: %Bool address = field.addr .trail inspect %5
  %13: Bool [unique call] guaranteed from{%5} = load inspect %12
  %14: Bool trivial = const True
  call replace(Bool) borrow %13 consume %14
  %15: %Bool address = field.addr .lead inspect %5
  %16: Bool trivial = load inspect %15
  branch inspect %16 -> bb3 -> bb1

bb1:
  %17: I32 trivial = const 0
  jump -> bb2(consume %17)

bb2(%0: I32 trivial):
  %18: %Bool address = field.addr .trail inspect %5
  %19: Bool trivial = load inspect %18
  branch inspect %19 -> bb6(consume %0) -> bb4(consume %0)

bb3:
  %20: I32 trivial = const 1
  jump -> bb2(consume %20)

bb4(%1: I32 trivial):
  %21: I32 trivial = const 0
  jump -> bb5(consume %21, consume %1)

bb5(%2: I32 trivial, %3: I32 trivial):
  %22: I32 trivial = add inspect %3 inspect %2
  return consume %22

bb6(%4: I32 trivial):
  %23: I32 trivial = const 2
  jump -> bb5(consume %23, consume %4)
}

fn replace(Bool)(slot: Bool [unique call], value: Bool) -> {} {
bb0(%0: Bool [unique call] guaranteed, %1: Bool trivial):
  %2: %Bool address = alloc frame Bool
  store inspect %2 consume %1
  %3: Bool trivial = load inspect %2
  store inspect %0 consume %3
  return
}

entry main
