mut @trace = [0, 0, 0, 0]

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 8, 8: Ptr
    %v_2 = alloca 8, 8: Ptr
    %v_3 = alloca 8, 8: Ptr
    %v_4 = imm 5: I64
    jmp b_5
  }

  b_5 {
    %v_6 = phi [b_0, 2], [b_7, %v_8]: I64
    %v_9 = cmp_ilt %v_6, %v_4: I32
    %v_10 = cmp_eq %v_6, %v_4: I32
    %v_11 = select %v_10, 1, 2: I32
    %v_12 = select %v_9, 0, %v_11: I32
    %v_13 = cmp_eq %v_12, 0: I32
    je %v_13, b_7, b_14
  }

  b_14 {
    %v_15 = imm 5: I64
    %v_16 = imm 1: I64
    store %v_1, 2, 8
    jmp b_17
  }

  b_7 {
    %v_18 = alloca 8, 8: Ptr
    store %v_18, %v_6, 8
    %v_19 = loads @trace, 4: I32
    %v_20 = imul %v_19, 10: I32
    %v_21 = add %v_20, 1: I32
    store @trace, %v_21, 4
    %v_8 = add %v_6, 1: I64
    jmp b_5
  }

  b_17 {
    %v_22 = load %v_1, 8: I64
    %v_23 = cmp_ilt %v_22, %v_15: I32
    %v_24 = cmp_eq %v_22, %v_15: I32
    %v_25 = select %v_24, 1, 2: I32
    %v_26 = select %v_23, 0, %v_25: I32
    %v_27 = cmp_neq %v_26, 2: I32
    je %v_27, b_28, b_29
  }

  b_29 {
    %v_30 = imm 1: I64
    %v_31 = imm 2: I64
    store %v_2, 5, 8
    jmp b_32
  }

  b_28 {
    %v_33 = alloca 8, 8: Ptr
    copy %v_33, %v_1, 8
    %v_34 = loads @trace, 4: I32
    %v_35 = imul %v_34, 10: I32
    %v_36 = add %v_35, 2: I32
    store @trace, %v_36, 4
    %v_37 = load %v_1, 8: I64
    %v_38 = sub %v_15, %v_37: I64
    %v_39 = cmp_ilt %v_38, %v_16: I32
    %v_40 = cmp_eq %v_38, %v_16: I32
    %v_41 = select %v_40, 1, 2: I32
    %v_42 = select %v_39, 0, %v_41: I32
    %v_43 = cmp_neq %v_42, 0: I32
    je %v_43, b_44, b_29
  }

  b_44 {
    %v_45 = add %v_37, %v_16: I64
    store %v_1, %v_45, 8
    jmp b_17
  }

  b_46 {
    %v_47 = load %v_2, 8: I64
    %v_48 = cmp_ilt %v_47, %v_30: I32
    %v_49 = cmp_eq %v_47, %v_30: I32
    %v_50 = select %v_49, 1, 2: I32
    %v_51 = select %v_48, 0, %v_50: I32
    %v_52 = cmp_neq %v_51, 0: I32
    je %v_52, b_53, b_54
  }

  b_54 {
    %v_55 = imm 2: I64
    store %v_3, 5, 8
    jmp b_56
  }

  b_57 {
    jmp b_58
  }

  b_59 {
    store %v_2, 3, 8
    jmp b_46
  }

  b_53 {
    %v_60 = alloca 8, 8: Ptr
    copy %v_60, %v_2, 8
    %v_61 = loads @trace, 4: I32
    %v_62 = imul %v_61, 10: I32
    %v_63 = add %v_62, 3: I32
    store @trace, %v_63, 4
    %v_64 = load %v_2, 8: I64
    %v_65 = sub %v_64, %v_30: I64
    %v_66 = cmp_ilt %v_65, %v_31: I32
    %v_67 = cmp_eq %v_65, %v_31: I32
    %v_68 = select %v_67, 1, 2: I32
    %v_69 = select %v_66, 0, %v_68: I32
    %v_70 = cmp_neq %v_69, 0: I32
    je %v_70, b_71, b_54
  }

  b_71 {
    %v_72 = sub %v_64, %v_31: I64
    store %v_2, %v_72, 8
    jmp b_46
  }

  b_56 {
    %v_73 = load %v_3, 8: I64
    %v_74 = cmp_ilt %v_73, %v_55: I32
    %v_75 = cmp_eq %v_73, %v_55: I32
    %v_76 = select %v_75, 1, 2: I32
    %v_77 = select %v_74, 0, %v_76: I32
    %v_78 = cmp_eq %v_77, 0: I32
    je %v_78, b_79, b_80
  }

  b_80 {
    %v_81 = loads @trace, 4: I32
    ret %v_81
  }

  b_79 {
    %v_82 = alloca 8, 8: Ptr
    copy %v_82, %v_3, 8
    %v_83 = loads @trace, 4: I32
    %v_84 = imul %v_83, 10: I32
    %v_85 = add %v_84, 4: I32
    store @trace, %v_85, 4
    %v_86 = load %v_3, 8: I64
    %v_87 = add %v_86, 1: I64
    store %v_3, %v_87, 8
    jmp b_56
  }

  b_32 {
    jmp b_88
  }

  b_88 {
    jmp b_57
  }

  b_58 {
    jmp b_89
  }

  b_89 {
    jmp b_59
  }
