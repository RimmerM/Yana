mut @trace = [0, 0, 0, 0]

main<complex>(): I32 {
  b_0 {
    %v_1 = imm 5: I64
    jmp b_2
  }

  b_2 {
    %v_3 = phi [b_0, 2], [b_4, %v_5]: I64
    %v_6 = cmp_ilt %v_3, %v_1: I32
    %v_7 = cmp_eq %v_3, %v_1: I32
    %v_8 = select %v_7, 1, 2: I32
    %v_9 = select %v_6, 0, %v_8: I32
    %v_10 = cmp_eq %v_9, 0: I32
    je %v_10, b_4, b_11
  }

  b_11 {
    %v_12 = imm 5: I64
    %v_13 = imm 1: I64
    jmp b_14
  }

  b_4 {
    %v_15 = loads @trace, 4: I32
    %v_16 = imul %v_15, 10: I32
    %v_17 = add %v_16, 1: I32
    store @trace, %v_17, 4
    %v_5 = add %v_3, 1: I64
    jmp b_2
  }

  b_14 {
    %v_18 = phi [b_11, 2], [b_19, %v_20]: I64
    %v_21 = cmp_ilt %v_18, %v_12: I32
    %v_22 = cmp_eq %v_18, %v_12: I32
    %v_23 = select %v_22, 1, 2: I32
    %v_24 = select %v_21, 0, %v_23: I32
    %v_25 = cmp_neq %v_24, 2: I32
    je %v_25, b_26, b_27
  }

  b_27 {
    %v_28 = imm 1: I64
    %v_29 = imm 2: I64
    jmp b_30
  }

  b_26 {
    %v_31 = loads @trace, 4: I32
    %v_32 = imul %v_31, 10: I32
    %v_33 = add %v_32, 2: I32
    store @trace, %v_33, 4
    %v_34 = sub %v_12, %v_18: I64
    %v_35 = cmp_ilt %v_34, %v_13: I32
    %v_36 = cmp_eq %v_34, %v_13: I32
    %v_37 = select %v_36, 1, 2: I32
    %v_38 = select %v_35, 0, %v_37: I32
    %v_39 = cmp_neq %v_38, 0: I32
    je %v_39, b_19, b_27
  }

  b_19 {
    %v_20 = add %v_18, %v_13: I64
    jmp b_14
  }

  b_30 {
    %v_40 = phi [b_27, 3], [b_41, %v_42]: I64
    %v_43 = cmp_ilt %v_40, %v_28: I32
    %v_44 = cmp_eq %v_40, %v_28: I32
    %v_45 = select %v_44, 1, 2: I32
    %v_46 = select %v_43, 0, %v_45: I32
    %v_47 = cmp_neq %v_46, 0: I32
    je %v_47, b_48, b_49
  }

  b_49 {
    %v_50 = imm 2: I64
    jmp b_51
  }

  b_48 {
    %v_52 = loads @trace, 4: I32
    %v_53 = imul %v_52, 10: I32
    %v_54 = add %v_53, 3: I32
    store @trace, %v_54, 4
    %v_55 = sub %v_40, %v_28: I64
    %v_56 = cmp_ilt %v_55, %v_29: I32
    %v_57 = cmp_eq %v_55, %v_29: I32
    %v_58 = select %v_57, 1, 2: I32
    %v_59 = select %v_56, 0, %v_58: I32
    %v_60 = cmp_neq %v_59, 0: I32
    je %v_60, b_41, b_49
  }

  b_41 {
    %v_42 = sub %v_40, %v_29: I64
    jmp b_30
  }

  b_51 {
    %v_61 = phi [b_49, 5], [b_62, %v_63]: I64
    %v_64 = cmp_ilt %v_61, %v_50: I32
    %v_65 = cmp_eq %v_61, %v_50: I32
    %v_66 = select %v_65, 1, 2: I32
    %v_67 = select %v_64, 0, %v_66: I32
    %v_68 = cmp_eq %v_67, 0: I32
    je %v_68, b_62, b_69
  }

  b_69 {
    %v_70 = loads @trace, 4: I32
    ret %v_70
  }

  b_62 {
    %v_71 = loads @trace, 4: I32
    %v_72 = imul %v_71, 10: I32
    %v_73 = add %v_72, 4: I32
    store @trace, %v_73, 4
    %v_63 = add %v_61, 1: I64
    jmp b_51
  }
}

