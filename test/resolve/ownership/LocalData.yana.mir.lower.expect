mut @trace = [0, 0, 0, 0]

Guard.drop<complex>(%v_0: I32) {
  b_1 {
    %v_2 = loads @trace, 4: I32
    %v_3 = imul %v_2, 10: I32
    %v_4 = add %v_3, %v_0: I32
    store @trace, %v_4, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = loads @trace, 4: I32
    %v_2 = imul %v_1, 10: I32
    %v_3 = add %v_2, 5: I32
    store @trace, %v_3, 4
    %v_4 = cmp_neq %v_3, 5: I32
    je %v_4, b_5, b_6
  }

  b_6 {
    store @trace, 0, 4
    call_complex Guard.drop, 3
    %v_7 = loads @trace, 4: I32
    %v_8 = cmp_neq %v_7, 3: I32
    %v_9 = select %v_8, 18446744073709551612, 0: I32
    ret %v_9
  }

  b_5 {
    ret 18446744073709551614
  }
}

