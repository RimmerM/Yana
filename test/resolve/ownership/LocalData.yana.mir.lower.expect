mut @trace = [0, 0, 0, 0]

Guard.drop<complex>(%value: Ptr) {
  b_0 {
    %v_1 = load %value, 4: I32
    %v_2 = loads @trace, 4: I32
    %v_3 = imul %v_2, 10: I32
    %v_4 = add %v_3, %v_1: I32
    store @trace, %v_4, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    %v_2 = alloca 4, 4: Ptr
    jmp b_3
  }

  b_3 {
    store %v_1, 5, 4
    copy %v_2, %v_1, 4
    call_complex Guard.drop, %v_2
    %v_4 = loads @trace, 4: I32
    %v_5 = cmp_neq %v_4, 5: I32
    je %v_5, b_6, b_7
  }

  b_7 {
    store @trace, 0, 4
    %v_8 = alloca 8, 4: Ptr
    store %v_8, 7, 4
    %v_9 = add %v_8, 4: Ptr
    store %v_9, 3, 4
    %v_10 = load %v_8, 4: I32
    call_complex Guard.drop, %v_9
    %v_11 = cmp_neq %v_10, 7: I32
    je %v_11, b_12, b_13
  }

  b_6 {
    ret 18446744073709551614
  }

  b_13 {
    %v_14 = loads @trace, 4: I32
    %v_15 = cmp_neq %v_14, 3: I32
    %v_16 = select %v_15, 18446744073709551612, 0: I32
    ret %v_16
  }

  b_12 {
    ret 18446744073709551613
  }
}

