mut @trace = [0, 0, 0, 0]

Guard.drop<complex>(%value: Ptr) {
  b_0 {
    %v_1 = load %value, 4: I32
    %v_2 = loads @trace, 4: I32
    %v_3 = imul %v_2, 10: I32
    %v_4 = add %v_3, %v_1: I32
    store @trace, %v_4, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    store %v_1, 5, 4
    call_complex Guard.drop, %v_1
    %v_2 = loads @trace, 4: I32
    %v_3 = cmp_neq %v_2, 5: I32
    je %v_3, b_4, b_5
  }

  b_5 {
    store @trace, 0, 4
    %v_6 = alloca 8, 4: Ptr
    store %v_6, 7, 4
    %v_7 = add %v_6, 4: Ptr
    store %v_7, 3, 4
    %v_8 = load %v_6, 4: I32
    call_complex Guard.drop, %v_7
    %v_9 = cmp_neq %v_8, 7: I32
    je %v_9, b_10, b_11
  }

  b_4 {
    ret 18446744073709551614
  }

  b_11 {
    %v_12 = loads @trace, 4: I32
    %v_13 = cmp_neq %v_12, 3: I32
    %v_14 = select %v_13, 18446744073709551612, 0: I32
    ret %v_14
  }

  b_10 {
    ret 18446744073709551613
  }
}

