  write.init borrow.unique ($yielded) take %2
  %4: I32 = read copy.trivial (global closed)
  %5: I32 = const 1
  %6: I32 = add inspect %4 inspect %5
  write.assign borrow.unique (global closed) take %6
  %8: $r = read take ($yielded)
  return take %8
}

