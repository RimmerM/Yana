mut @dropped = [0, 0, 0, 0]

Token.drop<complex>() {
  b_0 {
    %v_1 = loads @dropped, 4: I32
    %v_2 = add %v_1, 1: I32
    store @dropped, %v_2, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    call_complex Token.drop
    call_complex Token.drop
    %v_1 = alloca 8, 4: Ptr
    %v_2 = alloca 8, 4: Ptr
    store %v_2, 0, 1
    call_complex teardown(Maybe(Token)), %v_2
    store %v_1, 1, 1
    %v_3 = add %v_1, 4: Ptr
    store %v_3, 0, 4
    call_complex teardown(Outcome(Token, {})), %v_1
    call_complex Token.drop
    call_complex Token.drop
    %v_4 = loads @dropped, 4: I32
    %v_5 = add %v_4, 1: I32
    store @dropped, %v_5, 4
    call_complex Token.drop
    jmp b_6
  }

  b_6 {
    %v_7 = phi [b_0, 0], [b_8, %v_9]: I32
    %v_10 = phi [b_0, 1], [b_8, %v_11]: I32
    %v_12 = cmp_neq %v_10, 4294967294: I32
    je %v_12, b_13, b_14
  }

  b_13 {
    %v_15 = cmp_igt %v_10, 0: I32
    je %v_15, b_8, b_16
  }

  b_16 {
    call_complex Token.drop
    jmp b_14
  }

  b_8 {
    call_complex Token.drop
    %v_17 = loads @dropped, 4: I32
    %v_18 = add %v_17, 1: I32
    store @dropped, %v_18, 4
    %v_19 = add 3, %v_10: I32
    %v_9 = add %v_7, %v_19: I32
    %v_11 = add %v_10, 4294967295: I32
    jmp b_6
  }

  b_14 {
    %v_20 = loads @dropped, 4: I32
    ret %v_20
  }
}

teardown(Maybe(Token))<complex>(%v_0: Ptr) {
  b_1 {
    %v_2 = load %v_0, 1: I32
    %v_3 = cmp_eq %v_2, 1: I32
    je %v_3, b_4, b_5
  }

  b_6 {
    ret 
  }

  b_4 {
    call_complex Token.drop
    jmp b_6
  }

  b_5 {
    jmp b_6
  }
}

teardown(Outcome(Token, {}))<complex>(%v_0: Ptr) {
  b_1 {
    %v_2 = load %v_0, 1: I32
    %v_3 = cmp_eq %v_2, 0: I32
    je %v_3, b_4, b_5
  }

  b_6 {
    ret 
  }

  b_4 {
    call_complex Token.drop
    jmp b_6
  }

  b_5 {
    jmp b_6
  }
}

