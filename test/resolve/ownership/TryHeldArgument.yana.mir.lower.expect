    store %v_3, 1, 1
    %v_5 = load %v_4, 4: I32
    store %v_1, 0, 1
    %v_6 = add %v_1, 4: Ptr
    store %v_6, %v_5, 4
    %v_7 = alloca 8, 4: Ptr
    %v_8 = add %v_7, 4: Ptr
    store %v_8, 4, 4
    store %v_7, 1, 1
    %v_9 = load %v_8, 4: I32
    store %v_2, 0, 1
    %v_10 = add %v_2, 4: Ptr
    store %v_10, %v_9, 4
    %v_11 = load %v_6, 4: I32
    %v_12 = load %v_10, 4: I32
    call_complex Token.drop, %v_11
    call_complex Token.drop, %v_12
    %v_13 = alloca 8, 4: Ptr
    %v_14 = alloca 8, 4: Ptr
    %v_15 = alloca 8, 4: Ptr
    %v_16 = add %v_15, 4: Ptr
    store %v_16, 3, 4
    store %v_15, 1, 1
    %v_17 = load %v_16, 4: I32
    store %v_13, 0, 1
    %v_18 = add %v_13, 4: Ptr
    store %v_18, %v_17, 4
    %v_19 = alloca 8, 4: Ptr
    store %v_19, 0, 1
    call_complex teardown(Maybe(Token)), %v_19
    store %v_14, 1, 1
    %v_20 = add %v_14, 4: Ptr
    store %v_20, 0, 4
    %v_21 = load %v_18, 4: I32
    call_complex teardown(Outcome(Token, {})), %v_14
    call_complex Token.drop, %v_21
    call_complex Token.drop, 3
    %v_22 = loads @dropped, 4: I32
    %v_23 = add %v_22, 1: I32
    store @dropped, %v_23, 4
    call_complex Token.drop, 3
    %v_24 = imm 3: I32
    jmp b_25
  }

  b_25 {
    %v_26 = phi [b_0, 0], [b_27, %v_28]: I32
    %v_29 = phi [b_0, 1], [b_27, %v_30]: I32
    %v_31 = cmp_neq %v_29, 4294967294: I32
    je %v_31, b_32, b_33
  }

  b_32 {
    %v_34 = cmp_igt %v_29, 0: I32
    je %v_34, b_27, b_35
  }

  b_35 {
    call_complex Token.drop, %v_24
    jmp b_33
  }

  b_27 {
    call_complex Token.drop, %v_24
    %v_36 = loads @dropped, 4: I32
    %v_37 = add %v_36, 1: I32
    store @dropped, %v_37, 4
    %v_38 = add %v_24, %v_29: I32
    %v_28 = add %v_26, %v_38: I32
    %v_30 = add %v_29, 4294967295: I32
    jmp b_25
  }

  b_33 {
    %v_39 = loads @dropped, 4: I32
    ret %v_39
  }
}

teardown(Maybe(Token))<complex>(%v_0: Ptr) {
  b_1 {
    %v_2 = load %v_0, 1: I32
    %v_3 = cmp_eq %v_2, 1: I32
    je %v_3, b_4, b_5
  }

  b_6 {
    ret 
  }

  b_4 {
    %v_7 = add %v_0, 4: Ptr
    %v_8 = load %v_7, 4: I32
    call_complex Token.drop, %v_8
    jmp b_6
  }

  b_5 {
    jmp b_6
  }
}

teardown(Outcome(Token, {}))<complex>(%v_0: Ptr) {
  b_1 {
    %v_2 = load %v_0, 1: I32
    %v_3 = cmp_eq %v_2, 0: I32
    je %v_3, b_4, b_5
