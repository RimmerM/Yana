  return take %0
}

fn tagged(count: I32 [shared call], id: I32 [shared call]) -> Tagged {
bb0:
  %0: I32 = read copy.trivial (count)
  %1: I32 = read copy.trivial (id)
  %2: Guard = call guard borrow.shared %1
  %3: Tagged = aggregate take %0 take %2
  return take %3
}

