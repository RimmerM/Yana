@image$base = []

opaque<complex>(%x: I32): I32 {
  b_0 {
    ret %x
  }
}

asResult<complex>(): I64, I64 {
  b_0 {
    %v_1 = bitcast asResult.lambda: I64
    ret %v_1, 0
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 16, 8: Ptr
    %v_2 = call_complex opaque, 2: I32
    %v_3 = bitcast 0: Ptr
    %v_4 = call_complex asArgument.lambda, %v_3, %v_2: I32
    %v_5 = alloca 16, 8: Ptr
    %asField.lambda = fun asField.lambda: Ptr
    store %v_5, %asField.lambda, 8
    %v_6 = add %v_5, 8: Ptr
    store %v_6, 0, 8
    %v_7 = load %v_6, 8: Ptr
    %v_8 = call_complex %asField.lambda, %v_7, %v_2: I32
    call_complex teardown(fun), %v_5
    %v_9, %v_10 = call_complex asResult: I64, I64
    store %v_1, %v_9, 8
    %v_11 = add %v_1, 8: Ptr
    store %v_11, %v_10, 8
    %v_12 = load %v_1, 8: Ptr
    %v_13 = load %v_11, 8: Ptr
    %v_14 = call_complex %v_12, %v_13, %v_2: I32
    call_complex teardown(fun), %v_1
    %v_15 = bitcast 0: Ptr
    %v_16 = call_complex asAssignment.lambda'2, %v_15, %v_2: I32
    %v_17 = call_complex opaque, 4: I32
    %v_18 = add %v_2, %v_17: I32
    %v_19 = add %v_4, %v_8: I32
    %v_20 = add %v_19, %v_14: I32
    %v_21 = add %v_20, %v_16: I32
    %v_22 = add %v_21, %v_18: I32
    ret %v_22
  }
}

@header(asArgument.lambda) = [0, 0, 0, 0]
asArgument.lambda<complex>(%asArgument.lambda.env: Ptr, %x: I32): I32 {
  b_0 {
    %v_1 = shl %x, 1: I32
    ret %v_1
  }
}

@header(asField.lambda) = [0, 0, 0, 0]
asField.lambda<complex>(%asField.lambda.env: Ptr, %x: I32): I32 {
  b_0 {
    %v_1 = imul %x, 3: I32
    ret %v_1
  }
}

@header(asResult.lambda) = [0, 0, 0, 0]
asResult.lambda<complex>(%asResult.lambda.env: Ptr, %x: I32): I32 {
  b_0 {
    %v_1 = imul %x, 5: I32
    ret %v_1
  }
}

@header(asAssignment.lambda) = [0, 0, 0, 0]
asAssignment.lambda<complex>(%asAssignment.lambda.env: Ptr, %x: I32): I32 {
  b_0 {
    %v_1 = imul %x, 7: I32
    ret %v_1
  }
}

@header(asAssignment.lambda'2) = [0, 0, 0, 0]
asAssignment.lambda'2<complex>(%asAssignment.lambda'2.env: Ptr, %x: I32): I32 {
  b_0 {
    %v_1 = imul %x, 11: I32
    ret %v_1
  }
}

@header(capturing.lambda) = [0, 0, 0, 0]
capturing.lambda<complex>(%capturing.lambda.env: Ptr, %x: I32): I32 {
  b_0 {
    %v_1 = loads %capturing.lambda.env, 4: I32
    %v_2 = add %x, %v_1: I32
    ret %v_2
  }
}

teardown(fun)<complex>(%v_0: Ptr) {
  b_1 {
    %v_2 = add %v_0, 8: Ptr
    %v_3 = load %v_2, 8: I64
    %v_4 = cmp_eq %v_3, 0: I32
    je %v_4, b_5, b_6
  }

  b_6 {
    %v_7 = load %v_0, 8: Ptr
    %v_8 = sub %v_7, 4: Ptr
    %v_9 = loads %v_8, 4: I32
    %v_10 = sext %v_9: I64
    %v_11 = cmp_eq %v_10, 0: I32
    je %v_11, b_5, b_12
  }

  b_12 {
    %v_13 = add %v_10, @image$base: Ptr
    %v_14 = bitcast %v_3: Ptr
    call_complex %v_13, %v_14
    jmp b_5
  }

  b_5 {
    ret 
  }
}

