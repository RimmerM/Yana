bb0:
  %0: I32 = read copy.trivial (id)
  %1: Guard = aggregate.Guard take %0
  write.init borrow.unique (g) take %1
  %3: Guard = read take (g)
  %4: returned.lambda.env = aggregate.returned.lambda.env take %3
  write.init borrow.unique (returned.lambda.env) take %4
  %6: returned.lambda.env = read take (returned.lambda.env)
  %7: (I32) -> I32 = fun.value returned.lambda take %6
  return take %7
}

