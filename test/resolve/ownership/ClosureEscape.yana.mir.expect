fn oneArm(id: I32 [shared call], away: Bool [shared call]) -> I32 {
  local f: (I32) -> I32

bb0:
  %0: I32 = read copy.trivial (id)
  %1: (I32) -> I32 = call returned borrow.shared %0
  write.init borrow.unique (f) take %1
  %3: Bool = read copy.trivial (away)
  branch inspect %3 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %10: (I32) -> I32 [shared call] = read borrow.shared (f) loan0
  %11: I32 = const 20
  %12: I32 = call call borrow.shared %10 borrow.shared %11
  drop (f)
  return take %12

bb3:
  %5: (I32) -> I32 = read take (f)
  %6: I32 = const 10
  %7: I32 = call consume take %5 borrow.shared %6
  return take %7
}

fn borrowed(id: I32 [shared call]) -> I32 {
  local g: Guard
  local borrowed.lambda.env: borrowed.lambda.env
  local local3: (I32) -> I32 [owned here shape8 .0=shared call]

bb0:
  %0: I32 = read copy.trivial (id)
  %1: Guard = aggregate.Guard take %0
  write.init borrow.unique (g) take %1
  %3: Guard [shared slot 0] = read borrow.shared (g) loan0
  %4: borrowed.lambda.env = aggregate.borrowed.lambda.env borrow.shared %3 roots.0{0}
  write.init borrow.unique (borrowed.lambda.env) take %4
  %6: borrowed.lambda.env [shared call] = read borrow.shared (borrowed.lambda.env) loan1 roots.0{0}
  %7: (I32) -> I32 [owned here shape8 .0=shared call] = fun.value borrowed.lambda inspect %6 roots.0{0, 1}
  write.init borrow.unique (local3) take %7
  %9: (I32) -> I32 [shared call shape8 .0=shared call] = read borrow.shared (local3) loan2 roots.0{0, 1}
  %10: I32 = const 30
  %11: I32 = call call borrow.shared %9 borrow.shared %10
  drop (g)
  return take %11
}

fn round'2() -> I32 {
  local & total: I32
  local f: (I32) -> I32
  local h: Handler

bb0:
  %0: I32 = const 0
  write.init borrow.unique (total) take %0
  %2: I32 = const 1
  %3: (I32) -> I32 = call returned borrow.shared %2
  write.init borrow.unique (f) take %3
  %5: I32 = read copy.trivial (total)
  %6: (I32) -> I32 [shared call] = read borrow.shared (f) loan0
  %7: I32 = const 10
  %8: I32 = call inspect %6 borrow.shared %7
  drop (f)
  %9: I32 = add inspect %5 inspect %8
  write.assign borrow.unique (total) take %9
  %11: I32 = const 2
  %12: Handler = call inRecord borrow.shared %11
  write.init borrow.unique (h) take %12
  %14: I32 = read copy.trivial (total)
  %15: (I32) -> I32 [shared call] = read borrow.shared (h.run) loan1
  %16: I32 = const 20
  %17: I32 = call inspect %15 borrow.shared %16
  drop (h)
  %18: I32 = add inspect %14 inspect %17
  write.assign borrow.unique (total) take %18
  %20: I32 = read copy.trivial (total)
  %21: I32 = const 3
  %22: I32 = call handedOff borrow.shared %21
  %23: I32 = add inspect %20 inspect %22
  write.assign borrow.unique (total) take %23
  %25: I32 = read copy.trivial (total)
  %26: I32 = const 4
  %27: Bool = const True
  %28: I32 = call oneArm borrow.shared %26 borrow.shared %27
  %29: I32 = add inspect %25 inspect %28
  write.assign borrow.unique (total) take %29
  %31: I32 = read copy.trivial (total)
  %32: I32 = const 5
  %33: Bool = const False
  %34: I32 = call oneArm borrow.shared %32 borrow.shared %33
  %35: I32 = add inspect %31 inspect %34
  write.assign borrow.unique (total) take %35
  %37: I32 = read copy.trivial (total)
  %38: I32 = const 6
  %39: I32 = call borrowed borrow.shared %38
  %40: I32 = add inspect %37 inspect %39
  write.assign borrow.unique (total) take %40
  %42: I32 = read copy.trivial (total)
  return take %42
}

fn main() -> I32 {
  local mark: Size
  local & i: I32

bb0:
  %0: I32 = call round'2
  %1: I32 = const 112
  %2: Bool = ne inspect %0 inspect %1
  branch inspect %2 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %7: I32 = read copy.trivial (global dropCalls)
  %8: I32 = const 6
  %9: Bool = ne inspect %7 inspect %8
