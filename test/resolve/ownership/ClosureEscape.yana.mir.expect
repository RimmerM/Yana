instance Drop(Guard): Guard.drop

let & dropCalls: I32 = 0

fn Guard.drop(self: Guard) -> {} {
bb0:
  %0: I32 = read copy.trivial (global dropCalls)
  %1: I32 = const 1
  %2: I32 = add inspect %0 inspect %1
  write.assign borrow.unique (global dropCalls) take %2
  return
}

fn consume(f: (I32) -> I32, v: I32 [shared call]) -> I32 {
bb0:
  %0: (I32) -> I32 [shared call] = read borrow.shared (f) loan0
  %1: I32 = read copy.trivial (v)
  %2: I32 = call inspect %0 borrow.shared %1
  drop (f)
  return take %2
}

