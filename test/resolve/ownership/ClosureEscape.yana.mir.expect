  %39: Bool = ne inspect %37 inspect %38
  branch inspect %39 -> bb15 -> bb13

bb9:
  %24: I32 = call round'2
  %25: I32 = const 112
  %26: Bool = ne inspect %24 inspect %25
  branch inspect %26 -> bb12 -> bb10

bb10:
  jump -> bb11

bb11:
  %31: I32 = read copy.trivial (i)
  %32: I32 = const 1
  %33: I32 = add inspect %31 inspect %32
  write.assign borrow.unique (i) take %33
  jump -> bb7

bb12:
  %28: I32 = const -3
  return take %28

bb13:
  jump -> bb14

bb14:
  %44: I32 = const 112
  %45: I32 = read copy.trivial (global dropCalls)
  %46: I32 = const 600
  %47: I32 = sub inspect %45 inspect %46
  %48: I32 = add inspect %44 inspect %47
  return take %48

bb15:
  %41: I32 = const -4
  return take %41
}

