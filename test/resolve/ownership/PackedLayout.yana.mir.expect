  %34: @bits(1) U64 = const 1
  %35: PageTableEntry = aggregate.PageTableEntry take %22 take %23 take %24 take %25 take %26 take %27 take %28 take %29 take %30 take %31 take %32 take %33 take %34
  write.init borrow.unique (entry) take %35
  %37: @bits(1) U64 = const 0
