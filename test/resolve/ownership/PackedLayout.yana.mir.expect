module ResolveTest

data Mode = Read | Write | Execute | Sleep | Halt

data PageSize = PageSizeNormal | PageSizeHuge

data PageAvailable = Available0 | Available1 | Available2 | Available3 | Available4 | Available5 | Available6 | Available7

data Header {a: @bits(4) U32, b: @bits(3) U32, c: Bool, d: U16, e: U32}

data WithMode {mode: Mode, padding: @bits(5) U32}

data Crosses {first: @bits(7) U64, second: @bits(2) U64, padding: @bits(7) U64}

data WideBits {value: @bits(40) U64, tail: @bits(8) U64}

data OffsetWide {prefix: @bits(4) U64, value: @bits(40) U64, suffix: @bits(4) U64}

data PageTableEntry {present: @bits(1) U64, writable: @bits(1) U64, user: @bits(1) U64, writeThrough: @bits(1) U64, cacheDisable: @bits(1) U64, accessed: @bits(1) U64, dirty: @bits(1) U64, huge: @bits(1) U64, globalPage: @bits(1) U64, available: @bits(3) U64, address: @bits(40) U64, reserved: @bits(11) U64, executeDisable: @bits(1) U64}

data TypedPageTableEntry {present: Bool, writable: Bool, user: Bool, writeThrough: Bool, cacheDisable: Bool, accessed: Bool, dirty: Bool, huge: PageSize, globalPage: Bool, available: PageAvailable, address: @bits(40) U64, reserved: @bits(11) U16, executeDisable: Bool}

fn readWide(wide: WideBits [unique call]) -> U64 {
bb0:
  %0: @bits(40) U64 = read copy.trivial (wide.value)
  %1: U64 = convert inspect %0
  return take %1
}

fn writeWide(wide: WideBits [unique call], value: U64 [shared call]) -> {} {
bb0:
  %0: U64 = read copy.trivial (value)
  %1: @bits(40) U64 = convert inspect %0
  write.assign borrow.unique (wide.value) take %1
  return
}

fn wideRoundTrip(value: U64 [shared call]) -> U64 {
  local & wide: WideBits

bb0:
  %0: U64 = read copy.trivial (value)
  %1: @bits(40) U64 = convert inspect %0
  %2: @bits(8) U64 = const 90
  %3: WideBits = aggregate.WideBits take %1 take %2
  write.init borrow.unique (wide) take %3
  %5: WideBits [unique call] = read borrow.unique (wide) loan0
  %6: U64 = read copy.trivial (value)
  %7: {} = call writeWide borrow.unique %5 borrow.shared %6
  %8: WideBits [unique call] = read borrow.unique (wide) loan1
  %9: U64 = call readWide borrow.unique %8
  return take %9
}

fn readOffsetWide(wide: OffsetWide [unique call]) -> U64 {
bb0:
  %0: @bits(40) U64 = read copy.trivial (wide.value)
  %1: U64 = convert inspect %0
  return take %1
}

fn writeOffsetWide(wide: OffsetWide [unique call], value: U64 [shared call]) -> {} {
bb0:
  %0: U64 = read copy.trivial (value)
  %1: @bits(40) U64 = convert inspect %0
  write.assign borrow.unique (wide.value) take %1
  return
}

fn offsetWideRoundTrip(value: U64 [shared call]) -> U64 {
  local & wide: OffsetWide

bb0:
  %0: @bits(4) U64 = const 10
  %1: U64 = read copy.trivial (value)
  %2: @bits(40) U64 = convert inspect %1
  %3: @bits(4) U64 = const 5
  %4: OffsetWide = aggregate.OffsetWide take %0 take %2 take %3
  write.init borrow.unique (wide) take %4
  %6: OffsetWide [unique call] = read borrow.unique (wide) loan0
  %7: U64 = read copy.trivial (value)
  %8: {} = call writeOffsetWide borrow.unique %6 borrow.shared %7
  %9: OffsetWide [unique call] = read borrow.unique (wide) loan1
  %10: U64 = call readOffsetWide borrow.unique %9
  return take %10
}

fn main() -> I32 {
  local header: Header
  local packed: WithMode
  local crosses: Crosses
  local wideValue: U64
  local offsetWideValue: U64
  local & entry: PageTableEntry
  local & typedEntry: TypedPageTableEntry

bb0:
  %0: @bits(4) U32 = const 3
  %1: @bits(3) U32 = const 5
  %2: Bool = const True
  %3: U16 = const 4660
  %4: U32 = const 1450744508
  %5: Header = aggregate.Header take %0 take %1 take %2 take %3 take %4
  write.init borrow.unique (header) take %5
