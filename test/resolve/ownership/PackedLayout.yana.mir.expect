  %56: PageSize = const PageSizeHuge
  %57: Bool = const True
  %58: PageAvailable = const Available0
  %59: @bits(40) U64 = const 78187493530
  %60: @bits(11) U16 = const 0
  %61: Bool = const True
  %62: TypedPageTableEntry = aggregate.TypedPageTableEntry take %49 take %50 take %51 take %52 take %53 take %54 take %55 take %56 take %57 take %58 take %59 take %60 take %61
  write.init borrow.unique (typedEntry) take %62
  %64: Bool = const False
  write.assign borrow.unique (typedEntry.present) take %64
  %66: Bool = const True
  write.assign borrow.unique (typedEntry.present) take %66
  %68: PageSize = const PageSizeNormal
  write.assign borrow.unique (typedEntry.huge) take %68
  %70: PageSize = const PageSizeHuge
  write.assign borrow.unique (typedEntry.huge) take %70
  %72: PageAvailable = const Available3
  write.assign borrow.unique (typedEntry.available) take %72
  %74: PageAvailable = const Available0
  write.assign borrow.unique (typedEntry.available) take %74
  %76: @bits(40) U64 = const 151488268715
  write.assign borrow.unique (typedEntry.address) take %76
  %78: @bits(40) U64 = const 78187493530
  write.assign borrow.unique (typedEntry.address) take %78
  %80: Bool = const False
  write.assign borrow.unique (typedEntry.executeDisable) take %80
  %82: Bool = const True
  write.assign borrow.unique (typedEntry.executeDisable) take %82
  %84: @bits(4) U32 = read copy.trivial (header.a)
  %85: I32 = convert inspect %84
  %86: @bits(3) U32 = read copy.trivial (header.b)
  %87: I32 = convert inspect %86
  %88: I32 = const 10
  %89: I32 = mul inspect %87 inspect %88
  %90: I32 = add inspect %85 inspect %89
  %91: Bool = read copy.trivial (header.c)
  branch inspect %91 -> bb3(take %90) -> bb1(take %90)

bb1(%92: I32):
  %96: I32 = const 0
  jump -> bb2(take %96, take %92)

bb2(%97: I32, %98: I32):
  %101: I32 = add inspect %98 inspect %97
