    %v2 = load %value.discriminant : I32
    %v4 = cmp_eq %v2, 1 : Bool
    je %v4, b2, b4

  b1:
    %v6 = alloc : Outcome(Token, ())
    init %local3.discriminant, 1
    jmp b3

  b2:
    %v10 = load %value@Just : Token
    %v11 = move %value@Just : Token
    %inner = alloc : Token
    init %local1, %v11
    %v14 = alloc : Outcome(Token, ())
    aggregate %local2.discriminant = 0, %local2@Proceed = %inner
    jmp b3

  b3:
    %v1 = phi [b2, %v14], [b1, %v6] : Outcome(Token, ())
    ret %v1

  b4:
    drop_derived %value via drop$Maybe(Token)
    jmp b1
}

fn Try(Maybe(a), a, ()).fromExit(I32)(%reason: ()) -> Maybe(I32) {
