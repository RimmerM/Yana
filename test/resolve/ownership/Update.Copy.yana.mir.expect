  %1: I32 = const 1
  %2: I32 = add inspect %0 inspect %1
  write.assign borrow.unique (global copies) take %2
  %4: I32 = read copy.trivial (from.left)
  %5: I32 = const 100
  %6: I32 = add inspect %4 inspect %5
  %7: I32 = read copy.trivial (from.right)
  %8: Pair = aggregate.Pair take %6 take %7
