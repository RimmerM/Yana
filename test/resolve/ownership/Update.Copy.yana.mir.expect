}

fn withRight(p: Pair [shared call], r: I32 [shared call]) -> Pair {
  local & local2: Pair

bb0:
  %0: Pair [shared call] = read borrow.shared (p) loan0
  %1: Pair = call copy(Pair) borrow.shared %0
  write.init borrow.unique (local2) take %1
  %3: I32 = read copy.trivial (r)
  write.assign borrow.unique (local2.right) take %3
  %5: Pair = read take (local2)
