    %v_21 = loads @dropped, 4: I32
    %v_22 = imul %v_21, 10000000: I32
    %v_23 = imul %v_16, 100000: I32
    %v_24 = add %v_22, %v_23: I32
    %v_25 = imul %v_19, 1000: I32
    %v_26 = add %v_24, %v_25: I32
    %v_27 = add %v_26, %v_20: I32
