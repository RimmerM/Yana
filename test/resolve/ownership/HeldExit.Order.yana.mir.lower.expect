    call_complex Traced.drop, %v_17
    %v_22 = loads @trace, 4: I32
    %v_23 = imul %v_22, 10: I32
    %v_24 = add %v_23, 7: I32
    %v_25 = imul %v_24, 10: I32
    %v_26 = add %v_25, 9: I32
    store @trace, %v_26, 4
    ret 1, 0
  }

  b_27 {
    call_complex teardown(Outcome(Traced, {})), %v_3
    call_complex Traced.drop, %v_17
    call_complex Traced.drop, %v_21
    ret 0, 0
  }

  b_6 {
    jmp b_28
  }

  b_5 {
    jmp b_28
  }

  b_28 {
    %v_29 = phi [b_6, 0], [b_5, 1]: I32
    %v_30 = phi [b_6, 0], [b_5, %a]: I32
    %v_31 = alloca 8, 4: Ptr
    store %v_31, %v_29, 1
    %v_32 = add %v_31, 4: Ptr
    store %v_32, %v_30, 4
    je %v_29, b_33, b_34
  }

  b_34 {
