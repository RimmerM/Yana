mut @dropped = [0, 0, 0, 0]
mut @trace = [0, 0, 0, 0]

Token.drop<complex>(%v_0: I32) {
  b_1 {
    %v_2 = loads @dropped, 4: I32
    %v_3 = add %v_2, %v_0: I32
    store @dropped, %v_3, 4
    ret 
  }
}

Traced.drop<complex>(%v_0: I32) {
  b_1 {
    %v_2 = loads @trace, 4: I32
    %v_3 = imul %v_2, 10: I32
    %v_4 = add %v_3, %v_0: I32
    store @trace, %v_4, 4
    ret 
  }
}

nested<complex>(%a: I32, %b: I32, %c: I32): I32, I32 {
  b_0 {
    %v_1 = alloca 8, 4: Ptr
    %v_2 = alloca 8, 4: Ptr
    %v_3 = alloca 8, 4: Ptr
    %v_4 = cmp_igt %a, 0: I32
    je %v_4, b_5, b_6
  }

  b_7 {
    %v_8 = cmp_igt %b, 0: I32
    je %v_8, b_9, b_10
  }

  b_11 {
    call_complex teardown(Outcome(Traced, {})), %v_1
    ret 0, 0
  }

  b_12 {
    %v_13 = cmp_igt %c, 0: I32
    je %v_13, b_14, b_15
  }

  b_16 {
    call_complex teardown(Outcome(Traced, {})), %v_2
    call_complex Traced.drop, %v_17
    ret 0, 0
  }

  b_18 {
    call_complex Traced.drop, %v_19
    call_complex Traced.drop, %v_20
    call_complex Traced.drop, %v_17
    %v_21 = loads @trace, 4: I32
    %v_22 = imul %v_21, 10: I32
    %v_23 = add %v_22, 7: I32
    %v_24 = imul %v_23, 10: I32
    %v_25 = add %v_24, 9: I32
    store @trace, %v_25, 4
    ret 1, 0
  }

  b_26 {
    call_complex teardown(Outcome(Traced, {})), %v_3
    call_complex Traced.drop, %v_17
    call_complex Traced.drop, %v_19
    ret 0, 0
  }

  b_6 {
    jmp b_27
  }

  b_5 {
    jmp b_27
  }

  b_27 {
    %v_28 = phi [b_6, 0], [b_5, 1]: I32
    %v_29 = phi [b_6, 0], [b_5, %a]: I32
    %v_30 = alloca 8, 4: Ptr
    store %v_30, %v_28, 1
    %v_31 = add %v_30, 4: Ptr
    store %v_31, %v_29, 4
    je %v_28, b_32, b_33
  }

  b_33 {
    call_complex teardown(Maybe(Traced)), %v_30
    jmp b_34
  }

  b_32 {
    jmp b_34
  }

  b_34 {
    %v_35 = phi [b_33, 1], [b_32, 0]: I32
    %v_36 = phi [b_33, 0], [b_32, %v_29]: I32
    store %v_1, %v_35, 1
    %v_37 = add %v_1, 4: Ptr
    store %v_37, %v_36, 4
    je %v_35, b_11, b_7
  }

  b_10 {
    jmp b_38
  }

  b_9 {
    jmp b_38
  }

  b_38 {
    %v_39 = phi [b_10, 0], [b_9, 1]: I32
    %v_40 = phi [b_10, 0], [b_9, %b]: I32
    %v_41 = alloca 8, 4: Ptr
    store %v_41, %v_39, 1
    %v_42 = add %v_41, 4: Ptr
    store %v_42, %v_40, 4
    je %v_39, b_43, b_44
  }

  b_44 {
    call_complex teardown(Maybe(Traced)), %v_41
    jmp b_45
  }

  b_43 {
    jmp b_45
  }

  b_45 {
    %v_46 = phi [b_44, 1], [b_43, 0]: I32
    %v_47 = phi [b_44, 0], [b_43, %v_40]: I32
    store %v_2, %v_46, 1
    %v_48 = add %v_2, 4: Ptr
    store %v_48, %v_47, 4
    %v_17 = load %v_37, 4: I32
    je %v_46, b_16, b_12
  }

  b_15 {
    jmp b_49
  }

  b_14 {
    jmp b_49
  }

  b_49 {
    %v_50 = phi [b_15, 0], [b_14, 1]: I32
    %v_51 = phi [b_15, 0], [b_14, %c]: I32
    %v_52 = alloca 8, 4: Ptr
    store %v_52, %v_50, 1
    %v_53 = add %v_52, 4: Ptr
    store %v_53, %v_51, 4
    je %v_50, b_54, b_55
  }

  b_55 {
