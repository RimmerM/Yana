main<complex>(): I32 {
  b_0 {
    call_complex Token.drop, 10
    call_complex Token.drop, 10
    %v_1 = alloca 8, 4: Ptr
    %v_2 = alloca 8, 4: Ptr
    %v_3 = alloca 8, 4: Ptr
    %v_4 = alloca 8, 4: Ptr
    %v_5 = add %v_4, 4: Ptr
    store %v_5, 1, 4
    store %v_4, 1, 1
    %v_6 = load %v_5, 4: I32
    store %v_1, 0, 1
    %v_7 = add %v_1, 4: Ptr
    store %v_7, %v_6, 4
    %v_8 = alloca 8, 4: Ptr
    %v_9 = add %v_8, 4: Ptr
    store %v_9, 2, 4
    store %v_8, 1, 1
    %v_10 = load %v_9, 4: I32
    store %v_2, 0, 1
    %v_11 = add %v_2, 4: Ptr
    store %v_11, %v_10, 4
    %v_12 = load %v_7, 4: I32
    %v_13 = alloca 8, 4: Ptr
    store %v_13, 0, 1
    call_complex teardown(Maybe(Traced)), %v_13
    store %v_3, 1, 1
    %v_14 = add %v_3, 4: Ptr
    store %v_14, 0, 4
    %v_15 = load %v_11, 4: I32
    call_complex teardown(Outcome(Traced, {})), %v_3
    call_complex Traced.drop, %v_12
    call_complex Traced.drop, %v_15
    %v_16 = loads @trace, 4: I32
    store @trace, 0, 4
    %v_17, %v_18 = call_complex nested, 1, 2, 0: I32, I32
    %v_19 = loads @trace, 4: I32
    store @trace, 0, 4
