main<complex>(): I32 {
  b_0 {
    call_complex Token.drop, 10
    call_complex Token.drop, 10
    %v_1 = alloca 8, 4: Ptr
    %v_2 = alloca 8, 4: Ptr
    %v_3 = alloca 8, 4: Ptr
    store %v_1, 0, 1
    %v_4 = add %v_1, 4: Ptr
    store %v_4, 1, 4
    store %v_2, 0, 1
    %v_5 = add %v_2, 4: Ptr
    store %v_5, 2, 4
    %v_6 = load %v_4, 4: I32
    %v_7 = alloca 8, 4: Ptr
    store %v_7, 0, 1
    call_complex teardown(Maybe(Traced)), %v_7
    store %v_3, 1, 1
    %v_8 = add %v_3, 4: Ptr
    store %v_8, 0, 4
    %v_9 = load %v_5, 4: I32
    call_complex teardown(Outcome(Traced, {})), %v_3
    call_complex Traced.drop, %v_6
    call_complex Traced.drop, %v_9
    %v_10 = loads @trace, 4: I32
    store @trace, 0, 4
    %v_11, %v_12 = call_complex nested, 1, 2, 0: I32, I32
    %v_13 = loads @trace, 4: I32
    store @trace, 0, 4
    store @trace, 1, 4
    %v_14 = imm 12: I32
    store @trace, %v_14, 4
    %v_15 = loads @dropped, 4: I32
    %v_16 = imul %v_15, 10000000: I32
    %v_17 = imul %v_10, 100000: I32
    %v_18 = add %v_16, %v_17: I32
    %v_19 = imul %v_13, 1000: I32
    %v_20 = add %v_18, %v_19: I32
    %v_21 = add %v_20, %v_14: I32
    ret %v_21
  }
}

teardown(Maybe(Traced))<complex>(%v_0: Ptr) {
  b_1 {
    %v_2 = load %v_0, 1: I32
    %v_3 = cmp_eq %v_2, 1: I32
    je %v_3, b_4, b_5
  }

  b_6 {
    ret 
  }

  b_4 {
    %v_7 = add %v_0, 4: Ptr
    %v_8 = load %v_7, 4: I32
    call_complex Traced.drop, %v_8
    jmp b_6
  }

  b_5 {
    jmp b_6
