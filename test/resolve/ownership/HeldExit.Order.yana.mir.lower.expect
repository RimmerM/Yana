  }

  b_54 {
    jmp b_56
  }

  b_56 {
    %v_57 = phi [b_55, 1], [b_54, 0]: I32
    %v_20 = phi [b_55, 0], [b_54, %v_51]: I32
    store %v_3, %v_57, 1
    %v_58 = add %v_3, 4: Ptr
    store %v_58, %v_20, 4
    %v_19 = load %v_48, 4: I32
