mut @dropped = [0, 0, 0, 0]
mut @trace = [0, 0, 0, 0]

Traced.drop<complex>(%v_0: I32) {
  b_1 {
    %v_2 = loads @trace, 4: I32
    %v_3 = imul %v_2, 10: I32
    %v_4 = add %v_3, %v_0: I32
    store @trace, %v_4, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = loads @dropped, 4: I32
    %v_2 = add %v_1, 10: I32
    store @dropped, %v_2, 4
    %v_3 = add %v_1, 20: I32
    store @dropped, %v_3, 4
    %v_4 = alloca 8, 4: Ptr
    %v_5 = alloca 8, 4: Ptr
    store %v_5, 0, 1
    call_complex teardown(Maybe(Traced)), %v_5
    store %v_4, 1, 1
    call_complex teardown(Outcome(Traced, {})), %v_4
    call_complex Traced.drop, 1
    call_complex Traced.drop, 2
    %v_6 = loads @trace, 4: I32
    store @trace, 0, 4
    %v_7 = alloca 8, 4: Ptr
    %v_8 = alloca 8, 4: Ptr
    store %v_8, 0, 1
    call_complex teardown(Maybe(Traced)), %v_8
    store %v_7, 1, 1
    call_complex teardown(Outcome(Traced, {})), %v_7
    call_complex Traced.drop, 1
    call_complex Traced.drop, 2
    %v_9 = loads @trace, 4: I32
    store @trace, 0, 4
    store @trace, 1, 4
    %v_10 = imm 12: I32
    store @trace, %v_10, 4
    %v_11 = loads @dropped, 4: I32
    %v_12 = imul %v_11, 10000000: I32
    %v_13 = imul %v_6, 100000: I32
    %v_14 = add %v_12, %v_13: I32
    %v_15 = imul %v_9, 1000: I32
    %v_16 = add %v_14, %v_15: I32
    %v_17 = add %v_16, %v_10: I32
    ret %v_17
  }
}

teardown(Maybe(Traced))<complex>(%v_0: Ptr) {
  b_1 {
    %v_2 = load %v_0, 1: I32
    %v_3 = cmp_eq %v_2, 1: I32
    je %v_3, b_4, b_5
  }

  b_6 {
    ret 
  }

  b_4 {
    %v_7 = add %v_0, 4: Ptr
    %v_8 = load %v_7, 4: I32
    call_complex Traced.drop, %v_8
    jmp b_6
  }

  b_5 {
    jmp b_6
  }
}

teardown(Outcome(Traced, {}))<complex>(%v_0: Ptr) {
  b_1 {
    %v_2 = load %v_0, 1: I32
    %v_3 = cmp_eq %v_2, 0: I32
    je %v_3, b_4, b_5
  }

  b_6 {
    ret 
  }

  b_4 {
    %v_7 = add %v_0, 4: Ptr
    %v_8 = load %v_7, 4: I32
    call_complex Traced.drop, %v_8
    jmp b_6
  }

  b_5 {
    jmp b_6
  }
}

