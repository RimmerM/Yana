mut @dropped = [0, 0, 0, 0]
mut @trace = [0, 0, 0, 0]

Token.drop<complex>(%v_0: I32) {
  b_1 {
    %v_2 = loads @dropped, 4: I32
    %v_3 = add %v_2, %v_0: I32
    store @dropped, %v_3, 4
    ret 
  }
}

Traced.drop<complex>(%v_0: I32) {
  b_1 {
    %v_2 = loads @trace, 4: I32
    %v_3 = imul %v_2, 10: I32
    %v_4 = add %v_3, %v_0: I32
    store @trace, %v_4, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    call_complex Token.drop, 10
    call_complex Token.drop, 10
    %v_1 = alloca 8, 4: Ptr
    %v_2 = alloca 8, 4: Ptr
    %v_3 = alloca 8, 4: Ptr
    store %v_1, 0, 1
    %v_4 = add %v_1, 4: Ptr
    store %v_4, 1, 4
    store %v_2, 0, 1
    %v_5 = add %v_2, 4: Ptr
    store %v_5, 2, 4
    %v_6 = load %v_4, 4: I32
    %v_7 = alloca 8, 4: Ptr
    store %v_7, 0, 1
    call_complex teardown(Maybe(Traced)), %v_7
    store %v_3, 1, 1
    %v_8 = add %v_3, 4: Ptr
    store %v_8, 0, 4
    %v_9 = load %v_5, 4: I32
    call_complex teardown(Outcome(Traced, {})), %v_3
    call_complex Traced.drop, %v_6
    call_complex Traced.drop, %v_9
    %v_10 = loads @trace, 4: I32
    store @trace, 0, 4
    %v_11 = alloca 8, 4: Ptr
    %v_12 = alloca 8, 4: Ptr
    %v_13 = alloca 8, 4: Ptr
    store %v_11, 0, 1
    %v_14 = add %v_11, 4: Ptr
    store %v_14, 1, 4
    store %v_12, 0, 1
    %v_15 = add %v_12, 4: Ptr
    store %v_15, 2, 4
    %v_16 = load %v_14, 4: I32
    %v_17 = alloca 8, 4: Ptr
    store %v_17, 0, 1
    call_complex teardown(Maybe(Traced)), %v_17
    store %v_13, 1, 1
    %v_18 = add %v_13, 4: Ptr
    store %v_18, 0, 4
    %v_19 = load %v_15, 4: I32
    call_complex teardown(Outcome(Traced, {})), %v_13
    call_complex Traced.drop, %v_16
    call_complex Traced.drop, %v_19
    %v_20 = loads @trace, 4: I32
    store @trace, 0, 4
    store @trace, 1, 4
    %v_21 = imm 12: I32
    store @trace, %v_21, 4
    %v_22 = loads @dropped, 4: I32
    %v_23 = imul %v_22, 10000000: I32
    %v_24 = imul %v_10, 100000: I32
    %v_25 = add %v_23, %v_24: I32
    %v_26 = imul %v_20, 1000: I32
    %v_27 = add %v_25, %v_26: I32
    %v_28 = add %v_27, %v_21: I32
    ret %v_28
  }
}

teardown(Maybe(Traced))<complex>(%v_0: Ptr) {
  b_1 {
    %v_2 = load %v_0, 1: I32
    %v_3 = cmp_eq %v_2, 1: I32
    je %v_3, b_4, b_5
  }

  b_6 {
    ret 
  }

  b_4 {
    %v_7 = add %v_0, 4: Ptr
    %v_8 = load %v_7, 4: I32
    call_complex Traced.drop, %v_8
    jmp b_6
  }

  b_5 {
    jmp b_6
  }
}

teardown(Outcome(Traced, {}))<complex>(%v_0: Ptr) {
  b_1 {
    %v_2 = load %v_0, 1: I32
    %v_3 = cmp_eq %v_2, 0: I32
    je %v_3, b_4, b_5
  }

  b_6 {
    ret 
  }

  b_4 {
    %v_7 = add %v_0, 4: Ptr
    %v_8 = load %v_7, 4: I32
    call_complex Traced.drop, %v_8
    jmp b_6
  }

  b_5 {
    jmp b_6
  }
}

