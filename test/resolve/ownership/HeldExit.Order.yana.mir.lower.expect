    jmp b_35
  }

  b_33 {
    %v_36 = load %v_32, 4: I32
    jmp b_35
  }

  b_35 {
    %v_37 = phi [b_34, 1], [b_33, 0]: I32
    %v_38 = phi [b_34, 0], [b_33, %v_36]: I32
    store %v_1, %v_37, 1
    %v_39 = add %v_1, 4: Ptr
    store %v_39, %v_38, 4
    je %v_37, b_11, b_7
  }

  b_10 {
    jmp b_40
  }

  b_9 {
    jmp b_40
  }

  b_40 {
    %v_41 = phi [b_10, 0], [b_9, 1]: I32
    %v_42 = phi [b_10, 0], [b_9, %b]: I32
    %v_43 = alloca 8, 4: Ptr
    store %v_43, %v_41, 1
    %v_44 = add %v_43, 4: Ptr
    store %v_44, %v_42, 4
    je %v_41, b_45, b_46
  }

  b_46 {
