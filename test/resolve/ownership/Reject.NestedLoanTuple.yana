{-
   A tuple holding a record that holds a loan - the `NestedBorrow` refusal, at the one aggregate
   that has no name for the sentence to start with.

   It used to print " holds a Store, which refers to storage the record does not name", the empty
   name being the tuple's.
-}
data Cell {value: Int}
data Store {held: kept'Cell}

fn main() -> Int:
    let c = Cell {value: 1}
    let pair = {inner: Store {held: c}, n: 2}
    return pair.n
