module ResolveTest

data P {a: @bits(20) I32, b: @bits(20) I32, c: Bool}

data Box {x: P, flag: Bool, ok: Bool}

fn setFlag(x: a [unique call]) -> {} {
  form erased
  slot #0 type a
  slot #1 property a.flag
bb0:
  %0: Bool = read copy.trivial (x.flag)
  %1: Bool = not inspect %0
  write.assign borrow.unique (x.flag) take %1
  return
}

fn getFlag(x: a [shared call]) -> Bool {
  form erased
  slot #0 type a
  slot #1 property a.flag
bb0:
  %0: Bool = read copy.trivial (x.flag)
  return take %0
}

fn main() -> I32 {
  local & by: Box

bb0:
  %0: @bits(20) I32 = const 1
  %1: @bits(20) I32 = const 2
  %2: Bool = const False
  %3: P = aggregate.P take %0 take %1 take %2
  %4: Bool = const False
  %5: Bool = const False
  %6: Box = aggregate.Box take %3 take %4 take %5
  write.init borrow.unique (by) take %6
  %8: Box [unique call] = read borrow.unique (by) loan0
  %9: {} = call setFlag(Box) borrow.unique %8
  %10: Bool = read copy.trivial (by.flag)
  %11: Bool = not inspect %10
  branch inspect %11 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %16: Box = read copy.trivial (by)
  %17: Bool = call getFlag(Box) borrow.shared %16
  %18: Bool = not inspect %17
  branch inspect %18 -> bb6 -> bb4

bb3:
  %13: I32 = const 1
  return take %13

bb4:
  jump -> bb5

bb5:
  %23: Bool = read copy.trivial (by.ok)
  branch inspect %23 -> bb9 -> bb7

bb6:
  %20: I32 = const 2
  return take %20

bb7:
  %26: @bits(20) I32 = read copy.trivial (by.x.a)
  %27: I32 = convert inspect %26
  %28: I32 = const 1
  %29: Bool = ne inspect %27 inspect %28
  jump -> bb8(take %29)

bb8(%30: Bool):
  branch inspect %30 -> bb12 -> bb10

bb9:
  %25: Bool = const True
  jump -> bb8(take %25)

bb10:
  %35: @bits(20) I32 = read copy.trivial (by.x.b)
  %36: I32 = convert inspect %35
  %37: I32 = const 2
  %38: Bool = ne inspect %36 inspect %37
  jump -> bb11(take %38)

bb11(%39: Bool):
  branch inspect %39 -> bb15 -> bb13

bb12:
  %34: Bool = const True
  jump -> bb11(take %34)

bb13:
  %44: Bool = read copy.trivial (by.x.c)
  jump -> bb14(take %44)

bb14(%45: Bool):
  branch inspect %45 -> bb18 -> bb16

bb15:
  %43: Bool = const True
  jump -> bb14(take %43)

bb16:
  jump -> bb17

bb17:
  %52: Bool = const False
  write.assign borrow.unique (by.flag) take %52
  %54: Box = read copy.trivial (by)
  %55: Bool = call getFlag(Box) borrow.shared %54
  branch inspect %55 -> bb21 -> bb19

bb18:
  %49: I32 = const 3
  return take %49

bb19:
  jump -> bb20

bb20:
  %60: Bool = const True
  write.assign borrow.unique (by.ok) take %60
  %62: Box [unique call] = read borrow.unique (by) loan1
  %63: {} = call setFlag(Box) borrow.unique %62
  %64: Box = read copy.trivial (by)
  %65: Bool = call getFlag(Box) borrow.shared %64
  %66: Bool = not inspect %65
  branch inspect %66 -> bb24 -> bb22

bb21:
  %57: I32 = const 4
  return take %57

bb22:
  %69: Bool = read copy.trivial (by.ok)
  %70: Bool = not inspect %69
  jump -> bb23(take %70)

bb23(%71: Bool):
  branch inspect %71 -> bb27 -> bb25

bb24:
  %68: Bool = const True
  jump -> bb23(take %68)

bb25:
  %76: Bool = read copy.trivial (by.flag)
  %77: Bool = not inspect %76
  jump -> bb26(take %77)

bb26(%78: Bool):
  branch inspect %78 -> bb30 -> bb28

bb27:
  %75: Bool = const True
  jump -> bb26(take %75)

bb28:
  jump -> bb29

bb29:
  %85: I32 = const 0
  return take %85

bb30:
  %82: I32 = const 5
  return take %82
}

entry main
