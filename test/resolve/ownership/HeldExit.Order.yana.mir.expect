lens fn around($body: (->{}) -> $r [shared call]) -> $r {
  form specialized
  slot #0 type $r
  local $yielded: $r

bb0:
  %0: {} = const {}
  %1: (->{}) -> $r [shared call] = read borrow.shared ($body) loan0
  %2: $r = call inspect %1 take {}
  write.init borrow.unique ($yielded) take %2
  %4: $r = read take ($yielded)
  return take %4
}

