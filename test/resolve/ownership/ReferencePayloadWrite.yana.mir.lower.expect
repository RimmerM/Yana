
main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    store %v_1, 5, 4
    %v_2 = bitcast %v_1: I64
    %v_3 = cmp_neq %v_2, 0: I32
    je %v_3, b_4, b_5
  }

  b_5 {
    jmp b_6
  }

  b_4 {
    %v_7 = imm 42: I32
