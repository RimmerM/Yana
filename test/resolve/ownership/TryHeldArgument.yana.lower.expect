@image$base = []
mut @dropped = [0, 0, 0, 0]

Try(Maybe(a), a, ()).toOutcome(Token)<complex>(%v_0: Ptr, %value: Ptr) {
  b_1 {
    %v_2 = loads %value, 4: I32
    %v_3 = cmp_eq %v_2, 1: I32
    je %v_3, b_4, b_5
  }

  b_5 {
    %v_6 = alloca 8, 4: Ptr
    store %v_6, 1, 4
    jmp b_7
  }

  b_4 {
    %v_8 = add %value, 4: Ptr
    %inner = alloca 4, 4: Ptr
    copy %inner, %v_8, 4
    %v_9 = alloca 8, 4: Ptr
    store %v_9, 0, 4
    %v_10 = add %v_9, 4: Ptr
    copy %v_10, %inner, 4
    jmp b_7
  }

  b_7 {
    %v_11 = phi [b_4, %v_9], [b_5, %v_6]: Ptr
    copy %v_0, %v_11, 8
    ret 
  }
}

token<complex>(%v_0: Ptr, %n: I32) {
  b_1 {
    %v_2 = cmp_igt %n, 0: I32
    je %v_2, b_3, b_4
  }

  b_3 {
    %v_5 = alloca 8, 4: Ptr
    store %v_5, 1, 4
    %v_6 = add %v_5, 4: Ptr
    store %v_6, %n, 4
    jmp b_7
  }

  b_4 {
    %v_8 = alloca 8, 4: Ptr
    store %v_8, 0, 4
    jmp b_7
  }

  b_7 {
    %v_9 = phi [b_3, %v_5], [b_4, %v_8]: Ptr
    copy %v_0, %v_9, 8
    ret 
  }
}

combine<complex>(%x: Ptr, %y: Ptr): I32 {
  b_0 {
    %v_1 = loads %x, 4: I32
    %v_2 = loads @dropped, 4: I32
    %v_3 = loads %y, 4: I32
    %v_4 = add %v_2, 2: I32
    store @dropped, %v_4, 4
    %v_5 = add %v_1, %v_3: I32
    ret %v_5
  }
}

paired<complex>(%v_0: Ptr, %a: I32, %b: I32) {
  b_1 {
    %v_2 = alloca 8, 4: Ptr
    call_complex token, %v_2, %a
    %v_3 = alloca 8, 4: Ptr
    call_complex Try(Maybe(a), a, ()).toOutcome(Token), %v_3, %v_2
    %v_4 = loads %v_3, 4: I32
    %v_5 = cmp_eq %v_4, 1: I32
    je %v_5, b_6, b_7
  }

  b_7 {
    %v_8 = alloca 8, 4: Ptr
    call_complex token, %v_8, %b
    %v_9 = alloca 8, 4: Ptr
    call_complex Try(Maybe(a), a, ()).toOutcome(Token), %v_9, %v_8
    %v_10 = loads %v_9, 4: I32
    %v_11 = cmp_eq %v_10, 1: I32
    je %v_11, b_12, b_13
  }

  b_13 {
    %v_14 = add %v_3, 4: Ptr
    %v_15 = add %v_9, 4: Ptr
    %v_16 = call_complex combine, %v_14, %v_15: I32
    store %v_0, 1, 4
    %v_17 = add %v_0, 4: Ptr
    store %v_17, %v_16, 4
    ret 
  }

  b_6 {
    call_complex drop$Outcome(Token, ()), %v_3
    %v_18 = alloca 1, 1: Ptr
    store %v_0, 0, 4
    ret 
  }

  b_12 {
    call_complex drop$Outcome(Token, ()), %v_3
    call_complex drop$Outcome(Token, ()), %v_9
    %v_19 = alloca 1, 1: Ptr
    store %v_0, 0, 4
    ret 
  }
}

matched<complex>(%v_0: Ptr, %a: I32, %b: I32) {
  b_1 {
    %v_2 = alloca 4, 4: Ptr
    store %v_2, %a, 4
    %v_3 = cmp_igt %b, 0: I32
    je %v_3, b_4, b_5
  }

  b_5 {
    %v_6 = alloca 8, 4: Ptr
    store %v_6, 0, 4
    jmp b_7
  }

  b_4 {
    %v_8 = alloca 8, 4: Ptr
    store %v_8, 1, 4
    %v_9 = add %v_8, 4: Ptr
    store %v_9, %b, 4
    jmp b_7
  }

  b_7 {
    %v_10 = phi [b_4, %v_8], [b_5, %v_6]: Ptr
    %v_11 = loads %v_10, 4: I32
    %v_12 = cmp_eq %v_11, 1: I32
    je %v_12, b_13, b_14
  }

  b_14 {
    %v_15 = loads @dropped, 4: I32
    %v_16 = add %v_15, 1: I32
    store @dropped, %v_16, 4
    store %v_0, 0, 4
    ret 
  }

  b_13 {
    %v_17 = add %v_10, 4: Ptr
    %n = loads %v_17, 4: I32
    %v_18 = alloca 4, 4: Ptr
    store %v_18, %n, 4
    %v = call_complex combine, %v_2, %v_18: I32
    store %v_0, 1, 4
    %v_19 = add %v_0, 4: Ptr
    store %v_19, %v, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    %p = alloca 8, 4: Ptr
    call_complex paired, %p, 3, 4
    %q = alloca 8, 4: Ptr
    call_complex paired, %q, 3, 18446744073709551615
    %m = alloca 8, 4: Ptr
    call_complex matched, %m, 3, 4
    %n = alloca 8, 4: Ptr
    call_complex matched, %n, 3, 18446744073709551615
    jmp b_1
  }

  b_1 {
    %v_2 = phi [b_0, 0], [b_3, %v_4]: I32
    %v_5 = phi [b_0, 1], [b_3, %v_6]: I32
    %v_7 = cmp_neq %v_5, 4294967294: I32
    je %v_7, b_8, b_9
  }

  b_8 {
    %v_10 = alloca 4, 4: Ptr
    store %v_10, 3, 4
    %v_11 = cmp_igt %v_5, 0: I32
    je %v_11, b_12, b_13
  }

  b_13 {
    %v_14 = alloca 8, 4: Ptr
    store %v_14, 0, 4
    jmp b_15
  }

  b_12 {
    %v_16 = alloca 8, 4: Ptr
    store %v_16, 1, 4
    %v_17 = add %v_16, 4: Ptr
    store %v_17, %v_5, 4
    jmp b_15
  }

  b_15 {
    %v_18 = phi [b_12, %v_16], [b_13, %v_14]: Ptr
    %v_19 = load %v_18, 4: I32
    %v_20 = add %v_18, 4: Ptr
    %v_21 = load %v_20, 4: I32
    %v_22 = cmp_eq %v_19, 1: I32
    je %v_22, b_3, b_23
  }

  b_23 {
    %v_24 = loads @dropped, 4: I32
    %v_25 = add %v_24, 1: I32
    store @dropped, %v_25, 4
    jmp b_9
  }

  b_9 {
    %v_26 = loads @dropped, 4: I32
    ret %v_26
  }

  b_3 {
    %v_27 = alloca 4, 4: Ptr
    store %v_27, %v_21, 4
    %v_28 = call_complex combine, %v_10, %v_27: I32
    %v_4 = add %v_2, %v_28: I32
    %v_6 = add %v_5, 4294967295: I32
    jmp b_1
  }
}

drop$Outcome(Token, ())<complex>(%value: Ptr) {
  b_0 {
    %v_1 = loads %value, 4: I32
    %v_2 = cmp_eq %v_1, 0: I32
    je %v_2, b_3, b_4
  }

  b_5 {
    ret 
  }

  b_3 {
    %v_6 = loads @dropped, 4: I32
    %v_7 = add %v_6, 1: I32
    store @dropped, %v_7, 4
    jmp b_5
  }

  b_4 {
    jmp b_5
  }
}

