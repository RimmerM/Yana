mut @dropped = [0, 0, 0, 0]
mut @closed = [0, 0, 0, 0]

Token.drop<complex>(%v_0: I32) {
  b_1 {
    %v_2 = loads @dropped, 4: I32
    %v_3 = add %v_2, %v_0: I32
    store @dropped, %v_3, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    call_complex Token.drop, 10
    %v_1 = loads @closed, 4: I32
    %v_2 = add %v_1, 1: I32
    store @closed, %v_2, 4
    %v_3 = alloca 4, 4: Ptr
    call_complex Token.drop, 10
    call_complex Token.drop, 3
    %v_4 = imm 20: I32
    jmp b_5
  }

  b_6 {
    %v_7 = phi [b_8, 25], [b_9, 0]: I32
    %v_10 = loads @dropped, 4: I32
    %v_11 = imul %v_10, 100: I32
    %v_12 = loads @closed, 4: I32
    %v_13 = add %v_11, %v_12: I32
    %v_14 = add %v_13, 13: I32
    %v_15 = add %v_14, %v_7: I32
    ret %v_15
  }

  b_8 {
    call_complex Token.drop, %v_4
    call_complex Token.drop, 5
    jmp b_6
  }

  b_16 {
    %v_17 = cmp_eq %v_18, 1: I32
    je %v_17, b_9, b_5
  }

  b_5 {
    %v_19 = phi [b_16, %v_18], [b_0, 0]: I32
    %v_18 = add %v_19, 1: I32
    %v_20 = cmp_ilt %v_18, 3: I32
    je %v_20, b_16, b_8
  }

  b_9 {
    call_complex Token.drop, %v_4
    jmp b_6
  }
}

