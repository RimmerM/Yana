  b_0 {
    %v_1 = alloca 8, 8: Ptr
    store %v_1, %address, 8
    %v_2 = load @heapWindowBase, 8: Ptr
    %v_3 = call_complex isNull(U8), %v_2: I32
    je %v_3, b_4, b_5
  }

  b_5 {
    jmp b_6
  }

  b_6 {
    %v_7 = load %v_1, 8: Ptr
    %v_8 = load @heapWindowBase, 8: Ptr
    %v_9 = cmp_lt %v_7, %v_8: I32
    je %v_9, b_10, b_11
  }

  b_4 {
    ret 0
  }

  b_11 {
    jmp b_12
  }

  b_12 {
    %v_13 = load %v_1, 8: Ptr
    %v_14 = load @heapWindowLimit, 8: Ptr
    %v_15 = cmp_lt %v_13, %v_14: I32
    ret %v_15
  }

  b_10 {
    ret 0
  }
}

isNull(%U8)<complex>(%it: Ptr): I32 {
  b_0 {
    %v_1 = alloca 8, 8: Ptr
    store %v_1, %it, 8
    %v_2 = load %v_1, 8: Ptr
    %v_3 = call_complex %a.Size.bitcast(%U8), %v_2: I64
    %v_4 = cmp_eq %v_3, 0: I32
    ret %v_4
  }
}

null(U8)<complex>(): Ptr {
  b_0 {
    %v_1 = call_complex Size.%a.bitcast(U8), 0: Ptr
    ret %v_1
  }
}

isNull(U8)<complex>(%it: Ptr): I32 {
  b_0 {
    %v_1 = alloca 8, 8: Ptr
    store %v_1, %it, 8
    %v_2 = load %v_1, 8: Ptr
    %v_3 = call_complex %a.Size.bitcast(U8), %v_2: I64
    %v_4 = cmp_eq %v_3, 0: I32
    ret %v_4
  }
}

box(Cell)<complex>(%v_0: Ptr) {
  b_1 {
    call_complex freeHeap, %v_0
    ret 
  }
}

box(Cell if heap)<complex>(%v_0: Ptr) {
  b_1 {
    %v_2 = call_complex isHeapAddress, %v_0: I32
    je %v_2, b_3, b_4
  }

  b_3 {
    call_complex freeHeap, %v_0
    jmp b_4
  }

  b_4 {
    ret 
  }
}

teardown(Holder)<complex>(%v_0: Ptr) {
  b_1 {
    %v_2 = load %v_0, 8: Ptr
    call_complex box(Cell), %v_2
    ret 
  }
}

