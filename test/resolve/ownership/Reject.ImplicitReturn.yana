{-
   The two ways the `=` form does not work out: a result type that cannot be inferred, and a body
   that has no result to return.

   # resolver: ownership

   `resolve/Reject.ImplicitReturn.yana` is the shipping stage's copy. The recursion half asserts the
   same two sentences; the unit half is written with a call rather than with an assignment, because
   an assignment in expression position is a form this stage does not read yet.
-}

-- Directly recursive. The body is what decides the result type, and the body is what is asking.
fn fact(n: Int) = if n <= 1 then 1 else n * fact(n - 1)

-- Mutually recursive, which is the same cycle with a step in it. Reported once, at the call that
-- closes the cycle, rather than once per function in it.
fn isEven(n: Int) = if n == 0 then True else isOdd(n - 1)
fn isOdd(n: Int) = if n == 0 then False else isEven(n - 1)

fn store(&x: Int, v: Int):
    x = v

-- A body that produces nothing. `=` says the function is this expression, so this is the block form
-- written with the wrong separator - it warns rather than erroring, since it does compile.
fn setIt(&x: Int) = store(x, 7)

-- The same body with the unit result written out is the author saying what the warning would, so it
-- is left alone.
fn setDeclared(&x: Int) -> {} = store(x, 7)

-- And the form the warning points at.
fn setBlock(&x: Int): store(x, 7)

fn main() -> Int:
    let &v = 1
    setIt(v)
    setDeclared(v)
    setBlock(v)
    return v + fact(3)
