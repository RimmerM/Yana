  %7: (I32) -> {} [owned here shape8 .0=shared call] = fun.value stated.lambda inspect %6 roots.0{0, 1}
  write.init borrow.unique (local2) take %7
  %9: (I32) -> {} [shared call shape8 .0=shared call] = read borrow.shared (local2) loan2 roots.0{0, 1}
  %10: I32 = const 9
  %11: {} = call apply borrow.shared %9 borrow.shared %10
  %12: I32 = read copy.trivial (box.n)
