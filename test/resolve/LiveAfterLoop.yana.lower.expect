@image$base = []

main<complex>(): I32 {
  b_0 {
    jmp b_1
  }

  b_2 {
    %v_3 = cmp_ilt %v_4, 4: I32
    je %v_3, b_1, b_5
  }

  b_5 {
    %v_6 = add %v_7, 42: I64
    jmp b_8
  }

  b_9 {
    %v_10 = cmp_ilt %v_11, 3: I32
    je %v_10, b_8, b_12
  }

  b_12 {
    %v_13 = add %v_6, %v_14: I64
    %v_15 = cast %v_13: I32
    ret %v_15
  }

  b_8 {
    %v_16 = phi [b_9, %v_17], [b_5, 10]: I64
    %v_18 = phi [b_9, %v_11], [b_5, 0]: I64
    %v_19 = phi [b_9, %v_14], [b_5, 0]: I64
    %v_14 = add %v_19, %v_16: I64
    %v_17 = add %v_16, 1: I64
    %v_11 = add %v_18, 1: I64
    jmp b_9
  }

  b_1 {
    %v_20 = phi [b_2, %v_7], [b_0, 10]: I64
    %v_21 = phi [b_2, %v_4], [b_0, 0]: I64
    %v_7 = add %v_20, 1: I64
    %v_4 = add %v_21, 1: I64
    jmp b_2
  }
}

