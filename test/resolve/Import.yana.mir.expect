  %0: Bool = const False
  %1: I32 = const 1
  %2: Style = aggregate.Style take %0 take %1
  %3: I32 = call styleValue borrow.shared %2
  %4: Bool = const True
  %5: I32 = const 3
  %6: Style = aggregate.Style take %4 take %5
  %7: I32 = call styleValue borrow.shared %6
  %8: I32 = add inspect %3 inspect %7
  return take %8
