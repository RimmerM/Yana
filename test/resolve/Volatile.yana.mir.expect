module ResolveTest

fn pointer(p: %U32 [shared call]) -> U32 {
  local first: U32

bb0:
  %0: %U32 = read copy.trivial (p)
  %1: U32 = read.volatile copy.trivial ([%%0])
  write.init borrow.unique (first) take %1
  %3: %U32 = read copy.trivial (p)
  %4: U32 = read copy.trivial (first)
  %5: U32 = const 1
  %6: U32 = add inspect %4 inspect %5
  write.assign.volatile borrow.unique ([%%3]) take %6
  %8: {} = const {}
  %9: %U32 = read copy.trivial (p)
  %10: U32 = read.volatile copy.trivial ([%%9])
  return take %10
}

fn discarded(p: %U32 [shared call], flag: Bool [shared call]) -> U32 {
  local ignored: U32

bb0:
  %0: Bool = read copy.trivial (flag)
  branch inspect %0 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %7: %U32 = read copy.trivial (p)
  %8: U32 = const 1
  write.assign.volatile borrow.unique ([%%7]) take %8
  %10: {} = const {}
  %11: U32 = const 0
  return take %11

bb3:
  %2: %U32 = read copy.trivial (p)
  %3: U32 = read.volatile copy.trivial ([%%2])
  write.init borrow.unique (ignored) take %3
  jump -> bb2
}

fn looped(p: %U32 [shared call], count: U32 [shared call]) -> U32 {
  local & i: U32
  local ignored: U32

bb0:
  %0: U32 = const 0
  write.init borrow.unique (i) take %0
  jump -> bb1

bb1:
  %3: U32 = read copy.trivial (i)
  %4: U32 = read copy.trivial (count)
  %5: Bool = lt inspect %3 inspect %4
  branch inspect %5 -> bb3 -> bb2

bb2:
  %15: U32 = read copy.trivial (i)
  return take %15

bb3:
  %7: %U32 = read copy.trivial (p)
  %8: U32 = read.volatile copy.trivial ([%%7])
  write.init borrow.unique (ignored) take %8
  %10: U32 = read copy.trivial (i)
  %11: U32 = const 1
  %12: U32 = add inspect %10 inspect %11
  write.assign borrow.unique (i) take %12
  jump -> bb1
}

fn atomic'2(p: %U8 [shared call]) -> U32 {
  local cell: Atomic(U32) [shared slot 0]
  local first: U32

bb0:
  %0: %U8 = read copy.trivial (p)
  %1: Atomic(U32) [shared slot 0] = read borrow.shared ([%%0]) loan0
  write.init borrow.unique (cell) borrow.shared %1
  %3: Atomic(U32) [shared slot 0] = read borrow.shared (cell) loan1 roots{0}
  %4: LoadOrder = const LoadAcquire
  %5: U32 = atomic.load acquire volatile inspect %3
  write.init borrow.unique (first) take %5
  %7: Atomic(U32) [shared slot 0] = read borrow.shared (cell) loan2 roots{0}
  %8: U32 = read copy.trivial (first)
  %9: U32 = const 1
  %10: U32 = add inspect %8 inspect %9
  %11: StoreOrder = const StoreRelease
  %12: {} = atomic.store release volatile inspect %7 inspect %10
  %13: Atomic(U32) [shared slot 0] = read borrow.shared (cell) loan3 roots{0}
  %14: LoadOrder = const LoadRelaxed
  %15: U32 = atomic.load relaxed volatile inspect %13
  return take %15
}

fn atomicSequential(p: %U8 [shared call]) -> U32 {
  local cell: Atomic(U32) [shared slot 0]

bb0:
  %0: %U8 = read copy.trivial (p)
  %1: Atomic(U32) [shared slot 0] = read borrow.shared ([%%0]) loan0
  write.init borrow.unique (cell) borrow.shared %1
  %3: Atomic(U32) [shared slot 0] = read borrow.shared (cell) loan1 roots{0}
  %4: U32 = const 1
  %5: StoreOrder = const StoreSequential
  %6: {} = atomic.store seqcst volatile inspect %3 inspect %4
  %7: Atomic(U32) [shared slot 0] = read borrow.shared (cell) loan2 roots{0}
  %8: LoadOrder = const LoadSequential
  %9: U32 = atomic.load seqcst volatile inspect %7
  return take %9
}
