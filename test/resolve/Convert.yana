-- Conversion is a class operation: `Widen` is lossless and happens on its own, `Narrow` is lossy
-- and has to be written as `truncate`. Both are selected by their *result* type, which is the case
-- that argument types alone cannot decide. `::` is not a conversion of its own - it selects a target
-- type, and it may widen - so every lossy step below is a call.

fn widened(value: Int) -> Long = widen(value)

fn truncated(value: Long) -> Int = truncate(value)

-- The same call with two different expected types picks two different instances.
fn toFloat(value: Int) -> Float = widen(value)
fn toDouble(value: Int) -> Double = widen(value)

-- The same direct float rungs for the unsigned 32- and 64-bit widths.
@noinline
fn unsignedToFloat(value: U32) -> Float = value
@noinline
fn unsignedToDouble(value: U32) -> Double = value
@noinline
fn unsignedLongToFloat(value: U64) -> Float = value
@noinline
fn unsignedLongToDouble(value: U64) -> Double = value

-- And the reverse narrowing rungs, selected by the result type.
@noinline
fn floatToUnsigned(value: Float) -> U32 = truncate(value)
@noinline
fn doubleToUnsigned(value: Double) -> U64 = truncate(value)
@noinline
fn floatToUnsignedLong(value: Float) -> U64 = truncate(value)
@noinline
fn doubleToUnsignedInt(value: Double) -> U32 = truncate(value)

@noinline fn notANumber() -> Double = 0.0 / 0.0

-- Values above the old signed conversion range, both directions, plus the shared saturation rules.
fn unsignedBoundaries() -> Int:
    if unsignedToDouble(0xFFFFFFFF :: U32) != 4294967295.0 then return 1
    if unsignedToFloat(0xFFFFFFFF :: U32) != 4294967296.0 then return 2
    if unsignedLongToDouble(0x8000000000000000 :: U64) != 9223372036854775808.0 then return 3
    if unsignedLongToFloat(0x8000000000000000 :: U64) != 9223372036854775808.0 then return 4

    if floatToUnsigned(4294967295.0 :: Float) != (0xFFFFFFFF :: U32) then return 5
    if doubleToUnsigned(9223372036854775808.0) != (0x8000000000000000 :: U64) then return 6

    if floatToUnsigned(-1.0 :: Float) != (0 :: U32) then return 7
    if doubleToUnsigned(-1.0) != (0 :: U64) then return 8
    if floatToUnsigned(1.0e30 :: Float) != (0xFFFFFFFF :: U32) then return 9
    if doubleToUnsigned(1.0e30) != (0xFFFFFFFFFFFFFFFF :: U64) then return 10
    if floatToUnsigned(truncate(notANumber()) :: Float) != (0 :: U32) then return 11
    if doubleToUnsigned(notANumber()) != (0 :: U64) then return 12

    if floatToUnsignedLong(9223372036854775808.0 :: Float) != (0x8000000000000000 :: U64) then return 13
    if doubleToUnsignedInt(4294967295.0) != (0xFFFFFFFF :: U32) then return 14
    if floatToUnsignedLong(-1.0 :: Float) != (0 :: U64) then return 15
    if doubleToUnsignedInt(-1.0) != (0 :: U32) then return 16
    if floatToUnsignedLong(1.0e30 :: Float) != (0xFFFFFFFFFFFFFFFF :: U64) then return 17
    if doubleToUnsignedInt(1.0e30) != (0xFFFFFFFF :: U32) then return 18
    if floatToUnsignedLong(truncate(notANumber()) :: Float) != (0 :: U64) then return 19
    if doubleToUnsignedInt(notANumber()) != (0 :: U32) then return 20
    return 0

-- An ascription supplies the expected type where nothing else does.
fn ascribed() -> Int = truncate(9.75 :: Double) :: Int

-- Implicit widening at a call boundary and at a return goes through Widen too: the resolver has
-- no numeric ladder of its own, only the question of which of the two classes has an instance.
fn takesLong(value: Long) -> Long = value

fn implicitArgument(value: Int) -> Long = takesLong(value)

fn implicitReturn(value: Int) -> Double = value

-- The same narrowing an implicit conversion would have refused, written out and therefore taken.
fn explicitNarrowing(value: Double) -> Int = truncate(value) :: Int

-- Every `truncate` here is selected by the ascription that follows it: nothing about a Long
-- argument says which of the narrowing instances was meant.
fn main() -> Int =
    (truncate(widened(3)) :: Int) +
    truncated(4) +
    (truncate(toFloat(5)) :: Int) +
    (truncate(toDouble(6)) :: Int) +
    (truncate(unsignedToFloat(10)) :: Int) +
    (truncate(unsignedToDouble(11)) :: Int) +
    (truncate(unsignedLongToFloat(12)) :: Int) +
    (truncate(unsignedLongToDouble(13)) :: Int) +
    ascribed() +
    (truncate(implicitArgument(7)) :: Int) +
    (truncate(implicitReturn(8)) :: Int) +
    explicitNarrowing(9.5) +
    (truncate(floatToUnsigned(14.5)) :: Int) +
    (truncate(doubleToUnsigned(15.5)) :: Int) +
    unsignedBoundaries()
