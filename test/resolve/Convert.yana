-- Conversion is a class operation: `Widen` is lossless and happens on its own, `Narrow` is lossy
-- and has to be written. Both are selected by their *result* type, which is the case that
-- argument types alone cannot decide.

fn widened(value: Int) -> Long = widen(value)

fn narrowed(value: Long) -> Int = narrow(value)

-- The same call with two different expected types picks two different instances.
fn toFloat(value: Int) -> Float = widen(value)
fn toDouble(value: Int) -> Double = widen(value)

-- An ascription supplies the expected type where nothing else does.
fn ascribed() -> Int = narrow(9.75 :: Double) :: Int

-- Implicit widening at a call boundary and at a return goes through Widen too: the resolver has
-- no numeric ladder of its own, only the question of which of the two classes has an instance.
fn takesLong(value: Long) -> Long = value

fn implicitArgument(value: Int) -> Long = takesLong(value)

fn implicitReturn(value: Int) -> Double = value

-- The same narrowing an implicit conversion would have refused, written out and therefore taken.
fn explicitNarrowing(value: Double) -> Int = narrow(value) :: Int

-- Every `narrow` here is selected by the ascription that follows it: nothing about a Long
-- argument says which of the narrowing instances was meant.
fn main() -> Int =
    (narrow(widened(3)) :: Int) +
    narrowed(4) +
    (narrow(toFloat(5)) :: Int) +
    (narrow(toDouble(6)) :: Int) +
    ascribed() +
    (narrow(implicitArgument(7)) :: Int) +
    (narrow(implicitReturn(8)) :: Int) +
    explicitNarrowing(9.5)
