mut @dropped = [0, 0, 0, 0]

Token.drop<complex>() {
  b_0 {
    %v_1 = loads @dropped, 4: I32
    %v_2 = add %v_1, 1: I32
    store @dropped, %v_2, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    store %v_1, 7, 4
    %v_2 = call_complex identify.lambda, %v_1: I32
    call_complex Token.drop
    %v_3 = add 15, %v_2: I32
    %v_4 = alloca 8, 4: Ptr
    store %v_4, 0, 1
    call_complex teardown(Maybe(Token)), %v_4
    %v_5 = add %v_3, 100: I32
    %v_6 = imul %v_5, 10: I32
    %v_7 = loads @dropped, 4: I32
    %v_8 = add %v_6, %v_7: I32
    ret %v_8
  }
}

@header(identify.lambda) = [0, 0, 0, 0]
identify.lambda<complex>(%t: Ptr): I32 {
  b_0 {
    %v_1 = loads %t, 4: I32
    ret %v_1
  }
}

teardown(Maybe(Token))<complex>(%v_0: Ptr) {
  b_1 {
    %v_2 = load %v_0, 1: I32
    %v_3 = cmp_eq %v_2, 1: I32
    je %v_3, b_4, b_5
  }

  b_6 {
    ret 
  }

  b_4 {
    call_complex Token.drop
    jmp b_6
  }

  b_5 {
    jmp b_6
  }
}

