mut @dropped = [0, 0, 0, 0]

Token.drop<complex>(%value: Ptr) {
  b_0 {
    %v_1 = loads @dropped, 4: I32
    %v_2 = add %v_1, 1: I32
    store @dropped, %v_2, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    store %v_1, 10, 4
    jmp b_2
  }

  b_3 {
    jmp b_4
  }

  b_4 {
    %v_5 = phi [b_3, 0], [b_6, %v_7]: I32
    jmp b_8
  }

  b_6 {
