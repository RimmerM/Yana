mut @dropped = [0, 0, 0, 0]

Token.drop<complex>(%v_0: I32) {
  b_1 {
    %v_2 = loads @dropped, 4: I32
    %v_3 = add %v_2, 1: I32
    store @dropped, %v_3, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    store %v_1, 10, 4
    %v_2 = loads %v_1, 4: I32
    %v_3 = add 4, %v_2: I32
    %v_4 = alloca 8, 4: Ptr
    store %v_4, 1, 1
    %v_5 = add %v_4, 4: Ptr
    store %v_5, %v_3, 4
    %v_6 = load %v_4, 1: I32
    %v_7 = cmp_eq %v_6, 1: I32
    je %v_7, b_8, b_9
  }

  b_9 {
    jmp b_10
  }

  b_10 {
    %v_11 = phi [b_9, 0], [b_8, %v_12]: I32
    %v_13 = alloca 8, 4: Ptr
    store %v_13, 0, 1
    %v_14 = load %v_13, 1: I32
    %v_15 = cmp_eq %v_14, 1: I32
    je %v_15, b_16, b_17
  }

  b_8 {
    %v_12 = loads %v_5, 4: I32
    jmp b_10
  }

  b_17 {
    jmp b_18
  }

  b_18 {
    %v_19 = phi [b_17, 1], [b_16, %v_20]: I32
    %v_21 = add %v_11, %v_19: I32
    %v_22 = alloca 8, 4: Ptr
    %v_23 = add %v_22, 4: Ptr
    store %v_23, 7, 4
    store %v_22, 1, 1
    %v_24 = alloca 4, 4: Ptr
    copy %v_24, %v_23, 4
    %v_25 = bitcast 0: Ptr
    %v_26 = call_complex identify.lambda, %v_25, %v_24: I32
    %v_27 = load %v_24, 4: I32
    call_complex Token.drop, %v_27
    %v_28 = alloca 8, 4: Ptr
    store %v_28, 1, 1
    %v_29 = add %v_28, 4: Ptr
    store %v_29, %v_26, 4
    %v_30 = load %v_28, 1: I32
    %v_31 = cmp_eq %v_30, 1: I32
    je %v_31, b_32, b_33
  }

  b_16 {
    %v_34 = add %v_13, 4: Ptr
    %v_20 = loads %v_34, 4: I32
    jmp b_18
  }

  b_33 {
    jmp b_35
  }

  b_35 {
    %v_36 = phi [b_33, 0], [b_32, %v_37]: I32
    %v_38 = add %v_21, %v_36: I32
    %v_39 = alloca 8, 4: Ptr
    store %v_39, 0, 1
    %v_40 = alloca 4, 4: Ptr
    call_complex teardown(Maybe(Token)), %v_39
    %v_41 = alloca 8, 4: Ptr
    store %v_41, 0, 1
    %v_42 = load %v_41, 1: I32
    %v_43 = cmp_eq %v_42, 1: I32
    je %v_43, b_44, b_45
  }

  b_32 {
    %v_46 = add %v_28, 4: Ptr
    %v_37 = loads %v_46, 4: I32
    jmp b_35
  }

  b_45 {
    jmp b_47
  }

  b_47 {
    %v_48 = phi [b_45, 100], [b_44, %v_49]: I32
    %v_50 = add %v_38, %v_48: I32
    %v_51 = imul %v_50, 10: I32
    %v_52 = loads @dropped, 4: I32
    %v_53 = add %v_51, %v_52: I32
    ret %v_53
  }

  b_44 {
    %v_54 = add %v_41, 4: Ptr
    %v_49 = loads %v_54, 4: I32
    jmp b_47
  }
}

offsetBy.lambda<complex>(%offsetBy.lambda.env: Ptr, %at: I32): I32 {
  b_0 {
    %v_1 = loads %offsetBy.lambda.env, 4: I32
    %v_2 = add %at, %v_1: I32
    ret %v_2
  }
}

identify.lambda<complex>(%identify.lambda.env: Ptr, %t: Ptr): I32 {
  b_0 {
    %v_1 = loads %t, 4: I32
    ret %v_1
  }
}

teardown(Maybe(Token))<complex>(%v_0: Ptr) {
  b_1 {
    %v_2 = load %v_0, 1: I32
    %v_3 = cmp_eq %v_2, 1: I32
    je %v_3, b_4, b_5
  }

  b_6 {
    ret 
  }

  b_4 {
    %v_7 = add %v_0, 4: Ptr
    %v_8 = load %v_7, 4: I32
    call_complex Token.drop, %v_8
    jmp b_6
  }

  b_5 {
    jmp b_6
  }
}

