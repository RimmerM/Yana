    %v_12 = phi [b_10, 1], [b_13, %v_14]: I32
    %v_15 = add %v_5, %v_12: I32
    %v_16 = alloca 8, 4: Ptr
    %v_17 = add %v_16, 4: Ptr
    store %v_17, 7, 4
    store %v_16, 1, 1
    %v_18 = alloca 8, 8: Ptr
    store %v_18, 0, 8
    %v_19 = alloca 4, 4: Ptr
    jmp b_20
  }

  b_13 {
    %v_21 = add %v_22, 4: Ptr
    %v_14 = loads %v_21, 4: I32
    jmp b_11
  }

  b_23 {
    jmp b_24
  }

  b_24 {
    %v_25 = phi [b_23, 0], [b_26, %v_27]: I32
    %v_28 = add %v_15, %v_25: I32
    %v_29 = alloca 8, 4: Ptr
    store %v_29, 0, 1
    %v_30 = alloca 4, 4: Ptr
    jmp b_31
  }

  b_26 {
    %v_32 = add %v_33, 4: Ptr
    %v_27 = loads %v_32, 4: I32
    jmp b_24
  }

  b_34 {
    jmp b_35
  }

  b_35 {
    %v_36 = phi [b_34, 100], [b_37, %v_38]: I32
    %v_39 = add %v_28, %v_36: I32
    %v_40 = imul %v_39, 10: I32
    %v_41 = loads @dropped, 4: I32
    %v_42 = add %v_40, %v_41: I32
    ret %v_42
  }

  b_37 {
    %v_43 = add %v_44, 4: Ptr
    %v_38 = loads %v_43, 4: I32
    jmp b_35
  }

  b_2 {
    %v_45 = loads %v_1, 4: I32
    %v_46 = add 4, %v_45: I32
    %v_47 = alloca 8, 4: Ptr
    store %v_47, 1, 1
    %v_9 = add %v_47, 4: Ptr
    store %v_9, %v_46, 4
    jmp b_48
  }

  b_48 {
    %v_49 = load %v_47, 1: I32
    %v_50 = cmp_eq %v_49, 1: I32
    je %v_50, b_6, b_3
  }

  b_8 {
    %v_22 = alloca 8, 4: Ptr
    store %v_22, 0, 1
    jmp b_51
  }

  b_51 {
    %v_52 = load %v_22, 1: I32
    %v_53 = cmp_eq %v_52, 1: I32
    je %v_53, b_13, b_10
  }

  b_20 {
    copy %v_19, %v_17, 4
    %v_54 = load %v_18, 8: Ptr
    %v_55 = call_complex identify.lambda, %v_54, %v_19: I32
    call_complex Token.drop, %v_19
    %v_33 = alloca 8, 4: Ptr
    store %v_33, 1, 1
    %v_56 = add %v_33, 4: Ptr
