@image$base = []

tagOf<complex>(%m: Ptr): Int {
  b_0 {
    %v_1 = load %m, 1: Long
    %v_2 = cmp_le %v_1, 2: Int
    %v_3 = cmp_eq %v_2, 0: Int
    je %v_3, b_4, b_5
  }

  b_5 {
    je %v_2, b_6, b_7
  }

  b_4 {
    jmp b_8
  }

  b_7 {
    %v_9 = load %m, 1: Long
    %v_10 = cmp_le %v_9, 2: Int
    je %v_10, b_11, b_12
  }

  b_6 {
    %v_13 = load %m, 1: Int
    %v_14 = cast %v_13: Int
    %v_15 = cmp_eq %v_14, 0: Int
    je %v_15, b_16, b_7
  }

  b_16 {
    jmp b_8
  }

  b_12 {
    jmp b_8
  }

  b_11 {
    %v_17 = load %m, 1: Int
    %v_18 = cast %v_17: Int
    %v_19 = cmp_eq %v_18, 1: Int
    je %v_19, b_20, b_12
  }

  b_20 {
    jmp b_8
  }

  b_8 {
    %v_21 = phi [b_4, 0], [b_16, 1], [b_20, 2], [b_12, 3]: Int
    ret %v_21
  }
}

depthOf<complex>(%m: Ptr): Int {
  b_0 {
    %v_1 = load %m, 1: Long
    %v_2 = cmp_le %v_1, 3: Int
    %v_3 = cmp_eq %v_2, 0: Int
    je %v_3, b_4, b_5
  }

  b_5 {
    je %v_2, b_6, b_7
  }

  b_4 {
    jmp b_8
  }

  b_7 {
    %o = load %m, 1: Int
    %v_9 = alloca 1, 1: Ptr
    store %v_9, %o, 1
    %v_10 = call_complex tagOf, %v_9: Int
    %v_11 = add %v_10, 300: Int
    jmp b_8
  }

  b_6 {
    %v_12 = load %m, 1: Long
    %v_13 = cmp_le %v_12, 2: Int
    %v_14 = cmp_eq %v_13, 0: Int
    je %v_14, b_15, b_7
  }

  b_15 {
    jmp b_8
  }

  b_8 {
    %v_16 = phi [b_4, 100], [b_15, 200], [b_7, %v_11]: Int
    ret %v_16
  }
}

main<complex>(): Int {
  b_0 {
    %v_1 = alloca 1, 1: Ptr
    store %v_1, 3, 1
    %a = call_complex tagOf, %v_1: Int
    %v_2 = alloca 1, 1: Ptr
    store %v_2, 0, 1
    %b = call_complex tagOf, %v_2: Int
    %v_3 = alloca 1, 1: Ptr
    store %v_3, 2, 1
    %c = call_complex tagOf, %v_3: Int
    %v_4 = imul %b, 10: Int
    %v_5 = add %a, %v_4: Int
    %v_6 = imul %c, 100: Int
    %v_7 = add %v_5, %v_6: Int
    %v_8 = alloca 1, 1: Ptr
    store %v_8, 4, 1
    %outer = call_complex depthOf, %v_8: Int
    %v_9 = alloca 1, 1: Ptr
    store %v_9, 3, 1
    %middle = call_complex depthOf, %v_9: Int
    %v_10 = alloca 1, 1: Ptr
    store %v_10, 1, 1
    %inner = call_complex depthOf, %v_10: Int
    %v_11 = add %outer, %middle: Int
    %v_12 = add %v_11, %inner: Int
    %v_13 = add %v_7, %v_12: Int
    %v_14 = alloca 1, 1: Ptr
    store %v_14, 2, 1
    %v_15 = alloca 1, 1: Ptr
    store %v_15, 3, 1
    %v_16 = call_complex tagOf, %v_14: Int
    %v_17 = imul %v_16, 10: Int
    %v_18 = call_complex tagOf, %v_15: Int
    %v_19 = add %v_17, %v_18: Int
    %v_20 = add %v_13, %v_19: Int
    ret %v_20
  }
}

