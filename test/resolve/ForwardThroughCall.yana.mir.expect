module ResolveTest

let & tags: I32 = 0

let string'143: [CodeUnit *2] = "n="

let string'144: [CodeUnit *1] = "!"

let string'145: [CodeUnit *1] = "!"

let string'146: [CodeUnit *1] = "!"

fn tagged(n: I32 [shared call]) -> String {
  local & local1: String
  local local2: String

bb0:
  %0: I32 = read copy.trivial (global tags)
  %1: I32 = const 1
  %2: I32 = add inspect %0 inspect %1
  write.assign borrow.unique (global tags) take %2
  %4: Size = const 2
  %5: I32 = read copy.trivial (n)
  %6: Maybe(Size) = call showBound(I32) borrow.shared %5
  %7: Size = call formatBound borrow.shared %6
  %8: Size = add inspect %4 inspect %7
  %9: String = call String.ofCapacity borrow.shared %8
  write.init borrow.unique (local1) take %9
  %11: String [unique call] = read borrow.unique (local1) loan0
  %12: String = const String {units: Array {run: Run {items: &string'143, capacity: 2, ownsHeap: 0}, length: 2}}
  write.init borrow.unique (local2) take %12
  %14: String [shared slot 0] = read borrow.shared (local2) loan1
  %15: String [shared slot 0 view] = call.derivation view(String) borrow.shared %14 roots{1}
  %16: {} = call String.push borrow.unique %11 borrow.shared %15
  drop (local2)
  %17: I32 = read copy.trivial (n)
  %18: String [unique call] = read borrow.unique (local1) loan2
  %19: {} = call show(I32) borrow.shared %17 borrow.unique %18
  %20: String = read take (local1)
  return take %20
}

fn built(n: I32 [shared call]) -> I32 {
  local & text: String

bb0:
  %0: I32 = read copy.trivial (n)
  %1: String = call tagged borrow.shared %0
  write.init borrow.unique (text) take %1
  %3: String = read take (text)
  %4: String = const String {units: Array {run: Run {items: &string'144, capacity: 1, ownsHeap: 0}, length: 1}}
  %5: String = call ++(String) take %3 take %4
  write.reinit borrow.unique (text) take %5
  %7: String [shared call] = read borrow.shared (text) loan0
  %8: String [shared slot 0 view] = call.derivation view(String) borrow.shared %7 roots{0}
  %9: Size = call length(String) borrow.shared %8
  drop (text)
  %10: I32 = convert inspect %9
  return take %10
}

fn inLaterBlock(n: I32 [shared call]) -> I32 {
  local & text: String

bb0:
  %0: I32 = read copy.trivial (n)
  %1: String = call tagged borrow.shared %0
  write.init borrow.unique (text) take %1
  %3: I32 = read copy.trivial (n)
  %4: I32 = const 0
  %5: Bool = gt inspect %3 inspect %4
  branch inspect %5 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %13: String [shared call] = read borrow.shared (text) loan0
  %14: String [shared slot 0 view] = call.derivation view(String) borrow.shared %13 roots{0}
  %15: Size = call length(String) borrow.shared %14
  drop (text)
  %16: I32 = convert inspect %15
  return take %16

bb3:
  %7: String = read take (text)
  %8: String = const String {units: Array {run: Run {items: &string'145, capacity: 1, ownsHeap: 0}, length: 1}}
  %9: String = call ++(String) take %7 take %8
  write.reinit borrow.unique (text) take %9
  jump -> bb2
}

fn inLoop(n: I32 [shared call]) -> I32 {
  local & total: I32
  local & i: I32
  local & text: String

bb0:
  %0: I32 = const 0
  write.init borrow.unique (total) take %0
  %2: I32 = const 0
  write.init borrow.unique (i) take %2
  jump -> bb1

bb1:
  %5: I32 = read copy.trivial (i)
  %6: I32 = read copy.trivial (n)
  %7: Bool = lt inspect %5 inspect %6
  branch inspect %7 -> bb3 -> bb2

bb2:
  %28: I32 = read copy.trivial (total)
