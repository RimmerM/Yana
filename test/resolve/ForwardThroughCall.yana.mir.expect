bb3:
  %9: I32 = read copy.trivial (i)
  %10: String = call tagged borrow.shared %9
  write.init borrow.unique (text) take %10
  %12: String = read take (text)
  %13: String = const String {units: Array {run: Run {items: &string'146, capacity: 1, ownsHeap: 0}, length: 1}}
  %14: String = call ++(String) take %12 take %13
  write.reinit borrow.unique (text) take %14
  %16: I32 = read copy.trivial (total)
  %17: String [shared call] = read borrow.shared (text) loan0
  %18: String [shared slot 0 view] = call.derivation view(String) borrow.shared %17 roots{0}
  %19: Size = call length(String) borrow.shared %18
  drop (text)
  %20: I32 = convert inspect %19
  %21: I32 = add inspect %16 inspect %20
  write.assign borrow.unique (total) take %21
  %23: I32 = read copy.trivial (i)
  %24: I32 = const 1
  %25: I32 = add inspect %23 inspect %24
  write.assign borrow.unique (i) take %25
  jump -> bb1
}

