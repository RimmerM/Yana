  }

  b_51 {
    %v_63 = phi [b_55, %v_60], [b_42, 0]: I32
    %v_64 = phi [b_55, %v_57], [b_42, 2]: I32
    %v_60 = add %v_63, 1: I32
    %v_57 = add %v_64, 1: I32
