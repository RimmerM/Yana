    jmp b_4
  }

  b_2 {
    jmp b_5
  }

  b_5 {
    %v_6 = loads @trace, 4: I32
    %v_7 = or %v_6, 1: I32
    store @trace, %v_7, 4
    jmp b_3
  }

  b_8 {
    %v_9 = alloca 8, 8: Ptr
    store %v_9, %v_1, 8
    jmp b_10
  }

  b_11 {
    %v_12 = loads @trace, 4: I32
    %v_13 = or %v_12, 2: I32
    store @trace, %v_13, 4
    jmp b_8
  }

  b_14 {
    jmp b_15
  }

  b_16 {
    %v_17 = loads @trace, 4: I32
    %v_18 = or %v_17, 4: I32
    store @trace, %v_18, 4
    jmp b_14
  }

  b_19 {
    jmp b_20
  }

  b_15 {
    %v_21 = loads @trace, 4: I32
    %v_22 = or %v_21, 8: I32
    store @trace, %v_22, 4
    jmp b_19
  }

  b_23 {
    %v_24 = loads @trace, 4: I32
    %v_25 = or %v_24, 32: I32
    store @trace, %v_25, 4
    %v_26 = loads @trace, 4: I32
    %v_27 = or %v_26, 64: I32
    store @trace, %v_27, 4
    jmp b_28
  }

  b_20 {
    %v_29 = loads @trace, 4: I32
    %v_30 = or %v_29, 16: I32
    store @trace, %v_30, 4
    jmp b_23
  }

  b_31 {
    %v_32 = loads @trace, 4: I32
    %v_33 = or %v_32, 256: I32
    store @trace, %v_33, 4
    %v_34 = loads @trace, 4: I32
    %v_35 = or %v_34, 512: I32
    store @trace, %v_35, 4
    %v_36 = loads @trace, 4: I32
    %v_37 = or %v_36, 1024: I32
    store @trace, %v_37, 4
    %v_38 = loads @trace, 4: I32
    %v_39 = or %v_38, 2048: I32
    store @trace, %v_39, 4
    %v_40 = loads @trace, 4: I32
