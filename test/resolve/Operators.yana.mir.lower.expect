max(Money)<complex>(%v_0: Ptr, %lhs: Ptr, %rhs: Ptr) {
  b_1 {
    %v_2 = alloca 8, 8: Ptr
    %v_3 = alloca 8, 8: Ptr
    copy %v_2, %lhs, 8
    copy %v_3, %rhs, 8
    %v_4 = call_complex >=(Money), %v_3, %v_2: I32
    je %v_4, b_5, b_6
  }

  b_6 {
    jmp b_7
  }

  b_7 {
    %v_8 = phi [b_6, %v_2], [b_5, %v_3]: Ptr
    copy %v_0, %v_8, 8
    ret 
  }

  b_5 {
    jmp b_7
  }
}

>=(Money)<complex>(%lhs: Ptr, %rhs: Ptr): I32 {
  b_0 {
    %v_1 = call_complex Money.compare, %lhs, %rhs: I32
    %v_2 = cmp_neq %v_1, 0: I32
    ret %v_2
  }
}

