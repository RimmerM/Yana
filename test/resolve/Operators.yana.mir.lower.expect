    %v_10 = alloca 8, 8: Ptr
    store %v_10, %v_1, 8
    %v_11 = loads %v_9, 8: I64
    %v_12 = cmp_ilt %v_1, %v_11: I32
    je %v_12, b_13, b_14
  }

  b_15 {
    %v_16 = loads @trace, 4: I32
    %v_17 = or %v_16, 2: I32
    store @trace, %v_17, 4
    jmp b_8
  }

  b_18 {
    jmp b_19
  }

  b_20 {
    %v_21 = loads @trace, 4: I32
    %v_22 = or %v_21, 4: I32
    store @trace, %v_22, 4
    jmp b_18
  }

  b_23 {
    jmp b_24
  }

  b_19 {
    %v_25 = loads @trace, 4: I32
    %v_26 = or %v_25, 8: I32
    store @trace, %v_26, 4
    jmp b_23
  }

  b_27 {
    %v_28 = loads @trace, 4: I32
    %v_29 = or %v_28, 32: I32
    store @trace, %v_29, 4
    %v_30 = loads @trace, 4: I32
    %v_31 = or %v_30, 64: I32
    store @trace, %v_31, 4
    jmp b_32
  }

  b_24 {
    %v_33 = loads @trace, 4: I32
    %v_34 = or %v_33, 16: I32
    store @trace, %v_34, 4
    jmp b_27
  }

  b_35 {
    %v_36 = loads @trace, 4: I32
    %v_37 = or %v_36, 256: I32
    store @trace, %v_37, 4
    %v_38 = loads @trace, 4: I32
    %v_39 = or %v_38, 512: I32
    store @trace, %v_39, 4
    %v_40 = loads @trace, 4: I32
    %v_41 = or %v_40, 1024: I32
    store @trace, %v_41, 4
    %v_42 = loads @trace, 4: I32
    %v_43 = or %v_42, 2048: I32
    store @trace, %v_43, 4
    %v_44 = loads @trace, 4: I32
    %v_45 = or %v_44, 4096: I32
    store @trace, %v_45, 4
    %v_46 = loads @trace, 4: I32
    %v_47 = or %v_46, 8192: I32
    store @trace, %v_47, 4
    jmp b_48
  }

  b_32 {
    %v_49 = loads @trace, 4: I32
    %v_50 = or %v_49, 128: I32
    store @trace, %v_50, 4
    jmp b_35
  }

  b_51 {
    %v_52 = cmp_ilt %v_53, 5: I32
    je %v_52, b_48, b_54
  }

  b_54 {
    %v_55 = cmp_eq %v_56, 3: I32
    je %v_55, b_57, b_58
  }

  b_48 {
    %v_59 = phi [b_51, %v_56], [b_35, 0]: I32
    %v_60 = phi [b_51, %v_53], [b_35, 2]: I32
    %v_56 = add %v_59, 1: I32
    %v_53 = add %v_60, 1: I32
    jmp b_51
  }

  b_58 {
    %v_61 = loads @trace, 4: I32
    %v_62 = or %v_61, 32768: I32
    store @trace, %v_62, 4
    %v_63 = loads @trace, 4: I32
    ret %v_63
  }

  b_57 {
    %v_64 = loads @trace, 4: I32
    %v_65 = or %v_64, 16384: I32
    store @trace, %v_65, 4
    jmp b_58
  }

  b_4 {
    jmp b_15
  }

  b_13 {
    jmp b_66
  }

  b_66 {
    %v_67 = phi [b_14, %v_10], [b_13, %v_9]: Ptr
    %v_68 = loads %v_67, 8: I64
    %v_69 = cmp_eq %v_68, %v_1: I32
    je %v_69, b_20, b_18
  }

  b_14 {
    jmp b_66
  }
}

