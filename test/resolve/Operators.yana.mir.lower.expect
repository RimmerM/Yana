    store @trace, %v_41, 4
    %v_42 = loads @trace, 4: I32
    %v_43 = or %v_42, 8192: I32
    store @trace, %v_43, 4
    jmp b_44
  }

  b_28 {
    %v_45 = loads @trace, 4: I32
    %v_46 = or %v_45, 128: I32
    store @trace, %v_46, 4
    jmp b_31
