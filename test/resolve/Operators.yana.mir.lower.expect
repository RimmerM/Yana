  b_62 {
    jmp b_65
  }

  b_61 {
    %v_66 = loads @trace, 4: I32
    %v_67 = or %v_66, 16384: I32
    store @trace, %v_67, 4
    jmp b_62
  }

  b_68 {
    %v_69 = loads @trace, 4: I32
