  b_47 {
    %v_48 = cmp_ilt %v_49, 5: I32
    je %v_48, b_44, b_50
  }

  b_50 {
    %v_51 = cmp_eq %v_52, 3: I32
    je %v_51, b_53, b_54
  }

  b_44 {
    %v_55 = phi [b_47, %v_52], [b_31, 0]: I32
    %v_56 = phi [b_47, %v_49], [b_31, 2]: I32
    %v_52 = add %v_55, 1: I32
    %v_49 = add %v_56, 1: I32
    jmp b_47
  }

  b_54 {
    %v_57 = loads @trace, 4: I32
    %v_58 = or %v_57, 32768: I32
    store @trace, %v_58, 4
    %v_59 = loads @trace, 4: I32
    ret %v_59
  }

  b_53 {
    %v_60 = loads @trace, 4: I32
    %v_61 = or %v_60, 16384: I32
    store @trace, %v_61, 4
    jmp b_54
  }

  b_4 {
    jmp b_11
  }

  b_62 {
    %v_63 = loads %v_9, 8: I64
    %v_64 = cmp_eq %v_63, %v_1: I32
    je %v_64, b_16, b_14
  }

  b_10 {
    jmp b_62
