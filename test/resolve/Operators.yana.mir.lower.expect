mut @trace = [0, 0, 0, 0]

main<complex>(): I32 {
  b_0 {
    %v_1 = loads @trace, 4: I32
    %v_2 = or %v_1, 1: I32
    store @trace, %v_2, 4
    %v_3 = loads @trace, 4: I32
    %v_4 = or %v_3, 2: I32
    store @trace, %v_4, 4
    %v_5 = loads @trace, 4: I32
    %v_6 = or %v_5, 4: I32
    store @trace, %v_6, 4
    %v_7 = loads @trace, 4: I32
    %v_8 = or %v_7, 8: I32
    store @trace, %v_8, 4
    %v_9 = loads @trace, 4: I32
    %v_10 = or %v_9, 16: I32
    store @trace, %v_10, 4
    %v_11 = loads @trace, 4: I32
    %v_12 = or %v_11, 96: I32
    store @trace, %v_12, 4
    %v_13 = or %v_11, 224: I32
    store @trace, %v_13, 4
    %v_14 = loads @trace, 4: I32
    %v_15 = or %v_14, 16128: I32
    store @trace, %v_15, 4
    jmp b_16
  }

  b_17 {
    %v_18 = cmp_ilt %v_19, 5: I32
    je %v_18, b_16, b_20
  }

  b_20 {
    %v_21 = cmp_eq %v_22, 3: I32
    je %v_21, b_23, b_24
  }

  b_16 {
    %v_25 = phi [b_17, %v_22], [b_0, 0]: I32
    %v_26 = phi [b_17, %v_19], [b_0, 2]: I32
    %v_22 = add %v_25, 1: I32
    %v_19 = add %v_26, 1: I32
    jmp b_17
  }

  b_24 {
    %v_27 = loads @trace, 4: I32
    %v_28 = or %v_27, 32768: I32
    store @trace, %v_28, 4
    ret %v_28
  }

  b_23 {
    %v_29 = loads @trace, 4: I32
    %v_30 = or %v_29, 16384: I32
    store @trace, %v_30, 4
    jmp b_24
  }
}

