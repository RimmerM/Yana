mut @trace = [0, 0, 0, 0]

main<complex>(): I32 {
  b_0 {
    %v_1 = imm 15: I64
    jmp b_2
  }

  b_3 {
    jmp b_4
  }

  b_2 {
    jmp b_5
  }

  b_5 {
    %v_6 = loads @trace, 4: I32
    %v_7 = or %v_6, 1: I32
    store @trace, %v_7, 4
    jmp b_3
  }

  b_8 {
    %v_9 = alloca 8, 8: Ptr
    store %v_9, 5, 8
    %v_10 = alloca 8, 8: Ptr
    store %v_10, %v_1, 8
    jmp b_11
  }

  b_12 {
    %v_13 = loads @trace, 4: I32
    %v_14 = or %v_13, 2: I32
    store @trace, %v_14, 4
    jmp b_8
  }

  b_15 {
    jmp b_16
  }

  b_17 {
    %v_18 = loads @trace, 4: I32
    %v_19 = or %v_18, 4: I32
    store @trace, %v_19, 4
    jmp b_15
  }

  b_20 {
    jmp b_21
  }

  b_16 {
    %v_22 = loads @trace, 4: I32
    %v_23 = or %v_22, 8: I32
    store @trace, %v_23, 4
    jmp b_20
  }

  b_24 {
    %v_25 = loads @trace, 4: I32
    %v_26 = or %v_25, 32: I32
    store @trace, %v_26, 4
    %v_27 = loads @trace, 4: I32
    %v_28 = or %v_27, 64: I32
    store @trace, %v_28, 4
    jmp b_29
  }

  b_21 {
    %v_30 = loads @trace, 4: I32
    %v_31 = or %v_30, 16: I32
    store @trace, %v_31, 4
    jmp b_24
  }

  b_32 {
    %v_33 = loads @trace, 4: I32
    %v_34 = or %v_33, 256: I32
    store @trace, %v_34, 4
    %v_35 = loads @trace, 4: I32
    %v_36 = or %v_35, 512: I32
    store @trace, %v_36, 4
    %v_37 = loads @trace, 4: I32
    %v_38 = or %v_37, 1024: I32
    store @trace, %v_38, 4
    %v_39 = loads @trace, 4: I32
    %v_40 = or %v_39, 2048: I32
    store @trace, %v_40, 4
    %v_41 = loads @trace, 4: I32
    %v_42 = or %v_41, 4096: I32
    store @trace, %v_42, 4
    %v_43 = loads @trace, 4: I32
    %v_44 = or %v_43, 8192: I32
    store @trace, %v_44, 4
    jmp b_45
  }

  b_29 {
    %v_46 = loads @trace, 4: I32
    %v_47 = or %v_46, 128: I32
    store @trace, %v_47, 4
    jmp b_32
  }

  b_48 {
    %v_49 = cmp_ilt %v_50, 5: I32
    je %v_49, b_45, b_51
  }

  b_51 {
    %v_52 = cmp_eq %v_53, 3: I32
    je %v_52, b_54, b_55
  }

  b_45 {
    %v_56 = phi [b_48, %v_53], [b_32, 0]: I32
    %v_57 = phi [b_48, %v_50], [b_32, 2]: I32
    %v_53 = add %v_56, 1: I32
    %v_50 = add %v_57, 1: I32
    jmp b_48
  }

  b_55 {
    %v_58 = loads @trace, 4: I32
    %v_59 = or %v_58, 32768: I32
    store @trace, %v_59, 4
    %v_60 = loads @trace, 4: I32
    ret %v_60
  }

  b_54 {
    %v_61 = loads @trace, 4: I32
    %v_62 = or %v_61, 16384: I32
    store @trace, %v_62, 4
    jmp b_55
  }

  b_4 {
    jmp b_12
  }

  b_63 {
    %v_64 = loads %v_10, 8: I64
    %v_65 = cmp_eq %v_64, %v_1: I32
    je %v_65, b_17, b_15
  }

  b_11 {
    jmp b_63
  }
}

