mut @trace = [0, 0, 0, 0]

main<complex>(): I32 {
  b_0 {
    %v_1 = imm 15: I64
    jmp b_2
  }

  b_3 {
    jmp b_4
  }

  b_2 {
    jmp b_5
  }

  b_5 {
    %v_6 = loads @trace, 4: I32
    %v_7 = or %v_6, 1: I32
    store @trace, %v_7, 4
    jmp b_3
  }

  b_8 {
    %v_9 = alloca 8, 8: Ptr
