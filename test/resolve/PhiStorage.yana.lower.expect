@image$base = []

tagOf<complex>(%m: Ptr): Int {
  b_0 {
    %v_1 = load %m, 1: Long
    %v_2 = cmp_le %v_1, 2: Int
    je %v_2, b_3, b_4
  }

  b_4 {
    %v_5 = cmp_le %v_1, 2: Int
    je %v_5, b_6, b_7
  }

  b_3 {
    %v_8 = load %m, 1: Int
    %v_9 = cmp_eq %v_8, 0: Int
    je %v_9, b_10, b_4
  }

  b_10 {
    jmp b_11
  }

  b_7 {
    %v_12 = cmp_le %v_1, 2: Int
    je %v_12, b_13, b_14
  }

  b_6 {
    %v_15 = load %m, 1: Int
    %v_16 = cmp_eq %v_15, 1: Int
    je %v_16, b_17, b_7
