  }
}

main<complex>(): Int {
  b_0 {
    %v_1 = alloca 1, 1: Ptr
    store %v_1, 1, 1
    %v_2 = call_complex tagOf, %v_1: Int
    %v_3 = imul %v_2, 100: Int
    %v_4 = alloca 1, 1: Ptr
