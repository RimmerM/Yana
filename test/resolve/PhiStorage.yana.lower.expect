@image$base = []

tagOf<complex>(%m: Ptr): Int {
  b_0 {
    %v_1 = load %m, 1: Long
    %v_2 = cmp_le %v_1, 2: Int
    je %v_2, b_3, b_4
  }

  b_4 {
    %v_5 = cmp_le %v_1, 2: Int
    je %v_5, b_6, b_7
  }

  b_3 {
    %v_8 = load %m, 1: Int
    %v_9 = cast %v_8: Int
    %v_10 = cmp_eq %v_9, 0: Int
    je %v_10, b_11, b_4
  }

  b_11 {
    jmp b_12
  }

  b_7 {
    %v_13 = cmp_le %v_1, 2: Int
    je %v_13, b_14, b_15
  }

  b_6 {
    %v_16 = load %m, 1: Int
    %v_17 = cast %v_16: Int
    %v_18 = cmp_eq %v_17, 1: Int
    je %v_18, b_19, b_7
  }

  b_19 {
