    %v_19 = cmp_eq %v_18, 2: Int
    je %v_19, b_20, b_14
  }

  b_20 {
    jmp b_11
  }

  b_11 {
    %v_21 = phi [b_10, 1], [b_17, 2], [b_20, 3], [b_14, 0]: Int
