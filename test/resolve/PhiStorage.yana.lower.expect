    %v_21 = cast %v_20: Int
    %v_22 = cmp_eq %v_21, 2: Int
    je %v_22, b_23, b_15
  }

  b_23 {
    jmp b_12
  }

  b_12 {
    %v_24 = phi [b_11, 1], [b_19, 2], [b_23, 3], [b_15, 0]: Int
    ret %v_24
  }
}

main<complex>(): Int {
  b_0 {
    %v_1 = alloca 1, 1: Ptr
    store %v_1, 1, 1
    %v_2 = call_complex tagOf, %v_1: Int
    %v_3 = imul %v_2, 100: Int
    %v_4 = alloca 1, 1: Ptr
