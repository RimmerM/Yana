  }

  b_3 {
    jmp b_7
  }

  b_7 {
    %v_8 = phi [b_4, %v_6], [b_3, %v_2]: Int
    je %v_8, b_9, b_10
  }

  b_9 {
    ret 0
  }

  b_10 {
    jmp b_11
  }

  b_11 {
    %v_12 = sub %second, %first: Long
    %v_13 = cmp_ilt %v_12, 32: Int
    je %v_13, b_14, b_15
  }

  b_14 {
    ret 0
  }

  b_15 {
    jmp b_16
  }

