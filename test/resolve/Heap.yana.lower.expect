initHeap<complex>() {
  b_0 {
    %result = syscall 9, 0, 4194304, 3, 34, 18446744073709551615, 0: Long
    %v_1 = cmp_ilt %result, 0: Int
    %v_2 = imm 256: Long
    je %v_1, b_3, b_4
  }

  b_4 {
    %v_5 = bitcast %result: Ptr
    jmp b_6
  }

  b_3 {
    %v_7 = bitcast 0: Ptr
    jmp b_6
  }

  b_6 {
    %region = phi [b_4, %v_5], [b_3, %v_7]: Ptr
    %v_8 = bitcast %region: Long
    %v_9 = cmp_eq %v_8, 0: Int
    je %v_9, b_10, b_11
  }

  b_11 {
    setpattern %region, %v_2, 0
    %v_12 = bitcast %region: Ptr
    store @heapFree, %v_12, 8
    %v_13 = add %region, %v_2: Ptr
    store @heapNext, %v_13, 8
    %v_14 = add %region, 4194304: Ptr
    store @heapLimit, %v_14, 8
