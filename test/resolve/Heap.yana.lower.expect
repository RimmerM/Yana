  b_6 {
    %v_7 = call_complex heapClassCount: Long
    %table = imul %v_7, 8: Long
    setpattern %region, %table, 0
    %v_8 = bitcast %region: Ptr
    store @heapFree, %v_8, 8
    %v_9 = add %region, %table: Ptr
    store @heapNext, %v_9, 8
    %v_10 = call_complex heapRegionSize: Long
