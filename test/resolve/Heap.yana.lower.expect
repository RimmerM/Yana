    %first = call_complex allocateHeap, 32: Ptr
    %second = call_complex allocateHeap, 32: Ptr
    %v_1 = bitcast %first: Long
    %v_2 = cmp_eq %v_1, 0: Int
    %v_3 = bitcast %second: Long
    %v_4 = cmp_eq %v_3, 0: Int
    %v_5 = or %v_2, %v_4: Int
