  b_35 {
    %v_36 = add %block, %blockSize: Ptr
    store @heapNext, %v_36, 8
    %v_37 = bitcast %block: Ptr
    store %v_37, %sizeClass, 8
    %v_38 = add %block, 8: Ptr
