classesAreSeparate<complex>(): Long {
  b_0 {
    %small = call_complex allocateHeap, 8: Ptr
    call_complex freeHeap, %small
    %large = call_complex allocateHeap, 1000: Ptr
    %v_1 = cmp_eq %small, %large: Int
    je %v_1, b_2, b_3
