    %v_1 = load @heapFree, 8: Ptr
    %v_2 = bitcast %v_1: Long
    %v_3 = cmp_eq %v_2, 0: Int
    je %v_3, b_4, b_5
  }

  b_4 {
    call_complex initHeap
    %v_6 = load @heapFree, 8: Ptr
    %v_7 = bitcast %v_6: Long
    %v_8 = cmp_eq %v_7, 0: Int
    je %v_8, b_9, b_10
  }

  b_5 {
    jmp b_11
  }

  b_9 {
    %v_12 = bitcast 0: Ptr
