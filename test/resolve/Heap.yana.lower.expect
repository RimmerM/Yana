initHeap<complex>() {
  b_0 {
    %v_1 = call_complex heapRegionSize: Long
    %region = call_complex mapMemory, %v_1: Ptr
    %v_2 = bitcast %region: Long
    %v_3 = cmp_eq %v_2, 0: Int
    je %v_3, b_4, b_5
  }

  b_4 {
    ret 
  }

  b_5 {
    jmp b_6
