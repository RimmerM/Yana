  b_11 {
    %v_14 = add %size, 8: Long
    %sizeClass = call_complex heapClassOf, %v_14: Long
    %v_15 = call_complex heapClassCount: Long
    %v_16 = cmp_ige %sizeClass, %v_15: Int
    je %v_16, b_17, b_18
  }

  b_17 {
    %v_19 = bitcast 0: Ptr
