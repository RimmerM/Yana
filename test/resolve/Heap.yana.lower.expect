@heapFree = [0, 0, 0, 0, 0, 0, 0, 0]
@heapNext = [0, 0, 0, 0, 0, 0, 0, 0]
@heapLimit = [0, 0, 0, 0, 0, 0, 0, 0]

allocateHeap<complex>(%size: Long): Ptr {
  b_0 {
    %v_1 = load @heapFree, 8: Ptr
    %v_2 = bitcast %v_1: Long
    %v_3 = cmp_eq %v_2, 0: Int
    je %v_3, b_4, b_5
  }

  b_5 {
    jmp b_6
  }

  b_4 {
    call_complex initHeap
    %v_7 = load @heapFree, 8: Ptr
    %v_8 = bitcast %v_7: Long
    %v_9 = cmp_eq %v_8, 0: Int
    je %v_9, b_10, b_11
  }

  b_11 {
    jmp b_6
  }

  b_6 {
    %v_12 = add %size, 8: Long
    jmp b_13
  }

  b_13 {
    %v_14 = phi [b_6, 16], [b_15, %v_16]: Long
    %v_17 = phi [b_6, 0], [b_15, %v_18]: Long
    %v_19 = cmp_ilt %v_14, %v_12: Int
    je %v_19, b_15, b_20
  }

  b_20 {
    %v_21 = cmp_ige %v_17, 32: Int
    je %v_21, b_22, b_23
  }

  b_23 {
    %v_24 = load @heapFree, 8: Ptr
    %v_25 = imul %v_17, 8: Long
    %v_26 = add %v_24, %v_25: Ptr
    %v_27 = load %v_26, 8: Ptr
    %v_28 = bitcast %v_27: Long
    %v_29 = cmp_eq %v_28, 0: Int
    %v_30 = xor %v_29, 1: Int
    je %v_30, b_31, b_32
  }

  b_32 {
    %block = load @heapNext, 8: Ptr
    %v_33 = shl 16, %v_17: Long
    %v_34 = add %block, %v_33: Ptr
    %v_35 = load @heapLimit, 8: Ptr
    %v_36 = cmp_gt %v_34, %v_35: Int
    je %v_36, b_37, b_38
  }

  b_38 {
    store @heapNext, %v_34, 8
    %v_39 = bitcast %block: Ptr
    store %v_39, %v_17, 8
    %v_40 = add %block, 8: Ptr
    ret %v_40
  }

  b_37 {
    %v_41 = bitcast 0: Ptr
    ret %v_41
  }

  b_31 {
    %v_42 = bitcast %v_27: Ptr
    %v_43 = load %v_42, 8: Ptr
    %v_44 = load @heapFree, 8: Ptr
    %v_45 = add %v_44, %v_25: Ptr
    store %v_45, %v_43, 8
    ret %v_27
  }

  b_22 {
    %v_46 = bitcast 0: Ptr
    ret %v_46
  }

  b_15 {
    %v_16 = add %v_14, %v_14: Long
    %v_18 = add %v_17, 1: Long
    jmp b_13
  }

  b_10 {
    %v_47 = bitcast 0: Ptr
    ret %v_47
  }
}

writeAndRead<complex>(): Long {
  b_0 {
    %v_1 = call_complex allocateHeap, 8: Ptr
    %a = bitcast %v_1: Ptr
    %v_2 = call_complex allocateHeap, 8: Ptr
    %b = bitcast %v_2: Ptr
    %v_3 = bitcast %a: Long
    %v_4 = cmp_eq %v_3, 0: Int
    %v_5 = imm 2: Long
    je %v_4, b_6, b_7
  }

  b_7 {
    %v_8 = bitcast %b: Long
    %v_9 = cmp_eq %v_8, 0: Int
    jmp b_10
  }

  b_6 {
    jmp b_10
  }

  b_10 {
    %v_11 = phi [b_7, %v_9], [b_6, %v_4]: Int
    je %v_11, b_12, b_13
  }

  b_12 {
    ret 0
  }

  b_13 {
    jmp b_14
  }

  b_14 {
    store %a, 40, 8
    store %b, %v_5, 8
    %v_15 = loads %a, 8: Long
    %v_16 = loads %b, 8: Long
    %v_17 = add %v_15, %v_5: Long
    ret %v_17
