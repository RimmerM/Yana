  b_20 {
    %reused = call_complex freeListHead, %sizeClass: Ptr
    %v_21 = bitcast %reused: Long
    %v_22 = cmp_eq %v_21, 0: Int
    %v_23 = xor %v_22, 1: Int
    je %v_23, b_24, b_25
