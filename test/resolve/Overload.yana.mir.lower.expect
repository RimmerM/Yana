
Box.span<complex>(%lhs: Ptr, %rhs: Ptr): I32 {
  b_0 {
    %v_1 = loads %lhs, 4: I32
    %v_2 = loads %rhs, 4: I32
    %v_3 = add %v_1, %v_2: I32
    ret %v_3
  }
}

Tag.span<complex>(%lhs: Ptr, %rhs: Ptr): I32 {
  b_0 {
    %v_1 = loads %lhs, 4: I32
    %v_2 = loads %rhs, 4: I32
    %v_3 = imul %v_1, %v_2: I32
    ret %v_3
  }
}

span'2<complex>(%lhs: I32, %rhs: I32): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    %v_2 = alloca 4, 4: Ptr
    store %v_1, %lhs, 4
    store %v_2, %rhs, 4
    %v_3 = loads %v_1, 4: I32
    %v_4 = loads %v_2, 4: I32
    %v_5 = sub %v_3, %v_4: I32
    ret %v_5
  }
}

Box.weigh<complex>(%value: Ptr): I32 {
  b_0 {
    %v_1 = loads %value, 4: I32
    ret %v_1
  }
}

Box.weigh'2<complex>(%value: Ptr): I32 {
  b_0 {
    %v_1 = loads %value, 4: I32
    %v_2 = imul %v_1, 100: I32
    ret %v_2
  }
}

qualified<complex>(%value: Ptr): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    copy %v_1, %value, 4
    %v_2 = call_complex Box.weigh'2, %v_1: I32
    %v_3 = alloca 4, 4: Ptr
    copy %v_3, %value, 4
    %v_4 = call_complex Box.weigh, %v_3: I32
    %v_5 = add %v_2, %v_4: I32
    ret %v_5
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    %v_2 = alloca 4, 4: Ptr
    %v_3 = alloca 4, 4: Ptr
    %v_4 = alloca 4, 4: Ptr
    %v_5 = alloca 4, 4: Ptr
