    %v_7 = call_complex span'2, 1, 2: I32
    store %v_1, %v_7, 4
    %v_8 = alloca 4, 4: Ptr
    store %v_8, 4, 4
    %v_9 = alloca 4, 4: Ptr
    store %v_9, 5, 4
    %v_10 = call_complex Box.span, %v_8, %v_9: I32
    store %v_2, %v_10, 4
    %v_11 = alloca 4, 4: Ptr
    store %v_11, 3, 4
    %v_12 = alloca 4, 4: Ptr
    store %v_12, 6, 4
    %v_13 = call_complex Tag.span, %v_11, %v_12: I32
    store %v_3, %v_13, 4
    %v_14 = alloca 4, 4: Ptr
    store %v_14, 7, 4
    %v_15 = call_complex lightly(Box), %v_14: I32
    store %v_4, %v_15, 4
    %v_16 = alloca 4, 4: Ptr
    store %v_16, 7, 4
    %v_17 = call_complex heavily(Box), %v_16: I32
    store %v_5, %v_17, 4
    %v_18 = alloca 4, 4: Ptr
    store %v_18, 2, 4
    %v_19 = call_complex qualified, %v_18: I32
    store %v_6, %v_19, 4
    %v_20 = loads %v_1, 4: I32
    %v_21 = loads %v_2, 4: I32
    %v_22 = add %v_20, %v_21: I32
    %v_23 = loads %v_3, 4: I32
    %v_24 = add %v_22, %v_23: I32
    %v_25 = loads %v_4, 4: I32
    %v_26 = add %v_24, %v_25: I32
    %v_27 = loads %v_5, 4: I32
    %v_28 = add %v_26, %v_27: I32
    %v_29 = loads %v_6, 4: I32
    %v_30 = add %v_28, %v_29: I32
    ret %v_30
  }
}

lightly(Box)<complex>(%value: Ptr): I32 {
  b_0 {
    %v_1 = call_complex Box.weigh, %value: I32
    ret %v_1
  }
}

heavily(Box)<complex>(%value: Ptr): I32 {
  b_0 {
    %v_1 = call_complex Box.weigh'2, %value: I32
    ret %v_1
  }
}

