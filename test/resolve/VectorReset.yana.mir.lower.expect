
compressLike<clobber, x86_legacy_sse>(%state: i32x4, %message: i32x4): I32 {
  b_0 {
    vzeroupper 
    %v_1 = sha256msg1 %state, %message: i32x4
    %v_2 = add %v_1, %state: i32x4
    %v_3 = vlane %v_2, 0: I32
    ret %v_3
  }
}

throughHelper<clobber, x86_legacy_sse>(%state: i32x4): I32 {
  b_0 {
    vzeroupper 
    %v_1 = sha256msg2 %state, %state: i32x4
    %v_2 = vlane %v_1, 0: I32
    ret %v_2
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = vsplat 1: i32x4
    %v_2 = vsplat 2: i32x4
    %v_3 = call_clobber compressLike, %v_1, %v_2: I32
    %v_4 = call_clobber throughHelper, %v_1: I32
    %v_5 = add %v_3, %v_4: I32
    vzeroupper 
    %v_6 = add %v_5, 1: I32
    ret %v_6
  }
}

