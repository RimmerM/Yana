  %2: %U32 address = alloc frame U32
  store inspect %1 borrow %0
  %3: %U32 trivial = load inspect %1
  %4: U32 trivial = load.volatile inspect %3
  store inspect %2 consume %4
  %5: %U32 trivial = load inspect %1
  %6: U32 trivial = load inspect %2
  %7: U32 trivial = const 1
  %8: U32 trivial = add inspect %6 inspect %7
  store inspect %5 consume %8
  %9: %U32 trivial = load inspect %1
  %10: U32 trivial = load.volatile inspect %9
  return consume %10
}

