module ResolveTest

fn useId(it: @bits(53) U64 [shared call]) -> @bits(53) U64 = <no body>

fn useFlags(it: Flags [shared call]) -> Bool {
bb0(%0: Flags [shared call] guaranteed):
  %1: %Bool address = field.addr .optionA inspect %0
  %2: Bool trivial = load inspect %1
  return consume %2
}

fn useWrapped(it: Wrapped [shared call]) -> @bits(53) U64 {
bb0(%0: Wrapped [shared call] guaranteed):
  %1: %@bits(53) U64 address = field.addr .value inspect %0
  %2: @bits(53) U64 trivial = load inspect %1
  %3: U64 trivial = convert inspect %2
  %4: @bits(53) U64 trivial = convert inspect %3
  return consume %4
}

fn useRaw(it: Raw [shared call]) -> Bool = <no body>

fn main() -> I32 {
bb0:
  %1: %Flags address = alloc frame Flags
  %2: %Wrapped address = alloc frame Wrapped
  %3: %U64 address = alloc frame U64
  %4: Bool trivial = const True
  %5: Bool trivial = const False
  %6: Flags trivial = aggregate.Flags consume %4 consume %5
  store inspect %1 consume %6
  %7: @bits(53) U64 trivial = const 7
  %8: Wrapped trivial = aggregate.Wrapped consume %7
  store inspect %2 consume %8
  %9: Wrapped trivial = copy inspect %2
  %10: @bits(53) U64 trivial = call useWrapped borrow %9
  %11: U64 trivial = convert inspect %10
  store inspect %3 consume %11
  %12: Flags trivial = copy inspect %1
  %13: Bool trivial = call useFlags borrow %12
  branch inspect %13 -> bb3 -> bb1

bb1:
  %14: I32 trivial = const 0
  jump -> bb2(consume %14)

bb2(%0: I32 trivial):
  %15: U64 trivial = load inspect %3
  %16: I32 trivial = convert inspect %15
  %17: I32 trivial = add inspect %0 inspect %16
  return consume %17

bb3:
  %18: I32 trivial = const 1
  jump -> bb2(consume %18)
}

entry main
