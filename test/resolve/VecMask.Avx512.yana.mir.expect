  %21: Vec(F32) = read copy.trivial (b)
  %22: Vec(F32) = call pickByInt borrow.shared %18 borrow.shared %19 borrow.shared %20 borrow.shared %21
  write.init borrow.unique (floats) take %22
  %24: I32 = const 0
  %25: Vec(I32) = vec.splat inspect %24
  %26: I32 = const 1
  %27: Vec(I32) = vec.withlane #1 inspect %25 inspect %26
  %28: I32 = const 2
  %29: Vec(I32) = vec.withlane #2 inspect %27 inspect %28
  %30: I32 = const 3
  %31: Vec(I32) = vec.withlane #3 inspect %29 inspect %30
  %32: I32 = const 4
  %33: Vec(I32) = vec.withlane #4 inspect %31 inspect %32
  %34: I32 = const 5
  %35: Vec(I32) = vec.withlane #5 inspect %33 inspect %34
  %36: I32 = const 6
  %37: Vec(I32) = vec.withlane #6 inspect %35 inspect %36
  %38: I32 = const 7
  %39: Vec(I32) = vec.withlane #7 inspect %37 inspect %38
  %40: I32 = const 3
  %41: I32 = call maskedTotal borrow.shared %39 borrow.shared %40
  write.init borrow.unique (counted) take %41
  %43: Vec(I32) = read copy.trivial (picked)
  %44: I32 = const 0
  %45: I32 = vec.lane #0 inspect %43
  %46: I32 = const 100000
  %47: I32 = mul inspect %45 inspect %46
  %48: Vec(F32) = read copy.trivial (floats)
  %49: I32 = const 0
  %50: F32 = vec.lane #0 inspect %48
  %51: F32 = const 1
  %52: Bool = eq inspect %50 inspect %51
  branch inspect %52 -> bb3(take %47) -> bb1(take %47)

bb1(%53: I32):
  %57: I32 = const 0
  jump -> bb2(take %57, take %53)

bb2(%58: I32, %59: I32):
  %62: I32 = const 10000
  %63: I32 = mul inspect %58 inspect %62
  %64: I32 = add inspect %59 inspect %63
  %65: I32 = read copy.trivial (counted)
  %66: I32 = add inspect %64 inspect %65
  return take %66

bb3(%54: I32):
