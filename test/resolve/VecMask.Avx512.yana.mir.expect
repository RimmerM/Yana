module ResolveTest

fn pickByFloat(a: Vec(F32) [shared call], b: Vec(F32) [shared call], x: Vec(I32) [shared call], y: Vec(I32) [shared call]) -> Vec(I32) {
bb0:
  %0: Vec(F32) = read copy.trivial (a)
  %1: Vec(F32) = read copy.trivial (b)
  %2: Mask(F32) = lt inspect %0 inspect %1
  %3: Mask(I32) = bitcast inspect %2
  %4: Vec(I32) = read copy.trivial (x)
  %5: Vec(I32) = read copy.trivial (y)
  %6: Vec(I32) = select inspect %3 inspect %4 inspect %5
  return take %6
}

fn pickByInt(a: Vec(I32) [shared call], b: Vec(I32) [shared call], x: Vec(F32) [shared call], y: Vec(F32) [shared call]) -> Vec(F32) {
bb0:
  %0: Vec(I32) = read copy.trivial (a)
  %1: Vec(I32) = read copy.trivial (b)
  %2: Mask(I32) = lt inspect %0 inspect %1
  %3: Mask(F32) = bitcast inspect %2
  %4: Vec(F32) = read copy.trivial (x)
  %5: Vec(F32) = read copy.trivial (y)
  %6: Vec(F32) = select inspect %3 inspect %4 inspect %5
  return take %6
}

fn maskedTotal(v: Vec(I32) [shared call], limit: I32 [shared call]) -> I32 {
  local & live: Mask(I32)
  local kept: Vec(I32)

bb0:
  %0: Vec(I32) = read copy.trivial (v)
  %1: I32 = read copy.trivial (limit)
  %2: Vec(I32) = vec.splat inspect %1
  %3: Mask(I32) = lt inspect %0 inspect %2
  write.init borrow.unique (live) take %3
  %5: Mask(I32) = read copy.trivial (live)
  %6: Vec(I32) = read copy.trivial (v)
  %7: I32 = const 0
  %8: Vec(I32) = vec.splat inspect %7
  %9: Vec(I32) = select inspect %5 inspect %6 inspect %8
  write.init borrow.unique (kept) take %9
  %11: Mask(I32) = read copy.trivial (live)
  %12: Bool = vec.reduce or inspect %11
  %13: Bool = not inspect %12
  branch inspect %13 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %18: Vec(I32) = read copy.trivial (kept)
  %19: I32 = vec.reduce add inspect %18
  %20: I32 = const 10
  %21: I32 = mul inspect %19 inspect %20
  %22: Mask(I32) = read copy.trivial (live)
  %23: I32 = vec.reduce add inspect %22
  %24: I32 = add inspect %21 inspect %23
  return take %24

bb3:
  %15: I32 = const -1
  return take %15
}

fn main() -> I32 {
  local a: Vec(F32)
  local b: Vec(F32)
  local ints: Vec(I32)
  local others: Vec(I32)
  local picked: Vec(I32)
  local floats: Vec(F32)
  local counted: I32

bb0:
  %0: F32 = const 1
  %1: Vec(F32) = vec.splat inspect %0
  write.init borrow.unique (a) take %1
  %3: F32 = const 2
  %4: Vec(F32) = vec.splat inspect %3
  write.init borrow.unique (b) take %4
  %6: I32 = const 7
  %7: Vec(I32) = vec.splat inspect %6
