module ResolveTest

data Cell {value: I64, other: I64}

data PBox {p: %I64, pad: I32}

let & calls: I32 = 0

fn setViaBox(into: Cell [unique call]) -> I32 {
  local & b: PBox

bb0:
  %0: I64 [shared slot 0] = read borrow.shared (into.value) loan0
  %1: %I64 [owned here shape6 .*=shared slot 0] = address inspect %0 roots.0{0}
  %2: I32 = const 0
  %3: PBox = aggregate.PBox take %1 take %2
  write.init borrow.unique (b) take %3
  %5: I32 = const 1
  write.assign borrow.unique (b.pad) take %5
  %7: %I64 = read copy.trivial (b.p)
  %8: I64 = const 42
  write.assign borrow.unique ([%%7]) take %8
  %10: {} = const {}
  %11: I32 = read copy.trivial (b.pad)
  return take %11
}

fn setViaArray(into: Cell [unique call]) -> I32 {
  local & a: [%I64 *2]

bb0:
  %0: %I64 = call null(I64)
  %1: %I64 = call null(I64)
  %2: [%I64 *2] = aggregate.0 take %0 take %1
  write.init borrow.unique (a) take %2
  %4: Size = const 1
  %5: I64 [shared slot 0] = read borrow.shared (into.other) loan0
  %6: %I64 [owned here shape6 .*=shared slot 0] = address inspect %5 roots.0{0}
  write.assign borrow.unique (a[1]) take %6
  %8: Size = const 1
  %9: %I64 = read copy.trivial (a[1])
  %10: I64 = const 7
  write.assign borrow.unique ([%%9]) take %10
  %12: {} = const {}
  %13: I32 = const 1
  return take %13
}

fn setP(b: PBox [unique call], p: %I64 [shared call]) -> {} {
bb0:
  %0: %I64 = read copy.trivial (p)
  write.assign borrow.unique (b.p) take %0
  return
}

fn setViaCall(into: Cell [unique call]) -> I32 {
  local & b: PBox

bb0:
  %0: %I64 = call null(I64)
  %1: I32 = const 0
  %2: PBox = aggregate.PBox take %0 take %1
  write.init borrow.unique (b) take %2
  %4: PBox [unique call] = read borrow.unique (b) loan0
  %5: I64 [shared slot 0] = read borrow.shared (into.other) loan1
  %6: %I64 [owned here shape6 .*=shared slot 0] = address inspect %5 roots.0{1}
  %7: {} = call setP borrow.unique %4 borrow.shared %6
  %8: %I64 = read copy.trivial (b.p)
  %9: I64 = const 66
  write.assign borrow.unique ([%%8]) take %9
  %11: {} = const {}
  %12: I32 = const 1
  return take %12
}

fn viaBox() -> I64 {
  local & cell: Cell

bb0:
  %0: I32 [unique call] = read borrow.unique (global calls) loan0
  %1: I32 = const 1
  %2: {} = call +=(I32) borrow.unique %0 borrow.shared %1
  %3: I64 = const 0
  %4: I64 = const 0
  %5: Cell = aggregate.Cell take %3 take %4
  write.init borrow.unique (cell) take %5
  %7: Cell [unique call] = read borrow.unique (cell) loan1
  %8: I32 = call setViaBox borrow.unique %7
  %9: I32 = const 0
  %10: Bool = lt inspect %8 inspect %9
  branch inspect %10 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %15: I64 = read copy.trivial (cell.value)
  return take %15

bb3:
  %12: I64 = const -1
  return take %12
}

fn viaArray() -> I64 {
  local & cell: Cell

bb0:
  %0: I32 [unique call] = read borrow.unique (global calls) loan0
  %1: I32 = const 1
  %2: {} = call +=(I32) borrow.unique %0 borrow.shared %1
  %3: I64 = const 0
  %4: I64 = const 0
  %5: Cell = aggregate.Cell take %3 take %4
  write.init borrow.unique (cell) take %5
  %7: Cell [unique call] = read borrow.unique (cell) loan1
  %8: I32 = call setViaArray borrow.unique %7
  %9: I32 = const 0
  %10: Bool = lt inspect %8 inspect %9
  branch inspect %10 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %15: I64 = read copy.trivial (cell.other)
  return take %15

bb3:
  %12: I64 = const -1
  return take %12
}

fn sameBlock() -> I64 {
  local & cell: Cell
  local r: I32

bb0:
  %0: I32 [unique call] = read borrow.unique (global calls) loan0
  %1: I32 = const 1
  %2: {} = call +=(I32) borrow.unique %0 borrow.shared %1
  %3: I64 = const 0
  %4: I64 = const 0
  %5: Cell = aggregate.Cell take %3 take %4
  write.init borrow.unique (cell) take %5
  %7: Cell [unique call] = read borrow.unique (cell) loan1
  %8: I32 = call setViaBox borrow.unique %7
  write.init borrow.unique (r) take %8
  %10: I64 = read copy.trivial (cell.value)
  %11: I32 = read copy.trivial (r)
  %12: I64 = convert inspect %11
  %13: I64 = const 0
  %14: I64 = mul inspect %12 inspect %13
  %15: I64 = add inspect %10 inspect %14
  return take %15
}

fn viaCall() -> I64 {
  local & cell: Cell

bb0:
  %0: I32 [unique call] = read borrow.unique (global calls) loan0
  %1: I32 = const 1
  %2: {} = call +=(I32) borrow.unique %0 borrow.shared %1
  %3: I64 = const 0
  %4: I64 = const 0
  %5: Cell = aggregate.Cell take %3 take %4
  write.init borrow.unique (cell) take %5
  %7: Cell [unique call] = read borrow.unique (cell) loan1
  %8: I32 = call setViaCall borrow.unique %7
  %9: I32 = const 0
  %10: Bool = lt inspect %8 inspect %9
  branch inspect %10 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %15: I64 = read copy.trivial (cell.other)
  return take %15

bb3:
  %12: I64 = const -1
  return take %12
}

fn main() -> I32 {
  local & failed: I32

bb0:
  %0: I32 = const 0
  write.init borrow.unique (failed) take %0
  %2: I64 = call viaBox
  %3: I64 = const 42
  %4: Bool = ne inspect %2 inspect %3
  branch inspect %4 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %11: I64 = call viaArray
  %12: I64 = const 7
  %13: Bool = ne inspect %11 inspect %12
  branch inspect %13 -> bb6 -> bb4

bb3:
  %6: I32 [unique call] = read borrow.unique (failed) loan0
  %7: I32 = const 1
  %8: {} = call +=(I32) borrow.unique %6 borrow.shared %7
  jump -> bb2

bb4:
  jump -> bb5

bb5:
  %20: I64 = call sameBlock
  %21: I64 = const 42
  %22: Bool = ne inspect %20 inspect %21
  branch inspect %22 -> bb9 -> bb7

bb6:
  %15: I32 [unique call] = read borrow.unique (failed) loan1
  %16: I32 = const 2
  %17: {} = call +=(I32) borrow.unique %15 borrow.shared %16
  jump -> bb5

bb7:
  jump -> bb8

bb8:
  %29: I64 = call viaCall
  %30: I64 = const 66
  %31: Bool = ne inspect %29 inspect %30
  branch inspect %31 -> bb12 -> bb10

bb9:
  %24: I32 [unique call] = read borrow.unique (failed) loan2
  %25: I32 = const 4
  %26: {} = call +=(I32) borrow.unique %24 borrow.shared %25
  jump -> bb8

bb10:
  jump -> bb11

bb11:
  %38: I32 = read copy.trivial (global calls)
  %39: I32 = const 4
  %40: Bool = ne inspect %38 inspect %39
  branch inspect %40 -> bb15 -> bb13

bb12:
  %33: I32 [unique call] = read borrow.unique (failed) loan3
  %34: I32 = const 8
  %35: {} = call +=(I32) borrow.unique %33 borrow.shared %34
  jump -> bb11

bb13:
  jump -> bb14

bb14:
  %47: I32 = read copy.trivial (failed)
  return take %47

bb15:
  %42: I32 [unique call] = read borrow.unique (failed) loan4
  %43: I32 = const 16
  %44: {} = call +=(I32) borrow.unique %42 borrow.shared %43
  jump -> bb14
}

entry main
