"use strict";
// Core
function checkCondition(failed) {
  if (failed) {
    throw "yana: a runtime check failed";
  }
}

// ResolveTest
function main() {
  return ((total_3(new Int32Array([4, 1, 5])) + Math.imul(total_2(new Int32Array([2, 7])), 100) | 0) + 60000 | 0) + 200000 | 0;
}

function total_3(xs) {
  var sum = 0;
  var v5 = 0;
  while (v5 < 3) {
    var i = v5;
    var v14 = Math.imul(sum, 3);
    checkCondition(i >>> 0 >= 3 ? 1 : 0);
    sum = v14 + xs[i] | 0;
    v5 = v5 + 1 | 0;
  }
  return sum;
}

function total_2(xs) {
  var sum = 0;
  var v5 = 0;
  while (v5 < 2) {
    var i = v5;
    var v14 = Math.imul(sum, 3);
    checkCondition(i >>> 0 >= 2 ? 1 : 0);
    sum = v14 + xs[i] | 0;
    v5 = v5 + 1 | 0;
  }
  return sum;
}
main();
