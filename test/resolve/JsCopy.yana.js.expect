"use strict";
// ResolveTest
function seed() {
  return 5;
}

function next(n) {
  return n + 1 | 0;
}

function barrier(flag) {
  var acc = seed();
  if (flag) {
    acc = next(acc);
  }
  var held = acc;
  var v12 = next(held);
  acc = v12;
  return (Math.imul(held, 100) | 0) + v12 | 0;
}

function taken(flag) {
  var acc = seed();
  if (flag) {
    acc = next(acc);
  }
  return ((Math.imul(acc, 100) | 0) + acc | 0) + acc | 0;
}

function main() {
  return (barrier(1) + (Math.imul(barrier(0), 1000) | 0) | 0) + (Math.imul(taken(1), 1000000) | 0) | 0;
}
