@image$base = []

opaque<complex>(%x: F64): F64 {
  b_0 {
    ret %x
  }
}

opaqueF<complex>(%x: F32): F32 {
  b_0 {
    ret %x
  }
}

main<complex>(): I32 {
  b_0 {
    %wide = call_complex opaque, 2.5: F64
    %negated = neg %wide: F64
    %narrow = call_complex opaqueF, 1.5: F32
    %negatedF = neg %narrow: F32
    %zero = call_complex opaque, 0: F64
    %negatedZero = neg %zero: F64
    %source = call_complex opaque, 3.25: F64
    %once = neg %source: F64
    %twice = neg %once: F64
    %v_1 = cmp_eq %negated, -2.5: I32
    %v_2 = cmp_eq %wide, 2.5: I32
    %v_3 = select %v_2, 2, 0: I32
    %v_4 = add %v_1, %v_3: I32
    %v_5 = cmp_eq %negatedF, -1.5: I32
    %v_6 = select %v_5, 4, 0: I32
    %v_7 = add %v_4, %v_6: I32
    %v_8 = cmp_eq %narrow, 1.5: I32
    %v_9 = select %v_8, 8, 0: I32
    %v_10 = add %v_7, %v_9: I32
    %v_11 = div 1, %negatedZero: F64
    %v_12 = cmp_lt %v_11, 0: I32
    %v_13 = select %v_12, 16, 0: I32
    %v_14 = add %v_10, %v_13: I32
    %v_15 = cmp_eq %zero, 0: I32
    %v_16 = select %v_15, 32, 0: I32
    %v_17 = add %v_14, %v_16: I32
    %v_18 = cmp_eq %twice, 3.25: I32
    %v_19 = select %v_18, 64, 0: I32
    %v_20 = add %v_17, %v_19: I32
    %v_21 = cmp_eq %once, -3.25: I32
    %v_22 = select %v_21, 128, 0: I32
    %v_23 = add %v_20, %v_22: I32
    ret %v_23
  }
}

