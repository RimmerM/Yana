module ResolveTest

data Cell {v: I32}

fn addressValue(p: %a [shared call]) -> Size {
  form specialized
  slot #0 type a
bb0:
  %0: %a = read copy.trivial (p)
  %1: Size = call bitcast(%a, Size) borrow.shared %0
  return take %1
}

fn nowhere() -> %a {
  form specialized
  slot #0 type a
bb0:
  %0: Size = const 0
  %1: %a = call bitcast(Size, %a) borrow.shared %0
  return take %1
}

fn absent(it: %a [shared call]) -> Bool {
  form specialized
  slot #0 type a
bb0:
  %0: %a = read copy.trivial (it)
  %1: Size = call addressValue(a) borrow.shared %0
  %2: Size = const 0
  %3: Bool = eq inspect %1 inspect %2
  return take %3
}

fn borrowedAddress(x: a [shared slot 0]) -> Size {
  form specialized
  slot #0 type a
bb0:
  %0: a [shared slot 0] = read borrow.shared (x) loan0
  %1: %a [owned here shape1 .*=shared slot 0] = address inspect %0 roots.0{0}
  %2: Size = call addressValue(a) borrow.shared %1
  return take %2
}

fn main() -> I32 {
  local & cell: Cell
  local p: %Cell [owned here shape1 .*=shared slot 0]

bb0:
  %0: I32 = const 7
  %1: Cell = aggregate.Cell take %0
  write.init borrow.unique (cell) take %1
  %3: Cell [shared slot 0] = read borrow.shared (cell) loan0
  %4: %Cell [owned here shape1 .*=shared slot 0] = address inspect %3 roots.0{0}
  write.init borrow.unique (p) take %4
  %6: %Cell [owned here shape1 .*=shared slot 0] = read copy.trivial (p) roots.0{0}
  %7: Bool = call absent(Cell) borrow.shared %6
  branch inspect %7 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %12: %Cell = call nowhere(Cell)
  %13: Bool = call absent(Cell) borrow.shared %12
  %14: Bool = not inspect %13
  branch inspect %14 -> bb6 -> bb4

bb3:
  %9: I32 = const 1
  return take %9

bb4:
  jump -> bb5

bb5:
  %19: Cell [shared slot 0] = read borrow.shared (cell) loan1
  %20: Size = call borrowedAddress(Cell) borrow.shared %19
  %21: Size = const 0
  %22: Bool = eq inspect %20 inspect %21
  branch inspect %22 -> bb9 -> bb7

bb6:
  %16: I32 = const 2
  return take %16

bb7:
  jump -> bb8

bb8:
  %27: %Cell [owned here shape1 .*=shared slot 0] = read copy.trivial (p) roots.0{0}
  %28: Size = call addressValue(Cell) borrow.shared %27
  %29: Size = const 0
  %30: Bool = eq inspect %28 inspect %29
  branch inspect %30 -> bb12 -> bb10

bb9:
  %24: I32 = const 3
  return take %24

bb10:
  jump -> bb11

bb11:
  %35: I32 = const 0
  return take %35

bb12:
  %32: I32 = const 4
  return take %32
}

fn absent(Cell)(it: %Cell [shared call]) -> Bool = <absent at Cell>

fn nowhere(Cell)() -> %Cell = <nowhere at Cell>

fn borrowedAddress(Cell)(x: Cell [shared slot 0]) -> Size = <borrowedAddress at Cell>

fn addressValue(Cell)(p: %Cell [shared call]) -> Size = <addressValue at Cell>

entry main
