let image$base: () = <none>

let bonus: Int = 3

let &counter: Int = 0

let &shape: Shape = Circle(7)

let &seed: Int = <startup>

let &recorded: Int = <startup>

let &first: Int = <startup>

let &second: Int = <startup>

fn seedFrom(%n: Int) -> Int {
  b0:
    %v3 = mul %n, 5 : Int
    ret %v3
}

fn area(%s: Shape) -> Int {
  b0:
    %v1 = load %s.discriminant : Int
    %v3 = cmp_eq %v1, 0 : Bool
    je %v3, b2, b1

  b1:
    %n = load %s@Square : Int
    %v9 = mul %n, %n : Int
    ret %v9

  b2:
    %r = load %s@Circle : Int
    %v6 = mul %r, %r : Int
    ret %v6
}

fn main() -> Int {
  b0:
    %v1 = load counter : Int
    %v2 = add 3, %v1 : Int
    %v3 = load recorded : Int
    %v6 = mul %v3, 100 : Int
    %v7 = add %v2, %v6 : Int
    %v8 = load first : Int
    %v11 = mul %v8, 10000 : Int
    %v12 = add %v7, %v11 : Int
    %v13 = load second : Int
    %v16 = mul %v13, 1000000 : Int
    %v17 = add %v12, %v16 : Int
    ret %v17
}

fn main$() -> Int {
  b0:
    %v1 = call seedFrom, 4 : Int
    init seed, %v1
    %v3 = load counter : Int
    %v4 = load seed : Int
    %v5 = add %v3, %v4 : Int
    assign counter, %v5
    %v7 = load counter : Int
    %v8 = load shape : Shape
    %v9 = call area, %v8 : Int
    %v10 = add %v7, %v9 : Int
    assign counter, %v10
    %v12 = load counter : Int
    init recorded, %v12
    %v14 = load counter : Int
    %v17 = add %v14, 1 : Int
    init first, %v17
    %v19 = load first : Int
    %v22 = add %v19, 1 : Int
    init second, %v22
    %v24 = call main : Int
    ret %v24
}
