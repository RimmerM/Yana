let image$base: () = <none>

let bonus: I32 = 3

let &counter: I32 = 0

let &shape: Shape = Circle(7)

let &seed: I32 = <startup>

let &recorded: I32 = <startup>

let &first: I32 = <startup>

let &second: I32 = <startup>

fn seedFrom(%n: I32) -> I32 {
  b0:
    %v3 = mul %n, 5 : I32
    ret %v3
}

fn area(%s: Shape) -> I32 {
  b0:
    %v1 = load %s.discriminant : I32
    %v3 = cmp_eq %v1, 0 : Bool
    je %v3, b2, b1

  b1:
    %n = load %s@Square : I32
    %v9 = mul %n, %n : I32
    ret %v9

  b2:
    %r = load %s@Circle : I32
    %v6 = mul %r, %r : I32
    ret %v6
}

fn main() -> I32 {
  b0:
    %v1 = load counter : I32
    %v2 = add 3, %v1 : I32
    %v3 = load recorded : I32
    %v6 = mul %v3, 100 : I32
    %v7 = add %v2, %v6 : I32
    %v8 = load first : I32
    %v11 = mul %v8, 10000 : I32
    %v12 = add %v7, %v11 : I32
    %v13 = load second : I32
    %v16 = mul %v13, 1000000 : I32
    %v17 = add %v12, %v16 : I32
    ret %v17
}

fn main$() -> I32 {
  b0:
    %v1 = call seedFrom, 4 : I32
    init seed, %v1
    %v3 = load counter : I32
    %v4 = load seed : I32
    %v5 = add %v3, %v4 : I32
    assign counter, %v5
    %v7 = load counter : I32
    %v8 = load shape : Shape
    %v9 = call area, %v8 : I32
    %v10 = add %v7, %v9 : I32
    assign counter, %v10
    %v12 = load counter : I32
    init recorded, %v12
    %v14 = load counter : I32
    %v17 = add %v14, 1 : I32
    init first, %v17
    %v19 = load first : I32
    %v22 = add %v19, 1 : I32
    init second, %v22
    %v24 = call main : I32
    ret %v24
}
