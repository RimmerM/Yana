module ResolveTest

data Boxed(a) {value: a, tag: I32} drop derived reclaim derived

data Boxed(I32) {value: I32, tag: I32} of Boxed

class Peek(c -> v): peek, poke, swap

instance Peek(Boxed(a), a): Boxed(a).peek, Boxed(a).poke, Boxed(a).swap

fn peek(self: c [shared slot 0]) -> v [shared slot 0] = <no body>

fn poke(self: c [unique slot 0]) -> v [unique slot 0 owner] = <no body>

fn swap(self: c [unique slot 0], other: v) -> v [unique slot 0 owner] = <no body>

fn Boxed(a).peek(self: Boxed(a) [shared slot 0]) -> a [shared slot 0] {
  form specialized
  slot #0 type a
bb0:
  %0: a [shared slot 0] = read borrow.shared (self.value) loan0
  return borrow.shared %0
}

fn Boxed(a).poke(self: Boxed(a) [unique slot 0]) -> a [unique slot 0 owner] {
  form specialized
  slot #0 type a
bb0:
  %0: a [unique slot 0] = read borrow.unique (self.value) loan0
  return borrow.unique %0
}

fn Boxed(a).swap(self: Boxed(a) [unique slot 0], other: a) -> a [unique slot 0 owner] {
  form specialized
  slot #0 type a
bb0:
  %0: a = read take (other)
  drop (self.value)
  write.assign borrow.unique (self.value) take %0
  %2: a [unique slot 0] = read borrow.unique (self.value) loan0
  return borrow.unique %2
}

fn readThenWrite(b: Boxed(I32) [unique call]) -> I32 {
  local seen: I32 [shared slot 0]
  local kept: I32
  local & slot: I32 [unique slot 0 owner]

bb0:
  %0: Boxed(I32) [shared slot 0] = read borrow.shared (b) loan0
  %1: I32 [shared slot 0] = call peek(Boxed(I32), I32) borrow.shared %0 roots{0}
  write.init borrow.unique (seen) borrow.shared %1
  %3: I32 = read copy.trivial (seen)
  %4: I32 = const 0
  %5: I32 = add inspect %3 inspect %4
  write.init borrow.unique (kept) take %5
  %7: Boxed(I32) [unique slot 0] = read borrow.unique (b) loan1
  %8: I32 [unique slot 0 owner] = call poke(Boxed(I32), I32) borrow.unique %7 roots{1}
  write.init borrow.unique (slot) borrow.unique %8
  %10: I32 = read copy.trivial (slot)
  %11: I32 = const 1
  %12: I32 = add inspect %10 inspect %11
  write.assign borrow.unique (slot) take %12
  %14: I32 = read copy.trivial (kept)
  return take %14
}

fn heldAcross(b: Boxed(I32) [unique call]) -> I32 {
  local & first: I32 [unique slot 0 owner]
  local after: I32
  local & second: I32 [unique slot 0 owner]

bb0:
  %0: Boxed(I32) [unique call] = read borrow.unique (b) loan0
  %1: I32 = const 10
  %2: I32 [unique slot 0 owner] = call swap(Boxed(I32), I32) borrow.unique %0 take %1 roots{0}
  write.init borrow.unique (first) borrow.unique %2
  %4: I32 = read copy.trivial (first)
  %5: I32 = const 5
  %6: I32 = add inspect %4 inspect %5
  write.assign borrow.unique (first) take %6
  %8: I32 = read copy.trivial (first)
  write.init borrow.unique (after) take %8
  %10: Boxed(I32) [unique slot 0] = read borrow.unique (b) loan1
  %11: I32 [unique slot 0 owner] = call poke(Boxed(I32), I32) borrow.unique %10 roots{1}
  write.init borrow.unique (second) borrow.unique %11
  %13: I32 = read copy.trivial (second)
  %14: I32 = const 1
  %15: I32 = add inspect %13 inspect %14
  write.assign borrow.unique (second) take %15
  %17: I32 = read copy.trivial (after)
  return take %17
}

fn main() -> I64 {
  local & b: Boxed(I32)
  local seen: I32
  local held: I32

bb0:
  %0: I32 = const 3
  %1: I32 = const 7
  %2: Boxed(I32) = aggregate.Boxed take %0 take %1
  write.init borrow.unique (b) take %2
  %4: Boxed(I32) [unique call] = read borrow.unique (b) loan0
  %5: I32 = call readThenWrite borrow.unique %4
  write.init borrow.unique (seen) take %5
  %7: I32 = read copy.trivial (seen)
  %8: I32 = const 3
  %9: Bool = ne inspect %7 inspect %8
  branch inspect %9 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %14: I32 = read copy.trivial (b.value)
  %15: I32 = const 4
  %16: Bool = ne inspect %14 inspect %15
  branch inspect %16 -> bb6 -> bb4

bb3:
  %11: I64 = const -1
  return take %11

bb4:
  jump -> bb5

bb5:
  %21: Boxed(I32) [unique call] = read borrow.unique (b) loan1
  %22: I32 = call heldAcross borrow.unique %21
  write.init borrow.unique (held) take %22
  %24: I32 = read copy.trivial (held)
  %25: I32 = const 15
  %26: Bool = ne inspect %24 inspect %25
  branch inspect %26 -> bb9 -> bb7

bb6:
  %18: I64 = const -2
  return take %18

bb7:
  jump -> bb8

bb8:
  %31: I32 = read copy.trivial (b.value)
  %32: I32 = const 16
  %33: Bool = ne inspect %31 inspect %32
  branch inspect %33 -> bb12 -> bb10

bb9:
  %28: I64 = const -3
  return take %28

bb10:
  jump -> bb11

bb11:
  %38: I32 = read copy.trivial (b.value)
  %39: I32 = read copy.trivial (b.tag)
  %40: I32 = add inspect %38 inspect %39
  %41: I64 = convert inspect %40
  return take %41

bb12:
  %35: I64 = const -4
  return take %35
}

fn Boxed(a).peek(I32)(self: Boxed(I32) [shared slot 0]) -> I32 [shared slot 0] = <Boxed(a).peek at I32>

fn Boxed(a).poke(I32)(self: Boxed(I32) [unique slot 0]) -> I32 [unique slot 0 owner] = <Boxed(a).poke at I32>

fn Boxed(a).swap(I32)(self: Boxed(I32) [unique slot 0], other: I32) -> I32 [unique slot 0 owner] = <Boxed(a).swap at I32>

entry main
