module ResolveTest

let table: [P *2] = [P {a: Just(3000000000000), b: 4}, P {a: Nothing, b: 5}]

let & tree: Branch = Leaf

fn niched() -> I32 {
bb0:
  %20: %I32 address = alloc frame I32
  %21: %I32 address = alloc frame I32
  %22: %I32 address = alloc frame I32
  %23: %I64 address = alloc frame I64
  %24: I32 trivial = const 0
  store inspect %20 consume %24
  %25: I32 trivial = const 0
  %26: I32 trivial = const 2
  %27: I32 trivial = const 1
  store inspect %21 consume %25
  jump -> bb1(consume %26, consume %27)

bb1(%0: I32 trivial, %1: I32 trivial):
  %28: I32 trivial = load inspect %21
  %29: Bool trivial = lt inspect %28 inspect %0
  branch inspect %29 -> bb4(consume %0, consume %1) -> bb3(consume %0, consume %1)

bb2(%2: I32 trivial, %3: I32 trivial):
  %30: I32 trivial = load inspect %21
  %31: I32 trivial = add inspect %30 inspect %3
  store inspect %21 consume %31
  jump -> bb1(consume %2, consume %3)

bb3(%4: I32 trivial, %5: I32 trivial):
  %32: I32 trivial = load inspect %20
  return consume %32

bb4(%6: I32 trivial, %7: I32 trivial):
  %33: I32 trivial = load inspect %21
  store inspect %22 consume %33
  %34: I32 trivial = load inspect %22
  %35: Size trivial = convert inspect %34
  %36: USize trivial = const 2
  %37: USize trivial = bitcast inspect %35
  %38: Bool trivial = ge inspect %37 inspect %36
  call checkCondition borrow %38
  %39: %[P *2] address = global.addr table
  %40: %P address = element.addr inspect %39 inspect %35
  %41: %Maybe(I64) address = field.addr .a inspect %40
  %42: %U8 address = field.addr .# inspect %41
  %43: U8 trivial = load inspect %42
  %44: U8 trivial = const 1
  %45: Bool trivial = eq inspect %43 inspect %44
  branch inspect %45 -> bb7(consume %6, consume %7) -> bb5(consume %6, consume %7)

bb5(%8: I32 trivial, %9: I32 trivial):
  jump -> bb6(consume %8, consume %9)

bb6(%10: I32 trivial, %11: I32 trivial):
  %46: I32 [unique call] guaranteed from{%20} = load inspect %20
  %47: I32 trivial = load inspect %22
  %48: Size trivial = convert inspect %47
  %49: USize trivial = const 2
  %50: USize trivial = bitcast inspect %48
  %51: Bool trivial = ge inspect %50 inspect %49
  call checkCondition borrow %51
  %52: %[P *2] address = global.addr table
  %53: %P address = element.addr inspect %52 inspect %48
  %54: %I32 address = field.addr .b inspect %53
  %55: I32 trivial = load inspect %54
  call +=(I32) borrow %46 borrow %55
  jump -> bb2(consume %10, consume %11)

bb7(%12: I32 trivial, %13: I32 trivial):
  %56: %[P *2] address = global.addr table
  %57: %P address = element.addr inspect %56 inspect %35
  %58: %Maybe(I64) address = field.addr .a inspect %57
  %59: %I64 address = field.addr .Just inspect %58
  %60: I64 trivial = load inspect %59
  store inspect %23 consume %60
  %61: I64 trivial = load inspect %23
  %62: I64 trivial = const 255
  %63: I64 trivial = and inspect %61 inspect %62
  %64: I64 trivial = const 0
  %65: Bool trivial = eq inspect %63 inspect %64
  branch inspect %65 -> bb10(consume %12, consume %13) -> bb8(consume %12, consume %13)

bb8(%14: I32 trivial, %15: I32 trivial):
  jump -> bb9(consume %14, consume %15)

bb9(%16: I32 trivial, %17: I32 trivial):
  jump -> bb6(consume %16, consume %17)

bb10(%18: I32 trivial, %19: I32 trivial):
  %66: I32 [unique call] guaranteed from{%20} = load inspect %20
  %67: I32 trivial = const 1
  call +=(I32) borrow %66 borrow %67
  jump -> bb9(consume %18, consume %19)
}

fn recursive() -> I32 {
bb0:
  %0: %I32 address = alloc frame I32
  %1: %Branch address = global.addr tree
  %2: %U8 address = field.addr .# inspect %1
  %3: U8 trivial = load inspect %2
  %4: U8 trivial = const 1
  %5: Bool trivial = eq inspect %3 inspect %4
  branch inspect %5 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %6: I32 trivial = const 7
  return consume %6

bb3:
  %7: %Branch address = global.addr tree
  %8: %I32 address = field.addr .mark inspect %7
  %9: I32 trivial = load inspect %8
  store inspect %0 consume %9
  %10: I32 trivial = load inspect %0
  return consume %10
}

fn main() -> I32 {
bb0:
  %0: I32 trivial = call niched
  %1: I32 trivial = call recursive
  %2: I32 trivial = const 100
  %3: I32 trivial = mul inspect %1 inspect %2
  %4: I32 trivial = add inspect %0 inspect %3
