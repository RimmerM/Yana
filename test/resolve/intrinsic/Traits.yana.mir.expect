module ResolveTest

data Pad {wide: I64, narrow: I8}

data Nest {inner: Pad, tag: I8}

data Guard {id: I32} drop authored

instance Drop(Guard): Guard.drop

fn measured() -> I32 {
  local p: TypeTraits(Pad)
  local n: TypeTraits(Nest)

bb0:
  %0: Size = metric size Pad
  %1: Size = metric align Pad
  %2: Size = metric stride Pad
  %3: Bool = metric trivial.copy Pad
  %4: Bool = metric has.teardown Pad
  %5: TypeTraits(Pad) = aggregate.TypeTraits take %0 take %1 take %2 take %3 take %4
  write.init borrow.unique (p) take %5
  %7: Size = metric size Nest
  %8: Size = metric align Nest
  %9: Size = metric stride Nest
  %10: Bool = metric trivial.copy Nest
  %11: Bool = metric has.teardown Nest
  %12: TypeTraits(Nest) = aggregate.TypeTraits take %7 take %8 take %9 take %10 take %11
  write.init borrow.unique (n) take %12
  %14: Size = read copy.trivial (p.size)
  %15: Size = const 1000
  %16: Size = mul inspect %14 inspect %15
  %17: Size = read copy.trivial (p.align)
  %18: Size = const 100
  %19: Size = mul inspect %17 inspect %18
  %20: Size = add inspect %16 inspect %19
  %21: Size = read copy.trivial (p.stride)
  %22: Size = add inspect %20 inspect %21
  %23: I32 = convert inspect %22
  %24: Size = read copy.trivial (n.size)
  %25: Size = read copy.trivial (n.stride)
  %26: Size = add inspect %24 inspect %25
  %27: I32 = convert inspect %26
  %28: I32 = add inspect %23 inspect %27
  return take %28
}

fn viaValue() -> I32 {
  local p: Pad

bb0:
  %0: I64 = const 1
  %1: I8 = const 2
  %2: Pad = aggregate.Pad take %0 take %1
  write.init borrow.unique (p) take %2
  %4: Pad = read copy.trivial (p)
  %5: Size = call sizeOf(Pad) borrow.shared %4
  %6: Size = const 100
  %7: Size = mul inspect %5 inspect %6
  %8: Pad = read copy.trivial (p)
  %9: Size = call alignOf(Pad) borrow.shared %8
  %10: Size = const 10
  %11: Size = mul inspect %9 inspect %10
  %12: Size = add inspect %7 inspect %11
  %13: Pad = read copy.trivial (p)
  %14: Size = call strideOf(Pad) borrow.shared %13
  %15: Size = add inspect %12 inspect %14
  %16: I32 = convert inspect %15
  return take %16
}

fn Guard.drop(value: Guard) -> {} {
bb0:
  %0: {} = const {}
  return
}

fn flagged() -> I32 {
  local g: TypeTraits(Guard)
  local p: TypeTraits(Pad)
  local a: I32
  local b: I32
  local c: I32
  local d: I32

bb0:
  %0: Size = metric size Guard
  %1: Size = metric align Guard
  %2: Size = metric stride Guard
  %3: Bool = metric trivial.copy Guard
  %4: Bool = metric has.teardown Guard
  %5: TypeTraits(Guard) = aggregate.TypeTraits take %0 take %1 take %2 take %3 take %4
  write.init borrow.unique (g) take %5
  %7: Size = metric size Pad
  %8: Size = metric align Pad
  %9: Size = metric stride Pad
  %10: Bool = metric trivial.copy Pad
  %11: Bool = metric has.teardown Pad
  %12: TypeTraits(Pad) = aggregate.TypeTraits take %7 take %8 take %9 take %10 take %11
  write.init borrow.unique (p) take %12
  %14: Bool = read copy.trivial (g.trivialCopy)
  branch inspect %14 -> bb3 -> bb1

bb1:
  %17: I32 = const 0
  jump -> bb2(take %17)

bb2(%18: I32):
  write.init borrow.unique (a) take %18
  %22: Bool = read copy.trivial (g.hasTeardown)
  branch inspect %22 -> bb6 -> bb4

bb3:
  %16: I32 = const 1
  jump -> bb2(take %16)

bb4:
  %25: I32 = const 0
  jump -> bb5(take %25)

bb5(%26: I32):
  write.init borrow.unique (b) take %26
  %30: Bool = read copy.trivial (p.trivialCopy)
  branch inspect %30 -> bb9 -> bb7

bb6:
  %24: I32 = const 2
  jump -> bb5(take %24)

bb7:
  %33: I32 = const 0
  jump -> bb8(take %33)

bb8(%34: I32):
  write.init borrow.unique (c) take %34
  %38: Bool = read copy.trivial (p.hasTeardown)
  branch inspect %38 -> bb12 -> bb10

bb9:
  %32: I32 = const 4
  jump -> bb8(take %32)

bb10:
  %41: I32 = const 0
  jump -> bb11(take %41)

bb11(%42: I32):
  write.init borrow.unique (d) take %42
  %46: I32 = read copy.trivial (a)
  %47: I32 = read copy.trivial (b)
  %48: I32 = add inspect %46 inspect %47
  %49: I32 = read copy.trivial (c)
  %50: I32 = add inspect %48 inspect %49
  %51: I32 = read copy.trivial (d)
  %52: I32 = add inspect %50 inspect %51
  return take %52

bb12:
  %40: I32 = const 8
  jump -> bb11(take %40)
}

fn main() -> I32 {
bb0:
  %0: I32 = call measured
  %1: I32 = call viaValue
  %2: I32 = add inspect %0 inspect %1
  %3: I32 = call flagged
  %4: I32 = add inspect %2 inspect %3
  return take %4
}

entry main
