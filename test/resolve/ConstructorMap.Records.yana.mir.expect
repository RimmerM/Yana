}

fn independent(c: Corner [shared call]) -> I32 {
  local & first: Point
  local second: Point

bb0:
  %0: Corner = read copy.trivial (c)
  %1: Point = call cornerOf borrow.shared %0
  write.init borrow.unique (first) take %1
  %3: Corner = read copy.trivial (c)
