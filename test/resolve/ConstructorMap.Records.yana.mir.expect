module ResolveTest

data Corner = TopLeft | TopRight | BottomLeft | BottomRight

data Point {x: I32, y: I32}

data Box {origin: Point, span: Point}

data Token {id: I32} drop authored

instance Drop(Token): Token.drop

let & tokensDropped: I32 = 0

fn cornerOf(c: Corner [shared call]) -> Point {
bb0:
  %0: U8 = read copy.trivial (c.#)
  %1: Point = map [0 -> Point {x: 0, y: 0}, 1 -> Point {x: 1, y: 0}, 2 -> Point {x: 0, y: 1}, 3 -> Point {x: 1, y: 1}] inspect %0
  return take %1
}

fn axesOf(c: Corner [shared call]) -> {I32, Bool, F32} {
bb0:
  %0: U8 = read copy.trivial (c.#)
  switch [0, 1, 2] inspect %0 -> bb1 -> bb2 -> bb3 -> bb4

bb1:
  %2: I32 = const 0
  %3: Bool = const True
  %4: F32 = const 0.5
  %5: {I32, Bool, F32} = aggregate. take %2 take %3 take %4
  jump -> bb5(take %5)

bb2:
  %6: I32 = const 1
  %7: Bool = const True
  %8: F32 = const 1.5
  %9: {I32, Bool, F32} = aggregate. take %6 take %7 take %8
  jump -> bb5(take %9)

bb3:
  %10: I32 = const 2
  %11: Bool = const False
  %12: F32 = const 2.5
  %13: {I32, Bool, F32} = aggregate. take %10 take %11 take %12
  jump -> bb5(take %13)

bb4:
  %14: I32 = const 3
  %15: Bool = const False
  %16: F32 = const 3.5
  %17: {I32, Bool, F32} = aggregate. take %14 take %15 take %16
  jump -> bb5(take %17)

bb5(%18: {I32, Bool, F32}):
  return take %18
}

fn boxOf(c: Corner [shared call]) -> Box {
bb0:
  %0: U8 = read copy.trivial (c.#)
  %1: Box = map [0 -> Box {origin: Point {x: 0, y: 0}, span: Point {x: 4, y: 4}}, 1 -> Box {origin: Point {x: 4, y: 0}, span: Point {x: 4, y: 4}}, 2 -> Box {origin: Point {x: 0, y: 4}, span: Point {x: 4, y: 4}}, 3 -> Box {origin: Point {x: 4, y: 4}, span: Point {x: 4, y: 4}}] inspect %0
  return take %1
}

fn hintOf(c: Corner [shared call]) -> Maybe(I32) {
bb0:
  %0: U8 = read copy.trivial (c.#)
  %1: Maybe(I32) = map [0 -> Nothing, 1 -> Just(1), 2 -> Just(2), 3 -> Just(3)] inspect %0
  return take %1
}

fn always(c: Corner [shared call]) -> Point {
bb0:
  %0: U8 = read copy.trivial (c.#)
  %1: Point = map [0 -> Point {x: 9, y: 9}, 1 -> Point {x: 9, y: 9}, 2 -> Point {x: 9, y: 9}, 3 -> Point {x: 9, y: 9}] inspect %0
  return take %1
}

fn Token.drop(value: Token) -> {} {
bb0:
  %0: I32 = read copy.trivial (global tokensDropped)
  %1: I32 = read copy.trivial (value.id)
  %2: I32 = add inspect %0 inspect %1
  write.assign borrow.unique (global tokensDropped) take %2
  return
}

fn tokenOf(c: Corner [shared call]) -> Token {
bb0:
  %0: U8 = read copy.trivial (c.#)
  switch [0, 1, 2] inspect %0 -> bb1 -> bb2 -> bb3 -> bb4

bb1:
  %2: I32 = const 10
  %3: Token = aggregate.Token take %2
  jump -> bb5(take %3)

bb2:
  %4: I32 = const 20
  %5: Token = aggregate.Token take %4
  jump -> bb5(take %5)

bb3:
  %6: I32 = const 30
  %7: Token = aggregate.Token take %6
  jump -> bb5(take %7)

bb4:
  %8: I32 = const 40
  %9: Token = aggregate.Token take %8
  jump -> bb5(take %9)

bb5(%10: Token):
  return take %10
}

fn opaque(c: Corner [shared call]) -> Corner {
bb0:
  %0: Corner = read copy.trivial (c)
  return take %0
}

fn check(condition: Bool [shared call], weight: I32 [shared call]) -> I32 {
bb0:
  %0: Bool = read copy.trivial (condition)
  branch inspect %0 -> bb3 -> bb1

bb1:
  %3: I32 = const 0
  jump -> bb2(take %3)

bb2(%4: I32):
  return take %4

bb3:
  %2: I32 = read copy.trivial (weight)
