  %8: I32 = read copy.trivial (first.x)
  %9: I32 = const 100
  %10: Bool = eq inspect %8 inspect %9
  %11: I32 = const 1
  %12: I32 = call check borrow.shared %10 borrow.shared %11
  %13: I32 = read copy.trivial (second.x)
  %14: I32 = const 100
  %15: Bool = ne inspect %13 inspect %14
  branch inspect %15 -> bb3(take %12) -> bb1(take %12)

