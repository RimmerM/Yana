"use strict";
// ResolveTest
function checksum(text) {
  var total = 0;
  var i = 0;
  L0: for (;;) {
    if (i < text.length) {
      total = total + text.charCodeAt(i) | 0;
      i = i + 1 | 0;
      continue L0;
    }
    break L0;
  }
  return total;
}

function merged(m) {
  var v25;
  if (!(m === null)) {
    var v11 = "";
    v11 = v11 + "x";
    v11 = v11 + String(m);
    v11 = v11 + "y";
    v25 = v11;
  } else {
    v25 = "-";
  }
  return v25;
}

function returned(m) {
  if (!(m === null)) {
    var v11 = "";
    v11 = v11 + "x";
    v11 = v11 + String(m);
    v11 = v11 + "y";
    return v11;
  } else {
    return "-";
  }
}

function kept(n, flag) {
  var picked;
  var v7 = "";
  v7 = v7 + "x";
  v7 = v7 + String(n);
  v7 = v7 + "y";
  var v20 = n + 1 | 0;
  var v26 = "";
  v26 = v26 + "z";
  v26 = v26 + String(v20);
  v26 = v26 + "w";
  if (flag) {
    picked = v7;
  } else {
    picked = v26;
  }
  return (checksum(picked) + checksum(v7) | 0) + checksum(v26) | 0;
}

function main() {
  return ((((checksum(merged(6)) + checksum(returned(6)) | 0) + checksum(merged(null)) | 0) + checksum(returned(null)) | 0) + kept(6, 1) | 0) + kept(6, 0) | 0;
}
main();
