module ResolveTest

fn area(w: I32 [shared call], h: I32 [shared call]) -> I32 {
  local a: I32
  local b: I32

bb0:
  %0: I32 = read copy.trivial (w)
  %1: I32 = read copy.trivial (h)
  %2: I32 = mul inspect %0 inspect %1
  write.init borrow.unique (a) take %2
  %4: I32 = read copy.trivial (w)
  %5: I32 = read copy.trivial (h)
  %6: I32 = add inspect %4 inspect %5
  %7: I32 = const 2
  %8: I32 = mul inspect %7 inspect %6
  write.init borrow.unique (b) take %8
  %10: I32 = read copy.trivial (a)
  %11: I32 = read copy.trivial (b)
  %12: I32 = add inspect %10 inspect %11
  return take %12
}

fn square(x: I32 [shared call]) -> I32 {
  local y: I32

bb0:
  %0: I32 = read copy.trivial (x)
  %1: I32 = const 1
  %2: I32 = add inspect %0 inspect %1
  write.init borrow.unique (y) take %2
  %4: I32 = read copy.trivial (y)
  %5: I32 = read copy.trivial (y)
  %6: I32 = mul inspect %4 inspect %5
  return take %6
}

fn chained(x: I32 [shared call]) -> I32 {
  local near: I32
  local far: I32

bb0:
  %0: I32 = read copy.trivial (x)
  %1: I32 = const 1
  %2: I32 = add inspect %0 inspect %1
  write.init borrow.unique (near) take %2
  %4: I32 = read copy.trivial (near)
  %5: I32 = read copy.trivial (near)
  %6: I32 = mul inspect %4 inspect %5
  %7: I32 = read copy.trivial (near)
  %8: I32 = add inspect %6 inspect %7
  write.init borrow.unique (far) take %8
  %10: I32 = read copy.trivial (far)
  return take %10
}

fn shadowed(x: I32 [shared call]) -> I32 {
  local x: I32

bb0:
  %0: I32 = const 3
  write.init borrow.unique (x) take %0
  %2: I32 = const 3
  %3: I32 = const 10
  %4: I32 = mul inspect %2 inspect %3
  return take %4
}

fn main() -> I32 {
bb0:
  %0: I32 = const 2
  %1: I32 = const 3
  %2: I32 = call area borrow.shared %0 borrow.shared %1
  %3: I32 = const 4
  %4: I32 = call square borrow.shared %3
  %5: I32 = add inspect %2 inspect %4
  %6: I32 = const 2
  %7: I32 = call chained borrow.shared %6
  %8: I32 = add inspect %5 inspect %7
  %9: I32 = const 9
  %10: I32 = call shadowed borrow.shared %9
  %11: I32 = add inspect %8 inspect %10
  return take %11
}

entry main
