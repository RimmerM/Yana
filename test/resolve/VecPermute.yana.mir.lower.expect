
reversed<complex>(%v: i32x8): i32x8 {
  b_0 {
    %v_1 = alloca 32, 32: Ptr
    store %v_1, %v, 32
    %v_2 = load %v_1, 32: i32x8
    %v_3 = vshuffle %v_2, %v_2, 7, 6, 5, 4, 3, 2, 1, 0: i32x8
    ret %v_3
  }
}

rotated<complex>(%v: i32x8): i32x8 {
  b_0 {
    %v_1 = alloca 32, 32: Ptr
    store %v_1, %v, 32
    %v_2 = load %v_1, 32: i32x8
    %v_3 = imm 3: I32
    %v_4 = vshuffle %v_2, %v_2, 3, 4, 5, 6, 7, 0, 1, 2: i32x8
    ret %v_4
  }
}

build<complex>(): i32x8 {
  b_0 {
    %v_1 = vsplat 0: i32x8
    %v_2 = vwithlane %v_1, 1, 1: i32x8
    %v_3 = vwithlane %v_2, 2, 2: i32x8
    %v_4 = vwithlane %v_3, 3, 3: i32x8
    %v_5 = vwithlane %v_4, 4, 4: i32x8
    %v_6 = vwithlane %v_5, 5, 5: i32x8
    %v_7 = vwithlane %v_6, 6, 6: i32x8
    %v_8 = vwithlane %v_7, 7, 7: i32x8
    %v_9 = vsplat 1: i32x8
    %v_10 = add %v_8, %v_9: i32x8
    ret %v_10
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 32, 32: Ptr
    %v_2 = alloca 4, 4: Ptr
    %v_3 = alloca 4, 4: Ptr
    %v_4 = alloca 4, 4: Ptr
    %v_5 = alloca 4, 4: Ptr
    %v_6 = call_complex build: i32x8
    store %v_1, %v_6, 32
    %v_7 = load %v_1, 32: i32x8
    %v_8 = call_complex reversed, %v_7: i32x8
    %v_9 = imm 0: I32
    %v_10 = vlane %v_8, 0: I32
    store %v_2, %v_10, 4
    %v_11 = load %v_1, 32: i32x8
    %v_12 = call_complex reversed, %v_11: i32x8
    %v_13 = imm 5: I32
    %v_14 = vlane %v_12, 5: I32
    store %v_3, %v_14, 4
    %v_15 = load %v_1, 32: i32x8
    %v_16 = call_complex rotated, %v_15: i32x8
    %v_17 = imm 0: I32
    %v_18 = vlane %v_16, 0: I32
    store %v_4, %v_18, 4
    %v_19 = load %v_1, 32: i32x8
    %v_20 = call_complex rotated, %v_19: i32x8
    %v_21 = imm 6: I32
    %v_22 = vlane %v_20, 6: I32
    store %v_5, %v_22, 4
    %v_23 = loads %v_2, 4: I32
    %v_24 = loads %v_3, 4: I32
    %v_25 = add %v_23, %v_24: I32
    %v_26 = loads %v_4, 4: I32
    %v_27 = add %v_25, %v_26: I32
    %v_28 = loads %v_5, 4: I32
    %v_29 = add %v_27, %v_28: I32
