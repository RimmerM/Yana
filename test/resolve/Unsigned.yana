
-- Unsigned division and remainder have to select the unsigned machine instructions. The signed
-- ones read a value above half the range as negative, which is what the remainder below catches:
-- 2^64 - 2 is 2 modulo 3, while the same bits read as -2 give -2.
fn divide(a: U64, b: U64) -> U64 = a / b
fn remainder(a: U64, b: U64) -> U64 = a `rem` b

fn signedDivide(a: I64, b: I64) -> I64 = a / b

fn main() -> Int:
    let big = truncate(0 - 2) :: U64
    let half = divide(big, 2)
    let rest = remainder(big, 3)

    let quotientIsPositive = if half > (0 :: U64) then 1 else 0
    let signedStillSigned = if signedDivide(0 - 7, 2) == 0 - 3 then 10 else 0

    return quotientIsPositive + signedStillSigned + (truncate(rest) :: Int)
