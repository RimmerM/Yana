module ResolveTest

data Tail {wide: I64, narrow: I8}

data Nest {inner: Tail, tag: I8}

data Tight {wide: I64, narrow: I8}

data Plain {wide: I64, narrow: I8}

fn main() -> I32 {
  local n: Nest
  local at: USize
  local tag: USize

bb0:
  %0: I64 = const 0
  %1: I8 = const 0
  %2: Tail = aggregate.Tail take %0 take %1
  %3: Size = call sizeOf(Tail) borrow.shared %2
  %4: Size = const 16
  %5: Bool = ne inspect %3 inspect %4
  branch inspect %5 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %10: I64 = const 0
  %11: I8 = const 0
  %12: Tail = aggregate.Tail take %10 take %11
  %13: [Tail *3] = aggregate.0 take %12 take %12 take %12
  %14: Size = call sizeOf([Tail *3]) borrow.shared %13
  %15: Size = const 48
  %16: Bool = ne inspect %14 inspect %15
  branch inspect %16 -> bb6 -> bb4

bb3:
  %7: I32 = const 1
  return take %7

bb4:
  jump -> bb5

bb5:
  %21: I64 = const 0
  %22: I8 = const 0
  %23: Tail = aggregate.Tail take %21 take %22
  %24: I8 = const 0
  %25: Nest = aggregate.Nest take %23 take %24
  %26: Size = call sizeOf(Nest) borrow.shared %25
  %27: Size = const 24
  %28: Bool = ne inspect %26 inspect %27
  branch inspect %28 -> bb9 -> bb7

bb6:
  %18: I32 = const 2
  return take %18

bb7:
  jump -> bb8

bb8:
  %33: I64 = const 0
  %34: I8 = const 0
  %35: Tight = aggregate.Tight take %33 take %34
  %36: Size = call sizeOf(Tight) borrow.shared %35
  %37: Size = const 9
  %38: Bool = ne inspect %36 inspect %37
  branch inspect %38 -> bb12 -> bb10

bb9:
  %30: I32 = const 3
  return take %30

bb10:
  jump -> bb11

bb11:
  %43: I64 = const 0
  %44: I8 = const 0
  %45: Plain = aggregate.Plain take %43 take %44
  %46: Size = call sizeOf(Plain) borrow.shared %45
  %47: Size = const 9
  %48: Bool = ne inspect %46 inspect %47
  branch inspect %48 -> bb15 -> bb13

bb12:
  %40: I32 = const 4
  return take %40

bb13:
  jump -> bb14

bb14:
  %53: I64 = const 1
  %54: I8 = const 2
  %55: Tail = aggregate.Tail take %53 take %54
  %56: I8 = const 3
  %57: Nest = aggregate.Nest take %55 take %56
  write.init borrow.unique (n) take %57
  %59: Nest [shared slot 0] = read borrow.shared (n) loan0
  %60: %Nest [owned here shape6 .*=shared slot 0] = address inspect %59 roots.0{0}
  %61: USize = bitcast inspect %60
  write.init borrow.unique (at) take %61
  %63: I8 [shared slot 0] = read borrow.shared (n.tag) loan1
  %64: %I8 [owned here shape6 .*=shared slot 0] = address inspect %63 roots.0{1}
  %65: USize = bitcast inspect %64
  write.init borrow.unique (tag) take %65
  %67: USize = read copy.trivial (tag)
  %68: USize = read copy.trivial (at)
  %69: USize = sub inspect %67 inspect %68
  %70: USize = const 16
  %71: Bool = ne inspect %69 inspect %70
  branch inspect %71 -> bb18 -> bb16

bb15:
  %50: I32 = const 5
  return take %50

bb16:
  jump -> bb17

bb17:
  %76: I32 = const 0
  return take %76

bb18:
  %73: I32 = const 6
  return take %73
}

entry main
