-- The rules of `Reject.Try.yana` the default stage does not refuse yet: `?` in a result being
-- inferred, by `=` and by a lambda. It refuses both, but by saying a result type (`{}`, and an
-- empty name) has no `Try` instance rather than that the result is still being inferred. Move
-- each back when it does.

fn source() -> Maybe(Int) = Just(1)

-- `?` needs the enclosing function's result type before it can resolve anything, and the `=` form
-- decides its result *from* the body this is in. The same cycle a recursive `=` function reports,
-- reached one step earlier.
fn inferred(n: Int) = source()?

-- A lambda whose result its body decides is the same cycle with a different name for the fix.
fn inLambda(n: Int) -> Maybe(Int):
    let f = (x: Int) -> source()?
    return f(n)

fn main() -> Int = 0
