module ResolveTest

data Renamed = Other {value: I32}

data RandomError = NoEntropySource

data Reading = Exact {Exact: I32} | Approximate {Approximate: I32} | Unavailable

fn valueOf'2(r: Renamed [shared call]) -> I32 {
  local v: I32

bb0:
  %0: I32 = read copy.trivial (r.value)
  write.init borrow.unique (v) take %0
  %2: I32 = read copy.trivial (v)
  jump -> bb1(take %2)

bb1(%3: I32):
  return take %3
}

fn code(e: RandomError [shared call]) -> I32 {
bb0:
  %0: I32 = const 7
  jump -> bb1(take %0)

bb1(%1: I32):
  return take %1
}

fn reading(r: Reading [shared call]) -> I32 {
  local n: I32
  local n: I32

bb0:
  %0: U8 = read copy.trivial (r.#)
  %1: U8 = const 0
  %2: Bool = eq inspect %0 inspect %1
  branch inspect %2 -> bb4 -> bb1

bb1:
  %7: U8 = read copy.trivial (r.#)
  %8: U8 = const 1
  %9: Bool = eq inspect %7 inspect %8
  branch inspect %9 -> bb5 -> bb2

bb2:
  %16: I32 = const -1
  jump -> bb3(take %16)

bb3(%17: I32):
  return take %17

bb4:
  %4: I32 = read copy.trivial (r.Exact)
  write.init borrow.unique (n) take %4
  %6: I32 = read copy.trivial (n)
  jump -> bb3(take %6)

bb5:
  %11: I32 = read copy.trivial (r.Approximate)
  write.init borrow.unique (n) take %11
  %13: I32 = read copy.trivial (n)
  %14: I32 = const 2
  %15: I32 = mul inspect %13 inspect %14
  jump -> bb3(take %15)
}

fn main() -> I32 {
bb0:
  %0: I32 = const 3
  %1: Renamed = aggregate.Other take %0
  %2: I32 = call valueOf'2 borrow.shared %1
  %3: RandomError = aggregate.NoEntropySource
  %4: I32 = call code borrow.shared %3
  %5: I32 = add inspect %2 inspect %4
  %6: I32 = const 10
  %7: Reading = aggregate.Exact take %6
  %8: I32 = call reading borrow.shared %7
  %9: I32 = add inspect %5 inspect %8
  %10: I32 = const 100
  %11: Reading = aggregate.Approximate take %10
  %12: I32 = call reading borrow.shared %11
  %13: I32 = add inspect %9 inspect %12
  %14: Reading = aggregate.Unavailable
  %15: I32 = call reading borrow.shared %14
  %16: I32 = add inspect %13 inspect %15
  return take %16
}

entry main
