"use strict";
// ResolveTest
function floats() {
  if (Math.fround(1 / Math.fround(-0)) > 0) {
    return -2;
  } else {
    return 0;
  }
}

function indices() {
  return 0;
}

function main() {
  if (floats() !== 0) {
    return Math.imul(floats(), 10);
  } else {
    if (indices() !== 0) {
      return Math.imul(indices(), 100);
    } else {
      return 7955;
    }
  }
}
main();
