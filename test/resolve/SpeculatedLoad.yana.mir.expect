module ResolveTest

fn hoist(p: %I64 [shared call], n: I32 [shared call]) -> I64 {
  local h: I64
  local & i: I32
  local & t: I64

bb0:
  %0: %I64 = read copy.trivial (p)
  %1: Size = const -2
  %2: Size = metric stride I64
  %3: Size = mul inspect %1 inspect %2
  %4: %I64 [owned here shape6 .*=shared slot 0] = add inspect %0 inspect %3
  %5: I64 = read copy.trivial ([%%4])
  write.init borrow.unique (h) take %5
  %7: I32 = const 0
  write.init borrow.unique (i) take %7
  %9: I64 = const 0
  write.init borrow.unique (t) take %9
  jump -> bb1

bb1:
  %12: I32 = read copy.trivial (i)
  %13: I32 = read copy.trivial (n)
  %14: Bool = lt inspect %12 inspect %13
  branch inspect %14 -> bb3 -> bb2

bb2:
  %25: I64 = read copy.trivial (h)
  %26: I64 = read copy.trivial (t)
  %27: I64 = add inspect %25 inspect %26
  return take %27

bb3:
  %16: I64 = read copy.trivial (t)
  %17: %I64 = read copy.trivial (p)
  %18: I64 = read copy.trivial ([%%17])
  %19: I64 = add inspect %16 inspect %18
  write.assign borrow.unique (t) take %19
  %21: I32 [unique call] = read borrow.unique (i) loan0
  %22: I32 = const 1
  %23: {} = call +=(I32) borrow.unique %21 borrow.shared %22
  jump -> bb1
}

fn cell(p: %I64 [shared call], n: I32 [shared call]) -> I64 {
  local h: I64
  local & i: I32

bb0:
  %0: %I64 = read copy.trivial (p)
  %1: Size = const -2
  %2: Size = metric stride I64
  %3: Size = mul inspect %1 inspect %2
  %4: %I64 [owned here shape6 .*=shared slot 0] = add inspect %0 inspect %3
