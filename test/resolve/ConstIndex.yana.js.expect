"use strict";
// Collections
function checkCondition(failed) {
  if (failed) {
    throw "yana: a runtime check failed";
  }
  return;
}

// ResolveTest
function spanned() {
  var v5 = [1];
  v5[2] = 3;
  v5[3] = 4;
  var v19 = [];
  v19[1] = 9;
  v5[1] = 20;
  v19[0] = 5;
  return 29;
}

function overwritten() {
  return 30;
}

function computed() {
  return 65;
}

function aliased(n) {
  var v5 = [];
  v5[1] = 2;
  v5[2] = 3;
  v5[0] = 100;
  checkCondition(n >>> 0 >= 3);
  return v5[n] + 100 | 0;
}

function main() {
  return ((spanned() + overwritten() | 0) + computed() | 0) + aliased(1) | 0;
}
