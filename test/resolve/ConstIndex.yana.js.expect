"use strict";
// Collections
function checkCondition(failed) {
  if (failed) {
    throw "yana: a runtime check failed";
  }
  return;
}

// ResolveTest
function spanned() {
  return 29;
}

function overwritten() {
  return 30;
}

function computed() {
  return 65;
}

function aliased(n) {
  var v5 = [100, 2, 3];
  checkCondition(n >>> 0 >= 3);
  return v5[n] + 100 | 0;
}

function main() {
  return ((spanned() + overwritten() | 0) + computed() | 0) + aliased(1) | 0;
}
