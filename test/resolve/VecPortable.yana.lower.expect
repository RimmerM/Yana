@image$base = []
mut @seed = [2, 0, 0, 0]

construction<complex>(): I32 {
  b_0 {
    %empty = vsplat 0: i32x4
    %v_1 = vwithlane %empty, 1, 1: i32x4
    %v_2 = vwithlane %v_1, 2, 2: i32x4
    %indices = vwithlane %v_2, 3, 3: i32x4
    %v_3 = vlane %empty, 0: I32
    %v_4 = cmp_neq %v_3, 0: I32
    je %v_4, b_5, b_6
  }

  b_6 {
    %v_7 = vlane %empty, 1: I32
    %v_8 = cmp_neq %v_7, 0: I32
    je %v_8, b_9, b_10
  }

  b_10 {
    %v_11 = vlane %indices, 0: I32
    %v_12 = cmp_neq %v_11, 0: I32
