  }

  b_14 {
    %v_15 = vlane %indices, 1: I32
    %v_16 = cmp_neq %v_15, 1: I32
    %v_17 = vreduce_add %indices: I32
    %v_18 = cmp_neq %v_17, 6: I32
    %v_19 = select %v_18, 18446744073709551610, 0: I32
    %v_20 = select %v_16, 18446744073709551612, %v_19: I32
    ret %v_20
  }

  b_13 {
    ret 18446744073709551613
  }

  b_9 {
    ret 18446744073709551614
  }

  b_5 {
    ret 18446744073709551615
  }
}

arithmetic<complex>(%v: i32x4): I32 {
  b_0 {
    %v_1 = vsplat 0: i32x4
    %v_2 = vwithlane %v_1, 1, 1: i32x4
    %v_3 = vwithlane %v_2, 2, 2: i32x4
    %indices = vwithlane %v_3, 3, 3: i32x4
    %v_4 = cmp_ilt %v, %indices: m32x4
    %lower = select %v_4, %v, %indices: i32x4
    %v_5 = cmp_igt %v, %indices: m32x4
    %upper = select %v_5, %v, %indices: i32x4
    %v_6 = vlane %lower, 0: I32
    %v_7 = cmp_neq %v_6, 0: I32
    je %v_7, b_8, b_9
  }

  b_8 {
    ret 18446744073709551615
  }

  b_9 {
    %v_10 = vlane %upper, 0: I32
    %v_11 = cmp_neq %v_10, 2: I32
    je %v_11, b_12, b_13
  }

  b_12 {
    ret 18446744073709551614
  }

  b_13 {
    %v_14 = vlane %lower, 1: I32
    %v_15 = cmp_neq %v_14, 1: I32
    je %v_15, b_16, b_17
  }

  b_16 {
    ret 18446744073709551613
