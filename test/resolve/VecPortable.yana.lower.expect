    %nines = vsplat 9: i32x4
    %low = vshuffle %indices, %nines, 0, 4, 1, 5: i32x4
    %high = vshuffle %indices, %nines, 2, 6, 3, 7: i32x4
    %v_22 = vlane %low, 0: I32
    %v_23 = cmp_neq %v_22, 0: I32
    je %v_23, b_24, b_25
