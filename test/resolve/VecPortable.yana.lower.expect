  b_17 {
    %v_18 = vlane %upper, 1: I32
    %v_19 = cmp_neq %v_18, 2: I32
    je %v_19, b_20, b_21
  }

  b_20 {
    ret 18446744073709551612
  }

  b_21 {
    %negated = sub %v_1, %v: i32x4
    %v_22 = abs %negated: i32x4
    %v_23 = vlane %v_22, 0: I32
    %v_24 = cmp_neq %v_23, 2: I32
    je %v_24, b_25, b_26
  }

  b_25 {
    ret 18446744073709551611
  }

  b_26 {
    %v_27 = abs %v: i32x4
    %v_28 = vlane %v_27, 1: I32
    %v_29 = cmp_neq %v_28, 2: I32
    je %v_29, b_30, b_31
  }

  b_30 {
    ret 18446744073709551610
  }

  b_31 {
    ret 0
  }
}

floats<complex>(): I32 {
  b_0 {
    %a = vsplat -1.5: f32x4
    %zeros = vsplat 0: f32x4
    %v_1 = abs %a: f32x4
    %v_2 = vlane %v_1, 0: F32
    %v_3 = cmp_neq %v_2, 1.5: I32
    je %v_3, b_4, b_5
  }

  b_4 {
    ret 18446744073709551615
  }

  b_5 {
    %v_6 = cmp_lt %a, %zeros: m32x4
    %v_7 = select %v_6, %a, %zeros: f32x4
    %v_8 = vlane %v_7, 0: F32
    %v_9 = cmp_neq %v_8, -1.5: I32
    je %v_9, b_10, b_11
  }

  b_10 {
    ret 18446744073709551614
  }

  b_11 {
    %v_12 = cmp_gt %a, %zeros: m32x4
    %v_13 = select %v_12, %a, %zeros: f32x4
    %v_14 = vlane %v_13, 1: F32
    %v_15 = cmp_neq %v_14, 0: I32
    je %v_15, b_16, b_17
  }

  b_16 {
    ret 18446744073709551613
  }

  b_17 {
    %v_18 = abs %zeros: f32x4
    %v_19 = vlane %v_18, 0: F32
    %v_20 = div 1, %v_19: F32
    %v_21 = cmp_lt %v_20, 0: I32
    je %v_21, b_22, b_23
  }

  b_22 {
    ret 18446744073709551612
