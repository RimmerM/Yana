regrouping<complex>(%v: i32x4): I32 {
  b_0 {
    %other = vwithlane %v, 5, 0: i32x4
    %v_1 = cast %v: i16x4
    %v_2 = cast %other: i16x4
    %packed = vshuffle %v_1, %v_2, 0, 1, 2, 3, 4, 5, 6, 7: i16x8
    %v_3 = vlane %packed, 0: I32
    %v_4 = imm 16: I32
    %v_5 = shl %v_3, %v_4: I32
    %v_6 = sar %v_5, %v_4: I32
    %v_7 = cmp_neq %v_6, 2: I32
    %v_8 = imm 16: I32
    je %v_7, b_9, b_10
  }

  b_10 {
    %v_11 = vlane %packed, 4: I32
    %v_12 = shl %v_11, %v_8: I32
    %v_13 = sar %v_12, %v_8: I32
    %v_14 = cmp_neq %v_13, 5: I32
    je %v_14, b_15, b_16
  }

  b_16 {
    %v_17 = vshuffle %packed, %packed, 0, 1, 2, 3: i16x4
    %low = cast %v_17: i32x4
    %v_18 = vshuffle %packed, %packed, 4, 5, 6, 7: i16x4
    %high = cast %v_18: i32x4
    %v_19 = vlane %low, 0: I32
    %v_20 = cmp_neq %v_19, 2: I32
    %v_21 = vlane %high, 0: I32
    %v_22 = cmp_neq %v_21, 5: I32
    %v_23 = select %v_22, 18446744073709551611, 0: I32
    %v_24 = select %v_20, 18446744073709551612, %v_23: I32
    ret %v_24
  }

  b_15 {
    ret 18446744073709551613
  }

  b_9 {
    ret 18446744073709551614
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = loads @seed, 4: I32
    %v = vsplat %v_1: i32x4
    %v_2 = call_complex construction: I32
    %v_3 = cmp_neq %v_2, 0: I32
    je %v_3, b_4, b_5
  }

  b_4 {
    %v_6 = call_complex construction: I32
    ret %v_6
  }

  b_5 {
    %v_7 = call_complex arithmetic, %v: I32
    %v_8 = cmp_neq %v_7, 0: I32
    je %v_8, b_9, b_10
  }

  b_9 {
    %v_11 = call_complex arithmetic, %v: I32
    %v_12 = imul %v_11, 10: I32
