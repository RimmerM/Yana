rearrangement<complex>(): I32 {
  b_0 {
    %v_1 = vsplat 0: i32x4
    %v_2 = vwithlane %v_1, 1, 1: i32x4
    %v_3 = vwithlane %v_2, 2, 2: i32x4
    %indices = vwithlane %v_3, 3, 3: i32x4
    %backwards = vshuffle %indices, %indices, 3, 2, 1, 0: i32x4
    %v_4 = vlane %backwards, 0: I32
    %v_5 = cmp_neq %v_4, 3: I32
    je %v_5, b_6, b_7
  }

  b_6 {
