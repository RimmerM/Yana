  }

  b_16 {
    %v_19 = call_complex rearrangement: I32
    %v_20 = cmp_neq %v_19, 0: I32
    je %v_20, b_21, b_22
  }

  b_21 {
    %v_23 = call_complex rearrangement: I32
    %v_24 = imul %v_23, 1000: I32
    ret %v_24
  }

  b_22 {
    %v_25 = loads @seed, 4: I32
    %v_26 = vsplat %v_25: i32x4
    %v_27 = call_complex regrouping, %v_26: I32
    %v_28 = cmp_neq %v_27, 0: I32
    je %v_28, b_29, b_30
  }

  b_29 {
    %v_31 = loads @seed, 4: I32
    %v_32 = vsplat %v_31: i32x4
    %v_33 = call_complex regrouping, %v_32: I32
    %v_34 = imul %v_33, 10000: I32
