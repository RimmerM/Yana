@image$base = []

countDown<complex>(%n: I32): I32 {
  b_0 {
    %v_1 = phi [b_2, %n], [b_3, %v_4]: I32
    %v_5 = phi [b_2, 0], [b_3, %v_6]: I32
    %v_7 = cmp_ile %v_1, 0: I32
    je %v_7, b_8, b_9
  }

  b_8 {
    ret %v_5
  }

  b_9 {
    jmp b_3
  }

  b_3 {
    %v_4 = sub %v_1, 1: I32
    %v_6 = add %v_5, %v_1: I32
    jmp b_0
  }

  b_2 {
    jmp b_0
  }
}

evenLength<complex>(%n: I32): I32 {
  b_0 {
    %v_1 = phi [b_2, %n], [b_3, %v_4]: I32
    %v_5 = cmp_ile %v_1, 0: I32
