    %v_1 = shl 16, %sizeClass: Long
    ret %v_1
  }
}

branch<complex>(%flag: Int): Long {
  b_0 {
    %held = alloca 8, 8: Ptr
    call_complex makeBuffer, %held, 16
    je %flag, b_1, b_2
  }

  b_1 {
    %counted = loads @liveBuffers, 8: Long
    %v_3 = call_complex firstByte, %held: Long
    call_complex Drop(Buffer).drop, %held
    %v_4 = add %counted, %v_3: Long
