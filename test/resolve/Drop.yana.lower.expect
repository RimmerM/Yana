    %v_9 = call_complex firstByte, %buffer: Long
    %v_10 = loads @liveBuffers, 8: Long
    %v_11 = add %v_9, %v_10: Long
    call_complex +=(I64), %total, %v_11
    %v_12 = loads %i, 8: Long
