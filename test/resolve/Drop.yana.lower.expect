allocateHeap<complex>(%size: Long): Ptr {
  b_0 {
    %v_1 = load @heapFree, 8: Ptr
    %v_2 = bitcast %v_1: Long
    %v_3 = cmp_eq %v_2, 0: Int
    je %v_3, b_4, b_5
  }

  b_4 {
    call_complex initHeap
    %v_6 = load @heapFree, 8: Ptr
    %v_7 = bitcast %v_6: Long
    %v_8 = cmp_eq %v_7, 0: Int
    je %v_8, b_9, b_10
  }

  b_5 {
    jmp b_11
  }

  b_9 {
    %v_12 = bitcast 0: Ptr
    ret %v_12
  }

  b_10 {
    jmp b_13
  }

  b_13 {
    jmp b_11
  }

  b_11 {
    %v_14 = add %size, 8: Long
    %sizeClass = call_complex heapClassOf, %v_14: Long
    %v_15 = cmp_ige %sizeClass, 32: Int
    je %v_15, b_16, b_17
  }

  b_16 {
    %v_18 = bitcast 0: Ptr
