    %v_8 = loads %size, 8: Long
    %v_9 = add %v_7, %v_8: Long
    store %size, %v_9, 8
    %v_10 = loads %sizeClass, 8: Long
    %v_11 = add %v_10, 1: Long
    store %sizeClass, %v_11, 8
    jmp b_1
  }
}

mapMemory<complex>(%size: Long): Ptr {
