    %blockSize = call_complex heapBlockSize, %sizeClass: Long
    %v_28 = add %block, %blockSize: Ptr
    %v_29 = load @heapLimit, 8: Ptr
    %v_30 = cmp_gt %v_28, %v_29: Int
    je %v_30, b_31, b_32
