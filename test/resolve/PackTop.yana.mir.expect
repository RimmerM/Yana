fn pin1(v: B1 [unique call]) -> {} {
bb0:
  %0: @bits(6) U32 = read copy.trivial (v.lo)
  %1: U32 = convert inspect %0
  %2: @bits(6) U32 = convert inspect %1
  write.assign borrow.unique (v.lo) take %2
  return
}

fn pin4(v: B4 [unique call]) -> {} {
