bb1(%5: I32, %6: I32):
  %13: I32 = read copy.trivial (local3)
  %14: Bool = lt inspect %13 inspect %5
  branch inspect %14 -> bb4(take %5, take %6) -> bb3(take %5, take %6)

bb2(%7: I32, %8: I32):
  %33: I32 = read copy.trivial (local3)
  %34: I32 = add inspect %33 inspect %8
  write.assign borrow.unique (local3) take %34
  jump -> bb1(take %7, take %8)

bb3(%9: I32, %10: I32):
