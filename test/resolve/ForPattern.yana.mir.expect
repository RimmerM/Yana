  return take %37

bb4(%15: I32, %16: I32):
  %18: I32 = read copy.trivial (local3)
  write.init borrow.unique (i) take %18
  %20: I32 = read copy.trivial (i)
  %21: I32 = read copy.trivial (i)
  %22: I32 = const 2
  %23: I32 = mul inspect %21 inspect %22
  %24: Pair = aggregate.Pair take %20 take %23
  %25: (Pair) -> I32 [shared call] = read borrow.shared ($body) loan0
  %26: I32 = call inspect %25 borrow.shared %24
  %27: I32 = const 0
  %28: Bool = eq inspect %26 inspect %27
  write.assign borrow.unique ($yielded) take %26
  branch inspect %28 -> bb5 -> bb6

bb5:
  jump -> bb2(take %15, take %16)

bb6:
  jump -> bb3(take %15, take %16)
}

