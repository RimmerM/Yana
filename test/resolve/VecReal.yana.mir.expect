  %24: F64 = mul inspect %22 inspect %23
  write.assign borrow.unique (scaled) take %24
  %26: I32 [unique call] = read borrow.unique (i) loan1
  %27: I32 = const 1
  %28: {} = call -=(I32) borrow.unique %26 borrow.shared %27
  jump -> bb4
}

fn nearFloat(got: Vec(F32) [shared call], want: F64 [shared call]) -> Bool {
  local scale: F64
  local bound: F64
  local difference: Vec(F32)
  local size: Vec(F32)

bb0:
  %0: F64 = read copy.trivial (want)
  %1: F64 = const 0
  %2: Bool = lt inspect %0 inspect %1
  branch inspect %2 -> bb3 -> bb1

bb1:
  %7: F64 = read copy.trivial (want)
  jump -> bb2(take %7)

bb2(%8: F64):
  write.init borrow.unique (scale) take %8
  %12: F64 = read copy.trivial (scale)
  %13: F64 = const 1
  %14: Bool = gt inspect %12 inspect %13
  branch inspect %14 -> bb6 -> bb4

bb3:
  %4: F64 = read copy.trivial (want)
  %5: F64 = const 0
  %6: F64 = sub inspect %5 inspect %4
  jump -> bb2(take %6)

bb4:
  %17: F64 = const 1
  jump -> bb5(take %17)

bb5(%18: F64):
  %21: F64 = const 0.00001
  %22: F64 = mul inspect %21 inspect %18
  write.init borrow.unique (bound) take %22
  %24: Vec(F32) = read copy.trivial (got)
  %25: F64 = read copy.trivial (want)
  %26: F32 = convert inspect %25
  %27: Vec(F32) = vec.splat inspect %26
  %28: Vec(F32) = sub inspect %24 inspect %27
  write.init borrow.unique (difference) take %28
  %30: Vec(F32) = read copy.trivial (difference)
  %31: F32 = const 0
  %32: Vec(F32) = vec.splat inspect %31
  %33: Mask(F32) = lt inspect %30 inspect %32
  %34: F32 = const 0
  %35: Vec(F32) = vec.splat inspect %34
  %36: Vec(F32) = read copy.trivial (difference)
  %37: Vec(F32) = sub inspect %35 inspect %36
  %38: Vec(F32) = read copy.trivial (difference)
  %39: Vec(F32) = select inspect %33 inspect %37 inspect %38
  write.init borrow.unique (size) take %39
  %41: Vec(F32) = read copy.trivial (size)
  %42: F64 = read copy.trivial (bound)
  %43: F32 = convert inspect %42
  %44: Vec(F32) = vec.splat inspect %43
  %45: Mask(F32) = le inspect %41 inspect %44
  %46: Bool = vec.reduce and inspect %45
  return take %46

bb6:
  %16: F64 = read copy.trivial (scale)
  jump -> bb5(take %16)
}

