module ResolveTest

fn refExponent(value: F64 [shared call]) -> F64 {
  local & rest: F64
  local & exponent: F64

bb0:
  %0: F64 = read copy.trivial (value)
  write.init borrow.unique (rest) take %0
  %2: F64 = const 0
  write.init borrow.unique (exponent) take %2
  jump -> bb1

bb1:
  %5: F64 = read copy.trivial (rest)
  %6: F64 = const 2
  %7: Bool = ge inspect %5 inspect %6
  branch inspect %7 -> bb3 -> bb2

bb2:
  jump -> bb4

bb3:
  %9: F64 = read copy.trivial (rest)
  %10: F64 = const 0.5
  %11: F64 = mul inspect %9 inspect %10
  write.assign borrow.unique (rest) take %11
  %13: F64 = read copy.trivial (exponent)
  %14: F64 = const 1
  %15: F64 = add inspect %13 inspect %14
  write.assign borrow.unique (exponent) take %15
  jump -> bb1

bb4:
  %19: F64 = read copy.trivial (rest)
  %20: F64 = const 1
  %21: Bool = lt inspect %19 inspect %20
  branch inspect %21 -> bb6 -> bb5

bb5:
  %32: F64 = read copy.trivial (exponent)
  return take %32

bb6:
  %23: F64 = read copy.trivial (rest)
  %24: F64 = const 2
  %25: F64 = mul inspect %23 inspect %24
  write.assign borrow.unique (rest) take %25
  %27: F64 = read copy.trivial (exponent)
  %28: F64 = const 1
  %29: F64 = sub inspect %27 inspect %28
  write.assign borrow.unique (exponent) take %29
  jump -> bb4
}

