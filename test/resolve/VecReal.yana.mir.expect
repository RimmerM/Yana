  %10: F64 = const 2
  %11: F64 = mul inspect %9 inspect %10
  write.assign borrow.unique (scaled) take %11
  %13: I32 [unique call] = read borrow.unique (i) loan0
  %14: I32 = const 1
  %15: {} = call +=(I32) borrow.unique %13 borrow.shared %14
  jump -> bb1

bb4:
  %18: I32 = read copy.trivial (i)
  %19: I32 = read copy.trivial (exponent)
  %20: Bool = gt inspect %18 inspect %19
  branch inspect %20 -> bb6 -> bb5

bb5:
