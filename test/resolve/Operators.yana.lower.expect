@image$base = []
mut @trace = [0, 0, 0, 0]

main<complex>(): I32 {
  b_0 {
    %v_1 = imm 15: I64
    %v_2 = loads @trace, 4: I32
    %v_3 = or %v_2, 3: I32
    store @trace, %v_3, 4
    %y = alloca 8, 8: Ptr
    store %y, %v_1, 8
    %v_4 = load %y, 8: I64
    %v_5 = cmp_eq %v_4, %v_1: I32
    je %v_5, b_6, b_7
  }

  b_6 {
    %v_8 = loads @trace, 4: I32
    %v_9 = or %v_8, 4: I32
    store @trace, %v_9, 4
    jmp b_7
  }

  b_7 {
    %v_10 = loads @trace, 4: I32
    %v_11 = or %v_10, 16376: I32
    store @trace, %v_11, 4
    jmp b_12
  }

  b_13 {
    %v_14 = cmp_ilt %v_15, 5: I32
    je %v_14, b_12, b_16
  }

  b_16 {
    %v_17 = cmp_eq %v_18, 3: I32
    je %v_17, b_19, b_20
  }

  b_19 {
    %v_21 = loads @trace, 4: I32
    %v_22 = or %v_21, 16384: I32
    store @trace, %v_22, 4
    jmp b_20
  }

  b_20 {
    %v_23 = loads @trace, 4: I32
    %v_24 = or %v_23, 32768: I32
    store @trace, %v_24, 4
    ret %v_24
  }

  b_12 {
    %v_25 = phi [b_13, %v_18], [b_7, 0]: I32
    %v_26 = phi [b_13, %v_15], [b_7, 2]: I32
    %v_18 = add %v_25, 1: I32
    %v_15 = add %v_26, 1: I32
    jmp b_13
  }
}

