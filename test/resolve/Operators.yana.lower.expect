@image$base = []
mut @trace = [0, 0, 0, 0]

main<complex>(): I32 {
  b_0 {
    %v_1 = imm 15: I64
    %v_2 = loads @trace, 4: I32
    %v_3 = or %v_2, 3: I32
    store @trace, %v_3, 4
    %y = alloca 8, 8: Ptr
    store %y, %v_1, 8
    jmp b_4
  }

  b_4 {
    jmp b_5
  }

  b_5 {
    %v_6 = load %y, 8: I64
    %v_7 = cmp_eq %v_6, %v_1: I32
    je %v_7, b_8, b_9
  }

  b_8 {
    %v_10 = loads @trace, 4: I32
    %v_11 = or %v_10, 4: I32
    store @trace, %v_11, 4
    jmp b_9
  }

  b_9 {
    %v_12 = loads @trace, 4: I32
    %v_13 = or %v_12, 16376: I32
    store @trace, %v_13, 4
    jmp b_14
  }

  b_15 {
    %v_16 = cmp_ilt %v_17, 5: I32
    je %v_16, b_14, b_18
  }

  b_18 {
    %v_19 = cmp_eq %v_20, 3: I32
    je %v_19, b_21, b_22
  }

  b_21 {
    %v_23 = loads @trace, 4: I32
    %v_24 = or %v_23, 16384: I32
    store @trace, %v_24, 4
    jmp b_22
  }

  b_22 {
    %v_25 = loads @trace, 4: I32
    %v_26 = or %v_25, 32768: I32
    store @trace, %v_26, 4
    ret %v_26
  }

  b_14 {
    %v_27 = phi [b_15, %v_20], [b_9, 0]: I32
    %v_28 = phi [b_15, %v_17], [b_9, 2]: I32
    %v_20 = add %v_27, 1: I32
    %v_17 = add %v_28, 1: I32
    jmp b_15
  }
}

