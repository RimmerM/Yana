module ResolveTest

data Pair {left: Counted, right: Counted}

data Counted {size: I32}

fn counted(n: I32 [shared call]) -> Counted {
bb0:
  %0: I32 = read copy.trivial (n)
  %1: Counted = aggregate.Counted take %0
  return take %1
}

fn main() -> I32 {
  local & a: Counted
  local local1: Counted
  local old: Counted
  local & p: Pair
  local local4: Counted
  local & xs: [Counted *1]
  local local6: Counted
  local taken: Counted

bb0:
  %0: I32 = const 1
  %1: Counted = call counted borrow.shared %0
