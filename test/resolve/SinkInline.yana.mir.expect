  %1: U8 = const 1
  %2: Bool = eq inspect %0 inspect %1
  branch inspect %2 -> bb3 -> bb1

bb1:
  drop (value)
  %10: Maybe(b) = aggregate.Nothing
  jump -> bb2(take %10)

bb2(%11: Maybe(b)):
  return take %11

bb3:
  %4: x = read take (value.Just)
  write.init borrow.unique (inner) take %4
  %6: (x) -> b [shared call] = read borrow.shared (f) loan0
  %7: x [shared call] = read borrow.shared (inner) loan1
  %8: b = call inspect %6 borrow.shared %7
  drop (inner)
  %9: Maybe(b) = aggregate.Just take %8
  jump -> bb2(take %9)
}

