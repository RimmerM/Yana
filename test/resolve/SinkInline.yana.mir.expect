class Functor(m, b -> n, a): map

instance Drop(Token): Token.drop

instance Functor(Maybe(x), b, Maybe(b), x): Maybe(x).map

let & dropped: I32 = 0

fn map(value: m, f: (a) -> b [shared call]) -> n = <no body>

fn Token.drop(value: Token) -> {} {
bb0:
  %0: I32 = read copy.trivial (global dropped)
  %1: I32 = const 1
  %2: I32 = add inspect %0 inspect %1
  write.assign borrow.unique (global dropped) take %2
  return
}

fn Maybe(x).map(value: Maybe(x), f: (x) -> b [shared call]) -> Maybe(b) {
  form specialized
  slot #0 type x
  slot #1 type b
  local inner: x object0

bb0:
