  write.init borrow.unique (local3) take %5
  %7: (I32) -> I32 [shared call shape8 .0=shared call] = read borrow.shared (local3) loan1 roots.0{0}
  %8: Maybe(I32) = call map(Maybe(I32), I32, Maybe(I32), I32) take %0 borrow.shared %7
