target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

module asm "\09.set \22image$base\22, 0"

@"image$base" = external constant [0 x i8], align 8

define fastcc i32 @scalars() {
  br label %1

1:                                                ; preds = %0
  %2 = call double @llvm.sqrt.f64(double 1.600000e+01)
  %3 = fcmp une double %2, 4.000000e+00
  %4 = zext i1 %3 to i32
  br i1 %3, label %5, label %6

5:                                                ; preds = %1
  ret i32 -1

6:                                                ; preds = %1
  br label %7

7:                                                ; preds = %6
  %8 = call double @llvm.sqrt.f64(double 2.250000e+00)
  %9 = fcmp une double %8, 1.500000e+00
  %10 = zext i1 %9 to i32
  br i1 %9, label %11, label %12

11:                                               ; preds = %7
  ret i32 -2

12:                                               ; preds = %7
  br label %13

13:                                               ; preds = %12
  br i1 false, label %14, label %15

14:                                               ; preds = %13
  ret i32 -3

15:                                               ; preds = %13
  br label %16

16:                                               ; preds = %15
  %17 = call float @llvm.sqrt.f32(float 6.250000e+00)
  %18 = fcmp une float %17, 2.500000e+00
  %19 = zext i1 %18 to i32
  br i1 %18, label %20, label %21

20:                                               ; preds = %16
  ret i32 -4

21:                                               ; preds = %16
  br label %22

22:                                               ; preds = %21
  %23 = call float @llvm.sqrt.f32(float 0.000000e+00)
  %24 = fdiv float 1.000000e+00, %23
  %25 = fcmp une float %24, 0x7FF0000000000000
  %26 = zext i1 %25 to i32
  br i1 %25, label %27, label %28

27:                                               ; preds = %22
  ret i32 -5

28:                                               ; preds = %22
  br label %29

29:                                               ; preds = %28
  ret i32 0
}

define fastcc i32 @lanes() {
  br label %1

1:                                                ; preds = %0
  %roots = call <4 x float> @llvm.sqrt.v4f32(<4 x float> <float 6.250000e+00, float 6.250000e+00, float 6.250000e+00, float 6.250000e+00>)
  %2 = extractelement <4 x float> %roots, i32 0
  %3 = fcmp une float %2, 2.500000e+00
  %4 = zext i1 %3 to i32
  br i1 %3, label %5, label %6

5:                                                ; preds = %1
  ret i32 -1

6:                                                ; preds = %1
  br label %7

7:                                                ; preds = %6
  %8 = call float @llvm.vector.reduce.fmin.v4f32(<4 x float> %roots)
  %9 = fcmp une float %8, 2.500000e+00
  %10 = zext i1 %9 to i32
  br i1 %9, label %11, label %12

11:                                               ; preds = %7
  ret i32 -2

12:                                               ; preds = %7
  br label %13

13:                                               ; preds = %12
  br i1 false, label %14, label %15

14:                                               ; preds = %13
  ret i32 -3

15:                                               ; preds = %13
  br label %16

16:                                               ; preds = %15
  br i1 false, label %17, label %18

17:                                               ; preds = %16
  ret i32 -4

18:                                               ; preds = %16
  br label %19

19:                                               ; preds = %18
  br i1 false, label %20, label %21

20:                                               ; preds = %19
  ret i32 -5

21:                                               ; preds = %19
  br label %22

22:                                               ; preds = %21
  br i1 false, label %23, label %24

23:                                               ; preds = %22
  ret i32 -6

24:                                               ; preds = %22
  br label %25

25:                                               ; preds = %24
  ret i32 0
}

define fastcc i32 @main() {
  br label %1

1:                                                ; preds = %0
  %2 = call fastcc i32 @scalars()
  %3 = icmp ne i32 %2, 0
  %4 = zext i1 %3 to i32
  br i1 %3, label %5, label %7

5:                                                ; preds = %1
  %6 = call fastcc i32 @scalars()
  ret i32 %6

7:                                                ; preds = %1
  br label %8

8:                                                ; preds = %7
  %9 = call fastcc i32 @lanes()
  %10 = icmp ne i32 %9, 0
  %11 = zext i1 %10 to i32
  br i1 %10, label %12, label %15

12:                                               ; preds = %8
  %13 = call fastcc i32 @lanes()
  %14 = mul i32 %13, 10
  ret i32 %14

15:                                               ; preds = %8
  br label %16

16:                                               ; preds = %15
  ret i32 7
}

; Function Attrs: nocallback nofree nosync nounwind readnone speculatable willreturn
declare double @llvm.sqrt.f64(double) #0

; Function Attrs: nocallback nofree nosync nounwind readnone speculatable willreturn
declare float @llvm.sqrt.f32(float) #0

; Function Attrs: nocallback nofree nosync nounwind readnone speculatable willreturn
declare <4 x float> @llvm.sqrt.v4f32(<4 x float>) #0

; Function Attrs: nocallback nofree nosync nounwind readnone willreturn
declare float @llvm.vector.reduce.fmin.v4f32(<4 x float>) #1

attributes #0 = { nocallback nofree nosync nounwind readnone speculatable willreturn }
attributes #1 = { nocallback nofree nosync nounwind readnone willreturn }
