target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

module asm "\09.set \22image$base\22, 0"

@"image$base" = external constant [0 x i8], align 8

define fastcc i32 @scalars() #0 {
  br label %1

1:                                                ; preds = %0
  %2 = call double @llvm.sqrt.f64(double 1.600000e+01)
  %3 = fcmp une double %2, 4.000000e+00
  %4 = zext i1 %3 to i32
  br i1 %3, label %5, label %6

5:                                                ; preds = %1
  ret i32 -1

6:                                                ; preds = %1
  %7 = call double @llvm.sqrt.f64(double 2.250000e+00)
  %8 = fcmp une double %7, 1.500000e+00
  %9 = zext i1 %8 to i32
  br i1 %8, label %10, label %11

10:                                               ; preds = %6
  ret i32 -2

11:                                               ; preds = %6
  br i1 false, label %12, label %13

12:                                               ; preds = %11
  ret i32 -3

13:                                               ; preds = %11
  %14 = call float @llvm.sqrt.f32(float 6.250000e+00)
  %15 = fcmp une float %14, 2.500000e+00
  %16 = zext i1 %15 to i32
  br i1 %15, label %17, label %18

17:                                               ; preds = %13
  ret i32 -4

18:                                               ; preds = %13
  %19 = call float @llvm.sqrt.f32(float 0.000000e+00)
  %20 = fdiv float 1.000000e+00, %19
  %21 = fcmp une float %20, 0x7FF0000000000000
  %22 = zext i1 %21 to i32
  br i1 %21, label %23, label %24

23:                                               ; preds = %18
  ret i32 -5

24:                                               ; preds = %18
  ret i32 0
}

define fastcc i32 @lanes() #0 {
  br label %1

1:                                                ; preds = %0
  %roots = call <4 x float> @llvm.sqrt.v4f32(<4 x float> splat (float 6.250000e+00))
  %2 = extractelement <4 x float> %roots, i32 0
  %3 = fcmp une float %2, 2.500000e+00
  %4 = zext i1 %3 to i32
  br i1 %3, label %5, label %6

5:                                                ; preds = %1
  ret i32 -1

6:                                                ; preds = %1
  %7 = call float @llvm.vector.reduce.fmin.v4f32(<4 x float> %roots)
  %8 = fcmp une float %7, 2.500000e+00
  %9 = zext i1 %8 to i32
  br i1 %8, label %10, label %11

10:                                               ; preds = %6
  ret i32 -2

11:                                               ; preds = %6
  br i1 false, label %12, label %13

12:                                               ; preds = %11
  ret i32 -3

13:                                               ; preds = %11
  br i1 false, label %14, label %15

14:                                               ; preds = %13
  ret i32 -4

15:                                               ; preds = %13
  br i1 false, label %16, label %17

16:                                               ; preds = %15
  ret i32 -5

17:                                               ; preds = %15
  br i1 false, label %18, label %19

18:                                               ; preds = %17
  ret i32 -6

19:                                               ; preds = %17
  ret i32 0
}

define fastcc i32 @main() #0 {
  br label %1

1:                                                ; preds = %0
  %2 = call fastcc i32 @scalars()
  %3 = icmp ne i32 %2, 0
  %4 = zext i1 %3 to i32
  br i1 %3, label %5, label %7

5:                                                ; preds = %1
  %6 = call fastcc i32 @scalars()
  ret i32 %6

7:                                                ; preds = %1
  %8 = call fastcc i32 @lanes()
  %9 = icmp ne i32 %8, 0
  %10 = zext i1 %9 to i32
  br i1 %9, label %11, label %14

11:                                               ; preds = %7
  %12 = call fastcc i32 @lanes()
  %13 = mul i32 %12, 10
  ret i32 %13

14:                                               ; preds = %7
  ret i32 7
}

; Function Attrs: nocallback nocreateundeforpoison nofree nosync nounwind speculatable willreturn memory(none)
declare double @llvm.sqrt.f64(double) #1

; Function Attrs: nocallback nocreateundeforpoison nofree nosync nounwind speculatable willreturn memory(none)
declare float @llvm.sqrt.f32(float) #1

; Function Attrs: nocallback nocreateundeforpoison nofree nosync nounwind speculatable willreturn memory(none)
declare <4 x float> @llvm.sqrt.v4f32(<4 x float>) #1

; Function Attrs: nocallback nofree nosync nounwind speculatable willreturn memory(none)
declare float @llvm.vector.reduce.fmin.v4f32(<4 x float>) #2

attributes #0 = { "probe-stack"="inline-asm" }
attributes #1 = { nocallback nocreateundeforpoison nofree nosync nounwind speculatable willreturn memory(none) }
attributes #2 = { nocallback nofree nosync nounwind speculatable willreturn memory(none) }
