    %v_1 = alloca 4, 4: Ptr
    %v_2 = loads %a, 4: I32
    store %v_1, %v_2, 4
    %v_3 = loads %b, 4: I32
    store %a, %v_3, 4
    %v_4 = loads %v_1, 4: I32
