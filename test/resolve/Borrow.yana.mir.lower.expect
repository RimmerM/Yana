
bump<complex>(%counter: Ptr, %by: I32) {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    store %v_1, %by, 4
    %v_2 = loads %counter, 4: I32
    %v_3 = loads %v_1, 4: I32
    %v_4 = add %v_2, %v_3: I32
    store %counter, %v_4, 4
    ret 
  }
}

