main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    %v_2 = alloca 4, 4: Ptr
    %v_3 = alloca 4, 4: Ptr
    %v_4 = alloca 8, 4: Ptr
    store %v_1, 0, 4
    call_complex bump, %v_1, 5
    call_complex +=(I32), %v_1, 3
