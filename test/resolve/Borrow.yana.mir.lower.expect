    %v_5 = alloca 8, 4: Ptr
    store %v_5, 10, 4
    %v_6 = add %v_5, 4: Ptr
    store %v_6, 20, 4
    copy %v_4, %v_5, 8
    call_complex moveBy, %v_4, 1, 2
    %v_7 = loads %v_1, 4: I32
    call_complex copyThroughBorrow, %v_1, %v_7
    %v_8 = loads %v_1, 4: I32
    %v_9 = loads %v_2, 4: I32
    %v_10 = loads %v_3, 4: I32
    %v_11 = sub %v_9, %v_10: I32
    %v_12 = add %v_8, %v_11: I32
    %v_13 = loads %v_4, 4: I32
    %v_14 = add %v_12, %v_13: I32
    %v_15 = add %v_4, 4: Ptr
    %v_16 = loads %v_15, 4: I32
    %v_17 = add %v_14, %v_16: I32
    ret %v_17
  }
}

