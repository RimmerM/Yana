@image$base = []
mut @failures = [0, 0, 0, 0]
mut @given = [2, 0, 0, 0]

describe<complex>(%actual: I32, %expected: I32): I32 {
  b_0 {
    %v_1 = imul %actual, 31: I32
    %a = add %v_1, 7: I32
    %v_2 = imul %expected, 17: I32
    %b = add %v_2, 3: I32
    %v_3 = imul %a, %b: I32
    %v_4 = sub %a, %b: I32
    %c = add %v_3, %v_4: I32
    %v_5 = imulhi %c, 1431655766: I32
    %v_6 = shr %v_5, 31: I32
    %v_7 = add %v_5, %v_6: I32
    %v_8 = add %c, %v_7: I32
    %v_9 = imulhi %c, 1717986919: I32
    %v_10 = sar %v_9, 1: I32
    %v_11 = shr %v_10, 31: I32
    %v_12 = add %v_10, %v_11: I32
    %v_13 = imul %v_12, 5: I32
    %v_14 = sub %c, %v_13: I32
    %v_15 = add %v_8, %v_14: I32
    ret %v_15
  }
}

report<complex>(%detail: I32) {
  b_0 {
    %v_1 = loads @failures, 4: I32
    %v_2 = add %v_1, %detail: I32
    store @failures, %v_2, 4
    ret 
  }
}

checked<complex>(%actual: I32, %expected: I32) {
  b_0 {
    %v_1 = cmp_eq %actual, %expected: I32
    je %v_1, b_2, b_3
  }

  b_2 {
    ret 
  }

  b_3 {
    jmp b_4
  }

  b_4 {
    %v_5 = call_complex describe, %actual, %expected: I32
    call_complex report, %v_5
    ret 
  }
}

stepped<complex>(%x: I32): I32 {
  b_0 {
    %a = add %x, 1: I32
    %b = shl %a, 1: I32
    %c = sub %b, 3: I32
    %v_1 = add %c, %a: I32
    %v_2 = add %v_1, %b: I32
    ret %v_2
  }
}

checkedAgain<complex>(%actual: I32, %limit: I32) {
  b_0 {
    %v_1 = cmp_ilt %actual, %limit: I32
    je %v_1, b_2, b_3
  }

  b_2 {
    ret 
  }

  b_3 {
    jmp b_4
  }

  b_4 {
    %v_5 = call_complex describe, %actual, %limit: I32
    call_complex report, %v_5
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = loads @given, 4: I32
    call_complex checked, %v_1, 1
    %v_2 = loads @given, 4: I32
    call_complex checked, %v_2, %v_2
    %v_3 = loads @given, 4: I32
    call_complex checkedAgain, %v_3, 9
    %v_4 = loads @failures, 4: I32
    %v_5 = loads @given, 4: I32
    %v_6 = call_complex stepped, %v_5: I32
    %v_7 = add %v_4, %v_6: I32
    ret %v_7
  }
}

