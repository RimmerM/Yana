module ResolveTest

data Metres {value: I32}

instance FromInt(Metres): Metres.fromInt

instance Eq(Metres): Metres.==, Metres.!=

fn inc(x: a [shared call]) -> a {
  form specialized
  slot #0 type a
  slot #1 class Num(a)
  local local1: a

bb0:
  %0: a [shared call] = read borrow.shared (x) loan0
  %1: I64 = const 1
  %2: a = call fromInt(a) borrow.shared %1
  write.init borrow.unique (local1) take %2
  %4: a [shared call] = read borrow.shared (local1) loan1
  %5: a = call +(a) borrow.shared %0 borrow.shared %4
  drop (local1)
  return take %5
}

fn two() -> a {
