fn isFive(distance: Metres [shared call]) -> Bool {
bb0:
  %0: Metres = read copy.trivial (distance)
  %1: I64 = const 5
  %2: Metres = call fromInt(Metres) borrow.shared %1
  %3: Bool = call ==(Metres) borrow.shared %0 borrow.shared %2
  return take %3
