  %2: F32 = const 2.5
  write.init borrow.unique (f) take %2
  %4: I32 = read copy.trivial (i)
  %5: F32 = read copy.trivial (f)
  %6: I32 = convert inspect %5
  %7: I32 = add inspect %4 inspect %6
