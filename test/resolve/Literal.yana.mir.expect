}

fn oneMetre() -> Metres {
bb0:
  %0: I64 = const 1
  %1: Metres = call fromInt(Metres) borrow.shared %0
  return take %1
}

fn measure(distance: Metres [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (distance.value)
  return take %0
