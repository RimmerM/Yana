module ResolveTest

data Config {verbose: Bool, level: @bits(4) U32, name: I32}

fn flip(b: Bool [unique call]) -> {} {
bb0:
  %0: Bool = read copy.trivial (b)
  %1: Bool = not inspect %0
  write.assign borrow.unique (b) take %1
  return
}

fn bump(x: @bits(4) U32 [unique call]) -> {} {
bb0:
  %0: @bits(4) U32 = read copy.trivial (x)
  %1: U32 = convert inspect %0
  %2: U32 = const 1
  %3: U32 = add inspect %1 inspect %2
  %4: @bits(4) U32 = convert inspect %3
  write.assign borrow.unique (x) take %4
  return
}

fn borrowFlag() -> I32 {
  local & c: Config

bb0:
  %0: Bool = const True
  %1: @bits(4) U32 = const 1
  %2: I32 = const 0
  %3: Config = aggregate.Config take %0 take %1 take %2
  write.init borrow.unique (c) take %3
  %5: Bool [unique call] = read borrow.unique (c.verbose) loan0
  %6: {} = call flip borrow.unique %5
  %7: Bool = read copy.trivial (c.verbose)
  branch inspect %7 -> bb3 -> bb1

bb1:
  %10: I32 = const 2
  jump -> bb2(take %10)

bb2(%11: I32):
  return take %11

bb3:
  %9: I32 = const 1
  jump -> bb2(take %9)
}

fn borrowBits() -> I32 {
  local & c: Config

bb0:
  %0: Bool = const True
  %1: @bits(4) U32 = const 15
  %2: I32 = const 0
  %3: Config = aggregate.Config take %0 take %1 take %2
  write.init borrow.unique (c) take %3
  %5: @bits(4) U32 [unique call] = read borrow.unique (c.level) loan0
  %6: {} = call bump borrow.unique %5
  %7: @bits(4) U32 [unique call] = read borrow.unique (c.level) loan1
  %8: {} = call bump borrow.unique %7
  %9: @bits(4) U32 = read copy.trivial (c.level)
  %10: I32 = convert inspect %9
  return take %10
}

fn flagOf(c: Config [unique slot 0]) -> Bool [unique slot 0 owner] {
bb0:
  %0: Bool [unique slot 0] = read borrow.unique (c.verbose) loan0
  return borrow.unique %0
}

fn returned() -> I32 {
  local & c: Config
  local & v: Bool [unique slot 0 owner]

bb0:
  %0: Bool = const False
  %1: @bits(4) U32 = const 3
  %2: I32 = const 7
  %3: Config = aggregate.Config take %0 take %1 take %2
  write.init borrow.unique (c) take %3
  %5: Config [unique slot 0] = read borrow.unique (c) loan0
  %6: Bool [unique slot 0 owner] = call flagOf borrow.unique %5 roots{0}
  write.init borrow.unique (v) borrow.unique %6
  %8: Bool = const True
  write.assign borrow.unique (v) take %8
  %10: Bool = read copy.trivial (c.verbose)
  branch inspect %10 -> bb3 -> bb1

bb1:
  %13: I32 = const 0
  jump -> bb2(take %13)

bb2(%14: I32):
  %17: @bits(4) U32 = read copy.trivial (c.level)
  %18: I32 = convert inspect %17
  %19: I32 = const 10
  %20: I32 = mul inspect %18 inspect %19
  %21: I32 = add inspect %14 inspect %20
  %22: I32 = read copy.trivial (c.name)
  %23: I32 = add inspect %21 inspect %22
  return take %23

bb3:
  %12: I32 = const 100
  jump -> bb2(take %12)
}

fn main() -> I32 {
bb0:
  %0: I32 = call borrowFlag
  %1: I32 = call borrowBits
  %2: I32 = const 1000
  %3: I32 = mul inspect %1 inspect %2
  %4: I32 = add inspect %0 inspect %3
  %5: I32 = call returned
  %6: I32 = const 10000
  %7: I32 = mul inspect %5 inspect %6
  %8: I32 = add inspect %4 inspect %7
  return take %8
}

entry main
