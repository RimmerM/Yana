fn lanes() -> Int {
  b0:
    %squares = vsplat 6.25 : Vec(Float)
    %roots = sqrt %squares : Vec(Float)
    %v6 = vlane %roots, 0 : Float
    %v9 = cmp_ne %v6, 2.5 : Bool
    je %v9, b1, b2

  b1:
    %v13 = neg 1 : Int
    ret %v13

  b2:
    jmp b3

  b3:
    %v16 = vreduce_min %roots : Float
    %v19 = cmp_ne %v16, 2.5 : Bool
    je %v19, b4, b5

  b4:
    %v23 = neg 2 : Int
    ret %v23

  b5:
    jmp b6

  b6:
    %v27 = vsplat 0 : Vec(Float)
    %v29 = vwithlane %v27, 1, 1 : Vec(Float)
    %v31 = vwithlane %v29, 2, 2 : Vec(Float)
    %counted = vwithlane %v31, 3, 3 : Vec(Float)
    %v36 = vsplat 3 : Vec(Float)
    %v39 = vsplat 1 : Vec(Float)
    %scaled = fma %counted %v36 %v39 : Vec(Float)
    %v43 = vlane %scaled, 0 : Float
    %v46 = cmp_ne %v43, 1 : Bool
    je %v46, b7, b8

  b7:
    %v50 = neg 3 : Int
    ret %v50

  b8:
    jmp b9

  b9:
    %v55 = vlane %scaled, 1 : Float
    %v58 = cmp_ne %v55, 4 : Bool
    je %v58, b10, b11

  b10:
    %v62 = neg 4 : Int
