}

fn main() -> Int {
  b0:
    %v0 = call scalars : Int
    %v3 = cmp_ne %v0, 0 : Bool
    je %v3, b1, b2

  b1:
    %v5 = call scalars : Int
    ret %v5

  b2:
    jmp b3

  b3:
    %v8 = call lanes : Int
    %v11 = cmp_ne %v8, 0 : Bool
    je %v11, b4, b5

  b4:
    %v13 = call lanes : Int
    %v16 = mul %v13, 10 : Int
    ret %v16

  b5:
    jmp b6

  b6:
    ret 7
}
