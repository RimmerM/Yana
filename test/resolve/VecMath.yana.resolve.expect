let image$base: () = <none>

fn scalars() -> Int {
  b0:
    %v1 = sqrt 16 : Double
    %v4 = cmp_ne %v1, 4 : Bool
    je %v4, b1, b2

  b1:
    %v8 = neg 1 : Int
    ret %v8

  b2:
    jmp b3

  b3:
    %v12 = sqrt 2.25 : Double
    %v15 = cmp_ne %v12, 1.5 : Bool
    je %v15, b4, b5

  b4:
    %v19 = neg 2 : Int
    ret %v19

  b5:
    jmp b6

  b6:
    %v27 = fma 2 3 4 : Double
    %v30 = cmp_ne %v27, 10 : Bool
    je %v30, b7, b8

  b7:
    %v34 = neg 3 : Int
    ret %v34

  b8:
    jmp b9

  b9:
    %v38 = sqrt 6.25 : Float
    %v41 = cmp_ne %v38, 2.5 : Bool
    je %v41, b10, b11

  b10:
    %v45 = neg 4 : Int
    ret %v45

  b11:
    jmp b12

  b12:
    %v53 = sub 0, 0 : Float
    %v54 = sqrt %v53 : Float
    %v56 = div 1, %v54 : Float
    %v62 = sub 0, 0 : Float
    %v64 = div 1, %v62 : Float
    %v65 = cmp_ne %v56, %v64 : Bool
    je %v65, b13, b14

  b13:
    %v69 = neg 5 : Int
