let image$base: () = <none>

fn scalars() -> Int {
  b0:
    %v1 = sqrt 16 : Double
    %v4 = cmp_ne %v1, 4 : Bool
    je %v4, b1, b2

  b1:
    ret -1

  b2:
    jmp b3

  b3:
    %v10 = sqrt 2.25 : Double
    %v13 = cmp_ne %v10, 1.5 : Bool
    je %v13, b4, b5

  b4:
    ret -2

  b5:
    jmp b6

  b6:
    %v23 = fma 2 3 4 : Double
    %v26 = cmp_ne %v23, 10 : Bool
    je %v26, b7, b8

  b7:
    ret -3

  b8:
    jmp b9

  b9:
    %v32 = sqrt 6.25 : Float
    %v35 = cmp_ne %v32, 2.5 : Bool
    je %v35, b10, b11

  b10:
    ret -4

  b11:
    jmp b12

  b12:
    %v45 = sub 0, 0 : Float
    %v46 = sqrt %v45 : Float
    %v48 = div 1, %v46 : Float
    %v54 = sub 0, 0 : Float
    %v56 = div 1, %v54 : Float
    %v57 = cmp_ne %v48, %v56 : Bool
    je %v57, b13, b14

  b13:
    ret -5

  b14:
    jmp b15

  b15:
    ret 0
}

fn lanes() -> Int {
  b0:
    %squares = vsplat 6.25 : Vec(Float)
    %roots = sqrt %squares : Vec(Float)
    %v6 = vlane %roots, 0 : Float
    %v9 = cmp_ne %v6, 2.5 : Bool
    je %v9, b1, b2

  b1:
    ret -1

  b2:
    jmp b3

  b3:
    %v14 = vreduce_min %roots : Float
    %v17 = cmp_ne %v14, 2.5 : Bool
    je %v17, b4, b5

  b4:
    ret -2

  b5:
    jmp b6

  b6:
    %v23 = vsplat 0 : Vec(Float)
    %v25 = vwithlane %v23, 1, 1 : Vec(Float)
    %v27 = vwithlane %v25, 2, 2 : Vec(Float)
    %counted = vwithlane %v27, 3, 3 : Vec(Float)
    %v32 = vsplat 3 : Vec(Float)
    %v35 = vsplat 1 : Vec(Float)
    %scaled = fma %counted %v32 %v35 : Vec(Float)
    %v39 = vlane %scaled, 0 : Float
    %v42 = cmp_ne %v39, 1 : Bool
    je %v42, b7, b8

  b7:
    ret -3

  b8:
    jmp b9

  b9:
    %v49 = vlane %scaled, 1 : Float
    %v52 = cmp_ne %v49, 4 : Bool
    je %v52, b10, b11

  b10:
    ret -4

  b11:
    jmp b12

  b12:
    %v59 = vlane %scaled, 2 : Float
    %v62 = cmp_ne %v59, 7 : Bool
    je %v62, b13, b14

  b13:
    ret -5

  b14:
    jmp b15

  b15:
    %v67 = vreduce_add %scaled : Float
    %v70 = cmp_ne %v67, 22 : Bool
    je %v70, b16, b17

  b16:
    ret -6

  b17:
    jmp b18

  b18:
    ret 0
}

fn main() -> Int {
  b0:
    %v0 = call scalars : Int
    %v3 = cmp_ne %v0, 0 : Bool
    je %v3, b1, b2

  b1:
    %v5 = call scalars : Int
    ret %v5

  b2:
    jmp b3

  b3:
    %v8 = call lanes : Int
    %v11 = cmp_ne %v8, 0 : Bool
    je %v11, b4, b5

  b4:
    %v13 = call lanes : Int
    %v16 = mul %v13, 10 : Int
    ret %v16

  b5:
    jmp b6

  b6:
    ret 7
}
