  b11:
    jmp b12

  b12:
    %v67 = vlane %scaled, 2 : Float
    %v70 = cmp_ne %v67, 7 : Bool
    je %v70, b13, b14

  b13:
    %v74 = neg 5 : Int
    ret %v74

  b14:
    jmp b15

  b15:
    %v77 = vreduce_add %scaled : Float
    %v80 = cmp_ne %v77, 22 : Bool
    je %v80, b16, b17

  b16:
    %v84 = neg 6 : Int
    ret %v84

  b17:
    jmp b18

  b18:
