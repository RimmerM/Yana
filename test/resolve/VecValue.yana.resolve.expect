let image$base: () = <none>

let &seed: Int = 3

fn doubled(%v: Vec(Int)) -> Vec(Int) {
  b0:
    %v1 = add %v, %v : Vec(Int)
    ret %v1
}

fn scaled(%v: Vec(Int), %by: Int) -> Vec(Int) {
  b0:
    %v2 = vsplat %by : Vec(Int)
    %v3 = mul %v, %v2 : Vec(Int)
    ret %v3
}

fn main() -> Int {
  b0:
    %v0 = load seed : Int
    %base = vsplat %v0 : Vec(Int)
    %twice = call doubled, %base : Vec(Int)
    %six = call scaled, %base, 2 : Vec(Int)
    %v7 = vlane %twice, 0 : Int
    %v10 = cmp_ne %v7, 6 : Bool
    je %v10, b1, b2

  b1:
    ret -1

  b2:
    jmp b3

  b3:
    %v17 = vlane %six, 1 : Int
    %v20 = cmp_ne %v17, 6 : Bool
    je %v20, b4, b5

  b4:
    ret -2

  b5:
    jmp b6

  b6:
    %mixed = vwithlane %base, 10, 0 : Vec(Int)
    %v30 = vreduce_max %mixed : Int
    %v33 = cmp_ne %v30, 10 : Bool
    je %v33, b7, b8

  b7:
    ret -3

  b8:
    jmp b9

  b9:
    %v38 = vreduce_min %mixed : Int
    %v41 = cmp_ne %v38, 3 : Bool
    je %v41, b10, b11

  b10:
    ret -4

  b11:
    jmp b12

  b12:
    %total = alloc : Vec(Int)
    init %total, %base
    %i = alloc : Int
    init %i, 0
    jmp b13

  b13:
    %v52 = load %i : Int
    %v55 = cmp_lt %v52, 4 : Bool
    je %v55, b15, b14

  b14:
    %v66 = load %total : Vec(Int)
    %v69 = vlane %v66, 0 : Int
    %v72 = cmp_ne %v69, 15 : Bool
    je %v72, b16, b17

  b15:
    %v57 = load %total : Vec(Int)
    %v58 = add %v57, %base : Vec(Int)
    assign %total, %v58
    %v60 = load %i : Int
    %v63 = add %v60, 1 : Int
    assign %i, %v63
    jmp b13

  b16:
    ret -5

  b17:
    jmp b18

  b18:
    %v77 = load %total : Vec(Int)
    %v80 = vlane %v77, 1 : Int
    %v83 = cmp_ne %v80, 15 : Bool
    je %v83, b19, b20

  b19:
    ret -6

  b20:
    jmp b21

  b21:
    %v90 = vsplat 1 : Vec(Int)
    %lanes = vreduce_add %v90 : Int
    %v92 = load %total : Vec(Int)
    %v93 = vreduce_add %v92 : Int
    %v96 = mul %lanes, 15 : Int
    %v97 = cmp_ne %v93, %v96 : Bool
    je %v97, b22, b23

  b22:
    ret -7

  b23:
    jmp b24

  b24:
    %v104 = vlane %twice, 1 : Int
    %v107 = mul %v104, 100 : Int
    %v110 = vlane %six, 0 : Int
    %v111 = add %v107, %v110 : Int
    %v114 = vlane %mixed, 0 : Int
    %v115 = add %v111, %v114 : Int
    ret %v115
}
