let string'158: [CodeUnit *3] = [82, 101, 100]

fn nameOfColour(c: Colour [shared call]) -> String {
bb0:
  %0: Colour = read copy.trivial (c)
  %1: String = call nameOf(Colour, I32) borrow.shared %0
  return take %1
}

fn colourOfName(s: String [shared call view]) -> Maybe(Colour) {
bb0:
  %0: String [shared call view] = read borrow.shared (s) loan0
  %1: Maybe(Colour) = call fromName(Colour, I32) borrow.shared %0
  return take %1
}

fn whenceName(w: Whence [shared call]) -> String {
bb0:
  %0: Whence = read copy.trivial (w)
  %1: String = call nameOf(Whence, I32) borrow.shared %0
  return take %1
}

fn instantiatedName(p: Pair(I32) [shared call]) -> String {
bb0:
  %0: Pair(I32) = read copy.trivial (p)
  %1: String = call nameOf(Pair(I32), I32) borrow.shared %0
  return take %1
}

fn instantiatedOfName(s: String [shared call view]) -> Maybe(Pair(I32)) {
bb0:
  %0: String [shared call view] = read borrow.shared (s) loan0
  %1: Maybe(Pair(I32)) = call fromName(Pair(I32), I32) borrow.shared %0
  return take %1
}

