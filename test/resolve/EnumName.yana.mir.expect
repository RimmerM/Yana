module ResolveTest

data Colour = Red | Green | Blue

data Whence = FromStart = 0 | FromCurrent = 1 | FromEnd = 2

data Pair(a) = Low | High

data Pair(I32) = Low | High of Pair

let string'150: [CodeUnit *5] = "Green"

let string'151: [CodeUnit *7] = "FromEnd"

let string'152: [CodeUnit *4] = "Blue"

let string'153: [CodeUnit *6] = "Purple"

