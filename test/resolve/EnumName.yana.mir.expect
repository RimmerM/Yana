module ResolveTest

data Colour = Red | Green | Blue

data Whence = FromStart = 0 | FromCurrent = 1 | FromEnd = 2

data Pair(a) = Low | High

data Pair(I32) = Low | High of Pair

let string'150: [CodeUnit *5] = [71, 114, 101, 101, 110]

let string'151: [CodeUnit *7] = [70, 114, 111, 109, 69, 110, 100]

