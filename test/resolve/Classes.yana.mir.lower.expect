mut @trace = [0, 0, 0, 0]

Guard.drop<complex>(%value: Ptr) {
  b_0 {
    %v_1 = load %value, 4: I32
    %v_2 = loads @trace, 4: I32
    %v_3 = imul %v_2, 10: I32
    %v_4 = add %v_3, %v_1: I32
    store @trace, %v_4, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = loads @trace, 4: I32
    %v_2 = cmp_neq %v_1, 0: I32
    je %v_2, b_3, b_4
  }

  b_4 {
    %v_5 = alloca 4, 4: Ptr
    store %v_5, 4, 4
    call_complex Guard.drop, %v_5
    %v_6 = loads @trace, 4: I32
    %v_7 = cmp_neq %v_6, 4: I32
    %v_8 = select %v_7, 18446744073709551603, 4243: I32
    ret %v_8
  }

  b_3 {
    ret 18446744073709551605
  }
}

