mut @trace = [0, 0, 0, 0]

Guard.drop<complex>(%value: Ptr) {
  b_0 {
    %v_1 = load %value, 4: I32
    %v_2 = loads @trace, 4: I32
    %v_3 = imul %v_2, 10: I32
    %v_4 = add %v_3, %v_1: I32
    store @trace, %v_4, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    jmp b_1
  }

  b_1 {
    jmp b_2
  }

  b_2 {
    jmp b_3
  }

  b_3 {
    jmp b_4
  }

  b_4 {
    jmp b_5
  }

  b_5 {
    jmp b_6
  }

  b_6 {
    jmp b_7
  }

  b_7 {
    jmp b_8
  }

  b_8 {
    %v_9 = loads @trace, 4: I32
    %v_10 = cmp_neq %v_9, 0: I32
    je %v_10, b_11, b_12
  }

  b_12 {
    %v_13 = alloca 4, 4: Ptr
    store %v_13, 4, 4
    call_complex Guard.drop, %v_13
    %v_14 = loads @trace, 4: I32
    %v_15 = cmp_neq %v_14, 4: I32
    %v_16 = select %v_15, 18446744073709551603, 4243: I32
    ret %v_16
  }

  b_11 {
    ret 18446744073709551605
  }
}

