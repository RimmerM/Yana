    store %v_10, 5, 4
    jmp b_11
  }

  b_11 {
    jmp b_12
  }

  b_12 {
    %v_13 = loads @trace, 4: I32
    %v_14 = cmp_neq %v_13, 0: I32
    je %v_14, b_15, b_16
  }

  b_16 {
    %v_17 = alloca 4, 4: Ptr
    store %v_17, 4, 4
    call_complex Guard.drop, %v_17
    %v_18 = loads @trace, 4: I32
    %v_19 = cmp_neq %v_18, 4: I32
    je %v_19, b_20, b_21
