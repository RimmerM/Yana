@image$base = []

reductions<complex>(): I32 {
  b_0 {
    %ones = vsplat 1: i32x8
    %count = vreduce_add %ones: I32
    %v_1 = cmp_ilt %count, 2: I32
    je %v_1, b_2, b_3
  }

  b_2 {
    ret 18446744073709551615
  }

  b_3 {
    %v_4 = vreduce_mul %ones: I32
    %v_5 = cmp_neq %v_4, 1: I32
    je %v_5, b_6, b_7
  }

  b_6 {
    ret 18446744073709551614
  }

  b_7 {
    %sevens = vsplat 7: i32x8
    %v_8 = vreduce_add %sevens: I32
    %v_9 = imul %count, 7: I32
    %v_10 = cmp_neq %v_8, %v_9: I32
    je %v_10, b_11, b_12
  }

  b_11 {
    ret 18446744073709551613
  }

  b_12 {
    %v_13 = vreduce_imin %sevens: I32
    %v_14 = cmp_neq %v_13, 7: I32
    je %v_14, b_15, b_16
  }

  b_15 {
    ret 18446744073709551612
  }

  b_16 {
    %v_17 = vwithlane %sevens, 9, 0: i32x8
    %v_18 = vreduce_imax %v_17: I32
    %v_19 = cmp_neq %v_18, 9: I32
    je %v_19, b_20, b_21
  }

  b_20 {
    ret 18446744073709551611
  }

  b_21 {
    %v_22 = vwithlane %sevens, 2, 1: i32x8
    %v_23 = vreduce_imin %v_22: I32
    %v_24 = cmp_neq %v_23, 2: I32
    je %v_24, b_25, b_26
  }

  b_25 {
    ret 18446744073709551610
  }

  b_26 {
    ret 0
  }
}

floats<complex>(): I32 {
  b_0 {
    %a = vsplat 1.5: f32x8
    %b = vsplat 2: f32x8
    %scaled = mul %a, %b: f32x8
    %v_1 = vlane %scaled, 0: F32
    %v_2 = cmp_neq %v_1, 3: I32
    je %v_2, b_3, b_4
  }

  b_3 {
    ret 18446744073709551615
  }

  b_4 {
    %v_5 = add %a, %b: f32x8
    %v_6 = vlane %v_5, 1: F32
    %v_7 = cmp_neq %v_6, 3.5: I32
    je %v_7, b_8, b_9
  }

  b_8 {
    ret 18446744073709551614
  }

  b_9 {
    %v_10 = neg %a: f32x8
    %v_11 = vlane %v_10, 0: F32
    %v_12 = cmp_neq %v_11, -1.5: I32
    je %v_12, b_13, b_14
  }

  b_13 {
    ret 18446744073709551613
  }

  b_14 {
    ret 0
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = call_complex reductions: I32
    %v_2 = cmp_neq %v_1, 0: I32
    je %v_2, b_3, b_4
  }

  b_3 {
    %v_5 = call_complex reductions: I32
    ret %v_5
  }

  b_4 {
    %v_6 = call_complex floats: I32
    %v_7 = cmp_neq %v_6, 0: I32
    je %v_7, b_8, b_9
  }

  b_8 {
    %v_10 = call_complex floats: I32
    %v_11 = imul %v_10, 10: I32
    ret %v_11
  }

  b_9 {
    %a = vsplat 3: i32x8
    %b = vsplat 4: i32x8
    %sum = add %a, %b: i32x8
    %v_12 = vsplat 2: i32x8
    %product = shl %a, %v_12: i32x8
    %difference = sub %b, %a: i32x8
    %v_13 = vlane %sum, 0: I32
    %v_14 = imul %v_13, 100: I32
    %v_15 = vlane %product, 0: I32
    %v_16 = add %v_14, %v_15: I32
    %v_17 = vlane %difference, 1: I32
    %v_18 = add %v_16, %v_17: I32
    %a = vsplat 12: i32x8
    %b = vsplat 10: i32x8
    %v_19 = and %a, %b: i32x8
    %v_20 = vlane %v_19, 0: I32
    %v_21 = imul %v_20, 100: I32
    %v_22 = or %a, %b: i32x8
    %v_23 = vlane %v_22, 0: I32
    %v_24 = add %v_21, %v_23: I32
    %v_25 = xor %a, %b: i32x8
    %v_26 = vlane %v_25, 1: I32
    %v_27 = add %v_24, %v_26: I32
    %v_28 = add %v_18, %v_27: I32
    %v = vsplat 5: i32x8
    %changed = vwithlane %v, 9, 1: i32x8
    %v_29 = vlane %changed, 0: I32
    %v_30 = imul %v_29, 100: I32
    %v_31 = vlane %changed, 1: I32
    %v_32 = add %v_30, %v_31: I32
    %v_33 = add %v_28, %v_32: I32
    ret %v_33
  }
}

