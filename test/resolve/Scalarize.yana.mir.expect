module ResolveTest

data Point {x: I32, y: I32}

fn readOnly() -> I32 {
  local p: Point

bb0:
  %0: I32 = const 3
  %1: I32 = const 4
  %2: Point = aggregate take %0 take %1
  write.init borrow.unique (p) take %2
  %4: I32 = read copy.trivial (p.x)
  %5: I32 = read copy.trivial (p.x)
  %6: I32 = mul inspect %4 inspect %5
  %7: I32 = read copy.trivial (p.y)
  %8: I32 = read copy.trivial (p.y)
  %9: I32 = mul inspect %7 inspect %8
  %10: I32 = add inspect %6 inspect %9
  return take %10
}

fn writable() -> I32 {
  local & p: Point

bb0:
  %0: I32 = const 3
  %1: I32 = const 4
  %2: Point = aggregate take %0 take %1
  write.init borrow.unique (p) take %2
  %4: I32 = read copy.trivial (p.x)
  %5: I32 = const 1
  %6: I32 = add inspect %4 inspect %5
  write.assign borrow.unique (p.x) take %6
  %8: I32 = read copy.trivial (p.x)
  %9: I32 = read copy.trivial (p.y)
  %10: I32 = add inspect %8 inspect %9
  return take %10
}

fn passedWhole() -> I32 {
  local p: Point

bb0:
  %0: I32 = const 3
  %1: I32 = const 4
  %2: Point = aggregate take %0 take %1
  write.init borrow.unique (p) take %2
  %4: Point = read copy.trivial (p)
  %5: I32 = call distance borrow.shared %4
  return take %5
}

fn distance(it: Point [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (it.x)
  %1: I32 = read copy.trivial (it.y)
  %2: I32 = add inspect %0 inspect %1
  return take %2
}

fn main() -> I32 {
bb0:
  %0: I32 = call readOnly
  %1: I32 = call writable
  %2: I32 = add inspect %0 inspect %1
  %3: I32 = call passedWhole
  %4: I32 = add inspect %2 inspect %3
  return take %4
}

entry main
