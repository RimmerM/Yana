fn concrete() -> I32 {
  local g: Gate
  local d: I32 [shared call]

bb0:
  %0: I32 = const 3
  %1: Gate = aggregate.Gate take %0
  write.init borrow.unique (g) take %1
  %3: Gate = read copy.trivial (g)
  lens.call depthOf(Gate) borrow.shared %3 -> bb1

bb1(%4: I32 [shared call]) handover(I32 [shared call]):
  write.init borrow.unique (d) borrow.shared %4
  %7: I32 = read copy.trivial (d)
  %8: I32 = const 1
  %9: I32 = add inspect %7 inspect %8
