module ResolveTest

data Gate {depth: I32}

class Guard(a): depth, hold, depthOf, twiceDeep, steps

instance Guard(Gate): Gate.depth, Gate.hold, Gate.depthOf, Guard.twiceDeep, Guard.steps

fn depth(self: a [shared call]) -> I32 = <no body>

lens fn hold(self: a [shared call], $body: ({}) -> I32 [shared call]) -> I32 = <no body>

lens fn depthOf(self: a [shared call], $body: (I32) -> I32 [shared call]) -> I32 = <no body>

lens fn twiceDeep(self: a [shared call], $body: (I32) -> I32 [shared call]) -> I32 {
  form specialized
  slot #0 type a
  slot #1 class Guard(a)
  local $yielded: I32

bb0:
  %0: a [shared call] = read borrow.shared (self) loan0
  %1: I32 = call depth(a) borrow.shared %0
  %2: I32 = const 2
  %3: I32 = mul inspect %1 inspect %2
  %4: (I32) -> I32 [shared call] = read borrow.shared ($body) loan1
  %5: I32 = call inspect %4 borrow.shared %3
  write.init borrow.unique ($yielded) take %5
  %7: I32 = read copy.trivial ($yielded)
  return take %7
}

lens fn steps(self: a [shared call], $body: (I32) -> I32 [shared call]) -> I32 {
  form specialized
  slot #0 type a
  slot #1 class Guard(a)
  local & $yielded: I32
  local & i: I32

bb0:
  %0: I32 = const 0
  write.init borrow.unique ($yielded) take %0
  %2: I32 = const 0
  write.init borrow.unique (i) take %2
  jump -> bb1

bb1:
  %5: I32 = read copy.trivial (i)
  %6: a [shared call] = read borrow.shared (self) loan0
  %7: I32 = call depth(a) borrow.shared %6
  %8: Bool = lt inspect %5 inspect %7
  branch inspect %8 -> bb3 -> bb2

bb2:
  %23: I32 = read copy.trivial ($yielded)
  return take %23

bb3:
  %10: I32 = read copy.trivial (i)
  %11: (I32) -> I32 [shared call] = read borrow.shared ($body) loan1
  %12: I32 = call inspect %11 borrow.shared %10
  %13: I32 = const 0
  %14: Bool = eq inspect %12 inspect %13
  write.assign borrow.unique ($yielded) take %12
  branch inspect %14 -> bb4 -> bb5

bb4:
  %18: I32 = read copy.trivial (i)
  %19: I32 = const 1
  %20: I32 = add inspect %18 inspect %19
  write.assign borrow.unique (i) take %20
  jump -> bb1

bb5:
  jump -> bb2
}

fn Gate.depth(self: Gate [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (self.depth)
  return take %0
}

lens fn Gate.hold(self: Gate [shared call], $body: ({}) -> I32 [shared call]) -> I32 {
  local $yielded: I32

bb0:
