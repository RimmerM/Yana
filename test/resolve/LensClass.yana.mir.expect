}

lens fn twiceDeep(Gate)(self: Gate [shared call], $body: (I32) -> I32 [shared call]) -> I32 = <twiceDeep at Gate>

lens fn steps(Gate)(self: Gate [shared call], $body: (I32) -> I32 [shared call]) -> I32 = <steps at Gate>

