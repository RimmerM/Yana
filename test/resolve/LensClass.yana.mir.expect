fn main() -> I32 {
  local g: Gate

bb0:
  %0: I32 = const 2
  %1: Gate = aggregate.Gate take %0
  write.init borrow.unique (g) take %1
  %3: I32 = call concrete
  %4: I32 = call dotted
  %5: I32 = add inspect %3 inspect %4
  %6: I32 = call unitHandover
  %7: I32 = add inspect %5 inspect %6
  %8: Gate = read copy.trivial (g)
  %9: I32 = call deferred(Gate) borrow.shared %8
  %10: I32 = add inspect %7 inspect %9
  %11: Gate = read copy.trivial (g)
  %12: I32 = call deferredDot(Gate) borrow.shared %11
  %13: I32 = add inspect %10 inspect %12
  %14: Gate = read copy.trivial (g)
  %15: I32 = const 9
  %16: I32 = call deferredUnit(Gate) borrow.shared %14 borrow.shared %15
  %17: I32 = add inspect %13 inspect %16
  %18: Gate = read copy.trivial (g)
  %19: I32 = call deferredExit(Gate) borrow.shared %18
  %20: I32 = add inspect %17 inspect %19
  %21: I32 = call inherited
  %22: I32 = add inspect %20 inspect %21
  %23: Gate = read copy.trivial (g)
  %24: I32 = call deferredDefault(Gate) borrow.shared %23
  %25: I32 = add inspect %22 inspect %24
  %26: I32 = call iterated
  %27: I32 = add inspect %25 inspect %26
  %28: Gate = read copy.trivial (g)
  %29: I32 = call deferredIter(Gate) borrow.shared %28
  %30: I32 = add inspect %27 inspect %29
