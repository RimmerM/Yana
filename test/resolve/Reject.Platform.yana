-- What `@platform` rejects. A typo would otherwise delete a declaration from every build and be
-- discovered as a missing name somewhere else entirely, so the attribute is checked where it is
-- written rather than where its absence is felt.

@platform(wasm)
fn onlyWasm() -> Int = 1

@platform
fn noTarget() -> Int = 2

@platform("js")
fn quoted() -> Int = 3

-- An architecture is a target name and a *level* within one is not: `-extensions` says which
-- machine inside x86-64 to generate for, and a declaration that exists only above one is a question
-- about instruction selection rather than about which target compiled it.
@platform(avx2)
fn wideOnly() -> Int = 4

-- The control, and the line between it and the one above. An extension that no level implies is a
-- target name, because it comes as a *pair* - `sha` and `nosha` partition every target, so a
-- declaration excluded by one is answered by another the other selected. `avx2` has no such other
-- half: there is nothing a build below it selects instead, which is what makes it a question about
-- encoding rather than about which program was resolved.
@platform(sha)
fn withExtension() -> Int = 5

fn main() -> Int = 0
