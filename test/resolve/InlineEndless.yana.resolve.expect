let image$base: () = <none>

let &seed: I32 = 3

fn endless(%n: I32) -> I32 {
  b0:
    %i = alloc : I32
    init %i, %n
    jmp b1

  b1:
    %v8 = cmp_lt 1, 2 : Bool
    je %v8, b3, b2

  b2:
    %v16 = load %i : I32
    ret %v16

  b3:
    %v10 = load %i : I32
    %v13 = add %v10, 1 : I32
    assign %i, %v13
    jmp b1
}

fn guarded(%n: I32) -> I32 {
  b0:
    %v3 = cmp_gt %n, 1000000 : Bool
    je %v3, b1, b2

  b1:
    %v5 = call endless, %n : I32
    ret %v5

  b2:
    jmp b3

  b3:
    %v10 = mul %n, 2 : I32
    ret %v10
}

fn doubled(%n: I32) -> I32 {
  b0:
    %v3 = mul %n, 2 : I32
    %v6 = add %v3, 1 : I32
    ret %v6
}

fn main() -> I32 {
  b0:
    %v0 = load seed : I32
    %v1 = call guarded, %v0 : I32
    %v4 = mul %v1, 3 : I32
    %v5 = load seed : I32
    %v6 = call doubled, %v5 : I32
    %v7 = add %v4, %v6 : I32
    ret %v7
}
