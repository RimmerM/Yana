differs<complex>(%wide: i8x32, %first: i8x16, %second: i8x16): I32 {
  b_0 {
    %v = bitcast %wide: i64x4
    %v_1 = vlane %v, 0: I64
    %v_2 = bitcast %first: i64x2
    %v_3 = vlane %v_2, 0: I64
    %v_4 = cmp_neq %v_1, %v_3: I32
    je %v_4, b_5, b_6
  }

  b_5 {
    jmp b_7
  }

  b_6 {
    jmp b_7
  }

  b_7 {
    %v_8 = phi [b_5, 1], [b_6, 0]: I32
    %v_9 = vlane %v, 1: I64
    %v_10 = vlane %v_2, 1: I64
    %v_11 = cmp_neq %v_9, %v_10: I32
    je %v_11, b_12, b_13
  }

  b_12 {
    %v_14 = add %v_8, 1: I32
    jmp b_15
  }

  b_13 {
    jmp b_15
  }

  b_15 {
    %v_16 = phi [b_12, %v_14], [b_13, %v_8]: I32
    %v_17 = vlane %v, 2: I64
    %v_18 = bitcast %second: i64x2
    %v_19 = vlane %v_18, 0: I64
    %v_20 = cmp_neq %v_17, %v_19: I32
    je %v_20, b_21, b_22
  }

  b_21 {
    %v_23 = add %v_16, 1: I32
    jmp b_24
  }

  b_22 {
    jmp b_24
  }

  b_24 {
    %v_25 = phi [b_21, %v_23], [b_22, %v_16]: I32
    %v_26 = vlane %v, 3: I64
    %v_27 = vlane %v_18, 1: I64
    %v_28 = cmp_neq %v_26, %v_27: I32
    je %v_28, b_29, b_30
  }

  b_29 {
    %v_31 = add %v_25, 1: I32
    jmp b_32
  }

  b_30 {
