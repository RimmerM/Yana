nextKey<complex>(%key: i8x16, %assist: i8x16): i8x16 {
  b_0 {
    %v_1 = bitcast %assist: i32x4
    %t = vshuffle %v_1, %v_1, 3, 3, 3, 3: i32x4
    %z = vsplat 0: i32x4
    %k0 = bitcast %key: i32x4
    %v_2 = vshuffle %k0, %z, 7, 0, 1, 2: i32x4
    %k1 = xor %k0, %v_2: i32x4
    %v_3 = vshuffle %k1, %z, 6, 7, 0, 1: i32x4
    %k2 = xor %k1, %v_3: i32x4
    %v_4 = xor %k2, %t: i32x4
    %v_5 = bitcast %v_4: i8x16
    ret %v_5
  }
}

encryptOne<complex>(%plain: i8x16, %k0: i8x16, %k1: i8x16, %k2: i8x16, %k3: i8x16, %k4: i8x16, %k5: i8x16, %k6: i8x16, %k7: i8x16, %k8: i8x16, %k9: i8x16, %k10: i8x16): i8x16 {
