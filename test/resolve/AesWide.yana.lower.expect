pair<complex>(%first: i8x16, %second: i8x16): i8x32 {
  b_0 {
    %v_1 = bitcast %first: i64x2
    %v_2 = vlane %v_1, 0: I64
    %v_3 = vlane %v_1, 1: I64
    %v_4 = bitcast %second: i64x2
    %v_5 = vlane %v_4, 0: I64
    %v_6 = vlane %v_4, 1: I64
    %v_7 = vsplat 0: i64x4
    %v_8 = vwithlane %v_7, %v_2, 0: i64x4
    %v_9 = vwithlane %v_8, %v_3, 1: i64x4
    %v_10 = vwithlane %v_9, %v_5, 2: i64x4
    %v_11 = vwithlane %v_10, %v_6, 3: i64x4
    %v_12 = bitcast %v_11: i8x32
    ret %v_12
  }
}

