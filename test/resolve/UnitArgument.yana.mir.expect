module ResolveTest

class Wrap(a): wrap

instance Wrap({}): {}.wrap

instance Wrap(I32): I32.wrap

fn wrap(value: a [shared call]) -> I32 = <no body>

fn {}.wrap(value: {} [shared call]) -> I32 {
bb0:
  %0: I32 = const 7
  return take %0
}

fn I32.wrap(value: I32 [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (value)
  %1: I32 = const 1
  %2: I32 = add inspect %0 inspect %1
  return take %2
}

fn nothing() -> {} {
bb0:
  %0: {} = const {}
  return
}

fn wrap'2(a: I32 [shared call], b: I32 [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (a)
  %1: I32 = read copy.trivial (b)
  %2: I32 = add inspect %0 inspect %1
  return take %2
}

fn main() -> I32 {
  local literal: I32
  local produced: I32
  local ordinary: I32
  local plain: I32

bb0:
  %0: {} = const {}
  %1: I32 = call wrap({}) borrow.shared {}
  write.init borrow.unique (literal) take %1
  %3: {} = call nothing
  %4: I32 = call wrap({}) borrow.shared {}
  write.init borrow.unique (produced) take %4
  %6: I32 = const 3
  %7: I32 = call wrap(I32) borrow.shared %6
  write.init borrow.unique (ordinary) take %7
  %9: I32 = const 10
  %10: I32 = const 20
  %11: I32 = call wrap'2 borrow.shared %9 borrow.shared %10
  write.init borrow.unique (plain) take %11
  %13: I32 = read copy.trivial (literal)
  %14: I32 = read copy.trivial (produced)
  %15: I32 = add inspect %13 inspect %14
  %16: I32 = read copy.trivial (ordinary)
  %17: I32 = add inspect %15 inspect %16
  %18: I32 = read copy.trivial (plain)
  %19: I32 = add inspect %17 inspect %18
  return take %19
}

entry main
