@image$base = []

main<complex>(): I32 {
  b_0 {
    jmp b_1
  }

  b_2 {
    %v_3 = cmp_ilt %v_4, 3: I32
    je %v_3, b_1, b_5
  }

  b_5 {
    %v_6 = alloca 4, 8: Ptr
    %v_7 = alloca 16, 4: Ptr
    %v_8 = load %v_6, 4: I32
    store %v_6, 4, 4
    store %v_7, 1, 4
    %v_9 = add %v_7, 4: Ptr
    store %v_9, 2, 4
    %v_10 = add %v_7, 8: Ptr
    store %v_10, 3, 4
    %v_11 = add %v_7, 12: Ptr
    store %v_11, 4, 4
    %v_12 = add %v_13, 11: I32
    ret %v_12
  }

  b_1 {
    %v_14 = phi [b_2, %v_13], [b_0, 0]: I32
    %v_15 = phi [b_2, %v_4], [b_0, 0]: I32
    %v_16 = add %v_14, 5: I32
    %v_13 = add %v_16, %v_15: I32
    %v_4 = add %v_15, 1: I32
    jmp b_2
  }
}

