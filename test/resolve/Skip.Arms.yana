-- Where a skipping lens's alternative is written, and in which of the two arm shapes.
--
-- `Skip.yana` is the construct; this is its surface. One `|` with one meaning wherever it appears,
-- and two positions for it chosen by the *arm* rather than by what the initializer turned out to be:
-- inline after the call, and after the block the call hands its values to. The second exists only
-- where the extent is written - `let ... in:` - because the flat form's extent is the rest of the
-- enclosing block and there is nothing for an alternative to come after.
--
-- `test/resolve/lens/Skipping.Syntax.yana` is the same surface over the ownership resolver's `| E`
-- channel. The two stages spell the *declaration* differently and the call site identically, which
-- is the property this pair exists to hold.

let &log = 0 :: Int

lens fn checked(n: Int, body: (value: Int) -> a) -> Result(Int, a):
    if n > 9: return Err(n)

    return Ok(body(n * 2))

lens fn doubled(x: Int) -> Int:
    log = log + 1
    yield x * 2
    log = log + 10

-- `| pat -> expr` with no `match` in front of it, which is the shape an arm already has under
-- `match e:`. There is no bare `x -> e` lambda for it to be ambiguous with, so the keyword said
-- nothing the pattern did not.
fn bareArm(n: Int) -> Int:
    let v = checked(n) | code -> return code
    return v + 1

-- The same arm as a block. The flat form can take one inline because nothing follows the alternative
-- that the `:` could belong to.
fn blockArm(n: Int) -> Int:
    let v = checked(n) | code:
        log = log + 1
        return code * 2

    return v + 1

-- The extent written out, with the arm still inline.
fn scopedArm(n: Int) -> Int:
    let &sum = 0 :: Int

    let v = checked(n) | code -> sum = sum + code in:
        sum = sum + v

    return sum

-- ... and with the arm after the block, where both arms are blocks and the rare path is last. This
-- is the shape the `in:` collision made unwritable before: the `:` after an inline alternative opens
-- the extent, so an arm written there has nowhere to put a block of its own.
fn trailingArm(n: Int) -> Int:
    let &sum = 0 :: Int

    let v = checked(n) in:
        sum = sum + v
    | code:
        sum = sum + code * 3

    return sum

-- The fallback in the trailing position, which is `else` written where `else` goes.
fn trailingElse(n: Int) -> Int:
    let &sum = 0 :: Int

    let v = checked(n) in:
        sum = sum + v
    | else:
        sum = sum + 100

    return sum

-- A transparent lens with a written extent and therefore no alternatives at all. The statement after
-- it is not part of the continuation, which is the whole of what writing the extent buys - in the
-- flat form `return sum + 1` would have been inside the block the lens hands its value to.
fn transparentIn(n: Int) -> Int:
    let &sum = 0 :: Int

    let d = doubled(n) in:
        sum = sum + d

    return sum + 1

-- The spellings that were here before, unchanged.
fn keptSpellings(n: Int) -> Int:
    let a = checked(n) | match code -> return code
    let b = checked(a) | else -> return 0
    return b

fn main() -> Int:
    log = 0

    let a = bareArm(3)        -- 7
    let b = bareArm(20)       -- 20
    let c = blockArm(3)       -- 7
    let d = blockArm(20)      -- 40,  log 1
    let e = scopedArm(3)      -- 6
    let f = scopedArm(20)     -- 20
    let g = trailingArm(3)    -- 6
    let h = trailingArm(20)   -- 60
    let i = trailingElse(3)   -- 6
    let j = trailingElse(20)  -- 100
    let k = transparentIn(4)  -- 9,   log 12
    let l = keptSpellings(3)  -- 12
    let m = keptSpellings(20) -- 20

    -- 313, plus log 12.
    return a + b + c + d + e + f + g + h + i + j + k + l + m + log
