@image$base = []
mut @dropped = [0, 0, 0, 0]

branched<complex>(%flag: I32) {
  b_0 {
    %v_1 = imm 128: I32
    je %flag, b_2, b_3
  }

  b_2 {
    %v_4 = loads @dropped, 4: I32
    %v_5 = add %v_4, %v_1: I32
    store @dropped, %v_5, 4
    jmp b_6
  }

  b_6 {
    ret 
  }

  b_3 {
    %v_7 = loads @dropped, 4: I32
    %v_8 = add %v_7, %v_1: I32
    store @dropped, %v_8, 4
    jmp b_6
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = loads @dropped, 4: I32
    %v_2 = add %v_1, 3: I32
    store @dropped, %v_2, 4
    %v_3 = alloca 4, 4: Ptr
    store %v_3, 4, 4
    jmp b_4
  }

  b_5 {
    %v_6 = cmp_ilt %v_7, 1: I32
    je %v_6, b_4, b_8
  }

  b_8 {
    %v_9 = loads @dropped, 4: I32
    %v_10 = add %v_9, 120: I32
    store @dropped, %v_10, 4
    call_complex branched, 1
    call_complex branched, 0
    %v_11 = loads @dropped, 4: I32
    ret %v_11
  }

  b_4 {
    %v_12 = phi [b_5, %v_7], [b_0, 0]: I32
    %v_13 = sext %v_12: I64
    %v_14 = shl %v_13, 2: I64
    %v_15 = add %v_3, %v_14: Ptr
    %v_16 = load %v_15, 4: I32
    %v_17 = loads @dropped, 4: I32
    %v_18 = add %v_17, %v_16: I32
    store @dropped, %v_18, 4
    %v_7 = add %v_12, 1: I32
    jmp b_5
  }
}

