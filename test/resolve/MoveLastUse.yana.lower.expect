@image$base = []
mut @dropped = [0, 0, 0, 0]

branched<complex>(%flag: I32) {
  b_0 {
    %v_1 = imm 128: I32
    je %flag, b_2, b_3
  }

  b_2 {
    %v_4 = loads @dropped, 4: I32
    %v_5 = add %v_4, %v_1: I32
    store @dropped, %v_5, 4
    jmp b_6
  }

  b_7 {
    jmp b_6
  }

  b_6 {
    ret 
  }

  b_3 {
    %v_8 = loads @dropped, 4: I32
    %v_9 = add %v_8, %v_1: I32
    store @dropped, %v_9, 4
    jmp b_7
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = loads @dropped, 4: I32
    %v_2 = add %v_1, 3: I32
    store @dropped, %v_2, 4
    %v_3 = alloca 4, 4: Ptr
    store %v_3, 4, 4
    %v_4 = alloca 4, 8: Ptr
    store %v_4, 1, 4
    jmp b_5
  }

  b_6 {
    %v_7 = cmp_ilt %v_8, 1: I32
    je %v_7, b_5, b_9
  }

  b_9 {
    %v_10 = loads @dropped, 4: I32
    %v_11 = add %v_10, 120: I32
    store @dropped, %v_11, 4
    call_complex branched, 1
    call_complex branched, 0
    %v_12 = loads @dropped, 4: I32
    ret %v_12
  }

  b_5 {
    %v_13 = phi [b_6, %v_8], [b_0, 0]: I32
    %v_14 = sext %v_13: I64
    %v_15 = shl %v_14, 2: I64
    %v_16 = add %v_3, %v_15: Ptr
    %v_17 = load %v_16, 4: I32
    %v_18 = loads @dropped, 4: I32
    %v_19 = add %v_18, %v_17: I32
    store @dropped, %v_19, 4
    %v_8 = add %v_13, 1: I32
    jmp b_6
  }
}

