fn taken(mark: I32 [shared call]) -> I32 {
  local taken.thunk.env: taken.thunk.env

bb0:
  %0: I32 = const 1
  %1: Gate = aggregate.Gate take %0
  %2: I32 = read copy.trivial (mark)
  %3: taken.thunk.env = aggregate.taken.thunk.env take %2
  write.init borrow.unique (taken.thunk.env) take %3
  %5: taken.thunk.env [shared call] = read borrow.shared (taken.thunk.env) loan0
  %6: () -> I32 [owned here shape1 .0=shared call] = fun.value taken.thunk inspect %5 roots.0{0}
  %7: I32 = call pick(Gate) borrow.shared %1 borrow.shared %6
  return take %7
}

