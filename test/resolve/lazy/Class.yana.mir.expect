bb0:
  %0: a [shared call] = read borrow.shared (x) loan0
  %1: () -> I32 [shared call] = read borrow.shared (v) loan1
  %2: I32 = call pick(a) borrow.shared %0 borrow.shared %1
  return take %2
}

