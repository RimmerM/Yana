class Guard(a): depth, pick, orZero

instance Guard(Gate): Gate.depth, Gate.pick, Guard.orZero

instance Guard(Shut): Shut.depth, Shut.pick, Shut.orZero

let & effects: I32 = 0

fn depth(self: a [shared call]) -> I32 = <no body>

fn pick(self: a [shared call], @lazy v: () -> I32 [shared call]) -> I32 = <no body>

fn orZero(self: a [shared call], @lazy v: () -> I32 [shared call]) -> I32 {
  form specialized
  slot #0 type a
  slot #1 class Guard(a)
bb0:
  %0: a [shared call] = read borrow.shared (self) loan0
  %1: I32 = call depth(a) borrow.shared %0
  %2: I32 = const 0
  %3: Bool = eq inspect %1 inspect %2
  branch inspect %3 -> bb3 -> bb1

bb1:
  jump -> bb2

bb2:
  %8: () -> I32 [shared call] = read borrow.shared (v) loan1
  %9: I32 = call inspect %8
  return take %9

bb3:
  %5: I32 = const 0
  return take %5
}

fn bump(mark: I32 [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (global effects)
  %1: I32 = read copy.trivial (mark)
  %2: I32 = add inspect %0 inspect %1
  write.assign borrow.unique (global effects) take %2
  %4: I32 = read copy.trivial (mark)
  return take %4
}

