"use strict";
// ResolveTest
function countDown(n) {
  if (n <= 0) {
    return 0;
  } else {
    return n + countDown(n - 1 | 0) | 0;
  }
}

function evenLength(n) {
  if (n <= 0) {
    return 1;
  } else {
    return oddLength(n - 1 | 0);
  }
}

function oddLength(n) {
  if (n <= 0) {
    return 0;
  } else {
    return evenLength(n - 1 | 0);
  }
}

function measured(v) {
  return v + 1 | 0;
}

function stepped() {
  var value = 1;
  var steps = 0;
  L0: for (;;) {
    if (value < 20) {
      value = value + value | 0;
      steps = steps + 1 | 0;
      continue L0;
    }
    break L0;
  }
  return steps;
}

function main() {
  return (((((countDown(4) + 260 | 0) + (measured(1) + measured(2) | 0) | 0) + 219 | 0) + stepped() | 0) + 18 | 0) + (evenLength(6) + oddLength(6) | 0) | 0;
}
main();
