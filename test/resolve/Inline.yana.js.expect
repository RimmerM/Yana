"use strict";
// ResolveTest
function countDown(n) {
  if (n <= 0) {
    return 0;
  } else {
    return n + countDown(n - 1 | 0) | 0;
  }
}

function evenLength(n) {
  var v23;
  if (n <= 0) {
    return 1;
  } else {
    var v10 = n - 1 | 0;
    if (v10 <= 0) {
      v23 = 0;
    } else {
      v23 = evenLength(v10 - 1 | 0);
    }
    return v23;
  }
}

function measured(v) {
  return v + 1 | 0;
}

function stepped() {
  var value = 1;
  var steps = 0;
  L0: for (;;) {
    if (value < 20) {
      value = value + value | 0;
      steps = steps + 1 | 0;
      continue L0;
    }
    break L0;
  }
  return steps;
}

function main() {
  return (((((countDown(4) + 260 | 0) + (measured(1) + measured(2) | 0) | 0) + 219 | 0) + stepped() | 0) + 18 | 0) + (evenLength(6) + evenLength(3) | 0) | 0;
}
main();
