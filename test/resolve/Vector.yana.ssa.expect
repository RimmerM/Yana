fn natural(v: Vec(F32) [shared call]) -> Vec(F32) {
bb0(%0: Vec(F32) [shared call] guaranteed):
  %1: %Vec(F32) address = alloc frame Vec(F32) [shared call]
  store inspect %1 borrow %0
  %2: Vec(F32) trivial = load inspect %1
  return consume %2
}

