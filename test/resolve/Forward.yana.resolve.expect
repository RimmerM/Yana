  b1:
    %v13 = load %local0@Outer.inner : Point
    %v14 = load %local0@Outer.inner@Point.x : Int
    %v15 = load %local0@Outer.inner : Point
    %v16 = load %local0@Outer.inner@Point.y : Int
    %v17 = add %v14, %v16 : Int
    %v18 = load %local0@Outer.tag : Int
    %v19 = add %v17, %v18 : Int
