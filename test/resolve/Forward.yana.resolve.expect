fn escaped(%a: Int) -> Int {
  b0:
    %v1 = alloc : Point
    aggregate %p@Point.x = %a, %p@Point.y = 1
    %v6 = cmp_gt %a, 0 : Bool
    je %v6, b1, b2

  b1:
    %v8 = load %p : Point
    %v9 = borrow_mut %p : &mut Point
    call widen, %v9
    jmp b3

  b2:
    jmp b3

  b3:
    %v13 = load %p : Point
    %v14 = load %p@Point.x : Int
    %v15 = load %p : Point
    %v16 = load %p@Point.y : Int
    %v17 = add %v14, %v16 : Int
    ret %v17
