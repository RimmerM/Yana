  b4:
    assign %p@Point.x, 20
    jmp b6

  b5:
    jmp b6

  b6:
    %v21 = load %p : Point
    %v22 = load %p@Point.x : Int
    %v23 = load %p : Point
    %v24 = load %p@Point.y : Int
    %v25 = add %v22, %v24 : Int
