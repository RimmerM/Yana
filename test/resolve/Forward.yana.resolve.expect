fn widen(%p: Point) -> () {
  b0:
    %v1 = load %p : Point
    %v2 = load %p@Point.x : Int
    %v5 = add %v2, 1 : Int
    assign %p@Point.x, %v5
    ret
}

fn branched(%a: Int) -> Int {
  b0:
    %p = alloc : Point
    %v4 = add %a, 1 : Int
    aggregate %local0@Point.x = %a, %local0@Point.y = %v4
    %v8 = cmp_gt %a, 0 : Bool
    je %v8, b1, b2

  b1:
    %v10 = load %local0@Point.x : Int
    %v11 = load %local0@Point.y : Int
    %v12 = add %v10, %v11 : Int
    ret %v12

  b2:
    jmp b3

  b3:
    %v15 = load %local0@Point.y : Int
