fn merged(%a: Int) -> Int {
  b0:
    %v1 = alloc : Point
    aggregate %p@Point.x = 0, %p@Point.y = 7
    %v7 = cmp_gt %a, 0 : Bool
    je %v7, b1, b2

  b1:
    assign %p@Point.x, 10
