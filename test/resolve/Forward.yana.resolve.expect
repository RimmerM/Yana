fn invariant(%count: Int) -> Int {
  b0:
    %p = alloc : Point
    aggregate %local0@Point.x = 3, %local0@Point.y = 4
    %total = alloc : Int
    init %total, 0
    %i = alloc : Int
    init %i, 0
    jmp b1

  b1:
    %v12 = load %i : Int
    %v13 = cmp_lt %v12, %count : Bool
    je %v13, b3, b2

  b2:
    %v27 = load %total : Int
    ret %v27

  b3:
    %v15 = load %total : Int
    %v16 = load %local0@Point.x : Int
    %v17 = load %local0@Point.y : Int
    %v18 = mul %v16, %v17 : Int
    %v19 = add %v15, %v18 : Int
    assign %total, %v19
    %v21 = load %i : Int
    %v24 = add %v21, 1 : Int
    assign %i, %v24
    jmp b1
}

fn carried(%count: Int) -> Int {
  b0:
    %v1 = alloc : Point
    aggregate %acc@Point.x = 0, %acc@Point.y = 5
    %i = alloc : Int
    init %i, 0
    jmp b1

  b1:
    %v9 = load %i : Int
    %v10 = cmp_lt %v9, %count : Bool
    je %v10, b3, b2

  b2:
    %v24 = load %acc : Point
    %v25 = load %acc@Point.x : Int
    ret %v25

  b3:
    %v12 = load %acc : Point
    %v13 = load %acc@Point.x : Int
    %v14 = load %acc : Point
    %v15 = load %acc@Point.y : Int
    %v16 = add %v13, %v15 : Int
    assign %acc@Point.x, %v16
    %v18 = load %i : Int
    %v21 = add %v18, 1 : Int
    assign %i, %v21
    jmp b1
}

fn nested(%a: Int) -> Int {
  b0:
    %o = alloc : Outer
    %v2 = alloc : Point
    %v5 = add %a, 1 : Int
    aggregate %local1@Point.x = %a, %local1@Point.y = %v5
    aggregate %local0@Outer.inner = %v2, %local0@Outer.tag = 5
    %v11 = cmp_gt %a, 0 : Bool
