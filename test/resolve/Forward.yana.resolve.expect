fn main() -> Int {
  b0:
    %v1 = call branched, 2 : Int
    %v3 = call partial, 1 : Int
    %v4 = add %v1, %v3 : Int
    %v6 = call merged, 1 : Int
    %v7 = add %v4, %v6 : Int
    %v9 = call invariant, 3 : Int
    %v10 = add %v7, %v9 : Int
    %v12 = call carried, 4 : Int
    %v13 = add %v10, %v12 : Int
    %v15 = call nested, 2 : Int
