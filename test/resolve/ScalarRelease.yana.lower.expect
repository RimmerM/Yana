@image$base = []
mut @live = [0, 0, 0, 0]

main<complex>(): I32 {
  b_0 {
    jmp b_1
  }

  b_2 {
    %v_3 = cmp_ilt %v_4, 4: I32
    je %v_3, b_1, b_5
  }

  b_1 {
    %v_6 = phi [b_2, %v_7], [b_0, 0]: I32
    %v_8 = phi [b_2, %v_4], [b_0, 1]: I32
    %v_9 = loads @live, 4: I32
    %v_10 = add %v_9, 1: I32
    %v_11 = shl %v_8, 1: I32
    %v_12 = imul %v_8, 3: I32
    %v_13 = add %v_8, %v_11: I32
    %v_14 = add %v_13, %v_12: I32
    %v_15 = sub %v_10, 1: I32
    store @live, %v_15, 4
    %v_7 = add %v_6, %v_14: I32
    %v_4 = add %v_8, 1: I32
    jmp b_2
  }

  b_5 {
    %v_16 = imul %v_7, 1000: I32
    %v_17 = loads @live, 4: I32
    %v_18 = add %v_16, %v_17: I32
    ret %v_18
  }
}

