fn +=(I32) {
  arg target writable
  arg amount readonly
  %target: I32 borrowed writable live [0, 3)
  %amount: I32 borrowed readonly live [0, 2)
  %local2: I32 readonly live [1, 3)
}

fn *=(I32) {
  arg target writable
  arg amount readonly
  %target: I32 borrowed writable live [0, 3)
  %amount: I32 borrowed readonly live [0, 2)
  %local2: I32 readonly live [1, 3)
}

fn bump {
  arg counter writable
  arg by readonly
  %counter: I32 borrowed writable live [0, 3)
}

fn swap {
  arg a writable
  arg b writable
  %a: I32 borrowed writable live [0, 3)
  %b: I32 borrowed writable live [0, 4)
}

fn moveBy {
  arg p writable
  arg dx readonly
  arg dy readonly
  %p: Point borrowed writable live [0, 8)
}

fn copyThroughBorrow {
  arg target writable
  arg amount readonly
  %target: I32 borrowed writable live [0, 3)
}

fn main {
  %total: I32 writable live [0, 30)
  %left: I32 writable live [11, 31)
  %right: I32 writable live [13, 32)
  %here: Point writable live [20, 39)
}
