fn +=(Int) {
  arg target writable
  arg amount readonly
  %target: Int borrowed writable live [0, 1) [2, 3)
  %amount: Int borrowed readonly live [0, 2)
  %local2: Int readonly live [1, 3)
}

fn *=(Int) {
  arg target writable
  arg amount readonly
  %target: Int borrowed writable live [0, 1) [2, 3)
  %amount: Int borrowed readonly live [0, 2)
  %local2: Int readonly live [1, 3)
}

fn bump {
  arg counter writable
  arg by readonly
  %counter: Int borrowed writable live [0, 1) [2, 3)
}

fn swap {
  arg a writable
  arg b writable
  %a: Int borrowed writable live [0, 1) [2, 3)
  %b: Int borrowed writable live [0, 2) [3, 4)
}

fn moveBy {
  arg p writable
  arg dx readonly
  arg dy readonly
  %p: Point borrowed writable live [0, 8)
}

fn copyThroughBorrow {
  arg target writable
  arg amount readonly
  %target: Int borrowed writable live [0, 1) [2, 3)
}

fn main {
  %total: Int writable live [0, 33)
  %left: Int writable live [11, 34)
  %right: Int writable live [13, 35)
  %local3: Point readonly live [20, 25)
  %here: Point writable live [23, 42)
}
