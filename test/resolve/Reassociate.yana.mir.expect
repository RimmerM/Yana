module ResolveTest

fn sums(x: I32 [shared call]) -> I32 {
bb0:
  %0: I32 = read copy.trivial (x)
  %1: I32 = const 3
  %2: I32 = add inspect %0 inspect %1
  %3: I32 = const 4
  %4: I32 = add inspect %2 inspect %3
  return take %4
}

fn leftSums(x: I32 [shared call]) -> I32 {
bb0:
  %0: I32 = const 4
  %1: I32 = const 3
  %2: I32 = read copy.trivial (x)
  %3: I32 = add inspect %1 inspect %2
