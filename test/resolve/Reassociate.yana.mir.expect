  %3: I32 = const 20
  %4: I32 = shl inspect %2 inspect %3
  return take %4
}

fn widened(c: Bool [shared call]) -> I32 {
bb0:
  %0: Bool = read copy.trivial (c)
  branch inspect %0 -> bb3 -> bb1

bb1:
  %3: I32 = const 0
  jump -> bb2(take %3)

bb2(%4: I32):
  %7: I32 = const 1
  %8: Bool = eq inspect %4 inspect %7
  branch inspect %8 -> bb6 -> bb4

bb3:
  %2: I32 = const 1
  jump -> bb2(take %2)

bb4:
  %11: I32 = const 6
  jump -> bb5(take %11)

bb5(%12: I32):
  return take %12

bb6:
  %10: I32 = const 5
  jump -> bb5(take %10)
}

fn decided(c: Bool [shared call]) -> I32 {
bb0:
  %0: Bool = read copy.trivial (c)
  branch inspect %0 -> bb3 -> bb1

bb1:
  %3: I32 = const 3
  jump -> bb2(take %3)

bb2(%4: I32):
  %7: I32 = const 1
  %8: Bool = gt inspect %4 inspect %7
  branch inspect %8 -> bb6 -> bb4

bb3:
  %2: I32 = const 2
  jump -> bb2(take %2)

bb4:
  %11: I32 = const 8
  jump -> bb5(take %11)

bb5(%12: I32):
  return take %12

bb6:
  %10: I32 = const 7
  jump -> bb5(take %10)
}

fn main() -> I32 {
  local & total: I32

bb0:
  %0: I32 = const 0
