
emptyStorage<complex>(%v_0: Ptr) {
  b_1 {
    %v_2 = alloca 8, 4: Ptr
    store %v_2, 0, 4
    %v_3 = add %v_2, 4: Ptr
    store %v_3, 0, 4
    copy %v_0, %v_2, 8
    ret 
  }
}

shared<complex>(%x: Int): Int {
  b_0 {
    %v_1 = imul %x, 10: Int
    ret %v_1
  }
}

backend<complex>(): Int {
  b_0 {
    ret 1
  }
}

capacityOf<complex>(%s$capacity: Int, %s$count: Int): Int {
  b_0 {
    ret %s$capacity
  }
}

main<complex>(): Int {
  b_0 {
    %s = alloca 8, 4: Ptr
    call_complex emptyStorage, %s
    %v_1 = call_complex backend: Int
    %s$capacity = loads %s, 4: Int
    %v_2 = add %s, 4: Ptr
    %s$count = loads %v_2, 4: Int
    %v_3 = call_complex capacityOf, %s$capacity, %s$count: Int
    %v_4 = add %v_1, %v_3: Int
    %v_5 = call_complex shared, 4: Int
    %v_6 = add %v_4, %v_5: Int
    ret %v_6
  }
