90:                                               ; preds = %85
  br label %91

91:                                               ; preds = %90
  %92 = extractelement <8 x i32> %picked, i32 1
  %93 = icmp ne i32 %92, 2
  %94 = zext i1 %93 to i32
  br i1 %93, label %95, label %96

95:                                               ; preds = %91
  ret i32 -13

96:                                               ; preds = %91
  br label %97

97:                                               ; preds = %96
  %98 = insertelement <8 x i32> %base, i32 10, i32 1
  %99 = icmp sgt <8 x i32> %98, %base
  %100 = bitcast <8 x i1> %99 to i8
  %101 = zext i8 %100 to i32
  %102 = or i32 %101, 256
  %103 = call i32 @llvm.cttz.i32(i32 %102, i1 true)
  %104 = icmp ne i32 %103, 1
  %105 = zext i1 %104 to i32
  br i1 %104, label %106, label %107

106:                                              ; preds = %97
  ret i32 -14

107:                                              ; preds = %97
  br label %108

108:                                              ; preds = %107
  %109 = icmp slt <8 x i32> %mixed, %base
  %110 = bitcast <8 x i1> %109 to i8
  %111 = zext i8 %110 to i32
  %112 = or i32 %111, 256
  %113 = call i32 @llvm.cttz.i32(i32 %112, i1 true)
  %114 = icmp ne i32 %113, %lanes
  %115 = zext i1 %114 to i32
  br i1 %114, label %116, label %117

116:                                              ; preds = %108
  ret i32 -15

117:                                              ; preds = %108
  br label %118

118:                                              ; preds = %117
  %119 = icmp sge <8 x i32> %mixed, %base
  %120 = bitcast <8 x i1> %119 to i8
  %121 = zext i8 %120 to i32
  %122 = or i32 %121, 256
  %123 = call i32 @llvm.cttz.i32(i32 %122, i1 true)
  %124 = icmp ne i32 %123, 0
  %125 = zext i1 %124 to i32
  br i1 %124, label %126, label %127

126:                                              ; preds = %118
  ret i32 -16

127:                                              ; preds = %118
  br label %128

128:                                              ; preds = %127
  %129 = extractelement <8 x i32> %3, i32 1
  %130 = mul i32 %129, 100
  %131 = extractelement <8 x i32> %4, i32 0
  %132 = add i32 %130, %131
  %133 = extractelement <8 x i32> %mixed, i32 0
  %134 = add i32 %132, %133
  ret i32 %134
}

; Function Attrs: nocallback nofree nosync nounwind readnone willreturn
declare i32 @llvm.vector.reduce.add.v8i32(<8 x i32>) #0

; Function Attrs: nocallback nofree nosync nounwind readnone willreturn
declare i32 @llvm.vector.reduce.smax.v8i32(<8 x i32>) #0

; Function Attrs: nocallback nofree nosync nounwind readnone willreturn
declare i32 @llvm.vector.reduce.smin.v8i32(<8 x i32>) #0

; Function Attrs: nocallback nofree nosync nounwind readnone willreturn
