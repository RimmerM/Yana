target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

@"image$base" = constant [0 x i8] zeroinitializer, align 8
@seed = global [4 x i8] c"\03\00\00\00", align 8

define fastcc i32 @main() {
  %total = alloca i8, i64 32, align 16
  br label %1

1:                                                ; preds = %0
  %2 = load i32, ptr @seed, align 1
  %.splatinsert = insertelement <8 x i32> poison, i32 %2, i32 0
  %base = shufflevector <8 x i32> %.splatinsert, <8 x i32> poison, <8 x i32> zeroinitializer
  %3 = add <8 x i32> %base, %base
  %4 = mul <8 x i32> %base, <i32 2, i32 2, i32 2, i32 2, i32 2, i32 2, i32 2, i32 2>
  %5 = extractelement <8 x i32> %3, i32 0
  %6 = icmp ne i32 %5, 6
  %7 = zext i1 %6 to i32
  br i1 %6, label %8, label %9

8:                                                ; preds = %1
  ret i32 -1

9:                                                ; preds = %1
  br label %10

10:                                               ; preds = %9
  %11 = extractelement <8 x i32> %4, i32 1
  %12 = icmp ne i32 %11, 6
  %13 = zext i1 %12 to i32
  br i1 %12, label %14, label %15

14:                                               ; preds = %10
  ret i32 -2

15:                                               ; preds = %10
  br label %16

16:                                               ; preds = %15
  %lanes = call i32 @llvm.vector.reduce.add.v8i32(<8 x i32> <i32 1, i32 1, i32 1, i32 1, i32 1, i32 1, i32 1, i32 1>)
  %mixed = insertelement <8 x i32> %base, i32 10, i32 0
  %17 = call i32 @llvm.vector.reduce.smax.v8i32(<8 x i32> %mixed)
  %18 = icmp ne i32 %17, 10
  %19 = zext i1 %18 to i32
  br i1 %18, label %20, label %21

20:                                               ; preds = %16
  ret i32 -3

21:                                               ; preds = %16
  br label %22

22:                                               ; preds = %21
  %23 = call i32 @llvm.vector.reduce.smin.v8i32(<8 x i32> %mixed)
  %24 = icmp ne i32 %23, 3
  %25 = zext i1 %24 to i32
  br i1 %24, label %26, label %27

26:                                               ; preds = %22
  ret i32 -4

27:                                               ; preds = %22
  br label %28

28:                                               ; preds = %27
  store <8 x i32> %base, ptr %total, align 1
  br label %29

29:                                               ; preds = %38, %28
  %30 = phi i32 [ 0, %28 ], [ %41, %38 ]
  %31 = icmp slt i32 %30, 4
  %32 = zext i1 %31 to i32
  br i1 %31, label %38, label %33

33:                                               ; preds = %29
  %34 = load <8 x i32>, ptr %total, align 1
  %35 = extractelement <8 x i32> %34, i32 0
  %36 = icmp ne i32 %35, 15
  %37 = zext i1 %36 to i32
  br i1 %36, label %42, label %43

38:                                               ; preds = %29
  %39 = load <8 x i32>, ptr %total, align 1
  %40 = add <8 x i32> %39, %base
  store <8 x i32> %40, ptr %total, align 1
  %41 = add i32 %30, 1
  br label %29

42:                                               ; preds = %33
  ret i32 -5

43:                                               ; preds = %33
  br label %44

44:                                               ; preds = %43
  %45 = extractelement <8 x i32> %34, i32 1
  %46 = icmp ne i32 %45, 15
  %47 = zext i1 %46 to i32
  br i1 %46, label %48, label %49

48:                                               ; preds = %44
  ret i32 -6

49:                                               ; preds = %44
  br label %50

50:                                               ; preds = %49
  %51 = call i32 @llvm.vector.reduce.add.v8i32(<8 x i32> %34)
  %52 = mul i32 %lanes, 15
  %53 = icmp ne i32 %51, %52
  %54 = zext i1 %53 to i32
  br i1 %53, label %55, label %56

55:                                               ; preds = %50
  ret i32 -7

56:                                               ; preds = %50
  br label %57

57:                                               ; preds = %56
  %58 = add <8 x i32> %base, %3
  %59 = extractelement <8 x i32> %58, i32 0
  %60 = add <8 x i32> %4, %34
  %61 = extractelement <8 x i32> %60, i32 0
  %62 = add i32 %59, %61
  %63 = icmp ne i32 %62, 30
  %64 = zext i1 %63 to i32
  br i1 %63, label %65, label %66

65:                                               ; preds = %57
  ret i32 -8

66:                                               ; preds = %57
  br label %67

67:                                               ; preds = %66
  %above = icmp sgt <8 x i32> %mixed, %base
  %68 = zext <8 x i1> %above to <8 x i32>
  %69 = call i32 @llvm.vector.reduce.add.v8i32(<8 x i32> %68)
  %70 = icmp ne i32 %69, 1
  %71 = zext i1 %70 to i32
  br i1 %70, label %72, label %73

72:                                               ; preds = %67
  ret i32 -9

73:                                               ; preds = %67
  br label %74

74:                                               ; preds = %73
  %75 = call i1 @llvm.vector.reduce.or.v8i1(<8 x i1> %above)
  %76 = zext i1 %75 to i32
  %77 = xor i32 %76, 1
  %78 = icmp ne i32 %77, 0
  br i1 %78, label %79, label %80

79:                                               ; preds = %74
  ret i32 -10

80:                                               ; preds = %74
  br label %81

81:                                               ; preds = %80
  %82 = call i1 @llvm.vector.reduce.and.v8i1(<8 x i1> %above)
  %83 = zext i1 %82 to i32
  br i1 %82, label %84, label %85

84:                                               ; preds = %81
  ret i32 -11

85:                                               ; preds = %81
  br label %86

86:                                               ; preds = %85
  %picked = select <8 x i1> %above, <8 x i32> <i32 7, i32 7, i32 7, i32 7, i32 7, i32 7, i32 7, i32 7>, <8 x i32> <i32 2, i32 2, i32 2, i32 2, i32 2, i32 2, i32 2, i32 2>
  %87 = extractelement <8 x i32> %picked, i32 0
  %88 = icmp ne i32 %87, 7
  %89 = zext i1 %88 to i32
  br i1 %88, label %90, label %91

90:                                               ; preds = %86
  ret i32 -12

91:                                               ; preds = %86
  br label %92

92:                                               ; preds = %91
  %93 = extractelement <8 x i32> %picked, i32 1
  %94 = icmp ne i32 %93, 2
  %95 = zext i1 %94 to i32
  br i1 %94, label %96, label %97

96:                                               ; preds = %92
  ret i32 -13

97:                                               ; preds = %92
  br label %98

98:                                               ; preds = %97
  %99 = extractelement <8 x i32> %3, i32 1
  %100 = mul i32 %99, 100
  %101 = extractelement <8 x i32> %4, i32 0
  %102 = add i32 %100, %101
  %103 = extractelement <8 x i32> %mixed, i32 0
  %104 = add i32 %102, %103
  ret i32 %104
}

; Function Attrs: nocallback nofree nosync nounwind readnone willreturn
declare i32 @llvm.vector.reduce.add.v8i32(<8 x i32>) #0

; Function Attrs: nocallback nofree nosync nounwind readnone willreturn
declare i32 @llvm.vector.reduce.smax.v8i32(<8 x i32>) #0

; Function Attrs: nocallback nofree nosync nounwind readnone willreturn
declare i32 @llvm.vector.reduce.smin.v8i32(<8 x i32>) #0

; Function Attrs: nocallback nofree nosync nounwind readnone willreturn
declare i1 @llvm.vector.reduce.or.v8i1(<8 x i1>) #0

; Function Attrs: nocallback nofree nosync nounwind readnone willreturn
declare i1 @llvm.vector.reduce.and.v8i1(<8 x i1>) #0

attributes #0 = { nocallback nofree nosync nounwind readnone willreturn }
