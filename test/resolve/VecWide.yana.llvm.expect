target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

module asm "\09.set \22image$base\22, 0"

@"image$base" = external constant [0 x i8], align 8
@seed = global [4 x i8] c"\03\00\00\00", align 8

define fastcc i32 @main() #0 {
  br label %1

1:                                                ; preds = %0
  %2 = load i32, ptr @seed, align 1
  %.splatinsert = insertelement <8 x i32> poison, i32 %2, i64 0
  %base = shufflevector <8 x i32> %.splatinsert, <8 x i32> poison, <8 x i32> zeroinitializer
  %3 = add <8 x i32> %base, %base
  %4 = shl <8 x i32> %base, splat (i32 1)
  %5 = extractelement <8 x i32> %3, i32 0
  %6 = icmp ne i32 %5, 6
  %7 = zext i1 %6 to i32
  br i1 %6, label %8, label %9

8:                                                ; preds = %1
  ret i32 -1

9:                                                ; preds = %1
  %10 = extractelement <8 x i32> %4, i32 1
  %11 = icmp ne i32 %10, 6
  %12 = zext i1 %11 to i32
  br i1 %11, label %13, label %14

13:                                               ; preds = %9
  ret i32 -2

14:                                               ; preds = %9
  %lanes = call i32 @llvm.vector.reduce.add.v8i32(<8 x i32> splat (i32 1))
  %mixed = insertelement <8 x i32> %base, i32 10, i32 0
  %15 = call i32 @llvm.vector.reduce.smax.v8i32(<8 x i32> %mixed)
  %16 = icmp ne i32 %15, 10
  %17 = zext i1 %16 to i32
  br i1 %16, label %18, label %19

18:                                               ; preds = %14
  ret i32 -3

19:                                               ; preds = %14
  %20 = call i32 @llvm.vector.reduce.smin.v8i32(<8 x i32> %mixed)
  %21 = icmp ne i32 %20, 3
  %22 = zext i1 %21 to i32
  br i1 %21, label %23, label %24

23:                                               ; preds = %19
  ret i32 -4

24:                                               ; preds = %19
  br label %32

25:                                               ; preds = %32
  %26 = icmp slt i32 %36, 4
  %27 = zext i1 %26 to i32
  br i1 %26, label %32, label %28

28:                                               ; preds = %25
  %29 = extractelement <8 x i32> %35, i32 0
  %30 = icmp ne i32 %29, 15
  %31 = zext i1 %30 to i32
  br i1 %30, label %37, label %38

32:                                               ; preds = %25, %24
  %33 = phi <8 x i32> [ %35, %25 ], [ %base, %24 ]
  %34 = phi i32 [ %36, %25 ], [ 0, %24 ]
  %35 = add <8 x i32> %33, %base
  %36 = add i32 %34, 1
  br label %25

37:                                               ; preds = %28
  ret i32 -5

38:                                               ; preds = %28
  %39 = extractelement <8 x i32> %35, i32 1
  %40 = icmp ne i32 %39, 15
  %41 = zext i1 %40 to i32
  br i1 %40, label %42, label %43

42:                                               ; preds = %38
  ret i32 -6

43:                                               ; preds = %38
  %44 = call i32 @llvm.vector.reduce.add.v8i32(<8 x i32> %35)
  %45 = mul i32 %lanes, 15
  %46 = icmp ne i32 %44, %45
  %47 = zext i1 %46 to i32
  br i1 %46, label %48, label %49

48:                                               ; preds = %43
  ret i32 -7

49:                                               ; preds = %43
  %50 = add <8 x i32> %base, %3
  %51 = extractelement <8 x i32> %50, i32 0
  %52 = add <8 x i32> %4, %35
  %53 = extractelement <8 x i32> %52, i32 0
  %54 = add i32 %51, %53
  %55 = icmp ne i32 %54, 30
  %56 = zext i1 %55 to i32
  br i1 %55, label %57, label %58

57:                                               ; preds = %49
  ret i32 -8

58:                                               ; preds = %49
  %above = icmp sgt <8 x i32> %mixed, %base
  %59 = zext <8 x i1> %above to <8 x i32>
  %60 = call i32 @llvm.vector.reduce.add.v8i32(<8 x i32> %59)
  %61 = icmp ne i32 %60, 1
  %62 = zext i1 %61 to i32
  br i1 %61, label %63, label %64

63:                                               ; preds = %58
  ret i32 -9

64:                                               ; preds = %58
  %65 = call i1 @llvm.vector.reduce.or.v8i1(<8 x i1> %above)
  %66 = zext i1 %65 to i32
  br i1 %65, label %68, label %67

67:                                               ; preds = %64
  ret i32 -10

68:                                               ; preds = %64
  %69 = call i1 @llvm.vector.reduce.and.v8i1(<8 x i1> %above)
  %70 = zext i1 %69 to i32
  br i1 %69, label %71, label %72

71:                                               ; preds = %68
  ret i32 -11

72:                                               ; preds = %68
  %picked = select <8 x i1> %above, <8 x i32> splat (i32 7), <8 x i32> splat (i32 2)
  %73 = extractelement <8 x i32> %picked, i32 0
  %74 = icmp ne i32 %73, 7
  %75 = zext i1 %74 to i32
  br i1 %74, label %76, label %77

76:                                               ; preds = %72
  ret i32 -12

77:                                               ; preds = %72
  %78 = extractelement <8 x i32> %picked, i32 1
  %79 = icmp ne i32 %78, 2
  %80 = zext i1 %79 to i32
  br i1 %79, label %81, label %82

81:                                               ; preds = %77
  ret i32 -13

82:                                               ; preds = %77
  %83 = insertelement <8 x i32> %base, i32 10, i32 1
  %84 = icmp sgt <8 x i32> %83, %base
  %85 = bitcast <8 x i1> %84 to i8
  %86 = zext i8 %85 to i32
  %87 = or i32 %86, 256
  %88 = call i32 @llvm.cttz.i32(i32 %87, i1 true)
  %89 = icmp ne i32 %88, 1
  %90 = zext i1 %89 to i32
  br i1 %89, label %91, label %92

91:                                               ; preds = %82
  ret i32 -14

92:                                               ; preds = %82
  %93 = icmp slt <8 x i32> %mixed, %base
  %94 = bitcast <8 x i1> %93 to i8
  %95 = zext i8 %94 to i32
  %96 = or i32 %95, 256
  %97 = call i32 @llvm.cttz.i32(i32 %96, i1 true)
  %98 = icmp ne i32 %97, %lanes
  %99 = zext i1 %98 to i32
  br i1 %98, label %100, label %101

100:                                              ; preds = %92
  ret i32 -15

101:                                              ; preds = %92
  %102 = icmp sge <8 x i32> %mixed, %base
  %103 = bitcast <8 x i1> %102 to i8
  %104 = zext i8 %103 to i32
  %105 = or i32 %104, 256
  %106 = call i32 @llvm.cttz.i32(i32 %105, i1 true)
  %107 = icmp ne i32 %106, 0
  %108 = zext i1 %107 to i32
  br i1 %107, label %109, label %110

109:                                              ; preds = %101
  ret i32 -16

110:                                              ; preds = %101
  %111 = extractelement <8 x i32> %3, i32 1
  %112 = mul i32 %111, 100
  %113 = extractelement <8 x i32> %4, i32 0
  %114 = add i32 %112, %113
  %115 = extractelement <8 x i32> %mixed, i32 0
  %116 = add i32 %114, %115
  ret i32 %116
}

; Function Attrs: nocallback nofree nosync nounwind speculatable willreturn memory(none)
declare i32 @llvm.vector.reduce.add.v8i32(<8 x i32>) #1

; Function Attrs: nocallback nofree nosync nounwind speculatable willreturn memory(none)
declare i32 @llvm.vector.reduce.smax.v8i32(<8 x i32>) #1

; Function Attrs: nocallback nofree nosync nounwind speculatable willreturn memory(none)
declare i32 @llvm.vector.reduce.smin.v8i32(<8 x i32>) #1

; Function Attrs: nocallback nofree nosync nounwind speculatable willreturn memory(none)
declare i1 @llvm.vector.reduce.or.v8i1(<8 x i1>) #1

; Function Attrs: nocallback nofree nosync nounwind speculatable willreturn memory(none)
declare i1 @llvm.vector.reduce.and.v8i1(<8 x i1>) #1

; Function Attrs: nocallback nofree nosync nounwind speculatable willreturn memory(none)
declare i32 @llvm.cttz.i32(i32, i1 immarg) #1

attributes #0 = { "probe-stack"="inline-asm" }
attributes #1 = { nocallback nofree nosync nounwind speculatable willreturn memory(none) }
