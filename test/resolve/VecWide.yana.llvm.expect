target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

module asm "\09.set \22image$base\22, 0"

@"image$base" = external constant [0 x i8], align 8
@seed = global [4 x i8] c"\03\00\00\00", align 8

define fastcc i32 @main() {
  br label %1

1:                                                ; preds = %0
  %2 = load i32, ptr @seed, align 1
  %.splatinsert = insertelement <8 x i32> poison, i32 %2, i32 0
  %base = shufflevector <8 x i32> %.splatinsert, <8 x i32> poison, <8 x i32> zeroinitializer
  %3 = add <8 x i32> %base, %base
  %4 = shl <8 x i32> %base, <i32 1, i32 1, i32 1, i32 1, i32 1, i32 1, i32 1, i32 1>
  %5 = extractelement <8 x i32> %3, i32 0
  %6 = icmp ne i32 %5, 6
  %7 = zext i1 %6 to i32
  br i1 %6, label %8, label %9

8:                                                ; preds = %1
  ret i32 -1

9:                                                ; preds = %1
  br label %10

10:                                               ; preds = %9
  %11 = extractelement <8 x i32> %4, i32 1
  %12 = icmp ne i32 %11, 6
  %13 = zext i1 %12 to i32
  br i1 %12, label %14, label %15

14:                                               ; preds = %10
  ret i32 -2

15:                                               ; preds = %10
  br label %16

16:                                               ; preds = %15
  %lanes = call i32 @llvm.vector.reduce.add.v8i32(<8 x i32> <i32 1, i32 1, i32 1, i32 1, i32 1, i32 1, i32 1, i32 1>)
  %mixed = insertelement <8 x i32> %base, i32 10, i32 0
  %17 = call i32 @llvm.vector.reduce.smax.v8i32(<8 x i32> %mixed)
  %18 = icmp ne i32 %17, 10
  %19 = zext i1 %18 to i32
  br i1 %18, label %20, label %21

20:                                               ; preds = %16
  ret i32 -3

21:                                               ; preds = %16
  br label %22

22:                                               ; preds = %21
  %23 = call i32 @llvm.vector.reduce.smin.v8i32(<8 x i32> %mixed)
  %24 = icmp ne i32 %23, 3
  %25 = zext i1 %24 to i32
  br i1 %24, label %26, label %27

26:                                               ; preds = %22
  ret i32 -4

27:                                               ; preds = %22
  br label %28

28:                                               ; preds = %27
  br label %36

29:                                               ; preds = %36
  %30 = icmp slt i32 %40, 4
  %31 = zext i1 %30 to i32
  br i1 %30, label %36, label %32

32:                                               ; preds = %29
  %33 = extractelement <8 x i32> %39, i32 0
  %34 = icmp ne i32 %33, 15
  %35 = zext i1 %34 to i32
  br i1 %34, label %41, label %42

36:                                               ; preds = %29, %28
  %37 = phi <8 x i32> [ %39, %29 ], [ %base, %28 ]
  %38 = phi i32 [ %40, %29 ], [ 0, %28 ]
  %39 = add <8 x i32> %37, %base
  %40 = add i32 %38, 1
  br label %29

41:                                               ; preds = %32
  ret i32 -5

42:                                               ; preds = %32
  br label %43

43:                                               ; preds = %42
  %44 = extractelement <8 x i32> %39, i32 1
  %45 = icmp ne i32 %44, 15
  %46 = zext i1 %45 to i32
  br i1 %45, label %47, label %48

47:                                               ; preds = %43
  ret i32 -6

48:                                               ; preds = %43
  br label %49

49:                                               ; preds = %48
  %50 = call i32 @llvm.vector.reduce.add.v8i32(<8 x i32> %39)
  %51 = mul i32 %lanes, 15
  %52 = icmp ne i32 %50, %51
  %53 = zext i1 %52 to i32
  br i1 %52, label %54, label %55

54:                                               ; preds = %49
  ret i32 -7

55:                                               ; preds = %49
  br label %56

56:                                               ; preds = %55
  %57 = add <8 x i32> %base, %3
  %58 = extractelement <8 x i32> %57, i32 0
  %59 = add <8 x i32> %4, %39
  %60 = extractelement <8 x i32> %59, i32 0
  %61 = add i32 %58, %60
  %62 = icmp ne i32 %61, 30
  %63 = zext i1 %62 to i32
  br i1 %62, label %64, label %65

64:                                               ; preds = %56
  ret i32 -8

65:                                               ; preds = %56
  br label %66

66:                                               ; preds = %65
  %above = icmp sgt <8 x i32> %mixed, %base
  %67 = zext <8 x i1> %above to <8 x i32>
  %68 = call i32 @llvm.vector.reduce.add.v8i32(<8 x i32> %67)
  %69 = icmp ne i32 %68, 1
  %70 = zext i1 %69 to i32
  br i1 %69, label %71, label %72

71:                                               ; preds = %66
  ret i32 -9

72:                                               ; preds = %66
  br label %73

73:                                               ; preds = %72
  %74 = call i1 @llvm.vector.reduce.or.v8i1(<8 x i1> %above)
  %75 = zext i1 %74 to i32
  br i1 %74, label %77, label %76

76:                                               ; preds = %73
  ret i32 -10

77:                                               ; preds = %73
  br label %78

78:                                               ; preds = %77
  %79 = call i1 @llvm.vector.reduce.and.v8i1(<8 x i1> %above)
  %80 = zext i1 %79 to i32
  br i1 %79, label %81, label %82

81:                                               ; preds = %78
  ret i32 -11

82:                                               ; preds = %78
  br label %83

83:                                               ; preds = %82
  %picked = select <8 x i1> %above, <8 x i32> <i32 7, i32 7, i32 7, i32 7, i32 7, i32 7, i32 7, i32 7>, <8 x i32> <i32 2, i32 2, i32 2, i32 2, i32 2, i32 2, i32 2, i32 2>
  %84 = extractelement <8 x i32> %picked, i32 0
  %85 = icmp ne i32 %84, 7
  %86 = zext i1 %85 to i32
  br i1 %85, label %87, label %88

87:                                               ; preds = %83
  ret i32 -12

88:                                               ; preds = %83
  br label %89

89:                                               ; preds = %88
  %90 = extractelement <8 x i32> %picked, i32 1
  %91 = icmp ne i32 %90, 2
  %92 = zext i1 %91 to i32
  br i1 %91, label %93, label %94

93:                                               ; preds = %89
  ret i32 -13

94:                                               ; preds = %89
  br label %95

95:                                               ; preds = %94
  %96 = insertelement <8 x i32> %base, i32 10, i32 1
  %97 = icmp sgt <8 x i32> %96, %base
  %98 = bitcast <8 x i1> %97 to i8
  %99 = zext i8 %98 to i32
  %100 = or i32 %99, 256
  %101 = call i32 @llvm.cttz.i32(i32 %100, i1 true)
  %102 = icmp ne i32 %101, 1
  %103 = zext i1 %102 to i32
  br i1 %102, label %104, label %105

104:                                              ; preds = %95
  ret i32 -14

105:                                              ; preds = %95
  br label %106

106:                                              ; preds = %105
  %107 = icmp slt <8 x i32> %mixed, %base
  %108 = bitcast <8 x i1> %107 to i8
  %109 = zext i8 %108 to i32
  %110 = or i32 %109, 256
  %111 = call i32 @llvm.cttz.i32(i32 %110, i1 true)
  %112 = icmp ne i32 %111, %lanes
  %113 = zext i1 %112 to i32
  br i1 %112, label %114, label %115

114:                                              ; preds = %106
  ret i32 -15

115:                                              ; preds = %106
  br label %116

116:                                              ; preds = %115
  %117 = icmp sge <8 x i32> %mixed, %base
  %118 = bitcast <8 x i1> %117 to i8
  %119 = zext i8 %118 to i32
  %120 = or i32 %119, 256
  %121 = call i32 @llvm.cttz.i32(i32 %120, i1 true)
  %122 = icmp ne i32 %121, 0
  %123 = zext i1 %122 to i32
  br i1 %122, label %124, label %125

124:                                              ; preds = %116
  ret i32 -16

125:                                              ; preds = %116
  br label %126

126:                                              ; preds = %125
  %127 = extractelement <8 x i32> %3, i32 1
  %128 = mul i32 %127, 100
  %129 = extractelement <8 x i32> %4, i32 0
  %130 = add i32 %128, %129
  %131 = extractelement <8 x i32> %mixed, i32 0
  %132 = add i32 %130, %131
  ret i32 %132
}

; Function Attrs: nocallback nofree nosync nounwind readnone willreturn
declare i32 @llvm.vector.reduce.add.v8i32(<8 x i32>) #0

; Function Attrs: nocallback nofree nosync nounwind readnone willreturn
declare i32 @llvm.vector.reduce.smax.v8i32(<8 x i32>) #0

; Function Attrs: nocallback nofree nosync nounwind readnone willreturn
declare i32 @llvm.vector.reduce.smin.v8i32(<8 x i32>) #0

; Function Attrs: nocallback nofree nosync nounwind readnone willreturn
declare i1 @llvm.vector.reduce.or.v8i1(<8 x i1>) #0

; Function Attrs: nocallback nofree nosync nounwind readnone willreturn
declare i1 @llvm.vector.reduce.and.v8i1(<8 x i1>) #0

; Function Attrs: nocallback nofree nosync nounwind readnone speculatable willreturn
declare i32 @llvm.cttz.i32(i32, i1 immarg) #1

attributes #0 = { nocallback nofree nosync nounwind readnone willreturn }
attributes #1 = { nocallback nofree nosync nounwind readnone speculatable willreturn }
