    %v_11 = loads @log, 4: I32
    %v_12 = add %v_11, 100: I32
    store @log, %v_12, 4
    %v_13 = call_complex insideArm, 3: I32
    %v_14 = call_complex insideArm, 18446744073709551615: I32
    %v_15 = loads @log, 4: I32
    %v_16 = add %v_15, 1: I32
    store @log, %v_16, 4
    %v_17 = loads @log, 4: I32
    %v_18 = add %v_17, 100: I32
