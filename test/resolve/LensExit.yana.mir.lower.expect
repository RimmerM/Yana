mut @log = [0, 0, 0, 0]

insideArm<complex>(%x: I32): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    %v_2 = cmp_igt %x, 0: I32
    je %v_2, b_3, b_4
  }

  b_4 {
    ret 7
  }

  b_3 {
    %v_5 = loads @log, 4: I32
    %v_6 = add %v_5, 1: I32
    store @log, %v_6, 4
    %v_7 = cmp_igt %x, 100: I32
    je %v_7, b_8, b_9
  }

  b_10 {
    %v_11 = loads %v_1, 4: I32
    ret %v_11
  }

  b_12 {
    %v_13 = phi [b_9, 0], [b_8, 1]: I32
    %v_14 = loads @log, 4: I32
    %v_15 = add %v_14, 100: I32
    store @log, %v_15, 4
    je %v_13, b_10, b_4
  }

  b_9 {
    %v_16 = loads @log, 4: I32
    %v_17 = add %v_16, 1000: I32
    store @log, %v_17, 4
    jmp b_12
  }

  b_8 {
    store %v_1, 0, 4
    jmp b_12
  }
}

main<complex>(): I32 {
  b_0 {
    store @log, 0, 4
    %v_1 = loads @log, 4: I32
    %v_2 = add %v_1, 1: I32
    store @log, %v_2, 4
    %v_3 = loads @log, 4: I32
