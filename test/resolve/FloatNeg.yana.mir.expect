bb6:
  %24: I32 = read copy.trivial (score)
  %25: I32 = const 2
  %26: I32 = add inspect %24 inspect %25
  write.assign borrow.unique (score) take %26
  jump -> bb5

bb7:
  jump -> bb8

bb8:
  %43: F32 = const 7.5
  %44: F32 = call opaqueF borrow.shared %43
  %45: F32 = neg inspect %44
  %46: F32 = neg inspect %45
  %47: F32 = const 7.5
  %48: Bool = eq inspect %46 inspect %47
  branch inspect %48 -> bb12 -> bb10

bb9:
  %37: I32 = read copy.trivial (score)
  %38: I32 = const 4
  %39: I32 = add inspect %37 inspect %38
  write.assign borrow.unique (score) take %39
  jump -> bb8

bb10:
  jump -> bb11

bb11:
  %56: F64 = const 1
  %57: F64 = const 0
  %58: F64 = call opaque borrow.shared %57
  %59: F64 = neg inspect %58
  %60: F64 = div inspect %56 inspect %59
  %61: F64 = const 0
  %62: Bool = lt inspect %60 inspect %61
