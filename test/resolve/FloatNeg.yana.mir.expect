  %2: F64 = const 2.5
  %3: F64 = call opaque borrow.shared %2
  %4: F64 = neg inspect %3
  %5: F64 = const 0
  %6: F64 = const 2.5
  %7: F64 = sub inspect %5 inspect %6
  %8: Bool = eq inspect %4 inspect %7
