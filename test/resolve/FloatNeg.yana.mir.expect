bb12:
  %50: I32 = read copy.trivial (score)
  %51: I32 = const 8
  %52: I32 = add inspect %50 inspect %51
  write.assign borrow.unique (score) take %52
  jump -> bb11

bb13:
  jump -> bb14

bb14:
  %70: F64 = const 2.5
  %71: F64 = neg inspect %70
  %72: F64 = const 0
  %73: F64 = const 2.5
  %74: F64 = sub inspect %72 inspect %73
  %75: Bool = eq inspect %71 inspect %74
  branch inspect %75 -> bb18 -> bb16

bb15:
  %64: I32 = read copy.trivial (score)
  %65: I32 = const 16
  %66: I32 = add inspect %64 inspect %65
  write.assign borrow.unique (score) take %66
  jump -> bb14

bb16:
