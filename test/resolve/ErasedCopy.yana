-- The *duplicate* a body that cannot see the type performs, on both targets.
--
-- ErasedRelocate.yana is the other half of this and the half that already worked: a move of a type
-- variable calls the descriptor's `moveInit`, and storage of unknown shape is an empty object that
-- the relocation's own writes give the right shape to. What was missing was the write that is not a
-- relocation - `codegen/js/README.md` gap 4 - because native writes a whole value of unknown shape
-- by block-copying the descriptor's `size` bytes, and this target has no shallow copy of one value.
-- `TypeDescFields::kCopyInit` is the operation that answers it, and this fixture is what says so.
--
-- Compiled with specialization declined (see the `.generic` marker), so `duplicate` below really is
-- the erased form rather than one instantiation per call site.
--
-- Asserted by counting, on the same terms and for the same reason: a copy that silently aliased its
-- source instead of duplicating it produces the right *number* out of `value` and the wrong one out
-- of the counter, and only the counter can tell the two apart.

let &copyCalls = 0 :: Int

-- A type whose duplicate is not its bytes, so the descriptor's slot holds the adapter around this
-- instance rather than the block copy. That adapter is the one shape `Copy` needs and `Sink` does
-- not: `copy` returns the duplicate where `sink` is handed the destination, so the slot cannot name
-- it directly.
data Tracked {value: Int}

-- An aggregate whose duplicate *is* its bytes, which is the answer the erased write below actually
-- reaches: the slot holds the generated block copy, and each backend compiles that its own way - a
-- `memcpy` natively, a property-by-property duplicate on JS.
data Point {x: Int, y: Int}

{-
   And the same thing holding a `[T *n]`, because "property by property" is exactly what a fixed
   array has none of.

   A fixed array is its elements and has no properties at all (see eachProperty), so the object
   literal `cloneValue` builds for a record was building `{}` for this field and every element was
   gone. That is not hypothetical: a record with a `[U32 *4]` in it lost it whenever it was passed by
   value, and the digest built out of one answered zeros. The array now has a case of its own -
   `slice()` where the elements are values a read duplicates, written out one by one where an element
   is itself an object.

   `Point` beside the numbers rather than four more numbers, so that both halves of that case are
   here: the shallow copy the numeric arrays take, and the walk an array of objects needs.
-}
data Quad {values: [Int *4], places: [Point *2], tag: Int}

instance Copy(Tracked):
    fn copy(from: Tracked) -> Tracked:
        copyCalls = copyCalls + 1
        return Tracked {value: from.value}

-- The write gap 4 named: `slot` is storage the caller owns and `from` is borrowed rather than
-- consumed, so filling one from the other is a *duplicate* and not a relocation. Neither the shape
-- nor the size of `a` is known here, which is what left this reported rather than emitted.
--
-- `TrivialCopy(a)` rather than `Copy(a)`, and that is the language rather than a narrower test: an
-- unconstrained duplicate of a non-TrivialCopy type does not exist - `sinkValue` emits a move for
-- one, and the borrow checker rejects storing a borrowed value outright - so this constraint is
-- what the reachable erased copy is stated under. The authored half of the slot is exercised by
-- `Tracked` having a descriptor at all; see copyInitFor for why both answers have to be in it.
fn (TrivialCopy(a)) copyInto(&slot: a, from: a) -> {}:
    slot = from

fn main() -> Int:
    let &number = 0 :: Int
    copyInto(number, 7)

    let pair = Point {x: 3, y: 4}
    let &target = Point {x: 0, y: 0}
    copyInto(target, pair)

    -- The source survives the duplicate, which is the whole difference from a move.
    if pair.x != 3 then return -1

    {-
       The array-carrying record through the same erased write.

       Checked element by element rather than by a sum, because `{}` in place of the copy is not a
       wrong number on this target - it is a value with no elements at all, and reading one back
       answers `undefined`. The comparison is what turns that into a failure here rather than into
       arithmetic on a missing value somewhere downstream.
    -}
    let quad = Quad {values: [10, 20, 30, 40], places: [Point {x: 1, y: 2}, Point {x: 3, y: 4}], tag: 5}
    let &copied = Quad {values: [0, 0, 0, 0], places: [Point {x: 0, y: 0}, Point {x: 0, y: 0}], tag: 0}
    copyInto(copied, quad)

    if copied.values[0] != 10 then return -3
    if copied.values[3] != 40 then return -4
    if copied.places[1].x != 3 then return -5
    if copied.tag != 5 then return -6

    -- And the duplicate is independent of what it was made from, which is the half a `slice()` that
    -- was not there would have got right by accident.
    copied.values[0] = 99
    copied.places[1].x = 99

    if quad.values[0] != 10 then return -7
    if quad.places[1].x != 3 then return -8

    -- The authored instance is reachable directly, which is what keeps `Tracked`'s descriptor - and
    -- so the adapter in its copyInit slot - in the emitted program.
    let tracked = copy(Tracked {value: 10})
    if copyCalls != 1 then return -2

    -- 7 + 3 + 4 + 10 + 1 = 25
    return number + target.x + target.y + tracked.value + copyCalls
