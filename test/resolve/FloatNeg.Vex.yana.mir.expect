  %25: F64 = neg inspect %24
  write.init borrow.unique (twice) take %25
  %27: F64 = read copy.trivial (negated)
  %28: F64 = const 0
  %29: F64 = const 2.5
  %30: F64 = sub inspect %28 inspect %29
  %31: Bool = eq inspect %27 inspect %30
  %32: I32 = const 1
  %33: I32 = call check borrow.shared %31 borrow.shared %32
  %34: F64 = read copy.trivial (wide)
  %35: F64 = const 2.5
  %36: Bool = eq inspect %34 inspect %35
  %37: I32 = const 2
  %38: I32 = call check borrow.shared %36 borrow.shared %37
  %39: I32 = add inspect %33 inspect %38
  %40: F32 = read copy.trivial (negatedF)
  %41: F32 = const 0
  %42: F32 = const 1.5
  %43: F32 = sub inspect %41 inspect %42
  %44: Bool = eq inspect %40 inspect %43
  %45: I32 = const 4
  %46: I32 = call check borrow.shared %44 borrow.shared %45
  %47: I32 = add inspect %39 inspect %46
  %48: F32 = read copy.trivial (narrow)
  %49: F32 = const 1.5
  %50: Bool = eq inspect %48 inspect %49
  %51: I32 = const 8
  %52: I32 = call check borrow.shared %50 borrow.shared %51
  %53: I32 = add inspect %47 inspect %52
  %54: F64 = const 1
  %55: F64 = read copy.trivial (negatedZero)
  %56: F64 = div inspect %54 inspect %55
  %57: F64 = const 0
  %58: Bool = lt inspect %56 inspect %57
  %59: I32 = const 16
  %60: I32 = call check borrow.shared %58 borrow.shared %59
  %61: I32 = add inspect %53 inspect %60
  %62: F64 = read copy.trivial (zero)
  %63: F64 = const 0
  %64: Bool = eq inspect %62 inspect %63
  %65: I32 = const 32
  %66: I32 = call check borrow.shared %64 borrow.shared %65
  %67: I32 = add inspect %61 inspect %66
  %68: F64 = read copy.trivial (twice)
