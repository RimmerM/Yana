module ResolveTest

fn opaque(x: F64 [shared call]) -> F64 {
bb0:
  %0: F64 = read copy.trivial (x)
  return take %0
}

fn opaqueF(x: F32 [shared call]) -> F32 {
bb0:
  %0: F32 = read copy.trivial (x)
  return take %0
}

fn check(condition: Bool [shared call], weight: I32 [shared call]) -> I32 {
bb0:
  %0: Bool = read copy.trivial (condition)
  branch inspect %0 -> bb3 -> bb1

bb1:
  %3: I32 = const 0
  jump -> bb2(take %3)

bb2(%4: I32):
  return take %4

bb3:
  %2: I32 = read copy.trivial (weight)
  jump -> bb2(take %2)
}

