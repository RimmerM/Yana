-- What function values and captures reject. Each function is one rule; the expectation beside this
-- file is the whole of what it reports.
--
-- # resolver: ownership

fn applyUnit(f: () -> {}): f()

fn identity(->x: a) -> a = x

-- Design-Memory §8: a closure that outlives the frame that built it has to own what it captures.
-- `total` is mutable storage, so the capture is by reference, and the reference cannot leave.
fn escapingBorrow() -> () -> {}:
    let &total = 0 :: Int
    return (): total = total + 1

-- A frame touching a binding a stored closure captured by `&` moved to
-- `Reject.Closure.Legacy.yana`; that file says what the new stage does instead.

-- A capture that came out by value is one whose enclosing binding was not mutable, so writing it
-- would write the environment's own copy and the enclosing frame would never see it.
fn writeToCopiedCapture():
    let fixed = 1
    applyUnit((): fixed = 2)

-- Nothing says what the argument is, and a lambda has nowhere else to look.
fn unknownArgument() -> Int:
    let f = (x) -> x + 1
    return 0

-- `return` in a lambda whose result its body decides, and a generic function as a value moved to
-- `Reject.Closure.Legacy.yana`; that file says what the new stage does instead.

-- lens and iter lambdas parse and are not implemented.
fn lensLambda() -> Int:
    let f = lens (x: Int) -> x
    return 0
