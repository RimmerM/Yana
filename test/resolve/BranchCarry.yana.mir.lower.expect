    %v_13 = cmp_neq %v_12, 77: I32
    %v_14 = select %v_13, 18446744073709551601, 4242: I32
    ret %v_14
  }

  b_15 {
    ret 18446744073709551602
  }

  b_2 {
    %v_16 = loads %v_1, 4: I32
    call_complex Guard.drop, %v_1
    %v_17 = cmp_neq %v_16, 7: I32
    je %v_17, b_8, b_3
  }

  b_10 {
