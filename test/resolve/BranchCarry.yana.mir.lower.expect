mut @trace = [0, 0, 0, 0]

Guard.drop<complex>(%value: Ptr) {
  b_0 {
    %v_1 = load %value, 4: I32
    %v_2 = loads @trace, 4: I32
    %v_3 = imul %v_2, 10: I32
    %v_4 = add %v_3, %v_1: I32
    store @trace, %v_4, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    %v_1 = alloca 4, 4: Ptr
    store %v_1, 7, 4
    jmp b_2
  }

  b_3 {
    %v_4 = loads @trace, 4: I32
    %v_5 = cmp_neq %v_4, 7: I32
    je %v_5, b_6, b_7
  }

  b_8 {
    ret 18446744073709551604
  }

  b_7 {
    %v_9 = alloca 4, 4: Ptr
