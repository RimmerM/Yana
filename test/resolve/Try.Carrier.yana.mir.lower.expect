    %v_34 = load %v_33, 4: I32
    call_complex Token.drop, %v_34
    %v_35 = alloca 8, 4: Ptr
    store %v_35, 0, 1
    call_complex teardown(Maybe(Token)), %v_35
    store %v_29, 1, 1
    %v_36 = add %v_29, 4: Ptr
    store %v_36, 0, 4
    call_complex teardown(Outcome(Token, {})), %v_29
    %v_37 = loads @log, 4: I32
    %v_38 = add %v_37, 1: I32
    store @log, %v_38, 4
    %v_39 = loads @log, 4: I32
