mut @log = [0, 0, 0, 0]
mut @dropped = [0, 0, 0, 0]

Token.drop<complex>(%v_0: I32) {
  b_1 {
    %v_2 = loads @dropped, 4: I32
    %v_3 = add %v_2, 1: I32
    store @dropped, %v_3, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    store @log, 0, 4
    store @dropped, 0, 4
    store @log, 1, 4
    %v_1 = loads @log, 4: I32
    %v_2 = add %v_1, 1: I32
