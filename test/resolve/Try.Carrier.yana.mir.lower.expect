    store %v_15, 0, 1
    %v_20 = add %v_15, 4: Ptr
    store %v_20, %v_19, 4
    %v_21 = load %v_20, 4: I32
    call_complex Token.drop, %v_21
    %v_22 = alloca 8, 4: Ptr
    %v_23 = add %v_22, 4: Ptr
    store %v_23, 2, 4
    store %v_22, 1, 1
    %v_24 = load %v_23, 4: I32
    store %v_16, 0, 1
    %v_25 = add %v_16, 4: Ptr
    store %v_25, %v_24, 4
    %v_26 = load %v_25, 4: I32
    call_complex Token.drop, %v_26
    %v_27 = add %v_21, %v_26: I32
    %v_28 = alloca 8, 4: Ptr
    %v_29 = alloca 8, 4: Ptr
    %v_30 = alloca 8, 4: Ptr
    %v_31 = add %v_30, 4: Ptr
