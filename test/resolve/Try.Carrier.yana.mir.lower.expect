mut @log = [0, 0, 0, 0]
mut @dropped = [0, 0, 0, 0]

Token.drop<complex>() {
  b_0 {
    %v_1 = loads @dropped, 4: I32
    %v_2 = add %v_1, 1: I32
    store @dropped, %v_2, 4
    ret 
  }
}

main<complex>(): I32 {
  b_0 {
    store @log, 0, 4
    store @dropped, 0, 4
    store @log, 1, 4
    store @log, 2, 4
    store @log, 3, 4
    store @log, 4, 4
    store @log, 5, 4
    store @log, 6, 4
    store @log, 16, 4
    store @log, 26, 4
    call_complex Token.drop
    call_complex Token.drop
    %v_1 = alloca 8, 4: Ptr
    call_complex Token.drop
    %v_2 = alloca 8, 4: Ptr
    store %v_2, 0, 1
    call_complex teardown(Maybe(Token)), %v_2
    store %v_1, 1, 1
    call_complex teardown(Outcome(Token, {})), %v_1
    %v_3 = loads @log, 4: I32
    %v_4 = add %v_3, 1: I32
    store @log, %v_4, 4
    %v_5 = add %v_3, 2: I32
    store @log, %v_5, 4
    %v_6 = add %v_3, 3: I32
    store @log, %v_6, 4
    %v_7 = add %v_3, 4: I32
    store @log, %v_7, 4
    %v_8 = loads @dropped, 4: I32
    %v_9 = imul %v_8, 1000: I32
    %v_10 = add 165, %v_9: I32
    %v_11 = imul %v_7, 100000: I32
    %v_12 = add %v_10, %v_11: I32
    ret %v_12
  }
}

teardown(Maybe(Token))<complex>(%v_0: Ptr) {
  b_1 {
    %v_2 = load %v_0, 1: I32
    %v_3 = cmp_eq %v_2, 1: I32
    je %v_3, b_4, b_5
  }

  b_6 {
    ret 
  }

  b_4 {
    call_complex Token.drop
    jmp b_6
  }

  b_5 {
    jmp b_6
  }
}

teardown(Outcome(Token, {}))<complex>(%v_0: Ptr) {
  b_1 {
    %v_2 = load %v_0, 1: I32
    %v_3 = cmp_eq %v_2, 0: I32
    je %v_3, b_4, b_5
  }

  b_6 {
    ret 
  }

  b_4 {
    call_complex Token.drop
    jmp b_6
  }

  b_5 {
    jmp b_6
  }
}

