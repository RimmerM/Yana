@bytes = [1, 2, 3, 255]
@number = [210, 4, 0, 0, 0, 0, 0, 0]
@g = [42, 0, 0, 0]

callee<complex>(%x: I32, %y: I32): I32 {
  b_0 {
    ret %x
  }
}

namedRefs<complex>(): I32 {
  b_0 {
    %f = fun callee: Ptr
    %v = load @g, 4: I32
    ret %v
  }
}

manyArgs<complex>(%a: I32, %b: I32): I32 {
  b_0 {
    %r = call_complex callee, %a, %b: I32
    ret %r
  }
}

convCalls<complex>(%a: I32, %b: I32) {
  b_0 {
    %r0 = call_sysv callee, %a, %b: I32
    %r1 = call_win64 callee, %a, %b: I32
    %r2 = call_simple callee, %a, %b: I32
    %r3 = call_complex callee, %a, %b: I32
    %r4 = call_clobber callee, %a, %b: I32
    ret 
  }
}

