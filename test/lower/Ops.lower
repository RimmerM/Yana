ops(%i: Int, %j: Int, %f: Float, %p: Ptr, %n: Long): Int {
    {
        nop
        %s = set %i: Int
        %ng = neg %i: Int
        %ngf = neg %f: Float
        %nt = not %i: Int
        %se = sext %i: Long
        %it = itof %i: Float
        %ft = ftoi %f: Int
        %im = imul %i, %j: Int
        %idv = idiv %i, %j: Int
        %ir = irem %i, %j: Int
        %sh = shl %i, 2: Int
        %xr = xor %i, %j: Int
        %cn = cmp_neq %i, %j
        %cg = cmp_ge %i, %j
        %cig = cmp_igt %i, %j
        %cige = cmp_ige %i, %j
        %cil = cmp_ilt %i, %j
        %ld = loads %p, 4: Int
        copy %p, %p, %n
        setpattern %p, %n, 0
        ret %s
    }
}
