
neutral<complex>(%c: I32): I32 {
  start {
    je %c, left, right
  }

  left {
    %a = cast 1: I32
    jmp end
  }

  right {
    %b = cast 2: I32
    jmp end
  }

  end {
    %v_0 = phi [left, %a], [right, %b]: I32
    ret %v_0
  }
}

hinted<complex>(%c: I32): I32 {
  start {
    je %c, [left, 99], [right, 1]
  }

  left {
    %a = cast 1: I32
    jmp end
  }

  right {
    %b = cast 2: I32
    jmp end
  }

  end {
    %v_0 = phi [left, %a], [right, %b]: I32
    ret %v_0
  }
}

loop<complex>(%n: I32): I32 {
  start {
    %z = cast 0: I32
    jmp head
  }

  head {
    %i = phi [start, %z], [body, %i2]: I32
    %v_0 = cmp_ige %i, %n: I32
    je %v_0, end, body
  }

  body {
    %i2 = add %i, 1: I32
    jmp head
  }

  end {
    ret %i
  }
}

nested<complex>(%n: I32, %m: I32): I32 {
  start {
    %z = cast 0: I32
    jmp outer
  }

  outer {
    %i = phi [start, %z], [outerEnd, %i2]: I32
    %v_0 = cmp_ige %i, %n: I32
    je %v_0, done, innerHead
  }

  innerHead {
    %j = phi [outer, %z], [innerBody, %j2]: I32
    %v_1 = cmp_ige %j, %m: I32
    je %v_1, outerEnd, innerBody
  }

  innerBody {
    %j2 = add %j, 1: I32
    jmp innerHead
  }

  outerEnd {
    %i2 = add %i, 1: I32
    jmp outer
  }

  done {
    ret %i
  }
}

coldPathInLoop<complex>(%n: I32, %c: I32): I32 {
  start {
    %z = cast 0: I32
    jmp head
  }

  head {
    %i = phi [start, %z], [next, %i2]: I32
    %v_0 = cmp_ige %i, %n: I32
    je %v_0, done, check
  }

  check {
    %v_1 = cmp_eq %c, 0: I32
    je %v_1, [fail, 1], [next, 1000]
  }

  fail {
    %e = cast 0: I32
    jmp done
  }

  next {
    %i2 = add %i, 1: I32
    jmp head
  }

  done {
    %v_2 = phi [head, %i], [fail, %e]: I32
    ret %v_2
  }
}

