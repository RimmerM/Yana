
loop<complex>(%count: I32, %add: I32): I32 {
  start {
    # live-in: %count, %add
    %v = cast 0: I32
    jmp head
    # live-out: %count, %add, %v
  }

  head {
    # live-in: %add, %v1, %count1
    %v1 = phi [start, %v], [loop, %v2]: I32
    %count1 = phi [start, %count], [loop, %count2]: I32
    %v_0 = cmp_le %count1, 0: I32
    je %v_0, loop, end
    # live-out: %add, %v1, %count1
  }

  loop {
    # live-in: %add, %v1, %count1
    %count2 = sub %count1, 1: I32
    %v2 = add %v1, %add: I32
    jmp head
    # live-out: %add, %count2, %v2
  }

  end {
    # live-in: %v1
    ret %v1
    # live-out: 
  }
}

