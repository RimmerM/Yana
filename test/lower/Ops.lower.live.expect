
ops<complex>(%i: I32, %j: I32, %f: F32, %p: Ptr, %n: I64): I32 {
  b_0 {
    # live-in: %i, %j, %f, %p, %n
    nop 
    %s = set %i: I32
    %ng = neg %i: I32
    %ngf = neg %f: F32
    %nt = not %i: I32
    %bs = bswap %i: I32
    %bl = bswap %n: I64
    %se = sext %i: I64
    %it = itof %i: F32
    %ft = ftoi %f: I32
    %im = imul %i, %j: I32
    %idv = idiv %i, %j: I32
    %ir = irem %i, %j: I32
    %sh = shl %i, 2: I32
    %xr = xor %i, %j: I32
    %cn = cmp_neq %i, %j: I32
    %cg = cmp_ge %i, %j: I32
    %cig = cmp_igt %i, %j: I32
    %cige = cmp_ige %i, %j: I32
    %cil = cmp_ilt %i, %j: I32
    %ld = loads %p, 4: I32
    copy %p, %p, %n
    setpattern %p, %n, 0
    ret %s
    # live-out: 
  }
}

