
ops<complex>(%i: Int, %j: Int, %f: Float, %p: Ptr, %n: Long): Int {
  b_0 {
    # live-in: %i, %j, %f, %p, %n
    nop 
    %s = set %i: Int
    %ng = neg %i: Int
    %ngf = neg %f: Float
    %nt = not %i: Int
    %bs = bswap %i: Int
    %bl = bswap %n: Long
    %se = sext %i: Long
    %it = itof %i: Float
    %ft = ftoi %f: Int
    %im = imul %i, %j: Int
    %idv = idiv %i, %j: Int
    %ir = irem %i, %j: Int
    %sh = shl %i, 2: Int
    %xr = xor %i, %j: Int
    %cn = cmp_neq %i, %j: Int
    %cg = cmp_ge %i, %j: Int
    %cig = cmp_igt %i, %j: Int
    %cige = cmp_ige %i, %j: Int
    %cil = cmp_ilt %i, %j: Int
    %ld = loads %p, 4: Int
    copy %p, %p, %n
    setpattern %p, %n, 0
    ret %s
    # live-out: 
  }
}

