@bytes = [1, 2, 3, 255]
@number = 1234: Long
@g = 42

callee(%x: Int, %y: Int): Int {
    { ret %x }
}

namedRefs(): Int {
    {
        %f = fun callee
        %gv = global @g
        %v = load %gv, 4: Int
        ret %v
    }
}

# Which arguments travel on the stack is the calling convention's answer, so there is nothing to
# write here: the x64 backend derives the stores from the convention (see insertStackArgs). At this
# level a call simply names its arguments.
manyArgs(%a: Int, %b: Int): Int {
    {
        %r = call callee, %a, %b: Int
        ret %r
    }
}

convCalls(%a: Int, %b: Int) {
    {
        %r0 = call_sysv callee, %a, %b: Int
        %r1 = call_win64 callee, %a, %b: Int
        %r2 = call_simple callee, %a, %b: Int
        %r3 = call_complex callee, %a, %b: Int
        %r4 = call_clobber callee, %a, %b: Int
        ret
    }
}
