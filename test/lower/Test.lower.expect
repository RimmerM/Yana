@name = [104, 101, 108, 108, 111, 32, 119, 111, 114, 108, 100]

getCount<complex>(): Int {
  b_0 {
    ret 10
  }
}

print<complex>(%string: Ptr, %length: Long) {
  b_0 {
    %0 = syscall 1, 1, %string, %length: Int
    ret 
  }
}

main<complex>() {
  start {
    %space = alloca 1, 8: Ptr
    store %space, 32, 1
    %v_0 = call_complex getCount: Int
    %count = cast %v_0: Long
    jmp loop
  }

  loop {
    %i = phi [start, 0], [loop, %i2]: Long
    call_complex print, @name, 11
    call_complex print, %space, 1
    call_complex printInt, %i
    %i2 = add %i, 1: Long
    %v_1 = cmp_lt %i2, %count: Int
    je %v_1, loop, end
  }

  end {
    ret 
  }
}

printInt<complex>(%number: Long) {
  start {
    %buffer = alloca 32, 8: Ptr
    %string = alloca 32, 8: Ptr
    jmp loop
  }

  loop {
    %n = phi [start, %number], [loop, %2]: Long
    %p = phi [start, %buffer], [loop, %p2]: Ptr
    %v_0 = cast 48: Long
    %v_1 = rem %n, 10: Long
    %1 = add %v_0, %v_1: Long
    store %p, %1, 1
    %p2 = add %p, 1: Ptr
    %2 = div %n, 10: Long
    %v_2 = cmp_gt %2, 0: Int
    je %v_2, loop, reverse
  }

  reverse {
    %length = sub %p2, %buffer: Long
    jmp reverse_loop
  }

  reverse_loop {
    %p3 = phi [reverse, %p2], [reverse_loop, %p4]: Ptr
    %b = phi [reverse, %string], [reverse_loop, %b2]: Ptr
    %p4 = sub %p3, 1: Ptr
    %v_3 = load %p4, 1: Int
    store %b, %v_3, 1
    %b2 = add %b, 1: Ptr
    %v_4 = cmp_gt %p4, %buffer: Int
    je %v_4, reverse_loop, print
  }

  print {
    call_complex print, %string, %length
    ret 
  }
}

