
utf32PointToUtf8<complex>(%utf32: Ptr, %max: Ptr, %buffer: Ptr): Ptr {
  b_0 {
    # live-in: %utf32, %buffer
    %p = load %utf32, 8: Ptr
    %codePoint = load %p, 4: I32
    %v_1 = add %p, 4: Ptr
    store %utf32, %v_1, 8
    %v_2 = cmp_le %codePoint, 127: I32
    je %v_2, isOne, checkTwo
    # live-out: %utf32, %buffer, %p, %codePoint
  }

  isOne {
    # live-in: %buffer, %codePoint
    store %buffer, %codePoint, 1
    %v_3 = add %buffer, 1: Ptr
    ret %v_3
    # live-out: 
  }

  checkTwo {
    # live-in: %utf32, %buffer, %p, %codePoint
    %v_4 = cmp_le %codePoint, 2047: I32
    je %v_4, isTwo, checkThree
    # live-out: %utf32, %buffer, %p, %codePoint
  }

  isTwo {
    # live-in: %buffer, %codePoint
    %v_5 = shr %codePoint, 6: I32
    %c2_0 = or 192, %v_5: I32
    %v_6 = and %codePoint, 63: I32
    %c2_1 = or 128, %v_6: I32
    %v_7 = add %buffer, 0: Ptr
    store %v_7, %c2_0, 1
    %v_8 = add %buffer, 1: Ptr
    store %v_8, %c2_1, 1
    %v_9 = add %buffer, 2: Ptr
    ret %v_9
    # live-out: 
  }

  checkThree {
    # live-in: %utf32, %buffer, %p, %codePoint
    %v_10 = cmp_le %codePoint, 65535: I32
    je %v_10, isThree, checkFour
    # live-out: %utf32, %buffer, %p, %codePoint
  }

  isThree {
    # live-in: %buffer, %codePoint
    %v_11 = shr %codePoint, 12: I32
    %c3_0 = or 192, %v_11: I32
    %v_12 = shr %codePoint, 6: I32
    %v_13 = and %v_12, 63: I32
    %c3_1 = or 128, %v_13: I32
    %v_14 = and %codePoint, 63: I32
    %c3_2 = or 128, %v_14: I32
    %v_15 = add %buffer, 0: Ptr
    store %v_15, %c3_0, 1
    %v_16 = add %buffer, 1: Ptr
    store %v_16, %c3_1, 1
    %v_17 = add %buffer, 2: Ptr
    store %v_17, %c3_2, 1
    %v_18 = add %buffer, 3: Ptr
    ret %v_18
    # live-out: 
  }

  checkFour {
    # live-in: %utf32, %buffer, %p, %codePoint
    %v_19 = cmp_le %codePoint, 1114111: I32
    je %v_19, isFour, else
    # live-out: %utf32, %buffer, %p, %codePoint
  }

  isFour {
    # live-in: %buffer, %codePoint
    %v_20 = shr %codePoint, 18: I32
    %c4_0 = or 240, %v_20: I32
    %v_21 = shr %codePoint, 12: I32
    %v_22 = and %v_21, 63: I32
    %c4_1 = or 128, %v_22: I32
    %v_23 = shr %codePoint, 6: I32
    %v_24 = and %v_23, 63: I32
    %c4_2 = or 128, %v_24: I32
    %v_25 = and %codePoint, 63: I32
    %c4_3 = or 128, %v_25: I32
    %v_26 = add %buffer, 0: Ptr
    store %v_26, %c4_0, 1
    %v_27 = add %buffer, 1: Ptr
    store %v_27, %c4_1, 1
    %v_28 = add %buffer, 2: Ptr
    store %v_28, %c4_2, 1
    %v_29 = add %buffer, 3: Ptr
    store %v_29, %c4_3, 1
    %v_30 = add %buffer, 4: Ptr
    ret %v_30
    # live-out: 
  }

  else {
    # live-in: %utf32, %p
    store %utf32, %p, 8
    %v_31 = bitcast 0: Ptr
    ret %v_31
    # live-out: 
  }
}

