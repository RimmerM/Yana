# Every vector shape the lower IR can write down, and every rule its validator states about one.
#
# The point of this fixture is the round trip: the type spelling, the five instructions and the
# overreading load all have to print back as what was written, or the two halves of §4.3 of
# Implementation-Vector.md have drifted apart. It is a `.lower` file and nothing above the lower IR
# produces one of these yet, which is why it is here rather than in test/resolve.

arith(%a: f32x8, %b: f32x8, %i: i32x4, %j: i32x4): f32x8 {
    {
        %add = add %a, %b: f32x8
        %sub = sub %a, %b: f32x8
        %mul = mul %a, %b: f32x8
        %div = div %a, %b: f32x8
        %ng = neg %a: f32x8

        # Integer lanes take the whole integer set, division included - no machine here has a packed
        # divide, and expanding it lane by lane is the backend's business rather than the type's.
        %iadd = add %i, %j: i32x4
        %idiv = idiv %i, %j: i32x4
        %irem = irem %i, %j: i32x4
        %and = and %i, %j: i32x4
        %not = not %i: i32x4

        # Shifted by a vector of counts, and by one count every lane shares.
        %shv = shl %i, %j: i32x4
        %shs = shl %i, 3: i32x4
        ret %add
    }
}

# A comparison answers a mask, a select consumes one, and the four ways a mask becomes a scalar.
#
# `vreduce_first` is the one whose result type is not the lane's scalar form: it answers *which* lane
# rather than one of them, so it states an `Int` at any lane width - the rule the validator holds it
# and `vreduce_bits` to, and the reason both are written out here.
masks(%a: f32x8, %b: f32x8): f32x8 {
    {
        %lt = cmp_lt %a, %b: m32x8
        %gt = cmp_gt %a, %b: m32x8
        %both = and %lt, %gt: m32x8
        %inv = not %both: m32x8
        %sel = select %inv, %a, %b: f32x8
        %any = vreduce_or %inv: Int
        %all = vreduce_and %inv: Int
        %count = vreduce_add %inv: Int
        %first = vreduce_first %inv: Int
        ret %sel
    }
}

# The five that are not one of the instructions above.
lanes(%x: Float, %v: f32x8, %w: f32x8): Float {
    {
        %splat = vsplat %x: f32x8
        %lane = vlane %v, 3: Float
        %with = vwithlane %v, %x, 5: f32x8
        %sum = vreduce_add %v: Float
        %max = vreduce_max %v: Float

        # A pattern entry names a lane of the two sources concatenated, so 8..15 is the second one.
        # This is the interleave of the two low halves.
        %zip = vshuffle %v, %w, 0, 8, 1, 9, 2, 10, 3, 11: f32x8

        # A shuffle may change the lane count but not the lane type: this is the low four lanes of
        # one vector, which is what `packLanes` and the two `unpack`s are built out of.
        %low = vshuffle %v, %v, 0, 1, 2, 3: f32x4
        %narrow = vreduce_add %low: Float
        ret %sum
    }
}

# The lane types that exist only as lanes, at every width a register has.
widths(%p: Ptr): i8x32 {
    {
        %b = load %p, 32: i8x32
        %s = load %p, 32: i16x16
        %l = load %p, 32: i64x4
        %d = load %p, 32: f64x4

        # The tail-read guarantee, spelled. It reads a whole register where only part of it is
        # wanted, and says so - see isOverreadLoad.
        %tail = loadx %p, 32: i8x32
        %sum = add %b, %tail: i8x32
        store %p, %sum, 32
        ret %sum
    }
}

# Reinterpretation and conversion, which are the two things a `cast` between vectors can mean and
# which are told apart by the lane count.
convert(%f: f32x4, %i: i32x4): f64x4 {
    {
        %bits = bitcast %i: f32x4
        %wide = cast %f: f64x4
        %narrow = cast %i: i8x4
        %pack = bitcast %i: i8x16
        ret %wide
    }
}
