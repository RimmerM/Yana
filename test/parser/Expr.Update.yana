-- Tuple update, single field.
fn f(v) = {v | x: 1}

-- Tuple update, multiple fields.
fn g(v) = {v | x: 1, y: 2}

-- Map literal, empty.
fn h() = [:]

-- Map literal, single pair.
fn i() = ["a": 1]

-- Map literal, multiple pairs.
fn j() = ["a": 1, "b": 2]

-- Subscript, single index.
fn k(v) = v[0]

-- Subscript, chained.
fn l(v) = v[0][1]

-- Subscript on a call result.
fn m(v) = f(v)[0]

-- General prefix expression.
fn n(v) = -v

-- Dereference prefix expression.
fn o(v) = *v

-- Prefix expression on a chained access.
fn p(v) = -v[0]
