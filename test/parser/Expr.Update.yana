-- Tuple update, single field.
fn f(v) = {v | x: 1}

-- Tuple update, multiple fields.
fn g(v) = {v | x: 1, y: 2}

-- Map literal, empty.
fn h() = [:]

-- Map literal, single pair.
fn i() = ["a": 1]

-- Map literal, multiple pairs.
fn j() = ["a": 1, "b": 2]

-- Subscript, single index.
fn k(v) = v[0]

-- Subscript, chained.
fn l(v) = v[0][1]

-- Subscript on a call result.
fn m(v) = f(v)[0]

-- General prefix expression.
fn n(v) = -v

-- Dereference prefix expression.
fn o(v) = *v

-- Prefix expression on a chained access.
fn p(v) = -v[0]

-- Nested tuple update shorthand.
{- Block comments still work alongside the reserved `{->` move-update prefix. -}
fn q(v) = {v | .origin.x: 1}

-- The fully expanded equivalent.
fn r(v) = {v | origin: {v.origin | x: 1}}

-- A move update sinks both the outer and synthesized nested update sources.
fn s(v) = {->v | .origin.x: 1}

-- Move update, direct field.
fn t(v) = {->v | x: 1}

-- The fully expanded move-update equivalent.
fn u(v) = {->v | origin: {->v.origin | x: 1}}

-- A nested path is kept as a path rather than expanded into an update per level.
fn v(x) = {x | .a.b.c: 1}

-- Two paths sharing a prefix are two paths, not two updates of the same field.
fn w(x) = {x | .a.b: 1, .a.c: 2}

-- `~field` replaces a field with the binding of the same name.
fn x(a, b) = {a | ~b}
fn y(a, b) = {a | ~b, c: 1}
