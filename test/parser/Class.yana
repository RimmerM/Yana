-- A class with no functions at all: what it asks of a type is a property rather than an operation,
-- so it is written without the ':' and the block there would be nothing to put in.
class Marker(a)
class Relation(a, b)

class A(a):
  fn f(x: a) -> a
  fn g(x: a, y: Int) -> {a, Int}
  fn h(x: a, &y: Int = 0) -> [{a, Int}]
  fn i(x: a) = x
  fn j(x: a, y: Int) = {x: x, y: y * 2}

class B(a, b):
  fn f(x: a) -> a
  fn g(x: a, y: b) -> {a, b}
  fn h(x: a, &y: b = 0) -> [{a, b}]
  fn i(x: a) = x
  fn j(x: a, y: b) = {x: x, y: y * 2}

instance A(B):
  fn f(x: B) = x

instance B:
  fn g() = 0
  fn h(this: B) = this.x
  fn i(&this: B): this.x = 5

-- An instance head over a type variable, with what that variable has to satisfy written in
-- front of it exactly as a class writes its superclasses.
instance (Eq(a)) A(Maybe(a)):
  fn f(x: Maybe(a)) = x

-- Type constraints; more constraints are tested in Function.yana.
class (Ord(a)) Num(a):
  fn + (lhs: a, rhs: a) -> a
  fn - (lhs: a, rhs: a) -> a

-- A class default, written in the head like every other fact about a parameter: the type this
-- class produces when nothing else decides one.
class Counting(a = Int):
  fn count(x: a) -> a
