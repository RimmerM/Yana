-- Declarations that do not parse. Each case is its own top-level declaration, so the parser has
-- to recover far enough to make sense of the next one - the AST below the diagnostics shows how
-- much of each broken declaration survived.

-- A function without a body.
fn noBody(a: Int)

-- A function name that is not an identifier.
fn 3(a: Int) = 0

-- An argument list that is never closed.
fn unclosed(a: Int = 0

-- A data declaration with no constructors.
data NoCons

-- An alias with nothing to alias.
alias NoTarget

-- An instance declaration missing the ':' that opens its body.
instance NoBody(Int)

-- A generic parameter's default with nothing after the `=`.
class NoDefault(a =):
  fn f(x: a) -> a

-- An attribute declaration without a name, and one without a type.
@data
@data named

-- A terminating statement where a declaration belongs.
return 0

-- Trailing tokens after an otherwise complete declaration.
fn trailing() = 0 )

-- The declaration after all of the above still parses.
fn after(a: Int) = a

-- A plain alias with a `deriving` clause. It names the same type as its target, so a derivation
-- would either duplicate that type's instances or contradict them; `alias qualified` is the form
-- that makes a type of its own for one to be about.
alias Transparent = Int deriving (Eq)

-- A `deriving` clause whose list holds something that is not a class name.
alias qualified Wrapped = Int deriving (Eq, 3)
