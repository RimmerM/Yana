-- while, compact form.
fn f() = while a -> b()

-- while, block form with multiple statements.
fn g():
  while a > 0:
    a = a - 1
    b()

-- for, bare iterable, compact form.
fn h() = for x in xs -> f(x)

-- for, ascending range.
fn i() = for x in 0..10 -> f(x)

-- for, descending range.
fn j() = for x in 10 downto 0 -> f(x)

-- for, ascending range with step.
fn k() = for x in 0..10 step 2 -> f(x)

-- for, descending range with step, block form.
fn l():
  for x in 10 downto 0 step 2:
    f(x)
    g(x)

-- for, parenthesized selexpr bounds.
fn m() = for x in (a)..(b) step (c) -> f(x)

-- while, compact break with a value.
fn n() = while a -> break a

-- while, compact bare continue.
fn o() = while a -> continue

-- for, block form with break and continue.
fn p():
  for x in xs:
    if x < 0:
      continue
    if x > 100:
      break
    f(x)

-- for, an iterator call as the source. A call needs no parentheses of its own: no suffix of a
-- chain can reach past the expression to eat the `..`, `step` or `:` that ends the slot.
fn q() = for x in upTo(n) -> f(x)

-- ... including one with no arguments, and one reached as a method.
fn r():
  for x in ticks():
    f(x)

fn s() = for x in xs.items() -> f(x)

-- The same in the range slots, mixed with a subscript and a field.
fn t() = for i in bounds.low..xs.length() step counts[0] -> f(i)

-- An operator chain is still not a slot, and still needs its parentheses - which is what keeps
-- where each slot ends readable without knowing any fixity.
fn u() = for i in (a + 1)..(b * 2) -> f(i)
