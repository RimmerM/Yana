-- Unary minus.
match x:
  -0 -> 0
  -443543.544 -> 1

-- ConPat.
match x:
  Int -> 0
  Int(0) -> 0
  Int(x: 0, y: Int { a: b, c: d }) -> 0
  Int(True, False) -> 0
  Int {0} -> 0
  Int {x: 0, y: Int {a: b, c: d }} -> 0
  Int { True, False } -> 0

-- RangePat. A negative bound is a literal like any other, on either end.
match x:
  0..100 -> 0
  True..False -> 0
  {a, B}..{c, D} -> 0
  "a".."z" -> 0
  0.._ -> 0
  _..0 -> 0
  -5..5 -> 0
  -5 .. -1 -> 0

-- SectionPat. An operator at the head of a pattern takes the matched value as its left
-- operand, so the pattern below reads as the comparison it is. Any operator will parse;
-- whether it produces a Bool is a question for the resolver.
match x:
  ==v -> 0
  >0 -> 0
  <=limit -> 0
  != -1 -> 0
  `elem` xs -> 0

-- VarPat. `@` binds the whole value in addition to matching it; a section goes in parentheses
-- there, the same as a range, because both are pattern forms rather than left-patterns.
match x:
  a -> 0
  a@Int -> 0
  a@{0, 0} -> 0
  a@(0..100) -> 0
  a@(>0) -> 0
  a@(==v) -> 0
  a@(`elem` xs) -> 0
  (a) -> 0
  (Int {x, y}) -> 0

-- TupPat.
match x:
  { a } -> 0
  { a: a } -> 0
  { 0..1, { a, b } } -> 0
  { a: 0..1, b: { a, b } } -> 0
  { a: Int(0), b: Int([ 0, 1, 2 ]), c: -1} -> 0

-- ArrayPat.
match x:
  [] -> 0
  [ Int, Int {0, 0} ] -> 0
  [-1, 0, 1] -> 0
  [..a] -> 0
  [x, ..y] -> 0

-- misc.
match x:
  else -> 0
  _ -> 0
  Int -> 0
  0 -> 0
  0.0 -> 0
  "" -> 0