-- pub on a function declaration.
pub fn f() = 0

-- pub on a data declaration.
pub data X {a: Int}

-- pub on an alias declaration.
pub alias Y = Int

-- Non-exported declaration for contrast.
fn g() = 0

-- where clause on a function body.
fn h(x: Int) = y
  where y = x + 1

-- where clause with the body on the same line as 'let'.
fn i(x: Int) = z
  where z = x * 2
