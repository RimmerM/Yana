-- Multi-way if, with an 'else' fallback. `_` is not accepted here: an `if:` case is a fallback
-- marker rather than a pattern, so `else` is the only spelling of it.
fn f(a: Int) = if:
  a > 0 -> 1
  a < 0 -> -1
  else -> 0

-- The same, with a condition that binds nothing before it.
fn g(a: Int) = if:
  a == 0 -> "zero"
  else -> "nonzero"

-- Multi-way if, single case plus fallback.
fn h(a: Bool) = if:
  a -> 1
  else -> 0
