-- ConType.
alias X = Y
alias X = Y(Z)
alias X = Y(Z(W))
alias X = Y Z
alias X = Y(Z, W)
alias X = Y(a)
alias X = Y(a(b))
alias X = Y a
alias X = Y {Y, W}
alias X = Y {a: Z, b: W}
alias X = Y [Z]
alias X = Y [Z: W]
alias X = Y [a: b]
alias X = Y [Z(W)]
alias X = Y [Z(a)]

-- GenType.
alias X = a
alias X = a(Z)
alias X = a(Z(W))
alias X = a Z
alias X = a(Z, W)
alias X = a(b)
alias X = a(b(c))
alias X = a b
alias X = a {Y, W}
alias X = a {a: Z, b: W}
alias X = a [Z]
alias X = a [Z: W]
alias X = a [b: c]
alias X = a [Z(W)]
alias X = a [Z(b)]

-- Tuples.
alias X = {Y}
alias X = {Z, W}
alias X = {[Y]}
alias X = {[Y], {Z, W}}
alias X = {a: Int, b: Int, c: Int, d: Int}
alias X = {a: [Y]}
alias X = {a: [Y], b: {x: Int, y: Int}}

-- PtrType.
alias X = %X
alias X = %[Int]
alias X = %{Int, Int}
alias X = %(() -> Int)
alias X = %(Int)
alias X = %(%Int)
alias X = %(&Int)
alias X = %(&(*Int))
alias X = %(&Int)
alias X = %(%Int)
alias X = %(&[Int])

-- BorrowType.
alias X = &X
alias X = &[Int]
alias X = &{Int, Int}
alias X = &(() -> Int)
alias X = &(Int)
alias X = &(&Int)
alias X = &(%Int)
alias X = &(%(*Int))
alias X = &(%Int)
alias X = &(&Int)
alias X = &(%[Int])

-- SharedType. The origin marker, and the same grammar - Analysis-Borrows.md §3.2.
--
-- `&` and `'` are independent axes rather than two capabilities: `'` says the storage belongs to
-- somebody else and `&` says the value is mutable, so `&'T` is the composition and `&T` is its
-- shorthand. `Parser::applySigil` is where that is decided, and it is one function because the
-- adjacent and bracketed spellings are the same type: `&('Int)` below produces one BorrowType and
-- not a borrow of a borrow. What it refuses - the reverse order, and either axis twice - is
-- `test/resolve/Reject.OriginSigil.yana`, since the answer there is a diagnostic rather than a tree.
alias X = 'X
alias X = '[Int]
alias X = '{Int, Int}
alias X = '(() -> Int)
alias X = '(Int)
alias X = &('Int)
alias X = '(%Int)
alias X = Maybe('Int)
alias X = Pair('Int, &Int)

-- `&'T` written adjacently, which did not lex at all while `'` was a symbol: `&'` was one unknown
-- operator. It is the same tree as `&('Int)` above.
alias X = &'Int
alias X = &src'Int

-- The one that is *not* decided by the grammar, kept here because it is evidence rather than a
-- feature: a lowercase argument reads as a shared reference to a type variable, so a loan group
-- applied positionally at a use - Analysis-Borrows.md §9.3's `PairView('left, 'right)` - would be
-- the same token sequence as this. Slots need a channel of their own; the parser cannot tell them
-- apart and neither can a reader.
alias X = Pair('a, 'b)

-- The channel §9.3 settled on: the group carries a *trailing* tick, so `v'a` is a reference in
-- group `v` and `v'` alone is the group itself - Analysis-Borrows.md §4.2 and §4.7. The two are one
-- token of lookahead apart and nothing that can begin a type also ends an argument list, which is
-- what makes the pair unambiguous where the leading form above is not.
alias X = src'Int
alias X = src'[Int]
alias X = Maybe(src'Int)
alias X = Pair(left'Int, right'Int)

-- The capability sits outside the group, and there is no `&'`: a group is written *inside* the
-- capability, so `&Int` and `&src'Int` are the two forms and `&'Int` is not one. A bare tick is the
-- shared sigil, which is what `&` already replaces.
alias X = &src'Int
alias X = Maybe(&src'Int)

-- Nesting, which needs no rule of its own once a reference is one atom.
alias X = src'(dst'Int)
alias X = Pair(src'Int, &src'Int)

-- And the group itself, which is what the lookahead is for - §4.7's `Store(kept', a)`. It is a type
-- *argument* and never a type, so the parser produces it here and the resolver refuses it anywhere
-- a slot was not declared, which is exactly the division a const-generic count is under.
alias X = Store(kept')
alias X = Store(kept', a)
alias X = Store(a, kept')
alias X = Store(kept', kept'a)

-- RefType (checked reference).
alias X = *X
alias X = *[Int]
alias X = *{Int, Int}
alias X = *(() -> Int)
alias X = *(Int)
alias X = *(*Int)
alias X = *(&Int)
alias X = *(&(%Int))
alias X = *(%Int)
alias X = *(*Int)
alias X = *(&[Int])

-- Arrays.
alias X = [Y]
alias X = [a]
alias X = [{x: Int, y: Int}]
alias X = [[a]]
alias X = [[[[Int: Int]]]]
alias X = [Y: Z]
alias X = [a: Z]
alias X = [Y: a]
alias X = [{x: Int, y: Int}: Y(Z(W))]
alias X = [{Int, Int}: {Int, Int}]

-- Function types.
alias X = () -> {}
alias X = (Int) -> {}
alias X = (Int) -> Int
alias X = (Int, Bool) -> Int
alias X = (Int, Bool) -> {Int, Bool}
alias X = (a: Int, b: Bool) -> {a: Int, b: Bool}
alias X = (a: a, b: a) -> [a]
alias X = (a: [a], b: [a: a]) -> Set(Bool)
alias X = (a: Module.Type) -> Module.Type({Bool, Bool})
alias X = (&a: Int, ->b: Bool, c: Float) -> Int
alias X = (&Int, ->Bool, Float) -> Int

-- Parenthesized.
alias X = (Int)
alias X = (Module.Int)
alias X = ({ [X], [Y], [Z] })
alias X = ([a])
alias X = ({ x: [X], y: Module.Type, z: { Type } })

-- Borrow types, nested.
alias X = { x: &Int, y: &[Int], z: &{Int, {Int, Int}} }
alias X = [&Int]
alias X = Y(&Int)

-- Checked reference types, nested.
alias X = { x: *Int, y: *[Int], z: *{*Int, *{Int, Int}} }
alias X = [*[*[Int: *{a, b}]]]
alias X = Y(*Z)

-- Fixed arrays, and the three things that may stand where the count does: a literal, a name that a
-- const parameter will bind, and `_` - which says the count is the literal the type is written at
-- rather than anything in the type. `[T]` and `[T *_]` are different kinds rather than one with an
-- absent count, so the printer names the second.
alias X = [Int *4]
alias X = [Int *n]
alias X = [Int *_]
alias X = [[Int *_] *_]
alias X = { x: [Int *_], y: &[Int *4] }
alias X = [(Int) -> Bool *_]

-- Declaration paths - Design-Iterator-Objects.md §2.4. The head is a *value* name, which is what
-- separates `lex.Iter` from a qualified type name: a lowercase segment before the last is one the
-- lexer does not fuse into a `ConID`, so `Lex.lex.Iter` is one VarID, a dot and a ConID.
alias X = lex.Iter
alias X = lex.Iter(I32)
alias X = tokens.Result
alias X = Lex.lex.Iter
alias X = { x: src'lex.Iter, y: &lex.Iter, z: %lex.Iter }
alias X = [lex.Iter(a, b)]
alias X = Holder(lex.Iter)
alias X = (lex.Iter) -> tokens.Result

-- The erased `iter(...)` - Design-Iterator-Objects.md §2.2. An ordinary type since stage 4, so it
-- parses everywhere one does; the three channels inside the brackets are the same grammar a
-- traversal's result writes, and the convention on the hand-over belongs to the protocol.
alias X = iter(Int)
alias X = iter(->Int)
alias X = iter('Int)
alias X = iter(Token <- LexCommand)
alias X = iter(->Token <- ->LexCommand)
alias X = iter(Int | Error)
alias X = iter(Token <- LexCommand | Error)

-- ... and in every position a type stands in, which is what moving it out of the result grammar
-- bought: a field, a sigil, an array, a type argument and a function type's two ends.
alias X = { x: iter(Int), y: &iter(Int), z: %iter(Int) }
alias X = [iter(Int)]
alias X = Holder(iter(Int))
alias X = (iter(Int)) -> iter(Bool)

-- ... including **under a group**, which is the position the list above was missing: `startsType`
-- enumerates what may follow a `'` and had never been told about `iter`, so `src'iter(Int)` read as
-- the bare group `src'` and then as a bracket that ended nothing, and said "expected ')'". The
-- composition is the ordinary one - the group qualifies the occurrence and the protocol is the type
-- under it, the same way `src'[Int]` is a window in a group - and the two spellings of a capability
-- beside it fold as they do everywhere else.
alias X = src'iter(Int)
alias X = &src'iter(Int)
alias X = src'iter(Token <- LexCommand)
alias X = Pair(left'iter(Int), right'iter(Int))
alias X = { it: src'iter(Int) }

-- And the *function* reading of the word under a group, told apart by the same one token: this is a
-- traversal's function type in group `src`, not a protocol.
alias X = src'(iter (Int) -> Bool)

-- The one form that is *not* this: `iter (A) -> B` is the function type of a traversal, told apart
-- by what follows the bracket group and by nothing else. `parseType`'s `hasIterResultArrow` is the
-- one token of lookahead that decides.
alias X = iter (Int) -> Bool
alias X = lens (Int) -> Bool
