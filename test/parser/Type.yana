-- ConType.
alias X = Y
alias X = Y(Z)
alias X = Y(Z(W))
alias X = Y Z
alias X = Y(Z, W)
alias X = Y(a)
alias X = Y(a(b))
alias X = Y a
alias X = Y {Y, W}
alias X = Y {a: Z, b: W}
alias X = Y [Z]
alias X = Y [Z: W]
alias X = Y [a: b]
alias X = Y [Z(W)]
alias X = Y [Z(a)]

-- GenType.
alias X = a
alias X = a(Z)
alias X = a(Z(W))
alias X = a Z
alias X = a(Z, W)
alias X = a(b)
alias X = a(b(c))
alias X = a b
alias X = a {Y, W}
alias X = a {a: Z, b: W}
alias X = a [Z]
alias X = a [Z: W]
alias X = a [b: c]
alias X = a [Z(W)]
alias X = a [Z(b)]

-- Tuples.
alias X = {Y}
alias X = {Z, W}
alias X = {[Y]}
alias X = {[Y], {Z, W}}
alias X = {a: Int, b: Int, c: Int, d: Int}
alias X = {a: [Y]}
alias X = {a: [Y], b: {x: Int, y: Int}}

-- PtrType.
alias X = %X
alias X = %[Int]
alias X = %{Int, Int}
alias X = %(() -> Int)
alias X = %(Int)
alias X = %(%Int)
alias X = %(&Int)
alias X = %(&(*Int))
alias X = %(&Int)
alias X = %(%Int)
alias X = %(&[Int])

-- BorrowType.
alias X = &X
alias X = &[Int]
alias X = &{Int, Int}
alias X = &(() -> Int)
alias X = &(Int)
alias X = &(&Int)
alias X = &(%Int)
alias X = &(%(*Int))
alias X = &(%Int)
alias X = &(&Int)
alias X = &(%[Int])

-- SharedType. The other reference capability, and the same grammar - Analysis-Borrows.md §3.2.
-- `&` is exclusive and `'` is shared; nesting either inside the other is a parse question rather
-- than a sensible type, and the parser answers it the same way for both.
alias X = 'X
alias X = '[Int]
alias X = '{Int, Int}
alias X = '(() -> Int)
alias X = '(Int)
alias X = '('Int)
alias X = '(&Int)
alias X = &('Int)
alias X = '(%Int)
alias X = Maybe('Int)
alias X = Pair('Int, &Int)

-- The one that is *not* decided by the grammar, kept here because it is evidence rather than a
-- feature: a lowercase argument reads as a shared reference to a type variable, so a loan group
-- applied positionally at a use - Analysis-Borrows.md §9.3's `PairView('left, 'right)` - would be
-- the same token sequence as this. Slots need a channel of their own; the parser cannot tell them
-- apart and neither can a reader.
alias X = Pair('a, 'b)

-- RefType (checked reference).
alias X = *X
alias X = *[Int]
alias X = *{Int, Int}
alias X = *(() -> Int)
alias X = *(Int)
alias X = *(*Int)
alias X = *(&Int)
alias X = *(&(%Int))
alias X = *(%Int)
alias X = *(*Int)
alias X = *(&[Int])

-- Arrays.
alias X = [Y]
alias X = [a]
alias X = [{x: Int, y: Int}]
alias X = [[a]]
alias X = [[[[Int: Int]]]]
alias X = [Y: Z]
alias X = [a: Z]
alias X = [Y: a]
alias X = [{x: Int, y: Int}: Y(Z(W))]
alias X = [{Int, Int}: {Int, Int}]

-- Function types.
alias X = () -> {}
alias X = (Int) -> {}
alias X = (Int) -> Int
alias X = (Int, Bool) -> Int
alias X = (Int, Bool) -> {Int, Bool}
alias X = (a: Int, b: Bool) -> {a: Int, b: Bool}
alias X = (a: a, b: a) -> [a]
alias X = (a: [a], b: [a: a]) -> Set(Bool)
alias X = (a: Module.Type) -> Module.Type({Bool, Bool})
alias X = (&a: Int, ->b: Bool, c: Float) -> Int
alias X = (&Int, ->Bool, Float) -> Int

-- Parenthesized.
alias X = (Int)
alias X = (Module.Int)
alias X = ({ [X], [Y], [Z] })
alias X = ([a])
alias X = ({ x: [X], y: Module.Type, z: { Type } })

-- Borrow types, nested.
alias X = { x: &Int, y: &[Int], z: &{Int, {Int, Int}} }
alias X = [&Int]
alias X = Y(&Int)

-- Checked reference types, nested.
alias X = { x: *Int, y: *[Int], z: *{*Int, *{Int, Int}} }
alias X = [*[*[Int: *{a, b}]]]
alias X = Y(*Z)

-- Fixed arrays, and the three things that may stand where the count does: a literal, a name that a
-- const parameter will bind, and `_` - which says the count is the literal the type is written at
-- rather than anything in the type. `[T]` and `[T *_]` are different kinds rather than one with an
-- absent count, so the printer names the second.
alias X = [Int *4]
alias X = [Int *n]
alias X = [Int *_]
alias X = [[Int *_] *_]
alias X = { x: [Int *_], y: &[Int *4] }
alias X = [(Int) -> Bool *_]
