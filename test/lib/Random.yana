{-
   `Random` - Analysis-Library.md §2.7, on both targets.

   Four claims, and each of them fails on its own:

    - **A seed determines the sequence, and the sequence is the same on both targets.** That is what
      the numbers pinned below are for. They are xoshiro128\*\*'s over this file's own seeding, so a
      change to either would move them - which is the point: this generator's output is part of its
      contract, in the way a digest's is, because a fixture elsewhere seeded with a constant is
      entitled to the same numbers next year and on the other target.
    - **Ranges are half-open and respected.** Every `between` and every `below` here is checked
      against both ends over enough draws to reach them.
    - **The draws are actually uniform.** A generator that returned its seed forever passes every
      bound check above, so the bucket counts below are the assertion that does not. They are exact
      numbers rather than statistics - the seed is written in the source, so there is nothing here
      that could be unlucky on a Tuesday.
    - **`secureRandom` answers, either way.** It is the one thing in the module whose answer differs
      between the targets, so what is asserted is the shape of the answer and what follows from it.

   Run on both targets, which is the reason the generator is 32-bit at all: the same source, the same
   sequence, once through a machine word and once through a `number`.
-}

import Random

-- The seed the pinned numbers belong to. Nothing about it is special; it is written here once so
-- that the numbers below have one source.
let pinnedSeed = 20260824

fn sequence() -> {}:
    -- The first eight draws, as `U32`. Worked out from the reference implementation rather than
    -- from this one, so they pin the algorithm and not merely today's behaviour.
    let &rng = newRng(pinnedSeed)

    assert(next(rng) == 4140245044)
    assert(next(rng) == 2403813560)
    assert(next(rng) == 2821307866)
    assert(next(rng) == 2867869537)
    assert(next(rng) == 1874838478)
    assert(next(rng) == 148666953)
    assert(next(rng) == 2108964929)
    assert(next(rng) == 2886156714)

    -- The same seed is the same sequence, which is the whole of what no-global-state buys.
    let &again = newRng(pinnedSeed)
    assert(next(again) == 4140245044)
    assert(next(again) == 2403813560)

    -- Two generators are independent: drawing from one does not move the other.
    let &left = newRng(pinnedSeed)
    let &right = newRng(pinnedSeed)
    assert(next(left) == next(right))
    let _ = next(left)
    assert(next(right) == 2403813560)

    -- Adjacent seeds are unrelated sequences, which is what the SplitMix expansion is for: a
    -- generator seeded straight from `1` and one seeded from `2` would agree in most of their bits.
    let &one = newRng(1)
    let &two = newRng(2)
    assert(next(one) == 393288148)
    assert(next(two) == 4239540602)
    return

fn integers() -> {}:
    let &rng = newRng(pinnedSeed)

    -- `uniform` at `Int` is the same draw read as a signed word - the first pinned value above.
    assert((uniform(rng) :: Int) == -154722252)

    -- Half-open at both ends, over enough draws to reach them. A die is `between(1, 7)`.
    let &low = 7 :: Int
    let &high = 0 :: Int
    let &i = 0 :: Size

    while i < 600:
        let roll = between(rng, 1, 7) :: Int
        assert(roll >= 1)
        assert(roll < 7)

        if roll < low then low = roll
        if roll > high then high = roll
        i = i + 1

    assert(low == 1)
    assert(high == 6)

    -- An empty or inverted range answers its low end rather than being an error.
    assert((between(rng, 4, 4) :: Int) == 4)
    assert((between(rng, 9, 2) :: Int) == 9)

    -- The full signed range is drawable, which is the case the wrapping subtraction in the instance
    -- exists for: the span is 2^32 - 1, which no `Int` can hold.
    let &full = newRng(77)
    let least = minValue() :: Int
    let most = maxValue() :: Int
    let &negatives = 0 :: Int
    let &positives = 0 :: Int
    let &n = 0 :: Size

    while n < 16:
        let value = between(full, least, most) :: Int
        if value < 0 then negatives = negatives + 1
        if value > 0 then positives = positives + 1
        n = n + 1

    assert(negatives == 9)
    assert(positives == 7)
    return

fn widths() -> {}:
    -- The narrow instances, checked at their ends the same way. `U8` reaching 0 and 255 over a
    -- thousand draws is what a truncation to the wrong width fails.
    let &rng = newRng(11)
    let &lowByte = 255 :: U8
    let &highByte = 0 :: U8
    let &lowShort = 65535 :: U16
    let &highShort = 0 :: U16
    let &i = 0 :: Size

    while i < 4000:
        let byte = uniform(rng) :: U8
        if byte < lowByte then lowByte = byte
        if byte > highByte then highByte = byte

        let short = uniform(rng) :: U16
        if short < lowShort then lowShort = short
        if short > highShort then highShort = short
        i = i + 1

    assert(lowByte == 0)
    assert(highByte == 255)
    assert(lowShort < 100)
    assert(highShort > 65400)

    -- And their ranges, which go through the same unbiased draw the `Int` one does.
    let &j = 0 :: Size
    while j < 200:
        let byte = between(rng, 10 :: U8, 20 :: U8)
        assert(byte >= 10)
        assert(byte < 20)

        let short = between(rng, 1000 :: U16, 1001 :: U16)
        assert(short == 1000)
        j = j + 1

    -- One bit, and both values of it appear.
    let &heads = 0 :: Int
    let &tails = 0 :: Int
    let &k = 0 :: Size

    while k < 100:
        if uniform(rng) :: Bool then heads = heads + 1 else tails = tails + 1
        k = k + 1

    assert(heads > 20)
    assert(tails > 20)
    assert(heads + tails == 100)
    return

fn reals() -> {}:
    {-
       The unit interval, at both widths. `1.0` is not in it and cannot be - the assembled integer is
       at most 2^53 - 1 - which is what makes the scaling in `between` safe without a clamp.

       The bounds on the extremes are what a shift of the wrong distance fails: a `Double` built from
       one draw rather than two never exceeds 1 - 2^-32 by much less, but its *granularity* would be
       wrong, so what is checked instead is that a thousand draws span most of the interval.
    -}
    let &rng = newRng(3)
    let &least = 1.0 :: Double
    let &most = 0.0 :: Double
    let &i = 0 :: Size

    while i < 1000:
        let value = uniform(rng) :: Double
        assert(value >= 0.0)
        assert(value < 1.0)

        if value < least then least = value
        if value > most then most = value
        i = i + 1

    assert(least < 0.01)
    assert(most > 0.99)

    let &wide = newRng(4)
    let &leastFloat = 1.0 :: Float
    let &mostFloat = 0.0 :: Float
    let &j = 0 :: Size

    while j < 1000:
        let value = uniform(wide) :: Float
        assert(value >= 0.0)
        assert(value < 1.0)

        if value < leastFloat then leastFloat = value
        if value > mostFloat then mostFloat = value
        j = j + 1

    assert(leastFloat < 0.01)
    assert(mostFloat > 0.99)

    -- The range variant, which is the unit draw scaled. Both ends hold for a range that does not
    -- start at zero and for one that is entirely negative.
    let &k = 0 :: Size
    while k < 500:
        let value = between(rng, -2.5, -0.5) :: Double
        assert(value >= -2.5)
        assert(value < -0.5)

        let single = between(rng, 100.0 :: Float, 200.0 :: Float)
        assert(single >= 100.0)
        assert(single < 200.0)
        k = k + 1

    assert((between(rng, 1.0, 1.0) :: Double) == 1.0)
    return

fn uniformity() -> {}:
    {-
       The claim the bound checks cannot make: the draws are *spread*. Eight buckets over 4096 draws
       expect 512 each, and what is asserted is that every one of them is within a fifth of that -
       which a generator returning a constant, or one whose low bits are weak, misses by a mile.

       Exact rather than statistical: the seed is a constant, so these counts are a fact about this
       program and not a probability. They are checked against the reference implementation, so a
       change to either the generator or the rejection loop moves them.
    -}
    let &rng = newRng(pinnedSeed)
    let &counts = [0] :: [Int *8]
    let &i = 0 :: Size

    while i < 4096:
        let bucket = below(rng, 8)
        assert(bucket >= 0)
        assert(bucket < 8)

        counts[bucket] = counts[bucket] + 1
        i = i + 1

    let &total = 0 :: Int
    let &j = 0 :: Size

    while j < 8:
        assert(counts[j] > 409)
        assert(counts[j] < 615)
        total = total + counts[j]
        j = j + 1

    assert(total == 4096)

    -- `below` at the two degenerate counts, which is what a container of no elements hands it.
    assert(below(rng, 0) == 0)
    assert(below(rng, 1) == 0)
    return

fn entropy() -> {}:
    {-
       The one answer that differs between the targets: a kernel has an entropy pool and a bare
       script context has nothing that a library may rely on. So both arms are written, and each
       asserts what follows from its own answer rather than the fixture asserting which arm it is in.
    -}
    let &bytes = [0] :: [U8 *8]

    match secureRandom(bytes):
        Ok(_):
            -- Eight bytes the kernel wrote. All-zero is a legal answer with probability 2^-64, which
            -- is a smaller number than the chance of every other assertion in this file being wrong.
            let &any = 0 :: Int
            let &i = 0 :: Size

            while i < 8:
                any = any `or` (bytes[i] :: Int)
                i = i + 1

            assert(any != 0)

        Err(NoEntropySource):
            -- Nothing was written, which is the other half of the promise: a refusal does not leave
            -- a caller with bytes it might mistake for random ones.
            assert(bytes[0] == 0)
            assert(bytes[7] == 0)

    -- And the seed built over it, which has an answer either way. What is asserted is that it is a
    -- usable seed rather than which source it came from - a generator built from it draws.
    let &rng = seededRng()
    let &different = 0 :: Int
    let &j = 0 :: Size

    while j < 8:
        if next(rng) != next(rng) then different = different + 1
        j = j + 1

    assert(different > 4)
    return

fn main() -> Int:
    sequence()
    integers()
    widths()
    reals()
    uniformity()
    entropy()
    return 0
