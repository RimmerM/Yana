{-
   `File` - Analysis-Library.md §2.9, over a real file system.

   **The only fixture in this suite that has effects outside its own process**, and the two rules
   that follow from that are what most of the shape below is about.

   *It has to be able to run beside itself.* `YanaLibTest` and `YanaElfTest` share this corpus and
   run as separate processes at the same time, so a fixed path would have two programs creating and
   deleting each other's files. The scratch directory is therefore named after the process, which is
   what `processId` is in `Native.Linux` for - and `YanaLibTest` runs each build in a forked child,
   so its three builds get three pids of their own rather than sharing the driver's.

   *It has to be able to run again in the same tree.* The library driver compiles every fixture three
   times - specialization declined, the optimizer off - and runs `main` for each, so every step here
   either cleans up after itself or tolerates what the last one left. `tearDown` is what makes the
   next round's `setUp` see an empty tree.

   What each check asserts, it asserts with `assert`, so a failure stops the process where it
   happened. What no assertion can say is that a stage *ran* - an assertion in a body nothing
   reached reports nothing - so each stage still answers its own small positive number and `run`
   sums them: 66 is the whole tree having been walked.

   Native only - there is no `.js` marker beside it and there will not be one. `File` is written over
   `Native.Linux`, and a JavaScript build has no descriptors to hand out.
-}

import Native
import File
import Date

fn scratchRoot() -> String:
    let &name = String.ofCapacity(32)
    String.push(name, "/tmp/yana-file-")
    show(truncate(processId()) :: Int, name)
    return name

-- ------------------------------------------------------------------ directories

fn setUp(root: String) -> Result(FileError, Int):
    createDirectory(joinPath(root, "nested/deep"))?

    assert(directoryExists(root))
    assert(directoryExists(joinPath(root, "nested/deep")))
    assert(!(fileExists(root)))

    -- Already there is not a failure.
    createDirectory(root)?

    return Ok(1)

-- ------------------------------------------------------------------ whole files

fn wholeFile(root: String) -> Result(FileError, Int):
    let path = joinPath(root, "hello.txt")
    writeWholeFile(path, "hello, files")?

    assert(fileExists(path))
    assert(pathSize(path)? == 12)

    let back = readWholeFile(path)?
    assert(back == "hello, files")
    assert(length(back) == 12)

    return Ok(2)

-- ------------------------------------------------------------------ the handle

fn handles(root: String) -> Result(FileError, Int):
    let path = joinPath(root, "handle.bin")
    let &empty = closedFile()
    assert(!(isOpen(empty)))

    -- §2a: `let &` takes the value out of the `?` payload, so a file opened this way is mutable and
    -- every `&self` operation below is reachable from it. `openInto` existed to reach them, and it
    -- is gone.
    let &file = openFile(path, readWriteAccess(), CreateAlways)?

    assert(isOpen(file))
    assert(writeText(file, "0123456789")? == 10)
    assert(position(file)? == 10)
    assert(fileSize(file)? == 10)

    -- The positional pair does not move the cursor.
    let &buffer = [0 :: U8, 0, 0, 0]
    assert(readAtInto(file, 3, buffer)? == 4)
    assert(position(file)? == 10)
    assert(!(buffer[0] != 51 || buffer[3] != 54))

    -- And the sequential pair does.
    assert(seek(file, 1)? == 1)
    assert(readInto(file, buffer)? == 4)
    assert(position(file)? == 5)
    assert(buffer[0] == 49)

    -- A read that runs into the end answers what was there, and then zero.
    assert(seek(file, -2, FileEnd)? == 8)
    assert(readInto(file, buffer)? == 2)
    assert(readInto(file, buffer)? == 0)

    writeAt(file, 0, buffer)?
    truncateFileTo(file, 4)?
    assert(fileSize(file)? == 4)

    flush(file)?
    close(file)?
    assert(!(isOpen(file)))

    -- Closing twice is not an error, which is what makes the drop this value still owes harmless.
    close(file)?

    let back = readWholeFile(path)?
    assert(back == "8934")

    return Ok(3)

-- ------------------------------------------------------------------ appending, and the link stat

fn appending(root: String) -> Result(FileError, Int):
    let path = joinPath(root, "log.txt")
    writeWholeFile(path, "one")?

    let &file = openFile(path, writeAccess(), OpenAlways, fileAppend)?

    -- An append write lands at the end whatever the cursor says, which is what the flag is.
    seek(file, 0)?
    writeText(file, "two")?
    close(file)?

    assert(readWholeFile(path)? == "onetwo")

    -- The positional write is the one that does not move a cursor, and there is a cursor here to
    -- watch: `writeTextAt` leaves it where the sequential write above left it.
    let &second = openFile(path, readWriteAccess(), OpenExisting)?
    writeTextAt(second, 3, "TWO")?
    assert(position(second)? == 0)

    close(second)?
    assert(readWholeFile(path)? == "oneTWO")

    -- `linkInfo` is `lstat`, which on a path that is not a link answers what `stat` answers.
    let direct = pathInfo(path)?
    let linked = linkInfo(path)?
    assert(direct.size == linked.size)
    assert(!(linked.isLink))
    assert(!(linked.isDirectory))
    -- A `Timestamp` now rather than an `I64` of microseconds, so the comparison is against a point
    -- in time rather than against zero - and `epoch()` is the point a bare `0` used to stand for.
    assert(linked.modifiedTime > epoch())

    removeFile(path)?

    return Ok(9)

-- ------------------------------------------------------------------ copy, move, remove

fn moving(root: String) -> Result(FileError, Int):
    let source = joinPath(root, "hello.txt")
    let copied = joinPath(root, "copied.txt")
    let moved = joinPath(root, "nested/moved.txt")

    copyFile(source, copied)?
    assert(readWholeFile(copied)? == "hello, files")

    -- Without overwrite, a copy onto a file that is there is refused.
    assert((copyFile(source, copied, False) is Err(_)))

    moveFile(copied, moved)?
    assert(!(fileExists(copied)))
    assert(fileExists(moved))

    removeFile(moved)?
    assert(!(fileExists(moved)))

    return Ok(4)

-- Past one block of the copy loop and one read of `readWholeFile`, which is where the two loops
-- stop being straight lines. 100000 is not a multiple of the 65536 either of them asks for.
fn copyingBlocks(root: String) -> Result(FileError, Int):
    let source = joinPath(root, "big.bin")
    let target = joinPath(root, "big-copy.bin")

    let &text = String.ofCapacity(100000)
    let &at = 0 :: Int

    while at < 100000:
        String.pushUnit(text, 97 + (at `rem` 26))
        at = at + 1

    writeWholeFile(source, text)?
    assert(pathSize(source)? == 100000)

    copyFile(source, target)?
    assert(pathSize(target)? == 100000)

    let back = readWholeFile(target)?
    assert(length(back) == 100000)
    assert(back == text)

    removeFile(source)?
    removeFile(target)?

    return Ok(10)

-- ------------------------------------------------------------------ the traversal

fn walking(root: String) -> Result(FileError, Int):
    let &files = 0 :: Int
    let &directories = 0 :: Int
    let &named = 0 :: Int

    -- `?` and not a `match`, which is Analysis-Language.md §3a landing where it was aimed. What a
    -- `for` body receives has a binding convention now, `entries` declares `-> ->Result(...)`, and
    -- an owned payload is therefore something the body may take out. This loop used to be a `match`
    -- with an `Ok` arm and an `Err` arm, and the `Err` arm existed only to be counted.
    for entry in entries(root):
        let it = entry?

        if it.isDirectory then directories = directories + 1
        else files = files + 1

        if it.name == "hello.txt" then named = named + 1

    assert(directories == 1)
    assert(files == 2)
    assert(named == 1)

    -- `break` out of a traversal two thousand times: the descriptor is closed by the drop rather
    -- than by anything written here, and running out of descriptors is what says it was not. The
    -- value the body received is owned, so its name is dropped on the `break` path too.
    let &seen = 0 :: Int
    let &round = 0 :: Int
    while round < 2000:
        for entry in entries(root):
            let it = entry?
            seen = seen + 1
            break

        round = round + 1

    assert(seen == 2000)

    return Ok(5)

-- ------------------------------------------------------------------ failure

fn failures(root: String) -> Result(FileError, Int):
    let missing = joinPath(root, "nothing-here")

    assert((pathInfo(missing) is Err(NotFound)))
    assert((openFile(missing, readAccess(), OpenExisting) is Err(NotFound)))
    assert((readWholeFile(missing) is Err(NotFound)))
    assert(!(fileExists(missing)))
    assert((removeDirectory(root) is Err(InUse)))

    -- A directory opens and does not read, which is the kernel's rule rather than one made here.
    assert((readWholeFile(root) is Err(Unsupported)))

    -- What an error says about itself, in both forms.
    let &text = String.ofCapacity(32)
    show(NotFound, text)
    assert(text == "NotFound")
    assert(describeError(NoDiskSpace) == "the disk is full")

    -- The three inherited descriptors are files like any other. Nothing is written to them here;
    -- what is asserted is that they are open, which is the whole of what the constructors claim.
    assert(isOpen(standardInput()))
    assert(isOpen(standardOutput()))
    assert(isOpen(standardError()))

    return Ok(6)

{-
   The growth path of `readWholeFile`, which is the branch a file whose size `stat` knows never
   reaches: `/proc` reports every file as zero bytes and then hands over content.

   Conditional on `/proc` being mounted, deliberately. It is on every Linux this fixture can run on
   and it is not the kernel interface being tested, so a machine without it asserts nothing here
   rather than failing.
-}
fn growth() -> Result(FileError, Int):
    match readWholeFile("/proc/self/maps"):
        Ok(text):
            assert(length(text) != 0)
            assert(pathSize("/proc/self/maps")? == 0)

        Err(e):
            {}

    return Ok(11)

-- ------------------------------------------------------------------ the drop

-- Two thousand opens with no close written anywhere: a process has about a thousand descriptors, so
-- this runs out part way unless the drop closes each one at its last use.
fn dropping(root: String) -> Result(FileError, Int):
    let path = joinPath(root, "hello.txt")
    let &round = 0 :: Int
    let &total = 0 :: Int

    while round < 2000:
        let ->file = openFile(path, readAccess(), OpenExisting)?
        total = total + (if isOpen(file) then 1 else 0)
        round = round + 1

    assert(total == 2000)

    return Ok(7)

-- ------------------------------------------------------------------ cleanup

fn tearDown(root: String) -> Result(FileError, Int):
    removeFile(joinPath(root, "hello.txt"))?
    removeFile(joinPath(root, "handle.bin"))?
    removeDirectory(joinPath(root, "nested/deep"))?
    removeDirectory(joinPath(root, "nested"))?
    removeDirectory(root)?

    assert(!(directoryExists(root)))

    return Ok(8)

fn run() -> Result(FileError, Int):
    let root = scratchRoot()

    let a = setUp(root)?

    let b = wholeFile(root)?

    let c = handles(root)?

    let d = appending(root)?

    let e = moving(root)?

    let f = copyingBlocks(root)?

    let g = walking(root)?

    let h = failures(root)?

    let i = growth()?

    let j = dropping(root)?

    let k = tearDown(root)?

    return Ok(a + b + c + d + e + f + g + h + i + j + k)

{-
   The stages, and the one number that says every one of them ran.

   Each stage answers its own small positive number and `run` sums them, so 66 is the whole tree
   having been walked rather than any single check having held - which the assertions inside the
   stages cannot say, since an assertion in a body that never executed reports nothing.
-}
fn main() -> Int:
    match run():
        Ok(->v) -> assert(v == 66)
        Err(->e) -> assert(False)

    return 0
