{-
   `sort`, `sortBy`, `sorted` and `sortedBy` - Analysis-Library.md Part 6 item 4, on both targets.

   Five claims, and each of them fails on its own:

    - **The answer is in order.** Checked by walking the result rather than by naming the numbers,
      so the assertion holds for every input below rather than for the one that was written out.
    - **The answer is a permutation of the input.** A sort that dropped an element or duplicated one
      would pass every ordering check there is, so the multiset is checked separately - by sum and by
      count for the integer cases, and by looking for each original element in the result for the
      rest.
    - **The shapes the algorithm switches on are all reached.** Under twelve elements is insertion
      sort and nothing else; over it is the partition; and a range that defeats the pivot is
      heapsort. `defeated` below is long enough and lopsided enough to spend the budget, which is
      what makes the fallback something this file runs rather than something it describes.
    - **An element that owns storage is sorted by moving it, never by copying it.** That is what the
      `String` cases are for: they do not compile at all if anything in the algorithm duplicates an
      element, and they leak or double-free if a swap is written as a read and two writes in the
      wrong order.
    - **`sorted` leaves its argument alone**, which is the whole of what distinguishes it from
      `sort` and is asserted after every call.

   Run on both targets, because the two swap elements by different means - a `swap` through two
   addresses natively, a read of both slots and a write of each on JS - and that is the one place in
   the algorithm where the targets do not share a line.
-}

import Native

pub data Person {name: String, age: Int}

-- A container built from a seed, in an order nothing about the sort can predict. Not `Random`'s
-- generator: this file asserts about ordering rather than about draws, and a xorshift written here
-- is one that cannot move under it.
fn scrambled(count: Int, seed: I64) -> Array(Int):
    let &out = [] :: [Int]
    let &state = seed
    let &i = 0

    while i < count:
        state = state `xor` (state `shl` 13)
        state = state `xor` (state `shr` 7)
        state = state `xor` (state `shl` 17)
        push(out, truncate(state `shr` 40) :: Int)
        i = i + 1

    return out

fn ascends(xs: [Int]) -> Bool:
    let &i = 1 :: Size
    while i < length(xs):
        if xs[i] < xs[i - 1] then return False
        i = i + 1

    return True

fn descends(xs: [Int]) -> Bool:
    let &i = 1 :: Size
    while i < length(xs):
        if xs[i - 1] < xs[i] then return False
        i = i + 1

    return True

fn total(xs: [Int]) -> Int:
    let &out = 0
    let &i = 0 :: Size

    while i < length(xs):
        out = out + xs[i]
        i = i + 1

    return out

-- A fingerprint that survives reordering and not much else. The sum alone is preserved by a swap
-- that is not a permutation - 1 and 3 becoming 2 and 2 - and the xor is what that pair does not
-- survive, so the two together are what says the answer holds the elements the argument did.
fn mixed(xs: [Int]) -> Int:
    let &out = 0
    let &i = 0 :: Size

    while i < length(xs):
        out = out `xor` xs[i]
        i = i + 1

    return out

fn integers() -> {}:
    -- The empty container and the one-element one, which are the two ranges every index in
    -- `sortRange` is derived from and the two a sort most often walks off the end of.
    let &none = [] :: [Int]
    sort(none)
    assert(length(none) == 0)

    let &one = [7]
    sort(one)
    assert(one[0] == 7)

    -- Under `smallRange`: insertion sort and nothing else.
    let &small = [5, 3, 9, 1, 7, 2, 8]
    sort(small)
    assert(ascends(small))
    assert(small[0] == 1)
    assert(small[6] == 9)

    -- Over it: the partition runs, and the sum is what says nothing was lost on the way.
    let &many = scrambled(400, 88172645463325252)
    let before = total(many)
    sort(many)
    assert(ascends(many))
    assert(total(many) == before)

    -- Already sorted, and sorted backwards. Both are the inputs a first-element pivot turns into
    -- O(n²), and both are what the median of three exists for.
    let &up = [] :: [Int]
    let &down = [] :: [Int]
    let &i = 0
    while i < 200:
        push(up, i)
        push(down, 200 - i)
        i = i + 1

    sort(up)
    assert(ascends(up))
    assert(up[0] == 0)
    assert(up[199] == 199)

    sort(down)
    assert(ascends(down))
    assert(down[0] == 1)
    assert(down[199] == 200)

    -- Every element equal, which is where Lomuto's partition degrades and Hoare's does not. What is
    -- asserted is that it finishes and that nothing changed, since either is enough to fail if the
    -- scans do not stop on a tie.
    let &flat = [] :: [Int]
    let &j = 0
    while j < 300:
        push(flat, 42)
        j = j + 1

    sort(flat)
    assert(ascends(flat))
    assert(total(flat) == 300 * 42)

{-
   The heapsort fallback, reached rather than described.

   Musser's median-of-three killer at 400 elements: the odd positions count up from one and the even
   ones count up from `n/2`, which is the arrangement that makes the median of first, middle and last
   land one element from an end at every level. Four hundred elements gives the driver a budget of
   eighteen and this input spends it twice, so the fallback is code this fixture *runs* - which is
   not something an ordering assertion can say on its own, and was checked by emptying `heapRange`
   and watching this function fail.

   The assertion is the ordering and the fingerprint, because which of the two sorts produced the
   answer is not something a caller may ask.
-}
fn killer() -> Array(Int):
    let &out = [] :: [Int]
    let &i = 0

    while i < 400:
        push(out, if i `and` 1 == 0 then i + 1 else 200 + i)
        i = i + 1

    return out

fn defeated() -> {}:
    let &xs = killer()
    let sum = total(xs)
    let fold = mixed(xs)

    sort(xs)
    assert(ascends(xs))
    assert(length(xs) == 400)
    assert(total(xs) == sum)
    assert(mixed(xs) == fold)

    -- The same input through the closure half, which has its own copy of the driver and its own copy
    -- of the fallback. Ordering is asserted here because the comparison *is* an order - what the
    -- input defeats is the pivot, not the caller.
    let &again = killer()
    sortBy(again, (left: Int, right: Int) -> left < right)
    assert(ascends(again))
    assert(total(again) == sum)
    assert(mixed(again) == fold)

{-
   And the same fallback through the closure half, reached by a comparison that is not an order at
   all.

   `before` answering True for every pair is the worst a caller can hand over: the ascending scan
   runs to the end of the range, the descending one runs to the front, and the partition lands on
   `low` every time - so the range shrinks by one element per level and nothing else bounds the
   depth. What bounds it is the budget, and what the guards in `partitionRangeBy` bound is the two
   scans, which would otherwise walk off both ends of the container.

   So this asserts termination and the fingerprint and says nothing about order, which is all a
   caller who supplied that comparison is owed.
-}
fn inconsistent() -> {}:
    let &xs = scrambled(400, 1442695040888963407)
    let sum = total(xs)
    let fold = mixed(xs)

    sortBy(xs, (left: Int, right: Int) -> True)
    assert(length(xs) == 400)
    assert(total(xs) == sum)
    assert(mixed(xs) == fold)

    sortBy(xs, (left: Int, right: Int) -> False)
    assert(length(xs) == 400)
    assert(total(xs) == sum)
    assert(mixed(xs) == fold)

fn ordering() -> {}:
    -- `sortBy` with the order reversed, which is the smallest comparison that is not the class's.
    let &xs = scrambled(200, 6364136223846793005)
    let before = total(xs)
    sortBy(xs, (left: Int, right: Int) -> right < left)
    assert(descends(xs))
    assert(total(xs) == before)

    -- And a comparison over a field, which is what a closure is for and what `Ord` could not have
    -- answered: `Person` has no order, and a caller supplying one is the whole feature.
    let &people = [Person {name: "Ada", age: 36}, Person {name: "Grace", age: 45},
                   Person {name: "Alan", age: 41}, Person {name: "Edsger", age: 30}]

    sortBy(people, (left: Person, right: Person) -> left.age < right.age)
    assert(people[0].name == "Edsger")
    assert(people[1].name == "Ada")
    assert(people[2].name == "Alan")
    assert(people[3].name == "Grace")

    sortBy(people, (left: Person, right: Person) -> left.name < right.name)
    assert(people[0].name == "Ada")
    assert(people[1].name == "Alan")
    assert(people[2].name == "Edsger")
    assert(people[3].name == "Grace")

{-
   An element that owns its storage.

   These cases are the reason the algorithm moves elements with `swap` rather than lifting
   one into a temporary: a `String` cannot be duplicated, so a sort that copied anywhere would not
   compile, and one that wrote a swap as a read and two writes in the wrong order would free a
   string twice. Both are silent in the integer cases above and neither is silent here.
-}
fn owned() -> {}:
    let &names = ["pear", "apple", "fig", "banana", "cherry", "date"]
    sort(names)
    assert(names[0] == "apple")
    assert(names[1] == "banana")
    assert(names[2] == "cherry")
    assert(names[3] == "date")
    assert(names[4] == "fig")
    assert(names[5] == "pear")

    -- Long enough to partition, so the exchange runs over owned elements many times rather than the
    -- five an insertion sort of six would.
    let &lots = [] :: [String]
    let &i = 0
    while i < 60:
        push(lots, if i `and` 1 == 0 then "b" else "a")
        i = i + 1

    sort(lots)
    let &j = 0 :: Size
    while j < 60:
        assert(lots[j] == (if j < 30 then "a" else "b"))
        j = j + 1

    -- And with the order supplied at the call, over the same element type.
    let &back = ["pear", "apple", "fig"]
    sortBy(back, (left: String, right: String) -> right < left)
    assert(back[0] == "pear")
    assert(back[1] == "fig")
    assert(back[2] == "apple")

fn copies() -> {}:
    -- `sorted` answers a new container and leaves the argument in the order it was in, which is the
    -- one thing that distinguishes it from `sort`.
    let &source = [4, 2, 7, 1, 9, 3]
    let &out = sorted(source)

    assert(ascends(out))
    assert(length(out) == 6)
    assert(source[0] == 4)
    assert(source[1] == 2)
    assert(source[5] == 3)

    let &down = sortedBy(source, (left: Int, right: Int) -> right < left)
    assert(descends(down))
    assert(down[0] == 9)
    assert(down[5] == 1)
    assert(source[0] == 4)

    -- Over a slice of the argument rather than the whole of it, which is what `Chunked` accepting
    -- more than `Contiguous` buys and what a caller writes to sort part of a container.
    let &part = sorted(slice(source, 1, 4))
    assert(length(part) == 3)
    assert(part[0] == 1)
    assert(part[1] == 2)
    assert(part[2] == 7)

    -- Long enough to partition, so the copy and the sort are separate steps rather than one
    -- insertion pass over six elements.
    let &big = scrambled(300, 2862933555777941757)
    let before = total(big)
    let &ordered = sorted(big)
    assert(ascends(ordered))
    assert(total(ordered) == before)
    assert(total(big) == before)

{-
   Sorting in place through the two other containers a `Contiguous` argument accepts.

   A window into part of an array, and the array itself. Both reach `sort` by binding `c` to what the
   caller wrote, which is the argument position the note at the top of `Sort.yana` is about - so a
   fixture that only ever passed an `Array(a)` would not be testing the signature that file has.
-}
fn windows() -> {}:
    let &xs = [9, 8, 7, 6, 5, 4]
    let &middle = sliceMut(xs, 1, 5)

    sort(middle)
    assert(xs[0] == 9)
    assert(xs[1] == 5)
    assert(xs[2] == 6)
    assert(xs[3] == 7)
    assert(xs[4] == 8)
    assert(xs[5] == 4)

fn main() -> Int:
    integers()
    defeated()
    inconsistent()
    ordering()
    owned()
    copies()
    windows()

    return 0
