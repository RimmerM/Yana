{-
   `Monoid` and the four folds in `Core/Join.yana`.

   The class is `Append` plus an identity, and the split is what this file is mostly about: three of
   the four functions need the identity and `appendAll` does not, because a seed is the answer the
   identity would have supplied. So `appendAll` is written against `Append` alone and is the one a
   type with no empty value could still use.

   **Every fold here is a generic body specialized at two element types**, which is deliberate rather
   than incidental. `concat` at `String` and at `Array(Int)` are two clones of one body, and the
   accumulator in each is a `->` seed rebound with `let &->` and then moved out of and written back
   once per part. That is the shape three separate defects lived in - a class call in a cloned body
   whose result slot was left half-paired, an instruction's own copy of that slot number left on the
   appended index, and a `->` argument whose provenance was read through a `cast` the liveness walk
   did not follow - and each of them showed up as a wrong answer rather than as a diagnostic.

   The empty container is asserted for all three that take one, because that is the only case where
   the identity is the whole answer and the only case a fold can get wrong by never running its loop.

   Run on both targets, where the cost profiles differ and the answers cannot.
-}

fn strings() -> {}:
    assert(concat(["ab", "cd", "ef"]) == "abcdef")
    assert(concat(["solo"]) == "solo")
    assert(concat([] :: [String]) == "")

    assert(joinWith(["a", "b", "c"], ", ") == "a, b, c")
    assert(joinWith(["solo"], "-") == "solo")
    assert(joinWith([] :: [String], "-") == "")

    -- The separator is used `n - 1` times and copied each time, so an instance that consumed it
    -- would be a use-after-move on the second gap rather than a wrong string.
    assert(joinWith(["a", "b", "c", "d"], "..") == "a..b..c..d")

    assert(repeated("ab", 3) == "ababab")
    assert(repeated("ab", 1) == "ab")
    assert(repeated("ab", 0) == "")
    assert(repeated("ab", -2) == "")

    -- The seed's storage becomes the result's, which is what `appendAll` is for and what makes a
    -- builder continue rather than restart.
    assert(appendAll("start:", ["a", "b"]) == "start:ab")
    assert(appendAll("only", [] :: [String]) == "only")
    return

fn arrays() -> {}:
    let &joined = concat([[1, 2], [3]])

    assert(length(joined) == 3)
    assert(joined[0] == 1)
    assert(joined[2] == 3)

    -- Still an ordinary array afterwards rather than one fixed at the length it was built at.
    push(joined, 4)
    assert(length(joined) == 4)

    assert(length(concat([] :: [[Int]])) == 0)
    assert(length(concat([[7]])) == 1)

    let &separated = joinWith([[1], [2], [3]], [0])
    assert(length(separated) == 5)
    assert(separated[1] == 0)
    assert(separated[3] == 0)
    assert(separated[4] == 3)

    let &thrice = repeated([1, 2], 3)
    assert(length(thrice) == 6)
    assert(thrice[5] == 2)

    let &continued = appendAll([9], [[1], [2]])
    assert(length(continued) == 3)
    assert(continued[0] == 9)
    assert(continued[2] == 2)
    return

-- The element type the borrowing `++` could not serve, folded. Every part is copied into the result
-- and every copy is a run of its own, so a fold that aliased one would tear the same string down
-- twice at the end of this function.
fn owningElements() -> {}:
    let &names = concat([["ab", "cd"], ["ef"]])

    assert(length(names) == 3)
    assert(names[0] == "ab")
    assert(names[2] == "ef")

    let &spaced = joinWith([["a"], ["b"]], ["-"])
    assert(length(spaced) == 3)
    assert(spaced[1] == "-")

    -- The sources are still readable, which is what says the fold copied rather than consumed.
    let parts = [["x"], ["y"]]
    let &built = concat(parts)
    assert(length(built) == 2)
    assert(length(parts) == 2)
    assert(parts[0][0] == "x")
    return

-- A slice rather than the owner, which is the other `Contiguous` instance and the reason these are
-- written against the protocol rather than against `Array`.
fn overASlice() -> {}:
    let parts = ["ab", "cd", "ef"]

    assert(concat(parts[1..3]) == "cdef")
    assert(joinWith(parts[0..2], "+") == "ab+cd")
    assert(concat(parts[0..0]) == "")
    return

fn main() -> Int:
    strings()
    arrays()
    owningElements()
    overASlice()
    return 0
