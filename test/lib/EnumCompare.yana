{-
   `Eq` and `Ord` for a payload-free sum, generated - see `enumEqInstance` in resolve/intrinsic.cpp.

   Behaviour rather than shape, so this is a `lib/` fixture: what these change is that a comparison
   *exists* without anybody writing one, and that it answers what declaration order says. The IR of
   the comparison itself is one instruction and is nothing new.

   What they replaced was a line per enum, always the same line - `valueOf(lhs) == valueOf(rhs)` -
   which was both boilerplate and the wrong answer: `valueOf` reports `I64`, so on JS comparing two
   weekdays converted both to a `bigint`. `EnumValue.yana` beside this is the `Enum` class itself,
   which is what `valueOf` is still for.
-}

data Colour = Red | Green | Blue

-- Values pinned out of declaration order, which is where the two questions come apart: `Second` is
-- declared second and is the *largest*, so an order taken from the declaration list rather than from
-- the values would disagree here and nowhere else.
data Pinned = @value(1) First | @value(9) Second | @value(4) Third

-- And a negative one, which is the case the unsigned reading would get wrong. A `@value` below zero
-- is a number borrowed from a foreign ABI; the order is still the numbers' own.
data Signal = @value(-1) Failed | @value(0) Idle | @value(1) Running

-- Opaque, so that what is asserted is the comparison and not the constant folder. Every case below
-- would be answered at compile time otherwise, and a generated instance that only ever existed as a
-- call-site expansion would have nothing to run.
@noinline fn hide(c: Colour) -> Colour = c
@noinline fn hidePinned(p: Pinned) -> Pinned = p
@noinline fn hideSignal(s: Signal) -> Signal = s

fn equality() -> {}:
    assert(hide(Red) == hide(Red))
    assert(hide(Red) != hide(Green))
    assert(!(hide(Blue) == hide(Green)))

    -- `!=` has a default written over `==` in the class, and the generated instance supplies only
    -- `==` - so this is that default reaching a generated member.
    assert(hide(Blue) != hide(Red))
    return

fn ordering() -> {}:
    assert(hide(Red) < hide(Green))
    assert(hide(Green) <= hide(Green))
    assert(hide(Blue) > hide(Red))
    assert(hide(Green) >= hide(Red))
    assert(!(hide(Blue) < hide(Red)))

    -- `compare`, which is the member the class requires and the only one whose answer is not a
    -- `Bool`. The four above are emitted as their own comparisons rather than through it.
    assert(compare(hide(Red), hide(Blue)) == LT)
    assert(compare(hide(Green), hide(Green)) == EQ)
    assert(compare(hide(Blue), hide(Red)) == GT)

    -- And `min`/`max`, which keep the class defaults and so are one comparison and a select.
    assert(max(hide(Red), hide(Blue)) == Blue)
    assert(min(hide(Red), hide(Blue)) == Red)
    return

fn pinnedOrder() -> {}:
    -- The values decide, not the declaration list.
    assert(hidePinned(First) < hidePinned(Third))
    assert(hidePinned(Third) < hidePinned(Second))
    assert(max(hidePinned(First), hidePinned(Second)) == Second)
    assert(compare(hidePinned(Second), hidePinned(Third)) == GT)
    return

fn signalOrder() -> {}:
    assert(hideSignal(Failed) < hideSignal(Idle))
    assert(hideSignal(Failed) < hideSignal(Running))
    assert(min(hideSignal(Running), hideSignal(Failed)) == Failed)
    assert(hideSignal(Failed) != hideSignal(Running))
    return

{-
   A declared instance still wins, which is what makes an automatic one safe at all - the hook is
   consulted only where an instance lookup found nothing. `Bool` is the case that proves it in the
   library (it is a payload-free sum with a `Show` somebody wrote); this is the same statement for
   `Eq`, with an instance that deliberately answers the opposite of the generated one.
-}
data Odd = A | B

instance Eq(Odd):
    fn ==(lhs: Odd, rhs: Odd) -> Bool = False

fn declaredWins() -> {}:
    assert(!(A == A))
    return

fn main() -> {}:
    equality()
    ordering()
    pinnedOrder()
    signalOrder()
    declaredWins()
