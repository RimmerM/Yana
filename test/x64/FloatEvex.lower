# The scalar float arithmetic once more, at the AVX-512 level.
#
# extensions: v4
#
# The tier above FloatVex.lower, and it exists for the encoder rather than for the code: an EVEX
# prefix is four bytes where the VEX one is two or three, and for a scalar operation it buys nothing
# at all. What it buys later is the upper sixteen vector registers, which no other prefix can name -
# so every form a scalar value can reach needs an EVEX spelling before `vectorRegisterCountFor` can
# hand out xmm16, and this is where those spellings are checked.
#
# Only the arithmetic has one so far. The comparisons and transfers here still take their VEX forms,
# which is why they are in this file too: the mixture is what a target at this level actually emits.

arith64(%a: F64, %b: F64): F64 {
    {
        %s = add %a, %b: F64
        %d = sub %s, %b: F64
        %m = mul %d, %a: F64
        %q = div %m, %b: F64
        ret %q
    }
}

arith32(%a: F32, %b: F32): F32 {
    {
        %s = add %a, %b: F32
        %d = sub %s, %b: F32
        %m = mul %d, %a: F32
        %q = div %m, %b: F32
        ret %q
    }
}

# Every source read twice, so that no operand can be written over and the three-operand form is what
# keeps this to four instructions. Under the legacy forms each of these carries a copy.
noReuse(%a: F64, %b: F64): F64 {
    {
        %s = add %a, %b: F64
        %d = sub %a, %b: F64
        %m = mul %s, %d: F64
        %q = div %m, %a: F64
        ret %q
    }
}

# The three-byte prefix: the operand the allocator put in one of the upper eight registers cannot be
# named by the two-byte form, which has no B bit.
manyLive(%a: F64, %b: F64, %c: F64, %d: F64, %e: F64, %f: F64, %g: F64, %h: F64, %i: F64, %j: F64): F64 {
    {
        %ab = add %a, %b: F64
        %cd = add %c, %d: F64
        %ef = add %e, %f: F64
        %gh = add %g, %h: F64
        %ij = add %i, %j: F64
        %x = mul %ab, %cd: F64
        %y = mul %ef, %gh: F64
        %z = mul %x, %y: F64
        %r = div %z, %ij: F64
        ret %r
    }
}

# Negation, which is the pseudo that also loses its tie: `vxorps xmm, xmm, [rip + signmask]` names
# its source separately where `xorps` toggled the bit in the destination.
negate(%a: F64, %b: F32): F64 {
    {
        %n = neg %a: F64
        %m = neg %b: F32
        %w = cast %m: F64
        %r = add %n, %w: F64
        ret %r
    }
}

# The comparisons, which have nothing to drop: `vucomisd` is `ucomisd` with a different prefix.
compare(%a: F64, %b: F64): I32 {
    {
        %c = cmp_gt %a, %b: I32
        je %c, then, else
    }
  then {
        ret 1
    }
  else {
        ret 0
    }
}

compareValue(%a: F32, %b: F32): I32 {
    {
        %c = cmp_lt %a, %b: I32
        %d = add %c, %c: I32
        ret %d
    }
}

# A load folded into the operation that reads it, which is the memory twin of a VEX form: three
# operands and an address in the r/m field at once.
loadFold(%p: Ptr, %a: F64): F64 {
    {
        %v = load %p, 8: F64
        %s = add %a, %v: F64
        %w = load %p, 8: F64
        %m = mul %s, %w: F64
        ret %m
    }
}

# And the transfers on their own, where the address is the whole instruction.
transfer(%p: Ptr, %q: Ptr): F32 {
    {
        %v = load %p, 4: F32
        store %q, %v, 4
        ret %v
    }
}
