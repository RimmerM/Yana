# §42 The mask scan and the branch that guards it, made into one instruction.
#
# `if any(hits) then firstSet(hits)` is the shape of every search over vectors, and it computes the
# emptiness of one movemask twice: once as the comparison the branch reads, and once as the sentinel
# bit that keeps `bsf` from seeing zero. The machine answers both with the scan's own flags. What to
# look for:
#
#   - **`bsf ; jne` and nothing else.** No `or` and no `test`: the sentinel was only ever there to
#     make the operand nonzero, and the guard is the proof that it already is.
#   - **the scan stands in the *guard's* block**, above the branch that reads its flags. Hoisting it
#     is speculation of the cheapest kind - `bsf` does not fault, does not touch memory, and the
#     register it writes is dead on the arm that did not want it.
#   - **`guarded` is the shape that keeps its sentinel.** Its scan is reached from two places and
#     one of them says nothing about the mask, so both rewrites decline together.
#   - **`joined` is the shape §52 added**, where every way in *does* say something: two arms each
#     branch here on their own mask, so there are two proofs rather than none. It loses the sentinel
#     and keeps its two tests, and the movemask its scan reads is a **phi of the two arms' own
#     bitmaps** rather than a third `pmovmskb` of the vector the arms joined.
#
# The wide half of this is in `VectorMaskScan.Wide.lower`, where the scan is `tzcnt` and the flag
# that answers is CF rather than ZF.

# The whole rewrite. One predecessor, and it branches here on this mask being nonempty.
search(%a: i8x16, %b: i8x16): I32 {
    start {
        %m = cmp_eq %a, %b: m8x16
        %any = vreduce_or %m: I32
        je %any, hit, miss
    }

    hit {
        %f = vreduce_first %m: I32
        ret %f
    }

    miss {
        ret -1
    }
}

# The same guard written the other way round - `if none(hits) then miss` - which `foldNegatedTruth`
# turns into the comparison inverted rather than into a second instruction. So the scan's block is
# the branch's `otherwise` arm here, and the condition the branch carries is the one that means
# *empty*: `bsf` sets ZF for a zero operand, so this is `je` where the one above is `jne`.
searchInverted(%a: i8x16, %b: i8x16): I32 {
    start {
        %m = cmp_eq %a, %b: m8x16
        %any = vreduce_or %m: I32
        %none = xor %any, 1: I32
        je %none, miss, hit
    }

    miss {
        ret -1
    }

    hit {
        %f = vreduce_first %m: I32
        ret %f
    }
}

# A scan whose block has two ways into it, which is the case the proof does not reach: the second
# predecessor says nothing about the mask, so the sentinel stays and so does the test.
guarded(%a: i8x16, %b: i8x16, %n: I32): I32 {
    start {
        %m = cmp_eq %a, %b: m8x16
        %any = vreduce_or %m: I32
        je %any, hit, other
    }

    other {
        je (cmp_ilt %n, 0), hit, miss
    }

    hit {
        %f = vreduce_first %m: I32
        ret %f
    }

    miss {
        ret -1
    }
}

# §52 The join: a loop and the masked tail after it, each testing its own mask and branching into one
# hit block, which is what a search written out by hand compiles to once the two exits are merged.
#
# Three movemasks arrive here - one per arm and one of the phi - and two leave: a movemask is a
# function of its operand, so it distributes over the join, and the phi moves into the scalar domain.
# The sentinel goes with it, because here both proofs hold: every edge into `hit` is an arm branching
# on its own alternative being nonzero. The two `test`s stay - a scan cannot stand in two blocks at
# once, so the fusion above it is the one half a join does not get.
joined(%a: i8x16, %b: i8x16, %c: i8x16): I32 {
    start {
        %m = cmp_eq %a, %b: m8x16
        %any = vreduce_or %m: I32
        je %any, hit, tail
    }

    tail {
        %t = cmp_eq %a, %c: m8x16
        %anyTail = vreduce_or %t: I32
        je %anyTail, hit, miss
    }

    hit {
        %j = phi [start, %m], [tail, %t]: m8x16
        %f = vreduce_first %j: I32
        ret %f
    }

    miss {
        ret -1
    }
}
