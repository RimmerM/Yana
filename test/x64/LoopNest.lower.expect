
loopCall<complex>(%n: Int): Int {
  start {
    %z = cast 0: Int
    jmp head
  }

  head {
    %i = phi [start, %z], [body, %i2]: Int
    %s = phi [start, %z], [body, %s2]: Int
    %v_0 = cmp_ilt %i, %n: Int
    je %v_0, body, out
  }

  body {
    %r = call_complex helper, %i: Int
    %s2 = add %s, %r: Int
    %i2 = add %i, 1: Int
    jmp head
  }

  out {
    ret %s
  }
}

helper<complex>(%x: Int): Int {
  b_0 {
    ret %x
  }
}

nested<complex>(%n: Int, %m: Int): Int {
  start {
    %z = cast 0: Int
    jmp outer
  }

  outer {
    %i = phi [start, %z], [outerEnd, %i2]: Int
    %acc = phi [start, %z], [outerEnd, %acc2]: Int
    %v_0 = cmp_ilt %i, %n: Int
    je %v_0, inner, done
  }

  inner {
    %j = phi [outer, %z], [inner, %j2]: Int
    %a = phi [outer, %acc], [inner, %a2]: Int
    %a2 = add %a, %j: Int
    %j2 = add %j, 1: Int
    %v_1 = cmp_ilt %j2, %m: Int
    je %v_1, inner, outerEnd
  }

  outerEnd {
    %acc2 = phi [inner, %a2]: Int
    %i2 = add %i, 1: Int
    jmp outer
  }

  done {
    ret %acc
  }
}


