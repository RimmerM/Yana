    %m = cmp_eq %a, %b: m32x4
    %r = vreduce_and %m: Int
    ret %r
  }
}

countLanes<complex>(%a: i32x4, %b: i32x4): Int {
  b_0 {
    %m = cmp_eq %a, %b: m32x4
    %r = vreduce_add %m: Int
    ret %r
  }
}

anyThenFirst<complex>(%a: i8x16, %b: i8x16, %at: Int): Int {
  start {
    %m = cmp_eq %a, %b: m8x16
    %any = vreduce_or %m: Int
    je %any, hit, miss
  }

  hit {
    %first = vreduce_first %m: Int
    %r = add %at, %first: Int
    ret %r
  }

  miss {
    ret %at
  }
}

phiMask<complex>(%a: i8x16, %b: i8x16, %c: Int): Int {
  start {
    %p = cmp_eq %a, %b: m8x16
    %q = cmp_gt %a, %b: m8x16
    je %c, left, right
  }

  left {
    jmp join
  }

  right {
    jmp join
  }

  join {
    %m = phi [left, %p], [right, %q]: m8x16
    %any = vreduce_or %m: Int
    %first = vreduce_first %m: Int
    %r = add %first, %any: Int
    ret %r
  }
}

noneLanes<complex>(%a: i32x4, %b: i32x4, %x: Int): Int {
  start {
    %m = cmp_eq %a, %b: m32x4
    %any = vreduce_or %m: Int
    %none = xor %any, 1: Int
    je %none, empty, some
  }

  empty {
    ret %x
  }

  some {
    ret 0
  }
}


