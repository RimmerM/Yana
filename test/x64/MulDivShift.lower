mulDivShift(%a: I32, %b: I32): I32 {
    {
        %m1 = mul %a, %b: I32
        %m2 = imul %a, %b: I32
        %m3 = imul %a, 3: I32
        %dv = div %a, %b: I32
        %iq = idiv %a, %b: I32
        %ir = irem %a, %b: I32
        %sl = shl %a, %b: I32
        %sr = shr %a, %b: I32
        %sa = sar %a, %b: I32
        %sl2 = shl %a, 2: I32
        ret %m1
    }
}

# The high halves, which are the same two group-3 multiplies read for the register they usually
# throw away: the result is rdx and rax is the clobber, where `mul` and `imul` have it the other way
# round. Both widths, since the 32-bit one is the same encoding without the REX.W.
mulHigh(%a: I64, %b: I64, %c: I32, %d: I32): I64 {
    {
        %h1 = mulhi %a, %b: I64
        %h2 = imulhi %a, %b: I64
        %h3 = mulhi %c, %d: I32
        %h4 = imulhi %c, 7: I32
        %s = add %h1, %h2: I64
        ret %s
    }
}

# `rem` produces its result in rdx while reading its dividend from rax, so both have to be clear of
# anything still live - including a value that only passes through, like %c here (the third argument,
# which arrives in rdx).
remLiveResult(%a: I32, %b: I32, %c: I32): I32 {
    {
        %r = rem %a, %b: I32
        %s = add %r, %c: I32
        ret %s
    }
}
