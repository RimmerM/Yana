
branch<complex>(%v: Int, %out: Int): Int, Int {
  start {
    %v_0 = cmp_le %v, 0: Int
    je %v_0, a, b
  }

  a {
    %v1 = add %v, 1: Int
    jmp end
  }

  b {
    %v2 = mul %v, 2: Int
    jmp end
  }

  end {
    %v_1 = phi [a, %v1], [b, %v2]: Int
    ret %v_1, %out
  }
}

flagWindow<complex>(%v: Int, %w: Int): Int {
  start {
    %cmp = cmp_ilt %v, %w: Int
    %x = add %v, 1: Int
    %y = mul %w, 3: Int
    je %cmp, a, b
  }

  a {
    ret %x
  }

  b {
    ret %y
  }
}

flagWindowLoad<complex>(%v: Int, %w: Int, %p: Ptr): Int {
  start {
    %cmp = cmp_ilt %v, %w: Int
    %l = load %p, 4: Int
    %x = add %l, 1: Int
    je %cmp, a, b
  }

  a {
    ret %x
  }

  b {
    ret %w
  }
}

flagWindowLive<complex>(%v: Int, %w: Int, %p: Ptr): Int {
  start {
    %cmp = cmp_ilt %v, %w: Int
    %l = load %p, 4: Int
    %x = add %l, 1: Int
    je %cmp, a, b
  }

  a {
    %s = add %v, %w: Int
    %t = add %s, %x: Int
    ret %t
  }

  b {
    ret %w
  }
}

wideBranch<complex>(%v: Long, %w: Long): Long {
  start {
    %v_0 = cmp_ilt %v, %w: Int
    je %v_0, a, b
  }

  a {
    %s = add %v, %w: Long
    ret %s
  }

  b {
    %v_1 = cmp_ilt %w, 0: Int
    je %v_1, c, d
  }

  c {
    ret %w
  }

  d {
    %e = sub %v, 1: Long
    ret %e
  }
}


