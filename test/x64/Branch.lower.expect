
branch<complex>(%v: Int, %out: Int): Int, Int {
  start {
    %v_0 = cmp_le %v, 0: Int
    je %v_0, a, b
  }

  a {
    %v1 = add %v, 1: Int
    jmp end
  }

  b {
    %v2 = mul %v, 2: Int
    jmp end
  }

  end {
    %v_1 = phi [a, %v1], [b, %v2]: Int
    ret %v_1, %out
  }
}

wideBranch<complex>(%v: Long, %w: Long): Long {
  start {
    %v_0 = cmp_ilt %v, %w: Int
    je %v_0, a, b
  }

  a {
    %s = add %v, %w: Long
    ret %s
  }

  b {
    %v_1 = cmp_ilt %w, 0: Int
    je %v_1, c, d
  }

  c {
    ret %w
  }

  d {
    %e = sub %v, 1: Long
    ret %e
  }
}


