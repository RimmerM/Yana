expand16x8(%v: i16x8, %k: i16x8): i16x8 {
    {
        %m = cmp_neq %k, %v: m16x8
        %r = vexpand %v, %m: i16x8
        ret %r
    }
}

lookup16x8(%table: i16x8, %indices: i16x8): i16x8 {
    {
        %r = vlookup %table, %indices: i16x8
        ret %r
    }
}

