# `VectorMoves.lower` at `avx512`, where each is one instruction - Analysis-Avx512.md §3.1 and §3.3.
#
#   - **compress is `vpcompressb/w`** (EVEX.66.0F38.W0/W1 63, VBMI2) **and `vpcompressd/q`**
#     (W0/W1 8B), register to register with zero-masking, the mask in a `k` register: the source is
#     ModRM.reg and the destination r/m, which is the instruction's own operand order.
#   - **expand is `vpexpandb/w`** (62) **and `vpexpandd/q`** (89), the ordinary operand order.
#   - **a lookup is `vpermi2b/w/d/q`** (75/75/76/76) with the table as both sources, the index vector
#     being the destination.
#   - no `x86_masktovector` in front of either: the mask is the write mask and stays where the
#     comparison put it (`lowerMaskRegisters` lists `VecMove`).
#
# extensions: avx512

compress8x16(%v: i8x16, %k: i8x16): i8x16 {
    {
        %m = cmp_neq %k, %v: m8x16
        %r = vcompress %v, %m: i8x16
        ret %r
    }
}

expand8x16(%v: i8x16, %k: i8x16): i8x16 {
    {
        %m = cmp_neq %k, %v: m8x16
        %r = vexpand %v, %m: i8x16
        ret %r
    }
}

lookup8x16(%table: i8x16, %indices: i8x16): i8x16 {
    {
        %r = vlookup %table, %indices: i8x16
        ret %r
    }
}

compress16x8(%v: i16x8, %k: i16x8): i16x8 {
    {
        %m = cmp_neq %k, %v: m16x8
        %r = vcompress %v, %m: i16x8
