
popcounts<complex>(%b: i8x16, %w: i16x8, %d: i32x4, %q: i64x2): i8x16 {
  b_0 {
    %rb = popcnt %b: i8x16
    %rw = popcnt %w: i16x8
    %rd = popcnt %d: i32x4
    %rq = popcnt %q: i64x2
    ret %rb
  }
}

leadingWide<complex>(%d: i32x4): i32x4 {
  b_0 {
    %r = clz_width %d: i32x4
    ret %r
  }
}

trailing<complex>(%d: i32x4): i32x4 {
  b_0 {
    %r = cttz_width %d: i32x4
    ret %r
  }
}

upTo<complex>(%d: i32x4, %n: i32x4): i32x4 {
  b_0 {
    %r = bitsupto %d, %n: i32x4
    ret %r
  }
}


