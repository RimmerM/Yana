# Direct memory operands.
#
# A value that lives in the frame normally has to be brought back into a register before anything can
# read it. Most x86 ALU instructions have a form that reads one operand straight out of memory, and
# where that form exists the reload is not emitted at all: `add rax, [rsp+8]` in place of a load and
# an add.
#
# Which operand may be one is a table (memoryUseOperand), asked by the allocator when it decides
# whether to leave a spilled operand where it is and by the encoder when it finds a slot there. The
# property under test below is a `uses=[..., stack:N]` with no reload in front of it - or, for the
# cases the table excludes, exactly the reload that was there before.
#
# The Clobber convention destroys every register except rbp, so a value that has to survive one of
# its calls can only be in rbp, and a second one has nowhere left but the frame. That is the smallest
# way to spill something deliberately, and every case here uses it: %arg is consumed by the call and
# dies there, %keep is the first survivor and takes rbp, and %target is the second and takes a slot.

sink<clobber>(%x: I32): I32 {
    { ret %x }
}

wide<clobber>(%x: I64): I64 {
    { ret %x }
}

# The first add reads an ordinary register and the second reads the frame. They are the same
# instruction in the IR and different directions of the same opcode in the encoding: `add r, r/m`
# where the memory operand has to occupy the r/m field, `add r/m, r` where it does not.
foldedAdd(%arg: I32, %keep: I32, %target: I32): I32 {
    {
        %r = call_clobber sink, %arg: I32
        %s = add %r, %keep: I32
        %t = add %s, %target: I32
        ret %t
    }
}

# The other group-1 opcodes, each of which has the same pair of directions.
foldedBitwise(%arg: I32, %keep: I32, %t1: I32, %t2: I32): I32 {
    {
        %r = call_clobber sink, %arg: I32
        %s = and %r, %keep: I32
        %t = or %s, %t1: I32
        %u = xor %t, %t2: I32
        ret %u
    }
}

# A comparison, which needs no register at all for its own result when it is consumed as flags.
foldedCompare(%arg: I32, %keep: I32, %target: I32): I32 {
    start {
        %r = call_clobber sink, %arg: I32
        je (cmp_ilt %r, %target), less, more
    }

    less {
        ret %keep
    }

    more {
        ret %r
    }
}

# The group-3 forms take their operand as r/m too, so a divisor in the frame costs nothing either -
# and this is where the reload was most awkward, since the division already occupies rax and rdx.
foldedDivisor(%arg: I32, %keep: I32, %target: I32): I32 {
    {
        %r = call_clobber sink, %arg: I32
        %q = div %r, %target: I32
        %t = add %q, %keep: I32
        ret %t
    }
}

# A copy is a MOV either way round, so a source in the frame is read in place rather than loaded into
# a register the copy would then immediately read again.
foldedSet(%arg: I32, %keep: I32, %target: I32): I32 {
    {
        %r = call_clobber sink, %arg: I32
        %s = set %target: I32
        %t = add %s, %keep: I32
        %u = add %t, %r: I32
        ret %u
    }
}

# The first operand of a two-address operation is also its destination, so it can never be the memory
# *source* however the encoding is turned around. Where the operation has no memory destination form
# either - `imul` writes its result through the register field whichever way its operands are put -
# a spilled first operand is loaded into the destination register, which is exactly the reload the
# second operand no longer needs.
#
# %keep is read twice in a position that needs a register and %target once, which is what decides
# that %target is the one to leave in the frame.
spilledFirstOperand(%arg: I32, %keep: I32, %target: I32): I32 {
    {
        %r = call_clobber sink, %arg: I32
        %s = imul %target, %r: I32
        %t = add %keep, %s: I32
        %u = add %keep, %t: I32
        ret %u
    }
}

# Pointer arithmetic works at 64 bits and a 32-bit offset's slot holds four bytes. Slots are packed
# by width, so reading eight bytes out of a four-byte one would take the neighbouring value with it:
# the operand is reloaded instead. This is the one thing the width rule exists to force.
narrowOffset(%p: Ptr, %off: I32, %arg: I32): Ptr {
    {
        %r = call_clobber sink, %arg: I32
        %q = add %p, %off: Ptr
        ret %q
    }
}

# The same shape at matching widths, for contrast: the value is 64 bits and so is the operation, so
# the slot is exactly the right size and the operand stays where it is.
wideOffset(%p: I64, %off: I64, %arg: I64): I64 {
    {
        %r = call_clobber wide, %arg: I64
        %q = add %p, %off: I64
        ret %q
    }
}

# A shift takes its count in rcx and has no form that reads it from memory. A fixed-register operand
# is loaded straight into the register the encoding demands, out of the frame as readily as out of
# another register - so it costs a load, but never a scratch register.
shiftCount(%arg: I32, %keep: I32, %count: I32): I32 {
    {
        %r = call_clobber sink, %arg: I32
        %s = shl %r, %count: I32
        %t = add %s, %keep: I32
        ret %t
    }
}

# A load's address is not an operand an addressing mode can hold - it *is* the addressing mode - so a
# spilled pointer is brought into a register before the access.
spilledPointer(%arg: I32, %keep: I32, %p: Ptr): I32 {
    {
        %r = call_clobber sink, %arg: I32
        %v = load %p, 4: I32
        %s = add %keep, %v: I32
        %t = add %keep, %s: I32
        %u = add %t, %r: I32
        ret %u
    }
}

# A cast changes width by definition, so the width rule could never be satisfied and the table leaves
# casts out entirely rather than stating a condition that is always false. The source is reloaded.
spilledCast(%arg: I32, %keep: I64, %target: I32): I64 {
    {
        %r = call_clobber sink, %arg: I32
        %w = sext %target: I64
        %s = add %keep, %w: I64
        %t = add %keep, %s: I64
        ret %t
    }
}

# The other half of the table: a memory *destination*.
#
# The first operand of a two-address operation is also where its result goes, so it is the one
# operand an encoding can both read and write in the frame - `add [rsp+8], rcx` in place of a load,
# an add and a store. The condition is that the operand and the result occupy the same slot, which
# only the allocator can answer: their lives meet at the instruction rather than overlapping, so
# first-fit hands them one slot whenever it can, and phi-web coalescing makes them literally one web
# for a loop-carried accumulator (Spill.lower/spilledLoop is that case).
#
# It takes two calls to reach: the value has to be in the frame where it is read *and* still in the
# frame where the result is written, which one clobbering call is not enough to force.
#
# `uses=[stack:N, ...] creates=[stack:N]` with nothing around it is the property under test.

# %keep is read twice in a position that needs a register, so it takes the one preserved register.
# %target and the result of the add it feeds both end up in the frame, and in the same slot.
inPlaceAdd(%arg: I32, %keep: I32, %target: I32): I32 {
    {
        %r = call_clobber sink, %arg: I32
        %s = add %target, 7: I32
        %q = call_clobber sink, %r: I32
        %t = add %keep, %s: I32
        %u = add %keep, %t: I32
        %v = add %u, %q: I32
        ret %v
    }
}

# `inc [m]` rather than `add [m], 1`, the same one-byte-shorter form the register case already used.
inPlaceIncrement(%arg: I32, %keep: I32, %target: I32): I32 {
    {
        %r = call_clobber sink, %arg: I32
        %s = add %target, 1: I32
        %q = call_clobber sink, %r: I32
        %t = add %keep, %s: I32
        %u = add %keep, %t: I32
        %v = add %u, %q: I32
        ret %v
    }
}

# The group-3 unary forms take their subject as r/m too, so a spilled value is negated where it lies.
inPlaceNegate(%arg: I32, %keep: I32, %target: I32): I32 {
    {
        %r = call_clobber sink, %arg: I32
        %s = neg %target: I32
        %q = call_clobber sink, %r: I32
        %t = add %keep, %s: I32
        %u = add %keep, %t: I32
        %v = add %u, %q: I32
        ret %v
    }
}

# And so does every shift form.
inPlaceShift(%arg: I32, %keep: I32, %target: I32): I32 {
    {
        %r = call_clobber sink, %arg: I32
        %s = shl %target, 3: I32
        %q = call_clobber sink, %r: I32
        %t = add %keep, %s: I32
        %u = add %keep, %t: I32
        %v = add %u, %q: I32
        ret %v
    }
}

# Two spilled operands and one r/m field. The destination keeps it, since it is the one that would
# otherwise pay twice - a reload and a store - and the other operand is brought into a register.
oneMemoryOperand(%arg: I32, %keep: I32, %target: I32, %b: I32): I32 {
    {
        %r = call_clobber sink, %arg: I32
        %s = add %target, %b: I32
        %q = call_clobber sink, %r: I32
        %t = add %keep, %s: I32
        %u = add %keep, %t: I32
        %v = add %u, %q: I32
        ret %v
    }
}
