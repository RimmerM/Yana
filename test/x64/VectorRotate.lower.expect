
rotateByConstant<complex>(%v: i32x4): i32x4 {
  b_0 {
    %c = vsplat 5: i32x4
    %r = rol %v, %c: i32x4
    ret %r
  }
}

rotateRightByConstant<complex>(%v: i32x4): i32x4 {
