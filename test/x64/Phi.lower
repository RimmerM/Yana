# Phi hazards. Each of these used to break the register allocator, and each breaks it in a
# different way, so they are kept as separate functions rather than folded together.
#
# The shared theme is that a phi's register is written by a move at the end of *every* predecessor,
# including back edges reached long after the phi's own block. Any handling that assumes the value
# flowing into a phi is consumed exactly once, or that a phi's register is free between its last
# read and the back edge, gets one of these wrong.

# The value feeding the phi is also read inside the successor. It cannot be treated as consumed by
# the phi handoff, or the second read finds a register that has already been handed to something else.
sourceUsedLater(%n: Int, %lim: Int): Int {
    start {
        %x = add %n, 1: Int
        jmp head
    }

    head {
        %p = phi [start, %x], [head, %q]: Int
        %q = add %p, %x: Int
        je (cmp_le %q, %lim), head, end
    }

    end {
        ret %p
    }
}

# Two phis in the same block take the same incoming value, so that value is handed off twice over
# one edge.
sharedSource(%n: Int): Int {
    start {
        %x = add %n, 1: Int
        jmp join
    }

    join {
        %p = phi [start, %x]: Int
        %q = phi [start, %x]: Int
        %r = add %p, %q: Int
        ret %r
    }
}

# Both successors of a branch have a phi fed by the same value. Their moves must not both land on
# the branch's own terminator, where they would run on either path - the edges get split instead.
branchedSource(%n: Int, %c: Int): Int {
    start {
        %x = add %n, 1: Int
        je %c, a, b
    }

    a {
        %p = phi [start, %x]: Int
        ret %p
    }

    b {
        %q = phi [start, %x]: Int
        ret %q
    }
}

# Two phis that feed each other across the back edge: the copies at the edge form a permutation
# cycle, which is emitted as a single exchange rather than a sequence of moves that would clobber.
swap(%n: Int, %m: Int, %k: Int): Int {
    start {
        jmp head
    }

    head {
        %a = phi [start, %n], [head, %b]: Int
        %b = phi [start, %m], [head, %a]: Int
        je (cmp_le %a, %k), head, end
    }

    end {
        ret %a
    }
}

# The same swap, but each phi's incoming value is computed by a *destructive* operation whose other
# operand is the other phi. That is the one shape where interval arithmetic and coalescing disagree.
#
# `%b2 = sub %b, %a` writes its result over %b, so %a's life ends exactly where %b2's begins and the
# two never overlap - which makes %a and %b2 look like an ideal web to merge, and merging them is
# what removes a copy at the latch. But it also puts %b2 in %a's register, and the copy that puts %b
# there runs *in front of* the subtraction, so the subtraction then reads %b where it wanted %a.
#
# So the merge is refused, and the swap costs its copies. Both phis have to be here: with only one,
# the operand that would collide is the phi's own web and the copy is an identity.
tiedSwap(%x: Long, %y: Long, %n: Int): Long {
    start {
        jmp head
    }

    head {
        %a = phi [start, %x], [body, %b2]: Long
        %b = phi [start, %y], [body, %a2]: Long
        %i = phi [start, %n], [body, %i2]: Int
        je (cmp_eq %i, 0), done, body
    }

    body {
        %a2 = add %a, %b: Long
        %b2 = sub %b, %a: Long
        %i2 = sub %i, 1: Int
        jmp head
    }

    done {
        %r = sub %a, %b: Long
        ret %r
    }
}

# The other half of the same disjointness, and the one refusing the merge does not cover. `%y`'s
# life begins exactly where `%p`'s and `%q`'s end, so `%q` and the web `%y` belongs to are not
# merely mergeable - they are two webs first-fit will happily put in one register, and one of them
# is then read after the copy in front of the imul has overwritten it.
#
# Which of the two notices depends on which is placed first, and that is what makes this a phi
# hazard rather than an arithmetic one. A destructive result is normally placed *at* its instruction,
# where the other operands are already known and kept away from; but `%y` shares a web with the phi
# in `join`, so it was placed at the terminator of `left` - the first predecessor edge to reach that
# phi - long before the imul is walked, and the register it took there is one nothing at the imul
# was consulted about.
#
# Every part of the shape is load-bearing. `%g` is live across the whole function so that the web
# cannot have the first register in the order; `%p` takes the register `%a` is vacating, so the
# first free one is still free when `%q` asks for it - and what `%q` then finds free is the web's.
tiedNeighbour(%a: Int, %c: Int): Int {
    start {
        %g = add %a, 7: Int
        je %c, right, left
    }

    left {
        %x = add %g, 1: Int
        jmp join
    }

    right {
        %p = add %a, 2: Int
        %q = add %g, 3: Int
        %y = imul %p, %q: Int
        jmp join
    }

    join {
        %r = phi [left, %x], [right, %y]: Int
        %z = add %r, %g: Int
        ret %z
    }
}

# A phi threaded through a second diamond, so the value arriving at `end` comes from a phi rather
# than from an ordinary instruction.
chain(%x: Int, %c: Int): Int {
    start {
        je %c, l, r
    }

    l {
        %p = add %x, 1: Int
        jmp mid
    }

    r {
        %q = add %x, 2: Int
        jmp mid
    }

    mid {
        %m = phi [l, %p], [r, %q]: Int
        je %c, l2, r2
    }

    l2 {
        %s = add %m, 3: Int
        jmp end
    }

    r2 {
        %t = add %m, 4: Int
        jmp end
    }

    end {
        %z = phi [l2, %s], [r2, %t]: Int
        ret %z
    }
}

# A copy whose source is read again afterwards, and a phi over both ends of it.
#
# `%c` is a bitcast of `%b` and `%b` is added to it, so the two are live together and hold one
# number: buildWebs' copy phase merges them whatever the intervals say, and the bitcast emits
# nothing. What the phi at `end` then asks is the ordinary question - is the *whole* copy web dead
# wherever `%z` is live - which is why the copies are done first and the phis after. `%d` is read on
# the far side of the branch so that the web outlives the block it was built in.
copiedThenPhi(%p: Ptr, %n: Int): Long {
    start {
        %b = bitcast %p: Long
        %c = bitcast %b: Long
        %d = add %b, %c: Long
        je %n, hot, cold
    }

    hot {
        %e = add %d, 7L: Long
        jmp end
    }

    cold {
        jmp end
    }

    end {
        %z = phi [hot, %e], [cold, %d]: Long
        ret %z
    }
}
