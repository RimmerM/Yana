# The BMI pair-replacements, and the four BMI2 spellings of operations the machine already had.
#
# extensions: v3
#
# Two different things share this file because they are two halves of one feature level, and reading
# them apart is the point of `BitOps.lower` beside it - the same functions at v2, where every one of
# them is the pair or the legacy encoding these replace.
#
# The *rewrites* are `selectBitOps` in transform_peephole.cpp: `~a & b`, `x & (x - 1)`, `x & -x` and
# `x ^ (x - 1)` are two instructions each in the IR and one here, and the fifth entry in that table
# is a left rotation rewritten as the right one so that the immediate rotation can reach `rorx`.
#
# The *selections* are `alternative` links in machine_forms_scalar.cpp and nothing else: a variable
# shift becomes `shlx`/`shrx`/`sarx`, an immediate rotation becomes `rorx`, and an unsigned high
# product becomes `mulx`. No pass writes any of those; `selectAlternativeForm` takes them because the
# target has BMI2.
#
# What to look for:
#
#   - every one of the eight rewritten functions is one instruction. There is no `not`, no `dec`, no
#     `neg` and no copy in front of any of them - the pair was two-address and these are not.
#   - `blsr`, `blsi` and `blsmsk` put their *destination* in VEX.vvvv and an opcode extension in
#     ModRM.reg, which is the one shape in this backend that does. `andn` is the ordinary one.
#   - `shiftVariable` has no `mov` into rcx. That is the largest of the three things BMI2 buys here
#     and the one a byte count hides: the legacy form pins its count and this one does not.
#   - `highProduct` is one `mulx` naming the same register twice, which is the encoding's way of
#     asking for the top half alone. rax is not touched and no flag is written.
#   - `rotateLeft` is a `ror` by 25, not a `rol` by 7. The count is taken modulo the width, so the
#     two are the same function - see LowerInst::Rol.
#   - `andNotKept` is *not* rewritten: the complement has a second reader, so it has to stay, and a
#     rewrite would then buy one instruction at the price of one more value held live.
#   - `clearLowestLoaded` folds its load into the `blsr`, which is a fold the rewrite *creates*: the
#     pair read its subject twice, so no load feeding one ever had the single reader `foldLoads`
#     wants, and the replacement reads it once.
#   - `rotateSpilled` is the one encoding in this backend whose trailing immediate follows a
#     displacement rather than a ModRM byte alone - `rorx ecx, [rsp], 7`. It is here because a
#     trailing byte written in the wrong place has form: see the note on AsmRelocation, and the
#     packed compare against a pooled constant that was one byte off for exactly this reason.

# `~a & b`, from the side the language writes it: `alignUp` is `(v + a - 1) and not(a - 1)`.
andNot(%a: Int, %b: Int): Int {
    {
        %n = not %a: Int
        %r = and %n, %b: Int
        ret %r
    }
}

# And from the other side, which is the same instruction with its operands read the other way round.
# An `and` is commutative and `canonicalizeOperands` only moves immediates, so both orders arrive.
andNotSwapped(%a: Int, %b: Int): Int {
    {
        %n = not %a: Int
        %r = and %b, %n: Int
        ret %r
    }
}

andNot64(%a: Long, %b: Long): Long {
    {
        %n = not %a: Long
        %r = and %n, %b: Long
        ret %r
    }
}

# The complement is read twice, so it stays and so does the `and`.
andNotKept(%a: Int, %b: Int): Int {
    {
        %n = not %a: Int
        %r = and %n, %b: Int
        %s = add %r, %n: Int
        ret %s
    }
}

# The lowest set bit cleared - the step a loop over the set bits of a word takes.
clearLowest(%x: Int): Int {
    {
        %d = sub %x, 1: Int
        %r = and %x, %d: Int
        ret %r
    }
}

clearLowest64(%x: Long): Long {
    {
        %d = sub %x, 1L: Long
        %r = and %x, %d: Long
        ret %r
    }
}

# The lowest set bit alone, as a mask.
isolateLowest(%x: Int): Int {
    {
        %n = neg %x: Int
        %r = and %x, %n: Int
        ret %r
    }
}

# The same written as a subtraction from zero, which is how a source program spells it.
isolateLowestFromZero(%x: Int): Int {
    {
        %z = sub 0, %x: Int
        %r = and %z, %x: Int
        ret %r
    }
}

# Every bit below the lowest set one, and that one.
maskThroughLowest(%x: Int): Int {
    {
        %d = sub %x, 1: Int
        %r = xor %x, %d: Int
        ret %r
    }
}

# The variable shifts. The count is an argument, so the legacy form would pin it in cl.
shiftVariable(%x: Int, %n: Int): Int {
    {
        %r = shl %x, %n: Int
        ret %r
    }
}

shiftRightVariable(%x: Int, %n: Int): Int {
    {
        %r = shr %x, %n: Int
        ret %r
    }
}

shiftArithmeticVariable(%x: Long, %n: Long): Long {
    {
        %r = sar %x, %n: Long
        ret %r
    }
}

# An immediate shift keeps its legacy form: there is no `shlx r, r/m, imm` at any level.
shiftImmediate(%x: Int): Int {
    {
        %r = shl %x, 5: Int
        ret %r
    }
}

# The immediate rotation, which is the one BMI2 shift that takes an immediate.
rotateRight(%x: Int): Int {
    {
        %r = ror %x, 7: Int
        ret %r
    }
}

rotateLeft(%x: Int): Int {
    {
        %r = rol %x, 7: Int
        ret %r
    }
}

rotateRight64(%x: Long): Long {
    {
        %r = ror %x, 7: Long
        ret %r
    }
}

# A rotation by one keeps `ror r/m, 1`, which is two bytes against `rorx`'s six.
rotateByOne(%x: Int): Int {
    {
        %r = ror %x, 1: Int
        ret %r
    }
}

# The top half of an unsigned product, which is what a division by a constant turns into.
highProduct(%a: Int, %b: Int): Int {
    {
        %r = mulhi %a, %b: Int
        ret %r
    }
}

highProduct64(%a: Long, %b: Long): Long {
    {
        %r = mulhi %a, %b: Long
        ret %r
    }
}

# The signed one has no BMI2 spelling - `mulx` is unsigned and there is no `imulx` - so this is the
# group-3 `imul` at every level.
highProductSigned(%a: Int, %b: Int): Int {
    {
        %r = imulhi %a, %b: Int
        ret %r
    }
}

# The r/m side of the forms, which all four of the rewrites have: an operand that came out of memory
# is read there rather than loaded first.
andNotLoaded(%a: Int, %p: Ptr): Int {
    {
        %v = load %p, 4: Int
        %n = not %a: Int
        %r = and %n, %v: Int
        ret %r
    }
}

# A load feeding one of the lowest-bit operations, which is the fold the *rewrite* creates rather
# than preserves: the pair read `x` twice, so the load had two readers and could not be folded, and
# `blsr` reads it once.
clearLowestLoaded(%p: Ptr): Int {
    {
        %v = load %p, 4: Int
        %d = sub %v, 1: Int
        %r = and %v, %d: Int
        ret %r
    }
}

# The subject is read again afterwards, which is the case `rorx` exists for and the shape every
# hash-mixing loop has: `ror r/m, imm` writes through the operand it reads, so the legacy form needs
# a copy in front of it and this one does not. BitOps.lower beside this file is the same function
# with that copy.
rotateAndKeep(%x: Int): Int {
    {
        %r = ror %x, 3: Int
        %t = xor %r, %x: Int
        ret %t
    }
}

# The subject in a frame slot, which is the one encoding in this backend whose trailing immediate is
# written after a displacement rather than after a ModRM byte alone. The call is what puts it there:
# everything live across one is either callee-saved or spilled, and this backend spills.
rotateSpilled(%x: Int, %a: Int, %b: Int, %c: Int, %d: Int, %e: Int): Int {
    {
        %v0 = call_complex rotateAndKeep, %a: Int
        %v1 = call_complex rotateAndKeep, %b: Int
        %v2 = call_complex rotateAndKeep, %c: Int
        %v3 = call_complex rotateAndKeep, %d: Int
        %v4 = call_complex rotateAndKeep, %e: Int
        %v5 = call_complex rotateAndKeep, %v0: Int
        %v6 = call_complex rotateAndKeep, %v1: Int
        %v7 = call_complex rotateAndKeep, %v2: Int
        %r = ror %x, 7: Int
        %s0 = add %v0, %v1: Int
        %s1 = add %s0, %v2: Int
        %s2 = add %s1, %v3: Int
        %s3 = add %s2, %v4: Int
        %s4 = add %s3, %v5: Int
        %s5 = add %s4, %v6: Int
        %s6 = add %s5, %v7: Int
        %t = add %r, %s6: Int
        ret %t
    }
}

# `!a && b` over two truth values, which is the spelling the *language* emits rather than the one
# `andNot` above is written in. `Bitwise(Bool).not` is `xor c, 1` and not a `not` - complementing the
# storage of a one-bit value gives something that is not a `Bool`, which is the ruling in
# resolve/core.cpp - so `!a && b` reaches this backend as `(a xor 1) and b`.
#
# `x ^ 1` is not `~x`: they agree in bit 0 and differ in every bit above it. What licenses the `andn`
# is therefore not the complement at all but the operand it is read against - `b` is a comparison, so
# the bits the two spellings disagree about are zero in it and discarded either way.
andNotBoolean(%x: Int, %y: Int): Int {
    {
        %a = cmp_igt %x, 0: Int
        %b = cmp_igt %y, 0: Int
        %n = xor %a, 1: Int
        %r = and %n, %b: Int
        ret %r
    }
}

# The same complement read against a value that is *not* a truth value, which is **not** `andn` - the
# bits `x ^ 1` and `~x` disagree about survive here, so the two are different numbers. This is the
# control for the pair above, and the reason `complementedOperand` takes the other operand at all.
andNotBooleanWidened(%x: Int, %y: Int): Int {
    {
        %a = cmp_igt %x, 0: Int
        %n = xor %a, 1: Int
        %r = and %n, %y: Int
        ret %r
    }
}
