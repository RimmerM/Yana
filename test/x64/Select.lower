# Operand order is `select <condition>, <lhs>, <rhs>`, and the result is `condition ? lhs : rhs`.
# The emitted code keeps lhs in the result register and conditionally moves rhs over it, so the
# CMOV carries the negated condition code.
#
# Flags-producing comparisons: `merged` has nothing between the cmp and its use, so tryMergeCompare
# folds it into the select's condition code.

merged(%v: I32, %a: I32, %b: I32): I32 {
    {
        %cmp = cmp_eq %v, 1
        %r = select %cmp, %a, %b: I32
        ret %r
    }
}

# The clobber between the comparison and the select does not have to be there: nothing it reads is
# defined below the comparison, so it is lifted above it - taking the immediate it reads, which is
# an instruction of its own, along with it - and the comparison merges after all.
hoisted(%v: I32, %a: I32, %b: I32): I32 {
    {
        %cmp = cmp_ilt %v, 0
        %x = add %a, 1: I32
        %r = select %cmp, %x, %b: I32
        ret %r
    }
}

# `select %c, %v, 0` is the shape the zero peephole used to cost a factor of two on: the zero is
# materialized as `xor r, r` between the comparison and the select that reads it. Here it goes above
# the comparison and the select becomes a CMOV on the flags.
zeroArm(%p: Ptr, %t: I64): I64 {
    {
        %v = load %p, 8: I64
        %c = cmp_igt %v, %t
        %r = select %c, %v, 0L: I64
        ret %r
    }
}

# The same lift, over a comparison that reads its own operand out of memory.
#
# `%addr` becomes an `x86_addr` folded into the comparison, and an `x86_addr` emits nothing: it is
# resolved one instruction in front of the access, so the registers it names are live across exactly
# that gap. Landing the lifted `add` in the gap - which is what "directly above the comparison" used
# to mean - puts a *definition* there, and since nothing reads the address value between the two, the
# allocator sees the base as dead at the `x86_addr` and is free to hand the add's result the very
# register it was computed into. The comparison then reads through whatever the add produced.
# `flagsHoistTarget` is what puts the lift above the address instead; `checkFoldedAddress` in
# verify.cpp is what caught it, and without the fix this function trips that assertion rather than
# printing a different golden.
#
# The base arrives from a **call** rather than as an argument, and that is what makes the collision
# happen rather than merely be possible: a call result is in rax, `%n` is tied to `%r` which is
# returned in rax, and everything else is pushed into callee-saved registers by the call. An argument
# would have coalesced into its own incoming register and the two would never have met.
#
# `groupSize` in the library's `Agree` suite is where this arrived from - a counted loop over a
# bounds-checked subscript, whose `size + 1` is the instruction that gets lifted.
provider<complex>(%p: Ptr): Ptr {
    { ret %p }
}

hoistedOverAddress(%pp: Ptr, %i: I64, %of: I64, %acc: I64): I64 {
    {
        %base = call_complex provider, %pp: Ptr
        %sh = shl %i, 3: I64
        %addr = add %base, %sh: Ptr
        %v = load %addr, 8: I64
        %c = cmp_eq %v, %of
        %n = add %acc, 1L: I64
        %r = select %c, %n, %acc: I64
        ret %r
    }
}

# And where the clobber genuinely cannot move, the comparison still goes to a register: the add
# reads a load, and a load's position is not free to change.
materialized(%v: I32, %p: Ptr, %b: I32): I32 {
    {
        %cmp = cmp_ilt %v, 0
        %l = load %p, 4: I32
        %x = add %l, 1: I32
        %r = select %cmp, %x, %b: I32
        ret %r
    }
}

crossBlock(%v: I32, %a: I32, %b: I32): I32 {
    start {
        %cmp = cmp_ige %v, 10
        jmp next
    }

    next {
        %r = select %cmp, %a, %b: I32
        ret %r
    }
}

# A pointer is a value a select can hold, and it is the same CMOV at the other width: `mapMemory`
# answers zero on a failed `mmap` and the region otherwise, which is one `cmovs` where it used to be
# a branch, two blocks and a phi. The REX.W is the whole difference from `merged` above - a pointer
# is 64 bits, so the operand size is the one an `I32` select does not take.
#
# What this fixture is really pinning is that a pointer *reaches* here at all: opt_select.cpp's
# `selectableType` admits `Ptr` and `Borrow` and still declines a record, whose value is the address
# of its storage rather than a value, so nothing above builds one of those for this to encode.
pointerArm(%raw: I64, %p: Ptr): Ptr {
    {
        %c = cmp_ilt %raw, 0L
        %zero = bitcast 0L: Ptr
        %r = select %c, %zero, %p: Ptr
        ret %r
    }
}
