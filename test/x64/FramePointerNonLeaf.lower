# frame-pointer: non-leaf
#
# The same functions as FramePointerAll.lower under `non-leaf`: rbp only where a stack walk could
# continue past this frame, so the two leaves pay nothing and the two callers pay for the chain.

leafNoFrame(%a: I32, %b: I32): I32 {
    {
        %s = add %a, %b: I32
        ret %s
    }
}

leafWithLocal(%v: I32): I32 {
    {
        %a = alloca 8: Ptr
        store %a, %v, 8
        %r = load %a, 8: I32
        ret %r
    }
}

callerNoFrame(%a: I32, %b: I32): I32 {
    {
        %r = call_complex leafNoFrame, %a, %b: I32
        %s = add %r, %b: I32
        ret %s
    }
}

callerWithLocal(%v: I32): I32 {
    {
        %a = alloca 8: Ptr
        store %a, %v, 8
        %r = call_complex leafNoFrame, %v, %v: I32
        %s = load %a, 8: I32
        %t = add %r, %s: I32
        ret %t
    }
}
