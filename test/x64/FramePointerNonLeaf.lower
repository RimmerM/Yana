# frame-pointer: non-leaf
#
# The same functions as FramePointerAll.lower under `non-leaf`: rbp only where a stack walk could
# continue past this frame, so the two leaves pay nothing and the two callers pay for the chain.

leafNoFrame(%a: Int, %b: Int): Int {
    {
        %s = add %a, %b: Int
        ret %s
    }
}

leafWithLocal(%v: Int): Int {
    {
        %a = alloca 8: Ptr
        store %a, %v, 8
        %r = load %a, 8: Int
        ret %r
    }
}

callerNoFrame(%a: Int, %b: Int): Int {
    {
        %r = call_complex leafNoFrame, %a, %b: Int
        %s = add %r, %b: Int
        ret %s
    }
}

callerWithLocal(%v: Int): Int {
    {
        %a = alloca 8: Ptr
        store %a, %v, 8
        %r = call_complex leafNoFrame, %v, %v: Int
        %s = load %a, 8: Int
        %t = add %r, %s: Int
        ret %t
    }
}
