# Vector spilling, reloading and cycle breaking.
#
# The vector bank has its own sixteen registers, its own scratch reserve and its own spill slots -
# and it runs out independently of the general bank, which is the point of the reserve being per
# bank rather than one pool. A spilled scalar float takes a slot of its own width rather than of the
# register's, so a Float takes four bytes and a Double eight.
#
# It also differs in one thing the general bank does not have to think about: there is no XCHG for a
# vector register, so a copy cycle cannot be broken in place and has to go through a scratch one.

# Seventeen live doubles against sixteen registers, summed in the reverse of the order they were
# computed so that none of them can die early. Some end up in the frame, and each is brought back
# into a scratch register - or read straight out of the slot, where addsd's memory form applies.
manyLive(%a: Double, %b: Double): Double {
    {
        %v0 = add %a, %b: Double
        %v1 = mul %a, %v0: Double
        %v2 = mul %a, %v1: Double
        %v3 = mul %a, %v2: Double
        %v4 = mul %a, %v3: Double
        %v5 = mul %a, %v4: Double
        %v6 = mul %a, %v5: Double
        %v7 = mul %a, %v6: Double
        %v8 = mul %a, %v7: Double
        %v9 = mul %a, %v8: Double
        %v10 = mul %a, %v9: Double
        %v11 = mul %a, %v10: Double
        %v12 = mul %a, %v11: Double
        %v13 = mul %a, %v12: Double
        %v14 = mul %a, %v13: Double
        %v15 = mul %a, %v14: Double
        %v16 = mul %a, %v15: Double

        %s16 = add %v16, %v15: Double
        %s15 = add %s16, %v14: Double
        %s14 = add %s15, %v13: Double
        %s13 = add %s14, %v12: Double
        %s12 = add %s13, %v11: Double
        %s11 = add %s12, %v10: Double
        %s10 = add %s11, %v9: Double
        %s9 = add %s10, %v8: Double
        %s8 = add %s9, %v7: Double
        %s7 = add %s8, %v6: Double
        %s6 = add %s7, %v5: Double
        %s5 = add %s6, %v4: Double
        %s4 = add %s5, %v3: Double
        %s3 = add %s4, %v2: Double
        %s2 = add %s3, %v1: Double
        %s1 = add %s2, %v0: Double
        ret %s1
    }
}

# The same in the narrower class. A scalar float spills at its own width rather than at its
# register's, so the slots here are four bytes and the traffic is movss - which is the whole reason
# the two scalar views are classes of their own.
manyLive32(%a: Float, %b: Float): Float {
    {
        %v0 = add %a, %b: Float
        %v1 = mul %a, %v0: Float
        %v2 = mul %a, %v1: Float
        %v3 = mul %a, %v2: Float
        %v4 = mul %a, %v3: Float
        %v5 = mul %a, %v4: Float
        %v6 = mul %a, %v5: Float
        %v7 = mul %a, %v6: Float
        %v8 = mul %a, %v7: Float
        %v9 = mul %a, %v8: Float
        %v10 = mul %a, %v9: Float
        %v11 = mul %a, %v10: Float
        %v12 = mul %a, %v11: Float
        %v13 = mul %a, %v12: Float
        %v14 = mul %a, %v13: Float
        %v15 = mul %a, %v14: Float
        %v16 = mul %a, %v15: Float

        %s16 = add %v16, %v15: Float
        %s15 = add %s16, %v14: Float
        %s14 = add %s15, %v13: Float
        %s13 = add %s14, %v12: Float
        %s12 = add %s13, %v11: Float
        %s11 = add %s12, %v10: Float
        %s10 = add %s11, %v9: Float
        %s9 = add %s10, %v8: Float
        %s8 = add %s9, %v7: Float
        %s7 = add %s8, %v6: Float
        %s6 = add %s7, %v5: Float
        %s5 = add %s6, %v4: Float
        %s4 = add %s5, %v3: Float
        %s3 = add %s4, %v2: Float
        %s2 = add %s3, %v1: Float
        %s1 = add %s2, %v0: Float
        ret %s1
    }
}

# Both widths at once, which share the register file and so share the pressure: a function running
# out of vector registers does so whatever mix of the two put it there.
mixedWidth(%a: Float, %b: Double): Double {
    {
        %f0 = mul %a, %a: Float
        %f1 = mul %a, %f0: Float
        %f2 = mul %a, %f1: Float
        %f3 = mul %a, %f2: Float
        %f4 = mul %a, %f3: Float
        %f5 = mul %a, %f4: Float
        %f6 = mul %a, %f5: Float
        %f7 = mul %a, %f6: Float
        %f8 = mul %a, %f7: Float

        %d0 = mul %b, %b: Double
        %d1 = mul %b, %d0: Double
        %d2 = mul %b, %d1: Double
        %d3 = mul %b, %d2: Double
        %d4 = mul %b, %d3: Double
        %d5 = mul %b, %d4: Double
        %d6 = mul %b, %d5: Double
        %d7 = mul %b, %d6: Double
        %d8 = mul %b, %d7: Double

        %g8 = add %f8, %f7: Float
        %g7 = add %g8, %f6: Float
        %g6 = add %g7, %f5: Float
        %g5 = add %g6, %f4: Float
        %g4 = add %g5, %f3: Float
        %g3 = add %g4, %f2: Float
        %g2 = add %g3, %f1: Float
        %g1 = add %g2, %f0: Float

        %e8 = add %d8, %d7: Double
        %e7 = add %e8, %d6: Double
        %e6 = add %e7, %d5: Double
        %e5 = add %e6, %d4: Double
        %e4 = add %e5, %d3: Double
        %e3 = add %e4, %d2: Double
        %e2 = add %e3, %d1: Double
        %e1 = add %e2, %d0: Double

        %w = cast %g1: Double
        %r = add %w, %e1: Double
        ret %r
    }
}

# Two phis that feed each other across the back edge, which is the integer `swap` in Phi.lower one
# bank over. The copies at the latch are a permutation with no fixed point, and there they are one
# XCHG - but the vector file has no exchange instruction at all, so the cycle has to be broken by
# parking one end in a scratch register out of the move pool. That is the whole reason the reserve
# is per bank rather than one set of registers shared between them.
cycle(%x: Double, %y: Double, %n: Int): Double {
  start {
        jmp head
    }
  head {
        %a = phi [start, %x], [head, %b]: Double
        %b = phi [start, %y], [head, %a]: Double
        %i = phi [start, %n], [head, %i2]: Int
        %i2 = sub %i, 1: Int
        je (cmp_eq %i, 0), done, head
    }
  done {
        %r = sub %a, %b: Double
        ret %r
    }
}

# A loop carrying two doubles through destructive arithmetic. The phi that takes its value from a
# tied result cannot be coalesced with the other operand of that same instruction - see `tiedSwap`
# in Phi.lower - so the copies stay and the two values change places each iteration.
swap(%x: Double, %y: Double, %n: Int): Double {
  start {
        jmp head
    }
  head {
        %a = phi [start, %x], [body, %b2]: Double
        %b = phi [start, %y], [body, %a2]: Double
        %i = phi [start, %n], [body, %i2]: Int
        je (cmp_eq %i, 0), done, body
    }
  body {
        %a2 = add %a, %b: Double
        %b2 = mul %b, %a: Double
        %i2 = sub %i, 1: Int
        jmp head
    }
  done {
        %r = sub %a, %b: Double
        ret %r
    }
}
