
loop<complex>(%count: Int, %add: Int): Int {
  start {
    %v = cast 0: Int
    jmp head
  }

  head {
    %v1 = phi [start, %v], [loop, %v2]: Int
    %count1 = phi [start, %count], [loop, %count2]: Int
    %v_0 = cmp_le %count1, 0: Int
    je %v_0, loop, end
  }

  loop {
    %count2 = sub %count1, 1: Int
    %v2 = add %v1, %add: Int
    jmp head
  }

  end {
    ret %v1
  }
}


