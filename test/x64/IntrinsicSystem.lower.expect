
fences<complex>() {
  b_0 {
    mfence 
    lfence 
    sfence 
    pause 
    ret 
  }
}

interrupts<complex>(%x: I32, %y: I32): I32 {
  start {
    %c = cmp_ilt %x, %y: I32
    cli 
    swapgs 
    je %c, less, more
  }

  less {
    sti 
    ret %x
  }

  more {
    hlt 
    ret %y
  }
}

cacheOps<complex>(%p: Ptr, %i: I64) {
