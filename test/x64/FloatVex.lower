# The scalar float set again, written with a VEX prefix.
#
# extensions: v3
#
# The same functions as Float.lower and FloatMemory.lower, so the two goldens read side by side and
# every difference between them is the encoding and what it makes possible. Three things to look for:
#
#   - the arithmetic is three-operand, so the `movaps` that stood in front of every operation whose
#     result outlives one of its sources is gone. That is the reason these forms exist; the prefix
#     being one byte shorter is incidental.
#   - a two-byte prefix (c5) wherever the operands are in the low eight registers and the width is in
#     the prefix, and a three-byte one (c4) where a register number needs the extra bits.
#   - the operations with no tie to drop - the comparisons and the transfers - differ from their
#     legacy spelling in the prefix alone.
#
# What is deliberately unchanged is everything with no VEX form: the conversions, the general
# constant materialization and the select still write legacy SSE, which costs nothing while no
# instruction here leaves a dirty upper half of a ymm register.
#
# The one constant that is *not* left alone is positive zero. It is materialized rather than pooled -
# `xorps xmm, xmm` is two bytes where a load is eight - so unlike every other constant here it is an
# instruction that writes a vector register, and the rule those follow is this file's subject: a
# legacy write leaves the upper half alone, and which instructions it stands between is a property of
# the schedule rather than of the constant. See `zero` below.

arith64(%a: Double, %b: Double): Double {
    {
        %s = add %a, %b: Double
        %d = sub %s, %b: Double
        %m = mul %d, %a: Double
        %q = div %m, %b: Double
        ret %q
    }
}

arith32(%a: Float, %b: Float): Float {
    {
        %s = add %a, %b: Float
        %d = sub %s, %b: Float
        %m = mul %d, %a: Float
        %q = div %m, %b: Float
        ret %q
    }
}

# Every source read twice, so that no operand can be written over and the three-operand form is what
# keeps this to four instructions. Under the legacy forms each of these carries a copy.
noReuse(%a: Double, %b: Double): Double {
    {
        %s = add %a, %b: Double
        %d = sub %a, %b: Double
        %m = mul %s, %d: Double
        %q = div %m, %a: Double
        ret %q
    }
}

# The three-byte prefix: the operand the allocator put in one of the upper eight registers cannot be
# named by the two-byte form, which has no B bit.
manyLive(%a: Double, %b: Double, %c: Double, %d: Double, %e: Double, %f: Double, %g: Double, %h: Double, %i: Double, %j: Double): Double {
    {
        %ab = add %a, %b: Double
        %cd = add %c, %d: Double
        %ef = add %e, %f: Double
        %gh = add %g, %h: Double
        %ij = add %i, %j: Double
        %x = mul %ab, %cd: Double
        %y = mul %ef, %gh: Double
        %z = mul %x, %y: Double
        %r = div %z, %ij: Double
        ret %r
    }
}

# Negation, which is the pseudo that also loses its tie: `vxorps xmm, xmm, [rip + signmask]` names
# its source separately where `xorps` toggled the bit in the destination.
negate(%a: Double, %b: Float): Double {
    {
        %n = neg %a: Double
        %m = neg %b: Float
        %w = cast %m: Double
        %r = add %n, %w: Double
        ret %r
    }
}

# And the same negation with its operand still live afterwards, which is the case that says *which
# field* holds the destination. Every source above is consumed by the negation that reads it, so the
# allocator gives the pseudo its operand's register and a twin naming the destination in vvvv writes
# the same bytes as one naming the source there. Here it cannot: `%a` and `%b` are read again, so
# `vxorpd` names one register in vvvv and another in ModRM.reg. See §70.2 of test/bench/findings.md,
# which is what those bytes were wrong about.
negateLive(%a: Double, %b: Float): Double {
    {
        %n = neg %a: Double
        %m = neg %b: Float
        %w = cast %m: Double
        %s = add %n, %w: Double
        %t = add %s, %a: Double
        %u = cast %b: Double
        %r = add %t, %u: Double
        ret %r
    }
}

# Positive zero at both widths, which is the one constant with an encoding of its own: `vxorps`
# rather than `xorps`, with the source named in vvvv because the prefix no longer implies it. Added
# to and multiplied by an argument so that neither is folded away and both survive to be emitted.
zero(%a: Double, %b: Float): Double {
    {
        %z = add %a, 0.0: Double
        %y = mul %b, 0.0F: Float
        %w = cast %y: Double
        %r = add %z, %w: Double
        ret %r
    }
}

# The comparisons, which have nothing to drop: `vucomisd` is `ucomisd` with a different prefix.
compare(%a: Double, %b: Double): Int {
    {
        %c = cmp_gt %a, %b: Int
        je %c, then, else
    }
  then {
        ret 1
    }
  else {
        ret 0
    }
}

compareValue(%a: Float, %b: Float): Int {
    {
        %c = cmp_lt %a, %b: Int
        %d = add %c, %c: Int
        ret %d
    }
}

# A load folded into the operation that reads it, which is the memory twin of a VEX form: three
# operands and an address in the r/m field at once.
loadFold(%p: Ptr, %a: Double): Double {
    {
        %v = load %p, 8: Double
        %s = add %a, %v: Double
        %w = load %p, 8: Double
        %m = mul %s, %w: Double
        ret %m
    }
}

# And the transfers on their own, where the address is the whole instruction.
transfer(%p: Ptr, %q: Ptr): Float {
    {
        %v = load %p, 4: Float
        store %q, %v, 4
        ret %v
    }
}
