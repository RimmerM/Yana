lookup32x8(%table: i32x8, %indices: i32x8): i32x8 {
    {
        %r = vlookup %table, %indices: i32x8
        ret %r
    }
}

compress64x4(%v: i64x4, %k: i64x4): i64x4 {
    {
        %m = cmp_neq %k, %v: m64x4
        %r = vcompress %v, %m: i64x4
        ret %r
    }
}

expand64x4(%v: i64x4, %k: i64x4): i64x4 {
    {
        %m = cmp_neq %k, %v: m64x4
        %r = vexpand %v, %m: i64x4
