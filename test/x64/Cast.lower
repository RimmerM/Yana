widen(%v: I32): I64 {
    {
        %z = cast %v: I64
        %s = sext %v: I64
        %t = add %z, %s: I64
        ret %t
    }
}

narrowCast(%v: I64): I32 {
    {
        %n = cast %v: I32
        ret %n
    }
}

bitcasts(%v: I64, %p: Ptr): I64 {
    {
        %a = bitcast %v: Ptr
        %b = bitcast %p: I64
        %c = bitcast %b: I64
        %d = add %b, %c: I64
        ret %d
    }
}

immCast(): I64 {
    {
        %big = cast 4294967296L: I64
        %neg = cast -1: I64
        %t = add %big, %neg: I64
        ret %t
    }
}

# The extend-skipping peephole, which is why the four functions below exist in pairs: each is a cast
# the allocator will put in one register, and what differs between the two halves is whether the
# upper half of that register was already clear.

# It was. An addition at I32 wrote a 32-bit destination, which clears bits 32-63 of it, so the
# widening has nothing left to do and emits nothing at all. `%w` widens the sum and `%c` narrows it
# straight back, and neither is an instruction.
skipComputed(%a: I32, %b: I32): I64 {
    {
        %s = add %a, %b: I32
        %w = cast %s: I64
        %c = cast %w: I32
        %r = cast %c: I64
        ret %r
    }
}

# It was not. An argument arrives in a register the System V convention says nothing about above bit
# 31, so this is the zero-extension it looks like and stays.
keepArgument(%v: I32): I64 {
    {
        %w = cast %v: I64
        ret %w
    }
}

identity(%x: I32): I32 {
    { ret %x }
}

# Nor was it for a value that came back from a call. The return register's upper half is the callee's
# business and no convention here declares it clear, so this widening stands too.
keepCallResult(%a: I32): I64 {
    {
        %r = call_complex identity, %a: I32
        %w = cast %r: I64
        ret %w
    }
}

# A cast between two 64-bit types moves at 64 bits whatever either end calls itself, so it is a copy
# before anything is proved about its source - `mov rax, rax`, which was 3 bytes of nothing.
skipWide(%a: I64, %b: I64): I64 {
    {
        %s = add %a, %b: I64
        %c = cast %s: I64
        %r = add %c, %b: I64
        ret %r
    }
}

# The same question asked of a 64-bit operation, which is where a container's capacity arithmetic
# lives. A mask cannot set a bit neither operand has, and a logical shift only moves bits down, so
# both leave a register with nothing above bit 31 and the narrowing has nothing to clear.
#
# `sar` fills from the sign bit instead and answers no - but the third narrowing is elided all the
# same, by the *forwards* rule rather than this one: every reader of it here is a 32-bit `add`, so
# what is above bit 31 is never looked at whatever the shift left there. This said the third one
# stays, which the golden beside it has never agreed with. `keepArithmeticShift` in UpperHalf.lower
# is the control that actually holds `sar` to the backwards rule, by widening the result instead.
skipMasked(%p: Ptr): I32 {
    {
        %h = load %p, 8: I64
        %m = and %h, 1073741823L: I64
        %mn = cast %m: I32
        %s = shr %h, 40L: I64
        %sn = cast %s: I32
        %a = sar %h, 40L: I64
        %an = cast %a: I32
        %r = add %mn, %sn: I32
        %r2 = add %r, %an: I32
        ret %r2
    }
}

# The two loads either side of the rule. A byte lands in a register the `movzx` filled, so widening
# it is free; a signed four-byte load is `movsxd`, which is the one load that carries a bit upwards,
# so narrowing it back has to clear what the sign extension wrote.
loadWidths(%p: Ptr): I64 {
    {
        %b = load %p, 1: I32
        %bw = cast %b: I64
        %s = loads %p, 4: I64
        %sn = cast %s: I32
        %sw = cast %sn: I64
        %r = add %bw, %sw: I64
        ret %r
    }
}
