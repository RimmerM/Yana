  }
}

joined<complex>(%a: i8x16, %b: i8x16, %c: i8x16): Int {
  start {
    %m = cmp_eq %a, %b: m8x16
    %any = vreduce_or %m: Int
    je %any, hit, tail
  }

  tail {
