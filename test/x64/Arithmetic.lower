arith(%a: I32, %b: I32): I32 {
    {
        %s1 = add %a, %b: I32
        %s2 = add %a, 1: I32
        %d1 = sub %a, %b: I32
        %d2 = sub %a, 1: I32
        %n1 = and %a, %b: I32
        %o1 = or %a, %b: I32
        %x1 = xor %a, %b: I32
        %g1 = neg %a: I32
        %t1 = not %a: I32
        ret %s1
    }
}
