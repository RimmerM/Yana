arith(%a: Int, %b: Int): Int {
    {
        %s1 = add %a, %b: Int
        %s2 = add %a, 1: Int
        %d1 = sub %a, %b: Int
        %d2 = sub %a, 1: Int
        %n1 = and %a, %b: Int
        %o1 = or %a, %b: Int
        %x1 = xor %a, %b: Int
        %g1 = neg %a: Int
        %t1 = not %a: Int
        ret %s1
    }
}
