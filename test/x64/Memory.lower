# `mut`, because `globalStoreImm` below writes it. Without the keyword the backend is entitled to
# fold a load of it into its reader and to rematerialize one rather than spill it, which would be a
# read moved across the store - see LowerGlobal::mut and validateGlobalWrites.
mut @g = 42

loadStore(%p: Ptr, %v: I32): I32 {
    {
        store %p, %v, 4
        %l = load %p, 4: I32
        %w = add %l, %v: I32
        ret %w
    }
}

narrow(%p: Ptr, %v: I32): I32 {
    {
        store %p, %v, 1
        store %p, %v, 2
        store %p, %v, 8
        %b = load %p, 1: I32
        %h = loads %p, 2: I32
        %q = load %p, 8: I64
        %s = loads %p, 4: I64
        %t = add %q, %s: I64
        %c = cast %t: I32
        %r = add %b, %h: I32
        %r2 = add %r, %c: I32
        ret %r2
    }
}

globalLoad(): I32 {
    {
        %gp = global @g
        %gv = load %gp, 4: I32
        ret %gv
    }
}

# A global written with a constant, which is the one RIP-relative access whose displacement is not
# the last thing in the instruction: the immediate follows it, and the processor measures the
# displacement from the end of the instruction. See AsmRelocation::trailing - without it the store
# lands four bytes past @g, which is silent.
globalStoreImm() {
    {
        %gp = global @g
        store %gp, 7, 4
        ret
    }
}

# The same address wanted as a number rather than as a place, which is what keeps the `lea`: a
# pointer handed to a call has to be in a register, so the whole use is declined rather than the one
# position - the value is either implicit or it is not.
globalEscapes(%v: I32): I32 {
    {
        %gp = global @g
        %r = call_complex loadStore, %gp, %v: I32
        ret %r
    }
}

blockOps(%dst: Ptr, %src: Ptr) {
    {
        copy %dst, %src, 12
        setpattern %dst, 6, 0
        ret
    }
}

# A count that isn't an immediate can't be unrolled, so these take the `rep movsb`/`rep stosb`
# encodings instead, which read their operands from fixed registers.
blockOpsDynamic(%dst: Ptr, %src: Ptr, %n: I32, %pat: I32) {
    {
        copy %dst, %src, %n
        setpattern %dst, %n, %pat
        ret
    }
}
