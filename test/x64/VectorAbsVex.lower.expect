    ret %r
  }
}

absTwice<complex>(%a: f32x4, %b: f32x4): f32x4 {
  b_0 {
    %x = abs %a: f32x4
    %y = abs %b: f32x4
    %r = add %x, %y: f32x4
    ret %r
  }
}

absBoth<complex>(%a: f32x4, %b: f64x2): f32x4 {
  b_0 {
    %x = abs %a: f32x4
    %y = abs %b: f64x2
    %w = bitcast %y: f32x4
    %r = add %x, %w: f32x4
    ret %r
  }
}

absInt<complex>(%b: i8x16, %w: i16x8, %d: i32x4): i32x4 {
  b_0 {
    %rb = abs %b: i8x16
    %rw = abs %w: i16x8
    %rd = abs %d: i32x4
    %cb = bitcast %rb: i32x4
    %cw = bitcast %rw: i32x4
    %s = add %cb, %cw: i32x4
    %r = add %s, %rd: i32x4
    ret %r
  }
}

absNonDestructive<complex>(%d: i32x4): i32x4 {
  b_0 {
    %a = abs %d: i32x4
    %r = add %a, %d: i32x4
    ret %r
  }
}

absLoadFold<complex>(%p: Ptr): f32x4 {
  b_0 {
    %v = load %p, 16: f32x4
    %r = abs %v: f32x4
    ret %r
  }
}

absLoop<complex>(%p: Ptr, %n: Int): f32x4 {
  start {
    %init = vsplat 0: f32x4
    %zero = cast 0: Int
    jmp head
  }

  head {
    %i = phi [start, %zero], [body, %next]: Int
    %acc = phi [start, %init], [body, %sum]: f32x4
    %v_0 = cmp_ilt %i, %n: Int
    je %v_0, body, end
  }

  body {
    %off = mul %i, 16: Int
    %at = add %p, %off: Ptr
    %v = load %at, 16: f32x4
    %m = abs %v: f32x4
    %sum = add %acc, %m: f32x4
    %next = add %i, 1: Int
    jmp head
  }

  end {
    ret %acc
  }
}


