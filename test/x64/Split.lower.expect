coldCallInLoop<complex>(%n: Int, %p: Ptr, %q: Ptr): Long {
  entry {
    %zero = cast 0: Long
    jmp head
  }

  head {
    %i = phi [entry, %zero], [rejoin, %i2]: Long
    %acc = phi [entry, %zero], [rejoin, %acc2]: Long
    je %n, exit, hot
  }

  hot {
    %a1 = load %p, 8: Long
    %b1 = load %q, 8: Long
    %s1 = add %a1, %b1: Long
    %a2 = load %p, 8: Long
    %s2 = add %s1, %a2: Long
    %b2 = load %q, 8: Long
    %s3 = add %s2, %b2: Long
    je %i, [rejoin, 999], [cold, 1]
  }

  cold {
    %r = call_clobber sink, %n: Int
    jmp rejoin
  }

  rejoin {
    %acc2 = add %acc, %s3: Long
    %i2 = add %i, 1: Long
    jmp head
  }

  exit {
    ret %acc
  }
}

