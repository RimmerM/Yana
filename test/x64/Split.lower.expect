    %s5 = add %s4, %b3: I64
    %acc2 = add %acc, %s5: I64
    %i2 = add %i, 1: I64
    jmp head
  }

  exit {
    ret %acc
  }
}

coldCallInLoop<complex>(%n: I32, %p: Ptr, %q: Ptr): I64 {
  entry {
    %zero = cast 0: I64
    jmp head
  }

  head {
    %i = phi [entry, %zero], [rejoin, %i2]: I64
    %acc = phi [entry, %zero], [rejoin, %acc2]: I64
