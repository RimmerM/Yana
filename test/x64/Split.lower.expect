loopWithCall<complex>(%n: I32, %p: Ptr, %q: Ptr): I64 {
  entry {
    %zero = cast 0: I64
    jmp head
  }

  head {
    %i = phi [entry, %zero], [body, %i2]: I64
    %acc = phi [entry, %zero], [body, %acc2]: I64
    je %n, exit, body
  }

