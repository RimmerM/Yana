  }
}

coldCallInLoop<complex>(%n: I32, %p: Ptr, %q: Ptr): I64 {
  entry {
    %zero = cast 0: I64
    jmp head
  }

  head {
    %i = phi [entry, %zero], [rejoin, %i2]: I64
