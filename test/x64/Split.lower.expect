    %b1 = load %q, 8: I64
    %s1 = add %a1, %b1: I64
    %a2 = load %p, 8: I64
    %s2 = add %s1, %a2: I64
    %b2 = load %q, 8: I64
    %s3 = add %s2, %b2: I64
    je %i, [rejoin, 999], [cold, 1]
  }

  cold {
    %r = call_clobber sink, %n: I32
    jmp rejoin
  }

  rejoin {
    %acc2 = add %acc, %s3: I64
    %i2 = add %i, 1: I64
    jmp head
  }

  exit {
    ret %acc
  }
}


