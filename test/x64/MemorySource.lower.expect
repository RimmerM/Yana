sumArray<sysv>(%p: Ptr, %n: Long): Long {
  entry {
    %zero = cast 0: Long
    jmp head
  }

  head {
    %i = phi [entry, %zero], [body, %i2]: Long
    %acc = phi [entry, %zero], [body, %acc2]: Long
    %v_0 = cmp_ige %i, %n: Int
    je %v_0, exit, body
  }

  body {
    %o = shl %i, 3: Long
    %q = add %p, %o: Ptr
    %v = load %q, 8: Long
    %acc2 = add %acc, %v: Long
    %i2 = add %i, 1: Long
    jmp head
  }

  exit {
    ret %acc
  }
}


