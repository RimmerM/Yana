# Floating point against memory and across the banks.
#
# Three separate things that all end up as one instruction each: an access whose width is the value's
# own rather than a choice between extensions, a conversion that keeps REX.W meaning the *integer*
# operand's width while the prefix names the float, and a bitcast, which preserves the width by
# definition and so has nothing for a prefix to select.

# A load and a store are the value's own width - nothing extends into a vector register, so there is
# no narrow form and no signed one.
loadStore(%p: Ptr, %v: F64): F64 {
    {
        store %p, %v, 8
        %l = load %p, 8: F64
        %s = add %l, %v: F64
        ret %s
    }
}

loadStore32(%p: Ptr, %v: F32): F32 {
    {
        store %p, %v, 4
        %l = load %p, 4: F32
        %s = mul %l, %v: F32
        ret %s
    }
}

# A folded addressing mode reaches a float access exactly as it reaches an integer one: the address
# arithmetic is the pointer bank's whatever the loaded value is.
indexed(%p: Ptr, %i: I64): F64 {
    {
        %o = mul %i, 8L: I64
        %a = add %p, %o: Ptr
        %l = load %a, 8: F64
        ret %l
    }
}

# Signed conversions, which are the ones AMD64 has an instruction for. The prefix says which float
# the conversion works with and REX.W says how wide the integer is.
convert(%i: I32, %l: I64): F64 {
    {
        %a = itof %i: F64
        %b = itof %l: F64
        %c = add %a, %b: F64
        ret %c
    }
}

convert32(%i: I32, %l: I64): F32 {
    {
        %a = itof %i: F32
        %b = itof %l: F32
        %c = sub %a, %b: F32
        ret %c
    }
}

# The other direction truncates towards zero, which is what a cast to an integer means everywhere
# else in this compiler.
truncate(%f: F32, %d: F64): I64 {
    {
        %a = ftoi %f: I32
        %b = ftoi %d: I64
        %w = sext %a: I64
        %s = add %w, %b: I64
        ret %s
    }
}

# Unsigned conversions have no instruction in either direction, so expandUnsignedConversions
# replaces them with a sequence of ones that do - see transform.cpp. The two 32-bit cases are exact
# without any correction: every u32 fits in an i64, so widening the other side and converting signed
# is the whole of it.
unsigned32(%u: I32, %f: F64): I32 {
    {
        %a = cast %u: F64
        %b = add %a, %f: F64
        %r = cast %b: I32
        ret %r
    }
}

# The 64-bit ones do need correcting. Going up, a value with its top bit set is halved - keeping the
# bit that falls off, so the rounding still sees it - converted, and doubled back. Going down, a
# value at or above 2^63 has 2^63 subtracted before the conversion and the bit put back into the
# integer afterwards. Both compute the two arms and select, rather than branching.
unsigned64(%u: I64, %f: F64): I64 {
    {
        %a = cast %u: F64
        %b = add %a, %f: F64
        %r = cast %b: I64
        ret %r
    }
}

unsigned64Float(%u: I64, %f: F32): I64 {
    {
        %a = cast %u: F32
        %b = mul %a, %f: F32
        %r = cast %b: I64
        ret %r
    }
}

# A conversion nothing reads is dead either way, but expanding it first would make ten dead
# instructions out of one and nothing afterwards would take them out again. So it emits nothing.
unusedConversion(%u: I64, %v: I64): I64 {
    {
        %dead = cast %u: F64
        %r = add %u, %v: I64
        ret %r
    }
}

# Between the two float widths, where the prefix names the source.
widen(%f: F32, %d: F64): F32 {
    {
        %a = cast %f: F64
        %b = add %a, %d: F64
        %c = cast %b: F32
        ret %c
    }
}

# A bitcast crosses the banks without changing a bit, which is MOVD or MOVQ by the width alone.
bits(%d: F64, %l: I64): I64 {
    {
        %a = bitcast %d: I64
        %b = bitcast %l: F64
        %c = bitcast %b: I64
        %s = add %a, %c: I64
        ret %s
    }
}

bits32(%f: F32, %i: I32): I32 {
    {
        %a = bitcast %f: I32
        %b = bitcast %i: F32
        %c = bitcast %b: I32
        %s = add %a, %c: I32
        ret %s
    }
}
