
probeGroup<complex>(%control: Ptr, %pos: I64, %tag: I32): I64 {
  b_0 {
    %group = load %control, 16: i8x16
    %splat = vsplat %tag: i8x16
    %hits = cmp_eq %group, %splat: m8x16
    %bits = vreduce_bits %hits: I32
    jmp b_1
  }

  b_1 {
    %live = phi [b_0, %bits], [b_2, %next]: I32
    %any = cmp_neq %live, 0: I32
    je %any, b_3, b_4
  }

  b_3 {
    %lane = cttz %live: I32
    %wide = sext %lane: I64
    %slot = add %pos, %wide: I64
    ret %slot
  }

  b_2 {
    %less = sub %live, 1: I32
    %next = and %live, %less: I32
    jmp b_1
  }

  b_4 {
    jmp b_2
  }
}

probeEmpty<complex>(%control: Ptr): I32 {
  b_0 {
    %group = load %control, 16: i8x16
    %empty = vsplat 128: i8x16
    %free = cmp_eq %group, %empty: m8x16
    %bits = vreduce_bits %free: I32
    %none = cmp_eq %bits, 0: I32
    ret %none
  }
}


