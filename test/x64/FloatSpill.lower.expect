    %v_0 = cmp_eq %i, 0: Int
    je %v_0, done, head
  }

  done {
    %r = sub %a, %b: Double
    ret %r
  }
}

swap<complex>(%x: Double, %y: Double, %n: Int): Double {
  start {
    jmp head
  }

  head {
    %a = phi [start, %x], [body, %b2]: Double
    %b = phi [start, %y], [body, %a2]: Double
    %i = phi [start, %n], [body, %i2]: Int
    %v_0 = cmp_eq %i, 0: Int
    je %v_0, done, body
  }

  body {
    %a2 = add %a, %b: Double
    %b2 = mul %b, %a: Double
    %i2 = sub %i, 1: Int
    jmp head
  }

  done {
    %r = sub %a, %b: Double
    ret %r
  }
}


