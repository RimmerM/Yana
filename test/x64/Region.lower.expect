regionUnderPressure<complex>(%n: Int, %p: Ptr): Long {
  entry {
    %zero = cast 0: Long
    %a0 = load %p, 1: Long
    %a1 = load %p, 8: Long
    %a2 = load %p, 16: Long
    %a3 = load %p, 8: Long
    %a4 = load %p, 32: Long
    %a5 = load %p, 8: Long
    %a6 = load %p, 16: Long
    %a7 = load %p, 8: Long
    %a8 = load %p, 64: Long
    %a9 = load %p, 8: Long
    %target = load %p, 8: Ptr
    %r0 = call_complex callee, %n: Int
    jmp preloop
  }

  preloop {
    %u0 = add %zero, %a0: Long
    %u1 = add %u0, %a1: Long
    %u2 = add %u1, %a2: Long
    %u3 = add %u2, %a3: Long
    %u4 = add %u3, %a4: Long
    %u5 = add %u4, %a5: Long
    %u6 = add %u5, %a6: Long
    %u7 = add %u6, %a7: Long
    %u8 = add %u7, %a8: Long
    %u9 = add %u8, %a9: Long
    jmp head
  }

  head {
    %i = phi [preloop, %zero], [body, %i2]: Long
    %acc = phi [preloop, %u9], [body, %acc2]: Long
    je %n, tail, body
  }

  body {
    %w = load %target, 1: Long
    %r1 = call_complex callee, %n: Int
    %acc2 = add %acc, %w: Long
    %i2 = add %i, 1: Long
    jmp head
  }

  tail {
    %z = load %target, 8: Long
    %f = add %acc, %z: Long
    ret %f
  }
}

regionCached<complex>(%n: Int, %p: Ptr, %q: Ptr, %t: Ptr): Long {
  entry {
    %zero = cast 0: Long
    %r = call_clobber sink, %n: Int
    jmp head
  }

  head {
    %i = phi [entry, %zero], [latch, %i2]: Long
    %acc = phi [entry, %zero], [latch, %acc3]: Long
    je %n, exit, first
  }

  first {
    %a = load %p, 8: Long
    %acc1 = add %acc, %a: Long
    jmp second
  }

  second {
    %b = load %q, 8: Long
    %acc2 = add %acc1, %b: Long
    jmp latch
  }

  latch {
    %c = load %t, 8: Long
    %acc3 = add %acc2, %c: Long
    %i2 = add %i, 1: Long
    jmp head
  }

  exit {
    ret %acc
  }
}

regionMoved<complex>(%n: Int, %p: Ptr, %q: Ptr): Long {
  entry {
    %zero = cast 0: Long
    %r = call_clobber sink, %n: Int
    jmp head
  }

  head {
    %i = phi [entry, %zero], [body, %i2]: Long
    %acc = phi [entry, %zero], [body, %acc2]: Long
    je %n, exit, body
  }

  body {
    %a = load %p, 8: Long
    %b = load %q, 8: Long
    %s = add %a, %b: Long
    %acc2 = add %acc, %s: Long
    %i2 = add %i, 1: Long
    jmp head
  }

  exit {
    %z = add %acc, 1: Long
    ret %z
  }
}

regionTooThin<complex>(%n: Int, %p: Ptr, %q: Ptr): Long {
  entry {
    %zero = cast 0: Long
    %r = call_clobber sink, %n: Int
    %g = load %q, 8: Long
    jmp head
  }

  head {
    %i = phi [entry, %zero], [body, %i2]: Long
    %acc = phi [entry, %zero], [body, %acc2]: Long
    je %n, exit, body
  }

  body {
    %a = load %p, 8: Long
    %acc2 = add %acc, %a: Long
    %i2 = add %i, 1: Long
    jmp head
  }

  exit {
    %z = add %acc, %g: Long
    ret %z
  }
}

regionLiveBlocksOnly<complex>(%n: Int, %p: Ptr, %t: Ptr): Long {
  entry {
    %zero = cast 0: Long
    %r = call_clobber sink, %n: Int
    %t1 = load %t, 8: Long
    %t2 = load %t, 8: Long
    %tv = add %t1, %t2: Long
    jmp head
  }

  head {
    %i = phi [entry, %zero], [latch, %i2]: Long
    %acc = phi [entry, %zero], [latch, %acc2]: Long
    je %n, exit, first
  }

  first {
    %x1 = add %acc, %tv: Long
    %x2 = add %x1, %tv: Long
    jmp latch
  }

  latch {
    %a = load %p, 8: Long
    %acc2 = add %x2, %a: Long
    %i2 = add %i, 1: Long
    jmp head
  }

  exit {
    ret %acc
  }
}


