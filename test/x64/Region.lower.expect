
sink<clobber>(%x: I32): I32 {
  b_0 {
    ret %x
  }
}

callee<complex>(%x: I32): I32 {
  b_0 {
    ret %x
  }
}

reader<complex>(%p: Ptr): I64 {
  b_0 {
    %v_1 = load %p, 1: I64
    ret %v_1
  }
}

regionUnderPressure<complex>(%n: I32, %p: Ptr): I64 {
  entry {
    %zero = cast 0: I64
    %a0 = load %p, 1: I64
    %a1 = load %p, 8: I64
    %a2 = load %p, 16: I64
    %a3 = load %p, 8: I64
    %a4 = load %p, 32: I64
    %a5 = load %p, 8: I64
    %a6 = load %p, 16: I64
    %a7 = load %p, 8: I64
    %a8 = load %p, 64: I64
    %a9 = load %p, 8: I64
    %target = load %p, 8: Ptr
    %r0 = call_complex callee, %n: I32
    jmp preloop
  }

  preloop {
    %u0 = add %zero, %a0: I64
    %u1 = add %u0, %a1: I64
    %u2 = add %u1, %a2: I64
    %u3 = add %u2, %a3: I64
    %u4 = add %u3, %a4: I64
    %u5 = add %u4, %a5: I64
    %u6 = add %u5, %a6: I64
    %u7 = add %u6, %a7: I64
    %u8 = add %u7, %a8: I64
    %u9 = add %u8, %a9: I64
    jmp head
  }

  head {
    %i = phi [preloop, %zero], [body, %i2]: I64
    %acc = phi [preloop, %u9], [body, %acc2]: I64
    je %n, tail, body
  }

  body {
    %w = load %target, 1: I64
    %r1 = call_complex callee, %n: I32
    %acc2 = add %acc, %w: I64
    %i2 = add %i, 1: I64
    jmp head
  }

  tail {
    %z = load %target, 8: I64
    %f = add %acc, %z: I64
    ret %f
  }
}

regionCached<complex>(%n: I32, %p: Ptr, %q: Ptr, %t: Ptr): I64 {
  entry {
    %zero = cast 0: I64
    %r = call_clobber sink, %n: I32
    jmp head
  }

  head {
    %i = phi [entry, %zero], [latch, %i2]: I64
    %acc = phi [entry, %zero], [latch, %acc3]: I64
    je %n, exit, first
  }

  first {
    %a = load %p, 8: I64
    %acc1 = add %acc, %a: I64
    jmp second
  }

  second {
    %b = load %q, 8: I64
    %acc2 = add %acc1, %b: I64
    jmp latch
  }

  latch {
    %c = load %t, 8: I64
    %acc3 = add %acc2, %c: I64
    %i2 = add %i, 1: I64
    jmp head
  }

  exit {
    ret %acc
  }
}

regionMoved<complex>(%n: I32, %p: Ptr, %q: Ptr): I64 {
  entry {
    %zero = cast 0: I64
    %r = call_clobber sink, %n: I32
    jmp head
  }

  head {
    %i = phi [entry, %zero], [body, %i2]: I64
    %acc = phi [entry, %zero], [body, %acc2]: I64
    je %n, exit, body
  }

  body {
    %a = load %p, 8: I64
    %b = load %q, 8: I64
    %s = add %a, %b: I64
    %acc2 = add %acc, %s: I64
    %i2 = add %i, 1: I64
    jmp head
  }

  exit {
    %z = add %acc, 1: I64
    ret %z
  }
}

regionTooThin<complex>(%n: I32, %p: Ptr, %q: Ptr): I64 {
  entry {
    %zero = cast 0: I64
    %r = call_clobber sink, %n: I32
    %g = load %q, 8: I64
    jmp head
  }

  head {
    %i = phi [entry, %zero], [body, %i2]: I64
    %acc = phi [entry, %zero], [body, %acc2]: I64
    je %n, exit, body
  }

  body {
    %a = load %p, 8: I64
    %acc2 = add %acc, %a: I64
    %i2 = add %i, 1: I64
    jmp head
  }

  exit {
    %z = add %acc, %g: I64
    ret %z
  }
}

regionLiveBlocksOnly<complex>(%n: I32, %p: Ptr, %t: Ptr): I64 {
  entry {
    %zero = cast 0: I64
    %r = call_clobber sink, %n: I32
    %t1 = load %t, 8: I64
    %t2 = load %t, 8: I64
    %tv = add %t1, %t2: I64
    jmp head
  }

  head {
    %i = phi [entry, %zero], [latch, %i2]: I64
    %acc = phi [entry, %zero], [latch, %acc2]: I64
    je %n, exit, first
  }

  first {
    %x1 = add %acc, %tv: I64
    %x2 = add %x1, %tv: I64
    jmp latch
  }

  latch {
    %a = load %p, 8: I64
    %acc2 = add %x2, %a: I64
    %i2 = add %i, 1: I64
    jmp head
  }

  exit {
    ret %acc
  }
}

regionPhiMoved<complex>(%n: I32, %p: Ptr): I64 {
  entry {
    %zero = cast 0: I64
