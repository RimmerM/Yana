  keep {
    store %c1, %best, 8
    store %c2, %best, 8
    jmp latch
  }

  take {
    jmp latch
  }

  latch {
    %best2 = phi [keep, %best], [take, %a]: I64
    store %c3, %best2, 8
    %i2 = add %i, 1: I64
    jmp head
  }

  exit {
    %z = add %best, 1: I64
    ret %z
  }
}


