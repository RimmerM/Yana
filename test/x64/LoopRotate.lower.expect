
counted<complex>(%n: Int): Int {
  entry {
    %zero = cast 0: Int
    jmp head
  }

  head {
    %i = phi [entry, %zero], [body, %i2]: Int
    %acc = phi [entry, %zero], [body, %acc2]: Int
    %v_0 = cmp_ige %i, %n: Int
    je %v_0, exit, body
  }

  body {
    %acc2 = add %acc, %i: Int
    %i2 = add %i, 1: Int
    jmp head
  }

  exit {
    ret %acc
  }
}

shift<complex>(%n: Int, %x: Int, %y: Int): Int {
  entry {
    jmp head
  }

  head {
    %i = phi [entry, %n], [body, %i2]: Int
    %a = phi [entry, %x], [body, %b]: Int
    %b = phi [entry, %y], [body, %s]: Int
    %v_0 = cmp_eq %i, 0: Int
    je %v_0, exit, body
  }

  body {
    %s = add %a, %b: Int
    %i2 = sub %i, 1: Int
    jmp head
  }

  exit {
    ret %a
  }
}

diamond<complex>(%n: Int, %c: Int): Int {
  entry {
    %zero = cast 0: Int
    jmp head
  }

  head {
    %i = phi [entry, %zero], [rejoin, %i2]: Int
    %acc = phi [entry, %zero], [rejoin, %acc2]: Int
    %v_0 = cmp_ige %i, %n: Int
    je %v_0, exit, body
  }

  body {
    je %c, odd, rejoin
  }

  odd {
    jmp rejoin
  }

  rejoin {
    %step = phi [body, 1], [odd, 2]: Int
    %acc2 = add %acc, %step: Int
    %i2 = add %i, 1: Int
    jmp head
  }

  exit {
    ret %acc
  }
}

nested<complex>(%rows: Int, %cols: Int): Int {
  entry {
    %zero = cast 0: Int
    jmp outerHead
  }

  outerHead {
    %r = phi [entry, %zero], [outerLatch, %r2]: Int
    %acc = phi [entry, %zero], [outerLatch, %acc3]: Int
    %v_0 = cmp_ige %r, %rows: Int
    je %v_0, exit, innerPre
  }

  innerPre {
    jmp innerHead
  }

  innerHead {
    %c = phi [innerPre, %zero], [innerBody, %c2]: Int
    %acc2 = phi [innerPre, %acc], [innerBody, %acc2i]: Int
    %v_1 = cmp_ige %c, %cols: Int
    je %v_1, outerLatch, innerBody
  }

  innerBody {
    %acc2i = add %acc2, %c: Int
    %c2 = add %c, 1: Int
    jmp innerHead
  }

  outerLatch {
    %acc3 = phi [innerHead, %acc2]: Int
    %r2 = add %r, 1: Int
    jmp outerHead
  }

  exit {
    ret %acc
  }
}

twoLatches<complex>(%n: Int, %c: Int): Int {
  entry {
    %zero = cast 0: Int
    jmp head
  }

  head {
    %i = phi [entry, %zero], [left, %l], [right, %r]: Int
    %v_0 = cmp_ige %i, %n: Int
    je %v_0, exit, body
  }

  body {
    je %c, left, right
  }

  left {
    %l = add %i, 1: Int
    jmp head
  }

  right {
    %r = add %i, 2: Int
    jmp head
  }

  exit {
    ret %i
  }
}

noPreheader<complex>(%n: Int, %c: Int): Int {
  entry {
    %zero = cast 0: Int
    je %c, exit, head
  }

  head {
    %i = phi [entry, %zero], [body, %i2]: Int
    %v_0 = cmp_ige %i, %n: Int
    je %v_0, exit, body
  }

  body {
    %i2 = add %i, 1: Int
    jmp head
  }

  exit {
    %v = phi [entry, %zero], [head, %i]: Int
    ret %v
  }
}

headerWork<complex>(%p: Ptr, %n: Int): Int {
  entry {
    %zero = cast 0: Int
    jmp head
  }

  head {
    %i = phi [entry, %zero], [body, %i2]: Int
    %acc = phi [entry, %zero], [body, %acc2]: Int
    %q = add %i, 7: Int
    %v_0 = cmp_ige %i, %n: Int
    je %v_0, exit, body
  }

  body {
    %acc2 = add %acc, %q: Int
    %i2 = add %i, 1: Int
    jmp head
  }

  exit {
    ret %acc
  }
}

twoExits<complex>(%n: Int, %c: Int): Int {
  entry {
    %zero = cast 0: Int
    jmp head
  }

  head {
    %i = phi [entry, %zero], [body, %i2]: Int
    %v_0 = cmp_ige %i, %n: Int
    je %v_0, exit, body
  }

  body {
    %i2 = add %i, 1: Int
    je %c, early, head
  }

  early {
    jmp exit
  }

  exit {
    %v = phi [head, %i], [early, %i2]: Int
    ret %v
  }
}


