
counted<complex>(%n: I32): I32 {
  entry {
    %zero = cast 0: I32
    jmp head
  }

  head {
    %i = phi [entry, %zero], [body, %i2]: I32
    %acc = phi [entry, %zero], [body, %acc2]: I32
    %v_0 = cmp_ige %i, %n: I32
    je %v_0, exit, body
  }

  body {
    %acc2 = add %acc, %i: I32
    %i2 = add %i, 1: I32
    jmp head
  }

  exit {
    ret %acc
  }
}

shift<complex>(%n: I32, %x: I32, %y: I32): I32 {
  entry {
    jmp head
  }

  head {
    %i = phi [entry, %n], [body, %i2]: I32
    %a = phi [entry, %x], [body, %b]: I32
    %b = phi [entry, %y], [body, %s]: I32
    %v_0 = cmp_eq %i, 0: I32
    je %v_0, exit, body
  }

  body {
    %s = add %a, %b: I32
    %i2 = sub %i, 1: I32
    jmp head
  }

  exit {
    ret %a
  }
}

diamond<complex>(%n: I32, %c: I32): I32 {
  entry {
    %zero = cast 0: I32
    jmp head
  }

  head {
    %i = phi [entry, %zero], [rejoin, %i2]: I32
    %acc = phi [entry, %zero], [rejoin, %acc2]: I32
    %v_0 = cmp_ige %i, %n: I32
    je %v_0, exit, body
  }

  body {
    je %c, odd, rejoin
  }

  odd {
    jmp rejoin
  }

  rejoin {
    %step = phi [body, 1], [odd, 2]: I32
    %acc2 = add %acc, %step: I32
    %i2 = add %i, 1: I32
    jmp head
  }

  exit {
    ret %acc
  }
}

nested<complex>(%rows: I32, %cols: I32): I32 {
  entry {
    %zero = cast 0: I32
    jmp outerHead
  }

  outerHead {
    %r = phi [entry, %zero], [outerLatch, %r2]: I32
    %acc = phi [entry, %zero], [outerLatch, %acc3]: I32
    %v_0 = cmp_ige %r, %rows: I32
    je %v_0, exit, innerPre
  }

  innerPre {
    jmp innerHead
  }

  innerHead {
    %c = phi [innerPre, %zero], [innerBody, %c2]: I32
    %acc2 = phi [innerPre, %acc], [innerBody, %acc2i]: I32
    %v_1 = cmp_ige %c, %cols: I32
    je %v_1, outerLatch, innerBody
  }

  innerBody {
    %acc2i = add %acc2, %c: I32
    %c2 = add %c, 1: I32
    jmp innerHead
  }

  outerLatch {
    %acc3 = phi [innerHead, %acc2]: I32
    %r2 = add %r, 1: I32
    jmp outerHead
  }

  exit {
    ret %acc
  }
}

twoLatches<complex>(%n: I32, %c: I32): I32 {
  entry {
    %zero = cast 0: I32
    jmp head
  }

  head {
    %i = phi [entry, %zero], [left, %l], [right, %r]: I32
    %v_0 = cmp_ige %i, %n: I32
    je %v_0, exit, body
  }

  body {
    je %c, left, right
  }

  left {
    %l = add %i, 1: I32
    jmp head
  }

  right {
    %r = add %i, 2: I32
    jmp head
  }

  exit {
    ret %i
  }
}

noPreheader<complex>(%n: I32, %c: I32): I32 {
  entry {
    %zero = cast 0: I32
    je %c, exit, head
  }

  head {
    %i = phi [entry, %zero], [body, %i2]: I32
    %v_0 = cmp_ige %i, %n: I32
    je %v_0, exit, body
  }

  body {
    %i2 = add %i, 1: I32
    jmp head
  }

  exit {
    %v = phi [entry, %zero], [head, %i]: I32
    ret %v
  }
}

headerWork<complex>(%p: Ptr, %n: I32): I32 {
  entry {
    %zero = cast 0: I32
    jmp head
  }

  head {
    %i = phi [entry, %zero], [body, %i2]: I32
    %acc = phi [entry, %zero], [body, %acc2]: I32
    %q = add %i, 7: I32
    %v_0 = cmp_ige %i, %n: I32
    je %v_0, exit, body
  }

  body {
    %acc2 = add %acc, %q: I32
    %i2 = add %i, 1: I32
    jmp head
  }

  exit {
    ret %acc
  }
}

twoExits<complex>(%n: I32, %c: I32): I32 {
  entry {
    %zero = cast 0: I32
    jmp head
  }

  head {
    %i = phi [entry, %zero], [body, %i2]: I32
    %v_0 = cmp_ige %i, %n: I32
    je %v_0, exit, body
  }

  body {
    %i2 = add %i, 1: I32
    je %c, early, head
  }

  early {
    jmp exit
  }

  exit {
    %v = phi [head, %i], [early, %i2]: I32
    ret %v
  }
}


