# Rematerialization.
#
# A value cheap enough to recompute does not need to be kept anywhere. Instead of a register or a
# frame slot its web gets a *recipe*, which is emitted afresh into a scratch register at each
# instruction that reads it - and the instruction that would have defined it emits nothing at all,
# since there is nothing left to define. Between its uses the value occupies no location and
# interferes with nothing, which is the point: the values this applies to are exactly the ones whose
# live ranges are long and whose contents never change.
#
# Four recipes: an immediate, the address of a global, the address of a function, and the address of
# a fixed frame object - each a constant in the sense that matters, depending on nothing the program
# can write. `creates=[remat:N]` marks the definition that emits nothing, and `pre=[remat:N->r15]`
# the materialization that stands in for the reload.
#
# The Clobber convention destroys every register except rbp, so exactly one value can survive one of
# its calls in a register. Every case below sends three across: %keep and %other, which are read
# repeatedly in positions that need a register and are therefore worth keeping, and the one under
# test, which is not. What each case asks is what the loser gets - a recipe, or a slot with a store
# at the top and a read at every use.

@table = 1024

sink<clobber>(%x: I32): I32 {
    { ret %x }
}

indirect<complex>(%x: I64): I64 {
    { ret %x }
}

takePtr<complex>(%p: Ptr, %v: I64): I64 {
    { ret %v }
}

# A constant too wide to embed into an instruction has to be materialized somewhere, and
# `mov r, imm64` is the same ten bytes wherever it is put. A slot would have cost those ten bytes at
# the top, plus a store, plus a read at every use; the recipe costs them at the use and nothing else.
constantAcrossCall(%arg: I32, %keep: I64, %other: I64): I64 {
    {
        %k = imm 81985529216486895L: I64
        %r = call_clobber sink, %arg: I32

        %s1 = add %keep, %other: I64
        %s2 = add %other, %s1: I64
        %s3 = add %keep, %s2: I64
        %s4 = add %other, %s3: I64
        %s5 = add %keep, %s4: I64
        %s6 = add %other, %s5: I64

        %v = add %s6, %k: I64
        ret %v
    }
}

# A global's address is a RIP-relative `lea`, which produces the same answer wherever it is emitted.
globalAcrossCall(%arg: I32, %keep: I64, %other: I64): I64 {
    {
        %g = global @table
        %r = call_clobber sink, %arg: I32

        %s1 = add %keep, %other: I64
        %s2 = add %other, %s1: I64
        %s3 = add %keep, %s2: I64
        %s4 = add %other, %s3: I64
        %s5 = add %keep, %s4: I64
        %s6 = add %other, %s5: I64

        %v = load %g, 8: I64
        %w = add %s6, %v: I64
        ret %w
    }
}

# A function's address is the same shape. It reaches the allocator at all only because something
# other than a direct call reads it - here it is passed as an argument, where a direct call would
# have encoded it as a rel32 and never looked at a register.
functionAcrossCall(%arg: I32, %keep: I64, %other: I64): I64 {
    {
        %f = fun indirect
        %r = call_clobber sink, %arg: I32

        %s1 = add %keep, %other: I64
        %s2 = add %other, %s1: I64
        %s3 = add %keep, %s2: I64
        %s4 = add %other, %s3: I64
        %s5 = add %keep, %s4: I64
        %s6 = add %other, %s5: I64

        %v = call_complex takePtr, %f, %s6: I64
        ret %v
    }
}

# A fixed-size alloca is a constant displacement from a base register the frame keeps valid for the
# whole function, so its address is an `lea` that can be repeated. Spilling it would have meant
# storing a frame address into the frame.
#
# Its two reads stand next to each other, so the recipe is also where the *other* split applies: a
# cluster segment holds the address in a register across both of them and the `lea` is emitted once
# rather than twice (`post=[remat:0->rcx]`). A recipe is a home like any other as far as that is
# concerned - it goes on producing the same answer, so leaving the segment costs nothing. See
# `Cluster.lower`.
localAcrossCall(%arg: I32, %keep: I64, %other: I64): I64 {
    {
        %p = alloca 32: Ptr
        %r = call_clobber sink, %arg: I32

        %s1 = add %keep, %other: I64
        %s2 = add %other, %s1: I64
        %s3 = add %keep, %s2: I64
        %s4 = add %other, %s3: I64
        %s5 = add %keep, %s4: I64
        %s6 = add %other, %s5: I64

        store %p, %s6, 8
        %v = load %p, 8: I64
        ret %v
    }
}

# The other way round, and the reason both prices are worked out rather than one. Every use of this
# constant is an operand the instruction can read straight out of memory, which costs no instruction
# at all - only a longer encoding - so four reads from a slot come to less than four `mov r, imm64`,
# and the frame wins.
foldedConstant(%arg: I32, %keep: I64, %other: I64): I64 {
    {
        %k = imm 81985529216486895L: I64
        %r = call_clobber sink, %arg: I32

        %s1 = add %keep, %other: I64
        %s2 = add %other, %s1: I64
        %s3 = add %keep, %s2: I64
        %s4 = add %other, %s3: I64
        %s5 = add %keep, %s4: I64
        %s6 = add %other, %s5: I64

        %a = add %s6, %k: I64
        %b = add %a, %k: I64
        %c = add %b, %k: I64
        %d = add %c, %k: I64
        ret %d
    }
}

# Under ordinary pressure rather than at a call boundary: sixteen values live at once, of which one
# is a constant. It is the cheapest thing in the function to do without, so it is what gives up its
# register - and it gives it up for a recipe rather than a slot.
constantUnderPressure(%a: I64): I64 {
    {
        %k = imm 81985529216486895L: I64

        %v0 = add %a, 0L: I64
        %v1 = add %a, 1L: I64
        %v2 = add %a, 2L: I64
        %v3 = add %a, 3L: I64
        %v4 = add %a, 4L: I64
        %v5 = add %a, 5L: I64
        %v6 = add %a, 6L: I64
        %v7 = add %a, 7L: I64
        %v8 = add %a, 8L: I64
        %v9 = add %a, 9L: I64
        %v10 = add %a, 10L: I64
        %v11 = add %a, 11L: I64
        %v12 = add %a, 12L: I64
        %v13 = add %a, 13L: I64
        %v14 = add %a, 14L: I64

        %s14 = add %v14, %v13: I64
        %s13 = add %s14, %v12: I64
        %s12 = add %s13, %v11: I64
        %s11 = add %s12, %v10: I64
        %s10 = add %s11, %v9: I64
        %s9 = add %s10, %v8: I64
        %s8 = add %s9, %v7: I64
        %s7 = add %s8, %v6: I64
        %s6 = add %s7, %v5: I64
        %s5 = add %s6, %v4: I64
        %s4 = add %s5, %v3: I64
        %s3 = add %s4, %v2: I64
        %s2 = add %s3, %v1: I64
        %s1 = add %s2, %v0: I64
        %s0 = imul %s1, %k: I64
        ret %s0
    }
}
