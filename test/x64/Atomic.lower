# The atomics through the direct x64 backend - Analysis-Atomics.md §5.3.
#
# What this fixture pins is the half of the table where the answer is "the ordinary instruction",
# and the half where it is not.
#
# **A load is `mov` at every order it admits, and a store is `mov` at two of its three.** x86 orders
# load-load and store-store already, so acquire and release cost no instruction here; what they cost
# is motion, and that is spent above selection where `writesStorage` answers yes to every atomic.
# The bytes below are therefore identical to a plain load's, which is the point.
#
# **A sequential store is `xchg`.** It is the one order the architecture does not give for free: a
# plain store may be reordered past a later load from another location. `expandAtomics` rewrites it
# into the exchange it has to be, so what appears in the printed IR above the bytes is an
# `atomic_xchg` the source never wrote.
#
# **A compare-exchange is `lock cmpxchg` and a comparison.** rax is a fixed use and a fixed def, so
# the expected value is moved into it and the previous value is moved back out. Its success flag is
# not materialized with a `setcc`: on x86 the flag *is* `previous == expected`, so `expandAtomics`
# writes that comparison and points the readers at it, and the flags folding then branches on what
# the `cmpxchg` already left in ZF.
#
# **A fetch operation is one of four shapes**, and which one depends on whether its result is read -
# see `expandAtomics`. The whole table appears below: the locked in-place form when nobody reads the
# previous value, `lock xadd` when somebody does, a negation in front of it for a subtraction, and
# the compare-exchange loop for the three bitwise operations the architecture cannot answer.

loads(%p: Ptr): Int {
    {
        %a = atomic_load %p, 4, relaxed: Int
        %b = atomic_load %p, 4, acquire: Int
        %c = atomic_load %p, 4, seq_cst: Int
        %d = atomic_load %p, 8, acquire: Long
        %e = atomic_loads %p, 1, relaxed: Int
        %f = atomic_load %p, 2, acquire: Int
        ret %a
    }
}

# The two orders that are a plain `mov`, at both widths, and a constant that goes into the encoding
# rather than into a register.
stores(%p: Ptr, %v: Int, %w: Long) {
    {
        atomic_store %p, %v, 4, relaxed
        atomic_store %p, %v, 4, release
        atomic_store %p, %w, 8, release
        atomic_store %p, 1, 4, release
        atomic_store %p, %v, 2, relaxed
        atomic_store %p, %v, 1, release
        ret
    }
}

# And the one that is not. Both of these become an `xchg` whose result nothing reads.
sequentialStore(%p: Ptr, %v: Int, %w: Long) {
    {
        atomic_store %p, %v, 4, seq_cst
        atomic_store %p, %w, 8, seq_cst
        ret
    }
}

# The exchange proper, whose result is read - so the value register is destructive and the caller's
# copy is the allocator's problem rather than the encoding's.
exchange(%p: Ptr, %v: Int, %q: Ptr): Int {
    {
        %old = atomic_xchg %p, %v, 4, acq_rel: Int
        %ptr = atomic_xchg %p, %q, 8, seq_cst: Ptr
        %narrow = atomic_xchg %p, %v, 1, relaxed: Int
        %half = atomic_xchg %p, %v, 2, relaxed: Int
        ret %old
    }
}

compare(%p: Ptr, %e: Int, %d: Int): Int {
    {
        %prev, %ok = atomic_cas %p, %e, %d, 4, acq_rel, acquire: Int, Int
        ret %prev
    }
}

# The weak form, which encodes identically on x86 - there is no spurious failure to permit, so the
# flag only stops a caller from assuming one cannot happen elsewhere.
compareWeak(%p: Ptr, %e: Long, %d: Long): Long {
    {
        %prev, %ok = atomic_cas_weak %p, %e, %d, 8, seq_cst, seq_cst: Long, Int
        ret %prev
    }
}

# The two narrow widths, which are the same instruction with an operand-size prefix and, at one
# byte, the REX that names sil rather than dh.
compareNarrow(%p: Ptr, %e: Int, %d: Int): Int {
    {
        %p1, %o1 = atomic_cas %p, %e, %d, 1, relaxed, relaxed: Int, Int
        %p2, %o2 = atomic_cas %p, %e, %d, 2, acquire, acquire: Int, Int
        ret %p1
    }
}

# The success flag actually used, which is the shape a retry loop has - and where the comparison
# standing in for it costs nothing, the branch reading the flags the compare-exchange set.
compareBranch(%p: Ptr, %e: Int, %d: Int): Int {
    {
        %prev, %ok = atomic_cas %p, %e, %d, 4, acq_rel, acquire: Int, Int
        je %ok, then, else
    }

    then {
        ret %prev
    }

    else {
        ret %e
    }
}

# The five updates whose previous value nobody reads, which is the row of §5.3 that selection could
# not have chosen for itself: the instruction is the same instruction either way and only the use
# list says which encoding can express it. Each is one locked in-place operation naming one register,
# and the result is given no home at all.
fetchDiscard(%p: Ptr, %v: Int, %w: Long) {
    {
        %a = atomic_add %p, %v, 4, relaxed: Int
        %b = atomic_sub %p, %v, 4, seq_cst: Int
        %c = atomic_and %p, %v, 4, acquire: Int
        %d = atomic_or %p, %v, 4, release: Int
        %e = atomic_xor %p, %w, 8, acq_rel: Long
        ret
    }
}

# The narrow widths of the same row, which are the same instruction with an operand-size prefix and,
# at one byte, the REX that names sil rather than dh.
fetchDiscardNarrow(%p: Ptr, %v: Int) {
    {
        %a = atomic_add %p, %v, 1, relaxed: Int
        %b = atomic_or %p, %v, 2, seq_cst: Int
        ret
    }
}

# And the one update the architecture hands the previous value back from. `lock xadd` ties its result
# to the register the addend arrived in, so a caller whose amount is still live afterwards pays the
# copy that makes it destructive.
fetchAdd(%p: Ptr, %v: Int, %w: Long): Int {
    {
        %a = atomic_add %p, %v, 4, acq_rel: Int
        %b = atomic_add %p, %w, 8, seq_cst: Long
        %c = atomic_add %p, %v, 2, relaxed: Int
        ret %a
    }
}

# A subtraction whose result is read is the addition of a negation - there is no `xsub`, and this is
# the whole of what `fetchSub` costs over `fetchAdd`. What appears in the printed IR is an
# `atomic_add` the source never wrote, over a value the source never named.
fetchSub(%p: Ptr, %v: Int): Int {
    {
        %a = atomic_sub %p, %v, 4, acq_rel: Int
        ret %a
    }
}

# The three the machine cannot answer, which become the compare-exchange loop. The block is cut in
# two at the operation, the speculative read carries the failure order, and the comparison the flag
# fixup writes is folded into the branch that closes the loop.
fetchOr(%p: Ptr, %v: Int): Int {
    {
        %a = atomic_or %p, %v, 4, acq_rel: Int
        ret %a
    }
}

# The same at a wide width and with something following it in the block, so that the split has a
# bottom half with instructions in it rather than only a terminator.
fetchAndTail(%p: Ptr, %v: Long, %q: Ptr): Long {
    {
        %a = atomic_and %p, %v, 8, seq_cst: Long
        %b = atomic_load %q, 8, acquire: Long
        %c = add %a, %b: Long
        ret %c
    }
}

# Two loops in one block, which is what makes the walk's bookkeeping worth pinning: the second one
# cuts a block the first one created.
fetchTwice(%p: Ptr, %q: Ptr, %v: Int): Int {
    {
        %a = atomic_xor %p, %v, 4, relaxed: Int
        %b = atomic_or %q, %a, 4, acquire: Int
        ret %b
    }
}

# The fences. Three of the four orders emit nothing at all - x86 orders load-load, load-store and
# store-store already - and the instruction still stands, because what it constrains is this
# backend's own motion. The sequential one is `mfence`.
fences() {
    {
        fence acquire
        fence release
        fence acq_rel
        fence seq_cst
        ret
    }
}

# And the spin hint, which is `pause`: architecturally `rep nop`, and a hint that the loop around it
# is polling.
spin() {
    {
        spinhint
        spinhint
        ret
    }
}

# A bitwise fetch at a narrow width, which is where the comparison closing the loop has to be looked
# at rather than assumed. `lock cmpxchg` with a byte operand writes AL and leaves the rest of eax
# alone - and what the rest of eax holds is the expected value, moved in whole by the allocator. So
# the 32-bit comparison against the expectation is equal exactly when the byte was, and the loop
# terminates for the reason it looks like it does.
fetchNarrow(%p: Ptr, %v: Int): Int {
    {
        %a = atomic_and %p, %v, 1, acquire: Int
        %b = atomic_xor %p, %v, 2, relaxed: Int
        ret %a
    }
}
