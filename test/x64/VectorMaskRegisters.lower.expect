phiMask<complex>(%a: i8x16, %b: i8x16, %c: I32): I32 {
  start {
    %p = cmp_eq %a, %b: m8x16
    %q = cmp_gt %a, %b: m8x16
    je %c, left, right
  }

  left {
    jmp join
