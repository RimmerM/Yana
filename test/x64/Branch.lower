branch(%v: Int, %out: Int): Int, Int {
    start {
        je (cmp_le %v, 0), a, b
    }

    a {
        %v1 = add %v, 1: Int
        jmp end
    }

    b {
        %v2 = mul %v, 2: Int
        jmp end
    }

    end {
        ret (phi [a, %v1], [b, %v2]: Int), %out
    }
}

# The branch side of the flag window - see Select.lower for the same thing under a CMOV. Both
# instructions between the comparison and the branch that reads it write the flags, and neither
# reads anything defined below the comparison, so both are lifted above it and the branch tests the
# flags rather than a materialized comparison result.
flagWindow(%v: Int, %w: Int): Int {
    start {
        %cmp = cmp_ilt %v, %w
        %x = add %v, 1: Int
        %y = mul %w, 3: Int
        je %cmp, a, b
    }

    a {
        ret %x
    }

    b {
        ret %y
    }
}

# The same window, with a load in the middle of it. The load does not write the flags and so is not
# in the way; the add reads it and therefore cannot go above the comparison, and the comparison is
# materialized.
#
# `setcc` writes one byte and leaves the other three alone, so a materialized comparison has to clear
# them somehow. Here it cannot do so in front of the comparison: the result reuses the register the
# left-hand side is dying in, and zeroing that would destroy the operand the comparison is about to
# read - so the extension stays behind the `setcc` as a `movzx`. `flagWindowLive` below is the other
# half.
flagWindowLoad(%v: Int, %w: Int, %p: Ptr): Int {
    start {
        %cmp = cmp_ilt %v, %w
        %l = load %p, 4: Int
        %x = add %l, 1: Int
        je %cmp, a, b
    }

    a {
        ret %x
    }

    b {
        ret %w
    }
}

# And the half that can. Both compared values are read again on the taken arm, so the result gets a
# register of its own, and the clearing goes in front of the comparison as `xor r32, r32` - one byte
# shorter than the `movzx` above, and leaving the `setcc` with no dependency on whatever the register
# held before.
flagWindowLive(%v: Int, %w: Int, %p: Ptr): Int {
    start {
        %cmp = cmp_ilt %v, %w
        %l = load %p, 4: Int
        %x = add %l, 1: Int
        je %cmp, a, b
    }

    a {
        %s = add %v, %w: Int
        %t = add %s, %x: Int
        ret %t
    }

    b {
        ret %w
    }
}

# A comparison works at the width of what it compares, not at the width of what it produces: the
# result of every comparison is an Int, so taking the operand size from it would compare two 64-bit
# values by their low halves alone. Both comparisons here have to carry a REX.W prefix - the
# register form and the immediate one are encoded by different paths and get the width the same way.
wideBranch(%v: Long, %w: Long): Long {
    start {
        je (cmp_ilt %v, %w), a, b
    }

    a {
        %s = add %v, %w: Long
        ret %s
    }

    b {
        je (cmp_ilt %w, 0L), c, d
    }

    c {
        ret %w
    }

    d {
        %e = sub %v, 1L: Long
        ret %e
    }
}
