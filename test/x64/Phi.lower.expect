
sourceUsedLater<complex>(%n: I32, %lim: I32): I32 {
  start {
    %x = add %n, 1: I32
    jmp head
  }

  head {
    %p = phi [start, %x], [head, %q]: I32
    %q = add %p, %x: I32
    %v_0 = cmp_le %q, %lim: I32
    je %v_0, head, end
  }

  end {
    ret %p
  }
}

sharedSource<complex>(%n: I32): I32 {
  start {
    %x = add %n, 1: I32
    jmp join
  }

  join {
    %p = phi [start, %x]: I32
    %q = phi [start, %x]: I32
    %r = add %p, %q: I32
    ret %r
  }
}

branchedSource<complex>(%n: I32, %c: I32): I32 {
  start {
    %x = add %n, 1: I32
    je %c, a, b
  }

  a {
    %p = phi [start, %x]: I32
    ret %p
  }

  b {
    %q = phi [start, %x]: I32
    ret %q
  }
}

swap<complex>(%n: I32, %m: I32, %k: I32): I32 {
  start {
    jmp head
  }

  head {
    %a = phi [start, %n], [head, %b]: I32
    %b = phi [start, %m], [head, %a]: I32
    %v_0 = cmp_le %a, %k: I32
    je %v_0, head, end
  }

  end {
    ret %a
  }
}

tiedSwap<complex>(%x: I64, %y: I64, %n: I32): I64 {
  start {
    jmp head
  }

  head {
    %a = phi [start, %x], [body, %b2]: I64
    %b = phi [start, %y], [body, %a2]: I64
    %i = phi [start, %n], [body, %i2]: I32
    %v_0 = cmp_eq %i, 0: I32
    je %v_0, done, body
  }

  body {
    %a2 = add %a, %b: I64
    %b2 = sub %b, %a: I64
    %i2 = sub %i, 1: I32
    jmp head
  }

  done {
    %r = sub %a, %b: I64
    ret %r
  }
}

tiedNeighbour<complex>(%a: I32, %c: I32): I32 {
  start {
    %g = add %a, 7: I32
    je %c, right, left
  }

  left {
    %x = add %g, 1: I32
    jmp join
  }

  right {
    %p = add %a, 2: I32
    %q = add %g, 3: I32
    %y = imul %p, %q: I32
    jmp join
  }

  join {
    %r = phi [left, %x], [right, %y]: I32
    %z = add %r, %g: I32
    ret %z
  }
}

chain<complex>(%x: I32, %c: I32): I32 {
  start {
    je %c, l, r
  }

  l {
    %p = add %x, 1: I32
    jmp mid
  }

  r {
    %q = add %x, 2: I32
    jmp mid
  }

  mid {
    %m = phi [l, %p], [r, %q]: I32
    je %c, l2, r2
  }

  l2 {
    %s = add %m, 3: I32
    jmp end
  }

  r2 {
    %t = add %m, 4: I32
    jmp end
  }

  end {
    %z = phi [l2, %s], [r2, %t]: I32
    ret %z
  }
}

copiedThenPhi<complex>(%p: Ptr, %n: I32): I64 {
  start {
    %b = bitcast %p: I64
    %c = bitcast %b: I64
    %d = add %b, %c: I64
    je %n, hot, cold
  }

  hot {
    %e = add %d, 7: I64
    jmp end
  }

  cold {
    jmp end
  }

  end {
    %z = phi [hot, %e], [cold, %d]: I64
    ret %z
  }
}


