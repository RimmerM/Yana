
sourceUsedLater<complex>(%n: Int, %lim: Int): Int {
  start {
    %x = add %n, 1: Int
    jmp head
  }

  head {
    %p = phi [start, %x], [head, %q]: Int
    %q = add %p, %x: Int
    %v_0 = cmp_le %q, %lim: Int
    je %v_0, head, end
  }

  end {
    ret %p
  }
}

sharedSource<complex>(%n: Int): Int {
  start {
    %x = add %n, 1: Int
    jmp join
  }

  join {
    %p = phi [start, %x]: Int
    %q = phi [start, %x]: Int
    %r = add %p, %q: Int
    ret %r
  }
}

branchedSource<complex>(%n: Int, %c: Int): Int {
  start {
    %x = add %n, 1: Int
    je %c, a, b
  }

  a {
    %p = phi [start, %x]: Int
    ret %p
  }

  b {
    %q = phi [start, %x]: Int
    ret %q
  }
}

swap<complex>(%n: Int, %m: Int, %k: Int): Int {
  start {
    jmp head
  }

  head {
    %a = phi [start, %n], [head, %b]: Int
    %b = phi [start, %m], [head, %a]: Int
    %v_0 = cmp_le %a, %k: Int
    je %v_0, head, end
  }

  end {
    ret %a
  }
}

tiedSwap<complex>(%x: Long, %y: Long, %n: Int): Long {
  start {
    jmp head
  }

  head {
    %a = phi [start, %x], [body, %b2]: Long
    %b = phi [start, %y], [body, %a2]: Long
    %i = phi [start, %n], [body, %i2]: Int
    %v_0 = cmp_eq %i, 0: Int
    je %v_0, done, body
  }

  body {
    %a2 = add %a, %b: Long
    %b2 = sub %b, %a: Long
    %i2 = sub %i, 1: Int
    jmp head
  }

  done {
    %r = sub %a, %b: Long
    ret %r
  }
}

tiedNeighbour<complex>(%a: Int, %c: Int): Int {
  start {
    %g = add %a, 7: Int
    je %c, right, left
  }

  left {
    %x = add %g, 1: Int
    jmp join
  }

  right {
    %p = add %a, 2: Int
    %q = add %g, 3: Int
    %y = imul %p, %q: Int
    jmp join
  }

  join {
    %r = phi [left, %x], [right, %y]: Int
    %z = add %r, %g: Int
    ret %z
  }
}

chain<complex>(%x: Int, %c: Int): Int {
  start {
    je %c, l, r
  }

  l {
    %p = add %x, 1: Int
    jmp mid
  }

  r {
    %q = add %x, 2: Int
    jmp mid
  }

  mid {
    %m = phi [l, %p], [r, %q]: Int
    je %c, l2, r2
  }

  l2 {
    %s = add %m, 3: Int
    jmp end
  }

  r2 {
    %t = add %m, 4: Int
    jmp end
  }

  end {
    %z = phi [l2, %s], [r2, %t]: Int
    ret %z
  }
}


