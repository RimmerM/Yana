
sharedSource<complex>(%n: Int): Int {
  start {
    %x = add %n, 1: Int
    jmp join
  }

  join {
    %p = phi [start, %x]: Int
    %q = phi [start, %x]: Int
    %r = add %p, %q: Int
    ret %r
  }
}

swap<complex>(%n: Int, %m: Int, %k: Int): Int {
  start {
    jmp head
  }

  head {
    %a = phi [start, %n], [head, %b]: Int
    %b = phi [start, %m], [head, %a]: Int
    %v_0 = cmp_le %a, %k: Int
    je %v_0, head, end
  }

  end {
    ret %a
  }
}

sourceUsedLater<complex>(%n: Int, %lim: Int): Int {
  start {
    %x = add %n, 1: Int
    jmp head
  }

  head {
    %p = phi [start, %x], [head, %q]: Int
    %q = add %p, %x: Int
    %v_0 = cmp_le %q, %lim: Int
    je %v_0, head, end
  }

  end {
    ret %p
  }
}

branchedSource<complex>(%n: Int, %c: Int): Int {
  start {
    %x = add %n, 1: Int
    je %c, a, b
  }

  a {
    %p = phi [start, %x]: Int
    ret %p
  }

  b {
    %q = phi [start, %x]: Int
    ret %q
  }
}

chain<complex>(%x: Int, %c: Int): Int {
  start {
    je %c, l, r
  }

  l {
    %p = add %x, 1: Int
    jmp mid
  }

  r {
    %q = add %x, 2: Int
    jmp mid
  }

  mid {
    %m = phi [l, %p], [r, %q]: Int
    je %c, l2, r2
  }

  l2 {
    %s = add %m, 3: Int
    jmp end
  }

  r2 {
    %t = add %m, 4: Int
    jmp end
  }

  end {
    %z = phi [l2, %s], [r2, %t]: Int
    ret %z
  }
}


