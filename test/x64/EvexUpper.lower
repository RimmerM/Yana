# A negation is a pseudo - `vpxor` and `vpsubd` through a scratch register, written by its own emitter
# with no table to ask whether it may be spelled in EVEX - so its operand and its result stay in the
# lower sixteen however many other vectors are live, and the twenty others take the upper half. What
# is asserted is the placement rule (`MachineForm::namesUpperVectors`) as much as the bytes: the
# verifier refuses an instruction reading a register its form cannot name.
lowOnly(%p: Ptr): i32x4 {
    {
        %l0 = load %p, 16: i32x4
        %o1 = add %p, 16L: Ptr
        %l1 = load %o1, 16: i32x4
        %o2 = add %p, 32L: Ptr
        %l2 = load %o2, 16: i32x4
        %o3 = add %p, 48L: Ptr
        %l3 = load %o3, 16: i32x4
        %o4 = add %p, 64L: Ptr
        %l4 = load %o4, 16: i32x4
        %o5 = add %p, 80L: Ptr
        %l5 = load %o5, 16: i32x4
        %o6 = add %p, 96L: Ptr
        %l6 = load %o6, 16: i32x4
        %o7 = add %p, 112L: Ptr
        %l7 = load %o7, 16: i32x4
        %o8 = add %p, 128L: Ptr
        %l8 = load %o8, 16: i32x4
        %o9 = add %p, 144L: Ptr
        %l9 = load %o9, 16: i32x4
        %o10 = add %p, 160L: Ptr
        %l10 = load %o10, 16: i32x4
        %o11 = add %p, 176L: Ptr
        %l11 = load %o11, 16: i32x4
        %o12 = add %p, 192L: Ptr
        %l12 = load %o12, 16: i32x4
        %o13 = add %p, 208L: Ptr
        %l13 = load %o13, 16: i32x4
        %o14 = add %p, 224L: Ptr
        %l14 = load %o14, 16: i32x4
        %o15 = add %p, 240L: Ptr
        %l15 = load %o15, 16: i32x4
        %o16 = add %p, 256L: Ptr
        %l16 = load %o16, 16: i32x4
        %o17 = add %p, 272L: Ptr
        %l17 = load %o17, 16: i32x4
        %o18 = add %p, 288L: Ptr
        %l18 = load %o18, 16: i32x4
        %o19 = add %p, 304L: Ptr
        %l19 = load %o19, 16: i32x4
        %o20 = add %p, 320L: Ptr
        %l20 = load %o20, 16: i32x4
        %o21 = add %p, 336L: Ptr
        %l21 = load %o21, 16: i32x4
        %sel = neg %l21: i32x4
        %t0 = add %sel, %l1: i32x4
        %t1 = add %l2, %l3: i32x4
        %t2 = add %l4, %l5: i32x4
        %t3 = add %l6, %l7: i32x4
        %t4 = add %l8, %l9: i32x4
        %t5 = add %l10, %l11: i32x4
        %t6 = add %l12, %l13: i32x4
        %t7 = add %l14, %l15: i32x4
        %t8 = add %l16, %l17: i32x4
        %t9 = add %l18, %l19: i32x4
        %t10 = add %t0, %t1: i32x4
        %t11 = add %t2, %t3: i32x4
        %t12 = add %t4, %t5: i32x4
        %t13 = add %t6, %t7: i32x4
        %t14 = add %t8, %t9: i32x4
        %t15 = add %t10, %t11: i32x4
        %t16 = add %t12, %t13: i32x4
        %t17 = add %t14, %l20: i32x4
        %t18 = add %t15, %t16: i32x4
        %t19 = add %t18, %t17: i32x4
        ret %t19
    }
}

# The fifth thing that forces EVEX, with no register past fifteen anywhere: a displacement that needs
# four bytes under VEX and divides into one under EVEX's scale. `[rdi + 800]` read as a double is eight
# bytes as `vmovsd` and seven as the EVEX one with a displacement of 100; `[rdi + 1600]` as a vector of
# sixteen bytes is the same trade. `[rdi + 804]` divides by nothing and stays VEX.
farLoads(%p: Ptr): F64 {
    {
        %a = add %p, 800L: Ptr
        %x = load %a, 8: F64
        %b = add %p, 804L: Ptr
        %y = load %b, 8: F64
        %s = add %x, %y: F64
        %c = add %p, 1600L: Ptr
        %v = load %c, 16: f64x2
        %d = add %p, 96L: Ptr
        %w = load %d, 16: f64x2
        %u = add %v, %w: f64x2
        store %p, %u, 16
        ret %s
    }
}
