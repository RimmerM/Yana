# The upper sixteen vector registers, and the rule for when a vector instruction is EVEX-encoded.
#
# extensions: avx512
#
# Analysis-Avx512.md §1.1 and §1.2's stage 1. **An instruction is EVEX-encoded where its operands need
# it and VEX-encoded everywhere else**: the choice is made once the bytes exist, because only placement
# knows whether xmm17 was used. What forces EVEX is a register at or above sixteen in any of the three
# fields, a form with no VEX spelling, or the compressed displacement - disp8*N - being shorter than
# the four bytes VEX would write.
#
# Every function below keeps more vector values live at once than the lower sixteen registers hold, so
# the allocator has to reach the upper half, and every family that reaches it is here: the scalar and
# packed arithmetic, the transfers (whose EVEX.W is the element's and not VEX's), a shift by an
# immediate (whose destination is `vvvv`, and whose fifth bit is V'), and the copies and spills
# `genMoves` writes.
#
# Extracting the `=>` bytes and running `objdump -b binary -m i386:x86-64 -D` over them is the check
# that `evexSpellingOf` reads as the instructions it claims - the golden records bytes and nothing else
# can say what they mean.

# Twenty-four doubles live at once. The first sixteen go where they always went and the last eight are
# xmm16-23; every operation reading one of those is EVEX, and every one that reads none stays VEX.
# The loads are `movsd` at an offset that is a multiple of eight, so the ones in the upper registers
# carry the displacement as one byte scaled by eight.
floats24(%p: Ptr): F64 {
    {
        %l0 = load %p, 8: F64
        %o1 = add %p, 8L: Ptr
        %l1 = load %o1, 8: F64
        %o2 = add %p, 16L: Ptr
        %l2 = load %o2, 8: F64
        %o3 = add %p, 24L: Ptr
        %l3 = load %o3, 8: F64
        %o4 = add %p, 32L: Ptr
        %l4 = load %o4, 8: F64
        %o5 = add %p, 40L: Ptr
        %l5 = load %o5, 8: F64
        %o6 = add %p, 48L: Ptr
        %l6 = load %o6, 8: F64
        %o7 = add %p, 56L: Ptr
        %l7 = load %o7, 8: F64
        %o8 = add %p, 64L: Ptr
        %l8 = load %o8, 8: F64
        %o9 = add %p, 72L: Ptr
        %l9 = load %o9, 8: F64
        %o10 = add %p, 80L: Ptr
        %l10 = load %o10, 8: F64
        %o11 = add %p, 88L: Ptr
        %l11 = load %o11, 8: F64
        %o12 = add %p, 96L: Ptr
        %l12 = load %o12, 8: F64
        %o13 = add %p, 104L: Ptr
        %l13 = load %o13, 8: F64
        %o14 = add %p, 112L: Ptr
        %l14 = load %o14, 8: F64
        %o15 = add %p, 120L: Ptr
        %l15 = load %o15, 8: F64
        %o16 = add %p, 128L: Ptr
        %l16 = load %o16, 8: F64
        %o17 = add %p, 136L: Ptr
        %l17 = load %o17, 8: F64
        %o18 = add %p, 144L: Ptr
        %l18 = load %o18, 8: F64
        %o19 = add %p, 152L: Ptr
        %l19 = load %o19, 8: F64
        %o20 = add %p, 160L: Ptr
        %l20 = load %o20, 8: F64
        %o21 = add %p, 168L: Ptr
        %l21 = load %o21, 8: F64
        %o22 = add %p, 176L: Ptr
        %l22 = load %o22, 8: F64
        %o23 = add %p, 184L: Ptr
        %l23 = load %o23, 8: F64
        %t0 = add %l0, %l1: F64
        %t1 = sub %l2, %l3: F64
        %t2 = mul %l4, %l5: F64
        %t3 = div %l6, %l7: F64
        %t4 = add %l8, %l9: F64
        %t5 = sub %l10, %l11: F64
        %t6 = mul %l12, %l13: F64
        %t7 = div %l14, %l15: F64
        %t8 = add %l16, %l17: F64
        %t9 = sub %l18, %l19: F64
        %t10 = mul %l20, %l21: F64
        %t11 = div %l22, %l23: F64
        %t12 = add %t0, %t1: F64
        %t13 = sub %t2, %t3: F64
        %t14 = mul %t4, %t5: F64
        %t15 = div %t6, %t7: F64
        %t16 = add %t8, %t9: F64
        %t17 = sub %t10, %t11: F64
        %t18 = mul %t12, %t13: F64
        %t19 = div %t14, %t15: F64
        %t20 = add %t16, %t17: F64
        %t21 = sub %t18, %t19: F64
        %t22 = mul %t21, %t20: F64
        ret %t22
    }
}

