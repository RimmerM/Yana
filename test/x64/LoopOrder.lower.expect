
exitDeclaredFirst<complex>(%n: Int): Int {
  start {
    %z = cast 0: Int
    jmp head
  }

  head {
    %i = phi [start, %z], [body, %i2]: Int
    %v_0 = cmp_ige %i, %n: Int
    je %v_0, out, body
  }

  body {
    %i2 = add %i, 1: Int
    jmp head
  }

  out {
    ret %i
  }
}

bodyDeclaredFirst<complex>(%n: Int): Int {
  start {
    %z = cast 0: Int
    jmp head
  }

  head {
    %i = phi [start, %z], [body, %i2]: Int
    %v_0 = cmp_ilt %i, %n: Int
    je %v_0, body, out
  }

  body {
    %i2 = add %i, 1: Int
    jmp head
  }

  out {
    ret %i
  }
}

twoBackEdges<complex>(%n: Int, %c: Int): Int {
  start {
    %z = cast 0: Int
    jmp head
  }

  head {
    %i = phi [start, %z], [left, %l], [right, %r]: Int
    %v_0 = cmp_ige %i, %n: Int
    je %v_0, out, split
  }

  split {
    je %c, left, right
  }

  left {
    %l = add %i, 1: Int
    jmp head
  }

  right {
    %r = add %i, 2: Int
    jmp head
  }

  out {
    ret %i
  }
}

nested<complex>(%n: Int, %m: Int): Int {
  start {
    %z = cast 0: Int
    jmp outer
  }

  outer {
    %i = phi [start, %z], [outerEnd, %i2]: Int
    %acc = phi [start, %z], [outerEnd, %acc2]: Int
    %v_0 = cmp_ige %i, %n: Int
    je %v_0, done, innerHead
  }

  innerHead {
    %j = phi [outer, %z], [innerBody, %j2]: Int
    %a = phi [outer, %acc], [innerBody, %a2]: Int
    %v_1 = cmp_ige %j, %m: Int
    je %v_1, outerEnd, innerBody
  }

  innerBody {
    %a2 = add %a, %j: Int
    %j2 = add %j, 1: Int
    jmp innerHead
  }

  outerEnd {
    %acc2 = add %a, 1: Int
    %i2 = add %i, 1: Int
    jmp outer
  }

  done {
    ret %acc
  }
}

declaredOutOfOrder<complex>(%n: Int): Int {
  start {
    %z = cast 0: Int
    jmp head
  }

  head {
    %i = phi [start, %z], [body, %i2]: Int
    %v_0 = cmp_ige %i, %n: Int
    je %v_0, out, body
  }

  out {
    ret %i
  }

  body {
    %i2 = add %i, 1: Int
    jmp head
  }
}

branchInBody<complex>(%n: Int, %c: Int): Int {
  start {
    %z = cast 0: Int
    jmp head
  }

  head {
    %i = phi [start, %z], [join, %i2]: Int
    %v_0 = cmp_ige %i, %n: Int
    je %v_0, out, test
  }

  test {
    je %c, even, odd
  }

  even {
    %e = add %i, 2: Int
    jmp join
  }

  odd {
    %o = add %i, 1: Int
    jmp join
  }

  join {
    %i2 = phi [even, %e], [odd, %o]: Int
    jmp head
  }

  out {
    ret %i
  }
}


