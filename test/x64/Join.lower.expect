
critEdge<complex>(%n: Int, %m: Int, %c: Int): Int {
  start {
    je %c, a, b
  }

  a {
    %p = phi [start, %n]: Int
    ret %p
  }

  b {
    %q = phi [start, %m]: Int
    ret %q
  }
}

outOfOrder<complex>(%n: Int): Int {
  start {
    %x = add %n, 1: Int
    jmp b
  }

  a {
    %y = add %x, 2: Int
    ret %y
  }

  b {
    %z = add %n, 3: Int
    jmp a
  }
}

diverge<complex>(%n: Int, %d: Int, %c: Int): Int {
  start {
    %x = add %n, 1: Int
    je %c, a, b
  }

  a {
    %q = div %d, %n: Int
    jmp end
  }

  b {
    %r = add %d, %n: Int
    jmp end
  }

  end {
    ret %x
  }
}

earlyExit<complex>(%a: Int, %b: Int, %c: Int): Int {
  start {
    %keep = add %a, 7: Int
    %v_0 = cmp_eq %c, 0: Int
    je %v_0, quick, slow
  }

  quick {
    ret %keep
  }

  slow {
    %d = idiv %a, %b: Int
    %e = irem %a, %b: Int
    %f = add %d, %e: Int
    %g = add %f, %keep: Int
    ret %g
  }
}


