
diverge<complex>(%n: I32, %d: I32, %c: I32): I32 {
  start {
    %x = add %n, 1: I32
    je %c, a, b
  }

  a {
    %q = div %d, %n: I32
    jmp end
  }

  b {
    %r = add %d, %n: I32
    jmp end
  }

  end {
    ret %x
  }
}

critEdge<complex>(%n: I32, %m: I32, %c: I32): I32 {
  start {
    je %c, a, b
  }

  a {
    %p = phi [start, %n]: I32
    ret %p
  }

  b {
    %q = phi [start, %m]: I32
    ret %q
  }
}

outOfOrder<complex>(%n: I32): I32 {
  start {
    %x = add %n, 1: I32
    jmp b
  }

  a {
    %y = add %x, 2: I32
    ret %y
  }

  b {
    %z = add %n, 3: I32
    jmp a
  }
}

earlyExit<complex>(%a: I32, %b: I32, %c: I32): I32 {
