# `VectorTransfers.lower` at `avx512`, where every lane is one masked move - Analysis-Avx512.md §3.5.
#
#   - **the load is `vmovdqu8/16/32/64`, `vmovups`/`vmovupd` with `{k}{z}`** and the store the same
#     rows with `{k}` and a memory destination (EVEX.F2/F3.0F 6F/7F, 0F 10/11, 66.0F 10/11);
#   - the mask is `bzhi` of all ones at the count and a `kmov`, behind a clamp of the count into
#     0..lanes unless its known bits keep it inside a byte;
#   - a constant count in range makes the mask a constant.
#
# extensions: avx512

loadUpTo8x16(%p: Ptr, %n: I64): i8x16 {
    {
        %r = vloadupto %p, %n: i8x16
        ret %r
    }
}

storeUpTo8x16(%p: Ptr, %n: I64, %v: i8x16) {
    {
        vstoreupto %p, %n, %v
        ret
    }
}

loadUpTo16x8(%p: Ptr, %n: I64): i16x8 {
    {
        %r = vloadupto %p, %n: i16x8
        ret %r
    }
}

storeUpTo16x8(%p: Ptr, %n: I64, %v: i16x8) {
    {
        vstoreupto %p, %n, %v
        ret
    }
}

loadUpTo32x4(%p: Ptr, %n: I64): i32x4 {
    {
        %r = vloadupto %p, %n: i32x4
        ret %r
    }
}

storeUpTo32x4(%p: Ptr, %n: I64, %v: i32x4) {
    {
        vstoreupto %p, %n, %v
        ret
    }
}

loadUpTo64x2(%p: Ptr, %n: I64): i64x2 {
    {
        %r = vloadupto %p, %n: i64x2
        ret %r
    }
}

storeUpTo64x2(%p: Ptr, %n: I64, %v: i64x2) {
    {
        vstoreupto %p, %n, %v
        ret
    }
}

loadUpTof32x4(%p: Ptr, %n: I64): f32x4 {
    {
        %r = vloadupto %p, %n: f32x4
        ret %r
    }
}

storeUpTof32x4(%p: Ptr, %n: I64, %v: f32x4) {
    {
        vstoreupto %p, %n, %v
        ret
    }
}

loadUpTof64x2(%p: Ptr, %n: I64): f64x2 {
    {
        %r = vloadupto %p, %n: f64x2
        ret %r
    }
}

storeUpTof64x2(%p: Ptr, %n: I64, %v: f64x2) {
    {
        vstoreupto %p, %n, %v
        ret
    }
}

loadUpTo8x32(%p: Ptr, %n: I64): i8x32 {
    {
        %r = vloadupto %p, %n: i8x32
        ret %r
    }
}

storeUpTo8x32(%p: Ptr, %n: I64, %v: i8x32) {
    {
        vstoreupto %p, %n, %v
        ret
    }
}

loadUpTo32x8(%p: Ptr, %n: I64): i32x8 {
    {
        %r = vloadupto %p, %n: i32x8
        ret %r
    }
}

storeUpTo32x8(%p: Ptr, %n: I64, %v: i32x8) {
    {
        vstoreupto %p, %n, %v
        ret
    }
}

loadUpTof64x4(%p: Ptr, %n: I64): f64x4 {
    {
        %r = vloadupto %p, %n: f64x4
        ret %r
    }
}

storeUpTof64x4(%p: Ptr, %n: I64, %v: f64x4) {
    {
        vstoreupto %p, %n, %v
        ret
    }
}

# A count whose known bits keep it inside a byte needs no clamp in front of `bzhi`, and a constant
# one is decided outright: nothing at zero, the plain transfer at the lanes, a constant mask between.
loadUpToMasked8x32(%p: Ptr, %n: I64): i8x32 {
    {
        %m = imm 31L: I64
        %c = and %n, %m: I64
        %r = vloadupto %p, %c: i8x32
        ret %r
    }
}

storeUpToConstants8x16(%p: Ptr, %v: i8x16) {
    {
        %none = imm 0L: I64
        vstoreupto %p, %none, %v
        %all = imm 16L: I64
        vstoreupto %p, %all, %v
        %some = imm 5L: I64
        vstoreupto %p, %some, %v
        ret
    }
}
