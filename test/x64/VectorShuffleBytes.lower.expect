
swapWords<complex>(%v: i8x16): i8x16 {
  b_0 {
    %r = vshuffle %v, %v, 3, 2, 1, 0, 7, 6, 5, 4, 11, 10, 9, 8, 15, 14, 13, 12: i8x16
    ret %r
  }
}

