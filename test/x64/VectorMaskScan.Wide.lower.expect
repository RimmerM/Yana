    %m = cmp_eq %a, %b: m8x32
    %any = vreduce_or %m: Int
    je %any, hit, miss
  }

  hit {
    %f = vreduce_first %m: Int
    ret %f
  }

  miss {
    ret 18446744073709551615
  }
}

