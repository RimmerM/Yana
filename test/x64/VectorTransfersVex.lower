# `VectorTransfers.lower` at `avx2`.
#
#   - **four- and eight-byte lanes are `vpmaskmovd`/`q`** (VEX.66.0F38.W0/W1 8C to load, 8E to
#     store), the mask a vector of whole lanes built as `iota .< splat(count)` at the lane's width -
#     after a clamp into 0..lanes where the lane is four bytes and the count has to be truncated;
#   - bytes and words are still the ladder, with a sixteen-byte rung at thirty-two bytes.
#
# extensions: avx2

loadUpTo8x16(%p: Ptr, %n: I64): i8x16 {
    {
        %r = vloadupto %p, %n: i8x16
        ret %r
    }
}

storeUpTo8x16(%p: Ptr, %n: I64, %v: i8x16) {
    {
        vstoreupto %p, %n, %v
        ret
    }
}

loadUpTo16x8(%p: Ptr, %n: I64): i16x8 {
    {
        %r = vloadupto %p, %n: i16x8
        ret %r
    }
}

storeUpTo16x8(%p: Ptr, %n: I64, %v: i16x8) {
    {
        vstoreupto %p, %n, %v
        ret
    }
}

