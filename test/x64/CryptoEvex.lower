# AES-NI and PCLMULQDQ reaching the upper sixteen vector registers - Analysis-Avx512.md §1.2 and §4.1-4.2.
#
# extensions: avx512
#
# The four rounds and the carryless multiply have EVEX spellings (VAES and VPCLMULQDQ with VL, both
# implied by the level), so `evexSpellingOf` answers for them and a web they read may be placed in
# xmm16-31; the prefix writer then re-spells the instruction as EVEX there and nowhere else. `aesimc`
# and `aeskeygenassist` have no EVEX spelling - their webs stay in the lower sixteen for their whole
# life, which `verifyAllocation` checks per instruction.
#
# Each function keeps twenty-four blocks live at once, as `EvexUpper.lower` does, so that the last
# eight are in the upper registers. Running `objdump -b binary -m i386:x86-64 -D` over the `=>` bytes
# is what says the table reads as `vaesenc`, `vpclmulqdq` and the rest.

# The four rounds at 128 bits, each pairing one block with another so that all twenty-four are live
# until the second half of the pairs is reached. The key schedule's two at the end, in the lower sixteen.
rounds24(%p: Ptr): i8x16 {
    {
        %l0 = load %p, 16: i8x16
        %o1 = add %p, 16L: Ptr
        %l1 = load %o1, 16: i8x16
        %o2 = add %p, 32L: Ptr
        %l2 = load %o2, 16: i8x16
        %o3 = add %p, 48L: Ptr
        %l3 = load %o3, 16: i8x16
        %o4 = add %p, 64L: Ptr
        %l4 = load %o4, 16: i8x16
        %o5 = add %p, 80L: Ptr
        %l5 = load %o5, 16: i8x16
        %o6 = add %p, 96L: Ptr
        %l6 = load %o6, 16: i8x16
        %o7 = add %p, 112L: Ptr
        %l7 = load %o7, 16: i8x16
        %o8 = add %p, 128L: Ptr
        %l8 = load %o8, 16: i8x16
        %o9 = add %p, 144L: Ptr
        %l9 = load %o9, 16: i8x16
        %o10 = add %p, 160L: Ptr
        %l10 = load %o10, 16: i8x16
        %o11 = add %p, 176L: Ptr
        %l11 = load %o11, 16: i8x16
        %o12 = add %p, 192L: Ptr
        %l12 = load %o12, 16: i8x16
        %o13 = add %p, 208L: Ptr
        %l13 = load %o13, 16: i8x16
        %o14 = add %p, 224L: Ptr
        %l14 = load %o14, 16: i8x16
        %o15 = add %p, 240L: Ptr
        %l15 = load %o15, 16: i8x16
        %o16 = add %p, 256L: Ptr
        %l16 = load %o16, 16: i8x16
        %o17 = add %p, 272L: Ptr
        %l17 = load %o17, 16: i8x16
        %o18 = add %p, 288L: Ptr
        %l18 = load %o18, 16: i8x16
        %o19 = add %p, 304L: Ptr
        %l19 = load %o19, 16: i8x16
        %o20 = add %p, 320L: Ptr
        %l20 = load %o20, 16: i8x16
        %o21 = add %p, 336L: Ptr
        %l21 = load %o21, 16: i8x16
        %o22 = add %p, 352L: Ptr
        %l22 = load %o22, 16: i8x16
        %o23 = add %p, 368L: Ptr
        %l23 = load %o23, 16: i8x16
        %t0 = aesenc %l0, %l23: i8x16
        %t1 = aesenclast %l1, %l22: i8x16
        %t2 = aesdec %l2, %l21: i8x16
        %t3 = aesdeclast %l3, %l20: i8x16
        %t4 = aesenc %l4, %l19: i8x16
        %t5 = aesenclast %l5, %l18: i8x16
        %t6 = aesdec %l6, %l17: i8x16
        %t7 = aesdeclast %l7, %l16: i8x16
        %t8 = aesenc %l8, %l15: i8x16
        %t9 = aesenclast %l9, %l14: i8x16
        %t10 = aesdec %l10, %l13: i8x16
        %t11 = aesdeclast %l11, %l12: i8x16
        %t12 = aesenc %l12, %l11: i8x16
        %t13 = aesenclast %l13, %l10: i8x16
        %t14 = aesdec %l14, %l9: i8x16
        %t15 = aesdeclast %l15, %l8: i8x16
        %t16 = aesenc %l16, %l7: i8x16
        %t17 = aesenclast %l17, %l6: i8x16
        %t18 = aesdec %l18, %l5: i8x16
        %t19 = aesdeclast %l19, %l4: i8x16
        %t20 = aesenc %l20, %l3: i8x16
        %t21 = aesenclast %l21, %l2: i8x16
        %t22 = aesdec %l22, %l1: i8x16
        %t23 = aesdeclast %l23, %l0: i8x16
        %a1 = xor %t0, %t1: i8x16
        %a2 = xor %a1, %t2: i8x16
        %a3 = xor %a2, %t3: i8x16
        %a4 = xor %a3, %t4: i8x16
        %a5 = xor %a4, %t5: i8x16
        %a6 = xor %a5, %t6: i8x16
        %a7 = xor %a6, %t7: i8x16
        %a8 = xor %a7, %t8: i8x16
        %a9 = xor %a8, %t9: i8x16
        %a10 = xor %a9, %t10: i8x16
        %a11 = xor %a10, %t11: i8x16
        %a12 = xor %a11, %t12: i8x16
        %a13 = xor %a12, %t13: i8x16
        %a14 = xor %a13, %t14: i8x16
        %a15 = xor %a14, %t15: i8x16
        %a16 = xor %a15, %t16: i8x16
        %a17 = xor %a16, %t17: i8x16
        %a18 = xor %a17, %t18: i8x16
        %a19 = xor %a18, %t19: i8x16
        %a20 = xor %a19, %t20: i8x16
        %a21 = xor %a20, %t21: i8x16
        %a22 = xor %a21, %t22: i8x16
        %a23 = xor %a22, %t23: i8x16
        %m = aesimc %a23: i8x16
        %x = aeskeygenassist %m, 1: i8x16
        ret %x
    }
}

