
search<complex>(%v: I32): I32 {
  start {
    switch %v, other, [a0, 0], [a1, 4], [a2, 8], [a3, 12], [a4, 16], [a5, 20], [a6, 24], [a7, 28], [a8, 32], [a9, 36], [a10, 40], [a11, 44], [a12, 48], [a13, 52], [a14, 56], [a15, 60]
  }

  a0 {
    ret 10
  }

  a1 {
    ret 20
  }

  a2 {
    ret 30
  }

  a3 {
    ret 40
  }

  a4 {
    ret 50
  }

  a5 {
    ret 60
  }

  a6 {
    ret 70
  }

  a7 {
    ret 80
  }

  a8 {
    ret 90
  }

  a9 {
    ret 100
  }

  a10 {
    ret 110
  }

  a11 {
    ret 120
  }

  a12 {
    ret 130
  }

  a13 {
    ret 140
  }

  a14 {
    ret 150
  }

  a15 {
    ret 160
  }

  other {
    ret 0
  }
}

small<complex>(%v: I32): I32 {
  start {
    switch %v, other, [a0, 0], [a1, 1], [a2, 2]
  }

  a0 {
    ret 10
  }

  a1 {
    ret 20
  }

  a2 {
    ret 30
  }

  other {
    ret 0
  }
}


