# Benchmark shapes, System V on both sides so the comparison is between the two register allocators
# and nothing else. Every load is from a distinct address, so there is no common subexpression for a
# mid-level pass to remove and neither compiler is being asked to do work the other is not.

sink<sysv>(%x: I32): I32 {
    { ret %x }
}

# Eight pointers live across a call, each dereferenced four times afterwards. System V preserves six
# registers, so two of the eight cannot stay in one for their whole life.
acrossCall<sysv>(%n: I32, %p0: Ptr, %p1: Ptr, %p2: Ptr, %p3: Ptr, %p4: Ptr, %p5: Ptr, %p6: Ptr, %p7: Ptr): I64 {
    {
        %r = call_sysv sink, %n: I32

        %a0 = load %p0, 8: I64
        %a1 = load %p1, 8: I64
        %t0 = add %a0, %a1: I64
        %a2 = load %p2, 8: I64
        %t1 = add %t0, %a2: I64
        %a3 = load %p3, 8: I64
        %t2 = add %t1, %a3: I64
        %a4 = load %p4, 8: I64
        %t3 = add %t2, %a4: I64
        %a5 = load %p5, 8: I64
        %t4 = add %t3, %a5: I64
        %a6 = load %p6, 8: I64
        %t5 = add %t4, %a6: I64
        %a7 = load %p7, 8: I64
        %t6 = add %t5, %a7: I64

        %b0 = load %p0, 8: I64
        %t7 = add %t6, %b0: I64
        %b1 = load %p1, 8: I64
        %t8 = add %t7, %b1: I64
        %b2 = load %p2, 8: I64
        %t9 = add %t8, %b2: I64
        %b3 = load %p3, 8: I64
        %t10 = add %t9, %b3: I64
        %b4 = load %p4, 8: I64
        %t11 = add %t10, %b4: I64
        %b5 = load %p5, 8: I64
        %t12 = add %t11, %b5: I64
        %b6 = load %p6, 8: I64
        %t13 = add %t12, %b6: I64
        %b7 = load %p7, 8: I64
        %t14 = add %t13, %b7: I64

        %c0 = load %p0, 8: I64
        %t15 = add %t14, %c0: I64
        %c1 = load %p1, 8: I64
        %t16 = add %t15, %c1: I64
        %c2 = load %p2, 8: I64
        %t17 = add %t16, %c2: I64
        %c3 = load %p3, 8: I64
        %t18 = add %t17, %c3: I64
        %c4 = load %p4, 8: I64
        %t19 = add %t18, %c4: I64
        %c5 = load %p5, 8: I64
        %t20 = add %t19, %c5: I64
        %c6 = load %p6, 8: I64
        %t21 = add %t20, %c6: I64
        %c7 = load %p7, 8: I64
        %t22 = add %t21, %c7: I64

        ret %t22
    }
}

# The same pressure inside a loop, so the reads are worth eight times what the call is.
loopCall<sysv>(%n: I32, %p0: Ptr, %p1: Ptr, %p2: Ptr, %p3: Ptr, %p4: Ptr, %p5: Ptr, %p6: Ptr, %p7: Ptr): I64 {
    entry {
        %zero = cast 0: I64
        jmp head
    }

    head {
        %i = phi [entry, %zero], [body, %i2]: I64
        %acc = phi [entry, %zero], [body, %acc2]: I64
        je %n, exit, body
    }

    body {
        %r = call_sysv sink, %n: I32

        %a0 = load %p0, 8: I64
        %a1 = load %p1, 8: I64
        %t0 = add %a0, %a1: I64
        %a2 = load %p2, 8: I64
        %t1 = add %t0, %a2: I64
        %a3 = load %p3, 8: I64
        %t2 = add %t1, %a3: I64
        %a4 = load %p4, 8: I64
        %t3 = add %t2, %a4: I64
        %a5 = load %p5, 8: I64
        %t4 = add %t3, %a5: I64
        %a6 = load %p6, 8: I64
        %t5 = add %t4, %a6: I64
        %a7 = load %p7, 8: I64
        %t6 = add %t5, %a7: I64

        %b0 = load %p0, 8: I64
        %u0 = add %t6, %b0: I64
        %b1 = load %p1, 8: I64
        %u1 = add %u0, %b1: I64
        %b2 = load %p2, 8: I64
        %u2 = add %u1, %b2: I64
        %b3 = load %p3, 8: I64
        %u3 = add %u2, %b3: I64
        %b4 = load %p4, 8: I64
        %u4 = add %u3, %b4: I64
        %b5 = load %p5, 8: I64
        %u5 = add %u4, %b5: I64
        %b6 = load %p6, 8: I64
        %u6 = add %u5, %b6: I64
        %b7 = load %p7, 8: I64
        %u7 = add %u6, %b7: I64

        %c0 = load %p0, 8: I64
        %v0 = add %u7, %c0: I64
        %c1 = load %p1, 8: I64
        %v1 = add %v0, %c1: I64
        %c2 = load %p2, 8: I64
        %v2 = add %v1, %c2: I64
        %c3 = load %p3, 8: I64
        %v3 = add %v2, %c3: I64
        %c4 = load %p4, 8: I64
        %v4 = add %v3, %c4: I64
        %c5 = load %p5, 8: I64
        %v5 = add %v4, %c5: I64
        %c6 = load %p6, 8: I64
        %v6 = add %v5, %c6: I64
        %c7 = load %p7, 8: I64
        %v7 = add %v6, %c7: I64

        %acc2 = add %acc, %v7: I64
        %i2 = add %i, 1L: I64
        jmp head
    }

    exit {
        ret %acc
    }
}

# A call on an arm the IR says is taken one time in a thousand, with the reads in the loop around it.
coldCall<sysv>(%n: I32, %p0: Ptr, %p1: Ptr, %p2: Ptr, %p3: Ptr, %p4: Ptr, %p5: Ptr, %p6: Ptr, %p7: Ptr): I64 {
    entry {
        %zero = cast 0: I64
        jmp head
    }

    head {
        %i = phi [entry, %zero], [rejoin, %i2]: I64
        %acc = phi [entry, %zero], [rejoin, %acc2]: I64
        je %n, exit, hot
    }

    hot {
        %a0 = load %p0, 8: I64
        %a1 = load %p1, 8: I64
        %t0 = add %a0, %a1: I64
        %a2 = load %p2, 8: I64
        %t1 = add %t0, %a2: I64
        %a3 = load %p3, 8: I64
        %t2 = add %t1, %a3: I64
        %a4 = load %p4, 8: I64
        %t3 = add %t2, %a4: I64
        %a5 = load %p5, 8: I64
        %t4 = add %t3, %a5: I64
        %a6 = load %p6, 8: I64
        %t5 = add %t4, %a6: I64
        %a7 = load %p7, 8: I64
        %t6 = add %t5, %a7: I64
        je %i, [rejoin, 999], [cold, 1]
    }

    cold {
        %r = call_sysv sink, %n: I32
        jmp rejoin
    }

    rejoin {
        %acc2 = add %acc, %t6: I64
        %i2 = add %i, 1L: I64
        jmp head
    }

    exit {
        ret %acc
    }
}
