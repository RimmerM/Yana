-- The semantic index, asked the questions an editor asks. Each caret in a comment marks the
-- character above it, and the driver answers definition, hover and references for every one of
-- them - see LspTester.cpp.

import Shapes

fn pick(a: Int, b: Int) -> Int = if a > b then a else b
-- ^decl                            ^use

fn main() -> Int:
    let &total = 0
--       ^local
    let c = Shapes.Circle {radius: 4}
--                 ^con
    total = total + area(c)
--  ^write          ^classfun
    total = total + scale(c, 2)
--                  ^call
    let p = Point {x: 1, y: 2}
--          ^con2
    total = total + p.x + sum(p)
--                    ^field
    let s = Square {side: 3}
    return pick(total, area(s))
--         ^pick       ^classfun2
--              ^sigFirst
--                     ^sigSecond
--                          ^sigNested

-- Signature help where there is no call, and where the callee is a name nothing declares. Both
-- have to answer nothing rather than the nearest thing they can find. A declaration's own brackets
-- read exactly like a call and are not one, which is what the keyword in front of the name says.
fn quiet(n: Int) -> Int:
--       ^sigOutside
    return n + missingCallee(n)
--                           ^sigUnknown

-- Constructing a record is a call with arguments like any other, and its fields are its parameters
-- - so the same overlay answers for it. The second caret is inside a bare tuple, which has no name
-- in front of it and therefore no signature of its own: what a writer wants there is the call it is
-- an argument of, which is what walking outwards from the innermost bracket finds.
fn build() -> Int:
    let s = Square {side: 3}
--                        ^sigConstructor
    let p = Point {x: 1, y: 2}
--                       ^sigField
    return sum({x: 4, y: 5}) + area(s) + p.x
--                    ^sigTuple

-- What `explain` found and the source does not say - M9. `keep` writes what it was handed into
-- storage the caller also owns, so the loan cannot end at the call, and no part of the signature
-- says so. `plain` is here for the same reason the fixture has unsurprising functions in it at all:
-- a hover section that appeared under every declaration would be one nobody reads.
data Slot {value: Int}

fn keep(&slot: Slot, ->with: Slot) -> Int:
--  ^explained
    slot = with
    return slot.value

fn plain(n: Int) -> Int = n + 1
-- ^unexplained

-- A synthesized call is not an occurrence. `xs[1..3]` expands to a call of `slice`, which the
-- author did not write and which has no name in the source to hold an answer against - so it is
-- looked up at the whole subscript expression, a span the author wrote something else in.
--
-- The two carets are the two halves. `referenceAt` walks outwards until something answers, so the
-- one on `xs` was always right; the one inside the range has no answer of its own and used to reach
-- the subscript expression and report `fn slice(self: Flat(a), from: I64, to: I64)` - a signature
-- that is in no source file and cannot be gone to. Nothing synthesized is indexed, so it answers
-- nothing at all.
fn ranged(xs: [Int]) -> Int:
    let part = xs[1..3]
--             ^sliced
--                ^inRange
    return length(part) :: Int

-- A `for` loop reaches its iterator by name, and the name is what an occurrence is - the same split
-- `slice` above is about. The callee used to be recorded against the whole `counting(3)`, which the
-- arguments sit inside, so a cursor on the `3` - which has no answer of its own - walked outwards
-- and was told `iter fn counting`. `iterName` is the name itself, and still answers.
iter fn counting(limit: Int) -> Int:
    let &i = 0 :: Int

    while i < limit:
        yield i
        i = i + 1

fn counted() -> Int:
    let &sum = 0 :: Int

    for v in counting(3):
--           ^iterName
--                    ^iterLiteral
        sum = sum + v

    return sum
