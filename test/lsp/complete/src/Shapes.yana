-- The module the completion fixture's imported names come from. Two of the three imports in
-- Main.yana are of this one, which is what makes an include list and a `qualified` alias
-- observable: the same declaration has to appear under three different rules.

module

pub data Shape = Circle {radius: Int} | Square {side: Int}

pub data Point {x: Int, y: Int}

pub class Area(a):
    fn area(s: a) -> Int

instance Area(Shape):
    fn area(s: Shape) = match s:
        Circle(c) -> c.radius * c.radius * 3
        Square(q) -> q.side * q.side

pub fn scale(s: Shape, by: Int) -> Int = area(s) * by

pub fn scaleTwice(s: Shape) -> Int = scale(s, 2)

pub fn shapeOrigin() -> Point = Point {x: 0, y: 0}

-- A parameter whose type is a bare tuple, so that a literal written for it has field names to
-- complete against - which is the only way a tuple has any, since nothing else says what its
-- fields are called.
pub fn shapeAt(at: {x: Int, y: Int}) -> Int = at.x + at.y

-- A field with a declared default is not one the author has to write, so an item that inserts the
-- brackets leaves it out - the same distinction a call makes between an argument and no argument.
pub data Label {text: Int, weight: Int = 1}

-- The call-site half of the same thing: a trailing parameter with a default is not a position the
-- author has to write, so the snippet stops before it - and the default is shown in the detail,
-- since deciding whether to write the argument at all is what a reader needs it for.
pub fn shifted(s: Shape, by: Int = 1) -> Int = area(s) + by

{-
   A record of records, so that an update path has more than one segment to walk.
-}
pub data Line {from: Point, to: Point}

{-
   The two kinds of namespaced declaration, both of which take a `Point` first and only one of which
   a dot on a `Point` may offer - doc/spec/modules.md, "Namespaces".

   `Point.span` is in the receiver type's namespace, so `p.` offers it, and offers it under its last
   segment: `span` is what a dot-call writes and `Point.span` is not. `Corner.spanned` is a plain
   namespace that happens to take a `Point`, so the signature test alone would offer it under a name
   no call site could use - it must not appear in a member list at all.

   The two share a prefix on purpose. `Main.yana`'s `memberNamespace` marker filters a member list
   on `span`, so a skip that stopped working would put `spanned` in a list beside `span` rather than
   somewhere nothing looks.

   Both are `pub`, so an importer sees exactly what this module's own bodies do.
-}
pub fn Point.span(self: Point) -> Int = self.x + self.y

pub fn Corner.spanned(at: Point) -> Int = at.x

-- Unmarked, so it is private to this module and completion must not offer it. The counterpart of
-- `hiddenTwin` in Hidden.yana, from the other side of the boundary: that one is a `pub` declaration
-- an import list excludes, and this one is a declaration that is not offered to any import at all.
fn shapeInternal() -> Int = 41

data Internal {only: Int}

class Private(a):
    fn hidden(s: a) -> Int
