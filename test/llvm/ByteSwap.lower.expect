target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

define fastcc i32 @swap(i32 %a, i64 %b) {
  br label %1

1:                                                ; preds = %0
  %s = call i32 @llvm.bswap.i32(i32 %a)
  %w = call i64 @llvm.bswap.i64(i64 %b)
  ret i32 %s
}

define fastcc i64 @swapLoad(ptr %p) {
  br label %1

1:                                                ; preds = %0
  %2 = load i64, ptr %p, align 1
  %s = call i64 @llvm.bswap.i64(i64 %2)
  ret i64 %s
}

; Function Attrs: nocallback nofree nosync nounwind readnone speculatable willreturn
declare i32 @llvm.bswap.i32(i32) #0

; Function Attrs: nocallback nofree nosync nounwind readnone speculatable willreturn
declare i64 @llvm.bswap.i64(i64) #0

attributes #0 = { nocallback nofree nosync nounwind readnone speculatable willreturn }
