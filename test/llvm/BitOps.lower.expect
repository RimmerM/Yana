define fastcc i32 @twice(i32 %v, i32 %m) {
  br label %1

1:                                                ; preds = %0
  %a = call i32 @__yana_pext32(i32 %v, i32 %m)
  %b = call i32 @__yana_pext32(i32 %a, i32 %m)
  ret i32 %b
}

; Function Attrs: nounwind willreturn
define internal i32 @__yana_pext32(i32 %0, i32 %1) #0 {
entry:
  br label %loop

loop:                                             ; preds = %step, %entry
  %2 = phi i32 [ %1, %entry ], [ %11, %step ]
  %3 = phi i32 [ 1, %entry ], [ %12, %step ]
  %4 = phi i32 [ 0, %entry ], [ %13, %step ]
  %5 = icmp ne i32 %2, 0
  br i1 %5, label %step, label %done

step:                                             ; preds = %loop
  %6 = sub i32 0, %2
  %7 = and i32 %2, %6
  %8 = and i32 %0, %7
  %9 = icmp ne i32 %8, 0
  %10 = select i1 %9, i32 %3, i32 0
  %11 = xor i32 %2, %7
  %12 = shl i32 %3, 1
  %13 = or i32 %4, %10
  br label %loop

done:                                             ; preds = %loop
  ret i32 %4
}

