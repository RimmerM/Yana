target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

define fastcc i32 @low(i32 %v, i32 %n) {
  br label %1

1:                                                ; preds = %0
  %2 = icmp ult i32 %n, 32
  %3 = and i32 %n, 31
  %4 = shl i32 1, %3
  %5 = sub i32 %4, 1
  %6 = and i32 %v, %5
  %r = select i1 %2, i32 %6, i32 %v
  ret i32 %r
}

define fastcc i64 @low64(i64 %v, i64 %n) {
  br label %1

1:                                                ; preds = %0
  %2 = icmp ult i64 %n, 64
  %3 = and i64 %n, 63
  %4 = shl i64 1, %3
  %5 = sub i64 %4, 1
  %6 = and i64 %v, %5
  %r = select i1 %2, i64 %6, i64 %v
  ret i64 %r
}

define fastcc i32 @lowConstant(i32 %v) {
  br label %1

1:                                                ; preds = %0
  %2 = and i32 %v, 255
  %r = select i1 true, i32 %2, i32 %v
  ret i32 %r
}

define fastcc i32 @gather(i32 %v, i32 %m) {
  br label %1

1:                                                ; preds = %0
  %r = call i32 @llvm.x86.bmi.pext.32(i32 %v, i32 %m)
  ret i32 %r
}

define fastcc i32 @scatter(i32 %v, i32 %m) {
  br label %1

1:                                                ; preds = %0
  %r = call i32 @llvm.x86.bmi.pdep.32(i32 %v, i32 %m)
  ret i32 %r
}

define fastcc i64 @gather64(i64 %v, i64 %m) {
  br label %1

1:                                                ; preds = %0
  %r = call i64 @llvm.x86.bmi.pext.64(i64 %v, i64 %m)
  ret i64 %r
}

define fastcc i64 @scatter64(i64 %v, i64 %m) {
  br label %1

1:                                                ; preds = %0
  %r = call i64 @llvm.x86.bmi.pdep.64(i64 %v, i64 %m)
  ret i64 %r
}

define fastcc i32 @twice(i32 %v, i32 %m) {
  br label %1

1:                                                ; preds = %0
  %a = call i32 @llvm.x86.bmi.pext.32(i32 %v, i32 %m)
  %b = call i32 @llvm.x86.bmi.pext.32(i32 %a, i32 %m)
  ret i32 %b
}

; Function Attrs: nounwind readnone
declare i32 @llvm.x86.bmi.pext.32(i32, i32) #0

; Function Attrs: nounwind readnone
declare i32 @llvm.x86.bmi.pdep.32(i32, i32) #0

; Function Attrs: nounwind readnone
declare i64 @llvm.x86.bmi.pext.64(i64, i64) #0

; Function Attrs: nounwind readnone
declare i64 @llvm.x86.bmi.pdep.64(i64, i64) #0

attributes #0 = { nounwind readnone }
