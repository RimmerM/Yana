target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

define fastcc i32 @reads(ptr %p) #0 {
  br label %1

1:                                                ; preds = %0
  %2 = load volatile i32, ptr %p, align 1
  %3 = load volatile i32, ptr %p, align 1
  %c = add i32 %2, %3
  ret i32 %c
}

define fastcc i32 @writes(ptr %p, i32 %v) #0 {
  br label %1

1:                                                ; preds = %0
  store volatile i32 %v, ptr %p, align 1
  %2 = load volatile i32, ptr %p, align 1
  ret i32 %2
}

define fastcc i32 @atomicReads(ptr %p) #0 {
  br label %1

1:                                                ; preds = %0
  %a = load atomic volatile i32, ptr %p acquire, align 4
  %b = load atomic volatile i32, ptr %p monotonic, align 4
  %c = add i32 %a, %b
  ret i32 %c
}

define fastcc i32 @atomicWrites(ptr %p, i32 %v) #0 {
  br label %1

1:                                                ; preds = %0
  store atomic volatile i32 %v, ptr %p release, align 4
  %a = load atomic volatile i32, ptr %p monotonic, align 4
  ret i32 %a
}

define fastcc i32 @deadBranch(ptr %p, i32 %flag) #0 {
  br label %entry

entry:                                            ; preds = %0
  %1 = icmp ne i32 %flag, 0
  br i1 %1, label %yes, label %no

yes:                                              ; preds = %entry
  %2 = load volatile i32, ptr %p, align 1
  br label %join

no:                                               ; preds = %entry
  br label %join

join:                                             ; preds = %yes, %no
  store volatile i32 1, ptr %p, align 1
  ret i32 0
}

define fastcc i32 @poll(ptr %p, i32 %count) #0 {
  br label %entry

entry:                                            ; preds = %0
  br label %head

head:                                             ; preds = %body, %entry
  %i = phi i32 [ 0, %entry ], [ %next, %body ]
  %1 = icmp slt i32 %i, %count
  %2 = zext i1 %1 to i32
  br i1 %1, label %body, label %exit

body:                                             ; preds = %head
  %3 = load volatile i32, ptr %p, align 1
  %next = add i32 %i, 1
  br label %head

exit:                                             ; preds = %head
  ret i32 %i
}

define fastcc i32 @atomicSequential(ptr %p) #0 {
  br label %1

1:                                                ; preds = %0
  store atomic volatile i32 1, ptr %p seq_cst, align 4
  %a = load atomic volatile i32, ptr %p seq_cst, align 4
  ret i32 %a
}

attributes #0 = { "probe-stack"="inline-asm" }
