# The same three operations at v3, where two of them are an x86 intrinsic.
#
# extensions: v3
#
# BMI2 is v3, and this backend names it directly: `llvm.x86.bmi.pext.32` and its three siblings are
# the only way to reach `pext`/`pdep` from LLVM IR, there being no target-independent intrinsic for
# an arbitrary bit permutation. So the helper functions of BitOps.lower beside this file are gone and
# the four calls are four intrinsics.
#
# `hasBitPermute` in codegen/llvm/inst.cpp is what decides, and it asks the *build's* arch and level
# rather than the host - the same two fields `featuresOf` reads when the target machine is created,
# so an `-arch arm64` build never reaches the x86 intrinsic however new the machine compiling it is.
#
# `bitsupto` is unchanged and is the point of the contrast: it is written out at every level and left
# to LLVM, which selects `bzhi` for itself where the target has one. Naming an intrinsic for it would
# have bought nothing and lost every target that is not x86.

low(%v: I32, %n: I32): I32 {
    {
        %r = bitsupto %v, %n: I32
        ret %r
    }
}

low64(%v: I64, %n: I64): I64 {
    {
        %r = bitsupto %v, %n: I64
        ret %r
    }
}

# A constant count, which every tier above this one has already folded into an `and` - so what this
# asserts is only that the backend is not the thing that would have had to.
lowConstant(%v: I32): I32 {
    {
        %r = bitsupto %v, 8: I32
        ret %r
    }
}

gather(%v: I32, %m: I32): I32 {
    {
        %r = gatherbits %v, %m: I32
        ret %r
    }
}

scatter(%v: I32, %m: I32): I32 {
    {
        %r = scatterbits %v, %m: I32
        ret %r
    }
}

gather64(%v: I64, %m: I64): I64 {
    {
        %r = gatherbits %v, %m: I64
        ret %r
    }
}

scatter64(%v: I64, %m: I64): I64 {
    {
        %r = scatterbits %v, %m: I64
        ret %r
    }
}

# Two calls at one width, which take one helper between them.
twice(%v: I32, %m: I32): I32 {
    {
        %a = gatherbits %v, %m: I32
        %b = gatherbits %a, %m: I32
        ret %b
    }
}
