import Native

{-
   ------------------------------------------------------------------------------------------
   xxHash32 - Yann Collet's, and the fast one.
   ------------------------------------------------------------------------------------------

   Four independent accumulators over sixteen-byte stripes, which is why it is two and a half times
   Murmur3 on the same data: Murmur's chain is one multiply-rotate-multiply deep per four bytes and
   every step depends on the last, where these four run beside each other and the processor issues
   them together. A sixty-four-byte block is four stripes.

   The short-input path is a rule of the algorithm rather than an optimization: a message under
   sixteen bytes never enters the accumulators at all and starts from `seed + prime5`, so the
   accumulator merge is skipped and the answer is not what a zero-length stripe run would have
   produced.
-}
pub data XxHash32 {v1: U32, v2: U32, v3: U32, v4: U32, seed: U32}

let xxPrime1 = 2654435761 :: U32
let xxPrime2 = 2246822519 :: U32
let xxPrime3 = 3266489917 :: U32
let xxPrime4 = 668265263 :: U32
let xxPrime5 = 374761393 :: U32

pub fn newXxHash32() -> XxHash32 = seededXxHash32(0)

pub fn seededXxHash32(seed: U32) -> XxHash32 =
    XxHash32 {v1: seed + xxPrime1 + xxPrime2, v2: seed + xxPrime2, v3: seed,
              v4: seed - xxPrime1, seed: seed}

fn xxRound(accumulator: U32, lane: U32) -> U32 = ((accumulator + lane * xxPrime2) `rol` 13) * xxPrime1

{-
   The stripe walk, as a plain function so that it can have a second body.

   `compressBlocks` is a class member and a `@replaces` replaces a *function*, so the instance
   delegates and the replacement is written over this - the same move `Math.yana`'s vector `Real`
   instances make for the same reason.

   The walk itself is unchanged: four accumulators, one per word of a sixteen-byte stripe, each
   advanced by `xxRound`. It is also what the big-endian arm of the vector body below calls, which is
   why it is a third function rather than two.
-}
fn xxStripeWalk(&self: XxHash32, from: [U8], at: Size, stop: Size):
    let &v1 = self.v1
    let &v2 = self.v2
    let &v3 = self.v3
    let &v4 = self.v4
    let &i = at

    while i < stop:
        v1 = xxRound(v1, readLittleU32(from, i))
        v2 = xxRound(v2, readLittleU32(from, i + 4))
        v3 = xxRound(v3, readLittleU32(from, i + 8))
        v4 = xxRound(v4, readLittleU32(from, i + 12))
        i = i + 16

    self.v1 = v1
    self.v2 = v2
    self.v3 = v3
    self.v4 = v4

fn xxCompress(&self: XxHash32, from: [U8], at: Size, blocks: Size):
    xxStripeWalk(self, from, at, at + blocks * 64)

{-
   The same four accumulators as one four-lane register - Analysis-Avx512.md §4.4's first row.

   **The lanes are the algorithm's and not the machine's**, which is why the width is written:
   xxHash32 has exactly four accumulators and each one's next value depends on its own last, so
   there is no wider vector to grow into and `Vec(U32, 4)` at every level is the whole of the
   parallelism this digest has. What a wider register would be good for is several *messages* at
   once, which is a different interface (§4.4's multi-buffer row) and not this one.

   So the win, where there is one, is instruction count rather than width: `vpmulld`, `vpaddd` and
   §2.4's `vprold` are one instruction each against four, and the rotate is the one of the three
   that is three instructions below `avx512`. Whether that pays against four scalar chains the
   processor was already issuing together is a question about multiply latency on the part - which
   is why this is a replacement rather than the body, and why the baseline above is what
   `-no-replacements` and every non-native target run.

   **The stripe is read as one load and not as four.** `readLittleU32` is a load and a fold per word
   where the four together are sixteen contiguous bytes; on a little-endian target those bytes
   already *are* the four words in order, so the load is the whole conversion. On a big-endian one
   they are not, and rather than reach for a per-lane byte swap this hands the walk back - a target
   this library has never been compiled for should not be carrying an untested vector body. The
   comparison folds against `Target.byteOrder`, so nothing is tested at run time.
-}
@replaces @platform(native)
fn xxCompress(&self: XxHash32, from: [U8], at: Size, blocks: Size):
    let stop = at + blocks * 64

    if Target.byteOrder == Big:
        xxStripeWalk(self, from, at, stop)
        return

    let p1 = splat(xxPrime1) :: Vec(U32, 4)
    let p2 = splat(xxPrime2) :: Vec(U32, 4)
    let turn = splat(13 :: U32) :: Vec(U32, 4)

    let &acc = splat(self.v1) :: Vec(U32, 4)
    acc = withLane(acc, 1, self.v2)
    acc = withLane(acc, 2, self.v3)
    acc = withLane(acc, 3, self.v4)

    let &i = at

    while i < stop:
        let stripe = bitcast(loadVectorAt(from, i) :: Vec(U8, 16)) :: Vec(U32, 4)
        acc = ((acc + stripe * p2) `rol` turn) * p1
        i = i + 16

    self.v1 = lane(acc, 0)
    self.v2 = lane(acc, 1)
    self.v3 = lane(acc, 2)
    self.v4 = lane(acc, 3)

instance Block(XxHash32):
  fn compressBlocks(&self: XxHash32, from: [U8], at: Size, blocks: Size):
      xxCompress(self, from, at, blocks)

pub alias XxHash = Blocks(XxHash32)

instance Digest(Blocks(XxHash32), 4):
  fn newDigest() -> Blocks(XxHash32) = newBlocks(newXxHash32())

  fn update(&self: Blocks(XxHash32), from: [U8]): absorb(self, from)

  fn finish(->self: Blocks(XxHash32)) -> Fingerprint:
      let &running = self
      let used = running.used
      let &i = 0 :: Size

      -- Whole stripes still in the buffer. There can be up to three, since a fourth would have been
      -- a full block and would already have been compressed.
      while i + 16 <= used:
          running.state.v1 = xxRound(running.state.v1, readLittleU32(running.block, i))
          running.state.v2 = xxRound(running.state.v2, readLittleU32(running.block, i + 4))
          running.state.v3 = xxRound(running.state.v3, readLittleU32(running.block, i + 8))
          running.state.v4 = xxRound(running.state.v4, readLittleU32(running.block, i + 12))
          i = i + 16

      let &h = if running.total >= 16
               then ((running.state.v1 `rol` 1) + (running.state.v2 `rol` 7)) +
                    ((running.state.v3 `rol` 12) + (running.state.v4 `rol` 18))
               else running.state.seed + xxPrime5

      h = h + (truncate(running.total) :: U32)

      while i + 4 <= used:
          h = ((h + readLittleU32(running.block, i) * xxPrime3) `rol` 17) * xxPrime4
          i = i + 4

      while i < used:
          h = ((h + (running.block[i] :: U32) * xxPrime5) `rol` 11) * xxPrime1
          i = i + 1

      -- The avalanche. Not `mix32`: the shifts and the two constants are xxHash's own, and a digest
      -- that finalized with somebody else's would not be xxHash32.
      h = (h `xor` (h `shr` 15)) * xxPrime2
      h = (h `xor` (h `shr` 13)) * xxPrime3
      return bytesOfU32(h `xor` (h `shr` 16))

pub fn xxHash32Of(from: [U8]) -> Fingerprint:
    let &state = newDigest() :: XxHash
    update(state, from)
    return finish(state)

pub fn xxHash32ValueOf(from: [U8]) -> U32 = valueOfBytes(xxHash32Of(from))

-- The four bytes read back as the number they were, for the two hashes above whose callers want a
-- number. Big-endian, which is what `bytesOfU32` wrote, and the exact inverse of it.
pub fn valueOfBytes(value: [U8 *4]) -> U32 = readBigU32(value, 0)
