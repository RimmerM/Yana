    checkEqual(hexOf(whirlpoolOf(empty)), "19fa61d75522a4669b44e39c1d2e1726c530232130d407f89afee0964997f7a73e83be698b288febcf88e3e03c4f0757ea8964e59b63d93708b138cc42a66eb3")
    checkEqual(hexOf(whirlpoolOf(abc)), "4e2448a4c6f486bb16b6562c73b4020bf3043e3a731bce721ae1b303d97e6d4c7181eebdb6c57e277d0e34957114cbd6c797fc9d95d8b582d225292076d4eef5")
    checkEqual(hexOf(whirlpoolOf(twoBlocks)), "526b2394d85683e24b29acd0fd37f7d5027f61366a1407262dc2a6a345d9e240c017c1833db1e6db6a46bd444b0c69520c856e7c6e9c366d150a7da3aeb160d1")
    checkEqual(hexOf(whirlpoolOf(pangram)), "b97de512e91e3828b40d2b0fdce9ceb3c4a71f9bea8d88e75c4fa854df36725fd2b52eb6544edcacd6f8beddfea403cb55ae31f03ad62a5ef54e42ee82c3fb35")
    checkEqual(hexOf(whirlpoolOf(long)), "bb85e16dc0aa119a1a2f3af74dec5063463cc3dba0d32a7fa3de1bfeec10a15333797ff10f90b5ce180b7ec6984eaaed2c466eec86b00c996a4a64986dc97069")
