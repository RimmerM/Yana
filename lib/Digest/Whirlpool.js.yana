let roundConstantsHi = [
    404997864, 916902645, 1622973326, 501274562, 360134629,
    1489578250, 3176993012, 3827777931, 4226710630, 3391995655
] :: [U32 *10]

let roundConstantsLo = [
    2276983119, 2037354834, 2735504181, 776732247, 2683325146,
    2980080517, 3409839463, 2810025432, 3709290398, 2908390195
] :: [U32 *10]

{-
   The new high and low halves of `(hi, lo)` rotated right by `d`, for `0 < d < 32`.

   **Not `ror`, and it is not an oversight.** `Core.Bits`' `rol` and `ror` rotate a word within
   itself; what a 64-bit rotation becomes over a pair is a *funnel* shift, which takes each result
   word from both operands - so `ror` on each half separately would be a different function, and
   there is no primitive for this one. `shrd` is exactly it on x86 and a 32-bit backend is free to
   recognize the shape, which is the other reason to write it as these two lines rather than inline.

   Every rotation in the round function is one of these, or one of these with the two results
   exchanged.
-}
fn rorHi(hi: U32, lo: U32, d: U32) -> U32 = (hi `shr` d) `or` (lo `shl` (32 - d))
fn rorLo(hi: U32, lo: U32, d: U32) -> U32 = (lo `shr` d) `or` (hi `shl` (32 - d))

{-
   One lane of one round, as a pair.

   The eight terms are the eight of `whirlpoolLane` in the other file, in the same order and reading
   the same bytes of the same lanes. Each is accumulated into `accHi`/`accLo` rather than written as
   one expression, because the pair form has no single expression to be: what the 64-bit version says
   with `xor` this says twice.

   The four terms rotated by 32 or more take `rorLo`/`rorHi` the other way round, which is the
   exchange composed into the funnel shift - see the note at the head of this file.
-}
fn whirlpoolLaneHalves(hi: [U32], lo: [U32], n: Size, keyHi: U32, keyLo: U32,
                       &outHi: [U32], &outLo: [U32], at: Size) -> {}:
    let s0 = truncate(hi[n] `shr` 24) :: Size
    let &accHi = circulantHi[s0]
    let &accLo = circulantLo[s0]

    let s1 = truncate((hi[(n + 7) `and` 7] `shr` 16) `and` 255) :: Size
    accHi = accHi `xor` rorHi(circulantHi[s1], circulantLo[s1], 8)
    accLo = accLo `xor` rorLo(circulantHi[s1], circulantLo[s1], 8)

    let s2 = truncate((hi[(n + 6) `and` 7] `shr` 8) `and` 255) :: Size
    accHi = accHi `xor` rorHi(circulantHi[s2], circulantLo[s2], 16)
    accLo = accLo `xor` rorLo(circulantHi[s2], circulantLo[s2], 16)

    let s3 = truncate(hi[(n + 5) `and` 7] `and` 255) :: Size
    accHi = accHi `xor` rorHi(circulantHi[s3], circulantLo[s3], 24)
    accLo = accLo `xor` rorLo(circulantHi[s3], circulantLo[s3], 24)

    -- `ror 32` is the exchange and nothing else.
    let s4 = truncate(lo[(n + 4) `and` 7] `shr` 24) :: Size
    accHi = accHi `xor` circulantLo[s4]
    accLo = accLo `xor` circulantHi[s4]

    let s5 = truncate((lo[(n + 3) `and` 7] `shr` 16) `and` 255) :: Size
    accHi = accHi `xor` rorLo(circulantHi[s5], circulantLo[s5], 8)
    accLo = accLo `xor` rorHi(circulantHi[s5], circulantLo[s5], 8)

    let s6 = truncate((lo[(n + 2) `and` 7] `shr` 8) `and` 255) :: Size
    accHi = accHi `xor` rorLo(circulantHi[s6], circulantLo[s6], 16)
    accLo = accLo `xor` rorHi(circulantHi[s6], circulantLo[s6], 16)

    let s7 = truncate(lo[(n + 1) `and` 7] `and` 255) :: Size
    accHi = accHi `xor` rorLo(circulantHi[s7], circulantLo[s7], 24)
    accLo = accLo `xor` rorHi(circulantHi[s7], circulantLo[s7], 24)

    outHi[at] = accHi `xor` keyHi
    outLo[at] = accLo `xor` keyLo

{-
   The compression, one block, over halves.

   Line for line the other file's `whirlpoolCompress` with every lane doubled: the same ten rounds,
   the same key schedule advanced beside the state, and the same Miyaguchi-Preneel fold at the end.
-}
fn compressHalves(&stateHi: [U32 *8], &stateLo: [U32 *8], from: [U8], at: Size) -> {}:
    let &blockHi = [0] :: [U32 *8]
    let &blockLo = [0] :: [U32 *8]
    let &keyHi = [0] :: [U32 *8]
    let &keyLo = [0] :: [U32 *8]
    let &workHi = [0] :: [U32 *8]
    let &workLo = [0] :: [U32 *8]
    let &nextHi = [0] :: [U32 *8]
    let &nextLo = [0] :: [U32 *8]

    let &i = 0 :: Size
    while i < 8:
        blockHi[i] = readBigU32(from, at + i * 8)
        blockLo[i] = readBigU32(from, at + i * 8 + 4)
        keyHi[i] = stateHi[i]
        keyLo[i] = stateLo[i]
        workHi[i] = blockHi[i] `xor` keyHi[i]
        workLo[i] = blockLo[i] `xor` keyLo[i]
        i = i + 1

    let &r = 0 :: Size
    while r < 10:
        whirlpoolLaneHalves(keyHi, keyLo, 0, roundConstantsHi[r], roundConstantsLo[r],
                            nextHi, nextLo, 0)

        let &j = 1 :: Size
        while j < 8:
            whirlpoolLaneHalves(keyHi, keyLo, j, 0, 0, nextHi, nextLo, j)
            j = j + 1

        j = 0
        while j < 8:
            keyHi[j] = nextHi[j]
            keyLo[j] = nextLo[j]
            j = j + 1

        j = 0
        while j < 8:
            whirlpoolLaneHalves(workHi, workLo, j, keyHi[j], keyLo[j], nextHi, nextLo, j)
            j = j + 1

        j = 0
        while j < 8:
            workHi[j] = nextHi[j]
            workLo[j] = nextLo[j]
            j = j + 1

        r = r + 1

    i = 0
    while i < 8:
        stateHi[i] = stateHi[i] `xor` (workHi[i] `xor` blockHi[i])
        stateLo[i] = stateLo[i] `xor` (workLo[i] `xor` blockLo[i])
        i = i + 1

{-
   The instance, and the one place a wide value is touched at all.

   The state stays `[I64 *8]` - that is the type `Whirlpool.yana` declares, the type the padding and
   the `Digest` instance are written against, and the type `finish` writes out with `writeBigU64` -
   so this splits it on the way in and rejoins it on the way out. Sixteen wide operations per call,
   against a run of blocks; the alternative, a state of halves, would have made the state type itself
   platform-selected and dragged the record, the padding and the result with it.
-}
instance Block(WhirlpoolState):
  fn compressBlocks(&self: WhirlpoolState, from: [U8], at: Size, blocks: Size) -> {}:
      let &stateHi = [0] :: [U32 *8]
      let &stateLo = [0] :: [U32 *8]

      let &i = 0 :: Size
      while i < 8:
          let word = bitcast(self.h[i]) :: U64
          stateHi[i] = truncate(word `shr` 32)
          stateLo[i] = truncate(word)
          i = i + 1

      let &b = 0 :: Size
      while b < blocks:
          compressHalves(stateHi, stateLo, from, at + b * 64)
          b = b + 1

      i = 0
      while i < 8:
          self.h[i] = bitcast(((stateHi[i] :: U64) `shl` 32) `or` (stateLo[i] :: U64)) :: I64
          i = i + 1
