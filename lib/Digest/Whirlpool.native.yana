let roundConstantsWp = [
    1739452583106838863, 3938066875928252754, 6970617360185850677, 2152957850883456599,
    1546766456395418330, 6397689871562992517, -4801662984139176601, -2006563040903981608,
    -293160144494704738, -3878233664402062541
] :: [I64 *10]

fn tableSlot(index: U64) -> Size = truncate(index `and` 255) :: Size

{-
   One lane of one round - the whole of the algorithm's inner loop.

   Eight table reads, each of a different byte of a different lane, each rotated by a different
   multiple of eight, xor'd together with the round key. The byte taken from lane `n - k` is the one
   `8k` bits down, which is the diffusion: after one round every output byte depends on eight input
   bytes drawn from eight different lanes.
-}
fn whirlpoolLane(a: Flat(U64), n: Size, key: U64) -> U64 =
    (((bitcast(circulant[tableSlot(a[n] `shr` 56)]) :: U64) `xor` ((bitcast(circulant[tableSlot(a[(n + 7) `and` 7] `shr` 48)]) :: U64) `ror` 8)) `xor`
     (((bitcast(circulant[tableSlot(a[(n + 6) `and` 7] `shr` 40)]) :: U64) `ror` 16) `xor`
      ((bitcast(circulant[tableSlot(a[(n + 5) `and` 7] `shr` 32)]) :: U64) `ror` 24))) `xor`
    ((((bitcast(circulant[tableSlot(a[(n + 4) `and` 7] `shr` 24)]) :: U64) `ror` 32) `xor`
      ((bitcast(circulant[tableSlot(a[(n + 3) `and` 7] `shr` 16)]) :: U64) `ror` 40)) `xor`
     (((bitcast(circulant[tableSlot(a[(n + 2) `and` 7] `shr` 8)]) :: U64) `ror` 48) `xor`
      (((bitcast(circulant[tableSlot(a[(n + 1) `and` 7])]) :: U64) `ror` 56) `xor` key)))

{-
   The compression - the Miyaguchi-Preneel construction over a ten-round block cipher.

   The key schedule and the state are advanced together: each round derives the next round key from
   the last with the round constant in lane zero, then puts the state through the same function with
   that key. What comes out is xor'd with both the state that went in and the message block, which is
   what makes the construction one-way rather than a cipher anybody can run backwards.
-}
pub fn whirlpoolCompress(&h: [I64 *8], from: Flat(U8), at: Size) -> {}:
    let &block = [0] :: [U64 *8]
    let &key = [0] :: [U64 *8]
    let &state = [0] :: [U64 *8]
    let &next = [0] :: [U64 *8]

    let &i = 0 :: Size
    while i < 8:
        block[i] = readBigU64(from, at + i * 8)
        key[i] = bitcast(h[i]) :: U64
        state[i] = block[i] `xor` key[i]
        i = i + 1

    let &r = 0 :: Size
    while r < 10:
        next[0] = whirlpoolLane(key, 0, bitcast(roundConstantsWp[r]) :: U64)

        let &j = 1 :: Size
        while j < 8:
            next[j] = whirlpoolLane(key, j, 0)
            j = j + 1

        j = 0
        while j < 8:
            key[j] = next[j]
            j = j + 1

        j = 0
        while j < 8:
            next[j] = whirlpoolLane(state, j, key[j])
            j = j + 1

        j = 0
        while j < 8:
            state[j] = next[j]
            j = j + 1

        r = r + 1

    i = 0
    while i < 8:
        h[i] = bitcast((bitcast(h[i]) :: U64) `xor` (state[i] `xor` block[i])) :: I64
        i = i + 1


instance Block(WhirlpoolState):
  fn compressBlocks(&self: WhirlpoolState, from: Flat(U8), at: Size, blocks: Size) -> {}:
      let &i = 0 :: Size
      while i < blocks:
          whirlpoolCompress(self.h, from, at + i * 64)
          i = i + 1
