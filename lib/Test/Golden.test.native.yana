{-
   Snapshots - Design-Test.md §7's four rulings, each asserted.

   The machinery rather than any library's output: what is being pinned here is *when* a snapshot is
   created, when it is rewritten, when it fails and when it is stale, because those four are the
   rulings and they are what the current `generate` gets wrong. A fixture that snapshotted, say, a
   `Map`'s rendering would assert the ruling only by accident.

   Written against `snapshotOutcome` rather than `snapshot` for the reason `test/lib/Agree.yana`
   gives: the assertion records what it finds, so a test of what a *mismatch* does cannot be written
   in terms of it - the case would go red for succeeding.

   Each case owns a directory of its own under the system's temporary directory, wiped on the way in
   and on the way out. The driver compiles every fixture three to five ways and runs each in this
   same process, so a file one build left behind is a file the next build finds stale - which is the
   one thing this fixture must not be able to report by accident.
-}

import File
import Environment
import Native

fn rootFor(tag: String) -> String:
    let directory = match variable("TMPDIR"):
        Just(->named) -> named
        Nothing -> "/tmp"

    return "{directory}/yana-golden-{processId()}-{tag}"

-- Everything in it and then it, which is `removeDirectory`'s rule: the kernel refuses a directory
-- that still holds anything.
fn clearRoot(root: String) -> {}:
    for entry in entries(root):
        match entry:
            Err(_) -> {}
            Ok(found) -> removeFile(joinPath(root, found.name))

    removeDirectory(root)

{-
   The file a snapshot of this name would be written to, worked out the same way the library works it
   out - from the caller's own `@caller` location.

   Not a literal, and the reason is a driver rather than a preference: `YanaLibTest` compiles a
   `lib/` fixture as module `Lib.<name>` and `YanaElfTest` compiles the same file as `ElfTest`, so a
   fixture that wrote the module name down would be asserting which driver was running it. What is
   still pinned is the *scheme* - module, test, name - because `at.function` here is the case's own
   name, filled at the call below rather than written out.
-}
fn expectedFile(name: String, @caller ->at: Site) -> String = "{at.file}.{at.function}.{name}.txt"

fn useRoot(root: String, update: Bool, noUpdate: Bool, prune: Bool) -> {}:
    let &options = defaultOptions()
    options.snapshotDir = copy(root)
    options.update = update
    options.noUpdate = noUpdate
    options.prune = prune
    configureSnapshots(options)

{-
   Ruling 4's first half: a snapshot that is not there is a *create*, and the second comparison
   against it passes.

   The create is the ordinary development run and needs no flag. What it must not be is silent - the
   line goes on the report stream, which is what `snap  new` is - because a run that wrote four
   goldens and said nothing is a run whose diff is a surprise.
-}
@test fn absenceCreatesAndThenMatches() -> {}:
    let root = rootFor("create")
    clearRoot(root)
    useRoot(root, False, False, False)

    checkNothing(snapshotOutcome("shape", "alpha\nbeta\n"))
    check(fileExists(joinPath(root, expectedFile("shape"))))

    match readWholeFile(joinPath(root, expectedFile("shape"))):
        Err(_) -> check(False, "the snapshot that was just written could not be read back")
        Ok(text) -> checkEqual(text, "alpha\nbeta\n")

    checkNothing(snapshotOutcome("shape", "alpha\nbeta\n"))
    clearRoot(root)

{-
   The cell §7 is really about: a development run **fails** on a difference rather than rewriting it.

   A tool that rewrote by default is one where a wrong answer becomes the expected answer by being
   run once, which is the same failure mode as a golden nobody reviewed. The report names the first
   differing line, and the text the run actually produced is written beside the snapshot so that the
   whole diff is one `diff` away.
-}
@test fn differenceFailsAndKeepsTheEvidence() -> {}:
    let root = rootFor("differ")
    clearRoot(root)
    useRoot(root, False, False, False)

    checkNothing(snapshotOutcome("lines", "alpha\nbeta\ngamma\n"))

    let file = expectedFile("lines")

    match snapshotOutcome("lines", "alpha\nBETA\ngamma\n"):
        Nothing -> check(False, "a changed snapshot must fail a run that did not ask to update")
        Just(said) -> checkEqual(said, "snapshot {file} does not match - line 2: expected `beta`, got `BETA`, and what this run produced is beside it in {file}.actual")

    -- The evidence, and the snapshot left as it was. Both halves matter: the run that failed must
    -- not have changed what the next run compares against.
    check(fileExists(joinPath(root, "{file}.actual")))

    match readWholeFile(joinPath(root, file)):
        Err(_) -> check(False, "the snapshot went missing")
        Ok(text) -> checkEqual(text, "alpha\nbeta\ngamma\n")

    clearRoot(root)

{-
   Ruling 2: an update classifies what it wrote, and a reorder is not a change.

   Most library reorganizations move declarations without changing any of them, so most golden churn
   is the same lines in a different order. Separating the two is the difference between reviewing
   four files and reviewing four hundred, and the tool has both texts in memory when it decides.
-}
@test fn updateSeparatesAReorderFromAChange() -> {}:
    let root = rootFor("update")
    clearRoot(root)
    useRoot(root, False, False, False)

    checkNothing(snapshotOutcome("order", "one\ntwo\nthree\n"))
    useRoot(root, True, False, False)

    -- The same three lines rearranged, which is the class a reviewer skips.
    checkNothing(snapshotOutcome("order", "three\none\ntwo\n"))

    -- And one that is not, which is the class they do not.
    checkNothing(snapshotOutcome("order", "three\none\nfour\n"))

    match readWholeFile(joinPath(root, expectedFile("order"))):
        Err(_) -> check(False, "the rewritten snapshot could not be read back")
        Ok(text) -> checkEqual(text, "three\none\nfour\n")

    clearRoot(root)

{-
   Ruling 4's second half: under `--no-update` an absent snapshot is a *failure*.

   This is what CI passes, and it is the ruling `readExpectedRun` breaks today by treating an empty
   `.run.expect` as "skip this comparison" while still reporting Pass. No file's contents decide
   whether an assertion happens; a flag does.
-}
@test fn noUpdateRefusesToCreate() -> {}:
    let root = rootFor("noupdate")
    clearRoot(root)
    useRoot(root, False, True, False)

    checkJust(snapshotOutcome("missing", "anything\n"))
    check(!fileExists(joinPath(root, expectedFile("missing"))))

    clearRoot(root)

{-
   Ruling 3: a snapshot nothing reached in a full run is stale, and `--update --prune` deletes it.

   A golden file that no assertion compares against is the empty-fixture-directory failure mode:
   from the outside it is indistinguishable from one that passes. The orphan here is written through
   the store rather than through an assertion, which is exactly what makes it unreached.
-}
@test fn staleIsReportedAndPruned() -> {}:
    let root = rootFor("stale")
    clearRoot(root)
    useRoot(root, False, False, False)

    checkNothing(snapshotOutcome("kept", "still compared\n"))
    writeSnapshotFile(root, "SomeTestThatWentAway.gone.txt", "left behind\n")

    checkEqual(reviewSnapshots(True), 1)

    -- A run that did not reach everything says nothing about staleness, because what it would be
    -- reporting is the selection rather than the tree.
    checkEqual(reviewSnapshots(False), 0)

    useRoot(root, True, False, True)
    checkEqual(reviewSnapshots(True), 0)
    check(!fileExists(joinPath(root, "SomeTestThatWentAway.gone.txt")))

    -- And the one that was reached is still there, which is the half of pruning that has to be
    -- asserted separately from the half that deletes.
    check(fileExists(joinPath(root, expectedFile("kept"))))

    clearRoot(root)

-- A snapshot name is prose and a file name is not. `/` in particular must not name a directory, so
-- the mapping is checked rather than assumed.
@test fn namesBecomeFileNames() -> {}:
    let root = rootFor("names")
    clearRoot(root)
    useRoot(root, False, False, False)

    checkNothing(snapshotOutcome("after two inserts / one remove", "x\n"))
    check(fileExists(joinPath(root, expectedFile("after_two_inserts___one_remove"))))

    clearRoot(root)
