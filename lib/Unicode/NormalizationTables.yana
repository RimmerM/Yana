    6098, 6099, 6100, 6101, 6102, 6103, 6104, 6105, 6106, 6107, 6108, 6109, 6110, 6111, 6112, 6113,
    6114, 6115, 6116, 6117, 6118, 6119, 6120, 6121, 6122, 6123, 6124, 6125, 6126, 6127, 6128, 6129,
    6130, 6131, 6132, 6133, 6134, 6135, 6136, 6137, 6138, 6139, 6140, 6141, 6142, 6143, 6144, 6145,
    6146, 6147, 6148, 6149, 6150, 6151, 6152, 6153, 6154, 6155, 6156, 6157, 6158, 6159, 6160, 6161,
    6162, 6163, 6164, 6165, 6166, 6167, 6168, 6169, 6170, 6171, 6172, 6173, 6174, 6175, 6176, 6177,
    6178, 6179, 6180, 6181, 6182, 6183, 6184, 6185, 6186, 6187, 6188, 6189, 6190, 6191, 6192, 6193,
    6194, 6195, 6196, 6197, 6198, 6199, 6200, 6201, 6202, 6203, 6204, 6205, 6206, 6207, 6208, 6209,
    6210, 6211, 6212, 6213, 6214, 6215, 6216, 6217, 6218, 6219, 6220, 6221, 6222, 6223, 6224, 6225,
    6226, 6227, 0, 0
] :: [U16 *10544]

-- A `Char` above U+10FFFF is not a code point (the constructor does not check), and answers
-- the entry of a starter with no mappings rather than reading past the top level.
-- Middle block 13 is most of the code space and holds 0 throughout, so it is answered without
-- loading the two levels below it - `quiet_block` in tools/unicode/generate.py.
@inline(always)
fn normalizationIndexAt(c: Char) -> U16:
    if c.0 > 0x10FFFF then return 0

    let at = c :: Size
    let top = normalizationIndexTop[at `shr` 10] :: Size
    if top == 13 then return 0
    let middle = (top `shl` 6) + ((at `shr` 4) `and` 63)
    let leaf = ((normalizationIndexMiddle[middle] :: Size) `shl` 4) + (at `and` 15)
    return normalizationIndexLeaves[leaf]
