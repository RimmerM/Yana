@test fn caseIndexEveryCodePoint():
    let &failures = 0 :: Size

    for block in 0 .. (272 :: U32):
        let &sum = 0 :: U32
        for offset in 0 .. (0x1000 :: U32):
            let value = caseIndexAt(Char((block * 0x1000) + offset)) :: U32
            sum = (((sum `shl` 5) `or` (sum `shr` 27)) `xor` value)

        if sum != expectedCaseIndexSums[truncate(block) :: Size]:
            if failures < 8 then check(False, note: "block {block}")
            failures += 1

    checkEqual(failures, 0)
    checkEqual(caseIndexAt(Char(0x110000)) :: U32, 0)

