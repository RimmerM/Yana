{-
   The portable collator - Implementation-String.md part 8.5.

   `collationConformance` is CLDR's CollationTest_CLDR_NON_IGNORABLE_SHORT.txt, generated into
   `CollationTest.test.yana`: each line compares after the one before it, at tertiary strength with no
   variable weighting, which is `UnicodeCollator` with the default options. Lines of equal keys are in
   code point order in the file, and that is the collator's tie-break, so every pair is `LT`.

   `unicodeCollatorOptions` is `Collator.test.yana`'s check of the options against what ICU answers,
   through the portable collator on every target.
-}

import Test

@test fn collationConformance():
    let separator = charText(collationTestSeparator)
    let sorter = unicodeCollator(CollatorOptions {})
    let &previous = ""
    let &line = 0 :: Size
    let &failures = 0 :: Size

    for chunk in 0 .. length(collationTestChunks):
        let text = collationTestChunks[chunk]
        let &start = 0 :: Size
        while start <= length(text):
            let end = if String.find(text, separator, start) is Just(at) then at else length(text)
            let current = copy(String.slice(text, start, end))
            if line > 0 && sorter.compare(previous, current) != LT:
                if failures < 8 then check(False, note: "CollationTest line {line + 1}")
                failures += 1

            previous = current
            line += 1
            start = end + length(separator)

    checkEqual(failures, 0)
    checkEqual(line, 206268)

@test fn unicodeCollatorOptions():
    for option in 0 .. length(collatorAnswers):
        let sorter = unicodeCollator(collatorOptions(option))
        for pair in 0 .. length(collatorLefts):
            let left = collatorLefts[pair]
            let right = collatorRights[pair]
            let expected = collatorAnswers[option].unit(pair)
            check(agrees(sorter.compare(left, right), expected, left, right), note: "options {option}, pair {pair}")

@test fn numericRuns():
    let sorter = unicodeCollator(CollatorOptions {numeric: True})
    checkEqual(sorter.compare("file9", "file10"), LT)
    checkEqual(sorter.compare("file10", "file9"), GT)
    checkEqual(sorter.compare("0", "00"), compareChars("0", "00"))
    checkEqual(sorter.compare("x100000000000000000000", "x99999999999999999999"), GT)
    checkEqual(sorter.compare("1.5", "1.10"), LT)
    checkEqual(sorter.compare("٢", "10"), LT)

-- CLDR's table and conformance test, not ICU's radical-stroke root: see `Collation.yana`.
@test fn hanByCodePoint():
    let sorter = unicodeCollator(CollatorOptions {})
    checkEqual(sorter.compare("丁", "中"), LT)
    checkEqual(sorter.compare("\x20000", "中"), GT)
    checkEqual(sorter.compare("\x3400", "\x4E00"), GT)

@test fn tiesByCanonicalOrder():
    let sorter = unicodeCollator(CollatorOptions {})
    checkEqual(sorter.compare("\x591\x334", "\x334\x592"), LT)
    checkEqual(sorter.compare("é", "e\x301"), GT)
    checkEqual(sorter.compare("e\x301", "é"), LT)

@test fn emptyText():
    let sorter = unicodeCollator(CollatorOptions {})
    checkEqual(sorter.compare("", ""), EQ)
    checkEqual(sorter.compare("", "a"), LT)
    checkEqual(sorter.compare("a", ""), GT)
    checkEqual(sorter.compare("", "\x0"), LT)

-- Whether `nextPrimary` walks the full walk's primary weights for the text, or says it is unsure.
fn walkAgrees(sorter: UnicodeCollator, text: String) -> Bool:
    let &walked = [] :: [U32]
    let &walk = PrimaryWalk {}
    let &weight = nextPrimary(sorter, text, walk)
    while weight != walkEnd && weight != walkUnsure:
        walked.push(weight)
        weight = nextPrimary(sorter, text, walk)

    if weight == walkUnsure then return True

    let &expected = [] :: [U32]
    let full = textElements(sorter, text)
    for i in 0 .. length(full):
        if primaryOf(full[i]) != 0 then expected.push(primaryOf(full[i]))

    return walked == expected

{-
   `comparePrimaries` answers without the full walk, so its walk has to give the full walk's primary
   weights wherever it does not say it is unsure. Every code point alone and followed by a letter, and
   after `l` - one of the two contraction heads below U+0300, whose middle dot U+0387 reaches only
   once decomposed - with no variable weighting, and every code point alone under `shifted`.
   CollationTest's lines are the texts of more than two characters.
-}
@test fn primaryWalk():
    let plain = unicodeCollator(CollatorOptions {})
    let shifted = unicodeCollator(CollatorOptions {ignorePunctuation: True})
    let &failures = 0 :: Size

    for point in 0 .. (0x110000 :: U32):
        if point is 0xD800..=0xDFFF then continue

        let agrees = walkAgrees(plain, charText(Char(point))) && walkAgrees(plain, charText(Char(point)) ++ "a") &&
                     walkAgrees(plain, "l" ++ charText(Char(point))) && walkAgrees(shifted, charText(Char(point)))
        if !agrees:
            if failures < 8 then check(False, note: "U+{point}")
            failures += 1

    checkEqual(failures, 0)
