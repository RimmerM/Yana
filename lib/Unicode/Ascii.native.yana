import Native

{-
   The ASCII fast paths the Unicode operations share, natively - part 8's "every operation keeps an
   ASCII fast path per vector block". `Ascii.js.yana` has the same two names.

   ASCII is the one part of Unicode every table here agrees about: no case mapping but `A`-`Z` and
   `a`-`z`, no decomposition, no combining class, and a cluster per unit but CR LF. So a register
   that holds only ASCII is handled without decoding a character or reading a table.
-}

-- The offset of the first unit at or after `from` that is not ASCII, or the length: a sign test per
-- register and a `firstSet` in the register that ends the run.
fn asciiRunEnd(text: String, from: Size) -> Size:
    let bytes = String.bytes(text)
    let count = length(bytes)
    let width = vectorBytes
    let zero = zero() :: Vec(I8)
    let &at = from

    while at + width <= count:
        let high = (bitcast(loadVector(bytes, at)) :: Vec(I8)) .< zero
        if any(high) then return at + (firstSet(high) :: Size)
        at += width

    while at < count && bytes[at] < 0x80:
        at += 1

    return at

{-
   The offset of the first character at or after `from` that is not a well-formed character below
   U+0300, or the length - `asciiRunEnd` widened to the range in which every character is an NFC
   starter that composes with nothing before it, which is what ICU's `minNoMaybeCP` is for NFC.
   Latin text is mostly this range, and its accented letters were a decode and a lookup each.

   A register passes when no byte in it is `CC` or above and its two-unit sequences are whole: a
   continuation byte exactly where the byte before is a lead, and no `C0` or `C1` lead. The byte
   before the register is read for its first lane, as `utf8BlockErrors` does, so the first byte of
   the text is taken alone. At the first lane that fails, the run ends there - or at the lead before
   it, which the failing lane leaves without its continuation. A register that is all ASCII after a
   byte that is not a lead passes on one compare, as in `asciiRunEnd`.

   **Called where `asciiRunEnd` stopped short of a lead below `CC`,** rather than in its place: every
   ASCII run in CJK and emoji text ends at a lead above it, and calling this there instead measured
   10-50% slower for them and 3.6 times slower over all-ASCII text. The test on the byte it stopped
   at is what text that is not Latin pays, about 6% on `isNormalizedNfc` over emoji.
-}
fn nfcQuietRunEnd(text: String, from: Size) -> Size:
    let bytes = String.bytes(text)
    let count = length(bytes)
    let width = vectorBytes
    let zero = zero() :: Vec(I8)
    let sign = splat(-128 :: I8) :: Vec(I8)
    let high = splat(-53 :: I8) :: Vec(I8)
    let continuations = splat(-64 :: I8) :: Vec(I8)
    let leads = splat(0x3F :: I8) :: Vec(I8)
    let overlong = splat(0x42 :: I8) :: Vec(I8)
    let &at = from
    let &end = -1 :: Size

    if at == 0 && count > 0:
        if bytes[0] < 0x80 then at = 1
        else if bytes[0] is 0xC2..=0xCB && count > 1 && bytes[1] is 0x80..=0xBF then at = 2
        else end = 0

    while end < 0 && at + width <= count:
        let block = bitcast(loadVector(bytes, at)) :: Vec(I8)
        if bytes[at - 1] < 0xC0 && none(block .< zero):
            at += width
        else:
            let before = xor(bitcast(loadVector(bytes, at - 1)) :: Vec(I8), sign)
            let flipped = xor(block, sign)
            let stops = and(block .> high, block .< zero)
            let broken = xor(block .< continuations, before .> leads)
            let never = and(flipped .> leads, flipped .< overlong)
            let errors = or(or(stops, broken), never)

            if none(errors):
                at += width
            else:
                end = at + (firstSet(errors) :: Size)
                if end > from && bytes[end - 1] >= 0xC0 then end -= 1

    if end >= 0 then return end

    if at > from && bytes[at - 1] >= 0xC0 then at -= 1
    while at < count && (bytes[at] < 0x80 || (bytes[at] is 0xC2..=0xCB && at + 1 < count && bytes[at + 1] is 0x80..=0xBF)):
        at += if bytes[at] < 0x80 then 1 else 2

    return at

{-
   The offset of the first unit at or after `from` that is not ASCII or is an ASCII letter between
   `first` and `last`, or the length: the units a case mapping leaves as they are, which its walk
   copies later as one span rather than looking at one at a time. `asciiRunEnd` with the letters as
   a second stop.
-}
fn asciiUnchangedEnd(text: String, from: Size, first: I8, last: I8) -> Size:
    let bytes = String.bytes(text)
    let count = length(bytes)
    let width = vectorBytes
    let zero = zero() :: Vec(I8)
    let below = splat(first - 1) :: Vec(I8)
    let above = splat(last + 1) :: Vec(I8)
    let &at = from

    while at + width <= count:
        let block = bitcast(loadVector(bytes, at)) :: Vec(I8)
        let stops = or(block .< zero, and(block .> below, block .< above))
        if any(stops) then return at + (firstSet(stops) :: Size)
        at += width

    while at < count && bytes[at] < 0x80 && ((bitcast(bytes[at]) :: I8) < first || (bitcast(bytes[at]) :: I8) > last):
        at += 1

    return at

{-
   The offset after the run from `from` of ASCII units and of well-formed three-unit sequences led
   by `E4` to `E9` - U+4000 to U+9FFF, the unified ideographs and the few blocks around them - with
   the ASCII letters between `first` and `last` ending it too. `from` is such a lead. No character in
   that range has a case mapping, a combining class or a decomposition, which `check_han_quiet` in
   tools/unicode/generate.py refuses a Unicode version for breaking, so the walks that ask only that
   skip Chinese and Japanese text a register at a time instead of a decode and a lookup a character.

   A register passes when every byte is ASCII other than those letters, one of those leads, or a
   continuation byte exactly where one of the two bytes before is a lead - the two registers behind
   it are read for its first two lanes, as `utf8BlockErrors` does, so it starts two bytes in. At the
   first lane that fails, or at the last register that fits, the run ends at the start of the
   character that lane is in.
-}
fn hanRunEnd(text: String, from: Size, first: I8, last: I8) -> Size:
    let bytes = String.bytes(text)
    let count = length(bytes)
    let width = vectorBytes
    let zero = zero() :: Vec(I8)
    let belowLead = splat(-29 :: I8) :: Vec(I8)
    let aboveLead = splat(-22 :: I8) :: Vec(I8)
    let continuations = splat(-64 :: I8) :: Vec(I8)
    let below = splat(first - 1) :: Vec(I8)
    let above = splat(last + 1) :: Vec(I8)
    let &at = from
    let &end = -1 :: Size

    while end < 0 && at >= 2 && at + width <= count:
        let block = bitcast(loadVector(bytes, at)) :: Vec(I8)
        let one = bitcast(loadVector(bytes, at - 1)) :: Vec(I8)
        let two = bitcast(loadVector(bytes, at - 2)) :: Vec(I8)

        let lead = and(block .> belowLead, block .< aboveLead)
        let continuation = block .< continuations
        let wanted = or(and(one .> belowLead, one .< aboveLead), and(two .> belowLead, two .< aboveLead))
        let other = and(block .< zero, not(or(lead, continuation)))
        let letters = and(block .> below, block .< above)
        let errors = or(or(xor(continuation, wanted), other), letters)

        if none(errors):
            at += width
        else:
            end = at + (firstSet(errors) :: Size)

    let &stop = if end >= 0 then end else at
    if stop - 1 >= from && bytes[stop - 1] is 0xE4..=0xE9:
        stop -= 1
    else if stop - 2 >= from && bytes[stop - 2] is 0xE4..=0xE9:
        stop -= 2

    return stop

{-
   Appends the text's ASCII run from `from`, with the ASCII letters between `first` and `last` moved
   by `delta`, a register at a time, and answers where it stopped: where the run ends, or where less
   than a register is left, which the caller takes a unit at a time.

   `toLowerAscii`'s select (`lib/Core/Text.native.yana`), writing straight past the end of `out`:
   the register is reserved first, and the count is set after the store. **A register that is not
   all ASCII is mapped and written whole as well, and only its ASCII lanes are kept** - the count
   stops at the first unit that is not - which is how the transcoders in `Core/Encoding.native.yana`
   keep a run shorter than a register. So a run of changing letters between two accented ones is one
   store rather than a `pushUnit` each, which is what text where most letters change needs.
-}
fn pushCasedAscii(&out: String, text: String, from: Size, first: I8, last: I8, delta: I8) -> Size:
    let bytes = String.bytes(text)
    let count = length(bytes)
    let width = vectorBytes
    let zero = zero() :: Vec(I8)
    let below = splat(first - 1) :: Vec(I8)
    let above = splat(last + 1) :: Vec(I8)
    let bias = splat(delta) :: Vec(I8)
    let &at = from
    let &stopped = False

    while !stopped && at + width <= count:
        let block = bitcast(loadVector(bytes, at)) :: Vec(I8)
        let size = length(out)
        String.reserve(out, width)
        checkCondition((out.units.run.capacity :: Size) < size + width)

        let letters = and(block .> below, block .< above)
        setVectorAt(out.units.run.items + size, bitcast(select(letters, block + bias, block)) :: Vec(CodeUnit))

        let high = block .< zero
        let &kept = width
        if any(high):
            kept = firstSet(high) :: Size
            stopped = True

        out.units.length = truncate(size + kept) :: Count
        at += kept

    return at

{-
   The value of the well-formed sequence at `at`, whose lead the caller has read and seen is not
   ASCII, or `brokenSequence` - which the caller then decodes with `decodeChar`, the one place the
   maximal-subpart rule is. `decodeChar` itself is a call, and a walk over text that is not ASCII
   made it once per character: 37% of `isNormalizedNfc` over CJK text.

   Core's `wellFormedTwo`, `wellFormedThree` and `wellFormedFour` again, because those are private to
   `Core`, and dispatched on at each call site for the reason `Char.native.yana` gives: a function
   choosing among the three is past the inliner's ceiling even under `@inline(always)`, and measured
   here it stayed a call in `isNormalized` while being inlined into `lowerFrom`. So every walk writes

       let size = sequenceSize(lead)
       let value = if at + size > count then brokenSequence
                   else if size == 2 then twoUnitValue(text, at, lead)
                   else if size == 3 then threeUnitValue(text, at, lead) else fourUnitValue(text, at, lead)
-}
let brokenSequence = 0xFFFFFFFF :: U32

@inline(always) fn twoUnitValue(text: String, at: Size, lead: U32) -> U32:
    let b1 = (text.unit(at + 1) :: U32) `xor` 0x80
    return if b1 < 0x40 && lead >= 0xC2 then ((lead `and` 0x1F) `shl` 6) `or` b1 else brokenSequence

@inline(always) fn threeUnitValue(text: String, at: Size, lead: U32) -> U32:
    let b1 = (text.unit(at + 1) :: U32) `xor` 0x80
    let b2 = (text.unit(at + 2) :: U32) `xor` 0x80
    let value = ((lead `and` 0x0F) `shl` 12) `or` (b1 `shl` 6) `or` b2
    let broken = ((b1 `or` b2) `shr` 6) `or` ((value - 0x800) `shr` 31)
    return if broken == 0 && (value `shr` 11) != 0x1B then value else brokenSequence

@inline(always) fn fourUnitValue(text: String, at: Size, lead: U32) -> U32:
    let b1 = (text.unit(at + 1) :: U32) `xor` 0x80
    let b2 = (text.unit(at + 2) :: U32) `xor` 0x80
    let b3 = (text.unit(at + 3) :: U32) `xor` 0x80
    let value = ((lead `and` 0x07) `shl` 18) `or` (b1 `shl` 12) `or` (b2 `shl` 6) `or` b3
    let fits = (b1 `or` b2 `or` b3) < 0x40 && lead < 0xF5
    return if fits && value is 0x10000..=0x10FFFF then value else brokenSequence

@inline(always) fn sequenceSize(lead: U32) -> Size
  | _..0xE0 -> 2
  | _..0xF0 -> 3
  | _       -> 4

-- Appends `text`'s units from `from` to `to`: a block copy out of the text itself. `String.slice` is a
-- copy of its own under `compiler/resolve` (deleted in J173), so a walk that flushed through it
-- allocated per flush.
@inline(always) fn pushSpan(&out: String, text: String, from: Size, to: Size):
    if to > from then String.appendUnits(out, units(text) + from, to - from)
