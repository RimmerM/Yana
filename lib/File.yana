module

import Native
import Date

{-
   ==========================================================================================
   Files - Analysis-Library.md §2.9.
   ==========================================================================================

   Every operation here is `Result`-shaped, so `?` reads the way §2.9 says it does:

       let f = openFile(path, readAccess())?
       let n = readInto(f, buffer)?

   Four decisions about the surface, each recorded where it is:

    1. **The handle has a `Drop` instance**, so an unclosed descriptor - the standard leak of an
       explicit-close API - is unrepresentable here. `close` still exists, for the two things a drop
       cannot do: report the error, and close early.
    2. **The positional and sequential reads are separate functions** rather than one pair behind an
       optional offset. They differ in whether the cursor moves, which is observable, and the split
       is what lets `readAtInto` take `self` rather than `&self`.
    3. **One iterator serves the pull loop and both callback forms.** All three are the same
       traversal, and an `iter fn` is what a callback with a context pointer *is*. It yields a
       `Result`, which the consumer reads with a `match` rather than with `?`; see `entries` for why
       that is the honest shape and not the intended one.
    4. **One function per operation and not a `const char*` overload beside each**, because there is
       one string type.

   **`@platform(native)` is not written on any of these and the module is native-only anyway**: what
   it is written in terms of is Native's platform file, and a JS build has no descriptors to hand out.
   A second platform is therefore one file of Native rather than sixty attributes here, which is what
   Analysis-Modules.md §2.5 makes a general rule.

   `DynamicLibrary` is not here: it is `dlopen` rather than a system call, so there is nothing under
   it to write it in terms of.
-}

{-
   What went wrong, as the closed set the kernel's numbers map onto.

   Thirteen cases and not `errno`: a program branches on "was it there" and "may I have it", never
   on `EDQUOT` against `ENOSPC`. The numbers are the platform file's and the mapping below is the
   only thing that reads them.
-}
pub data FileError = Unknown | NotFound | Corrupt | AccessDenied | NoMemory | NoResources
                   | NoBufferSpace | NoDiskSpace | InvalidInput | Unsupported | Exists | InUse | Ended

{-
   The mapping, as a `match` - Analysis-Language.md §5.1.

   Nineteen `if code == err...` comparisons is what this is without the type, and not because anyone
   would prefer them: a bare name in a pattern *binds*, so `match code: errNotFound -> NotFound`
   against nineteen `let`s would match everything and bind the number - the one shape in this file
   that would compile and be wrong. A type is what makes the alternatives constructors instead, and
   a constructor in a pattern is a test.

   The wildcard is the honest half of the answer either way: the kernel has two hundred numbers and
   `Errno` names nineteen, so `errnoOf` is partial and anything it declines is `Unknown`.
-}
fn errorOf(code: Size) -> FileError = match errnoOf(code):
    Just(NoEntry) -> NotFound
    Just(PermissionDenied) -> AccessDenied
    Just(NotPermitted) -> AccessDenied
    Just(ReadOnlyFileSystem) -> AccessDenied
    Just(AlreadyExists) -> Exists
    Just(DeviceBusy) -> InUse
    Just(NotEmpty) -> InUse
    Just(OutOfMemory) -> NoMemory
    Just(NoSpace) -> NoDiskSpace
    Just(NameTooLong) -> NoBufferSpace
    Just(InvalidArgument) -> InvalidInput
    Just(BadAddress) -> InvalidInput
    Just(NotADirectory) -> InvalidInput
    Just(BadHandle) -> InvalidInput
    Just(TableFull) -> NoResources
    Just(TooManyOpen) -> NoResources
    Just(QuotaExceeded) -> NoResources
    Just(IsADirectory) -> Unsupported
    Just(FileTooLarge) -> Unsupported
    _ -> Unknown

-- A kernel answer as a `Result`: negative is the negated errno, and anything else is the answer.
fn checked(answer: Size) -> Result(FileError, Size):
    if answer < 0 then return Err(errorOf(0 - answer))
    return Ok(answer)

-- The same for a call whose answer is a *file offset* rather than a word - `lseek`, and nothing
-- else. An offset is sixty-four bits on every Linux ABI, so it is the one result here that does not
-- narrow with the machine; see the note beside `offsetWord` in `Native/Linux.x64.yana`.
fn checkedOffset(answer: I64) -> Result(FileError, I64):
    if answer < 0 then return Err(errorOf(truncate(0 - answer) :: Size))
    return Ok(answer)

-- The same for a call whose only answer is whether it worked.
fn checkedUnit(answer: Size) -> Result(FileError, {}):
    if answer < 0 then return Err(errorOf(0 - answer))
    return Ok({})

pub fn describeError(error: FileError) -> String = match error:
    Unknown -> "unknown error"
    NotFound -> "no such file or directory"
    Corrupt -> "the file system is corrupt"
    AccessDenied -> "access denied"
    NoMemory -> "out of memory"
    NoResources -> "out of system resources"
    NoBufferSpace -> "a buffer ran out of space"
    NoDiskSpace -> "the disk is full"
    InvalidInput -> "invalid input"
    Unsupported -> "the operation is unsupported"
    Exists -> "the file already exists"
    InUse -> "the file is in use"
    Ended -> "the file ended"

{-
   There is no `instance Show(FileError)` here, and its absence is the assertion.

   A payload-free sum's `Show` is generated from the declaration - the constructor's name, and a
   bound that is the longest of them, which for these thirteen is `NoBufferSpace` at thirteen units.
   Writing it out instead is a thirteen-arm `match` mapping each constructor to a string spelled the
   same way, which is a list that can drift from the declaration above it with no way to be checked
   against it.

   `describeError` stays, and the two are not the same function. This type has a *text* form and a
   *constructor* form, they are different answers, and only one of them is decided by the declaration.
   A derived `Show` can supply that one and can never supply the other; writing `describeError` beside
   it is what keeps the prose a thing somebody chose.
-}

{-
   How a file is opened, as the three questions `open` asks, in that order.

   `FileAccess` is a pair of flags rather than an enumeration because both may be set and neither
   need be; `CreateMode` is an enumeration because its four cases are exclusive. The three
   constructors below are the whole of what a call site normally writes.
-}
pub data FileAccess {read: Bool, write: Bool}

pub fn readAccess() -> FileAccess = FileAccess {read: True, write: False}
pub fn writeAccess() -> FileAccess = FileAccess {read: False, write: True}
pub fn readWriteAccess() -> FileAccess = FileAccess {read: True, write: True}

pub data CreateMode = CreateAlways | CreateNew | OpenAlways | OpenExisting

{-
   The extra flags, as a set of bits.

   Bits and not a record of eight booleans: seven of them are false at almost every call site, and a
   defaulted `flags: Size = 0` says that in one character where a record says it in eight fields.
   They are ored together - `fileAppend `or` fileUserPrivate` - and the three permission ones are
   what `createAccess` reads.
-}
pub let fileUnbuffered = 1 :: Size
pub let fileAppend = 2 :: Size
pub let fileTemporary = 4 :: Size
pub let fileReadOnly = 8 :: Size
pub let fileWriteThrough = 16 :: Size
pub let fileGroupPrivate = 32 :: Size
pub let fileUserPrivate = 64 :: Size
pub let fileExecutable = 128 :: Size

fn hasFlag(flags: Size, flag: Size) -> Bool = (flags `and` flag) != 0

-- The mode bits a *created* file gets, which is only read when the open actually creates one.
-- Readable by everyone, writable unless `fileReadOnly`, executable if asked, and then narrowed to
-- the owner or to the owner's group if either private flag is set.
fn createAccess(flags: Size) -> FileMode:
    let &base = 4 :: Size
    if !hasFlag(flags, fileReadOnly) then base = base `or` 2
    if hasFlag(flags, fileExecutable) then base = base `or` 1

    let &mode = fileMode((base `shl` 6) `or` (base `shl` 3) `or` base)

    if hasFlag(flags, fileUserPrivate):
        mode = mode `and` fileMode(448)
    else if hasFlag(flags, fileGroupPrivate):
        mode = mode `and` fileMode(504)

    return mode

fn accessFlags(access: FileAccess) -> OpenFlags:
    if access.read && access.write then return openReadWrite
    if access.write then return openWriteOnly

    return openReadOnly

fn createFlags(mode: CreateMode) -> OpenFlags = match mode:
    CreateAlways -> openCreate `or` openTruncate
    CreateNew -> openCreate `or` openExclusive
    OpenAlways -> openCreate
    OpenExisting -> OpenFlags(0)

fn openFlagsOf(access: FileAccess, mode: CreateMode, flags: Size) -> OpenFlags:
    let &result = accessFlags(access) `or` createFlags(mode)

    if hasFlag(flags, fileAppend) then result = result `or` openAppend
    if hasFlag(flags, fileWriteThrough) then result = result `or` openSync
    if hasFlag(flags, fileUnbuffered) then result = result `or` openDirect
    if hasFlag(flags, fileTemporary) then result = result `or` openTemporary

    return result

{-
   ==========================================================================================
   Paths, and the one rule everything below obeys.
   ==========================================================================================

   A kernel path is a NUL-terminated byte sequence and a `String` is a run and a live prefix, so
   every call that takes one takes a *copy* with the terminator appended. `terminated` is that copy.

   **The address the copy hands out is rooted in the copy, and the signature has to say so.** A raw
   pointer carries provenance exactly as a borrow does, but nothing *requires* an undeclared
   signature to state it: `fn bytesOf(text: String) -> %U8` is accepted in silence, and then
   `openPath(bytesOf(terminated(p)), ...)` releases the copy at the `bytesOf` call, `freeHeap` writes
   the free list's next pointer over the first eight bytes, and the open asks for a path beginning
   with eight zero bytes - failing as `NotFound` rather than as a crash.

   `return text` is that declaration (Analysis-Language.md §1), and it makes the nested form correct
   by construction: the drop of what `terminated` built is placed after the call that reads through
   the pointer. It is also why there is no layer of one-line syscall wrappers here - `openAt`,
   `removeAt`, `renameAt`, `makeDirectoryAt`, `removeDirectoryAt`, `pathInfoIn`, `linkInfoIn` -
   whose only job would be to make the copy somebody's parameter, and why no public function here
   may write `bytesOf` itself.
-}
-- The units as bytes, which is what every path and buffer argument below hands the kernel. A
-- string's own element type is `CodeUnit` now (see `StringData`), and the reinterpretation is what
-- says "the encoding's bytes" rather than "eight-bit numbers" - free on this target, and the one
-- place the whole module crosses between the two readings.
fn bytesOf(return text: String) -> %U8 = bitcast(stringData(text).bytes.run.items) :: %U8

fn terminated(path: String) -> String:
    let &copy = String.ofCapacity(length(path) + 1)
    String.push(copy, path)
    String.pushUnit(copy, 0)

    return copy

-- `dir` and `name` joined by a separator, which is what a directory traversal needs and what a
-- caller without it builds by hand into a fixed buffer at every site that walks a tree.
pub fn joinPath(dir: String, name: String) -> String:
    let &joined = String.ofCapacity(length(dir) + length(name) + 1)

    if length(dir) > 0:
        String.push(joined, dir)
        if String.unit(dir, length(dir) - 1) != 47 then String.pushUnit(joined, 47)

    String.push(joined, name)

    return joined

{-
   ==========================================================================================
   What `stat` answered.
   ==========================================================================================

   **Three times and not four.** There is no `createdTime`, because `stat` has no creation time to
   report - only `statx` does, and only on file systems that keep one. The usual way to have the
   field anyway is to fill it with the *accessed* time, and reporting a time that is not the one the
   field names is worse than not having the field. So what is here is the three `stat` really
   answers: when the contents were last read, when they were last written, and when the inode itself
   last changed.

   **The three times are `Timestamp`s.** They were an `I64` of microseconds since the epoch, written
   that way because the type Analysis-Library.md §3.1 promised did not exist yet and the number was
   already the right one. It exists now, so the field says what it holds: a `Timestamp` *is* that
   `I64`, so this costs nothing at runtime and buys what a bare integer could not - the difference
   between two of them is an `Interval`, comparing one against a duration does not compile, and
   `dateOf` takes one without a conversion at the call site. `timestampOfMicros` is the way back in,
   for a caller holding a number that came from somewhere else.

   `isLink` can only be true through `linkInfo`, since every other path here follows links. Computing
   it from an ordinary `stat` would make it dead: `stat` follows, so `S_ISLNK` of what it answers
   never holds.
-}
pub data FileInfo {size: I64, modifiedTime: Timestamp, accessedTime: Timestamp,
                   changedTime: Timestamp, isLink: Bool, isDirectory: Bool}

fn byteRun(count: Size) -> Run(U8) = newRun(count)

-- A `timespec` pair as the point in time `FileInfo` carries. The kernel's two words are a second
-- and a remainder in nanoseconds, and a `Timestamp` is microseconds, so the remainder is divided
-- rather than carried - the same three digits `Native.Clock` drops for the same reason.
fn statTime(seconds: I64, nanos: I64) -> Timestamp =
    timestampOfMicros(seconds * 1000000 + nanos / 1000)

{-
   What `stat` answered, off the record it filled - Analysis-Language.md §5.2.

   `@layout(c)` on Native's `FileStatus` is what makes the compiler hold the layout, so this reads
   named fields rather than walking a `%U8` with six offset constants - a C structure layout
   described one addition at a time.
-}
fn infoOf(status: FileStatus) -> FileInfo:
    let kind = kindOf(status.mode)

    return FileInfo {size: status.size,
                     modifiedTime: statTime(status.modifiedSeconds, status.modifiedNanos),
                     accessedTime: statTime(status.accessedSeconds, status.accessedNanos),
                     changedTime: statTime(status.changedSeconds, status.changedNanos),
                     isLink: kind is Just(LinkKind),
                     isDirectory: kind is Just(DirectoryKind)}

{-
   ==========================================================================================
   The file itself.
   ==========================================================================================

   A descriptor and one bit, and the `Drop` that is §2.9's first design change. A closed file holds
   -1, which is what makes both `close` and the drop idempotent: the syscall is made once, whichever
   of the two reaches it first.

   **The bit says whether this value is the descriptor's owner**, and it is not ceremony - it was
   added after `standardOutput()` closed a test driver's own standard output. A `File` around fd 1
   is an ordinary value: it is dropped at its last use like every other one, and the drop would
   close the descriptor the *process* was given. Everything printed afterwards goes nowhere, the
   exit status stays zero, and the failure looks like a truncated log. So a file this value did not
   open is one it does not close - the same distinction a `closeOnDestruct` flag draws anywhere else
   a handle can be inherited, and the reason it is worth having *here* is that a `File` without it
   has a drop that runs on every one.

   `close` is not governed by the bit. Asking for it in so many words is a decision, and a program
   that closes its own standard output meant to; the flag is about the drop the program did not
   write.
-}
pub data File {handle: Size, owned: Bool}

instance Drop(File):
    fn drop(->value: File) -> {}:
        if value.owned && value.handle >= 0:
            closeFile(value.handle)
            return

-- A file that is not open - the default a `File` field or a not-yet-opened local holds. It owes a
-- drop like any other `File`, and the drop does nothing.
pub fn closedFile() -> File = File {handle: -1, owned: True}

{-
   The two ways a descriptor from somewhere else becomes a file, split by the question a single
   `File(handle)` constructor cannot ask.

   `adoptFile` is the one that takes responsibility: whatever produced the descriptor is done with
   it and this value's drop is what closes it. `borrowFile` is the one that does not, which is what
   an inherited descriptor needs.
-}
pub fn adoptFile(handle: Size) -> File = File {handle: handle, owned: True}
pub fn borrowFile(handle: Size) -> File = File {handle: handle, owned: False}

pub fn standardInput() -> File = borrowFile(0)
pub fn standardOutput() -> File = borrowFile(1)
pub fn standardError() -> File = borrowFile(2)

pub fn isOpen(self: File) -> Bool = self.handle >= 0

{-
   Opening one, and the only way to.

   `mode` and `flags` are defaulted to what four of every five call sites want, so
   `openFile(path, readAccess())` is the common case in full.
-}
pub fn openFile(path: String, access: FileAccess, mode: CreateMode = OpenAlways,
                flags: Size = 0) -> Result(FileError, File):
    let handle = openPath(bytesOf(terminated(path)), openFlagsOf(access, mode, flags), createAccess(flags))
    if handle < 0 then return Err(errorOf(0 - handle))

    return Ok(adoptFile(handle))

{-
   Closing one early, and reporting what it said.

   `close` is what a program calls when it has something to do about a failure - a write-back error
   surfaces here and nowhere else, which is why the drop cannot be the whole answer. Afterwards the
   handle is -1, so the drop this value still owes does nothing.
-}
pub fn close(&self: File) -> Result(FileError, {}):
    if self.handle < 0 then return Ok({})

    let answer = closeFile(self.handle)
    self.handle = -1

    return checkedUnit(answer)

{-
   ==========================================================================================
   Reading and writing.
   ==========================================================================================

   §2.9's second design change: the sequential and positional forms are four functions rather than
   two with a `Maybe<U64> offset`. The sequential pair takes `&self` because the cursor moves, and
   the positional pair takes `self` because it does not - which is the distinction the merged
   signature could not express, and it is checked rather than documented: a positional read of a
   file another borrow is reading is fine, and a sequential one is not.

   A buffer is a `[U8]` on both sides. The count is what the kernel actually transferred, which for
   a read is how a program learns the file ended - zero - and for a write is what a caller has to
   loop on when it is short.
-}
pub fn readInto(&self: File, &to: [U8]) -> Result(FileError, Size) =
    checked(readFile(self.handle, values(to), length(to)))

pub fn readAtInto(self: File, at: I64, &to: [U8]) -> Result(FileError, Size) =
    checked(readFileAt(self.handle, values(to), length(to), at))

pub fn write(&self: File, from: [U8]) -> Result(FileError, Size) =
    checked(writeFile(self.handle, values(from), length(from)))

pub fn writeAt(self: File, at: I64, from: [U8]) -> Result(FileError, Size) =
    checked(writeFileAt(self.handle, values(from), length(from), at))

-- The same two for text, which is what a program that writes a line has. The units are the string's
-- own, so this is bytes natively and there is no encoding step.
pub fn writeText(&self: File, text: String) -> Result(FileError, Size) =
    checked(writeFile(self.handle, bytesOf(text), length(text)))

pub fn writeTextAt(self: File, at: I64, text: String) -> Result(FileError, Size) =
    checked(writeFileAt(self.handle, bytesOf(text), length(text), at))

{-
   The cursor.

   Both answer where it ended up, and both are a `Result`. Reporting a failed seek as position zero
   is the usual alternative, and it is a real answer for a file that is at position zero - so the
   two cases would be indistinguishable.
-}
pub data SeekBase = FileStart | CurrentPosition | FileEnd

fn whenceOf(base: SeekBase) -> Whence = match base:
    FileStart -> FromStart
    CurrentPosition -> FromCurrent
    FileEnd -> FromEnd

pub fn position(&self: File) -> Result(FileError, I64) =
    checkedOffset(seekFile(self.handle, 0, FromCurrent))

pub fn seek(&self: File, delta: I64, base: SeekBase = FileStart) -> Result(FileError, I64) =
    checkedOffset(seekFile(self.handle, delta, whenceOf(base)))

{-
   Shortening the file, without deleting it.

   `File::truncate()` over there is this with the size wired to zero and a seek to the start in
   front of it. The size is a parameter here because `ftruncate` takes one and the zero case is not
   special, and the seek is *not* here: a truncate to a nonzero length has no reason to move the
   cursor, so a caller that wants it says so. `truncate` is Core's name for the narrowing conversion,
   which is why this one is spelled out.
-}
pub fn truncateFileTo(&self: File, size: I64) -> Result(FileError, {}) =
    checkedUnit(truncateFile(self.handle, size))

pub fn flush(&self: File) -> Result(FileError, {}) = checkedUnit(syncFile(self.handle))

{-
   What the descriptor says about itself.

   A `Result` rather than a zero and a comment saying the `fstat` shouldn't fail. An empty file and a
   bad descriptor are different answers, and a program that cares can tell them apart.
-}
{-
   The three `stat` readers, each one line and each owning its own buffer.

   The buffer is a `FileStatus` the kernel fills (§5.2) rather than a `Run(U8)` the caller passes in,
   and either way the address is safe to hand a syscall: `slots` declares `return self`
   (Analysis-Language.md §1), so a raw address stays rooted in the run whatever the body does with
   it.
-}
pub fn fileInfo(self: File) -> Result(FileError, FileInfo):
    let &status = FileStatus {}
    let answer = statFile(self.handle, status)
    if answer < 0 then return Err(errorOf(0 - answer))

    return Ok(infoOf(status))

pub fn fileSize(self: File) -> Result(FileError, I64):
    let info = fileInfo(self)?
    return Ok(info.size)

{-
   ==========================================================================================
   Paths, without opening anything.
   ==========================================================================================

   `pathInfo` follows symbolic links and `linkInfo` reports the link itself, which is `stat` against
   `lstat` and is the one place the two differ. Everything else here is written over one of them.
-}
pub fn pathInfo(path: String) -> Result(FileError, FileInfo):
    let &status = FileStatus {}
    let answer = statPath(bytesOf(terminated(path)), status)
    if answer < 0 then return Err(errorOf(0 - answer))

    return Ok(infoOf(status))

pub fn linkInfo(path: String) -> Result(FileError, FileInfo):
    let &status = FileStatus {}
    let answer = statLink(bytesOf(terminated(path)), status)
    if answer < 0 then return Err(errorOf(0 - answer))

    return Ok(infoOf(status))

pub fn pathSize(path: String) -> Result(FileError, I64):
    let info = pathInfo(path)?
    return Ok(info.size)

-- True for a file that is not a directory, which is what `File::exists` means by the word - a
-- directory at that path answers False here and True below.
pub fn fileExists(path: String) -> Bool = match pathInfo(path):
    Ok(->info) -> !info.isDirectory
    Err(_) -> False

pub fn directoryExists(path: String) -> Bool = match pathInfo(path):
    Ok(->info) -> info.isDirectory
    Err(_) -> False

pub fn removeFile(path: String) -> Result(FileError, {}) = checkedUnit(removePath(bytesOf(terminated(path))))

-- Renaming, which is what a move within one file system is. Across file systems the kernel refuses
-- with `EXDEV` and this answers `Unknown`; a copy and a delete is what such a move is, and making
-- that decision silently is not this function's to make.
pub fn moveFile(from: String, to: String) -> Result(FileError, {}) =
    checkedUnit(renamePath(bytesOf(terminated(from)), bytesOf(terminated(to))))

{-
   Copying, as an open, a loop and two closes.

   `sendfile` belongs here and moves the bytes without them entering the process at all. It is a
   syscall this layer does not have yet and it is worth having - the loop below is two copies per
   block where `sendfile` is none - but it is a fast path for one platform rather than the
   operation, so what is written is the portable form. The buffer is 64 KiB, which is where the
   syscall count stops mattering.

   The target is created with the ordinary permission bits rather than the source's own, because
   reading those means a second `stat` field this record does not carry.
-}
let copyBlock = 65536 :: Size

pub fn copyFile(from: String, to: String, overwrite: Bool = True) -> Result(FileError, {}):
    let ->source = openFile(from, readAccess(), OpenExisting)?
    let mode = if overwrite then CreateAlways else CreateNew
    let ->target = openFile(to, writeAccess(), mode)?

    let buffer = byteRun(copyBlock)
    let &running = True

    while running:
        let got = readFile(source.handle, slots(buffer), copyBlock)
        if got < 0 then return Err(errorOf(0 - got))

        if got == 0:
            running = False
        else:
            let &moved = 0 :: Size

            while moved < got:
                let put = writeFile(target.handle, slots(buffer) + moved, got - moved)
                if put < 0 then return Err(errorOf(0 - put))

                moved = moved + put

    return Ok({})

{-
   ==========================================================================================
   Directories.
   ==========================================================================================
-}

-- The permission bits a created directory gets: 0777, which the process umask narrows.
let directoryAccess = FileMode(511)

{-
   Creating one, and every directory above it that does not exist yet.

   The recursion is on a *prefix length*, so nothing is written over: `parentOf` is where the last
   separator is, and the substring is built by the ordinary string operations. Recursing by writing
   a NUL over the last separator is the other way, and it needs a mutable copy of the path and has
   to restore the byte afterwards.
-}
fn parentOf(path: String) -> Size:
    let &at = length(path) - 1

    -- A trailing separator names the same directory, so it is not the one to cut at.
    while at > 0 && String.unit(path, at) == 47:
        at = at - 1

    while at > 0:
        if String.unit(path, at) == 47 then return at
        at = at - 1

    return 0

fn prefixOf(path: String, count: Size) -> String:
    let &copy = String.ofCapacity(count)
    let &at = 0 :: Size

    while at < count:
        String.pushUnit(copy, String.unit(path, at))
        at = at + 1

    return copy

pub fn createDirectory(path: String) -> Result(FileError, {}):
    if length(path) == 0 then return Err(InvalidInput)

    let answer = makeDirectory(bytesOf(terminated(path)), directoryAccess)
    if answer >= 0 then return Ok({})

    let error = errorOf(0 - answer)

    -- Already there is not a failure, which is what makes this the "make sure it exists" operation
    -- rather than a bare `mkdir`. Anything but a missing parent is.
    if error is Exists:
        if directoryExists(path) then return Ok({})
        return Err(Exists)

    if !(error is NotFound) then return Err(error)

    let parent = parentOf(path)
    if parent == 0 then return Err(NotFound)

    createDirectory(prefixOf(path, parent))?

    return checkedUnit(makeDirectory(bytesOf(terminated(path)), directoryAccess))

-- The directory must be empty, which is the kernel's rule and not this function's: a non-empty one
-- answers `InUse`.
pub fn removeDirectory(path: String) -> Result(FileError, {}) =
    checkedUnit(removeDirectoryPath(bytesOf(terminated(path))))

{-
   What a directory holds - the one shape all three traversals collapse into.

   **The name is owned rather than borrowed.** The cheap form is a view into the walker's 4 KiB
   buffer, invalidated when the callback returns and documented as such at every declaration that
   hands one out; here it is a `String` the consumer may keep. That costs an allocation per entry
   and removes the only rule those declarations would have to state.
-}
pub data DirectoryEntry {name: String, isDirectory: Bool}

-- What one `getdents64` asks for. The kernel fills whole records only, so a name longer than this
-- would be refused rather than split - and 4 KiB is four times the longest path Linux accepts.
let entryBlock = 4096 :: Size

{-
   The traversal - §2.9's third design change, and the answer to "which of the three is this".

   A pull loop, a callback with a context and a cheaper callback with a context are the same
   traversal written three ways, and they are written three ways only where nothing can quantify
   over what the caller wants to do with an entry. An `iter fn` is exactly a callback with a context
   pointer - so all three are this, and `break` works in the loop body where no callback could
   support it.

   **It yields a `Result`, and `?` will not unwrap it.** An `iter fn` has no way to end *with* an
   error - the last thing it can do is yield - so a failure mid-traversal is a yielded `Err`, which
   is honest. But a yielded value is *borrowed* for the extent of the body, which is what makes a
   yield free, and `?` moves the payload out of it. An entry owns its name, so `let it = entry?` is
   rejected as taking ownership of borrowed storage and the consumer writes

       for entry in entries(path):
           match entry:
               Ok(it): ...
               Err(e): ...

   That holds for any yielded payload with a teardown and is not specific to this iterator. It is
   the cost the ordinary case pays for the failing one.

   `.` and `..` are not yielded: they name the directory itself and its parent rather than anything
   in it, and every caller would filter them.

   The descriptor is a `File` rather than a raw handle, so a consumer that stops early still closes
   it: the `break` returns out of this frame, and the drop runs where every other drop does. That is
   the `Drop` instance paying for itself in the one place a walker would otherwise need a
   destructor.
-}
pub iter fn entries(path: String) -> ->Result(FileError, DirectoryEntry):
    let handle = openPath(bytesOf(terminated(path)), openReadOnly `or` openDirectory, fileMode(0))

    -- An `iter fn` ends by running out of values rather than by `return` - the loop's signal is not
    -- something a body names - so every early exit below is a flag this loop reads.
    if handle < 0:
        yield Err(errorOf(0 - handle))
    else:
        let dir = adoptFile(handle)
        let buffer = byteRun(entryBlock)

        -- Read out of the run once, above the loop. `slots` declares `return self`
        -- (Analysis-Language.md §1), so the address stays rooted in the run across the loop rather
        -- than letting the drop pass release the block before the kernel writes into it.
        let base = slots(buffer)
        let &running = True

        while running:
            let filled = readDirectoryEntries(dir.handle, base, entryBlock)

            if filled < 0:
                yield Err(errorOf(0 - filled))
                running = False
            else if filled == 0:
                running = False
            else:
                let &at = 0 :: Size

                while at < filled:
                    let record = bitcast(base + at) :: %DirectoryRecord
                    at = at + ((*record).length :: Size)

                    -- A record the kernel has already unlinked, which is what a zero inode means.
                    if (*record).inode != 0 && !isSelfOrParent(record):
                        yield Ok(DirectoryEntry {name: nameOf(record),
                                                 isDirectory: (*record).kind == entryKindByte(EntryDirectory)})

-- The kernel's own byte for one of `getdents64`'s kinds, which is what the record holds.
fn entryKindByte(kind: EntryKind) -> U8 = truncate(valueOf(kind)) :: U8

-- Where a record's name starts. The head is a record and the name is not a field of it - its length
-- is a scan rather than a number the head carries - so this is the one piece of address arithmetic a
-- variable-length record costs.
fn nameStart(return record: %DirectoryRecord) -> %U8 = (bitcast(record) :: %U8) + entryNameOffset

-- The name out of one record: NUL-terminated inside the record, so its length is a scan rather than
-- a field. `d_reclen` covers the padding after it, which is why it cannot be used as the length.
fn nameLength(record: %DirectoryRecord) -> Size:
    let from = nameStart(record)
    let &count = 0 :: Size

    while *(from + count) != 0:
        count = count + 1

    return count

fn nameOf(record: %DirectoryRecord) -> String:
    let count = nameLength(record)
    let &name = String.ofCapacity(count)
    String.appendUnits(name, bitcast(nameStart(record)) :: %CodeUnit, count)

    return name

-- `.` and `..`, tested on the record's own bytes rather than on a string this would otherwise
-- allocate for every entry only to throw away.
fn isSelfOrParent(record: %DirectoryRecord) -> Bool:
    let count = nameLength(record)
    if count > 2 || count == 0 then return False

    let from = nameStart(record)
    if *from != 46 then return False
    if count == 1 then return True

    return *(from + 1) == 46

{-
   ==========================================================================================
   Whole files.
   ==========================================================================================

   The reason to write them here is Analysis-Library.md's part 6, which names item 7 as "the point
   at which Yana can write a program that reads its input". Without these that program is an open, a
   stat, an allocation, a read loop and a close at every call site.

   **The read is one allocation and one `read` for a file whose size the `stat` knew**, which is
   every ordinary file. What makes that exact rather than optimistic is the loop: a file that grew
   between the two calls, and one whose size `stat` cannot answer at all - a pipe, `/proc` - are
   both read to the end by the same path, at the cost of a doubling when the first guess was short.
-}
let readBlock = 4096 :: Size

pub fn readWholeFile(path: String) -> Result(FileError, String):
    let ->file = openFile(path, readAccess(), OpenExisting)?
    let info = fileInfo(file)?

    -- The size as a capacity, which is a narrowing on a target whose word is smaller than an
    -- `off_t`. It costs nothing to be wrong: the loop below grows the string whenever it runs out
    -- and refuses a file past `maxCount` either way, so this is a first guess rather than a bound.
    let &text = String.ofCapacity(if info.size > 0 then truncate(info.size) :: Size else readBlock)
    let &total = 0 :: Size
    let &running = True

    while running:
        let target = stringDataMut(text)
        let room = (target.bytes.run.capacity :: Size) - total

        -- Nothing left to fill: grow before asking, so that the read below always has room and a
        -- short answer means the file ended rather than that the buffer did.
        if room <= 0:
            String.reserve(text, readBlock)
        else:
            let got = readFile(file.handle, bitcast(target.bytes.run.items + total) :: %U8, room)
            if got < 0 then return Err(errorOf(0 - got))

            total = total + got

            -- A string's live prefix is a `Count`, so a file past what one can hold is refused here
            -- rather than truncated into a length that disagrees with the bytes behind it - the
            -- same answer `resize` gives for the same reason.
            if total > maxCount then return Err(NoBufferSpace)

            target.bytes.length = truncate(total) :: Count
            running = got != 0

    let ->done = text
    return Ok(done)

pub fn writeWholeFile(path: String, text: String) -> Result(FileError, {}):
    let ->file = openFile(path, writeAccess(), CreateAlways)?
    return writeAllText(file, text)

-- The write loop, as its own function for the reason every path helper above is one: `text` is a
-- parameter here, so the caller owns it for the whole of the loop and the address does not go stale
-- under a partial write.
fn writeAllText(file: File, text: String) -> Result(FileError, {}):
    let &written = 0 :: Size

    while written < length(text):
        let put = writeFile(file.handle, bytesOf(text) + written, length(text) - written)
        if put < 0 then return Err(errorOf(0 - put))

        written = written + put

    return Ok({})
