{-
   Characters - Implementation-String.md part 1 and part 1.1.

   A `Char` is one Unicode code point, and every one that a literal or a decode produces is a scalar
   value: at most `0x10FFFF` and never a surrogate. The newtype's constructor cannot check that, so
   `Char.fromU32` is the checked way in and `Char(v)` is the unchecked one.

   **Integer-like without being arithmetic.** It compares, orders and hashes as the number it holds,
   and arithmetic goes through `.0`: `c.0 - "0"` is a digit's value, because the literal becomes the
   `U32` it stands opposite. Adding two characters is not an operation on characters.
-}
@builtin(character)
pub alias qualified Char = U32 deriving (Eq, Ord)

instance Hash(Char):
    fn hash(value: Char, state: U32) -> U32 = hash(value.0, state)

-- The replacement character, which is what decoding answers for anything that is not a character.
pub let replacementChar = Char(0xFFFD)

-- `value` as a `Char` where it is a scalar value, and `Nothing` for a surrogate or anything above
-- the last plane.
pub fn Char.fromU32(value: U32) -> Maybe(Char) =
    if value > 0x10FFFF || (value >= 0xD800 && value <= 0xDFFF) then Nothing else Just(Char(value))

{-
   The literal conversions - part 1.1's table.

   **A literal never reaches these bodies** at `Char` or at an integer: the compiler checks
   that the text is one code point the type means the same thing by, and folds it to a constant.
   What runs here is the conversion a generic body asks for with a string that is not a literal -
   `fn (FromText(a)) f(text: String) -> a = fromText(text)` - and it cannot refuse, so it reads the
   first character and narrows it, with U+FFFD for an empty or malformed start.

   `String`'s instance is the one every literal has by default, and a literal at `String` is the
   constant it always was rather than a call of this.
-}
instance FromText(String):
    fn fromText(value: String) -> String = copy(value)

instance FromText(Char):
    fn fromText(value: String) -> Char = Char(firstCharOf(value))

instance FromText(U8):
    fn fromText(value: String) -> U8 = truncate(firstCharOf(value))

instance FromText(I8):
    fn fromText(value: String) -> I8 = truncate(firstCharOf(value))

instance FromText(U16):
    fn fromText(value: String) -> U16 = truncate(firstCharOf(value))

instance FromText(I16):
    fn fromText(value: String) -> I16 = truncate(firstCharOf(value))

instance FromText(U32):
    fn fromText(value: String) -> U32 = firstCharOf(value)

instance FromText(I32):
    fn fromText(value: String) -> I32 = bitcast(firstCharOf(value))

instance FromText(U64):
    fn fromText(value: String) -> U64 = firstCharOf(value) :: U64

instance FromText(I64):
    fn fromText(value: String) -> I64 = firstCharOf(value) :: I64

instance FromText(CodeUnit):
    fn fromText(value: String) -> CodeUnit = truncate(firstCharOf(value))

instance FromText(Size):
    fn fromText(value: String) -> Size = truncate(firstCharOf(value))

instance FromText(USize):
    fn fromText(value: String) -> USize = firstCharOf(value) :: USize
