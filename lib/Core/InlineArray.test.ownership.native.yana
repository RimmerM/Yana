{-
   `@inline(n) @capacity(n) [T]` - `InlineArray.ownership.native.yana` (J143).

   The one half of the refinement a golden fixture cannot state is the bound: a `push` past `n` stops
   the program, which takes a driver that runs `main` in its own process down with it. So it is here,
   as `@test(aborts)`, beside the growth it refuses.
-}

import Native
import Test

data Small {items: @inline(3) @capacity(3) [Int], tag: Int}

@test fn growsToItsBound():
    let &s = Small {items: [1], tag: 0}
    push(s.items, 2)
    push(s.items, 3)
    checkEqual(length(s.items), 3 :: Size)
    checkEqual(s.items[2], 3)

-- The descriptor a `push` works on is built from the record's address at the call, so a record that
-- moved between two pushes is grown where it is now.
fn moved(->s: Small) -> Small = s

@test fn growsAfterAMove():
    let &first = Small {items: [5], tag: 1}
    push(first.items, 6)

    let &second = moved(first)
    push(second.items, 7)
    checkEqual(second.items[0] + second.items[1] + second.items[2], 18)

-- `@capacity(n)` is a bound and not a hint: the fourth `push` into three slots is refused where it
-- would relocate storage the descriptor does not own, and the refusal stops the program.
@test(aborts) fn pushPastTheBound():
    let &s = Small {items: [1, 2, 3], tag: 0}
    push(s.items, 4)

-- A callee that replaces the array it was lent as a growable one leaves a descriptor that is not over
-- the record's slots, and `commitGrowable` stops the program rather than count what is not there
-- (J146 - it used to write the new length over the old elements).
fn replaced(&xs: Array(Int)):
    xs = [7, 8, 9]

@test(aborts) fn replacedByCallee():
    let &s = Small {items: [1], tag: 0}
    replaced(s.items)
