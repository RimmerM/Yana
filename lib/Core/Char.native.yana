import Native

{-
   The first character of a UTF-8 string, for `FromText`'s run-time conversions.

   Strict about what a sequence is - no overlong forms, no surrogates, nothing past U+10FFFF - and
   U+FFFD for anything else, including an empty string. Part 6's decoder replaces this when it lands.
-}
@platform(native) fn firstCharOf(text: String) -> U32:
    let count = length(text)
    if count == 0 then return 0xFFFD

    let at = units(text)
    let lead = *at :: U32
    if lead < 0x80 then return lead

    let &need = 0 :: Size
    let &value = 0 :: U32
    let &lowest = 0 :: U32

    if lead >= 0xC2 && lead <= 0xDF:
        need = 1
        value = lead `and` 0x1F
        lowest = 0x80
    else if lead >= 0xE0 && lead <= 0xEF:
        need = 2
        value = lead `and` 0x0F
        lowest = 0x800
    else if lead >= 0xF0 && lead <= 0xF4:
        need = 3
        value = lead `and` 0x07
        lowest = 0x10000
    else:
        return 0xFFFD

    if count <= need then return 0xFFFD

    let &i = 1 :: Size
    while i <= need:
        let next = *(at + i) :: U32
        if (next `and` 0xC0) != 0x80 then return 0xFFFD
        value = (value `shl` 6) `or` (next `and` 0x3F)
        i = i + 1

    if value < lowest || value > 0x10FFFF || (value >= 0xD800 && value <= 0xDFFF) then return 0xFFFD
    return value
