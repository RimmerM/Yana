{-
   Namespaced declarations - doc/spec/modules.md, "Namespaces".

   A declaration's name may be qualified, and the prefix is either a type of this module - in which
   case a dot-call on a value of that type finds the name - or nothing, in which case it is a plain
   namespace. What is asserted here is which of those two a call means, since the *name* half is the
   same lookup either way and only the dot-call tells them apart.

   Behaviour rather than shape, so this is a `lib/` fixture: what a namespace changes is which
   function a call selects, and the IR of the selected one is nothing new. The rejection half - an
   operator under a namespace, and adding to a foreign type's namespace - is
   `resolve/Reject.Namespace.yana`, since neither of those produces a program to run.
-}

import Test

data NamespaceBox {v: Int}
data Bag {v: Int}
data Cell(a) {v: a}

{-
   The case the feature exists for: one name, two types, and no `sizeOfBag` anywhere.

   `namespaceSize` bare is `Bag`'s, which is what a name declares when nothing namespaces it. `NamespaceBox.namespaceSize` is
   the second claimant, and it is what a dot on a `NamespaceBox` means - which is the precedence R1 states
   for a dot-call, and the whole of what `reserveString` used to be standing in for.
-}
fn namespaceSize(self: Bag) -> Int = self.v + 100
fn NamespaceBox.namespaceSize(self: NamespaceBox) -> Int = self.v

@test fn typeNamespace() -> {}:
    let b = NamespaceBox(7)
    let g = Bag(7)

    -- The receiver's type selects, and the qualified spelling names the same function.
    checkEqual(b.namespaceSize(), 7)
    checkEqual(NamespaceBox.namespaceSize(b), 7)

    -- And every other type still means the bare one, by either spelling.
    checkEqual(g.namespaceSize(), 107)
    checkEqual(namespaceSize(g), 107)

{-
   A plain namespace, whose prefix names no type at all.

   Nothing declares `Hmac`, and nothing has to: the name is the namespace. So there is no bare
   `tag` and no dot-call reaches these - they are called the way they are written.
-}
fn Hmac.tag(key: Int, message: Int) -> Int = key * 31 + message
fn Hmac.check(key: Int, message: Int, against: Int) -> Bool = Hmac.tag(key, message) == against

@test fn plainNamespace() -> {}:
    checkEqual(Hmac.tag(2, 3), 65)
    check(Hmac.check(2, 3, 65))
    check(!Hmac.check(2, 3, 64))

    -- An ordinary name in every other respect, including value position.
    let f = Hmac.tag
    checkEqual(f(2, 3), 65)

{-
   A generic type has one namespace rather than one per instantiation, because the prefix names the
   declaration and every `Cell(a)` is made from it.

   `bump` also asserts that a `&self` receiver reaches its type's namespace: the dot steps through
   one reference before it asks, which is the same step a bare dot-call takes.
-}
fn Cell.count(self: Cell(a)) -> Int = 1
fn Cell.get(self: Cell(Int)) -> Int = self.v
fn Cell.bump(&self: Cell(Int)) -> {}:
    self.v = self.v + 1

@test fn genericNamespace() -> {}:
    let ints = Cell(5)
    let text = Cell("five")

    checkEqual(ints.count(), 1)
    checkEqual(text.count(), 1)
    checkEqual(Cell.get(ints), 5)

    let &counter = Cell(1)
    counter.bump()
    counter.bump()
    checkEqual(counter.get(), 3)

-- The library's own namespaces, which are what the compiler change was made for.
@test fn library() -> {}:
    let &s = String.ofCapacity(16)
    String.reserve(s, 8)
    s.pushUnit(104)
    s.push("ello")
    checkEqual(s, "hello")
    checkEqual(s.unit(0), 104)
