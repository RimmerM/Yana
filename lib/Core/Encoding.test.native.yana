module Core

{-
   The native vector paths of part 7 against the scalar walks they stand in for.

   The vector validator and counter settle a block with comparisons rather than by walking it, so
   what can go wrong is a rule missed at one lane position or a sequence cut by a block boundary.
   Neither shows up in a hand-written case unless the case happens to put the byte there, so these
   generate thousands of texts - `generatedText` in `Char.test.native.yana`, mostly well-formed with
   a bad byte dropped in now and then - and assert that every vector answer is the scalar one.
-}

import Test

@test fn validatorAgreesWithScalar():
    let &state = 12345 :: U32
    let &wrong = 0
    let &valid = 0

    for round in 0 .. 20000:
        let text = generatedText(state, 90, if round % 4 == 0 then 0 else 4)
        let bytes = String.bytes(text)
        let expected = utf8ValidFrom(bytes, 0)
        if expected then valid = valid + 1
        if isValidUtf8(bytes) != expected then wrong = wrong + 1

    checkEqual(wrong, 0)
    -- Both answers occur often enough for the agreement to mean something.
    check(valid > 3000)
    check(valid < 17000)

-- `String.bytes` is the string's own units, not a copy of them.
@test fn bytesIsAWindow():
    let text = "aé€😀z"
    let bytes = String.bytes(text)
    checkEqual(length(bytes), length(text))
    checkEqual(bytes[1] :: U32, 0xC3)
    check(bytes.items == (bitcast(units(text)) :: %U8))

{-
   The vector transcoders against a character-at-a-time walk, over the same generated text - broken
   text included, since what a transcoder writes for a broken
   sequence is part of what it promises.
-}
fn referenceUtf16(text: String) -> [U16]:
    let &out = [] :: [U16]
    let &at = 0 :: Size

    while at < length(text):
        let {char, next} = decodeChar(text, at)
        if char.0 < 0x10000:
            push(out, truncate(char.0) :: U16)
        else:
            push(out, truncate(0xD800 + ((char.0 - 0x10000) `shr` 10)) :: U16)
            push(out, truncate(0xDC00 + ((char.0 - 0x10000) `and` 0x3FF)) :: U16)
        at = next

    return out

fn sameUnits(left: [U16], right: [U16]) -> Bool:
    if length(left) != length(right) then return False
    for i in 0 .. length(left):
        if left[i] != right[i] then return False

    return True

@test fn transcodersAgreeWithWalk():
    let &state = 31337 :: U32
    let &wrong = 0

    for round in 0 .. 3000:
        let text = generatedText(state, 120, if round % 2 == 0 then 0 else 4)
        let &units = [] :: [U16]
        String.appendUtf16(text, units)

        let expected = referenceUtf16(text)
        if !sameUnits(elements(units), elements(expected)) then wrong = wrong + 1

        -- The `Unchecked` form agrees on valid text, and on the rest only has to stay in bounds.
        let &trusted = [] :: [U16]
        String.appendUtf16Unchecked(text, trusted)
        if round % 2 == 0 && !sameUnits(elements(trusted), elements(expected)) then wrong = wrong + 1
        if length(trusted) > length(text) then wrong = wrong + 1

        -- Back to UTF-8 is the text with every broken sequence as U+FFFD, which is `chars` re-encoded.
        let &encoded = String.ofCapacity(length(text))
        for c in chars(text):
            String.pushChar(encoded, c)
        if String.fromUtf16(elements(units)) != encoded then wrong = wrong + 1

    checkEqual(wrong, 0)

{-
   The same agreement over text that is mostly three-byte characters, which `generatedText` rarely
   puts five of in a row: the register steps in `widenThreeByteRegisters` and `narrowThreeByteRun`
   take five or three characters, and eight or four units, so a run has to be that long and has to
   end - at ASCII, a two- or four-byte character, a lead the register step leaves to the scalar walk
   (`E0`, `ED`, `EE`, `EF`), a broken sequence, or on the UTF-16 side a surrogate - at every lane.
-}
let threeByteChars = [0x800 :: U32, 0xFFF, 0x1000, 0x4E00, 0x9FFF, 0xCFFF, 0xD000, 0xD7FF, 0xE000, 0xFFFD,
                      0xFFFF, 0x4E2D, 0x6587]
let runEnds = [0x20 :: U32, 0xE9, 0x1F600, 0x7FF, 0x10000]

-- UTF-16 to UTF-8 a unit at a time: a pair is its character, and any other surrogate U+FFFD.
fn referenceUtf8(units: [U16]) -> String:
    let &out = String.ofCapacity(3 * length(units))
    let &at = 0 :: Size

    while at < length(units):
        let unit = units[at] :: U32
        if unit is 0xD800..=0xDBFF && at + 1 < length(units) && units[at + 1] is 0xDC00..=0xDFFF:
            String.pushChar(out, Char(0x10000 + ((unit - 0xD800) `shl` 10) + ((units[at + 1] :: U32) - 0xDC00)))
            at = at + 2
        else:
            String.pushChar(out, Char(unit))
            at = at + 1

    return out

@test fn threeByteRunsAgreeWithWalk():
    let &state = 4242 :: U32
    let &wrong = 0

    for round in 0 .. 6000:
        let broken = round % 3 == 0
        let size = below(state, 100)
        state = nextState(state)

        let &text = String.ofCapacity(3 * size)
        let &units = [] :: [U16]
        for _ in 0 .. size:
            let pick = below(state, 100)
            state = nextState(state)

            if pick < 8:
                String.pushChar(text, Char(runEnds[below(state, 5)]))
            else if broken && pick < 12:
                -- A lead cut short, or a continuation where a lead should be.
                String.pushUnit(text, if pick < 10 then 0xE4 else 0x80)
                if pick == 8 then String.pushUnit(text, 0xB8)
            else:
                String.pushChar(text, Char(threeByteChars[below(state, 13)]))
            state = nextState(state)

        String.appendUtf16(text, units)
        let expected = referenceUtf16(text)
        if !sameUnits(elements(units), elements(expected)) then wrong = wrong + 1

        let &trusted = [] :: [U16]
        String.appendUtf16Unchecked(text, trusted)
        if !broken && !sameUnits(elements(trusted), elements(expected)) then wrong = wrong + 1

        -- A lone surrogate at one unit in four rounds, anywhere in a register.
        if round % 4 == 1 && length(units) > 0:
            units[below(state, truncate(length(units)) :: U32)] = if round % 8 == 1 then 0xD800 else 0xDC00
            state = nextState(state)

        if String.fromUtf16(elements(units)) != referenceUtf8(elements(units)) then wrong = wrong + 1

    checkEqual(wrong, 0)
