module Core

{-
   Malformed UTF-8 - Implementation-String.md part 6's replacement rule, natively.

   The sequences are the Unicode Standard's own examples of U+FFFD substitution of maximal subparts
   (chapter 3, tables 3-8 to 3-11), which is also what the WHATWG decoder answers, so these are the
   numbers a host `TextDecoder` gives for the same bytes. Each text is walked forwards and backwards,
   and its boundaries are checked at every offset, since a stray byte is a boundary on each side.
-}

import Test

fn bytesText(bytes: [U8]) -> String:
    let &text = String.ofCapacity(length(bytes))
    for i in 0 .. length(bytes):
        String.pushUnit(text, bytes[i])

    return text

@test fn maximalSubparts():
    -- Table 3-8: a lead with too few continuations is one replacement, a stray continuation is one.
    let table8 = bytesText(elements([0x61 :: U8, 0xF1, 0x80, 0x80, 0xE1, 0x80, 0xC2, 0x62, 0x80, 0x63, 0x80, 0xBF, 0x64]))
    checkEqual(charNumbers(table8), "97 65533 65533 65533 98 65533 99 65533 65533 100")
    checkEqual(charNumbersBackwards(table8), charNumbers(table8))
    checkEqual(countChars(table8), 10)
    checkEqual(boundaryMismatches(table8), 0)

    -- Table 3-9: overlong forms are refused at the second byte, so every byte is its own replacement.
    let table9 = bytesText(elements([0xC0 :: U8, 0xAF, 0xE0, 0x80, 0xBF, 0xF0, 0x81, 0x82, 0x41]))
    checkEqual(charNumbers(table9), "65533 65533 65533 65533 65533 65533 65533 65533 65")
    checkEqual(charNumbersBackwards(table9), charNumbers(table9))
    checkEqual(boundaryMismatches(table9), 0)

    -- Table 3-10: surrogates encoded as UTF-8 are refused the same way.
    let table10 = bytesText(elements([0xED :: U8, 0xA0, 0x80, 0xED, 0xBF, 0xBF, 0xED, 0xAF, 0x41]))
    checkEqual(charNumbers(table10), "65533 65533 65533 65533 65533 65533 65533 65533 65")
    checkEqual(charNumbersBackwards(table10), charNumbers(table10))
    checkEqual(boundaryMismatches(table10), 0)

    -- Table 3-11: past U+10FFFF, and a byte that is never UTF-8.
    let table11 = bytesText(elements([0xF4 :: U8, 0x91, 0x92, 0x93, 0xFF, 0x41, 0x80, 0xBF, 0x42]))
    checkEqual(charNumbers(table11), "65533 65533 65533 65533 65533 65 65533 65533 66")
    checkEqual(charNumbersBackwards(table11), charNumbers(table11))
    checkEqual(boundaryMismatches(table11), 0)

    -- Table 3-12's truncated sequences, each one replacement for its valid prefix.
    let table12 = bytesText(elements([0xE1 :: U8, 0x80, 0xE2, 0xF0, 0x91, 0x92, 0xF1, 0xBF, 0x41]))
    checkEqual(charNumbers(table12), "65533 65533 65533 65533 65")
    checkEqual(charNumbersBackwards(table12), charNumbers(table12))
    checkEqual(boundaryMismatches(table12), 0)

-- A sequence cut off by the end of the text, and more continuation bytes than any lead takes.
@test fn truncatedAndOverlong():
    let cut = bytesText(elements([0x61 :: U8, 0xF0, 0x9F, 0x98]))
    checkEqual(charNumbers(cut), "97 65533")
    checkEqual(charNumbersBackwards(cut), "97 65533")
    check(!isCharBoundary(cut, 2))
    checkEqual(floorCharBoundary(cut, 3), 1)
    checkEqual(ceilCharBoundary(cut, 2), 4)

    let long = bytesText(elements([0xF0 :: U8, 0x9F, 0x98, 0x80, 0x80, 0x80]))
    checkEqual(charNumbers(long), "128512 65533 65533")
    checkEqual(charNumbersBackwards(long), charNumbers(long))
    checkEqual(boundaryMismatches(long), 0)

    -- `compareChars` is byte order natively, and invalid bytes are ordered as bytes.
    checkEqual(compareChars(cut, long), compare(cut, long))

{-
   ------------------------------------------------------------------------------------------
   The fast paths against the decoder they replaced
   ------------------------------------------------------------------------------------------

   Build order step 5 gave `decodeChar` a path for well-formed sequences, the boundary functions a
   form that does not decode, and `countChars` a vector loop. What follows is the stage-3 scalar
   decoder, kept here word for word as the reference, and a generator of text that is mostly
   well-formed with the edge bytes of every rule dropped in - so that every answer of the new forms
   is compared with the old one at every offset of thousands of texts, and every `Unchecked` form
   with its checked one on the texts that are valid.
-}

fn referenceDecodeChar(text: String, at: Size) -> {Char, Size}:
    if !isUnitOffset(text, at) then return {replacementChar, at}

    let lead = unitNumber(text, at)
    if lead < 0x80 then return {Char(lead), at + 1}

    let {need, bits} = leadBits(lead)
    if need == 0 then return {replacementChar, at + 1}

    let count = length(text)
    let end = at + 1 + need
    let &value = bits
    let &next = at + 1

    while next < end:
        -- A sequence cut off by the end of the text, or broken by a unit that cannot continue it, is
        -- one replacement for what was read so far.
        if next >= count then return {replacementChar, next}

        let unit = unitNumber(text, next)
        let continues = if next == at + 1 then firstContinuation(lead, unit) else unit is 0x80..=0xBF
        if !continues then return {replacementChar, next}

        value = (value `shl` 6) `or` (unit `and` 0x3F)
        next = next + 1

    return {Char(value), end}

fn referenceSequenceStart(text: String, at: Size) -> Size:
    let &start = at
    let &limit = at - 3
    if limit < 0 then limit = 0

    while start > limit && isContinuation(String.unit(text, start)):
        start = start - 1

    return if isContinuation(String.unit(text, start)) then at else start

fn referenceSequenceAround(text: String, at: Size) -> {Size, Size}:
    let start = referenceSequenceStart(text, at)
    let {char, end} = referenceDecodeChar(text, start)
    if end > at then return {start, end}

    return {at, at + 1}

fn referenceDecodeCharBefore(text: String, at: Size) -> {Char, Size}:
    if !isUnitOffset(text, at - 1) then return {replacementChar, at}

    let last = unitNumber(text, at - 1)
    if last < 0x80 then return {Char(last), at - 1}

    -- The decode that covers the last unit ends exactly at `at` when it is a whole character, and
    -- anywhere else leaves that unit as a replacement of its own.
    let start = referenceSequenceStart(text, at - 1)
    let {char, end} = referenceDecodeChar(text, start)
    if end != at then return {replacementChar, at - 1}

    return {char, start}

fn referenceIsCharBoundary(text: String, at: Size) -> Bool:
    -- Past the last unit only the end itself is a boundary, and an empty text's end is also its start.
    if !isUnitOffset(text, at) then return at == length(text)
    if !isContinuation(String.unit(text, at)) then return True

    let {start, end} = referenceSequenceAround(text, at)
    return start == at

fn referenceFloorCharBoundary(text: String, at: Size) -> Size:
    let count = length(text)
    if at <= 0 then return 0
    if at >= count then return count
    if !isContinuation(String.unit(text, at)) then return at

    let {start, end} = referenceSequenceAround(text, at)
    return start

fn referenceCeilCharBoundary(text: String, at: Size) -> Size:
    let count = length(text)
    if at <= 0 then return 0
    if at >= count then return count
    if !isContinuation(String.unit(text, at)) then return at

    let {start, end} = referenceSequenceAround(text, at)
    return if start == at then at else end

-- A linear congruential step, and a number below `bound` taken from its high bits.
fn nextState(state: U32) -> U32 = state * 1103515245 + 12345
fn below(state: U32, bound: U32) -> Size = truncate((state `shr` 16) % bound)

-- The bytes the rules are about: every lead that narrows its second byte, the edges of each
-- continuation range, and the bytes that are never UTF-8.
let edgeBytes = [0x41 :: U8, 0x7F, 0x80, 0x8F, 0x90, 0x9F, 0xA0, 0xBF, 0xC0, 0xC1, 0xC2, 0xDF, 0xE0,
                     0xE1, 0xED, 0xEE, 0xEF, 0xF0, 0xF1, 0xF3, 0xF4, 0xF5, 0xF8, 0xFC, 0xFF]

-- The continuation bytes at the edges of the narrowed second-byte ranges.
let edgeContinuations = [0x80 :: U8, 0x8F, 0x90, 0x9F, 0xA0, 0xBF]

-- A spread of characters across every sequence length and every narrowed range.
let sampleChars = [0x61 :: U32, 0x7F, 0x80, 0xE9, 0x7FF, 0x800, 0xFFF, 0x1000, 0xD7FF, 0xE000, 0xFFFD,
                   0xFFFF, 0x10000, 0x3FFFF, 0x40000, 0xFFFFF, 0x100000, 0x10FFFF]

fn generatedText(&state: U32, units: U32, badness: Size) -> String:
    let &text = String.ofCapacity(64)
    let size = below(state, units)
    state = nextState(state)

    while length(text) < size:
        let pick = below(state, 100)
        state = nextState(state)

        if pick < badness:
            -- An edge byte on its own, or a lead with as many edge continuations as it asks for -
            -- which is how an overlong form, a surrogate or a value past the last plane is written.
            let lead = edgeBytes[below(state, 25)]
            String.pushUnit(text, lead)
            state = nextState(state)

            if below(state, 2) == 0:
                let &more = if lead >= 0xF0 then 3 else if lead >= 0xE0 then 2 else if lead >= 0xC0 then 1 else 0
                while more > 0:
                    state = nextState(state)
                    String.pushUnit(text, edgeContinuations[below(state, 6)])
                    more = more - 1
        else if pick < 60:
            String.pushUnit(text, truncate(0x61 + below(state, 26)) :: CodeUnit)
        else:
            String.pushChar(text, Char(sampleChars[below(state, 18)]))

        state = nextState(state)

    return text

-- How many answers of the decoding functions differ from the reference, over every offset.
fn referenceMismatches(text: String) -> Int:
    let count = length(text)
    let &wrong = 0

    for at in (-1 :: Size) .. (count + 2):
        let {a, aNext} = decodeChar(text, at)
        let {b, bNext} = referenceDecodeChar(text, at)
        if a != b || aNext != bNext then wrong = wrong + 1

        let {c, cStart} = decodeCharBefore(text, at)
        let {d, dStart} = referenceDecodeCharBefore(text, at)
        if c != d || cStart != dStart then wrong = wrong + 1

        if isCharBoundary(text, at) != referenceIsCharBoundary(text, at) then wrong = wrong + 1
        if floorCharBoundary(text, at) != referenceFloorCharBoundary(text, at) then wrong = wrong + 1
        if ceilCharBoundary(text, at) != referenceCeilCharBoundary(text, at) then wrong = wrong + 1

    let &referenceCount = 0 :: Size
    let &at = 0 :: Size
    let &sum = 0 :: I64

    while at < count:
        let {char, next} = referenceDecodeChar(text, at)
        referenceCount = referenceCount + 1
        sum = sum + (char.0 :: I64) * ((at :: I64) + 1)
        at = next

    if countChars(text) != referenceCount then wrong = wrong + 1

    let &charSum = 0 :: I64
    let &walk = 0 :: Size
    for {offset, c} in charOffsets(text):
        charSum = charSum + (c.0 :: I64) * ((offset :: I64) + 1)
        walk = walk + 1
    if charSum != sum || walk != referenceCount then wrong = wrong + 1

    return wrong

-- On valid text, how many answers of the `Unchecked` forms differ from the checked ones.
fn uncheckedMismatches(text: String) -> Int:
    let count = length(text)
    let &wrong = 0

    for at in (-1 :: Size) .. (count + 2):
        if floorCharBoundaryUnchecked(text, at) != floorCharBoundary(text, at) then wrong = wrong + 1
        if ceilCharBoundaryUnchecked(text, at) != ceilCharBoundary(text, at) then wrong = wrong + 1

        -- Only from a boundary: the text before any other offset ends in half a character.
        if isCharBoundary(text, at):
            let {c, cStart} = decodeCharBeforeUnchecked(text, at)
            let {d, dStart} = decodeCharBefore(text, at)
            if c != d || cStart != dStart then wrong = wrong + 1

    if countCharsUnchecked(text) != countChars(text) then wrong = wrong + 1
    if charNumbers(text) != uncheckedCharNumbers(text) then wrong = wrong + 1

    let &offsets = 0 :: I64
    let &expected = 0 :: I64
    for {at, c} in charOffsetsUnchecked(text):
        offsets = offsets + (at :: I64) * (c.0 :: I64)
    for {at, c} in charOffsets(text):
        expected = expected + (at :: I64) * (c.0 :: I64)
    if offsets != expected then wrong = wrong + 1

    return wrong

fn uncheckedCharNumbers(text: String) -> String:
    let &out = ""
    for c in charsUnchecked(text):
        if length(out) > 0 then out.push(" ")
        out.push("{c.0}")

    return out

@test fn fastPathsAgreeWithReference():
    let &state = 777 :: U32
    let &wrong = 0
    let &invalid = 0

    for round in 0 .. 3000:
        let text = generatedText(state, 80, if round % 3 == 0 then 0 else 5)
        wrong = wrong + referenceMismatches(text)
        if !isValidUtf8(String.bytes(text)) then invalid = invalid + 1

    checkEqual(wrong, 0)
    check(invalid > 500)
    check(invalid < 2500)

-- An `Unchecked` form answers what its checked form does whenever the text is valid.
@test fn uncheckedAgreesOnValidText():
    let &state = 4242 :: U32
    let &wrong = 0

    for round in 0 .. 3000:
        let text = generatedText(state, 80, 0)
        wrong = wrong + uncheckedMismatches(text)

    checkEqual(wrong, 0)

-- And on anything at all, it stays inside the text and stops. Nothing is asserted about the answers.
@test fn uncheckedIsSafeOnInvalidText():
    let &state = 99 :: U32
    let &total = 0 :: Size

    for round in 0 .. 3000:
        let text = generatedText(state, 80, 30)
        let count = length(text)

        for at in (-1 :: Size) .. (count + 2):
            let down = floorCharBoundaryUnchecked(text, at)
            let up = ceilCharBoundaryUnchecked(text, at)
            let {c, start} = decodeCharBeforeUnchecked(text, at)
            check(down >= 0 && down <= count && up >= 0 && up <= count)
            check(start <= at || at < 0)

        for c in charsUnchecked(text):
            total = total + 1
        for {at, c} in charOffsetsUnchecked(text):
            check(at >= 0 && at < count)
        total = total + countCharsUnchecked(text)

    check(total > 0)
