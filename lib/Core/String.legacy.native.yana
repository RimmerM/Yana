import Native

{-
   `String.slice` under the legacy resolve stage - a copy, because that stage cannot represent a
   window over part of a string. `String.yana` has the contract; `String.ownership.native.yana` is
   the window every library caller is written against. Goes with `compiler/resolve`.
-}
@platform(native) pub fn String.slice(text: String, from: Size, to: Size) -> String:
    let count = length(text)
    let &start = from
    if start < (0 :: Size) then start = 0

    let &end = to
    if end > count then end = count
    if start >= end then return ""

    -- One block copy rather than a loop over units, which is what makes this the same operation
    -- `copy` is with an offset on the front.
    let &out = String.ofCapacity(end - start)
    String.appendUnits(out, units(text) + start, end - start)
    return out
