module Core

{-
   Base64, in both directions.

   The vectors are RFC 4648 §10's, which is the list every implementation is checked against and is
   chosen for exactly the property this needs: `f`, `fo`, `foo`, `foob`, `fooba`, `foobar` walk the
   three tail lengths twice, so a padding mistake or an off-by-one in the last group shows up in one
   of the six.

   The alphabet is checked on a byte run that reaches the two units the two of them disagree about -
   `0xfb 0xff 0xbe` is the only kind of input that can tell `+/` from `-_` - and the round trip is
   checked over every tail length, since that is the claim a caller depends on.
-}

import Test
import Native

-- A run of bytes from a text's units, which is how the vectors below are written as strings.
fn bytesOfText(text: String) -> Array(U8):
    let &out = emptyArray() :: Array(U8)
    for i in 0 .. length(text):
        push(out, truncate(String.unit(text, i)) :: U8)

    return out

-- And back, so a round trip can be asserted against the text it started from.
fn textOfBytes(bytes: [U8]) -> String:
    let &out = String.ofCapacity(length(bytes))
    for i in 0 .. length(bytes):
        String.pushUnit(out, bytes[i])

    return out

@test fn base64Vectors():
    checkEqual(base64Of(bytesOfText("f")), "Zg==")
    checkEqual(base64Of(bytesOfText("fo")), "Zm8=")
    checkEqual(base64Of(bytesOfText("foo")), "Zm9v")
    checkEqual(base64Of(bytesOfText("foob")), "Zm9vYg==")
    checkEqual(base64Of(bytesOfText("fooba")), "Zm9vYmE=")
    checkEqual(base64Of(bytesOfText("foobar")), "Zm9vYmFy")

    -- The formatter and the whole-string form write the same text, which is the property that makes
    -- `base64Of` a convenience rather than a second implementation.
    checkEqual("{base64(bytesOfText("foob"))}", "Zm9vYg==")

@test fn base64Alphabets():
    let odd = bytesOfText("")
    let &run = emptyArray() :: Array(U8)
    push(run, 251)
    push(run, 255)
    push(run, 190)

    checkEqual("{base64(run)}", "+/++")
    checkEqual("{base64Url(run)}", "-_--")

    -- `url` and `pad` are separate fields, so a padded URL-safe text is spellable - some libraries
    -- emit one, and this reads and writes it.
    checkEqual("{base64(bytesOfText("f"), url: True)}", "Zg==")
    checkEqual("{base64(bytesOfText("f"), url: True, pad: False)}", "Zg")
    checkEqual(length(odd), 0)

{-
   Reading, which accepts either alphabet and either padding whatever the style says - `hexValue`'s
   tolerance, at this notation's group size.
-}
@test fn base64Reading():
    let &at = 0 :: Size

    match readBase64("Zm9vYmFy", at):
        Ok(bytes) -> check(textOfBytes(bytes) == "foobar" && at == 8)
        Err(_) -> check(False)

    at = 0
    match readBase64("Zg==rest", at):
        Ok(bytes) -> check(textOfBytes(bytes) == "f" && at == 4)
        Err(_) -> check(False)

    -- Unpadded, which is what the URL-safe form writes and is the same bytes.
    at = 0
    match readBase64("Zm9vYmE", at):
        Ok(bytes) -> check(textOfBytes(bytes) == "fooba" && at == 7)
        Err(_) -> check(False)

    at = 0
    match readBase64("-_--", at):
        Ok(bytes) -> check(length(bytes) == 3 && (bytes[0] :: Int) == 251)
        Err(_) -> check(False)

{-
   A group of one unit carries no whole byte, so the run stops in front of it - `readHexBytes`'
   answer to an odd trailing digit, at a group of four. A text with no group at all is `NoDigits` and
   the cursor does not move.
-}
@test fn base64Partial():
    let &at = 0 :: Size

    match readBase64("Zm9vZ", at):
        Ok(bytes) -> check(textOfBytes(bytes) == "foo" && at == 4)
        Err(_) -> check(False)

    at = 0
    match readBase64("!!!", at):
        Ok(_) -> check(False)
        Err(NoDigits) -> checkEqual(at, 0)
        Err(_) -> check(False)

-- The identity, over every tail length and both alphabets. `readAll` is the whole-string form, so a
-- trailing unit is a failure rather than a shorter success.
@test fn base64RoundTrip():
    let cases = ["f", "fo", "foo", "foob", "fooba", "foobar", "the quick brown fox"]
    for i in 0 .. length(cases):
        let raw = bytesOfText(cases[i])

        match readAll(base64Style(), base64Of(raw)) :: Result(ReadError, Array(U8)):
            Ok(back) -> checkEqual(textOfBytes(back), cases[i])
            Err(_) -> check(False)

        match readAll(base64UrlStyle(), base64Of(raw, url: True, pad: False)) :: Result(ReadError, Array(U8)):
            Ok(back) -> checkEqual(textOfBytes(back), cases[i])
            Err(_) -> check(False)

@test fn base64Bounds():
    checkAtMost(length("{base64(bytesOfText("foob"))}"), bound(base64(bytesOfText("foob"))))
    checkAtMost(length("{base64Url(bytesOfText("fooba"))}"), bound(base64Url(bytesOfText("fooba"))))

{-
   Every length from 0 to 100 against an encoder written a bit at a time, in both alphabets.

   Natively the whole groups are encoded twelve bytes a turn by a vector body (`Base64.native.yana`)
   that stops sixteen bytes short of the end and hands the rest to the scalar groups, so the lengths
   worth trying are every one around each multiple of twelve - and the byte pattern walks every
   six-bit window through all of its sixty-four values, which is where an offset table would be wrong.
-}
fn referenceBase64(bytes: [U8], url: Bool) -> String:
    let alphabet = if url then "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
                   else "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    let &out = String.ofCapacity(length(bytes) * 2)
    let bits = length(bytes) * 8
    let &at = 0 :: Size

    while at < bits:
        let &window = 0
        for k in 0 .. 6:
            let bit = at + (k :: Size)
            let set = bit < bits && ((bytes[bit / 8] :: Int) `shr` (7 - (truncate(bit % 8) :: Int))) `and` 1 == 1
            window = window * 2 + (if set then 1 else 0)

        String.pushUnit(out, String.unit(alphabet, window :: Size))
        at = at + 6

    if !url:
        while length(out) % 4 != 0:
            String.pushUnit(out, "=")

    return out

@test fn base64EveryLength():
    let &bad = 0

    for n in 0 .. 101:
        let &bytes = emptyArray() :: Array(U8)
        for k in 0 .. n:
            push(bytes, truncate(k * 37 + 11 + (k / 7) * 64) :: U8)

        if base64Of(bytes) != referenceBase64(bytes, False) then bad = bad + 1
        if base64Of(bytes, url: True, pad: False) != referenceBase64(bytes, True) then bad = bad + 1

    checkEqual(bad, 0)

{-
   And the reading direction at every length, which is where the block form of the reader lives.

   `pushBase64Blocks` takes sixteen units - four groups, twelve bytes - at a time and abandons a
   block holding anything that is not a unit of either alphabet, so the lengths worth walking are
   every one around each multiple of sixteen units, and the two endings worth having are a padded
   text (where `=` is what stops the block) and an unpadded one (where running out is). Both are
   here, in both alphabets, against the bytes that were encoded.

   The byte pattern is the encoder sweep's, which walks every six-bit window through all sixty-four
   of its values - so a body that got one run of the alphabet's arithmetic wrong is wrong at some
   length here rather than only on text nobody wrote.
-}
@test fn base64ReadingEveryLength():
    let &bad = 0

    -- From one, because a text of no groups is `NoDigits` rather than no bytes - which is the
    -- reader's own answer and is asserted where it is stated, in `base64Partial`.
    for n in 1 .. 101:
        let &bytes = emptyArray() :: Array(U8)
        for k in 0 .. n:
            push(bytes, truncate(k * 37 + 11 + (k / 7) * 64) :: U8)

        match readAll(base64Style(), base64Of(bytes)) :: Result(ReadError, Array(U8)):
            Ok(back) -> (if !itemsEqual(elements(back), elements(bytes)) then bad = bad + 1)
            Err(_) -> bad = bad + 1

        match readAll(base64UrlStyle(), base64Of(bytes, url: True, pad: False)) :: Result(ReadError, Array(U8)):
            Ok(back) -> (if !itemsEqual(elements(back), elements(bytes)) then bad = bad + 1)
            Err(_) -> bad = bad + 1

    checkEqual(bad, 0)

{-
   A unit that is not base64 in the middle of a long run, at every position of the first block.

   The block form either takes sixteen units or none, so the position of the first illegal unit
   decides how much of the text the group walk behind it is handed - and the cursor and the bytes
   have to come out the same wherever it falls. A run long enough for several blocks with the stop
   moved through the first of them is what says the two bodies agree about where a run ends.
-}
@test fn base64StopsAtTheFirstIllegalUnit():
    let &bad = 0

    for stop in 1 .. 40:
        let &text = String.ofCapacity(80)
        for k in 0 .. 80:
            text.pushUnit((if k == stop then "!" else "A") :: CodeUnit)

        {-
           The whole groups before the stop, and then whatever the group the stop is in still
           carries: four units are three bytes, three are two and two are one, and a lone unit is
           six bits of nothing and is not taken at all. That last case is also the only way this run
           ends with no bytes, which is `NoDigits`.
        -}
        let groups = stop / 4
        let held = stop % 4
        let partial = if held < 2 then 0 else held - 1

        let wantBytes = (groups :: Size) * 3 + (partial :: Size)
        let wantAt = (groups :: Size) * 4 + (if held < 2 then 0 else held :: Size)

        let &at = 0 :: Size

        match readBase64(text, at):
            Ok(back):
                if length(back) != wantBytes then bad = bad + 1
                if at != wantAt then bad = bad + 1
                for b in 0 .. length(back):
                    if (back[b] :: Int) != 0 then bad = bad + 1
            Err(_) -> (if wantBytes > 0 then bad = bad + 1)

    checkEqual(bad, 0)
