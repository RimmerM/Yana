module Core

import Native

{-
   `pushHex` and the reader's blocks, natively - the kernel's block bodies (`HexKernel.native.yana`, at
   the natural width since J238; until then sixteen lanes and a sixty-four-lane `.native.avx512.yana`)
   lent the reserved run of a string or an array as a byte window, as `Base64.native.yana` lends
   Base64's (J202 D5, J234). Until J235 each of these held
   its own vector loop: `pushHex` the encoding bodies over a `%CodeUnit`, in this file and a replacement
   of its own at `avx512`, and `pushHexBlocks` a sixteen-lane decoder by range tests.

   `Format/Hex.yana` beside this states what the operations are.

   **The write goes into the string's own run**, which is what the reservation is for: natively a
   `String` is its UTF-8 bytes, digits are ASCII, and the length is set before the kernel runs, so the
   window is exactly the units it writes and nothing is zero-filled. `String.appendUnits` makes the same
   capacity check for the same reason - a reserve the allocator refused is a write past the end of the
   run and not a lost append.
-}
@inline pub fn pushHex(bytes: [U8], &to: String, upper: Bool = False):
    let n = length(bytes)
    if n <= 0 then return

    String.reserve(to, n + n)

    let start = to.units.length :: Size
    let wanted = start + n + n
    checkCondition((to.units.run.capacity :: Size) < wanted)
    to.units.length = truncate(wanted) :: Count

    let &window = ArrayView {items: bitcast(to.units.run.items + start) :: %U8, length: n + n}
    let blocks = encodeHexBlocks(upper, bytes, window)

    -- The native block bodies take every byte that fits - ragged end included - and the window is
    -- exactly their room, so this is all of them. Tested rather than finished by `encodeHexRun`:
    -- keeping `upper` and the count live across the call for a finish that never runs was a quarter
    -- of a nanosecond on a sixteen-byte `hexOf` (J235 §5).
    checkCondition(blocks.read != n)

{-
   The block form of the reader: the kernel's `decodeHexBlocks`, lent the array's reserved bytes as
   the window. What comes back is a pair boundary with exactly the pairs' bytes appended, which is all
   `Hex.yana`'s walk needs: an odd trailing digit, a separator and a unit that is not hexadecimal at
   all end a block, and the walk finishes the run from there. The window is a byte per two units of
   what is left, and the blocks write nothing past their bytes.
-}
@replaces
fn pushHexBlocks(text: String, from: Size, &bytes: Array(U8)) -> Size:
    let units = length(text)
    if from + 16 > units then return from

    let held = bytes.length :: Size
    let room = (units - from) / 2
    reserve(bytes, held + room)

    -- The text's units from `from` as a window built rather than sliced: `from + 16 <= units` is tested
    -- above and the slice's clamps were four `cmov`s on a sixteen-byte read.
    let &window = ArrayView {items: bytes.run.items + held, length: room}
    let source = ArrayView {items: String.bytes(text).items + from, length: units - from}
    let run = decodeHexBlocks(source, window)

    bytes.length = truncate(held + run.written) :: Count
    return from + run.read
