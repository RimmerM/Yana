module Core

import Native

{-
   Bytes as hexadecimal - `Format/Hex.yana` states what it is, and here it is the walk it reads as.

   Two `pushUnit`s per byte, which are the host's `+` and therefore a rope, so the chain is linear.
   There is no run under a host string to store a vector into and no bytes to load one out of, so
   the native half's block form has nothing to say here; the reservation is the no-op it is on this
   target and is left off rather than written to be ignored.
-}
pub fn pushHex(bytes: [U8], &to: String):
    let n = length(bytes)
    let &i = 0 :: Size

    while i < n:
        let byte = bytes[i] :: Int
        to.pushUnit(hexUnit(byte `shr` 4))
        to.pushUnit(hexUnit(byte `and` 15))
        i = i + 1
