module Core

import Native

{-
   `pushHex` at the natural width - the `avx512` body of the function `Hex.native.yana` declares
   (Design-Replacements.md). What the operation is, and why the digit is arithmetic, is stated there.

   **The width the baseline could not have.** That body pins sixteen lanes because the two interleaves
   that put the digits in their final order were no instruction at all at 256 bits: every AVX2 shuffle
   works inside a 128-bit half. At `avx512` each is one `vpermi2b` over a pooled index vector
   (Analysis-Avx512.md §2.5), so the loop can take the natural width - sixty-four bytes a turn since
   step 10, thirty-two before it - and write twice that in units. Everything else is the baseline's
   loop with the count changed, and the count is `vectorBytes` rather than a number, which is what
   let the width change under it; the sixteen-entry digit table is read at the natural width's
   indices, which is `vpermi2b` over the table repeated to fill the register (Analysis-Avx512.md §3.3).

   Measured in `test/bench/avx512/findings.md` against the baseline built at the same level.
-}
@replaces
fn pushHex(bytes: [U8], &to: String):
    let n = length(bytes)
    if n <= 0 then return

    String.reserve(to, n + n)

    let start = to.units.length :: Size
    let wanted = start + n + n
    checkCondition((to.units.run.capacity :: Size) < wanted)
    to.units.length = truncate(wanted) :: Count

    let source = bytes.items
    let target = to.units.run.items + start

    let digits = hexDigitVector()
    let width = vectorBytes

    let &i = 0 :: Size
    while i + width <= n:
        let block = vectorAt(source + i) :: Vec(U8)
        let highText = lookup(digits, block `shr` (splat(4) :: Vec(U8)))
        let lowText = lookup(digits, block)

        let low = bitcast(interleaveLow(highText, lowText)) :: Vec(CodeUnit)
        let high = bitcast(interleaveHigh(highText, lowText)) :: Vec(CodeUnit)
        setVectorAt(target + i + i, low)
        setVectorAt(target + i + i + width, high)
        i = i + width

    -- The ragged end, as the baseline writes it at the register's width: `2r` units, the first
    -- `width` of them in the low interleave.
    if i < n:
        let block = vectorPast(source + i) :: Vec(U8)
        let highText = lookup(digits, block `shr` (splat(4) :: Vec(U8)))
        let lowText = lookup(digits, block)
        let units = truncate((n - i) + (n - i)) :: Int
        let lanes = truncate(width) :: Int

        storeUpTo(target + i + i, units `and` (lanes + lanes - 1), bitcast(interleaveLow(highText, lowText)) :: Vec(CodeUnit))
        storeUpTo(target + i + i + width, units - lanes, bitcast(interleaveHigh(highText, lowText)) :: Vec(CodeUnit))
