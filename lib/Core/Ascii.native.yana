import Native

{-
   The ASCII tier, natively - the bulk operations over the string's own bytes.

   `Ascii.yana` beside this is the tier's documentation and the one function both targets share;
   `Ascii.js.yana` is the host's answer to the same two names. Everything here is three lines,
   because the work is `Chunked`'s: declaring that a string is a container of code units is what
   makes `indexOf` and `occurrences` the vector search, and these are the two calls that say so.
-}

instance Chunked(String, CodeUnit):
    iter fn chunks(self: String) -> Flat(CodeUnit) = yield elements(stringData(self).bytes)

-- One vector pass: a lane-wise compare against the splatted unit, and `firstSet` over the hit mask.
pub fn findAscii(self: String, unit: CodeUnit) -> Maybe(Size) = indexOf(self, unit)

-- The same pass with a mask count instead of a first-set, so a count is one traversal rather than a
-- search restarted at every hit.
pub fn countAscii(self: String, unit: CodeUnit) -> Int = occurrences(self, unit)
