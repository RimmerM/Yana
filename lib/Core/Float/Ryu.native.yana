    1822780504889099373, 5246222702107417334, 2278475631111374216, 3278889188817135834,
    1424047269444608885, 8710297504448807696, 1780059086805761106] :: [I64 *652]

{-
   The three logarithm approximations Ryu is written in, each exact over the range it is used on and
   each one multiply and a shift. The ranges are the reference implementation's and are stated
   because nothing here checks them: every caller below derives its argument from a float's own
   exponent field, which is what bounds them.
-}

-- floor(log_10(2^e)), for 0 <= e <= 1650.
fn log10Pow2(e: Int) -> Int = (e * 78913) `shr` 18

-- floor(log_10(5^e)), for 0 <= e <= 2620.
fn log10Pow5(e: Int) -> Int = (e * 732923) `shr` 20

-- floor(log_2(5^e)), for 0 <= e <= 3528. `pow5Bits` is this plus one, which is `ceil` everywhere
-- but at zero - where the answer wanted is 1 and not 0, so the two share a body deliberately.
fn log2Pow5(e: Int) -> Int = (e * 1217359) `shr` 19
fn pow5Bits(e: Int) -> Int = log2Pow5(e) + 1

{-
   The top of a 128-bit product, shifted down - `mulShift64`.

   `m` is 64 bits and the table entry is 128, so the product is 192 and only its top is wanted. The
   low word's product therefore contributes nothing but its own high half, which is what makes this
   two widening multiplies and one 128-bit add rather than a full multiply.

   The add is written out because there is no 128-bit type here to write it in: `sumLow` carries into
   `sumHigh` exactly when it came out below the value it started from, which is the standard
   unsigned-overflow test and is one comparison.

   A zero distance is its own case rather than one the shift handles, because it would ask for a
   64-bit shift of `sumHigh` - a distance the machine's shift does not have and this language does
   not define. Ryu's own distances are all at least one; this is what makes that a fact about the
   caller rather than a precondition.
-}
fn mulShift(m: U64, low: U64, high: U64, shift: Int) -> U64:
    let carried = mulHigh(m, low)
    let productLow = m * high
    let productHigh = mulHigh(m, high)

    let sumLow = carried + productLow
    let sumHigh = productHigh + carryOf(sumLow < carried)

    let distance = shift - 64
    if distance == 0 then return sumLow

    return (sumLow `shr` wideCount(distance)) `or` (sumHigh `shl` wideCount(64 - distance))

fn mulShiftInv(m: U64, index: Int, shift: Int) -> U64 =
    mulShift(m, bitcast(pow5InvSplit[index * 2]) :: U64,
             bitcast(pow5InvSplit[index * 2 + 1]) :: U64, shift)

fn mulShiftPow5(m: U64, index: Int, shift: Int) -> U64 =
    mulShift(m, bitcast(pow5Split[index * 2]) :: U64,
             bitcast(pow5Split[index * 2 + 1]) :: U64, shift)

{-
   How many times five divides a non-zero value.

   By multiplying by five's inverse modulo 2^64 rather than by dividing: the inverse maps the
   multiples of 5^k onto the low 1/5^k of the range, so the product stays at or below 2^64/5 exactly
   while another factor of five is there to remove. One multiply per factor, and no division at all.
-}
fn pow5Factor(value: U64) -> Int:
    -- 5 * inverse = 1 (mod 2^64), written as its own negation because the number itself is above
    -- what a literal holds. `limit` is 2^64 / 5, and the two are exact complements.
    let inverse = (0 :: U64) - 3689348814741910323
    let limit = 3689348814741910323 :: U64

    let &current = value
    let &count = 0 :: Int

    while True:
        current = current * inverse
        if current > limit then break
        count = count + 1

    return count

fn multipleOfPowerOf5(value: U64, power: Int) -> Bool = pow5Factor(value) >= power
fn multipleOfPowerOf2(value: U64, power: Int) -> Bool =
    bitsUpTo(value, wideCount(power)) == 0

{-
   Ryu proper - the shortest decimal in the interval of values that round to this float.

   `m2` and `e2` are the mantissa and exponent the caller's format decoded, already scaled by the
   two extra bits the bounds computation needs; `mmShift` is one where the lower neighbour is half a
   step away rather than a whole one, which is the case at a power of two. Everything else is
   arithmetic on those three, which is what makes one body serve both widths.

   The two thresholds - `q <= 21` and `q < 63` - are the double's. They bound *exact* predicates
   rather than approximating anything, so a float reaching them with a smaller `q` is answered by
   the same tests; what a narrower threshold would buy is skipping a test whose answer is already no.
-}
fn shortestOf(m2: U64, e2: Int, mmShift: U64) -> Shortest:
    let acceptBounds = (m2 `and` 1) == 0
    let mv = 4 * m2

    let &vr = 0 :: U64
    let &vp = 0 :: U64
    let &vm = 0 :: U64
    let &e10 = 0 :: Int
    let &lowerIsExact = False
    let &valueIsExact = False

    if e2 >= 0:
        let q = log10Pow2(e2) - (if e2 > 3 then 1 else 0)
        let k = 125 + pow5Bits(q) - 1
        let i = 0 - e2 + q + k

        e10 = q
        vr = mulShiftInv(mv, q, i)
        vp = mulShiftInv(mv + 2, q, i)
        vm = mulShiftInv(mv - 1 - mmShift, q, i)

        -- At most one of the three can be a multiple of five, so the three arms are exclusive and
        -- the order they are tried in is the order that makes them so.
        if q <= 21:
            if mv % 5 == 0:
                valueIsExact = multipleOfPowerOf5(mv, q)
            else if acceptBounds:
                lowerIsExact = multipleOfPowerOf5(mv - 1 - mmShift, q)
            else if multipleOfPowerOf5(mv + 2, q):
                vp = vp - 1
    else:
        let q = log10Pow5(0 - e2) - (if (0 - e2) > 1 then 1 else 0)
        let i = (0 - e2) - q
        let k = pow5Bits(i) - 125
        let j = q - k

        e10 = q + e2
        vr = mulShiftPow5(mv, i, j)
        vp = mulShiftPow5(mv + 2, i, j)
        vm = mulShiftPow5(mv - 1 - mmShift, i, j)

        if q <= 1:
            -- `mv` is four times the mantissa, so it always has two trailing zero bits.
            valueIsExact = True
            if acceptBounds then lowerIsExact = mmShift == 1
            else vp = vp - 1
        else if q < 63:
            valueIsExact = multipleOfPowerOf2(mv, q)

    let &removed = 0 :: Int
    let &lastRemoved = 0 :: Int
    let &output = 0 :: U64

    if lowerIsExact || valueIsExact:
        -- The exact case, which is about one input in a hundred and forty. A digit may only be
        -- removed while the interval still holds a number, and the bookkeeping tracks whether what
        -- has been dropped so far was all zeros - which is what decides a tie at the end.
        while True:
            let vpNext = vp / 10
            let vmNext = vm / 10
            if vpNext <= vmNext then break

            let vrNext = vr / 10
            lowerIsExact = lowerIsExact && (vm - vmNext * 10) == 0
            valueIsExact = valueIsExact && lastRemoved == 0
            lastRemoved = truncate(vr - vrNext * 10) :: Int
            vr = vrNext
            vp = vpNext
            vm = vmNext
            removed = removed + 1

        if lowerIsExact:
            while True:
                let vmNext = vm / 10
                if (vm - vmNext * 10) != 0 then break

                let vpNext = vp / 10
                let vrNext = vr / 10
                valueIsExact = valueIsExact && lastRemoved == 0
                lastRemoved = truncate(vr - vrNext * 10) :: Int
                vr = vrNext
                vp = vpNext
                vm = vmNext
                removed = removed + 1

        -- An exact `...50...0` rounds to even, which is what turning the five into a four says.
        if valueIsExact && lastRemoved == 5 && vr % 2 == 0 then lastRemoved = 4

        let outside = vr == vm && (!acceptBounds || !lowerIsExact)
        output = vr + carryOf(outside || lastRemoved >= 5)
    else:
        -- And the common case, where two digits go at once before the loop starts because they
        -- almost always can.
        let &roundUp = False
        let vpHundred = vp / 100
        let vmHundred = vm / 100

        if vpHundred > vmHundred:
            let vrHundred = vr / 100
            roundUp = (vr - vrHundred * 100) >= 50
            vr = vrHundred
            vp = vpHundred
            vm = vmHundred
            removed = removed + 2

        while True:
            let vpNext = vp / 10
            let vmNext = vm / 10
            if vpNext <= vmNext then break

            let vrNext = vr / 10
            roundUp = (vr - vrNext * 10) >= 5
            vr = vrNext
            vp = vpNext
            vm = vmNext
            removed = removed + 1

        output = vr + carryOf(vr == vm || roundUp)

    return Shortest {digits: output, exponent: e10 + removed}

{-
   The two decoders, which are the whole of what a width contributes.

   A subnormal has no implicit bit and takes the exponent one above the bias, so that its value is
   the same expression as a normal number's. The two extra bits `e2` is short by are the interval
   computation's, which is why every exponent here has a `- 2` in it.
-}
fn doubleShortest(value: Double) -> Shortest:
    let pattern = bitcast(value) :: U64
    let mantissa = bitsUpTo(pattern, 52)
    let exponent = truncate((pattern `shr` 52) `and` 2047) :: Int

    if exponent == 0:
        return shortestOf(mantissa, 1 - 1023 - 52 - 2, carryOf(mantissa != 0))

    return shortestOf(mantissa `or` implicitBit52, exponent - 1023 - 52 - 2,
                      carryOf(mantissa != 0 || exponent <= 1))

fn floatShortest(value: Float) -> Shortest:
    let pattern = widen(bitcast(value) :: U32) :: U64
    let mantissa = bitsUpTo(pattern, 23)
    let exponent = truncate((pattern `shr` 23) `and` 255) :: Int

    if exponent == 0:
        return shortestOf(mantissa, 1 - 127 - 23 - 2, carryOf(mantissa != 0))

    return shortestOf(mantissa `or` implicitBit23, exponent - 127 - 23 - 2,
                      carryOf(mantissa != 0 || exponent <= 1))
