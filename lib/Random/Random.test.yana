{-
   `Random` - Analysis-Library.md §2.7, on both targets.

   Four claims, and each of them fails on its own:

    - **A seed determines the sequence, and the sequence is the same on both targets.** That is what
      the numbers pinned below are for. They are xoshiro128\*\*'s over this file's own seeding, so a
      change to either would move them - which is the point: this generator's output is part of its
      contract, in the way a digest's is, because a fixture elsewhere seeded with a constant is
      entitled to the same numbers next year and on the other target.
    - **Ranges are half-open and respected.** Every `between` and every `below` here is checked
      against both ends over enough draws to reach them.
    - **The draws are actually uniform.** A generator that returned its seed forever passes every
      bound check above, so the bucket counts below are the assertion that does not. They are exact
      numbers rather than statistics - the seed is written in the source, so there is nothing here
      that could be unlucky on a Tuesday.
    - **`secureRandom` answers, either way.** It is the one thing in the module whose answer differs
      between the targets, so what is asserted is the shape of the answer and what follows from it.

   Run on both targets, which is the reason the generator is 32-bit at all: the same source, the same
   sequence, once through a machine word and once through a `number`.
-}

import Test

-- The seed the pinned numbers belong to. Nothing about it is special; it is written here once so
-- that the numbers below have one source.
let pinnedSeed = 20260824

@test fn sequence() -> {}:
    -- The first eight draws, as `U32`. Worked out from the reference implementation rather than
    -- from this one, so they pin the algorithm and not merely today's behaviour.
    let &rng = newRng(pinnedSeed)

    checkEqual(next(rng), 4140245044)
    checkEqual(next(rng), 2403813560)
    checkEqual(next(rng), 2821307866)
    checkEqual(next(rng), 2867869537)
    checkEqual(next(rng), 1874838478)
    checkEqual(next(rng), 148666953)
    checkEqual(next(rng), 2108964929)
    checkEqual(next(rng), 2886156714)

    -- The same seed is the same sequence, which is the whole of what no-global-state buys.
    let &again = newRng(pinnedSeed)
    checkEqual(next(again), 4140245044)
    checkEqual(next(again), 2403813560)

    -- Two generators are independent: drawing from one does not move the other.
    let &left = newRng(pinnedSeed)
    let &right = newRng(pinnedSeed)
    checkEqual(next(left), next(right))
    let _ = next(left)
    checkEqual(next(right), 2403813560)

    -- Adjacent seeds are unrelated sequences, which is what the SplitMix expansion is for: a
    -- generator seeded straight from `1` and one seeded from `2` would agree in most of their bits.
    let &one = newRng(1)
    let &two = newRng(2)
    checkEqual(next(one), 393288148)
    checkEqual(next(two), 4239540602)

@test fn integers() -> {}:
    let &rng = newRng(pinnedSeed)

    -- `uniform` at `Int` is the same draw read as a signed word - the first pinned value above.
    checkEqual((uniform(rng) :: Int), -154722252)

    -- Half-open at both ends, over enough draws to reach them. A die is `between(1, 7)`.
    let &low = 7 :: Int
    let &high = 0 :: Int
    let &i = 0 :: Size

    while i < 600:
        let roll = between(rng, 1, 7) :: Int
        checkAtLeast(roll, 1)
        checkLess(roll, 7)

        if roll < low then low = roll
        if roll > high then high = roll
        i = i + 1

    checkEqual(low, 1)
    checkEqual(high, 6)

    -- An empty or inverted range answers its low end rather than being an error.
    checkEqual((between(rng, 4, 4) :: Int), 4)
    checkEqual((between(rng, 9, 2) :: Int), 9)

    -- The full signed range is drawable, which is the case the wrapping subtraction in the instance
    -- exists for: the span is 2^32 - 1, which no `Int` can hold.
    let &full = newRng(77)
    let least = minValue() :: Int
    let most = maxValue() :: Int
    let &negatives = 0 :: Int
    let &positives = 0 :: Int
    let &n = 0 :: Size

    while n < 16:
        let value = between(full, least, most) :: Int
        if value < 0 then negatives = negatives + 1
        if value > 0 then positives = positives + 1
        n = n + 1

    checkEqual(negatives, 9)
    checkEqual(positives, 7)

@test fn widths() -> {}:
    -- The narrow instances, checked at their ends the same way. `U8` reaching 0 and 255 over a
    -- thousand draws is what a truncation to the wrong width fails.
    let &rng = newRng(11)
    let &lowByte = 255 :: U8
    let &highByte = 0 :: U8
    let &lowShort = 65535 :: U16
    let &highShort = 0 :: U16
    let &i = 0 :: Size

    while i < 4000:
        let byte = uniform(rng) :: U8
        if byte < lowByte then lowByte = byte
        if byte > highByte then highByte = byte

        let short = uniform(rng) :: U16
        if short < lowShort then lowShort = short
        if short > highShort then highShort = short
        i = i + 1

    checkEqual(lowByte, 0)
    checkEqual(highByte, 255)
    checkLess(lowShort, 100)
    checkGreater(highShort, 65400)

    -- And their ranges, which go through the same unbiased draw the `Int` one does.
    let &j = 0 :: Size
    while j < 200:
        let byte = between(rng, 10 :: U8, 20 :: U8)
        checkAtLeast(byte, 10)
        checkLess(byte, 20)

        let short = between(rng, 1000 :: U16, 1001 :: U16)
        checkEqual(short, 1000)
        j = j + 1

    -- One bit, and both values of it appear.
    let &heads = 0 :: Int
    let &tails = 0 :: Int
    let &k = 0 :: Size

    while k < 100:
        if uniform(rng) :: Bool then heads = heads + 1 else tails = tails + 1
        k = k + 1

    checkGreater(heads, 20)
    checkGreater(tails, 20)
    checkEqual(heads + tails, 100)

    -- The signed narrow width, tracked *here* rather than beside its own case below, because the
    -- pressure is the point. `lowSigned` is live across three loops that each call into the
    -- generator, which is more webs across more calls than the x64 allocator has preserved registers
    -- for - so it gets no register over its whole life, and §5.10's region promotion gives it one
    -- over this loop alone. Under that promotion the only thing that writes it is the phi the two
    -- `if`s merge into, a phi was not counted as a definition, and a region nothing defines in is one
    -- that stores nothing back: every update landed in the register, the frame slot kept the seed,
    -- and both ends answered 127. This is the shape that says so, and it needs the loops above it.
    let &lowSigned = 127 :: I8
    let &highSigned = -128 :: I8
    let &m = 0 :: Size

    while m < 4000:
        let signedByte = uniform(rng) :: I8
        if signedByte < lowSigned then lowSigned = signedByte
        if signedByte > highSigned then highSigned = signedByte
        m = m + 1

    checkEqual(lowSigned, -128)
    checkEqual(highSigned, 127)

@test fn signedWidths() -> {}:
    {-
       The two narrow widths, signed - the pair that made the compiler say something.

       `Random(I8)` is a `U8` draw reinterpreted, and reinterpreting between the two readings of a
       sub-register width is where `bitcast` lowered to nothing natively: it left the register with
       the wrong half above the value, so `bitcast(207 :: U8) :: I8` answered 207 rather than -49 on
       a native build and -49 on a JavaScript one. Reaching both ends is what says the
       reinterpretation happened - an instance that widened instead would never produce a negative
       number at all.

       **A case of its own rather than the tail of `widths`**, and it stays one now for a different
       reason than it was written for. Writing these claims after that case's tracking loops answered
       127 for both ends on a native build at a shape a JavaScript build got right, which was a
       *third* thing and not this one: a homeless narrow local promoted into a register over a loop
       whose only write to it was a phi, and a phi was not counted as a definition. That is fixed -
       §5.10 of codegen/x64/README.md - and the shape that found it now lives at the end of `widths`,
       where the pressure that produces it is. What is left here is the `bitcast` above, which needs
       no pressure at all and is a claim about the instance rather than about the allocator.
    -}
    let &rng = newRng(11)
    let &lowSigned = 127 :: I8
    let &highSigned = -128 :: I8
    let &negatives = 0 :: Int
    let &m = 0 :: Size

    while m < 4000:
        let signedByte = uniform(rng) :: I8
        if signedByte < lowSigned then lowSigned = signedByte
        if signedByte > highSigned then highSigned = signedByte
        if signedByte < 0 then negatives = negatives + 1
        m = m + 1

    checkEqual(lowSigned, -128)
    checkEqual(highSigned, 127)
    checkGreater(negatives, 1800)
    checkLess(negatives, 2200)

    -- The wider of the two, at its own ends.
    let &lowShort = 32767 :: I16
    let &highShort = -32768 :: I16
    let &n = 0 :: Size

    while n < 4000:
        let signedShort = uniform(rng) :: I16
        if signedShort < lowShort then lowShort = signedShort
        if signedShort > highShort then highShort = signedShort
        n = n + 1

    checkLess(lowShort, -32000)
    checkGreater(highShort, 32000)

    -- A range that straddles zero, which is the two subtractions wrapping and wrapping back.
    let &k = 0 :: Size
    while k < 400:
        let byte = between(rng, -5 :: I8, 5)
        checkAtLeast(byte, -5)
        checkLess(byte, 5)

        let short = between(rng, -1000 :: I16, 1000)
        checkAtLeast(short, -1000)
        checkLess(short, 1000)
        k = k + 1

@test fn words() -> {}:
    {-
       The word-width instances, and the one claim a fixture that does not know its own word width
       has to make on its own terms: **every bit of the word is drawn.**

       That is not a formality. `Random(USize)` assembles the word from as many 32-bit draws as it
       takes, and the first version of it asked `bitWidth(value)` - the *value's* significant bits -
       where it meant the type's width. It compiled, it ran, and it passed every bound check in this
       file, because the top half of each draw was simply zero. The union of the draws is what
       separates the two, at whatever width this target's word happens to be.
    -}
    let &rng = newRng(pinnedSeed)
    let width = wordBits
    let &seen = 0 :: USize
    let &i = 0 :: Size

    while i < 200:
        seen = seen `or` (uniform(rng) :: USize)
        i = i + 1

    checkEqual(seen, maxValue() :: USize)
    checkAtLeast(width, 32)

    -- The signed word is the unsigned one reinterpreted, so half of it is negative. A body that
    -- widened instead of reinterpreting would answer non-negative every time.
    let &negatives = 0 :: Int
    let &j = 0 :: Size

    while j < 200:
        if (uniform(rng) :: Size) < 0 then negatives = negatives + 1
        j = j + 1

    checkGreater(negatives, 60)
    checkLess(negatives, 140)

    -- Both ends of a range, the same way every other width is checked here.
    let &k = 0 :: Size
    while k < 400:
        let n = between(rng, 10 :: Size, 20)
        checkAtLeast(n, 10)
        checkLess(n, 20)

        let one = between(rng, 7 :: USize, 8)
        checkEqual(one, 7)
        k = k + 1

    {-
       A range over the whole word, which on a 64-bit target is the span no single 32-bit draw
       covers - `belowWord`'s rejection loop rather than its first branch. Half the values are above
       half the range at any width, so the assertion is the same sentence on both targets while the
       code under it is not.

       `maxValue()` is written rather than a literal for exactly that reason: a number above 2^32
       spelled out here would not compile at all where the word is 32 bits, which is a fixture that
       cannot run on the target it is asserting about.
    -}
    let half = (maxValue() :: USize) `shr` 1
    let &above = 0 :: Int
    let &m = 0 :: Size

    while m < 200:
        if between(rng, 0 :: USize, maxValue() :: USize) > half then above = above + 1
        m = m + 1

    checkGreater(above, 60)
    checkLess(above, 140)

@test fn wide() -> {}:
    {-
       Sixty-four bits, which is the one width in this module whose arithmetic is a `bigint` on
       JavaScript - and the reason the file declares it anyway is that an unused instance is not
       emitted, so the cost lands only where a caller asks for one. This case is the asking.

       The claims are the word case's at a fixed width: every bit is drawn, the signed reading is the
       unsigned one reinterpreted so half of it is negative, and a span wider than a single draw goes
       through the rejection loop rather than through the 32-bit shortcut.
    -}
    let &rng = newRng(pinnedSeed)
    let &seen = 0 :: U64
    let &i = 0 :: Size

    while i < 200:
        seen = seen `or` (uniform(rng) :: U64)
        i = i + 1

    checkEqual(seen, maxValue() :: U64)

    let &negatives = 0 :: Int
    let &j = 0 :: Size

    while j < 200:
        if (uniform(rng) :: I64) < 0 then negatives = negatives + 1
        j = j + 1

    checkGreater(negatives, 60)
    checkLess(negatives, 140)

    {-
       A span of 2^40, which no single 32-bit draw covers - so this is `belowWide`'s rejection arm
       and not its shortcut. About 255 in 256 of the draws land above 2^32, which is what makes the
       bound below an assertion about the arm rather than about the seed.
    -}
    let &above = 0 :: Int
    let &k = 0 :: Size

    while k < 200:
        let v = between(rng, 0 :: U64, 1099511627776)
        checkLess(v, 1099511627776)
        if v >= 4294967296 then above = above + 1
        k = k + 1

    checkGreater(above, 150)

    -- And the shortcut beside it: a small span at a wide type still takes one draw and still lands
    -- in range, which is the arm every ordinary caller of a `U64` range reaches.
    let &n = 0 :: Size
    while n < 200:
        let v = between(rng, 100 :: U64, 110)
        checkAtLeast(v, 100)
        checkLess(v, 110)
        n = n + 1

@test fn reals() -> {}:
    {-
       The unit interval, at both widths. `1.0` is not in it and cannot be - the assembled integer is
       at most 2^53 - 1 - which is what makes the scaling in `between` safe without a clamp.

       The bounds on the extremes are what a shift of the wrong distance fails: a `Double` built from
       one draw rather than two never exceeds 1 - 2^-32 by much less, but its *granularity* would be
       wrong, so what is checked instead is that a thousand draws span most of the interval.
    -}
    let &rng = newRng(3)
    let &least = 1.0 :: Double
    let &most = 0.0 :: Double
    let &i = 0 :: Size

    while i < 1000:
        let value = uniform(rng) :: Double
        checkAtLeast(value, 0.0)
        checkLess(value, 1.0)

        if value < least then least = value
        if value > most then most = value
        i = i + 1

    checkLess(least, 0.01)
    checkGreater(most, 0.99)

    let &wide = newRng(4)
    let &leastFloat = 1.0 :: Float
    let &mostFloat = 0.0 :: Float
    let &j = 0 :: Size

    while j < 1000:
        let value = uniform(wide) :: Float
        checkAtLeast(value, 0.0)
        checkLess(value, 1.0)

        if value < leastFloat then leastFloat = value
        if value > mostFloat then mostFloat = value
        j = j + 1

    checkLess(leastFloat, 0.01)
    checkGreater(mostFloat, 0.99)

    -- The range variant, which is the unit draw scaled. Both ends hold for a range that does not
    -- start at zero and for one that is entirely negative.
    let &k = 0 :: Size
    while k < 500:
        let value = between(rng, -2.5, -0.5) :: Double
        checkAtLeast(value, -2.5)
        checkLess(value, -0.5)

        let single = between(rng, 100.0 :: Float, 200.0 :: Float)
        checkAtLeast(single, 100.0)
        checkLess(single, 200.0)
        k = k + 1

    checkEqual((between(rng, 1.0, 1.0) :: Double), 1.0)

@test fn uniformity() -> {}:
    {-
       The claim the bound checks cannot make: the draws are *spread*. Eight buckets over 4096 draws
       expect 512 each, and what is asserted is that every one of them is within a fifth of that -
       which a generator returning a constant, or one whose low bits are weak, misses by a mile.

       Exact rather than statistical: the seed is a constant, so these counts are a fact about this
       program and not a probability. They are checked against the reference implementation, so a
       change to either the generator or the rejection loop moves them.
    -}
    let &rng = newRng(pinnedSeed)
    let &counts = [0] :: [Int *8]
    let &i = 0 :: Size

    while i < 4096:
        let bucket = below(rng, 8)
        checkAtLeast(bucket, 0)
        checkLess(bucket, 8)

        counts[bucket] = counts[bucket] + 1
        i = i + 1

    let &total = 0 :: Int
    let &j = 0 :: Size

    while j < 8:
        checkGreater(counts[j], 409)
        checkLess(counts[j], 615)
        total = total + counts[j]
        j = j + 1

    checkEqual(total, 4096)

    -- `below` at the two degenerate counts, which is what a container of no elements hands it.
    checkEqual(below(rng, 0), 0)
    checkEqual(below(rng, 1), 0)

@test fn entropy() -> {}:
    {-
       The one answer that differs between the targets: a kernel has an entropy pool and a bare
       script context has nothing that a library may rely on. So both arms are written, and each
       asserts what follows from its own answer rather than the fixture asserting which arm it is in.
    -}
    let &bytes = [0] :: [U8 *8]

    match secureRandom(bytes):
        Ok(_):
            -- Eight bytes the kernel wrote. All-zero is a legal answer with probability 2^-64, which
            -- is a smaller number than the chance of every other assertion in this file being wrong.
            let &any = 0 :: Int
            let &i = 0 :: Size

            while i < 8:
                any = any `or` (bytes[i] :: Int)
                i = i + 1

            checkNotEqual(any, 0)

        Err(NoEntropySource):
            -- Nothing was written, which is the other half of the promise: a refusal does not leave
            -- a caller with bytes it might mistake for random ones.
            checkEqual(bytes[0], 0)
            checkEqual(bytes[7], 0)

    -- And the seed built over it, which has an answer either way. What is asserted is that it is a
    -- usable seed rather than which source it came from - a generator built from it draws.
    let &rng = seededRng()
    let &different = 0 :: Int
    let &j = 0 :: Size

    while j < 8:
        if next(rng) != next(rng) then different = different + 1
        j = j + 1

    checkGreater(different, 4)
